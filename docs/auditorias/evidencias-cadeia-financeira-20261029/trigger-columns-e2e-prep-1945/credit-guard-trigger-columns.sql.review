-- INACTIVE REVIEW CANDIDATE — disposable PostgreSQL only. Never apply hosted, never copy into
-- supabase/migrations, never GRANT. Depends on shared-credit-guard.sql.review (candidate function body).
-- Captured LIVE DDL: BEFORE INSERT OR UPDATE OF status, total  -> an UPDATE touching ONLY
-- final_amount_with_interest or credit_approved_by never fires the credit guard.
-- Candidate: same trigger name/timing/function, column list widened. Function body unchanged.
DROP TRIGGER IF EXISTS trg_partner_orders_credit_guard ON public.partner_orders;
CREATE TRIGGER trg_partner_orders_credit_guard
  BEFORE INSERT OR UPDATE OF status, total, final_amount_with_interest, credit_approved_by ON public.partner_orders
  FOR EACH ROW EXECUTE FUNCTION public.tg_partner_orders_credit_guard();
