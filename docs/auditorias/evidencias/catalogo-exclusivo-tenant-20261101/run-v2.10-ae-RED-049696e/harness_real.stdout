{"id": "AE-3c", "scenario": "helper real de visibilidade do parceiro restaurado após o stub", "expected": "CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_partner_visible(p_partner uuid, p_technical boolean DEFAULT false)\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE s record; u uuid:=auth.uid(); BEGIN\n IF u IS NULL OR p_partner IS NULL THEN RETURN false; END IF;\n IF public.is_platform_superadmin(u) THEN RETURN true; END IF;\n IF EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=u AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor')) THEN\n  RETURN public.is_valid_b2b_partner_user(u,p_partner)\n   AND (public.has_role(u,'parceiro_b2b') OR (p_technical AND public.has_role(u,'parceiro_b2b_tecnico')));\n END IF;\n SELECT * INTO s FROM platform_private.b2b_actor_scope(u);\n RETURN s.profile_ok AND s.partner_valid AND s.org_partner=p_partner;\nEND $function$", "actual": "CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_partner_visible(p_partner uuid, p_technical boolean DEFAULT false)\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE s record; u uuid:=auth.uid(); BEGIN\n IF u IS NULL OR p_partner IS NULL THEN RETURN false; END IF;\n IF public.is_platform_superadmin(u) THEN RETURN true; END IF;\n IF EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=u AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor')) THEN\n  RETURN public.is_valid_b2b_partner_user(u,p_partner)\n   AND (public.has_role(u,'parceiro_b2b') OR (p_technical AND public.has_role(u,'parceiro_b2b_tecnico')));\n END IF;\n SELECT * INTO s FROM platform_private.b2b_actor_scope(u);\n RETURN s.profile_ok AND s.partner_valid AND s.org_partner=p_partner;\nEND $function$", "status": "PASS", "kind": "PG_DISPOSABLE_REAL_SCHEMA_SYNTHETIC_AUTH"}
