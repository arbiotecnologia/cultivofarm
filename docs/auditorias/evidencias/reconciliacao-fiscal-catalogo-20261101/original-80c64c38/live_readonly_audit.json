   "functions": [
    {
     "acl": [
      "postgres=X/postgres"
     ],
     "definition": "CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_actor(p_mode text)\n RETURNS uuid\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE\n  v_uid uuid := auth.uid();\n  v_claims jsonb := NULLIF(current_setting('request.jwt.claims', true), '')::jsonb;\n  v_org uuid;\nBEGIN\n  IF v_uid IS NULL OR v_claims IS NULL OR v_claims->>'role' IS DISTINCT FROM 'authenticated'\n     OR (v_claims->>'sub') IS DISTINCT FROM v_uid::text\n     OR NULLIF(v_claims->>'exp','') IS NULL OR (v_claims->>'exp') !~ '^[0-9]{1,12}$'\n     OR to_timestamp((v_claims->>'exp')::bigint) <= now()\n     OR (NULLIF(v_claims->>'iat','') IS NOT NULL AND ((v_claims->>'iat') !~ '^[0-9]{1,12}$'\n         OR to_timestamp((v_claims->>'iat')::bigint) > now() + interval '60 seconds')) THEN\n    RAISE EXCEPTION 'catalog_visibility_auth_required' USING ERRCODE='42501';\n  END IF;\n  IF public.is_platform_superadmin(v_uid) THEN\n    RAISE EXCEPTION 'catalog_visibility_platform_actor_denied' USING ERRCODE='42501';\n  END IF;\n  v_org := platform_private.h15_actor_organization();\n  IF v_org IS NULL OR NOT EXISTS (SELECT 1 FROM public.organizations o WHERE o.id=v_org AND o.ativo IS TRUE AND o.status='ativa') THEN\n    RAISE EXCEPTION 'catalog_visibility_tenant_unavailable' USING ERRCODE='42501';\n  END IF;\n  IF p_mode IN ('mutate','read_catalog','read_management') AND NOT public._saas_user_has_feature(v_uid, 'catalogo_precos') THEN\n    RAISE EXCEPTION 'catalog_visibility_feature_unavailable' USING ERRCODE='42501';\n  END IF;\n  IF p_mode='mutate' THEN\n    IF NOT (platform_private.has_role(v_uid,'administrador'::public.app_role) OR platform_private.has_role(v_uid,'gestor'::public.app_role)) THEN\n      RAISE EXCEPTION 'catalog_visibility_role_denied' USING ERRCODE='42501'; END IF;\n  ELSIF p_mode='read_catalog' THEN\n    IF NOT public.can_view_catalog_internal(v_uid) THEN\n      RAISE EXCEPTION 'catalog_visibility_role_denied' USING ERRCODE='42501'; END IF;\n  ELSIF p_mode NOT IN ('read_management','read_selection_cultura','read_prefs') OR p_mode IS NULL THEN\n    RAISE EXCEPTION 'catalog_visibility_mode_invalid' USING ERRCODE='22023';\n  END IF;\n  RETURN v_org;\nEND; $function$\n",
     "md5": "5e0ce9cc9122f1c21d76e29a13de8b59",
     "name": "catalog_tenant_actor",
     "schema": "platform_private",
     "signature": "platform_private.catalog_tenant_actor(text)"
    },
    {
     "acl": [
      "postgres=X/postgres",
      "authenticated=X/postgres",
      "service_role=X/postgres"
     ],
     "definition": "CREATE OR REPLACE FUNCTION public.h15_actor_organization()\n RETURNS uuid\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ SELECT platform_private.h15_actor_organization(); $function$\n",
     "md5": "55edafec08bcc84a00f1526c14334a2c",
     "name": "h15_actor_organization",
     "schema": "public",
     "signature": "h15_actor_organization()"
    },
    {
     "acl": [
      "postgres=X/postgres",
      "authenticated=X/postgres",
      "service_role=X/postgres"
     ],
     "definition": "CREATE OR REPLACE FUNCTION platform_private.h15_actor_organization()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT p.organization_id FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE WHERE p.user_id=auth.uid() AND p.ativo IS TRUE AND platform_private.platform_actor_access_ready(p.user_id);\n$function$\n",
     "md5": "64e10608403238a41a9baf92857ca881",
     "name": "h15_actor_organization",
     "schema": "platform_private",
     "signature": "platform_private.h15_actor_organization()"
    },
    {
     "acl": [
      "postgres=X/postgres",
      "authenticated=X/postgres",
      "service_role=X/postgres"
     ],
     "definition": "CREATE OR REPLACE FUNCTION platform_private.platform_actor_access_ready(p_user uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM public.profiles p WHERE p.user_id=p_user AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE)\n AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=p_user AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL AND auth.uid()=p_user AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));\n$function$\n",
     "md5": "048249c0c2106c3761e26eacb8d0de84",
     "name": "platform_actor_access_ready",
     "schema": "platform_private",
     "signature": "platform_private.platform_actor_access_ready(uuid)"
    },
    {
     "acl": [
      "postgres=X/postgres",
      "authenticated=X/postgres"
     ],
     "definition": "CREATE OR REPLACE FUNCTION public.platform_create_global_product(p_payload jsonb, p_reason text, p_idempotency_key uuid)\n RETURNS jsonb\n LANGUAGE sql\n SET search_path TO ''\nAS $function$\n  SELECT platform_private.create_global_product_core(p_payload,p_reason,p_idempotency_key);\n$function$\n",
     "md5": "6335cdcfc5806c34ea87c532f93d0d0d",
     "name": "platform_create_global_product",
     "schema": "public",
     "signature": "platform_create_global_product(jsonb,text,uuid)"
    },
