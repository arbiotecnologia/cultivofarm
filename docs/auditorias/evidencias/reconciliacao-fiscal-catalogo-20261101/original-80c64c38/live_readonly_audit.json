     "definition": "CREATE OR REPLACE FUNCTION public.platform_set_global_product_family(p_id uuid, p_expected_updated_at timestamp with time zone, p_familia text, p_classe text, p_reason text, p_idempotency_key uuid)\n RETURNS jsonb\n LANGUAGE sql\n SET search_path TO ''\nAS $function$ SELECT platform_private.set_global_product_family_core(p_id,p_expected_updated_at,p_familia,p_classe,p_reason,p_idempotency_key) $function$\n",
     "md5": "9f3d74fc898944514574360d091bb1ff",
     "name": "platform_set_global_product_family",
     "schema": "public",
     "signature": "platform_set_global_product_family(uuid,timestamp with time zone,text,text,text,uuid)"
    }
