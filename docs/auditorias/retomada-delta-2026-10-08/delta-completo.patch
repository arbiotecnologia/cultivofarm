+CREATE OR REPLACE FUNCTION public.platform_validate_plan_version_draft(_draft_id uuid)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = ''
+AS $$
+DECLARE
+  v public.saas_plan_versions%ROWTYPE;
+  v_missing text[] := ARRAY[]::text[];
+  v_feature_keys jsonb;
+  v_feature_count integer;
+BEGIN
+  IF auth.uid() IS NULL OR NOT public.is_platform_superadmin(auth.uid()) THEN
+    RAISE EXCEPTION 'platform_forbidden: apenas superadmin' USING ERRCODE='42501';
+  END IF;
+  SELECT * INTO v FROM public.saas_plan_versions WHERE id=_draft_id;
+  IF NOT FOUND OR v.status <> 'DRAFT' THEN
+    RAISE EXCEPTION 'platform_invalid: rascunho inexistente' USING ERRCODE='22023';
+  END IF;
+
+  SELECT count(*),coalesce(jsonb_agg(f.key ORDER BY f.key) FILTER (WHERE vf.enabled),'[]'::jsonb)
+    INTO v_feature_count,v_feature_keys
+  FROM public.saas_plan_version_features vf
+  JOIN public.saas_features f ON f.id=vf.feature_id
+  WHERE vf.plan_version_id=v.id AND vf.enabled;
+
+  IF v.price_amount IS NULL OR v.price_amount <= 0 THEN v_missing:=array_append(v_missing,'price_amount'); END IF;
+  IF v.currency IS NULL OR v.currency NOT IN ('BRL','USD','EUR') THEN v_missing:=array_append(v_missing,'currency'); END IF;
+  IF v.billing_cycle IS NULL OR v.billing_cycle NOT IN ('monthly','quarterly','semiannual','annual','custom') THEN v_missing:=array_append(v_missing,'billing_cycle'); END IF;
+  IF v.trial_days IS NULL OR v.trial_days < 1 OR v.trial_days > 365 THEN v_missing:=array_append(v_missing,'trial_days'); END IF;
+  IF v.effective_from IS NULL THEN v_missing:=array_append(v_missing,'effective_from'); END IF;
+  IF v.limits_snapshot IS NULL OR jsonb_typeof(v.limits_snapshot) <> 'object' THEN v_missing:=array_append(v_missing,'limits'); END IF;
+  IF v_feature_count=0 THEN v_missing:=array_append(v_missing,'features'); END IF;
+
+  IF cardinality(v_missing)=0 THEN
+    BEGIN
+      PERFORM platform_private.validate_commercial_plan_payload(v.plan_id,v.limits_snapshot,v_feature_keys);
+    EXCEPTION WHEN SQLSTATE '22023' THEN
+      v_missing:=array_append(v_missing,'commercial_payload');
+    END;
+  END IF;
+
+  RETURN jsonb_build_object(
+    'complete',cardinality(v_missing)=0,
+    'valid',cardinality(v_missing)=0,
+    'missing',to_jsonb(v_missing),
+    'feature_count',v_feature_count,
+    'revision',v.revision
+  );
+END;
+$$;
+REVOKE ALL ON FUNCTION public.platform_validate_plan_version_draft(uuid) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.platform_validate_plan_version_draft(uuid) TO authenticated, service_role;
+
+CREATE OR REPLACE FUNCTION public.platform_publish_plan_version_draft(
+  _draft_id uuid,
+  _reason text,
+  _idempotency_key uuid,
+  _confirmation text
+) RETURNS uuid
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = ''
+AS $$
+DECLARE
+  v public.saas_plan_versions%ROWTYPE;
+  v_check jsonb;
+  v_old jsonb;
+BEGIN
+  IF auth.uid() IS NULL OR NOT public.is_platform_superadmin(auth.uid()) THEN
+    RAISE EXCEPTION 'platform_forbidden: apenas superadmin' USING ERRCODE='42501';
+  END IF;
+  IF _reason IS NULL OR length(btrim(_reason))<5 OR _idempotency_key IS NULL OR _confirmation<>'PUBLICAR' THEN
+    RAISE EXCEPTION 'platform_invalid: confirmação, motivo e chave obrigatórios' USING ERRCODE='22023';
+  END IF;
+  SELECT * INTO v FROM public.saas_plan_versions WHERE publish_key=_idempotency_key;
+  IF FOUND THEN RETURN v.id; END IF;
+  SELECT * INTO v FROM public.saas_plan_versions WHERE id=_draft_id FOR UPDATE;
+  IF NOT FOUND OR v.status<>'DRAFT' THEN
+    RAISE EXCEPTION 'platform_invalid: rascunho inexistente' USING ERRCODE='22023';
+  END IF;
+  v_check:=public.platform_validate_plan_version_draft(v.id);
+  IF NOT coalesce((v_check->>'complete')::boolean,false) THEN
+    RAISE EXCEPTION 'platform_invalid: versão comercial incompleta' USING ERRCODE='22023';
+  END IF;
+  IF EXISTS(
+    SELECT 1 FROM public.saas_plan_versions existing
+    WHERE existing.plan_id=v.plan_id
+      AND existing.status='PUBLISHED'
+      AND existing.effective_from<=v.effective_from
+      AND (existing.effective_to IS NULL OR existing.effective_to>v.effective_from)
+  ) THEN
+    RAISE EXCEPTION 'platform_conflict: vigência sobreposta' USING ERRCODE='40001';
+  END IF;
+  v_old:=to_jsonb(v);
+  PERFORM platform_private.issue_ticket('saas_plan_version_write',v.plan_id);
+  UPDATE public.saas_plan_versions SET
+    status='PUBLISHED',published_at=now(),publication_reason=btrim(_reason),
+    correlation_id=_idempotency_key,publish_key=_idempotency_key,updated_at=now()
+  WHERE id=v.id;
+  PERFORM platform_private.issue_ticket('saas_plan_version_audit',v.plan_id);
+  INSERT INTO public.saas_plan_version_audit(
+    plan_version_id,action,old_values,new_values,reason,origin,actor_user_id,idempotency_key
+  ) VALUES (
+    v.id,'published',v_old,
+    (SELECT to_jsonb(current_version) FROM public.saas_plan_versions current_version WHERE current_version.id=v.id),
+    btrim(_reason),'platform_rpc',auth.uid(),_idempotency_key
+  );
+  RETURN v.id;
+END;
+$$;
+REVOKE ALL ON FUNCTION public.platform_publish_plan_version_draft(uuid,text,uuid,text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.platform_publish_plan_version_draft(uuid,text,uuid,text) TO authenticated, service_role;
+
+COMMIT;
