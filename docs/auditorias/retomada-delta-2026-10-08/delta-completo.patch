+    assertEquals(r.ok ? "" : `${r.status}:${r.code}`, "401:invalid_token");
+    assertEquals(calls, ["getUser"]);
+  }
+});
+
+Deno.test("ator válido não-superadmin => 403", async () => {
+  for (const v of [false, null, "true", 1]) {
