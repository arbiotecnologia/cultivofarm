+  IF nullif(upper(btrim(coalesce(_currency,''))),'') IS NOT NULL AND upper(btrim(_currency)) !~ '^[A-Z]{3}$' THEN RAISE EXCEPTION 'platform_invalid: moeda inválida'; END IF;
