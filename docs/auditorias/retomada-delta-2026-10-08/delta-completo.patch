+-- P1B: executar SELECT separadamente em cada destino comprovado.
+-- Sem dados de negócio, segredos, rebind ou metadata Storage.
+-- Comparar arrays completos, não somente MD5. Ref homolog autorizado: vrlcdwmlytukrjezrrnf.
+WITH tableset(name) AS (VALUES
+ ('organizations'),('partner_accounts'),('clientes'),('partner_users'),
+ ('partner_clients'),('partner_user_clients'),('partner_orders'),('partner_order_items'),
+ ('partner_order_financial_links'),('accounts_receivable'),('accounts_receivable_installments'),
+ ('production_planning'),('production_order_link'),('ordens_servico'),('entregas'),
+ ('fiscal_invoices'),('fiscal_invoice_items'),('fiscal_events'),('company_fiscal_settings')),
+snapshots(category,items) AS (
+ SELECT 'migrations',coalesce(jsonb_agg(jsonb_build_object('version',version,'name',name,
+    'hash',md5(array_to_string(statements,E'\n'))) ORDER BY version),'[]'::jsonb)
+ FROM supabase_migrations.schema_migrations
+ UNION ALL
+ SELECT 'columns',coalesce(jsonb_agg(to_jsonb(c) ORDER BY table_name,ordinal_position),'[]'::jsonb)
+ FROM (SELECT table_name,column_name,ordinal_position,udt_name,is_nullable,column_default
+ FROM information_schema.columns WHERE table_schema='public' AND table_name IN (SELECT name FROM tableset)) c
+ UNION ALL
+ SELECT 'rls',coalesce(jsonb_agg(jsonb_build_object('name',t.name,'exists',c.oid IS NOT NULL,
+    'enabled',c.relrowsecurity,'forced',c.relforcerowsecurity) ORDER BY t.name),'[]'::jsonb)
+ FROM tableset t LEFT JOIN pg_class c ON c.relname=t.name AND c.relnamespace='public'::regnamespace
+ UNION ALL
+ SELECT 'policies',coalesce(jsonb_agg(to_jsonb(p) ORDER BY tablename,policyname),'[]'::jsonb)
+ FROM pg_policies p WHERE schemaname='public' AND tablename IN (SELECT name FROM tableset)
+ UNION ALL
+ SELECT 'constraints',coalesce(jsonb_agg(jsonb_build_object('table',c.relname,'name',k.conname,
+    'definition',pg_get_constraintdef(k.oid)) ORDER BY c.relname,k.conname),'[]'::jsonb)
+ FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid
+ WHERE c.relnamespace='public'::regnamespace AND c.relname IN (SELECT name FROM tableset)
+ UNION ALL
+ SELECT 'table_grants',coalesce(jsonb_agg(to_jsonb(g) ORDER BY table_name,grantee,privilege_type),'[]'::jsonb)
+ FROM information_schema.role_table_grants g WHERE table_schema='public' AND table_name IN (SELECT name FROM tableset)
+ UNION ALL
+ SELECT 'rpc_and_acl',coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,
+   'args',pg_get_function_identity_arguments(p.oid),'definition_hash',md5(pg_get_functiondef(p.oid)),
+   'definer',p.prosecdef,'config',p.proconfig,'acl',p.proacl::text,
+   'anon',has_function_privilege('anon',p.oid,'EXECUTE'),
+   'authenticated',has_function_privilege('authenticated',p.oid,'EXECUTE')) ORDER BY n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)),'[]'::jsonb)
+ FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+ WHERE n.nspname IN ('public','platform_private') AND p.prokind='f'
+   AND (p.proname ILIKE '%b2b%' OR p.proname ILIKE '%partner%'
+     OR p.proname ILIKE '%fiscal%' OR p.proname ILIKE '%h15%')
+)
+SELECT category,md5(items::text) fingerprint,items FROM snapshots ORDER BY category;
\ No newline at end of file
diff --git a/scripts/rbac-audit/commercial-context-isolation-proof.sql b/scripts/rbac-audit/commercial-context-isolation-proof.sql
new file mode 100644
index 000000000..0eea9f176
--- /dev/null
+++ b/scripts/rbac-audit/commercial-context-isolation-proof.sql
@@ -0,0 +1,43 @@
+-- Somente no canônico; ROLE/claims SQL não são prova JWT/API/browser.
+-- Fixtures de domínio apenas, nenhuma alteração de organização/usuário/vínculo.
+-- A exceção final reverte TUDO; nunca remover nem capturar essa exceção.
+DO $$
+DECLARE
+ a uuid := 'cbdc4ef3-005a-4674-8ea3-4410c7d7d212';
+ b uuid := 'a7d45277-6dec-413d-bf6b-86620c1ef39f';
+ oa uuid := '8f57c7dd-0557-4041-b401-7a00f7244626';
+ ob uuid := '007bb519-cba0-4704-be2c-cb93ad010048';
+ ca uuid := gen_random_uuid(); cb uuid := gen_random_uuid();
+ pa uuid := gen_random_uuid(); pb uuid := gen_random_uuid();
+ run text := 'TEMPORARY_AUDIT_' || gen_random_uuid()::text;
+ actor uuid; ownc uuid; otherc uuid; ownp uuid; otherp uuid;
+ n integer; positive integer := 0; denied integer := 0;
+BEGIN
+ IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='swzpzcwiasxmjutrmvkm') THEN RAISE EXCEPTION 'canonical_project_required'; END IF;
+ IF NOT EXISTS(SELECT 1 FROM public.profiles WHERE user_id=a AND organization_id=oa AND ativo AND senha_provisoria=false)
+ OR NOT EXISTS(SELECT 1 FROM public.profiles WHERE user_id=b AND organization_id=ob AND ativo AND senha_provisoria=false) THEN RAISE EXCEPTION 'actor_baseline_changed'; END IF;
+ EXECUTE 'SET LOCAL ROLE authenticated';
+ PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',a,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text,true);
+ INSERT INTO public.clientes(id,nome,nome_fantasia,codigo_cliente) VALUES(ca,run,run,run||'_A');
+ INSERT INTO public.partner_accounts(id,razao_social,client_id) VALUES(pa,run,ca);
+ PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',b,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text,true);
+ INSERT INTO public.clientes(id,nome,nome_fantasia,codigo_cliente) VALUES(cb,run,run,run||'_B');
+ INSERT INTO public.partner_accounts(id,razao_social,client_id) VALUES(pb,run,cb);
+ FOREACH actor IN ARRAY ARRAY[a,b] LOOP
+  ownc:=CASE WHEN actor=a THEN ca ELSE cb END; otherc:=CASE WHEN actor=a THEN cb ELSE ca END;
+  ownp:=CASE WHEN actor=a THEN pa ELSE pb END; otherp:=CASE WHEN actor=a THEN pb ELSE pa END;
+  PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',actor,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text,true);
+  SELECT count(*) INTO n FROM public.clientes WHERE id=ownc; IF n<>1 THEN RAISE EXCEPTION 'own_client_failed'; END IF; positive:=positive+1;
+  SELECT count(*) INTO n FROM public.partner_accounts WHERE id=ownp; IF n<>1 THEN RAISE EXCEPTION 'own_partner_failed'; END IF; positive:=positive+1;
+  UPDATE public.partner_accounts SET observacoes=run WHERE id=ownp; GET DIAGNOSTICS n=ROW_COUNT; IF n<>1 THEN RAISE EXCEPTION 'own_update_failed'; END IF; positive:=positive+1;
+  SELECT count(*) INTO n FROM public.clientes WHERE id=otherc; IF n<>0 THEN RAISE EXCEPTION 'cross_client_read'; END IF; denied:=denied+1;
+  SELECT count(*) INTO n FROM public.partner_accounts WHERE id=otherp; IF n<>0 THEN RAISE EXCEPTION 'cross_partner_read'; END IF; denied:=denied+1;
+  UPDATE public.partner_accounts SET observacoes=run WHERE id=otherp; GET DIAGNOSTICS n=ROW_COUNT; IF n<>0 THEN RAISE EXCEPTION 'cross_partner_update'; END IF; denied:=denied+1;
+  UPDATE public.clientes SET nome=run WHERE id=otherc; GET DIAGNOSTICS n=ROW_COUNT; IF n<>0 THEN RAISE EXCEPTION 'cross_client_update'; END IF; denied:=denied+1;
+  BEGIN
+   UPDATE public.partner_accounts SET client_id=otherc WHERE id=ownp;
+   RAISE EXCEPTION 'cross_reparent_accepted';
+  EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+ END LOOP;
+ RAISE EXCEPTION 'COMMERCIAL_CONTEXT_ROLLBACK run=% clients=%,% partners=%,% positive=% denied=%',run,ca,cb,pa,pb,positive,denied;
+END $$;
\ No newline at end of file
diff --git a/scripts/rbac-audit/communication-notif3-proof.sql b/scripts/rbac-audit/communication-notif3-proof.sql
new file mode 100644
index 000000000..d218798f9
--- /dev/null
+++ b/scripts/rbac-audit/communication-notif3-proof.sql
@@ -0,0 +1,54 @@
+-- Canonical swzpzcwiasxmjutrmvkm only. No sends, Auth changes or secrets.
+-- Execute as one transaction; final exception MUST roll back all fixtures.
+DO $proof$
+DECLARE
+  run_id uuid := gen_random_uuid();
+  event_id uuid := gen_random_uuid();
+  audit_id bigint := -(1000000000000 + floor(random()*1000000000000)::bigint);
+  actor uuid;
+  t text;
+  n bigint;
+  denied integer := 0;
+  hidden integer := 0;
+  result jsonb;
+BEGIN
+  INSERT INTO public.comunicacao_audit_log(id,acao,entidade,entity_id,actor_id)
+    VALUES(audit_id,'TEMPORARY_AUDIT_NOTIF3','TEMPORARY_AUDIT_NOTIF3',run_id,'a7d45277-6dec-413d-bf6b-86620c1ef39f');
+  INSERT INTO public.comunicacao_eventos(id,event_key,source_type,source_id,created_by,idempotency_key)
+    VALUES(event_id,'TEMPORARY_AUDIT_NOTIF3','TEMPORARY_AUDIT_NOTIF3',run_id,'a7d45277-6dec-413d-bf6b-86620c1ef39f',run_id::text);
+  FOREACH actor IN ARRAY ARRAY['cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid,'a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid] LOOP
+    PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',actor,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text,true);
+    EXECUTE 'SET LOCAL ROLE authenticated';
+    FOREACH t IN ARRAY ARRAY['comunicacao_eventos','comunicacao_outbox','comunicacao_audit_log','comunicacao_consent_log','comunicacao_provider_receipts','comunicacao_dlq_replay_audit','comunicacao_regras','comunicacao_templates','communication_provider_settings','communication_provider_settings_audit','communication_provider_settings_rate_limit'] LOOP
+      BEGIN
+        EXECUTE format('SELECT count(*) FROM public.%I',t) INTO n;
+        IF n<>0 THEN RAISE EXCEPTION 'unexpected global visibility: %',t; END IF;
+      EXCEPTION WHEN insufficient_privilege THEN NULL;
+      END;
+      hidden:=hidden+1;
+    END LOOP;
+    BEGIN PERFORM public.rpc_admin_communication_health_snapshot(); RAISE EXCEPTION 'health allowed';
+      EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    BEGIN PERFORM public.rpc_publish_communication_event_v2('administrative_important_update',NULL,NULL,'{}',run_id::text); RAISE EXCEPTION 'publish allowed';
+      EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    BEGIN PERFORM public.rpc_admin_set_whatsapp_consent(NULL,actor,'opt_in','TEMPORARY_AUDIT_NOTIF3',NULL); RAISE EXCEPTION 'consent allowed';
+      EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    BEGIN PERFORM public.rpc_verify_communication_channel(NULL,actor,'email',true,true); RAISE EXCEPTION 'verify allowed';
+      EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    BEGIN UPDATE public.comunicacao_eventos SET payload='{"forged":true}' WHERE id=event_id;
+      GET DIAGNOSTICS n=ROW_COUNT; IF n<>0 THEN RAISE EXCEPTION 'update allowed'; END IF;
+      EXCEPTION WHEN insufficient_privilege THEN NULL; END;
+    BEGIN INSERT INTO public.comunicacao_eventos(event_key,idempotency_key) VALUES('TEMPORARY_AUDIT_NOTIF3',gen_random_uuid()::text); RAISE EXCEPTION 'insert allowed';
+      EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    EXECUTE 'RESET ROLE';
+  END LOOP;
+  -- Privileged execution still denied BEFORE reads/effects, not just ACL.
+  BEGIN PERFORM public.rpc_admin_communication_health_snapshot(); RAISE EXCEPTION 'privileged health allowed';
+    EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+  BEGIN PERFORM public.rpc_publish_communication_event_v2('administrative_important_update',NULL,NULL,'{}',run_id::text); RAISE EXCEPTION 'privileged publish allowed';
+    EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+  result:=public._comunicacao_publish_system_event('unknown',NULL,NULL,'{}',run_id::text);
+  IF result->>'suppressed'<>'true' OR result->>'ok'<>'false' THEN RAISE EXCEPTION 'parent suppression failed'; END IF;
+  IF hidden<>22 OR denied<>12 THEN RAISE EXCEPTION 'coverage count mismatch'; END IF;
+  RAISE EXCEPTION 'NOTIF3_COMMUNICATION_ROLLBACK hidden=% denied=% parent_suppressed=true event=% audit=% run=%',hidden,denied,event_id,audit_id,run_id USING ERRCODE='P0001';
+END $proof$;
\ No newline at end of file
diff --git a/scripts/rbac-audit/communication-preferences-notif3-proof.sql b/scripts/rbac-audit/communication-preferences-notif3-proof.sql
new file mode 100644
index 000000000..3e14b45bd
--- /dev/null
+++ b/scripts/rbac-audit/communication-preferences-notif3-proof.sql
@@ -0,0 +1,68 @@
+-- Canonical swzpzcwiasxmjutrmvkm only; no Auth/account changes or sends.
+-- All inserts and preference/consent effects MUST roll back at the final P0001.
+DO $proof$
+DECLARE
+  run_id uuid := gen_random_uuid();
+  cross_client uuid := gen_random_uuid();
+  cross_pref uuid := gen_random_uuid();
+  cross_link uuid := gen_random_uuid();
+  inactive_pref uuid := gen_random_uuid();
+  unowned_pref uuid := gen_random_uuid();
+  actor uuid;
+  n bigint;
+  result jsonb;
+  positive integer := 0;
+  denied integer := 0;
+BEGIN
+  -- Explicit temporary client, not a backfill of any real/unowned client.
+  INSERT INTO public.clientes(id,nome,codigo_cliente,organization_id)
+    VALUES(cross_client,'TEMPORARY_AUDIT_NOTIF3_PREF', 'AUD-'||run_id::text,'007bb519-cba0-4704-be2c-cb93ad010048');
+  INSERT INTO public.comunicacao_preferencias(id,user_id,cliente_id,canal,source)
+    VALUES(cross_pref,NULL,cross_client,'email','cliente_portal');
+  INSERT INTO public.user_clientes(id,user_id,cliente_id)
+    VALUES(cross_link,'cbdc4ef3-005a-4674-8ea3-4410c7d7d212',cross_client);
+  INSERT INTO public.comunicacao_preferencias(id,user_id,canal,source) VALUES
+    (inactive_pref,'d856140b-26c9-4d6a-a5aa-8bea47e78fff','email','user'),
+    (unowned_pref,'37303555-f734-4ba8-8d13-f8fa54603853','email','user');
+  FOREACH actor IN ARRAY ARRAY['cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid,'a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid] LOOP
+    PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',actor,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text,true);
+    EXECUTE 'SET LOCAL ROLE authenticated';
+    IF public.h15_actor_organization() IS NULL THEN RAISE EXCEPTION 'positive actor not ready'; END IF;
+    result := public.rpc_update_communication_preferences('in_app',false,NULL);
+    IF result->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'own RPC failed'; END IF;
+    SELECT count(*) INTO n FROM public.comunicacao_preferencias WHERE user_id=actor AND canal='in_app' AND enabled=false;
+    IF n<>1 THEN RAISE EXCEPTION 'own read failed'; END IF;
+    positive:=positive+1;
+    SELECT count(*) INTO n FROM public.comunicacao_preferencias WHERE user_id<>actor OR id=cross_pref;
+    IF n<>0 THEN RAISE EXCEPTION 'cross user/client visible'; END IF;
+    denied:=denied+1;
+    -- No caller-supplied owner exists in the RPC contract; direct writes remain closed.
+    BEGIN
+      INSERT INTO public.comunicacao_preferencias(user_id,canal,source)
+        VALUES(CASE WHEN actor='cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid THEN 'a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid ELSE 'cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid END,'whatsapp','user');
+      RAISE EXCEPTION 'forged owner allowed';
+    EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    EXECUTE 'RESET ROLE';
+  END LOOP;
+  -- Real existing inactive/no-org users; never mutate their profiles or roles.
+  FOREACH actor IN ARRAY ARRAY['d856140b-26c9-4d6a-a5aa-8bea47e78fff'::uuid,'37303555-f734-4ba8-8d13-f8fa54603853'::uuid,NULL::uuid] LOOP
+    PERFORM set_config('request.jwt.claims',CASE WHEN actor IS NULL THEN '{}' ELSE jsonb_build_object('sub',actor,'role','authenticated','iat',extract(epoch FROM clock_timestamp())::bigint)::text END,true);
+    EXECUTE 'SET LOCAL ROLE authenticated';
+    IF public.h15_actor_organization() IS NOT NULL THEN RAISE EXCEPTION 'negative actor unexpectedly ready'; END IF;
+    BEGIN
+      PERFORM public.rpc_update_communication_preferences('in_app',false,NULL);
+      RAISE EXCEPTION 'invalid actor mutation allowed';
+    EXCEPTION WHEN insufficient_privilege THEN denied:=denied+1; END;
+    SELECT count(*) INTO n FROM public.comunicacao_preferencias;
+    IF n<>0 THEN RAISE EXCEPTION 'invalid actor read allowed'; END IF;
+    denied:=denied+1;
+    EXECUTE 'RESET ROLE';
+  END LOOP;
+  -- Exactly two own writes, two consent records, plus one explicit cross fixture.
+  SELECT count(*) INTO n FROM public.comunicacao_preferencias WHERE canal='in_app' AND user_id=ANY(ARRAY['cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid,'a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid]);
+  IF n<>2 THEN RAISE EXCEPTION 'positive writes mismatch'; END IF;
+  SELECT count(*) INTO n FROM public.comunicacao_consent_log WHERE user_id=ANY(ARRAY['cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid,'a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid]) AND canal='in_app';
+  IF n<>2 THEN RAISE EXCEPTION 'consent effects mismatch'; END IF;
+  IF positive<>2 OR denied<>10 THEN RAISE EXCEPTION 'coverage mismatch'; END IF;
+  RAISE EXCEPTION 'NOTIF3_PREFERENCES_ROLLBACK own=% denied=% run=% client=% preference=% link=% inactive_pref=% unowned_pref=%',positive,denied,run_id,cross_client,cross_pref,cross_link,inactive_pref,unowned_pref USING ERRCODE='P0001';
+END $proof$;
\ No newline at end of file
diff --git a/scripts/rbac-audit/multiportal-1-proof.sql b/scripts/rbac-audit/multiportal-1-proof.sql
new file mode 100644
index 000000000..73548f3fd
--- /dev/null
+++ b/scripts/rbac-audit/multiportal-1-proof.sql
@@ -0,0 +1,46 @@
+-- Canonical project swzpzcwiasxmjutrmvkm. No Auth/role/profile writes; preferences/logs rollback.
+BEGIN;
+DO $proof$
+DECLARE v jsonb; u uuid; n int:=0;
+BEGIN
+ IF NOT EXISTS(SELECT 1 FROM supabase_migrations.schema_migrations WHERE version='20261008150531') THEN RAISE EXCEPTION 'canonical_baseline_missing'; END IF;
+ PERFORM set_config('request.jwt.claim.sub','1298df7d-847b-442a-aacc-7f018d331aa6',true);
+ PERFORM set_config('request.jwt.claims',jsonb_build_object('sub','1298df7d-847b-442a-aacc-7f018d331aa6','role','authenticated','iat',extract(epoch from now())::bigint)::text,true);
+ v:=public.get_my_available_portal_contexts();
+ IF v->'available_contexts' <> '["admin","technical"]'::jsonb OR v->>'is_admin'<>'true' OR v->>'has_b2b_access'<>'true' THEN RAISE EXCEPTION 'multipapel_contexts_failed:%',v; END IF;
+ v:=public.set_my_context_preference('technical',true);
+ IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'technical_preference_failed'; END IF;
+ v:=public.get_my_available_portal_contexts();
+ IF v->>'preferred_context'<>'technical' OR v->>'skip_context_selector'<>'true' THEN RAISE EXCEPTION 'technical_preference_read_failed'; END IF;
+ v:=public.set_my_context_preference('admin',true);
+ IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'management_preference_failed'; END IF;
+ v:=public.register_my_login_redirect_secure('admin');
+ IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'management_log_failed'; END IF;
+ v:=public.set_my_context_preference('b2b',true);
+ IF v->>'ok'<>'false' THEN RAISE EXCEPTION 'invented_partner_context'; END IF;
+ v:=public.set_my_context_preference('admin',false);
+ IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'clear_preference_failed'; END IF;
+ v:=public.get_my_available_portal_contexts();
+ IF v->>'preferred_context' IS NOT NULL OR v->>'skip_context_selector'<>'false' THEN RAISE EXCEPTION 'preference_not_cleared'; END IF;
+ PERFORM set_config('request.jwt.claim.sub','70956249-6294-48da-a046-006b5cced0bb',true);
+ PERFORM set_config('request.jwt.claims',jsonb_build_object('sub','70956249-6294-48da-a046-006b5cced0bb','role','authenticated','iat',extract(epoch from now())::bigint)::text,true);
+ v:=public.get_my_available_portal_contexts();
+ IF NOT(v->'available_contexts' ? 'admin') OR NOT(v->>'has_b2b_access')::boolean THEN RAISE EXCEPTION 'legacy_admin_access_lost'; END IF;
+ IF EXISTS(SELECT 1 FROM public.user_access_preferences WHERE user_id=auth.uid()) THEN RAISE EXCEPTION 'preference_cross_identity'; END IF;
+ FOREACH u IN ARRAY ARRAY['d856140b-26c9-4d6a-a5aa-8bea47e78fff'::uuid,'ef031451-3fa1-462d-a792-f1e72f335257'::uuid] LOOP
+  PERFORM set_config('request.jwt.claim.sub',u::text,true);
+  PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',u,'role','authenticated','iat',extract(epoch from now())::bigint)::text,true);
+  v:=public.get_my_available_portal_contexts();
+  IF v->'available_contexts'<>'[]'::jsonb THEN RAISE EXCEPTION 'unready_contexts'; END IF;
+  BEGIN PERFORM public.set_my_context_preference('admin',true); RAISE EXCEPTION 'unready_write_allowed'; EXCEPTION WHEN raise_exception THEN IF SQLERRM<>'not authenticated' THEN RAISE; END IF; n:=n+1; END;
+  BEGIN PERFORM public.register_my_login_redirect_secure('admin'); RAISE EXCEPTION 'unready_log_allowed'; EXCEPTION WHEN raise_exception THEN IF SQLERRM<>'not authenticated' THEN RAISE; END IF; n:=n+1; END;
+ END LOOP;
+ PERFORM set_config('request.jwt.claim.sub','',true); PERFORM set_config('request.jwt.claims','{}',true);
+ v:=public.get_my_available_portal_contexts(); IF v->'available_contexts'<>'[]'::jsonb THEN RAISE EXCEPTION 'no_uid_contexts'; END IF;
+ BEGIN PERFORM public.set_my_context_preference('admin',true); RAISE EXCEPTION 'no_uid_write_allowed'; EXCEPTION WHEN raise_exception THEN IF SQLERRM<>'not authenticated' THEN RAISE; END IF; n:=n+1; END;
+ IF n<>5 THEN RAISE EXCEPTION 'proof_count'; END IF;
+ RAISE NOTICE 'MULTIPORTAL1 positive_management_technical=1 legacy_admin=1 b2b_denied=1 unready_mutations_denied=5; rollback required; SQL claims NOT JWT/API/browser';
+END $proof$;
+ROLLBACK;
+SELECT 'preferences' as source,count(*),md5(coalesce(string_agg(to_jsonb(t)::text,'' order by user_id),'')) hash FROM public.user_access_preferences t
+UNION ALL SELECT 'logs',count(*),md5(coalesce(string_agg(to_jsonb(t)::text,'' order by id),'')) FROM public.user_context_access_logs t;
diff --git a/scripts/rbac-audit/notification-p1-additional-proof.sql b/scripts/rbac-audit/notification-p1-additional-proof.sql
