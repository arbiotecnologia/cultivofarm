+CREATE OR REPLACE FUNCTION public.platform_transition_subscription(_organization_id uuid, _action text, _reason text, _correlation_id uuid, _plan_version_id uuid DEFAULT NULL::uuid)
+ RETURNS uuid
+ LANGUAGE plpgsql
+ SET search_path TO ''
+AS $function$
+DECLARE v_sub public.organization_subscriptions%ROWTYPE; v_version public.saas_plan_versions%ROWTYPE; v_now timestamptz:=now(); v_target public.saas_subscription_status; v_existing uuid;
+BEGIN
+  IF auth.uid() IS NULL OR NOT public.is_platform_superadmin(auth.uid()) THEN RAISE EXCEPTION 'platform_forbidden: apenas superadmin' USING ERRCODE='42501'; END IF;
+  IF _reason IS NULL OR length(btrim(_reason))<5 OR _correlation_id IS NULL THEN RAISE EXCEPTION 'platform_invalid: motivo e correlação obrigatórios' USING ERRCODE='22023'; END IF;
+  IF _action NOT IN ('start_trial','change_plan','mark_past_due','suspend','reactivate_manual','cancel','expire_trial') THEN RAISE EXCEPTION 'platform_invalid: ação inválida' USING ERRCODE='22023'; END IF;
+  SELECT h.subscription_id INTO v_existing FROM public.organization_subscription_history h WHERE h.correlation_id=_correlation_id;
+  IF v_existing IS NOT NULL THEN RETURN v_existing; END IF;
+  IF NOT EXISTS(SELECT 1 FROM public.organizations o WHERE o.id=_organization_id) THEN RAISE EXCEPTION 'platform_invalid: empresa inexistente' USING ERRCODE='22023'; END IF;
+  SELECT * INTO v_sub FROM public.organization_subscriptions s WHERE s.organization_id=_organization_id AND s.status IN('TRIAL','ACTIVE','PAST_DUE','SUSPENDED') ORDER BY s.started_at DESC LIMIT 1 FOR UPDATE;
+  SELECT h.subscription_id INTO v_existing FROM public.organization_subscription_history h WHERE h.correlation_id=_correlation_id;
+  IF v_existing IS NOT NULL THEN RETURN v_existing; END IF;
+  IF _plan_version_id IS NOT NULL THEN SELECT * INTO v_version FROM public.saas_plan_versions v WHERE v.id=_plan_version_id AND v.status='PUBLISHED' AND v.effective_from<=v_now AND (v.effective_to IS NULL OR v.effective_to>v_now); IF NOT FOUND THEN RAISE EXCEPTION 'platform_invalid: versão inexistente ou fora de vigência' USING ERRCODE='22023'; END IF; END IF;
+  IF _action='start_trial' THEN
+    IF v_sub.id IS NOT NULL OR _plan_version_id IS NULL THEN RAISE EXCEPTION 'platform_conflict: trial exige empresa sem assinatura corrente e versão vigente' USING ERRCODE='40001'; END IF;
+    IF EXISTS(SELECT 1 FROM public.organization_subscriptions s WHERE s.organization_id=_organization_id AND (s.status='TRIAL' OR EXISTS(SELECT 1 FROM public.organization_subscription_history h WHERE h.subscription_id=s.id AND (h.action='start_trial' OR h.new_status='TRIAL')))) THEN RAISE EXCEPTION 'platform_conflict: trial já utilizado' USING ERRCODE='40001'; END IF;
+    PERFORM platform_private.issue_ticket('saas_subscription_write',_organization_id);
+    PERFORM set_config('app.saas_change_reason',btrim(_reason),true); PERFORM set_config('app.saas_change_action',_action,true); PERFORM set_config('app.saas_correlation_id',_correlation_id::text,true);
+    INSERT INTO public.organization_subscriptions(organization_id,plan_id,plan_version_id,status,started_at,trial_ends_at,price_snapshot,currency_snapshot,billing_cycle,billing_cycle_snapshot,limits_snapshot,features_snapshot,state_changed_at,last_correlation_id,created_by)
+    VALUES(_organization_id,v_version.plan_id,v_version.id,'TRIAL',v_now,v_now+interval '14 days',v_version.price_amount,v_version.currency,v_version.billing_cycle,v_version.billing_cycle,v_version.limits_snapshot,v_version.features_snapshot,v_now,_correlation_id,auth.uid()) RETURNING * INTO v_sub;
+    RETURN v_sub.id;
+  END IF;
+  IF v_sub.id IS NULL THEN RAISE EXCEPTION 'platform_invalid: assinatura corrente inexistente' USING ERRCODE='22023'; END IF;
+  -- Assinatura legada (sem versão): só pode ser regularizada por change_plan para versão PUBLISHED e vigente.
+  IF v_sub.plan_version_id IS NULL AND NOT (_action='change_plan' AND _plan_version_id IS NOT NULL) THEN RAISE EXCEPTION 'platform_conflict: assinatura legada exige regularização explícita' USING ERRCODE='40001'; END IF;
+  IF _action='change_plan' AND _plan_version_id IS NULL THEN RAISE EXCEPTION 'platform_invalid: versão obrigatória' USING ERRCODE='22023'; END IF;
+  IF (_action='mark_past_due' AND v_sub.status<>'ACTIVE') OR (_action='suspend' AND v_sub.status NOT IN('ACTIVE','PAST_DUE')) OR (_action='reactivate_manual' AND v_sub.status<>'SUSPENDED') OR (_action='cancel' AND v_sub.status NOT IN('TRIAL','ACTIVE','PAST_DUE','SUSPENDED')) OR (_action='expire_trial' AND (v_sub.status<>'TRIAL' OR v_sub.trial_ends_at IS NULL OR v_sub.trial_ends_at>v_now)) THEN RAISE EXCEPTION 'platform_conflict: transição inválida' USING ERRCODE='40001'; END IF;
+  v_target:=CASE _action WHEN 'mark_past_due' THEN 'PAST_DUE'::public.saas_subscription_status WHEN 'suspend' THEN 'SUSPENDED'::public.saas_subscription_status WHEN 'reactivate_manual' THEN 'ACTIVE'::public.saas_subscription_status WHEN 'cancel' THEN 'CANCELLED'::public.saas_subscription_status WHEN 'expire_trial' THEN 'EXPIRED'::public.saas_subscription_status ELSE v_sub.status END;
+  PERFORM platform_private.issue_ticket('saas_subscription_write',_organization_id);
+  PERFORM set_config('app.saas_change_reason',btrim(_reason),true); PERFORM set_config('app.saas_change_action',_action,true); PERFORM set_config('app.saas_correlation_id',_correlation_id::text,true);
+  UPDATE public.organization_subscriptions s SET plan_id=CASE WHEN _action='change_plan' THEN v_version.plan_id ELSE s.plan_id END,plan_version_id=CASE WHEN _action='change_plan' THEN v_version.id ELSE s.plan_version_id END,status=v_target,price_snapshot=CASE WHEN _action='change_plan' THEN v_version.price_amount ELSE s.price_snapshot END,currency_snapshot=CASE WHEN _action='change_plan' THEN v_version.currency ELSE s.currency_snapshot END,billing_cycle=CASE WHEN _action='change_plan' THEN v_version.billing_cycle ELSE s.billing_cycle END,billing_cycle_snapshot=CASE WHEN _action='change_plan' THEN v_version.billing_cycle ELSE s.billing_cycle_snapshot END,limits_snapshot=CASE WHEN _action='change_plan' THEN v_version.limits_snapshot ELSE s.limits_snapshot END,features_snapshot=CASE WHEN _action='change_plan' THEN v_version.features_snapshot ELSE s.features_snapshot END,suspended_at=CASE WHEN v_target='SUSPENDED' THEN coalesce(s.suspended_at,v_now) ELSE NULL END,cancelled_at=CASE WHEN v_target='CANCELLED' THEN coalesce(s.cancelled_at,v_now) ELSE NULL END,state_changed_at=v_now,last_correlation_id=_correlation_id WHERE s.id=v_sub.id;
+  RETURN v_sub.id;
+END;
+$function$;
+REVOKE ALL ON FUNCTION public.platform_transition_subscription(uuid,text,text,uuid,uuid) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.platform_transition_subscription(uuid,text,text,uuid,uuid) TO authenticated, service_role;
