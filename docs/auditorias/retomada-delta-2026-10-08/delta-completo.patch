+ actors uuid[] := ARRAY['a7d45277-6dec-413d-bf6b-86620c1ef39f'::uuid,
+   'cbdc4ef3-005a-4674-8ea3-4410c7d7d212'::uuid,
+   '28c5f1ca-32a7-4826-b1ee-8fb93c5a5ab9'::uuid, NULL::uuid];
