+  useVersoesPlanosSaaS: () => versoes,
+  useCatalogoPlanosSaaS: () => catalogo,
+  useSalvarRascunhoPlano: () => idle,
+  useValidarRascunhoPlano: () => idle,
+  usePublicarRascunhoPlano: () => idle,
