# Variáveis obrigatórias para o kit de implantação — Fases 1/2/4 do módulo de Comunicação.
# NÃO commitar valores reais. Exportar no shell antes de rodar os scripts.

# Confirmação dupla — os dois valores devem ser IDÊNTICOS.
STAGING_PROJECT_REF=example-staging-ref
STAGING_CONFIRM_REF=example-staging-ref

# DSN do banco (apenas staging). Nunca produção.
STAGING_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Somente defina se souber, fora do repositório, que o ref configurado do
# projeto (navfzbwgwzruipouyfnk) corresponde ao STAGING real. Caso contrário,
# deixe em branco/false: os scripts recusarão esse ref por padrão.
I_UNDERSTAND_CONFIGURED_REF_IS_STAGING=false

# Opcional — aplicar seeds da Fase 2 no staging (rodam APÓS migration/postcheck/harness).
APPLY_COMMUNICATION_SEEDS=false

# Somente para rollback (Fase 2). Exige confirmação explícita.
ROLLBACK_COMMUNICATION=false

# Somente para rollback da Fase 4 isoladamente (aditiva sobre Fase 2).
ROLLBACK_COMMUNICATION_FASE4=false

# ─────────────────────────────────────────────────────────────────────────────
# Verificação REAL de flags OFF via communication-health (opcional).
# STAGING_TEST_ADMIN_JWT é um SEGREDO — obter fora do repositório, exportar
# apenas no shell da máquina que roda verify-staging.sh. Nunca commitar.
# O endpoint é derivado internamente e é IMUTÁVEL:
#   https://<STAGING_PROJECT_REF>.supabase.co/functions/v1/communication-health
# NÃO existe variável de URL/host — evita exfiltração do JWT para hosts externos.
# ─────────────────────────────────────────────────────────────────────────────
STAGING_TEST_ADMIN_JWT=

# ─────────────────────────────────────────────────────────────────────────────
# Fase 4 — Webhook WhatsApp (Meta Cloud API). Nomes documentados, SEM valores.
# Os valores reais moram em Project Settings → Secrets do Supabase e nunca no
# repositório. O kit NÃO envia esses segredos ao webhook; eles são lidos pela
# Edge Function em runtime.
#   WHATSAPP_APP_SECRET             (obrigatório) — HMAC do X-Hub-Signature-256
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN   (obrigatório) — challenge GET Meta
#   WHATSAPP_PHONE_NUMBER_ID        (obrigatório, numérico; reaproveitado do worker)
#   WHATSAPP_WEBHOOK_ENABLED        (feature flag REAL: quando != "true", o POST
#                                    com assinatura válida responde 200 disabled
#                                    e NÃO grava nada em banco. GET challenge
#                                    continua funcionando para configuração.)
# ─────────────────────────────────────────────────────────────────────────────

# Internos — os scripts setam automaticamente conforme o caso; não exportar à mão.
REQUIRE_SUPABASE_CLI=false
REQUIRE_DATABASE=true
