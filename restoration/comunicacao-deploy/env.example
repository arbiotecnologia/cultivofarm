# Variáveis obrigatórias para o kit de implantação — Fase 3.
# NÃO commitar valores reais. Exportar no shell antes de rodar os scripts.

# Confirmação dupla — os dois valores devem ser IDÊNTICOS.
STAGING_PROJECT_REF=example-staging-ref
STAGING_CONFIRM_REF=example-staging-ref

# DSN do banco (apenas staging). Nunca produção.
STAGING_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Somente defina se souber, fora do repositório, que o ref configurado do
# projeto (navfzbwgwzruipouyfnk) corresponde ao STAGING real. Caso contrário,
# deixe em branco/false: os scripts recusarão esse ref por padrão.
I_UNDERSTAND_CONFIGURED_REF_IS_STAGING=false

# Opcional — aplicar seeds da Fase 2 no staging (rodam APÓS migration/postcheck/harness).
APPLY_COMMUNICATION_SEEDS=false

# Somente para rollback (Fase 2). Exige confirmação explícita.
ROLLBACK_COMMUNICATION=false

# ─────────────────────────────────────────────────────────────────────────────
# Verificação REAL de flags OFF via communication-health (opcional).
# STAGING_TEST_ADMIN_JWT é um SEGREDO — obter fora do repositório, exportar
# apenas no shell da máquina que roda verify-staging.sh. Nunca commitar.
# STAGING_API_URL é opcional; se ausente, verify-staging.sh deriva de
# STAGING_PROJECT_REF: https://<ref>.functions.supabase.co
# ─────────────────────────────────────────────────────────────────────────────
STAGING_TEST_ADMIN_JWT=
STAGING_API_URL=

# Interno — os scripts de deploy de funções setam automaticamente.
REQUIRE_SUPABASE_CLI=false
