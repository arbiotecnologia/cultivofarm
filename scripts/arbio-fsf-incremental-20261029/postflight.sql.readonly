-- Read-only: compare exact new body/ACL/DDL with the reviewed build; no business RPC calls.
SELECT oid::regprocedure::text,md5(pg_get_functiondef(oid)),proacl,prosecdef,proconfig FROM pg_proc WHERE oid IN ('public.approve_b2b_credit(uuid,text)'::regprocedure,'public.fn_b2b_guard_credit_approval_fields()'::regprocedure,'public.tg_partner_orders_credit_guard()'::regprocedure,'platform_private.b2b_credit_config_block(uuid)'::regprocedure,'platform_private.b2b_credit_internal_authority(uuid,uuid)'::regprocedure);
SELECT pg_get_triggerdef(oid),tgenabled FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname IN ('trg_partner_orders_credit_guard','trg_b2b_guard_credit_approval_fields');
SELECT count(*) AS tickets_must_be_zero FROM platform_private.credit_approval_tickets_20261029;
SELECT policyname,permissive,qual,with_check FROM pg_policies WHERE schemaname='public' AND tablename='organizations';
DO $post$ BEGIN
IF md5(pg_get_functiondef('platform_private.b2b_credit_config_block(uuid)'::regprocedure)) IS DISTINCT FROM '582b943911a63a3e3391770fea5f7fbb' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
IF md5(pg_get_functiondef('platform_private.b2b_credit_internal_authority(uuid,uuid)'::regprocedure)) IS DISTINCT FROM '897a89edb970aa0772c38035854891b6' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
IF md5(pg_get_functiondef('public.approve_b2b_credit(uuid,text)'::regprocedure)) IS DISTINCT FROM '53673ea183c6f0a1fd4e7861f20e52a0' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
IF md5(pg_get_functiondef('public.fn_b2b_guard_credit_approval_fields()'::regprocedure)) IS DISTINCT FROM '3bac4722eb855a6932057f42f28b3850' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
IF md5(pg_get_functiondef('public.tg_partner_orders_credit_guard()'::regprocedure)) IS DISTINCT FROM 'c09a79e48bea260679d82adf1616fcc8' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
IF EXISTS(SELECT 1 FROM platform_private.credit_approval_tickets_20261029) THEN RAISE EXCEPTION 'POST_TICKET_RESIDUE'; END IF;
IF (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid='public.approve_b2b_credit(uuid,text)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.approve_b2b_credit(uuid,text)'::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'POST_FUNCTION_ACL_OWNER_DRIFT'; END IF;
IF (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid='public.fn_b2b_guard_credit_approval_fields()'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.fn_b2b_guard_credit_approval_fields()'::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'POST_FUNCTION_ACL_OWNER_DRIFT'; END IF;
IF (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid='public.tg_partner_orders_credit_guard()'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.tg_partner_orders_credit_guard()'::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'POST_FUNCTION_ACL_OWNER_DRIFT'; END IF;
IF (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid='platform_private.b2b_credit_config_block(uuid)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='platform_private.b2b_credit_config_block(uuid)'::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'POST_FUNCTION_ACL_OWNER_DRIFT'; END IF;
IF (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid='platform_private.b2b_credit_internal_authority(uuid,uuid)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='platform_private.b2b_credit_internal_authority(uuid,uuid)'::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'POST_FUNCTION_ACL_OWNER_DRIFT'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='trg_b2b_guard_credit_approval_fields' AND pg_get_triggerdef(oid)='CREATE TRIGGER trg_b2b_guard_credit_approval_fields BEFORE UPDATE ON public.partner_orders FOR EACH ROW EXECUTE FUNCTION fn_b2b_guard_credit_approval_fields()' AND tgenabled='O') THEN RAISE EXCEPTION 'POST_TRIGGER_DRIFT'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='trg_partner_orders_credit_guard' AND pg_get_triggerdef(oid)='CREATE TRIGGER trg_partner_orders_credit_guard BEFORE INSERT OR UPDATE OF status, total, final_amount_with_interest, credit_approved_by ON public.partner_orders FOR EACH ROW EXECUTE FUNCTION tg_partner_orders_credit_guard()' AND tgenabled='O') THEN RAISE EXCEPTION 'POST_TRIGGER_DRIFT'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_class WHERE oid='platform_private.credit_approval_tickets_20261029'::regclass AND relrowsecurity AND pg_get_userbyid(relowner)='postgres' AND relacl::text='{postgres=arwdDxtm/postgres}') THEN RAISE EXCEPTION 'POST_TICKET_ACL_RLS_DRIFT'; END IF;
END $post$;
