-- Emergency rollback candidate: keep origin deny/CDN containment intact.
BEGIN;
CREATE OR REPLACE FUNCTION public.client_document_download_snapshot(_name text)
RETURNS jsonb LANGUAGE sql STABLE SECURITY INVOKER SET search_path = ''
