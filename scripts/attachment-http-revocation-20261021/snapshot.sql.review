-- REVIEW ONLY. Do not execute; no migration or hosted mutation authorized.
-- Single statement snapshot; INVOKER preserves all current table RLS.
BEGIN;
CREATE OR REPLACE FUNCTION public.client_document_download_snapshot(_name text)
RETURNS jsonb LANGUAGE sql STABLE SECURITY INVOKER SET search_path = '' AS $fn$
  WITH actor AS MATERIALIZED (
    SELECT auth.uid() AS uid, public.h15_actor_organization() AS org
    WHERE auth.uid() IS NOT NULL
      AND length(_name) BETWEEN 1 AND 1024
      AND public.cliente_storage_object_permitted(_name)
  ), roles AS MATERIALIZED (
    SELECT jsonb_agg(r.role::text ORDER BY r.role::text) AS value
    FROM public.user_roles r JOIN actor a ON r.user_id = a.uid
  ), docs AS MATERIALIZED (
    SELECT d.id, d.cliente_id, d.arquivo_path, d.tamanho_bytes, d.mime, a.uid, a.org
    FROM public.cliente_documentos d
    JOIN public.clientes c ON c.id = d.cliente_id
    JOIN actor a ON c.organization_id = a.org
    WHERE d.arquivo_path = _name
      AND public.can_user_access_cliente(c.id)
  )
  SELECT CASE WHEN (SELECT count(*) FROM docs) = 1
    AND jsonb_array_length(coalesce((SELECT value FROM roles), '[]'::jsonb)) > 0
    THEN (SELECT jsonb_build_object('actor', uid, 'tenant', org,
      'roles', (SELECT value FROM roles), 'document', id, 'client', cliente_id,
      'path', arquivo_path, 'size', tamanho_bytes, 'mime', mime) FROM docs)
    ELSE NULL END;
$fn$;
REVOKE ALL ON FUNCTION public.client_document_download_snapshot(text) FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION public.client_document_download_snapshot(text) TO authenticated;
-- No table grants, no RLS widening, no claims/GUC privilege, no role mutation.
COMMIT;