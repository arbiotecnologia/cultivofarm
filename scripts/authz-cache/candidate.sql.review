-- CANDIDATO v4. NÃO INSTALAR. Destino exclusivo swzpzcwiasxmjutrmvkm.
-- Executor deve comprovar ref fora do SQL. Gate frontend continua false.
-- Sem alterações em dados, principal, associações, RLS ou grants globais.
-- Schema dedicado: USAGE/EXECUTE mínimos permitem wrapper INVOKER.
-- Core SEM parâmetros deriva auth.uid(): chamada direta também é self-only.
BEGIN;
DO $preflight$
DECLARE contract record; p record;
BEGIN
 IF to_regnamespace('authz_cache_private') IS NOT NULL
 OR to_regprocedure('public.get_my_authz_fingerprint()') IS NOT NULL
 OR to_regprocedure('public._authz_fingerprint_core(uuid)') IS NOT NULL THEN
   RAISE EXCEPTION 'authz_candidate_destination_occupied';
 END IF;
 FOR contract IN SELECT * FROM (VALUES
   ('public.get_cliente_ids_for_user(uuid)','v','c80d5900692d960f649d0a9f7850fe2c'),
   ('platform_private.producer_commercial_client_scope(uuid)','s','49b8329ce232670c1560f0683b913a26'),
   ('platform_private.b2b_commercial_context()','s','02158d4204dea67308558f649113ba6d')
 ) c(signature,volatility,definition_md5) LOOP
   SELECT x.prosecdef,x.prorettype,x.provolatile,x.proconfig,x.proowner INTO p
     FROM pg_catalog.pg_proc x WHERE x.oid=to_regprocedure(contract.signature);
   IF NOT FOUND OR p.prosecdef IS DISTINCT FROM true OR p.provolatile::text IS DISTINCT FROM contract.volatility
      OR p.proowner IS DISTINCT FROM 'postgres'::regrole THEN
     RAISE EXCEPTION 'authz_canonical_resolver_drift: %',contract.signature;
   END IF;
   IF md5(pg_get_functiondef(to_regprocedure(contract.signature))) IS DISTINCT FROM contract.definition_md5 THEN
     RAISE EXCEPTION 'authz_canonical_definition_drift: %',contract.signature;
   END IF;
 END LOOP;
 -- Hashes documentados do hosted: não substituir por migration histórica.
 IF md5(pg_get_functiondef('public.get_cliente_ids_for_user(uuid)'::regprocedure))
      IS DISTINCT FROM 'c80d5900692d960f649d0a9f7850fe2c'
 OR md5(pg_get_functiondef('platform_private.producer_commercial_client_scope(uuid)'::regprocedure))
      IS DISTINCT FROM '49b8329ce232670c1560f0683b913a26' THEN
   RAISE EXCEPTION 'authz_membership_definition_drift';
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_proc p
   WHERE p.oid='platform_private.b2b_commercial_context()'::regprocedure
   AND p.proconfig IS NOT DISTINCT FROM ARRAY['search_path=""']::text[]
   AND p.prorettype='jsonb'::regtype) THEN
   RAISE EXCEPTION 'authz_b2b_contract_drift';
 END IF;
 IF EXISTS(SELECT 1 FROM (VALUES
   ('profiles','user_id'),('profiles','ativo'),('profiles','senha_provisoria'),('profiles','organization_id'),('profiles','updated_at'),
   ('organizations','id'),('organizations','ativo'),('organizations','status'),('organizations','partner_account_id'),('organizations','updated_at'),
   ('user_clientes','id'),('user_clientes','user_id'),('user_clientes','cliente_id'),
   ('clientes','id'),('clientes','status_cliente'),('clientes','organization_id'),
   ('partner_users','id'),('partner_users','user_id'),('partner_users','partner_id'),('partner_users','papel'),
   ('partner_accounts','id'),('partner_accounts','ativo'),('partner_accounts','deleted_at'),('partner_accounts','updated_at'),('partner_accounts','commercial_owner_organization_id')
 ) expected(tbl,col) WHERE NOT EXISTS(SELECT 1 FROM information_schema.columns c
   WHERE c.table_schema='public' AND c.table_name=expected.tbl AND c.column_name=expected.col)) THEN
   RAISE EXCEPTION 'authz_fingerprint_columns_drift';
 END IF;
END $preflight$;
CREATE SCHEMA authz_cache_private AUTHORIZATION postgres;
REVOKE ALL ON SCHEMA authz_cache_private FROM PUBLIC,anon,authenticated,service_role;
GRANT USAGE ON SCHEMA authz_cache_private TO authenticated;
CREATE FUNCTION authz_cache_private.get_my_fingerprint_core()
 RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $core$
DECLARE
 u uuid:=auth.uid(); p public.profiles%ROWTYPE; o public.organizations%ROWTYPE;
 roles jsonb; links jsonb; partners jsonb; clients uuid[]; b2b jsonb;
 eligible boolean:=false; payload jsonb;
BEGIN
 IF u IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
 SELECT * INTO p FROM public.profiles WHERE user_id=u;
 IF NOT FOUND OR p.ativo IS DISTINCT FROM true OR p.senha_provisoria IS DISTINCT FROM false
    OR p.organization_id IS NULL THEN
   RETURN jsonb_build_object('eligible',false,'fingerprint',NULL);
 END IF;
 SELECT * INTO o FROM public.organizations WHERE id=p.organization_id;
 IF NOT FOUND OR o.ativo IS DISTINCT FROM true OR o.status IS DISTINCT FROM 'ativa' THEN
   RETURN jsonb_build_object('eligible',false,'fingerprint',NULL);
 END IF;
 SELECT coalesce(jsonb_agg(r.role::text ORDER BY r.role::text),'[]'::jsonb)
 INTO roles FROM public.user_roles r WHERE r.user_id=u;
 -- This small external-only candidate does not invent a mixed-role context.
 IF jsonb_array_length(roles) IS DISTINCT FROM 1 THEN
   RETURN jsonb_build_object('eligible',false,'fingerprint',NULL);
 END IF;
 -- Branches match role AND its canonical resolver, never role OR generic link.
 IF EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=u AND r.role::text='cliente_produtor') THEN
   clients:=public.get_cliente_ids_for_user(u);
   SELECT EXISTS(SELECT 1 FROM unnest(clients) c(id)
     WHERE platform_private.producer_commercial_client_scope(c.id) IS TRUE) INTO eligible;
 ELSIF EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=u
     AND r.role::text IN ('parceiro_b2b','parceiro_b2b_tecnico')) THEN
   b2b:=platform_private.b2b_commercial_context();
   eligible:=b2b IS NOT NULL;
 END IF;
 IF eligible IS DISTINCT FROM true THEN
   RETURN jsonb_build_object('eligible',false,'fingerprint',NULL);
 END IF;
 -- Full link state (no fictional partner_users flags), canonical resolved IDs,
 -- tenant activity, deleted partner and role/papel; no IDs returned to caller.
 SELECT coalesce(jsonb_agg(jsonb_build_object('link',to_jsonb(uc),
   'client',jsonb_build_object('id',c.id,'status',c.status_cliente,'org',c.organization_id),
   'current',uc.cliente_id=ANY(coalesce(clients,ARRAY[]::uuid[]))) ORDER BY uc.id),'[]'::jsonb)
 INTO links FROM public.user_clientes uc LEFT JOIN public.clientes c ON c.id=uc.cliente_id WHERE uc.user_id=u;
 SELECT coalesce(jsonb_agg(jsonb_build_object('link',to_jsonb(pu),
   'partner',jsonb_build_object('id',pa.id,'active',pa.ativo,'deleted',pa.deleted_at,
     'owner',pa.commercial_owner_organization_id,'updated',pa.updated_at)) ORDER BY pu.id),'[]'::jsonb)
 INTO partners FROM public.partner_users pu LEFT JOIN public.partner_accounts pa ON pa.id=pu.partner_id WHERE pu.user_id=u;
 payload:=jsonb_build_object('profile_revision',p.updated_at,'org',p.organization_id,
   'organization_active',o.ativo,'organization_status',o.status,'organization_partner',o.partner_account_id,
   'organization_revision',o.updated_at,'roles',roles,'clients',clients,'links',links,'partners',partners,'b2b',b2b);
 RETURN jsonb_build_object('eligible',true,'fingerprint',md5(payload::text));
END $core$;
REVOKE ALL ON FUNCTION authz_cache_private.get_my_fingerprint_core() FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION authz_cache_private.get_my_fingerprint_core() TO authenticated;
CREATE FUNCTION public.get_my_authz_fingerprint()
 RETURNS jsonb LANGUAGE sql VOLATILE SECURITY INVOKER SET search_path='' AS $wrapper$
 SELECT authz_cache_private.get_my_fingerprint_core();
$wrapper$;
REVOKE ALL ON FUNCTION public.get_my_authz_fingerprint() FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.get_my_authz_fingerprint() TO authenticated;
COMMIT;
