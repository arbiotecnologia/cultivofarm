-- Somente catálogo; executar manualmente APENAS no projeto vrlcdwmlytukrjezrrnf.
-- Não comprova ref pelo SQL: operador deve conferir URL/ref no painel antes de executar.
WITH wanted(name) AS (VALUES
('platform_private.b2b_allocation_reversals'),
('platform_private.b2b_authorized_documents'),
('platform_private.b2b_cancel_policy_allowlist_v1'),
('platform_private.b2b_cancel_policy_gate_v1'),
('platform_private.b2b_cancellation_attestations'),
('platform_private.b2b_condition_versions'),
('platform_private.b2b_document_allocations'),
('platform_private.b2b_financial_forecast_events'),
('platform_private.b2b_financial_forecasts'),
('platform_private.b2b_fiscal_invoice_snapshots'),
('platform_private.b2b_fiscal_service_permits'),
('platform_private.b2b_forecast_consultation_links_v1'),
('platform_private.b2b_forecast_creation_allowlist_v1'),
('platform_private.b2b_forecast_creation_gate_v1'),
('platform_private.b2b_forecast_lifecycle_allowlist_v1'),
('platform_private.b2b_forecast_lifecycle_gate_v1'),
('platform_private.b2b_order_condition_quote_snapshots'),
('platform_private.b2b_order_condition_snapshots'),
('platform_private.b2b_title_permits'),
('platform_private.b4_order_condition_snapshots'),
('platform_private.c2_order_partner_recipients'),
('platform_private.financial_initial_installments'),
('platform_private.fiscal_close_pending'),
('platform_private.holiday_calendars'),
('platform_private.price_schedule_snapshots'),
('public.accounts_receivable'),
('public.accounts_receivable_installments'),
('public.bank_accounts'),
('public.cf_user_guards_v1'),
('public.clientes'),
('public.commercial_payment_plan_assignments'),
('public.commercial_payment_plans'),
('public.company_fiscal_settings'),
('public.entregas'),
('public.estoque_produto'),
('public.financial_audit_log'),
('public.financial_categories'),
('public.financial_settings'),
('public.fiscal_audit_log'),
('public.fiscal_environment_marker'),
('public.fiscal_events'),
('public.fiscal_invoice_items'),
('public.fiscal_invoices'),
('public.fiscal_sefaz_transmissions'),
('public.fiscal_xml_runs'),
('public.h15_actor_organization'),
('public.notificacoes_operacionais'),
('public.organization_feature_overrides'),
('public.organizations'),
('public.partner_accounts'),
('public.partner_financial_settings'),
('public.partner_order_audit_logs'),
('public.partner_order_financial_links'),
('public.partner_order_items'),
('public.partner_order_payment_schedule'),
('public.partner_order_payment_terms'),
('public.partner_orders'),
('public.payment_methods'),
('public.profiles'),
('public.receivable_payments'),
('public.saas_features'),
('public.user_roles'),
('public.v_fiscal_document_reconciliation_pending'),
('public.v_fiscal_sefaz_event_state')
) SELECT w.name,c.oid IS NOT NULL AS present,c.relkind,pg_get_userbyid(c.relowner) AS owner,c.relacl::text AS raw_acl,c.relrowsecurity,c.relforcerowsecurity,
(SELECT jsonb_agg(jsonb_build_object('name',a.attname,'type',format_type(a.atttypid,a.atttypmod),'not_null',a.attnotnull,'identity',a.attidentity,'generated',a.attgenerated,'default',pg_get_expr(d.adbin,d.adrelid),'collation',a.attcollation::regcollation::text) ORDER BY a.attnum) FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped) AS columns,
(SELECT jsonb_agg(jsonb_build_object('name',x.conname,'type',x.contype,'validated',x.convalidated,'definition',pg_get_constraintdef(x.oid,true),'target',x.confrelid::regclass::text) ORDER BY x.conname) FROM pg_constraint x WHERE x.conrelid=c.oid) AS constraints,
(SELECT jsonb_agg(pg_get_indexdef(x.indexrelid) ORDER BY x.indexrelid::regclass::text) FROM pg_index x WHERE x.indrelid=c.oid) AS indexes,
(SELECT jsonb_agg(jsonb_build_object('name',t.tgname,'enabled',t.tgenabled,'definition',pg_get_triggerdef(t.oid,true),'function',t.tgfoid::regprocedure::text,'body_md5',md5(pg_get_functiondef(t.tgfoid))) ORDER BY t.tgname) FROM pg_trigger t WHERE t.tgrelid=c.oid AND NOT t.tgisinternal) AS triggers,
(SELECT jsonb_agg(jsonb_build_object('name',p.polname,'command',p.polcmd,'permissive',p.polpermissive,'roles',p.polroles,'using',pg_get_expr(p.polqual,p.polrelid),'check',pg_get_expr(p.polwithcheck,p.polrelid)) ORDER BY p.polname) FROM pg_policy p WHERE p.polrelid=c.oid) AS policies,
(SELECT jsonb_agg(jsonb_build_object('grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,'privilege',a.privilege_type,'grantable',a.is_grantable) ORDER BY a.grantee,a.privilege_type) FROM aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a) AS effective_acl,
CASE WHEN c.relkind IN ('v','m') THEN pg_get_viewdef(c.oid,true) END AS view_definition
FROM wanted w LEFT JOIN pg_class c ON c.oid=to_regclass(w.name) ORDER BY w.name;
