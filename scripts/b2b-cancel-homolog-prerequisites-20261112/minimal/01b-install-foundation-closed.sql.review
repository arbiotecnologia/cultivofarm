-- HOMOLOG ONLY vrlcdwmlytukrjezrrnf; review-only; psql -v ON_ERROR_STOP=1 -v approved_event_trigger_md5=<MD5 FROM THE SEVEN CAPTURED EVENT TRIGGERS>
BEGIN;SET LOCAL lock_timeout='3s';
CREATE TEMP TABLE cancel_homolog_review_pins(event_md5 text) ON COMMIT DROP;
INSERT INTO cancel_homolog_review_pins VALUES (:'approved_event_trigger_md5');
DO $pre$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF (SELECT event_md5 FROM cancel_homolog_review_pins) IS DISTINCT FROM (SELECT md5(coalesce(jsonb_agg(jsonb_build_array(evtname,evtevent,evtenabled,evttags,evtfoid::regprocedure::text,md5(pg_get_functiondef(evtfoid))) ORDER BY evtname COLLATE "C")::text,'null')) FROM pg_event_trigger) THEN RAISE EXCEPTION 'HOMOLOG_EVENT_TRIGGER_PIN_REQUIRED'; END IF;
 IF (SELECT format_type(atttypid,atttypmod) FROM pg_attribute WHERE attrelid='public.partner_orders'::regclass AND attname='id' AND NOT attisdropped) IS DISTINCT FROM 'uuid' OR NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.partner_orders'::regclass AND contype='p' AND conkey=ARRAY[(SELECT attnum FROM pg_attribute WHERE attrelid='public.partner_orders'::regclass AND attname='id')]::smallint[]) THEN RAISE EXCEPTION 'HOMOLOG_ORDER_PARENT_SHAPE'; END IF;
END $pre$;
DO $absence$ BEGIN
IF to_regclass('platform_private.b2b_financial_forecasts') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_financial_forecasts'; END IF;
IF to_regclass('platform_private.b2b_financial_forecast_events') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_financial_forecast_events'; END IF;
IF to_regclass('platform_private.b2b_forecast_creation_gate_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_forecast_creation_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_creation_allowlist_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_forecast_creation_allowlist_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_lifecycle_gate_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_forecast_lifecycle_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_lifecycle_allowlist_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_ALREADY_PRESENT:b2b_forecast_lifecycle_allowlist_v1'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_events_immutable()') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_financial_forecast_events_immutable()'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_guard()') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_financial_forecast_guard()'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_PRESENT:b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)'; END IF;
END $absence$;
CREATE TEMP TABLE cancel_homolog_before ON COMMIT DROP AS SELECT md5(jsonb_build_object(
 'functions',(SELECT jsonb_agg(jsonb_build_array(p.oid::regprocedure::text,md5(pg_get_functiondef(p.oid)),p.proowner,p.proacl,p.proconfig) ORDER BY p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('public','auth','storage') AND p.prokind='f'),
 'relations',(SELECT jsonb_agg(jsonb_build_array(c.oid,c.relacl,c.relowner,c.relrowsecurity,c.relforcerowsecurity) ORDER BY c.oid) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage')),
 'triggers',(SELECT jsonb_agg(jsonb_build_array(t.oid,t.tgenabled,pg_get_triggerdef(t.oid)) ORDER BY t.oid) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage') AND NOT t.tgisinternal),
 'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY p.oid) FROM pg_policy p JOIN pg_class c ON c.oid=p.polrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage')),
 'memberships',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m))::text) AS fingerprint;
CREATE TABLE platform_private.b2b_financial_forecasts(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),order_id uuid NOT NULL UNIQUE REFERENCES public.partner_orders(id),
 organization_id uuid NOT NULL,partner_id uuid NOT NULL,total_amount numeric(14,2) NOT NULL CHECK(total_amount>0),
 residual_amount numeric(14,2) NOT NULL CHECK(residual_amount>=0 AND residual_amount<=total_amount),
 state text NOT NULL CHECK(state IN ('aguardando_fiscal','emissao_em_andamento','consulta_fiscal_obrigatoria','faturado_parcial','faturado_total','cancelado_antes_nf','cancelado_residual')),
 due_dates_estimated boolean NOT NULL DEFAULT true CHECK(due_dates_estimated),economic_snapshot jsonb NOT NULL,
 schedule_snapshot jsonb NOT NULL CHECK(jsonb_typeof(schedule_snapshot)='array'),items_snapshot jsonb NOT NULL CHECK(jsonb_typeof(items_snapshot)='array'),
 credit_decision_snapshot jsonb NOT NULL,commercial_approved_by uuid NOT NULL,commercial_approved_at timestamptz NOT NULL,
 credit_approved_by uuid,credit_approved_at timestamptz,fiscal_intent_id uuid,last_error_code text,
 version integer NOT NULL DEFAULT 1 CHECK(version>0),created_at timestamptz NOT NULL DEFAULT now(),updated_at timestamptz NOT NULL DEFAULT now());
ALTER TABLE platform_private.b2b_financial_forecasts ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_financial_forecasts FROM PUBLIC,anon,authenticated,service_role;
CREATE TABLE platform_private.b2b_financial_forecast_events(
 id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,forecast_id uuid NOT NULL REFERENCES platform_private.b2b_financial_forecasts(id),
 event_type text NOT NULL,event_reference text NOT NULL,payload jsonb NOT NULL DEFAULT '{}'::jsonb,actor_id uuid,created_at timestamptz NOT NULL DEFAULT now(),
 UNIQUE(forecast_id,event_type,event_reference));
ALTER TABLE platform_private.b2b_financial_forecast_events ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_financial_forecast_events FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.b2b_financial_forecast_events_immutable() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$BEGIN RAISE EXCEPTION 'B2B_FORECAST_EVENT_IMMUTABLE' USING ERRCODE='42501';END$$;
CREATE TRIGGER b2b_forecast_events_no_change BEFORE UPDATE OR DELETE ON platform_private.b2b_financial_forecast_events
FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_financial_forecast_events_immutable();
CREATE FUNCTION platform_private.b2b_financial_forecast_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'B2B_FORECAST_DELETE_DENIED' USING ERRCODE='42501';END IF;
 IF (NEW.order_id,NEW.organization_id,NEW.partner_id,NEW.total_amount,NEW.due_dates_estimated,NEW.economic_snapshot,
     NEW.schedule_snapshot,NEW.items_snapshot,NEW.credit_decision_snapshot,NEW.commercial_approved_by,NEW.commercial_approved_at,
     NEW.credit_approved_by,NEW.credit_approved_at)
    IS DISTINCT FROM
    (OLD.order_id,OLD.organization_id,OLD.partner_id,OLD.total_amount,OLD.due_dates_estimated,OLD.economic_snapshot,
     OLD.schedule_snapshot,OLD.items_snapshot,OLD.credit_decision_snapshot,OLD.commercial_approved_by,OLD.commercial_approved_at,
     OLD.credit_approved_by,OLD.credit_approved_at)
 THEN RAISE EXCEPTION 'B2B_FORECAST_ECONOMIC_IMMUTABLE' USING ERRCODE='42501';END IF;
 IF NEW.version<>OLD.version+1 THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_REQUIRED' USING ERRCODE='PT409';END IF;
 RETURN NEW;
END$$;
CREATE TRIGGER b2b_forecast_guard BEFORE UPDATE OR DELETE ON platform_private.b2b_financial_forecasts
FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_financial_forecast_guard();

-- Review cf7d5fb/214: forecast CREATION has its own deny-default gate + exact
-- short grant (actor/org/partner/order, synthetic, <=4h, revocable). Installed
-- closed and empty. Without it the approval hooks keep the original LIVE effects
-- (no forecast, no new snapshot/schedule failure). Lifecycle/logistics gates untouched.
CREATE TABLE platform_private.b2b_forecast_creation_gate_v1(
 singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false,
 updated_at timestamptz NOT NULL DEFAULT now(),updated_by uuid,reason text);
INSERT INTO platform_private.b2b_forecast_creation_gate_v1(singleton,enabled,reason) VALUES(true,false,'INSTALLED_CLOSED');
CREATE TABLE platform_private.b2b_forecast_creation_allowlist_v1(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 actor_id uuid NOT NULL,organization_id uuid NOT NULL,partner_id uuid NOT NULL,order_id uuid NOT NULL,
 synthetic boolean NOT NULL DEFAULT true CHECK(synthetic IS TRUE),
 valid_from timestamptz NOT NULL DEFAULT now(),valid_until timestamptz NOT NULL,
 revoked_at timestamptz,revoked_by uuid,revoke_reason text,created_at timestamptz NOT NULL DEFAULT now(),created_by uuid,
 CHECK(valid_until>valid_from AND valid_until<=valid_from+interval '4 hours'),CHECK(revoked_at IS NULL OR revoked_at>=valid_from));
ALTER TABLE platform_private.b2b_forecast_creation_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE platform_private.b2b_forecast_creation_allowlist_v1 ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_forecast_creation_gate_v1,platform_private.b2b_forecast_creation_allowlist_v1 FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.b2b_forecast_creation_scope_v1(p_actor uuid,p_org uuid,p_partner uuid,p_order uuid)
RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 -- Unlocked pre-filter only: out-of-pilot approvals never wait on pilot rows.
 SELECT p_actor IS NOT NULL AND p_org IS NOT NULL AND p_partner IS NOT NULL AND p_order IS NOT NULL
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 g WHERE g.singleton AND g.enabled IS TRUE)
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_allowlist_v1 a
   WHERE a.actor_id=p_actor AND a.organization_id=p_org AND a.partner_id=p_partner AND a.order_id=p_order
    AND a.revoked_at IS NULL AND a.valid_from<=pg_catalog.clock_timestamp() AND a.valid_until>pg_catalog.clock_timestamp());
$$;
CREATE FUNCTION platform_private.b2b_forecast_creation_allowed_v1(p_actor uuid,p_org uuid,p_partner uuid,p_order uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_grant record;v_enabled boolean;
BEGIN
 IF p_actor IS NULL OR p_org IS NULL OR p_partner IS NULL OR p_order IS NULL THEN RETURN false;END IF;
 -- Lock order grant -> gate (held to commit); validity/enabled measured after each wait.
 FOR v_grant IN SELECT a.* FROM platform_private.b2b_forecast_creation_allowlist_v1 a
  WHERE a.actor_id=p_actor AND a.organization_id=p_org AND a.partner_id=p_partner AND a.order_id=p_order ORDER BY a.id FOR UPDATE
 LOOP
  SELECT g.enabled INTO v_enabled FROM platform_private.b2b_forecast_creation_gate_v1 g WHERE g.singleton FOR UPDATE;
  IF v_enabled IS NOT TRUE THEN RETURN false;END IF;
  IF v_grant.synthetic IS TRUE AND v_grant.revoked_at IS NULL
   AND v_grant.valid_from<=pg_catalog.clock_timestamp() AND v_grant.valid_until>pg_catalog.clock_timestamp() THEN RETURN true;END IF;
 END LOOP;
 RETURN false;
END$$;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid),platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE TABLE platform_private.b2b_forecast_lifecycle_gate_v1(
 singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),
 enabled boolean NOT NULL DEFAULT false,
 updated_at timestamptz NOT NULL DEFAULT now(),updated_by uuid,reason text);
INSERT INTO platform_private.b2b_forecast_lifecycle_gate_v1(singleton,enabled,reason) VALUES(true,false,'INSTALLED_CLOSED');
CREATE TABLE platform_private.b2b_forecast_lifecycle_allowlist_v1(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 operation text NOT NULL CHECK(operation IN ('forecast_sync','forecast_cancel','forecast_begin')),
 actor_id uuid NOT NULL,organization_id uuid NOT NULL,partner_id uuid NOT NULL,order_id uuid NOT NULL,
 synthetic boolean NOT NULL DEFAULT true CHECK(synthetic IS TRUE),
 valid_from timestamptz NOT NULL DEFAULT now(),valid_until timestamptz NOT NULL,
 revoked_at timestamptz,revoked_by uuid,revoke_reason text,
 created_at timestamptz NOT NULL DEFAULT now(),created_by uuid,
 CHECK(valid_until>valid_from),CHECK(revoked_at IS NULL OR revoked_at>=valid_from));
ALTER TABLE platform_private.b2b_forecast_lifecycle_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE platform_private.b2b_forecast_lifecycle_allowlist_v1 ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_forecast_lifecycle_gate_v1,platform_private.b2b_forecast_lifecycle_allowlist_v1 FROM PUBLIC,anon,authenticated,service_role;
CREATE OR REPLACE FUNCTION platform_private.b2b_forecast_lifecycle_scope_v1(p_operation text, p_actor uuid, p_org uuid, p_partner uuid, p_order uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 -- Unlocked pre-filter only (never final authority): avoids waiting on foreign rows.
 SELECT p_actor IS NOT NULL AND p_org IS NOT NULL AND p_partner IS NOT NULL AND p_order IS NOT NULL
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 g WHERE g.singleton AND g.enabled IS TRUE)
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_allowlist_v1 a
   WHERE a.operation=p_operation AND a.actor_id=p_actor AND a.organization_id=p_org
    AND a.partner_id=p_partner AND a.order_id=p_order AND a.revoked_at IS NULL
    AND a.valid_from<=pg_catalog.clock_timestamp() AND a.valid_until>pg_catalog.clock_timestamp());
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_forecast_lifecycle_allowed_v1(p_operation text, p_actor uuid, p_org uuid, p_partner uuid, p_order uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_grant record;v_enabled boolean;
BEGIN
 IF p_actor IS NULL OR p_org IS NULL OR p_partner IS NULL OR p_order IS NULL
  OR p_operation NOT IN ('forecast_sync','forecast_cancel','forecast_begin') THEN RETURN false; END IF;
 -- Single lock order grant -> gate; both held until commit, so revocation/gate OFF
 -- serialize with an authorized writer; enabled/validity measured after every wait.
 FOR v_grant IN SELECT a.* FROM platform_private.b2b_forecast_lifecycle_allowlist_v1 a
  WHERE a.operation=p_operation AND a.actor_id=p_actor AND a.organization_id=p_org
   AND a.partner_id=p_partner AND a.order_id=p_order ORDER BY a.id FOR UPDATE
 LOOP
  SELECT g.enabled INTO v_enabled FROM platform_private.b2b_forecast_lifecycle_gate_v1 g WHERE g.singleton FOR UPDATE;
  IF v_enabled IS NOT TRUE THEN RETURN false; END IF;
  IF v_grant.synthetic IS TRUE AND v_grant.revoked_at IS NULL
   AND v_grant.valid_from<=pg_catalog.clock_timestamp() AND v_grant.valid_until>pg_catalog.clock_timestamp() THEN RETURN true; END IF;
 END LOOP;
 RETURN false;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_financial_forecast_cancel_residual_v1(p_forecast uuid, p_expected_version integer, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE f platform_private.b2b_financial_forecasts;new_state text;
BEGIN
 IF nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_REASON_REQUIRED' USING ERRCODE='22023';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE id=p_forecast FOR UPDATE;
 IF NOT FOUND OR f.version<>p_expected_version THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 IF f.state IN ('emissao_em_andamento','consulta_fiscal_obrigatoria','faturado_total','cancelado_antes_nf','cancelado_residual') THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
 new_state:=CASE WHEN f.residual_amount<f.total_amount THEN 'cancelado_residual' ELSE 'cancelado_antes_nf' END;
 UPDATE platform_private.b2b_financial_forecasts SET state=new_state,residual_amount=0,version=version+1,updated_at=now() WHERE id=f.id;
 INSERT INTO platform_private.b2b_financial_forecast_events(forecast_id,event_type,event_reference,payload)
 VALUES(f.id,'FORECAST_CANCELED',f.id::text||':'||(f.version+1)::text,jsonb_build_object('reason',p_reason,'previous_state',f.state));
 RETURN jsonb_build_object('forecast_id',f.id,'state',new_state,'version',f.version+1);
END$function$;
REVOKE ALL ON FUNCTION platform_private.b2b_financial_forecast_events_immutable() FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_financial_forecast_guard() FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text) FROM PUBLIC,anon,authenticated,service_role;
DO $post$ BEGIN
IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_financial_forecasts'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_financial_forecasts'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_financial_forecasts'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_financial_forecasts'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_financial_forecasts'; END IF;
IF to_regclass('platform_private.b2b_financial_forecast_events') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_financial_forecast_events'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_financial_forecast_events'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_financial_forecast_events'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_financial_forecast_events'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_financial_forecast_events'; END IF;
IF to_regclass('platform_private.b2b_forecast_creation_gate_v1') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_gate_v1'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_forecast_creation_gate_v1'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_gate_v1'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_gate_v1'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_forecast_creation_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_creation_allowlist_v1') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_allowlist_v1'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_forecast_creation_allowlist_v1'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_allowlist_v1'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_forecast_creation_allowlist_v1'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_forecast_creation_allowlist_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_lifecycle_gate_v1') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_gate_v1'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_forecast_lifecycle_gate_v1'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_gate_v1'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_gate_v1'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_forecast_lifecycle_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_forecast_lifecycle_allowlist_v1') IS NULL OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_allowlist_v1'::regclass) THEN RAISE EXCEPTION 'STAGE_A_RELATION_INVALID:b2b_forecast_lifecycle_allowlist_v1'; END IF;
IF EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_allowlist_v1'::regclass),acldefault('r',(SELECT relowner FROM pg_class WHERE oid='platform_private.b2b_forecast_lifecycle_allowlist_v1'::regclass)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_TABLE_ACL_OPEN:b2b_forecast_lifecycle_allowlist_v1'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_events_immutable()') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_events_immutable()'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_events_immutable()'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_financial_forecast_events_immutable()'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_guard()') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_guard()'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_guard()'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_financial_forecast_guard()'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_forecast_lifecycle_scope_v1(text,uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_forecast_lifecycle_allowed_v1(text,uuid,uuid,uuid,uuid)'; END IF;
IF to_regprocedure('platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)'::regprocedure),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid='platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)'::regprocedure)))) WHERE grantee=0 OR grantee IN (SELECT oid FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'STAGE_A_FUNCTION_ACL_OPEN:b2b_financial_forecast_cancel_residual_v1(uuid,integer,text)'; END IF;
IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_allowlist_v1) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_allowlist_v1) OR EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecasts) OR EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecast_events) THEN RAISE EXCEPTION 'STAGE_A_NOT_CLOSED_EMPTY'; END IF;
END $post$;
DO $unchanged$ DECLARE after_hash text; BEGIN SELECT md5(jsonb_build_object(
 'functions',(SELECT jsonb_agg(jsonb_build_array(p.oid::regprocedure::text,md5(pg_get_functiondef(p.oid)),p.proowner,p.proacl,p.proconfig) ORDER BY p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('public','auth','storage') AND p.prokind='f'),
 'relations',(SELECT jsonb_agg(jsonb_build_array(c.oid,c.relacl,c.relowner,c.relrowsecurity,c.relforcerowsecurity) ORDER BY c.oid) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage')),
 'triggers',(SELECT jsonb_agg(jsonb_build_array(t.oid,t.tgenabled,pg_get_triggerdef(t.oid)) ORDER BY t.oid) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage') AND NOT t.tgisinternal),
 'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY p.oid) FROM pg_policy p JOIN pg_class c ON c.oid=p.polrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('public','auth','storage')),
 'memberships',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m))::text) INTO after_hash; IF after_hash IS DISTINCT FROM (SELECT fingerprint FROM cancel_homolog_before) THEN RAISE EXCEPTION 'EXISTING_CATALOG_CHANGED'; END IF; END $unchanged$;
COMMIT;
