END $checker_pin$;
SELECT platform_private.cancel_homolog_catalog_check_v1();
DO $absent$ BEGIN
IF to_regclass('platform_private.b2b_authorized_documents') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_authorized_documents'; END IF;
IF to_regclass('platform_private.b2b_document_allocations') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_document_allocations'; END IF;
IF to_regclass('platform_private.b2b_allocation_reversals') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_allocation_reversals'; END IF;
IF to_regclass('platform_private.b2b_title_permits') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_title_permits'; END IF;
IF to_regclass('platform_private.b2b_cancellation_attestations') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_cancellation_attestations'; END IF;
END $absent$;
CREATE TEMP TABLE continuation_before ON COMMIT DROP AS SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) AS pin;
CREATE TABLE platform_private.b2b_authorized_documents (
 id uuid PRIMARY KEY, organization_id uuid NOT NULL, partner_id uuid NOT NULL, order_id uuid NOT NULL REFERENCES public.partner_orders(id),
 kind text NOT NULL CHECK(kind IN ('NFE','NFSE')), issue_date date NOT NULL CHECK(isfinite(issue_date)),
 event_key text NOT NULL, source_digest text NOT NULL CHECK(source_digest ~ '^[0-9a-f]{64}$'),
 items jsonb NOT NULL, state text NOT NULL CHECK(state IN ('AUTHORIZED','CANCELED')),
 UNIQUE(organization_id,kind,event_key)
);

CREATE TABLE platform_private.b2b_document_allocations (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_authorized_documents(id), organization_id uuid NOT NULL,
 order_id uuid NOT NULL REFERENCES public.partner_orders(id), partner_id uuid NOT NULL,
 receivable_id uuid NOT NULL UNIQUE REFERENCES public.accounts_receivable(id), source_digest text NOT NULL,
 principal numeric NOT NULL CHECK(principal>0), financed_interest numeric NOT NULL CHECK(financed_interest>=0),
 items jsonb NOT NULL, item_money jsonb NOT NULL CHECK(jsonb_typeof(item_money)='array'), rows jsonb NOT NULL, created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE platform_private.b2b_allocation_reversals (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_document_allocations(document_id),
 replacement_document_id uuid REFERENCES platform_private.b2b_authorized_documents(id), source_digest text NOT NULL,
 created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE platform_private.b2b_title_permits (
 transaction_id bigint NOT NULL, actor_id uuid NOT NULL, organization_id uuid NOT NULL, title_id uuid NOT NULL,
 order_id uuid NOT NULL, partner_id uuid NOT NULL, customer_id uuid NOT NULL, rows jsonb NOT NULL,
 PRIMARY KEY(transaction_id,title_id)
);

CREATE TABLE platform_private.b2b_cancellation_attestations (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_authorized_documents(id), organization_id uuid NOT NULL,
 event_key text NOT NULL, source_digest text NOT NULL CHECK(source_digest ~ '^[0-9a-f]{64}$'), UNIQUE(organization_id,event_key)
);

ALTER TABLE platform_private.b2b_authorized_documents ENABLE ROW LEVEL SECURITY;REVOKE ALL ON platform_private.b2b_authorized_documents FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_document_allocations ENABLE ROW LEVEL SECURITY;REVOKE ALL ON platform_private.b2b_document_allocations FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_allocation_reversals ENABLE ROW LEVEL SECURITY;REVOKE ALL ON platform_private.b2b_allocation_reversals FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_title_permits ENABLE ROW LEVEL SECURITY;REVOKE ALL ON platform_private.b2b_title_permits FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_cancellation_attestations ENABLE ROW LEVEL SECURITY;REVOKE ALL ON platform_private.b2b_cancellation_attestations FROM PUBLIC,anon,authenticated,service_role;
DO $closed$ BEGIN
IF to_regclass('platform_private.b2b_authorized_documents') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_authorized_documents'; END IF;
IF to_regclass('platform_private.b2b_document_allocations') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_document_allocations'; END IF;
IF to_regclass('platform_private.b2b_allocation_reversals') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_allocation_reversals'; END IF;
IF to_regclass('platform_private.b2b_title_permits') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_title_permits'; END IF;
IF to_regclass('platform_private.b2b_cancellation_attestations') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_cancellation_attestations'; END IF;
END $closed$;
DO $invariant$ DECLARE p text;BEGIN SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) INTO p;IF p IS DISTINCT FROM (SELECT pin FROM continuation_before) THEN RAISE EXCEPTION 'EXISTING_AUTHORITY_CHANGED'; END IF;END $invariant$;
COMMIT;
