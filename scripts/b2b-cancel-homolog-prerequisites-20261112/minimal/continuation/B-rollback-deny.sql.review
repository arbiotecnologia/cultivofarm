-- HOMOLOG ONLY vrlcdwmlytukrjezrrnf; CLOSED additive preparation; no operational hooks.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';SET LOCAL search_path=public,pg_catalog;
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
REVOKE ALL ON platform_private.b2b_authorized_documents FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.b2b_document_allocations FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.b2b_allocation_reversals FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.b2b_title_permits FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.b2b_cancellation_attestations FROM PUBLIC,anon,authenticated,service_role;
DO $closed$ BEGIN
IF to_regclass('platform_private.b2b_authorized_documents') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_authorized_documents'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_authorized_documents'; END IF;
IF to_regclass('platform_private.b2b_document_allocations') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_document_allocations'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_document_allocations'; END IF;
IF to_regclass('platform_private.b2b_allocation_reversals') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_allocation_reversals'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_allocation_reversals'; END IF;
IF to_regclass('platform_private.b2b_title_permits') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_title_permits'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_title_permits'; END IF;
IF to_regclass('platform_private.b2b_cancellation_attestations') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancellation_attestations'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_cancellation_attestations'; END IF;
END $closed$;
COMMIT;
