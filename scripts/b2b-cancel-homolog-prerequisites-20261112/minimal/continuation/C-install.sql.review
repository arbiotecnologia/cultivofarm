END $checker_pin$;
SELECT platform_private.cancel_homolog_catalog_check_v1();
DO $absent$ BEGIN
IF to_regclass('platform_private.b2b_fiscal_service_permits') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_fiscal_service_permits'; END IF;
IF to_regclass('platform_private.fiscal_close_pending') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.fiscal_close_pending'; END IF;
IF to_regclass('platform_private.b2b_fiscal_invoice_snapshots') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_fiscal_invoice_snapshots'; END IF;
END $absent$;
CREATE TEMP TABLE continuation_before ON COMMIT DROP AS SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) AS pin;
CREATE TABLE platform_private.b2b_fiscal_service_permits(
 transaction_id bigint NOT NULL,invoice_id uuid NOT NULL,document_id uuid NOT NULL,
 organization_id uuid NOT NULL,order_id uuid NOT NULL,partner_id uuid NOT NULL,
 created_at timestamptz NOT NULL DEFAULT now(),PRIMARY KEY(transaction_id,invoice_id));
ALTER TABLE platform_private.b2b_fiscal_service_permits ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_fiscal_service_permits FROM PUBLIC,anon,authenticated,service_role;
CREATE TABLE platform_private.fiscal_close_pending(
 transmission_id uuid PRIMARY KEY REFERENCES public.fiscal_sefaz_transmissions(id) ON DELETE RESTRICT,
 fiscal_invoice_id uuid REFERENCES public.fiscal_invoices(id) ON DELETE RESTRICT,
 error_code text NOT NULL CHECK(error_code IN ('FISCAL_AUTHORIZATION_CLOSE_PENDING','FISCAL_EVENT_RECONCILIATION_PENDING')),
 first_error_at timestamptz NOT NULL DEFAULT now(),last_error_at timestamptz NOT NULL DEFAULT now(),
 attempts integer NOT NULL DEFAULT 1 CHECK(attempts>=1));
ALTER TABLE platform_private.fiscal_close_pending ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.fiscal_close_pending FROM PUBLIC,anon,authenticated,service_role;
CREATE TABLE platform_private.b2b_fiscal_invoice_snapshots(
 invoice_id uuid PRIMARY KEY,transmission_id uuid NOT NULL,protocol text NOT NULL,
 source_digest text NOT NULL,snapshot jsonb NOT NULL,created_at timestamptz NOT NULL DEFAULT now());
ALTER TABLE platform_private.b2b_fiscal_invoice_snapshots ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_fiscal_invoice_snapshots FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE public.receivable_payments ADD COLUMN idempotency_key text;
CREATE UNIQUE INDEX cancel_homolog_payment_idem_v1 ON public.receivable_payments(installment_id,idempotency_key) WHERE idempotency_key IS NOT NULL;
ALTER TABLE public.fiscal_sefaz_transmissions ADD COLUMN protocol_c_stat text;
ALTER TABLE public.accounts_receivable ADD COLUMN b2b_document_id uuid REFERENCES platform_private.b2b_authorized_documents(id);
CREATE UNIQUE INDEX cancel_homolog_one_title_document_v1 ON public.accounts_receivable(b2b_document_id) WHERE b2b_document_id IS NOT NULL;
DO $closed$ BEGIN
IF to_regclass('platform_private.b2b_fiscal_service_permits') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_fiscal_service_permits'; END IF;
IF to_regclass('platform_private.fiscal_close_pending') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.fiscal_close_pending'; END IF;
IF to_regclass('platform_private.b2b_fiscal_invoice_snapshots') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_fiscal_invoice_snapshots'; END IF;
END $closed$;
DO $shape$ BEGIN IF NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='public.receivable_payments'::regclass AND attname='idempotency_key' AND atttypid='text'::regtype) OR NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='public.fiscal_sefaz_transmissions'::regclass AND attname='protocol_c_stat' AND atttypid='text'::regtype) THEN RAISE EXCEPTION 'ADDITIVE_COLUMN_MISSING'; END IF;END $shape$;
DO $invariant$ DECLARE p text;BEGIN SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) INTO p;IF p IS DISTINCT FROM (SELECT pin FROM continuation_before) THEN RAISE EXCEPTION 'EXISTING_AUTHORITY_CHANGED'; END IF;END $invariant$;
COMMIT;
