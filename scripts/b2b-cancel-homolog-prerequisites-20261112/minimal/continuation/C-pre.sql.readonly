IF NOT EXISTS(SELECT 1 FROM pg_index WHERE indrelid=to_regclass('public.fiscal_invoices') AND pg_get_indexdef(indexrelid)='CREATE UNIQUE INDEX ux_fiscal_invoice_scope_nfe ON public.fiscal_invoices USING btree (source_type, source_id, billing_scope) WHERE ((document_model = ''NFE''::text) AND (source_id IS NOT NULL) AND (status <> ''CANCELED''::text))') THEN RAISE EXCEPTION 'INDEX_DRIFT:public.fiscal_invoices'; END IF;
IF (SELECT jsonb_build_array(polcmd,polpermissive,polroles,pg_get_expr(polqual,polrelid),pg_get_expr(polwithcheck,polrelid)) FROM pg_policy WHERE polrelid=to_regclass('public.fiscal_invoices') AND polname='fi_producer_read') IS DISTINCT FROM '["r", true, ["16485"], "(has_role(( SELECT auth.uid() AS uid), ''cliente_produtor''::app_role) AND (((receivable_id IS NOT NULL) AND (EXISTS ( SELECT 1\n   FROM accounts_receivable ar\n  WHERE ((ar.id = fiscal_invoices.receivable_id) AND (ar.customer_id = ANY (get_cliente_ids_for_user(( SELECT auth.uid() AS uid)))))))) OR ((delivery_id IS NOT NULL) AND (EXISTS ( SELECT 1\n   FROM entregas e\n  WHERE ((e.id = fiscal_invoices.delivery_id) AND (e.cliente_id = ANY (get_cliente_ids_for_user(( SELECT auth.uid() AS uid))))))))))", null]'::jsonb THEN RAISE EXCEPTION 'POLICY_DRIFT:public.fiscal_invoices.fi_producer_read'; END IF;
