-- HOMOLOG ONLY vrlcdwmlytukrjezrrnf; CLOSED additive preparation; no operational hooks.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';SET LOCAL search_path=public,pg_catalog;
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
REVOKE ALL ON platform_private.b2b_fiscal_service_permits FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.fiscal_close_pending FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON platform_private.b2b_fiscal_invoice_snapshots FROM PUBLIC,anon,authenticated,service_role;
DO $closed$ BEGIN
IF to_regclass('platform_private.b2b_fiscal_service_permits') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_service_permits'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_fiscal_service_permits'; END IF;
IF to_regclass('platform_private.fiscal_close_pending') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.fiscal_close_pending'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.fiscal_close_pending'; END IF;
IF to_regclass('platform_private.b2b_fiscal_invoice_snapshots') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_fiscal_invoice_snapshots'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_fiscal_invoice_snapshots'; END IF;
END $closed$;
DO $shape$ BEGIN IF NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='public.receivable_payments'::regclass AND attname='idempotency_key' AND atttypid='text'::regtype) OR NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='public.fiscal_sefaz_transmissions'::regclass AND attname='protocol_c_stat' AND atttypid='text'::regtype) THEN RAISE EXCEPTION 'ADDITIVE_COLUMN_MISSING'; END IF;END $shape$;
COMMIT;
