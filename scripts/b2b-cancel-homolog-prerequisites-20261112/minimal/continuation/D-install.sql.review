-- HOMOLOG ONLY vrlcdwmlytukrjezrrnf; CLOSED additive preparation; no operational hooks.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';SET LOCAL search_path=public,pg_catalog;
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
DO $checker_pin$ BEGIN
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_resolve_function_v1(text,text)')) IS DISTINCT FROM jsonb_build_array('5403681b61bb5d63d3ca40d830553849','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_resolve_function_v1(text,text)'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_00_v1()')) IS DISTINCT FROM jsonb_build_array('b44f78ea1ccb498f48d9ad801e329825','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_00_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_01_v1()')) IS DISTINCT FROM jsonb_build_array('af34b396ff697fcd3b42ae5873ffab96','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_01_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_02_v1()')) IS DISTINCT FROM jsonb_build_array('b732de30cc96d569fea133bd7fe6d4e5','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_02_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_03_v1()')) IS DISTINCT FROM jsonb_build_array('26dbc5636551e0593823ab7d38c20082','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_03_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_04_v1()')) IS DISTINCT FROM jsonb_build_array('9e461ee77ead857ef34d11d7f80b0f75','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_04_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_05_v1()')) IS DISTINCT FROM jsonb_build_array('2e85fb221b8f97e381a2b26178dd8124','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_05_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_06_v1()')) IS DISTINCT FROM jsonb_build_array('59a7e7e83a3ba29c87af31420d58af3f','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_06_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_07_v1()')) IS DISTINCT FROM jsonb_build_array('e8a801e91c789ffc075f9286c7fbeaf4','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_07_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_08_v1()')) IS DISTINCT FROM jsonb_build_array('cbcceac480b88094bd3e2cc3c3470ea6','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_08_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_09_v1()')) IS DISTINCT FROM jsonb_build_array('1533f8f2b33964f7faa4a16b9b6385fc','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_09_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_part_10_v1()')) IS DISTINCT FROM jsonb_build_array('e23a92f4b67ce3447c58ea1898006ac1','postgres',true,'["search_path=\"\""]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_part_10_v1()'; END IF;
IF (SELECT jsonb_build_array(md5(prosrc),pg_get_userbyid(proowner),prosecdef,proconfig,(SELECT coalesce(jsonb_agg(a::text ORDER BY a::text),'[]'::jsonb) FROM unnest(proacl) a)) FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_catalog_check_v1()')) IS DISTINCT FROM jsonb_build_array('fd787a755a54215b87c2a9f2fd31c2f3','postgres',true,'["search_path=public, pg_catalog"]'::jsonb,'["postgres=X/postgres"]'::jsonb) THEN RAISE EXCEPTION 'CHECKER_PIN_DRIFT:platform_private.cancel_homolog_catalog_check_v1()'; END IF;
END $checker_pin$;
SELECT platform_private.cancel_homolog_catalog_check_v1();
DO $absent$ BEGIN
IF to_regclass('platform_private.b2b_cancel_policy_gate_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_cancel_policy_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_cancel_policy_allowlist_v1') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_cancel_policy_allowlist_v1'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_residual_capability_v1(uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.cancel_homolog_residual_capability_v1(uuid)'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)'; END IF;
IF to_regprocedure('platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)') IS NOT NULL THEN RAISE EXCEPTION 'STAGE_ALREADY_PRESENT:platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)'; END IF;
END $absent$;
CREATE TEMP TABLE continuation_before ON COMMIT DROP AS SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) AS pin;
CREATE TABLE platform_private.b2b_cancel_policy_gate_v1(singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false);
REVOKE ALL ON platform_private.b2b_cancel_policy_gate_v1 FROM PUBLIC,anon,authenticated,service_role;
INSERT INTO platform_private.b2b_cancel_policy_gate_v1(singleton,enabled) VALUES(true,false);
CREATE TABLE platform_private.b2b_cancel_policy_allowlist_v1(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),actor_id uuid NOT NULL,organization_id uuid NOT NULL,invoice_id uuid NOT NULL,order_id uuid NOT NULL,synthetic boolean NOT NULL DEFAULT true,valid_from timestamptz NOT NULL DEFAULT clock_timestamp(),valid_until timestamptz NOT NULL,revoked_at timestamptz);
REVOKE ALL ON platform_private.b2b_cancel_policy_allowlist_v1 FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_cancel_policy_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE platform_private.b2b_cancel_policy_allowlist_v1 ENABLE ROW LEVEL SECURITY;
CREATE OR REPLACE FUNCTION platform_private.cancel_homolog_residual_capability_v1(p_order uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $fn$
DECLARE org uuid;po public.partner_orders;f platform_private.b2b_financial_forecasts;
BEGIN
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton AND enabled) THEN RETURN jsonb_build_object('available',false); END IF;
 org:=platform_private.c2p1_internal_actor(ARRAY['administrador','gestor_comercial']::public.app_role[]);
 IF org IS NULL OR public._saas_user_has_feature(auth.uid(),'pedidos_b2b') IS NOT TRUE OR public._saas_user_has_feature(auth.uid(),'contas_receber') IS NOT TRUE THEN RETURN jsonb_build_object('available',false); END IF;
 SELECT * INTO po FROM public.partner_orders WHERE id=p_order AND EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=partner_id AND pa.commercial_owner_organization_id=org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL);
 IF NOT FOUND OR po.approved_by IS NULL OR po.approved_at IS NULL OR po.status::text NOT IN ('aprovado','entregue') OR platform_private.c2p1_settings_allowed(po.partner_id,true) IS NOT TRUE OR platform_private.b2b_forecast_lifecycle_scope_v1('forecast_cancel',auth.uid(),org,po.partner_id,po.id) IS NOT TRUE THEN RETURN jsonb_build_object('available',false); END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=po.id AND organization_id=org AND partner_id=po.partner_id;
 IF NOT FOUND OR f.residual_amount IS NULL OR f.residual_amount<=0 OR f.state NOT IN ('aguardando_fiscal','faturado_parcial') OR EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN platform_private.fiscal_close_pending cp ON cp.fiscal_invoice_id=i.id WHERE i.partner_order_id=po.id) OR EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN public.fiscal_sefaz_transmissions t ON t.fiscal_invoice_id=i.id WHERE i.partner_order_id=po.id AND t.state IN ('PENDING','SENT')) THEN RETURN jsonb_build_object('available',false); END IF;
 RETURN jsonb_build_object('available',true,'order_id',po.id,'version',f.version,'residual_amount',f.residual_amount);
END $fn$;
CREATE OR REPLACE FUNCTION platform_private.cancel_homolog_residual_command_v1(p_order uuid, p_expected_version integer, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE po public.partner_orders;f platform_private.b2b_financial_forecasts;org uuid;
BEGIN
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton AND enabled) THEN RAISE EXCEPTION 'CANCEL_POLICY_DISABLED' USING ERRCODE='42501'; END IF;
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed' THEN
  RAISE EXCEPTION 'B2B_FORECAST_READ_COMMITTED_REQUIRED' USING ERRCODE='42501';END IF;
 org:=platform_private.c2p1_internal_actor(ARRAY['administrador','gestor_comercial']::public.app_role[]);
 IF org IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 IF public._saas_user_has_feature(auth.uid(),'pedidos_b2b') IS NOT TRUE
  OR public._saas_user_has_feature(auth.uid(),'contas_receber') IS NOT TRUE THEN
  RAISE EXCEPTION 'B2B_FORECAST_FEATURE_DENIED' USING ERRCODE='42501';END IF;
 IF p_order IS NULL OR p_expected_version IS NULL OR nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN
  RAISE EXCEPTION 'B2B_FORECAST_CANCEL_REASON_REQUIRED' USING ERRCODE='22023';END IF;
 -- Canonical order: order row first, then forecast (same as approval and the bridge).
 SELECT * INTO po FROM public.partner_orders WHERE id=p_order
  AND EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=partner_orders.partner_id
   AND pa.commercial_owner_organization_id=org)
  AND platform_private.c2p1_settings_allowed(partner_id,true)
  AND platform_private.b2b_forecast_lifecycle_scope_v1('forecast_cancel',auth.uid(),org,
   partner_id,id) IS TRUE FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=p_order AND organization_id=org FOR UPDATE;
 IF NOT FOUND OR f.partner_id IS DISTINCT FROM po.partner_id THEN
  RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 IF platform_private.c2p1_internal_actor(ARRAY['administrador','gestor_comercial']::public.app_role[]) IS DISTINCT FROM f.organization_id
  OR NOT platform_private.c2p1_settings_allowed(f.partner_id,true) THEN
  RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 IF platform_private.b2b_forecast_lifecycle_allowed_v1('forecast_cancel',auth.uid(),org,
   po.partner_id,po.id) IS NOT TRUE THEN
  RAISE EXCEPTION 'B2B_FORECAST_PILOT_DENIED' USING ERRCODE='42501';END IF;
 IF public._saas_user_has_feature(auth.uid(),'pedidos_b2b') IS NOT TRUE
  OR public._saas_user_has_feature(auth.uid(),'contas_receber') IS NOT TRUE THEN
  RAISE EXCEPTION 'B2B_FORECAST_FEATURE_DENIED' USING ERRCODE='42501';END IF;
 IF platform_private.c2p1_internal_actor(ARRAY['administrador','gestor_comercial']::public.app_role[]) IS DISTINCT FROM org
  OR platform_private.c2p1_settings_allowed(po.partner_id,true) IS NOT TRUE THEN
  RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 PERFORM 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton FOR SHARE;
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton AND enabled) THEN RAISE EXCEPTION 'CANCEL_POLICY_DISABLED' USING ERRCODE='42501'; END IF;
 IF po.approved_at IS NULL OR po.approved_by IS NULL OR po.status::text NOT IN ('aprovado','entregue') THEN RAISE EXCEPTION 'B2B_CANCEL_ORDER_NOT_APPROVED' USING ERRCODE='PT409'; END IF;
 IF f.state IN ('cancelado_antes_nf','cancelado_residual') THEN
  IF f.version=p_expected_version+1 AND EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecast_events e WHERE e.forecast_id=f.id AND e.event_type='FORECAST_CANCELED' AND e.payload->>'reason'=p_reason) THEN RETURN jsonb_build_object('forecast_id',f.id,'state',f.state,'version',f.version,'idempotentReplay',true); END IF;
  RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409'; END IF;
 -- An emission/consultation still open or an authorized return awaiting close must settle first.
 IF EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN public.fiscal_sefaz_transmissions t ON t.fiscal_invoice_id=i.id
   WHERE i.partner_order_id=p_order AND t.state IN ('PENDING','SENT')) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_IN_FLIGHT' USING ERRCODE='PT409';END IF;
 IF EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN platform_private.fiscal_close_pending cp ON cp.fiscal_invoice_id=i.id
   WHERE i.partner_order_id=p_order) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_RECONCILIATION_PENDING' USING ERRCODE='PT409';END IF;
 RETURN platform_private.b2b_financial_forecast_cancel_residual_v1(f.id,p_expected_version,p_reason)
  ||jsonb_build_object('actor',auth.uid(),'order_id',p_order);
END
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_cancel_confirmed_fiscal_v1(p_tx uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $fn$
DECLARE t public.fiscal_sefaz_transmissions;e public.fiscal_events;i public.fiscal_invoices;r public.accounts_receivable;paid boolean;actor_org uuid;
BEGIN
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton AND enabled) THEN RETURN jsonb_build_object('final',false,'code','CANCEL_POLICY_DISABLED'); END IF;
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed' THEN RAISE EXCEPTION 'CANCEL_READ_COMMITTED_REQUIRED' USING ERRCODE='42501'; END IF;
 SELECT * INTO t FROM public.fiscal_sefaz_transmissions WHERE id=p_tx;
 IF NOT FOUND OR t.service<>'NFeRecepcaoEvento4' OR t.fiscal_event_id IS NULL THEN RETURN jsonb_build_object('final',false,'code','NOT_LINKED_CANCEL'); END IF;
 actor_org:=public.h15_actor_organization();
 IF actor_org IS NULL OR public.fn_fiscal_can_operate(auth.uid()) IS NOT TRUE THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 SELECT * INTO i FROM public.fiscal_invoices WHERE id=t.fiscal_invoice_id AND organization_id=actor_org;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_allowlist_v1 g WHERE g.actor_id=auth.uid() AND g.organization_id=i.organization_id AND g.invoice_id=i.id AND g.order_id=i.partner_order_id AND g.revoked_at IS NULL AND g.valid_from<=clock_timestamp() AND g.valid_until>clock_timestamp() AND g.synthetic) THEN RETURN jsonb_build_object('final',false,'code','CANCEL_POLICY_SCOPE_DENIED'); END IF;
 SELECT * INTO e FROM public.fiscal_events WHERE id=t.fiscal_event_id AND organization_id=i.organization_id AND fiscal_invoice_id=i.id;
 IF NOT FOUND OR e.event_type<>'SEFAZ_CANCELLATION_PREPARED' OR e.sefaz_event_code<>'110111' OR e.sefaz_access_key IS DISTINCT FROM i.access_key THEN RETURN jsonb_build_object('final',false,'code','NOT_LINKED_CANCEL'); END IF;
 -- 136 is registration without final linkage: consultation remains necessary.
 IF t.state<>'SUCCEEDED' OR t.outcome<>'EVENT_REGISTERED' OR t.c_stat NOT IN ('135','155') OR nullif(btrim(t.n_prot),'') IS NULL OR t.ch_nfe IS DISTINCT FROM i.access_key OR t.ambiente_retorno IS DISTINCT FROM '2' THEN RETURN jsonb_build_object('final',false,'code','FISCAL_CANCEL_NOT_FINAL'); END IF;
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_events x WHERE x.related_event_id=e.id AND x.sefaz_transmission_id=t.id AND x.organization_id=i.organization_id AND x.fiscal_invoice_id=i.id AND x.event_type='SEFAZ_EVENT_REGISTERED' AND x.sefaz_c_stat=t.c_stat AND x.sefaz_n_prot=t.n_prot AND x.sefaz_access_key=i.access_key AND x.sefaz_event_code='110111' AND x.sefaz_seq_evento=e.sefaz_seq_evento) THEN RETURN jsonb_build_object('final',false,'code','FISCAL_CANCEL_UNPROVEN'); END IF;
 PERFORM 1 FROM public.fiscal_invoices WHERE id=i.id FOR UPDATE;
 IF public.h15_actor_organization() IS DISTINCT FROM actor_org OR public.fn_fiscal_can_operate(auth.uid()) IS NOT TRUE THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton FOR SHARE;
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE singleton AND enabled) THEN RETURN jsonb_build_object('final',false,'code','CANCEL_POLICY_DISABLED'); END IF;
 SELECT * INTO i FROM public.fiscal_invoices WHERE id=i.id;
 PERFORM 1 FROM platform_private.b2b_cancel_policy_allowlist_v1 g WHERE g.actor_id=auth.uid() AND g.organization_id=i.organization_id AND g.invoice_id=i.id AND g.order_id=i.partner_order_id FOR SHARE;
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_allowlist_v1 g WHERE g.actor_id=auth.uid() AND g.organization_id=i.organization_id AND g.invoice_id=i.id AND g.order_id=i.partner_order_id AND g.revoked_at IS NULL AND g.valid_from<=clock_timestamp() AND g.valid_until>clock_timestamp() AND g.synthetic) THEN RETURN jsonb_build_object('final',false,'code','CANCEL_POLICY_SCOPE_DENIED'); END IF;
 IF i.normalized_status NOT IN ('AUTHORIZED','CANCELED') OR EXISTS(SELECT 1 FROM platform_private.fiscal_close_pending p WHERE p.fiscal_invoice_id=i.id AND p.error_code='FISCAL_AUTHORIZATION_CLOSE_PENDING') THEN RETURN jsonb_build_object('final',false,'code','FISCAL_AUTHORIZATION_RECONCILIATION_PENDING'); END IF;
 IF i.partner_order_id IS NULL OR i.debtor_partner_id IS NULL OR i.receivable_id IS NULL THEN RETURN jsonb_build_object('final',false,'code','FISCAL_CANCEL_TITLE_LINK_UNPROVEN'); END IF;
 IF NOT EXISTS(SELECT 1 FROM public.partner_orders po JOIN public.partner_accounts pa ON pa.id=po.partner_id WHERE po.id=i.partner_order_id AND po.partner_id=i.debtor_partner_id AND pa.commercial_owner_organization_id=i.organization_id) THEN RAISE EXCEPTION 'FISCAL_CANCEL_LINK_MISMATCH' USING ERRCODE='42501'; END IF;
 SELECT * INTO r FROM public.accounts_receivable WHERE id=i.receivable_id AND organization_id=i.organization_id AND b2b_document_id=i.id AND origin_type='B2B_ORDER' AND origin_id=i.partner_order_id AND partner_id=i.debtor_partner_id FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_CANCEL_LINK_MISMATCH' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.accounts_receivable_installments WHERE receivable_id=r.id ORDER BY id FOR UPDATE;
 IF public.h15_actor_organization() IS DISTINCT FROM actor_org OR public.fn_fiscal_can_operate(auth.uid()) IS NOT TRUE OR NOT EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=i.debtor_partner_id AND pa.commercial_owner_organization_id=i.organization_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL) THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 SELECT EXISTS(SELECT 1 FROM public.receivable_payments p JOIN public.accounts_receivable_installments x ON x.id=p.installment_id WHERE x.receivable_id=r.id) OR EXISTS(SELECT 1 FROM public.accounts_receivable_installments x WHERE x.receivable_id=r.id AND (x.received_amount IS NULL OR x.received_amount<>0 OR x.status='PAID')) INTO paid;
 IF i.normalized_status<>'CANCELED' THEN UPDATE public.fiscal_invoices SET status='CANCELED',normalized_status='CANCELED',canceled_at=clock_timestamp(),cancel_reason=e.sefaz_reason,reconciliation_status=CASE WHEN paid THEN 'REQUIRES_REVIEW' ELSE 'RECONCILED' END WHERE id=i.id; END IF;
 IF paid THEN RETURN jsonb_build_object('final',true,'financialReconciliationRequired',true,'code','FISCAL_CANCEL_PAYMENT_REVIEW'); END IF;
 IF r.status='CANCELED' THEN RETURN jsonb_build_object('final',true,'financialReconciliationRequired',false,'idempotentReplay',true); END IF;
 IF r.status NOT IN ('OPEN','OVERDUE') OR EXISTS(SELECT 1 FROM public.accounts_receivable_installments x WHERE x.receivable_id=r.id AND (x.organization_id IS DISTINCT FROM i.organization_id OR x.status NOT IN ('OPEN','OVERDUE') OR x.discount_amount IS NULL OR x.discount_amount<>0)) OR NOT EXISTS(SELECT 1 FROM public.accounts_receivable_installments WHERE receivable_id=r.id) THEN RAISE EXCEPTION 'FISCAL_CANCEL_FINANCIAL_STATE_UNDECIDED' USING ERRCODE='PT409'; END IF;
 UPDATE public.accounts_receivable_installments SET status='CANCELED' WHERE receivable_id=r.id;
 UPDATE public.accounts_receivable SET status='CANCELED' WHERE id=r.id;
 INSERT INTO public.financial_audit_log(entity_type,entity_id,action,performed_by,reason,new_data) VALUES('accounts_receivable',r.id,'AR_CANCELED',auth.uid(),e.sefaz_reason,jsonb_build_object('source','FINAL_FISCAL_CANCELLATION','invoice_id',i.id,'transmission_id',t.id));
 RETURN jsonb_build_object('final',true,'financialReconciliationRequired',false,'idempotentReplay',false);
END $fn$;
REVOKE ALL ON FUNCTION platform_private.cancel_homolog_residual_capability_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.cancel_homolog_residual_command_v1(uuid,integer,text) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_cancel_confirmed_fiscal_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
DO $closed$ BEGIN
IF to_regclass('platform_private.b2b_cancel_policy_gate_v1') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_gate_v1')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_gate_v1')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_gate_v1'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_cancel_policy_gate_v1'; END IF;
IF to_regclass('platform_private.b2b_cancel_policy_allowlist_v1') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_allowlist_v1')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_allowlist_v1')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.b2b_cancel_policy_allowlist_v1'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.b2b_cancel_policy_allowlist_v1'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_residual_capability_v1(uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_residual_capability_v1(uuid)')),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_residual_capability_v1(uuid)'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_FUNCTION_NOT_CLOSED:platform_private.cancel_homolog_residual_capability_v1(uuid)'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)')),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_FUNCTION_NOT_CLOSED:platform_private.cancel_homolog_residual_command_v1(uuid,integer,text)'; END IF;
IF to_regprocedure('platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=to_regprocedure('platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)')),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid=to_regprocedure('platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_FUNCTION_NOT_CLOSED:platform_private.b2b_cancel_confirmed_fiscal_v1(uuid)'; END IF;
END $closed$;
DO $off$ BEGIN IF EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_cancel_policy_allowlist_v1) THEN RAISE EXCEPTION 'CANCEL_POLICY_MUST_BE_CLOSED'; END IF;END $off$;
DO $invariant$ DECLARE p text;BEGIN SELECT md5(jsonb_build_object('roles',(SELECT jsonb_agg(to_jsonb(m) ORDER BY roleid,member) FROM pg_auth_members m),'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY oid) FROM pg_policy p),'triggers',(SELECT jsonb_agg(jsonb_build_array(oid,tgenabled,pg_get_triggerdef(oid)) ORDER BY oid) FROM pg_trigger WHERE NOT tgisinternal),'functions',(SELECT jsonb_agg(jsonb_build_array(oid,md5(pg_get_functiondef(oid)),proacl,proconfig) ORDER BY oid) FROM pg_proc WHERE prokind='f' AND pronamespace='public'::regnamespace))::text) INTO p;IF p IS DISTINCT FROM (SELECT pin FROM continuation_before) THEN RAISE EXCEPTION 'EXISTING_AUTHORITY_CHANGED'; END IF;END $invariant$;
COMMIT;
