-- HOMOLOG ONLY; reviewed exception infrastructure, gate OFF/no issuer/no client grant.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
DO $closed$ BEGIN
IF to_regclass('platform_private.cancel_homolog_fixture_gate_v1') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_gate_v1')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_gate_v1')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_gate_v1'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.cancel_homolog_fixture_gate_v1'; END IF;
IF to_regclass('platform_private.cancel_homolog_fixture_grants_v1') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_grants_v1')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_grants_v1')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_grants_v1'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.cancel_homolog_fixture_grants_v1'; END IF;
IF to_regclass('platform_private.cancel_homolog_fixture_permits_v1') IS NULL OR (SELECT relrowsecurity FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_permits_v1')) IS NOT TRUE OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT relacl FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_permits_v1')),acldefault('r',(SELECT relowner FROM pg_class WHERE oid=to_regclass('platform_private.cancel_homolog_fixture_permits_v1'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_RELATION_NOT_CLOSED:platform_private.cancel_homolog_fixture_permits_v1'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_fixture_scope_v1(text,uuid,jsonb,boolean)') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_fixture_scope_v1(text,uuid,jsonb,boolean)')),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_fixture_scope_v1(text,uuid,jsonb,boolean)'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_FUNCTION_NOT_CLOSED:platform_private.cancel_homolog_fixture_scope_v1(text,uuid,jsonb,boolean)'; END IF;
IF to_regprocedure('platform_private.cancel_homolog_fixture_row_guard_v1()') IS NULL OR EXISTS(SELECT 1 FROM aclexplode(coalesce((SELECT proacl FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_fixture_row_guard_v1()')),acldefault('f',(SELECT proowner FROM pg_proc WHERE oid=to_regprocedure('platform_private.cancel_homolog_fixture_row_guard_v1()'))))) WHERE grantee=0 OR grantee IN(SELECT oid FROM pg_roles WHERE rolname IN('anon','authenticated','service_role'))) THEN RAISE EXCEPTION 'NEW_FUNCTION_NOT_CLOSED:platform_private.cancel_homolog_fixture_row_guard_v1()'; END IF;
END $closed$;
DO $Eoff$ BEGIN IF EXISTS(SELECT 1 FROM platform_private.cancel_homolog_fixture_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.cancel_homolog_fixture_grants_v1) OR EXISTS(SELECT 1 FROM platform_private.cancel_homolog_fixture_permits_v1) THEN RAISE EXCEPTION 'E_FIXTURE_NOT_CLOSED_EMPTY'; END IF;IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='a00_homolog_validation_no_receivable' AND tgrelid='public.accounts_receivable'::regclass AND tgenabled='O' AND tgfoid='platform_private.homolog_validation_block_receivable_insert()'::regprocedure) OR NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='zz_cancel_homolog_fixture_row_guard_v1' AND tgrelid='public.accounts_receivable'::regclass AND tgenabled='O') OR NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='zz_cancel_homolog_fixture_payment_guard_v1' AND tgrelid='public.receivable_payments'::regclass AND tgenabled='O') THEN RAISE EXCEPTION 'E_ROW_OR_STATEMENT_GUARD_MISSING'; END IF;END $Eoff$;
ROLLBACK;
