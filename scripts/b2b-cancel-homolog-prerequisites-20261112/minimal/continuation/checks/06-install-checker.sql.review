-- HOMOLOG ONLY; catalog validation infrastructure, no business grants.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
DO $absence$ BEGIN IF to_regprocedure('platform_private.cancel_homolog_catalog_part_05_v1()') IS NOT NULL THEN RAISE EXCEPTION 'CHECKER_ALREADY_PRESENT:platform_private.cancel_homolog_catalog_part_05_v1()'; END IF;END $absence$;
CREATE OR REPLACE FUNCTION platform_private.cancel_homolog_catalog_part_05_v1() RETURNS jsonb LANGUAGE sql SECURITY DEFINER SET search_path='' AS $part$ SELECT '{"name":"public.fiscal_sefaz_transmissions","owner":"postgres","relrowsecurity":true,"relforcerowsecurity":false,"columns":[{"name":"id","type":"uuid","default":"gen_random_uuid()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"fiscal_invoice_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"xml_run_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"service","type":"text","default":null,"identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"environment_code","type":"text","default":"''2''::text","identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"endpoint_host","type":"text","default":null,"identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"endpoint_url","type":"text","default":null,"identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"correlation_id","type":"uuid","default":"gen_random_uuid()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"idempotency_key","type":"text","default":null,"identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"request_fingerprint","type":"text","default":null,"identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"state","type":"text","default":"''PENDING''::text","identity":"","not_null":true,"collation":"\"default\"","generated":""},{"name":"attempt","type":"integer","default":"0","identity":"","not_null":true,"collation":"-","generated":""},{"name":"c_stat","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"x_motivo","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"ch_nfe","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"n_prot","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"n_rec","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"dh_recbto","type":"timestamp with time zone","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"ambiente_retorno","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"response_summary","type":"jsonb","default":"''{}''::jsonb","identity":"","not_null":true,"collation":"-","generated":""},{"name":"error_code","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"created_by","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"created_at","type":"timestamp with time zone","default":"now()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"updated_at","type":"timestamp with time zone","default":"now()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"completed_at","type":"timestamp with time zone","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"fiscal_event_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"outcome","type":"text","default":"''PENDING''::text","identity":"","not_null":true,"collation":"\"default\"","generated":""}],"constraints":[{"name":"chk_fiscal_sefaz_tx_outcome","type":"c","target":"-","validated":true,"definition":"CHECK (outcome = ANY (ARRAY[''PENDING''::text, ''AUTHORIZED''::text, ''REJECTED''::text, ''PROCESSING''::text, ''EVENT_REGISTERED''::text, ''SERVICE_INFO''::text, ''TRANSPORT_ERROR''::text]))"},{"name":"fiscal_sefaz_transmissions_attempt