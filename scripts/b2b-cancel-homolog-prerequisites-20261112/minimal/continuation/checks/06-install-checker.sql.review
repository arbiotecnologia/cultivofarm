X ix_fiscal_sefaz_tx_event ON public.fiscal_sefaz_transmissions USING btree (fiscal_event_id, created_at DESC)","CREATE INDEX ix_fiscal_sefaz_tx_invoice ON public.fiscal_sefaz_transmissions USING btree (fiscal_invoice_id, service, created_at DESC)","CREATE UNIQUE INDEX ux_fiscal_sefaz_tx_idem ON public.fiscal_sefaz_transmissions USING btree (idempotency_key)"],"policies":[{"name":"fiscal_sefaz_tx_no_delete","check":null,"roles":["16485"],"using":"false","command":"d","permissive":true},{"name":"fiscal_sefaz_tx_no_insert","check":"false","roles":["16485"],"using":null,"command":"a","permissive":true},{"name":"fiscal_sefaz_tx_no_update","check":null,"roles":["16485"],"using":"false","command":"w","permissive":true},{"name":"fiscal_sefaz_tx_read","check":null,"roles":["16485"],"using":"fn_fiscal_can_read_internal(( SELECT auth.uid() AS uid))","command":"r","permissive":true}],"triggers":[{"name":"trg_fiscal_sefaz_tx_guard","enabled":"O","body_md5":"1661123d056217810d8fb175b46fdd8b","function":"fn_fiscal_sefaz_tx_guard()","definition":"CREATE TRIGGER trg_fiscal_sefaz_tx_guard BEFORE DELETE OR UPDATE ON fiscal_sefaz_transmissions FOR EACH ROW EXECUTE FUNCTION fn_fiscal_sefaz_tx_guard()"},{"name":"trg_fiscal_sefaz_tx_link_guard","enabled":"O","body_md5":"d908116081eff89e5979055a2e99e0a1","function":"fn_fiscal_sefaz_tx_link_guard()","definition":"CREATE TRIGGER trg_fiscal_sefaz_tx_link_guard BEFORE INSERT ON fiscal_sefaz_transmissions FOR EACH ROW EXECUTE FUNCTION fn_fiscal_sefaz_tx_link_guard()"}],"acl":["authenticated=r/postgres","postgres=arwdDxtm/postgres","service_role=arwdDxtm/postgres"]}'::jsonb $part$;
REVOKE ALL ON FUNCTION platform_private.cancel_homolog_catalog_part_05_v1() FROM PUBLIC,anon,authenticated,service_role;
