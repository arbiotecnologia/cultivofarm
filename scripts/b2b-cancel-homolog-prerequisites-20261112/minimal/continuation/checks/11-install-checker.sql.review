-- HOMOLOG ONLY; catalog validation infrastructure, no business grants.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';
DO $target$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='vrlcdwmlytukrjezrrnf' AND production_emission_allowed IS FALSE) OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' OR production_emission_allowed IS DISTINCT FROM FALSE) THEN RAISE EXCEPTION 'HOMOLOG_MARKER_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM cron.job WHERE active) THEN RAISE EXCEPTION 'HOMOLOG_CRON_ACTIVE'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'STAGE_A_REQUIRED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 WHERE enabled) OR EXISTS(SELECT 1 FROM platform_private.b2b_forecast_lifecycle_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'FOUNDATION_MUST_REMAIN_CLOSED'; END IF;
END $target$;
CREATE OR REPLACE FUNCTION platform_private.cancel_homolog_catalog_part_10_v1() RETURNS jsonb LANGUAGE sql SECURITY DEFINER SET search_path='' AS $part$ SELECT '{"name":"public.receivable_payments","owner":"postgres","relrowsecurity":true,"relforcerowsecurity":false,"columns":[{"name":"id","type":"uuid","default":"gen_random_uuid()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"installment_id","type":"uuid","default":null,"identity":"","not_null":true,"collation":"-","generated":""},{"name":"payment_date","type":"date","default":"CURRENT_DATE","identity":"","not_null":true,"collation":"-","generated":""},{"name":"amount_received","type":"numeric(14,2)","default":null,"identity":"","not_null":true,"collation":"-","generated":""},{"name":"payment_method_id","type":"uuid","default":null,"identity":"","not_null":true,"collation":"-","generated":""},{"name":"bank_account_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"discount_amount","type":"numeric(14,2)","default":"0","identity":"","not_null":true,"collation":"-","generated":""},{"name":"interest_amount","type":"numeric(14,2)","default":"0","identity":"","not_null":true,"collation":"-","generated":""},{"name":"penalty_amount","type":"numeric(14,2)","default":"0","identity":"","not_null":true,"collation":"-","generated":""},{"name":"notes","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"created_by","type":"uuid","default":null,"identity":"","not_null":true,"collation":"-","generated":""},{"name":"created_at","type":"timestamp with time zone","default":"now()","identity":"","not_null":true,"collation":"-","generated":""},{"name":"is_reversal","type":"boolean","default":"false","identity":"","not_null":true,"collation":"-","generated":""},{"name":"reversed_payment_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""},{"name":"reversal_reason","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"request_fingerprint","type":"text","default":null,"identity":"","not_null":false,"collation":"\"default\"","generated":""},{"name":"organization_id","type":"uuid","default":null,"identity":"","not_null":false,"collation":"-","generated":""}],"constraints":[{"name":"receivable_payments_amount_sign_check","type":"c","target":"-","validated":true,"definition":"CHECK (COALESCE(is_reversal, false) = false AND amount_received > 0::numeric OR is_reversal = true AND amount_received < 0::numeric)"},{"name":"receivable_payments_bank_account_id_fkey","type":"f","target":"bank_accounts","validated":true,"definition":"FOREIGN KEY (bank_account_id) REFERENCES bank_accounts(id)"},{"name":"receivable_payments_created_by_fkey","type":"f","target":"auth.users","validated":true,"definition":"FOREIGN KEY (created_by) REFERENCES auth.users(id)"},{"name":"receivable_payments_installment_id_fkey","type":"f","target":"accounts_receivable_installments","validated":true,"definition":"FOREIGN KEY (installment_id) REFERENCES accounts_receivable_installments(id) ON DELETE CASCADE"},{"name":"receivable_payments_organization_id_fkey","type":"f","target":"organizations","validated":true,"definition":"FOREIGN KEY (organization_id) REFERENCES organizations(id)"},{"name":"receivable_payments_payment_method_id_fkey","type":"f","target":"payment_methods","validated":true,"definition":"FOREIGN KEY (payment_method_id) REFERENCES payment_methods(id)"},{"name":"receivable_payments_pkey","type":"p","target":"-","validated":true,"definition":"PRIMARY KEY (id)"},{"name":"receivable_payments_reversal_consistency_check","type":"c","target":"-","validated":true,"definition":"CHECK (COALESCE(is_reversal, false) = false AND reversed_payment_id IS NULL OR is_reversal = true AND reversed_payment_id IS NOT NULL)"},{"name":"receivable_payments_reversed_payment_id_fkey","type":"f","target":"receivable_payments","validated":true,"definition":"FOREIGN KEY (reversed_payment_id) REFERENCES receivable_payments(id)"}],"indexes":["CREATE INDEX idx_rp_date ON public.receivable_payments USING btree (payment_date)","CREATE INDEX receivable_payments_organization_id_idx ON public.receivable_payments USING btree (organization_id)","CREATE UNIQUE INDEX receivable_payments_pkey ON public.receivable_payments USING btree (id)","CREATE UNIQUE INDEX ux_receivable_payments_one_reversal ON public.receivable_payments USING btree (reversed_payment_id) WHERE ((is_reversal = true) AND (reversed_payment_id IS NOT NULL))"],"policies":[{"name":"Financial staff full access","check":"is_financial_staff(( SELECT auth.uid() AS uid))","roles":["16485"],"using":"is_financial_staff(( SELECT auth.uid() AS uid))","command":"*","permissive":true},{"name":"tenant_isolation_d51_5","check":"((organization_id IS NOT NULL) AND (organization_id = h15_actor_organization()))","roles":["16485"],"using":"((organization_id IS NOT NULL) AND (organization_id = h15_actor_organization()))","command":"*","permissive":false}],"triggers":[{"name":"d51_5_validate_tenant_links","enabled":"O","body_md5":"f470a25ba7e65b366c62ad3ac8aa3112","function":"d51_5_validate_financial_tenant_links()","definition":"CREATE TRIGGER d51_5_validate_tenant_links BEFORE INSERT OR UPDATE OF organization_id, installment_id ON receivable_payments FOR EACH ROW EXECUTE FUNCTION d51_5_validate_financial_tenant_links()"},{"name":"tenant_organization_guard","enabled":"O","body_md5":"d01a740c1e3e02407131d2b9228bf658","function":"guard_tenant_organization_id()","definition":"CREATE TRIGGER tenant_organization_guard BEFORE INSERT OR UPDATE ON receivable_payments FOR EACH ROW EXECUTE FUNCTION guard_tenant_organization_id()"},{"name":"trg_audit_rp","enabled":"O","body_md5":"46f777c2020ff9a059a80ae6dab4bd12","function":"fn_financial_audit()","definition":"CREATE TRIGGER trg_audit_rp AFTER INSERT OR DELETE OR UPDATE ON receivable_payments FOR EACH ROW EXE