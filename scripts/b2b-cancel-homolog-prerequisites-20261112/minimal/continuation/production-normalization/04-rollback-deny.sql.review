-- INACTIVE production-candidate overlay; requires exact installed candidate baseline, not homolog.
BEGIN;SET LOCAL lock_timeout='3s';SET LOCAL statement_timeout='30s';
DO $post$ BEGIN IF md5((SELECT prosrc FROM pg_proc WHERE oid='public.rpc_b2b_cancel_residual_capability_v1(uuid)'::regprocedure)) IS DISTINCT FROM '45b58c8beabf4904e096695974f48f2f' THEN RAISE EXCEPTION 'NORMALIZATION_SOURCE_DRIFT'; END IF;END $post$;
REVOKE EXECUTE ON FUNCTION public.rpc_b2b_cancel_residual_capability_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
UPDATE platform_private.b2b_cancel_policy_gate_v1 SET enabled=false;
