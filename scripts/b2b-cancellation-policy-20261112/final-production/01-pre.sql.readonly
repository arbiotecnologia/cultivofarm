d = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''receivable_payments''::text) THEN (EXISTS ( SELECT 1\n       FROM receivable_payments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''payable_payments''::text) THEN (EXISTS ( SELECT 1\n       FROM payable_payments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_documents''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_documents source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_receipts''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_receipts source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_report_exports''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_report_exports source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''fiscal_invoices''::text) THEN (EXISTS ( SELECT 1\n       FROM fiscal_invoices source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ANY (ARRAY[''recurring_financial_templates''::text, ''RECURRING_TEMPLATE''::text])) THEN (EXISTS ( SELECT 1\n       FROM recurring_financial_templates source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ANY (ARRAY[''entrega''::text, ''entregas''::text])) THEN (EXISTS ( SELECT 1\n       FROM entregas source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    ELSE false\nEND)",null]],"triggers":[],"force_rls":false,"constraints":[["financial_audit_log_performed_by_fkey","FOREIGN KEY (performed_by) REFERENCES auth.users(id)",true],["financial_audit_log_pkey","PRIMARY KEY (id)",true]]},"public.receivable_payments":{"acl":["anon=arwdDxtm/postgres","authenticated=arwdDxtm/postgres","postgres=arwdDxtm/postgres","service_role=arwdDxtm/postgres"],"rls":true,"owner":"postgres","columns":[["id","uuid",true,"gen_random_uuid()"],["installment_id","uuid",true,null],["payment_date","date",true,"CURRENT_DATE"],["amount_received","numeric(14,2)",true,null],["payment_method_id","uuid",true,null],["bank_account_id","uuid",false,null],["discount_amount","numeric(14,2)",true,"0"],["interest_amount","numeric(14,2)",true,"0"],["penalty_amount","numeric(14,2)",true,"0"],["notes","text",false,null],["created_by","uuid",true,null],["created_at","timestamp with time zone",true,"now()"],["is_reversal","boolean",true,"false"],["reversed_payment_id","uuid",false,null],["reversal_reason","text",false,null],["idempotency_key","text",false,null],["request_fingerprint","text",false,null],["organization_id","uuid",false,null]],"indexes":[["idx_rp_date","CREATE INDEX idx_rp_date ON public.receivable_payments USING btree (payment_date)",true],["receivable_payments_organization_id_idx","CREATE INDEX receivable_payments_organization_id_idx ON public.receivable_payments USING btree (organization_id)",true],["receivable_payments_pkey","CREATE UNIQUE INDEX receivable_payments_pkey ON public.receivable_payments USING btree (id)",true],["ux_receivable_payments_one_reversal","CREATE UNIQUE INDEX ux_receivable_payments_one_reversal ON public.rec