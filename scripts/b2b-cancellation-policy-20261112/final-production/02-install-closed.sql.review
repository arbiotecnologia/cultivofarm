,"text",true,null],["created_at","timestamp with time zone",true,"now()"]],"indexes":[["b2b_allocation_reversals_pkey","CREATE UNIQUE INDEX b2b_allocation_reversals_pkey ON platform_private.b2b_allocation_reversals USING btree (document_id)",true]],"policies":[],"triggers":[["immutable_truncate","CREATE TRIGGER immutable_truncate BEFORE TRUNCATE ON platform_private.b2b_allocation_reversals FOR EACH STATEMENT EXECUTE FUNCTION platform_private.price_immutable()","O","d001f9720ad2c42c6d1d62c210e043dd"],["immutable_update_delete","CREATE TRIGGER immutable_update_delete BEFORE DELETE OR UPDATE ON platform_private.b2b_allocation_reversals FOR EACH ROW EXECUTE FUNCTION platform_private.price_immutable()","O","d001f9720ad2c42c6d1d62c210e043dd"]],"force_rls":false,"constraints":[["b2b_allocation_reversals_document_id_fkey","FOREIGN KEY (document_id) REFERENCES platform_private.b2b_document_allocations(document_id)",true],["b2b_allocation_reversals_pkey","PRIMARY KEY (document_id)",true],["b2b_allocation_reversals_replacement_document_id_fkey","FOREIGN KEY (replacement_document_id) REFERENCES platform_private.b2b_authorized_documents(id)",true]]},"platform_private.b2b_document_allocations":{"acl":[],"rls":true,"owner":"postgres","columns":[["document_id","uuid",true,null],["organization_id","uuid",true,null],["order_id","uuid",true,null],["partner_id","uuid",true,null],["receivable_id","uuid",true,null],["source_digest","text",true,null],["principal","numeric",true,null],["financed_interest","numeric",true,null],["items","jsonb",true,null],["item_money","jsonb",true,null],["rows","jsonb",true,null],["created_at","timestamp with time zone",true,"now()"]],"indexes":[["b2b_document_allocations_pkey","CREATE UNIQUE INDEX b2b_document_allocations_pkey ON platform_private.b2b_document_allocations USING btree (document_id)",true],["b2b_document_allocations_receivable_id_key","CREATE UNIQUE INDEX b2b_document_allocations_receivable_id_key ON platform_private.b2b_document_allocations 