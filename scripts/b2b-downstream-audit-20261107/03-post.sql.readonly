-- READ ONLY.
DO $guard$
BEGIN
  IF md5(pg_get_functiondef('public.request_b2b_payment_terms_adjustment_secure(uuid,text)'::regprocedure)) <> '55996e9496ffb123504adaeaa502c81f' THEN
    RAISE EXCEPTION 'ADJUSTMENT_FUNCTION_PIN_DRIFT';
  END IF;
  IF md5(pg_get_functiondef('public.b2b_phase1_order_visible(uuid)'::regprocedure)) <> '8812508716f279a88e3d5a31b15621d8' THEN
    RAISE EXCEPTION 'ADJUSTMENT_SCOPE_PIN_DRIFT';
  END IF;
  IF md5(pg_get_functiondef('platform_private.c2_accounting_pending_guard()'::regprocedure)) <> '669b19490a7a9700f0158db4b31885ad' THEN
    RAISE EXCEPTION 'ACCOUNTING_GUARD_PIN_DRIFT';
  END IF;
END
$guard$;
DO $acl$
BEGIN
  IF NOT has_function_privilege('authenticated', 'public.request_b2b_payment_terms_adjustment_secure(uuid,text)', 'EXECUTE')
     OR NOT has_function_privilege('service_role', 'public.request_b2b_payment_terms_adjustment_secure(uuid,text)', 'EXECUTE')
     OR has_function_privilege('anon', 'public.request_b2b_payment_terms_adjustment_secure(uuid,text)', 'EXECUTE') THEN
    RAISE EXCEPTION 'ADJUSTMENT_ACL_DRIFT';
  END IF;
END
$acl$;
SELECT 'POST_OK' AS status;
