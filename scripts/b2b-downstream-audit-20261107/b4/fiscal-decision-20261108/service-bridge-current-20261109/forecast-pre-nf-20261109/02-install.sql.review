-- REVIEW_ONLY_INACTIVE_NOT_APPROVED; PostgreSQL descartável apenas.
BEGIN;
SET LOCAL lock_timeout='3s';
DO $$ BEGIN
 IF current_setting('b2b_forecast.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_FORECAST_REF_NOT_VERIFIED';END IF;
 IF md5(pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure)) IS DISTINCT FROM '664f63441c92a6716f0117362255ec9e' THEN RAISE EXCEPTION 'B2B_FORECAST_APPROVE_INSTALL_PRE_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.approve_b2b_payment_terms_secure(uuid,text)'::regprocedure)) IS DISTINCT FROM 'a61daa8542058bdbf239903d655c2a1b' THEN RAISE EXCEPTION 'B2B_FORECAST_TERMS_INSTALL_PRE_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.approve_b2b_credit(uuid,text)'::regprocedure)) IS DISTINCT FROM '8127c7b697871fa1eecafa845a551eea' THEN RAISE EXCEPTION 'B2B_FORECAST_CREDIT_APPROVAL_INSTALL_PRE_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.fn_b2b_credit_exposure(uuid,numeric,uuid)'::regprocedure)) IS DISTINCT FROM '213ac31f3a30816ead75365b0d1fed18' THEN RAISE EXCEPTION 'B2B_FORECAST_CREDIT_INSTALL_PRE_DRIFT';END IF;
END$$;

CREATE TABLE platform_private.b2b_financial_forecasts(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),order_id uuid NOT NULL UNIQUE REFERENCES public.partner_orders(id),
 organization_id uuid NOT NULL,partner_id uuid NOT NULL,total_amount numeric(14,2) NOT NULL CHECK(total_amount>0),
 residual_amount numeric(14,2) NOT NULL CHECK(residual_amount>=0 AND residual_amount<=total_amount),
 state text NOT NULL CHECK(state IN ('aguardando_fiscal','emissao_em_andamento','consulta_fiscal_obrigatoria','faturado_parcial','faturado_total','cancelado_antes_nf','cancelado_residual')),
 due_dates_estimated boolean NOT NULL DEFAULT true CHECK(due_dates_estimated),economic_snapshot jsonb NOT NULL,
 schedule_snapshot jsonb NOT NULL CHECK(jsonb_typeof(schedule_snapshot)='array'),items_snapshot jsonb NOT NULL CHECK(jsonb_typeof(items_snapshot)='array'),
 credit_decision_snapshot jsonb NOT NULL,commercial_approved_by uuid NOT NULL,commercial_approved_at timestamptz NOT NULL,
 credit_approved_by uuid,credit_approved_at timestamptz,fiscal_intent_id uuid,last_error_code text,
 version integer NOT NULL DEFAULT 1 CHECK(version>0),created_at timestamptz NOT NULL DEFAULT now(),updated_at timestamptz NOT NULL DEFAULT now());
ALTER TABLE platform_private.b2b_financial_forecasts ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_financial_forecasts FROM PUBLIC,anon,authenticated,service_role;
CREATE TABLE platform_private.b2b_financial_forecast_events(
 id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,forecast_id uuid NOT NULL REFERENCES platform_private.b2b_financial_forecasts(id),
 event_type text NOT NULL,event_reference text NOT NULL,payload jsonb NOT NULL DEFAULT '{}'::jsonb,actor_id uuid,created_at timestamptz NOT NULL DEFAULT now(),
 UNIQUE(forecast_id,event_type,event_reference));
ALTER TABLE platform_private.b2b_financial_forecast_events ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_financial_forecast_events FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.b2b_financial_forecast_events_immutable() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$BEGIN RAISE EXCEPTION 'B2B_FORECAST_EVENT_IMMUTABLE' USING ERRCODE='42501';END$$;
CREATE TRIGGER b2b_forecast_events_no_change BEFORE UPDATE OR DELETE ON platform_private.b2b_financial_forecast_events
FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_financial_forecast_events_immutable();
CREATE FUNCTION platform_private.b2b_financial_forecast_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'B2B_FORECAST_DELETE_DENIED' USING ERRCODE='42501';END IF;
 IF (NEW.order_id,NEW.organization_id,NEW.partner_id,NEW.total_amount,NEW.due_dates_estimated,NEW.economic_snapshot,
     NEW.schedule_snapshot,NEW.items_snapshot,NEW.credit_decision_snapshot,NEW.commercial_approved_by,NEW.commercial_approved_at,
     NEW.credit_approved_by,NEW.credit_approved_at)
    IS DISTINCT FROM
    (OLD.order_id,OLD.organization_id,OLD.partner_id,OLD.total_amount,OLD.due_dates_estimated,OLD.economic_snapshot,
     OLD.schedule_snapshot,OLD.items_snapshot,OLD.credit_decision_snapshot,OLD.commercial_approved_by,OLD.commercial_approved_at,
     OLD.credit_approved_by,OLD.credit_approved_at)
 THEN RAISE EXCEPTION 'B2B_FORECAST_ECONOMIC_IMMUTABLE' USING ERRCODE='42501';END IF;
 IF NEW.version<>OLD.version+1 THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_REQUIRED' USING ERRCODE='PT409';END IF;
 RETURN NEW;
END$$;
CREATE TRIGGER b2b_forecast_guard BEFORE UPDATE OR DELETE ON platform_private.b2b_financial_forecasts
FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_financial_forecast_guard();

-- Review cf7d5fb/214: forecast CREATION has its own deny-default gate + exact
-- short grant (actor/org/partner/order, synthetic, <=4h, revocable). Installed
-- closed and empty. Without it the approval hooks keep the original LIVE effects
-- (no forecast, no new snapshot/schedule failure). Lifecycle/logistics gates untouched.
CREATE TABLE platform_private.b2b_forecast_creation_gate_v1(
 singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false,
 updated_at timestamptz NOT NULL DEFAULT now(),updated_by uuid,reason text);
INSERT INTO platform_private.b2b_forecast_creation_gate_v1(singleton,enabled,reason) VALUES(true,false,'INSTALLED_CLOSED');
CREATE TABLE platform_private.b2b_forecast_creation_allowlist_v1(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 actor_id uuid NOT NULL,organization_id uuid NOT NULL,partner_id uuid NOT NULL,order_id uuid NOT NULL,
 synthetic boolean NOT NULL DEFAULT true CHECK(synthetic IS TRUE),
 valid_from timestamptz NOT NULL DEFAULT now(),valid_until timestamptz NOT NULL,
 revoked_at timestamptz,revoked_by uuid,revoke_reason text,created_at timestamptz NOT NULL DEFAULT now(),created_by uuid,
 CHECK(valid_until>valid_from AND valid_until<=valid_from+interval '4 hours'),CHECK(revoked_at IS NULL OR revoked_at>=valid_from));
ALTER TABLE platform_private.b2b_forecast_creation_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE platform_private.b2b_forecast_creation_allowlist_v1 ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_forecast_creation_gate_v1,platform_private.b2b_forecast_creation_allowlist_v1 FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.b2b_forecast_creation_scope_v1(p_actor uuid,p_org uuid,p_partner uuid,p_order uuid)
RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 -- Unlocked pre-filter only: out-of-pilot approvals never wait on pilot rows.
 SELECT p_actor IS NOT NULL AND p_org IS NOT NULL AND p_partner IS NOT NULL AND p_order IS NOT NULL
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_gate_v1 g WHERE g.singleton AND g.enabled IS TRUE)
  AND EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_allowlist_v1 a
   WHERE a.actor_id=p_actor AND a.organization_id=p_org AND a.partner_id=p_partner AND a.order_id=p_order
    AND a.revoked_at IS NULL AND a.valid_from<=pg_catalog.clock_timestamp() AND a.valid_until>pg_catalog.clock_timestamp());
$$;
CREATE FUNCTION platform_private.b2b_forecast_creation_allowed_v1(p_actor uuid,p_org uuid,p_partner uuid,p_order uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_grant record;v_enabled boolean;
BEGIN
 IF p_actor IS NULL OR p_org IS NULL OR p_partner IS NULL OR p_order IS NULL THEN RETURN false;END IF;
 -- Lock order grant -> gate (held to commit); validity/enabled measured after each wait.
 FOR v_grant IN SELECT a.* FROM platform_private.b2b_forecast_creation_allowlist_v1 a
  WHERE a.actor_id=p_actor AND a.organization_id=p_org AND a.partner_id=p_partner AND a.order_id=p_order ORDER BY a.id FOR UPDATE
 LOOP
  SELECT g.enabled INTO v_enabled FROM platform_private.b2b_forecast_creation_gate_v1 g WHERE g.singleton FOR UPDATE;
  IF v_enabled IS NOT TRUE THEN RETURN false;END IF;
  IF v_grant.synthetic IS TRUE AND v_grant.revoked_at IS NULL
   AND v_grant.valid_from<=pg_catalog.clock_timestamp() AND v_grant.valid_until>pg_catalog.clock_timestamp() THEN RETURN true;END IF;
 END LOOP;
 RETURN false;
END$$;
REVOKE ALL ON FUNCTION platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid),platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.b2b_financial_forecast_after_approval_v1(p_order uuid,p_credit jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE po public.partner_orders;org uuid;org_after uuid;f platform_private.b2b_financial_forecasts;
 schedule jsonb;items jsonb;reason text;total numeric(14,2);v_credit jsonb:=p_credit;
BEGIN
 SELECT * INTO po FROM public.partner_orders WHERE id=p_order FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_FORECAST_COMMERCIAL_APPROVAL_REQUIRED' USING ERRCODE='42501';END IF;
 IF po.status<>'aprovado' OR po.approved_by IS NULL OR po.approved_at IS NULL THEN
  RETURN jsonb_build_object('deferred',true,'reason','COMMERCIAL_APPROVAL_REQUIRED');END IF;
 IF po.requires_financial_approval AND NOT EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
  WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id AND t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL) THEN
  RETURN jsonb_build_object('deferred',true,'reason','PAYMENT_TERMS_APPROVAL_REQUIRED');END IF;
 -- Creation pilot: before ANY snapshot/schedule/credit check, so out-of-pilot
 -- approvals keep their original result and effects (no forecast, no new raise).
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecasts WHERE order_id=po.id) THEN
  SELECT pa.commercial_owner_organization_id INTO org FROM public.partner_accounts pa
   WHERE pa.id=po.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
  IF org IS NULL OR NOT platform_private.b2b_forecast_creation_scope_v1(auth.uid(),org,po.partner_id,po.id) THEN
   RETURN jsonb_build_object('deferred',true,'reason','FORECAST_CREATION_NOT_GRANTED');END IF;
  IF NOT platform_private.b2b_forecast_creation_allowed_v1(auth.uid(),org,po.partner_id,po.id) THEN
   RETURN jsonb_build_object('deferred',true,'reason','FORECAST_CREATION_NOT_GRANTED');END IF;
  -- Nothing read before the grant/gate wait counts after it: reread order, owner org and actor.
  SELECT * INTO po FROM public.partner_orders WHERE id=p_order FOR UPDATE;
  SELECT pa.commercial_owner_organization_id INTO org_after FROM public.partner_accounts pa
   WHERE pa.id=po.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
  IF org_after IS DISTINCT FROM org OR po.status<>'aprovado' OR po.approved_by IS NULL OR po.approved_at IS NULL
   OR platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor','gestor_comercial']::public.app_role[]) IS DISTINCT FROM org THEN
   RETURN jsonb_build_object('deferred',true,'reason','FORECAST_CREATION_NOT_GRANTED');END IF;
  IF v_credit IS NULL THEN v_credit:=public.fn_b2b_credit_exposure(po.partner_id,0,NULL);END IF;
 END IF;
 reason:=coalesce(v_credit->>'reason_code','');
 IF po.payment_terms_id IS NULL OR coalesce(po.payment_condition_status,'') NOT IN ('defined','approved') THEN
  RAISE EXCEPTION 'B2B_FORECAST_CONDITION_UNPROVEN' USING ERRCODE='42501';END IF;
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecasts WHERE order_id=po.id) AND po.credit_approved_at IS NULL AND reason<>'OK' THEN
  RAISE EXCEPTION 'B2B_FORECAST_CREDIT_APPROVAL_REQUIRED' USING ERRCODE='42501';END IF;
 IF po.credit_approved_at IS NOT NULL AND po.credit_approved_by IS NULL THEN
  RAISE EXCEPTION 'B2B_FORECAST_CREDIT_APPROVAL_REQUIRED' USING ERRCODE='42501';END IF;
 SELECT pa.commercial_owner_organization_id INTO org FROM public.partner_accounts pa
  WHERE pa.id=po.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
 IF org IS NULL OR po.internal_economic_snapshot IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_SCOPE_UNPROVEN' USING ERRCODE='42501';END IF;
 total:=round(coalesce(po.final_amount_with_interest,po.total,0),2);
 IF total<=0 THEN RAISE EXCEPTION 'B2B_FORECAST_TOTAL_INVALID' USING ERRCODE='23514';END IF;
 -- Same economic identity as the sealed schedule: operational status/link and
 -- bookkeeping time are not contractual values. Existing snapshots stay intact.
 SELECT jsonb_agg(to_jsonb(s)-ARRAY['status','receivable_installment_id','created_at'] ORDER BY s.installment_number) INTO schedule
  FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=po.id;
 IF schedule IS NULL OR jsonb_array_length(schedule)=0 OR (SELECT sum((x->>'amount')::numeric) FROM jsonb_array_elements(schedule)x) IS DISTINCT FROM total THEN
  RAISE EXCEPTION 'B2B_FORECAST_SCHEDULE_UNPROVEN' USING ERRCODE='23514';END IF;
 SELECT coalesce(jsonb_agg(to_jsonb(i) ORDER BY i.id),'[]'::jsonb) INTO items FROM public.partner_order_items i WHERE i.order_id=po.id;
 IF jsonb_array_length(items)=0 THEN RAISE EXCEPTION 'B2B_FORECAST_ITEMS_UNPROVEN' USING ERRCODE='23514';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=po.id;
 IF f.id IS NOT NULL THEN
  IF (f.organization_id,f.partner_id,f.total_amount,f.economic_snapshot,
      (SELECT jsonb_agg(x-ARRAY['status','receivable_installment_id','created_at'] ORDER BY (x->>'installment_number')::integer) FROM jsonb_array_elements(f.schedule_snapshot)x),f.items_snapshot,
      f.commercial_approved_by,f.commercial_approved_at,f.credit_approved_by,f.credit_approved_at)
   IS DISTINCT FROM (org,po.partner_id,total,po.internal_economic_snapshot,schedule,items,
      po.approved_by,po.approved_at,po.credit_approved_by,po.credit_approved_at)
  THEN RAISE EXCEPTION 'B2B_FORECAST_REPLAY_DIVERGENCE' USING ERRCODE='PT409';END IF;
  RETURN jsonb_build_object('forecast_id',f.id,'replayed',true,'state',f.state);
 END IF;
 INSERT INTO platform_private.b2b_financial_forecasts(order_id,organization_id,partner_id,total_amount,residual_amount,state,
  economic_snapshot,schedule_snapshot,items_snapshot,credit_decision_snapshot,commercial_approved_by,commercial_approved_at,credit_approved_by,credit_approved_at)
 VALUES(po.id,org,po.partner_id,total,total,'aguardando_fiscal',po.internal_economic_snapshot,schedule,items,v_credit,
  po.approved_by,po.approved_at,po.credit_approved_by,po.credit_approved_at) RETURNING * INTO f;
 INSERT INTO platform_private.b2b_financial_forecast_events(forecast_id,event_type,event_reference,payload,actor_id)
 VALUES(f.id,'PREVISION_CREATED',f.id::text,jsonb_build_object('total',total,'estimated',true),po.approved_by);
 RETURN jsonb_build_object('forecast_id',f.id,'replayed',false,'state',f.state);
END$$;

CREATE FUNCTION public.get_b2b_financial_forecast_secure(p_order uuid)
RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $$
DECLARE f platform_private.b2b_financial_forecasts;actor uuid:=auth.uid();owner_org uuid;
BEGIN
 IF actor IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_READ_DENIED' USING ERRCODE='42501';END IF;
 IF NOT public.b2b_phase1_order_visible(p_order) THEN
  SELECT pa.commercial_owner_organization_id INTO owner_org
   FROM public.partner_orders po JOIN public.partner_accounts pa ON pa.id=po.partner_id
  WHERE po.id=p_order AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
  IF owner_org IS NULL OR public.h15_actor_organization() IS DISTINCT FROM owner_org
   OR NOT (public.has_role(actor,'administrador') OR public.has_role(actor,'gestor_comercial') OR public.has_role(actor,'financeiro')) THEN
   RAISE EXCEPTION 'B2B_FORECAST_READ_DENIED' USING ERRCODE='42501';END IF;
 END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=p_order;
 IF NOT FOUND THEN RETURN NULL;END IF;
 RETURN jsonb_build_object('forecast_id',f.id,'order_id',f.order_id,'organization_id',f.organization_id,'partner_id',f.partner_id,
  'total_amount',f.total_amount,'residual_amount',f.residual_amount,'state',f.state,'due_dates_estimated',true,
  'schedule',f.schedule_snapshot,'version',f.version,'fiscal_intent_id',f.fiscal_intent_id,'last_error_code',f.last_error_code,
  'created_at',f.created_at,'updated_at',f.updated_at);
END$$;
REVOKE ALL ON FUNCTION public.get_b2b_financial_forecast_secure(uuid) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION public.get_b2b_financial_forecast_secure(uuid) TO authenticated;

CREATE FUNCTION platform_private.b2b_financial_forecast_transition_v1(p_forecast uuid,p_expected_version integer,p_event text,p_reference text,p_payload jsonb DEFAULT '{}'::jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE f platform_private.b2b_financial_forecasts;new_state text;existing platform_private.b2b_financial_forecast_events;event_ref text;
BEGIN
 IF p_reference IS NULL OR btrim(p_reference)='' OR p_payload IS NULL OR jsonb_typeof(p_payload)<>'object' THEN
  RAISE EXCEPTION 'B2B_FORECAST_EVENT_INVALID' USING ERRCODE='22023';END IF;
 IF coalesce(p_payload->>'attempt','1')!~'^[1-9][0-9]*$' THEN RAISE EXCEPTION 'B2B_FORECAST_ATTEMPT_INVALID' USING ERRCODE='22023';END IF;
 -- Replay key is per source transmission when present (attempt-199: constant attempt
 -- collided across two cycles of one invoice); reference stays the intent invoice.
 event_ref:=p_reference||':'||coalesce(nullif(p_payload->>'transmission_id',''),nullif(p_payload->>'attempt',''),'1');
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE id=p_forecast FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 SELECT * INTO existing FROM platform_private.b2b_financial_forecast_events WHERE forecast_id=p_forecast AND event_type=p_event AND event_reference=event_ref;
 IF FOUND THEN
  IF existing.payload IS DISTINCT FROM p_payload THEN RAISE EXCEPTION 'B2B_FORECAST_REPLAY_DIVERGENCE' USING ERRCODE='PT409';END IF;
  RETURN jsonb_build_object('forecast_id',p_forecast,'state',f.state,'version',f.version,'replayed',true);END IF;
 IF f.version IS DISTINCT FROM p_expected_version THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 IF p_event='EMISSION_STARTED' THEN
  IF f.residual_amount<=0 OR f.state NOT IN ('aguardando_fiscal','emissao_em_andamento','faturado_parcial') THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
  IF f.state='emissao_em_andamento' AND f.fiscal_intent_id::text IS DISTINCT FROM p_reference THEN RAISE EXCEPTION 'B2B_FORECAST_INTENT_CONFLICT' USING ERRCODE='PT409';END IF;
  new_state:='emissao_em_andamento';
 ELSIF p_event IN ('EMISSION_FAILED','EMISSION_REJECTED') THEN
  IF f.state<>'emissao_em_andamento' OR f.fiscal_intent_id::text IS DISTINCT FROM p_reference THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
  new_state:='aguardando_fiscal';
 ELSIF p_event='EMISSION_TIMEOUT' THEN
  IF f.state<>'emissao_em_andamento' OR f.fiscal_intent_id::text IS DISTINCT FROM p_reference THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
  new_state:='consulta_fiscal_obrigatoria';
 ELSIF p_event='CONSULTATION_NOT_AUTHORIZED' THEN
  IF f.state<>'consulta_fiscal_obrigatoria' OR f.fiscal_intent_id::text IS DISTINCT FROM p_reference THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
  new_state:='aguardando_fiscal';
 ELSE RAISE EXCEPTION 'B2B_FORECAST_EVENT_INVALID' USING ERRCODE='22023';END IF;
 UPDATE platform_private.b2b_financial_forecasts SET state=new_state,fiscal_intent_id=CASE WHEN p_event='EMISSION_STARTED' THEN p_reference::uuid ELSE fiscal_intent_id END,
  last_error_code=CASE WHEN p_event IN ('EMISSION_FAILED','EMISSION_REJECTED','EMISSION_TIMEOUT') THEN nullif(p_payload->>'error_code','') ELSE NULL END,
  version=version+1,updated_at=now() WHERE id=f.id;
 INSERT INTO platform_private.b2b_financial_forecast_events(forecast_id,event_type,event_reference,payload) VALUES(f.id,p_event,event_ref,p_payload);
 RETURN jsonb_build_object('forecast_id',f.id,'state',new_state,'version',f.version+1,'replayed',false);
END$$;

CREATE FUNCTION platform_private.b2b_financial_forecast_cancel_residual_v1(p_forecast uuid,p_expected_version integer,p_reason text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE f platform_private.b2b_financial_forecasts;new_state text;
BEGIN
 IF nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_REASON_REQUIRED' USING ERRCODE='22023';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE id=p_forecast FOR UPDATE;
 IF NOT FOUND OR f.version<>p_expected_version THEN RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 IF f.state IN ('emissao_em_andamento','consulta_fiscal_obrigatoria','faturado_total','cancelado_antes_nf','cancelado_residual') THEN RAISE EXCEPTION 'B2B_FORECAST_STATE_CONFLICT' USING ERRCODE='PT409';END IF;
 new_state:=CASE WHEN f.residual_amount<f.total_amount THEN 'cancelado_residual' ELSE 'cancelado_antes_nf' END;
 UPDATE platform_private.b2b_financial_forecasts SET state=new_state,residual_amount=0,version=version+1,updated_at=now() WHERE id=f.id;
 INSERT INTO platform_private.b2b_financial_forecast_events(forecast_id,event_type,event_reference,payload)
 VALUES(f.id,'FORECAST_CANCELED',f.id::text||':'||(f.version+1)::text,jsonb_build_object('reason',p_reason,'previous_state',f.state));
 RETURN jsonb_build_object('forecast_id',f.id,'state',new_state,'version',f.version+1);
END$$;
REVOKE ALL ON FUNCTION platform_private.b2b_financial_forecast_after_approval_v1(uuid,jsonb),platform_private.b2b_financial_forecast_events_immutable(),platform_private.b2b_financial_forecast_guard(),platform_private.b2b_financial_forecast_transition_v1(uuid,integer,text,text,jsonb),platform_private.b2b_financial_forecast_cancel_residual_v1(uuid,integer,text) FROM PUBLIC,anon,authenticated,service_role;
-- No direct service caller: canonical wrappers/authority still require review.

CREATE OR REPLACE FUNCTION public.approve_b2b_credit(p_partner_order_id uuid, p_notes text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_order public.partner_orders%ROWTYPE;
  v_final_status public.partner_order_status;
  v_final_reason text;
BEGIN

  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  IF NOT (public.has_role(v_uid,'administrador') OR public.has_role(v_uid,'gestor')
          OR public.has_role(v_uid,'financeiro')) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;

  SELECT * INTO v_order FROM public.partner_orders
   WHERE id = p_partner_order_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'order_not_found'; END IF;
  -- Re-validate authority after the row-lock wait (READ COMMITTED sees revocations committed meanwhile).
  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF NOT (public.has_role(v_uid,'administrador') OR public.has_role(v_uid,'gestor')
          OR public.has_role(v_uid,'financeiro')) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;
  IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1') THEN RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501'; END IF;

  IF v_order.status IN ('aprovado','reprovado','cancelado') THEN
    RAISE EXCEPTION 'already_processed: pedido já está em status %', v_order.status;
  END IF;

  IF v_order.status = 'em_analise_comercial' THEN
    RAISE EXCEPTION 'already_released: crédito já liberado, pedido em análise comercial';
  END IF;

  IF v_order.status <> 'aguardando_aprovacao_credito' THEN
    RAISE EXCEPTION 'invalid_status: %', v_order.status;
  END IF;

  -- H4-003: autoriza gravacao dos campos credit_approved_by/at nesta transacao.
  PERFORM set_config('arbio.b2b_credit_approval', 'on', true);

  UPDATE public.partner_orders SET
    status = 'em_analise_comercial',
    ready_for_production = false,
    approved_by = NULL,
    approved_at = NULL,
    credit_approved_by = COALESCE(credit_approved_by, v_uid),
    credit_approved_at = COALESCE(credit_approved_at, now()),
    credit_approval_notes = COALESCE(NULLIF(p_notes, ''), credit_approval_notes),
    credit_block_reason = NULL,
    updated_at = now()
  WHERE id = p_partner_order_id
    AND status = 'aguardando_aprovacao_credito';

  PERFORM set_config('arbio.b2b_credit_approval', 'off', true);

  IF NOT FOUND THEN
    RAISE EXCEPTION 'concurrent_update: status do pedido mudou durante a aprovação';
  END IF;

  SELECT status, credit_block_reason INTO v_final_status, v_final_reason
  FROM public.partner_orders WHERE id = p_partner_order_id;

  IF v_final_status <> 'em_analise_comercial' THEN
    RAISE EXCEPTION 'credit_release_failed: %', COALESCE(v_final_reason, 'status_nao_liberado');
  END IF;

  INSERT INTO public.partner_order_audit_logs(usuario_id, partner_id, order_id, acao, dados_anteriores, dados_novos)
  VALUES (v_uid, v_order.partner_id, p_partner_order_id, 'credito_aprovado',
          jsonb_build_object('status', v_order.status, 'reason', v_order.credit_block_reason),
          jsonb_build_object('status', v_final_status, 'approved_by', v_uid, 'notes', p_notes));

  RETURN jsonb_build_object('ok', true, 'order_id', p_partner_order_id, 'status', v_final_status);
END;
$function$
;
CREATE OR REPLACE FUNCTION public.approve_b2b_payment_terms_secure(p_partner_order_id uuid, p_notes text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_terms_id uuid;
  v_observed_terms uuid;
  v_observed_updated_at timestamptz;
  v_locked_updated_at timestamptz;
  v_approved_by uuid;
  v_approved_at timestamptz;
  v_approval_status text;
  v_created_by uuid;
  v_numero text;
BEGIN

  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'unauthorized';
  END IF;
  IF NOT (public.has_role(v_uid,'administrador')
       OR public.has_role(v_uid,'financeiro')
       OR public.has_role(v_uid,'gestor_comercial')) THEN
    RAISE EXCEPTION 'unauthorized';
  END IF;

  SELECT po.payment_terms_id,t.updated_at INTO v_observed_terms,v_observed_updated_at
    FROM public.partner_orders po LEFT JOIN public.partner_order_payment_terms t ON t.id=po.payment_terms_id AND t.partner_order_id=po.id WHERE po.id=p_partner_order_id;
  SELECT po.payment_terms_id, po.created_by, po.numero
    INTO v_terms_id, v_created_by, v_numero
  FROM public.partner_orders po
  WHERE po.id = p_partner_order_id FOR UPDATE;
  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor_comercial']::public.app_role[]) IS NULL THEN RAISE EXCEPTION 'unauthorized' USING ERRCODE='42501'; END IF;
  IF v_terms_id IS DISTINCT FROM v_observed_terms THEN RAISE EXCEPTION 'B2B_PAYMENT_TERMS_CAS_CONFLICT' USING ERRCODE='PT409'; END IF;
  IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND (status IN ('cancelado','reprovado') OR c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1')) THEN RAISE EXCEPTION 'B2B_FORECAST_APPROVAL_UNAVAILABLE' USING ERRCODE='42501'; END IF;

  IF v_terms_id IS NULL THEN
    RAISE EXCEPTION 'payment_terms_not_defined';
  END IF;

  SELECT updated_at,approval_status,approved_by,approved_at INTO v_locked_updated_at,v_approval_status,v_approved_by,v_approved_at FROM public.partner_order_payment_terms
    WHERE id=v_terms_id AND partner_order_id=p_partner_order_id FOR UPDATE;
  IF NOT FOUND OR v_locked_updated_at IS DISTINCT FROM v_observed_updated_at THEN
    RAISE EXCEPTION 'B2B_PAYMENT_TERMS_CAS_CONFLICT' USING ERRCODE='PT409'; END IF;
  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor_comercial']::public.app_role[]) IS NULL THEN RAISE EXCEPTION 'unauthorized' USING ERRCODE='42501'; END IF;

  -- Approval is one immutable decision. Repetition is not a notes editor and
  -- cannot replace its original actor/time or redispatch audit/notification.
  -- Authority, parent/child locks and observed CAS were checked before replay.
  IF v_approval_status='approved' THEN
    IF v_approved_by IS NULL OR v_approved_at IS NULL THEN
      RAISE EXCEPTION 'B2B_PAYMENT_TERMS_APPROVAL_UNPROVEN' USING ERRCODE='42501'; END IF;
    RETURN jsonb_build_object('success',true,'status','approved','replayed',true,
      'approved_by',v_approved_by,'approved_at',v_approved_at);
  END IF;
  UPDATE public.partner_order_payment_terms
     SET approval_status = 'approved',
         approved_by = v_uid,
         approved_at = now(),
         approval_notes = COALESCE(p_notes, approval_notes),
         updated_at = now()
   WHERE id = v_terms_id AND partner_order_id = p_partner_order_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'payment_terms_not_defined' USING ERRCODE='42501'; END IF;

  IF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor_comercial']::public.app_role[]) IS NULL THEN RAISE EXCEPTION 'unauthorized' USING ERRCODE='42501'; END IF;
  UPDATE public.partner_orders
     SET financial_approval_status = 'approved',
         payment_condition_status = 'approved',
         updated_at = now()
   WHERE id = p_partner_order_id AND internal_origin_snapshot IS NULL AND c2_external_origin_snapshot IS NULL AND internal_economic_snapshot IS NULL;

  INSERT INTO public.partner_order_audit_logs(order_id, acao, usuario_id, dados_novos)
  VALUES (p_partner_order_id, 'payment_terms_approved', v_uid,
          jsonb_build_object('notes', p_notes));

  -- Notifica comercial (criador)
  IF v_created_by IS NOT NULL THEN
    INSERT INTO public.notificacoes_operacionais(usuario_id, tipo, titulo, mensagem, link)
    VALUES (v_created_by, 'b2b_payment_terms',
            'Condição financeira aprovada',
            format('Pedido %s teve a condição de pagamento aprovada.', COALESCE(v_numero,'B2B')),
            '/comercial/pedidos-b2b');
  END IF;

  IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND status='aprovado' AND approved_by IS NOT NULL AND approved_at IS NOT NULL) THEN
    -- Credit is evaluated inside the helper only after the creation grant/gate.
    PERFORM platform_private.b2b_financial_forecast_after_approval_v1(p_partner_order_id,NULL);
  END IF;
  RETURN jsonb_build_object('success', true, 'status', 'approved');
END;
$function$
;
CREATE OR REPLACE FUNCTION public.approve_partner_order(p_order_id uuid, p_approval_notes text DEFAULT NULL::text, p_estimated_delivery_date date DEFAULT NULL::date)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_pid uuid; v_prev partner_order_status; v_partner_user uuid; v_numero text;
  v_final_status partner_order_status; v_final_ready boolean; v_block text;
  v_amount numeric(14,2); v_credit_ok timestamptz; v_credit jsonb; v_reason text;
BEGIN

  IF NOT (public.b2b_phase1_order_visible(p_order_id) OR EXISTS (
    SELECT 1 FROM public.partner_orders po WHERE po.id=p_order_id
      AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  IF NOT (has_role(v_uid,'administrador') OR has_role(v_uid,'gestor_comercial')) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;

  SELECT partner_id, status, numero,
         ROUND(COALESCE(final_amount_with_interest, total, 0),2), credit_approved_at
    INTO v_pid, v_prev, v_numero, v_amount, v_credit_ok
    FROM public.partner_orders WHERE id = p_order_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'order_not_found'; END IF;
  IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_order_id AND c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1') THEN RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501'; END IF;

  IF v_prev = 'aguardando_cotacao' THEN
    RAISE EXCEPTION 'quote_required: defina o preco da cotacao antes de aprovar';
  END IF;
  IF NOT public.fn_b2b_order_priceable(p_order_id) THEN
    RAISE EXCEPTION 'order_not_priceable_quote_required';
  END IF;

  IF v_prev IN ('aprovado','reprovado','cancelado') THEN
    RAISE EXCEPTION 'already_processed: pedido já está em status %', v_prev;
  END IF;

  IF v_prev = 'aguardando_aprovacao_credito' THEN
    RAISE EXCEPTION 'credit_pending: aprove o crédito antes da análise comercial';
  END IF;

  IF v_prev NOT IN ('em_analise_comercial','solicitado','rascunho') THEN
    RAISE EXCEPTION 'invalid_status_transition: %', v_prev;
  END IF;

  -- H4-001/H4-003: reavaliar credito na aprovacao, com lock por parceiro.
  -- C2 single credit lock domain: same bigint key as create_partner_order_secure and tg_partner_orders_credit_guard.
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || v_pid::text, 0));
  -- Re-validate authority after a possible wait (READ COMMITTED: each statement sees revocations committed meanwhile).
  IF NOT (has_role(v_uid,'administrador') OR has_role(v_uid,'gestor_comercial')) THEN RAISE EXCEPTION 'forbidden'; END IF;
  IF NOT (public.b2b_phase1_order_visible(p_order_id) OR EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id=p_order_id
      AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  v_credit := public.fn_b2b_credit_exposure(v_pid, 0, NULL);
  v_reason := COALESCE(v_credit->>'reason_code','OK');

  IF v_credit_ok IS NULL THEN
    IF v_reason IN ('LIMIT_EXCEEDED_BLOCK','OVERDUE_BLOCK') THEN
      UPDATE public.partner_orders
         SET credit_block_reason = v_reason, updated_at = now()
       WHERE id = p_order_id;
      RAISE EXCEPTION 'credit_block_on_approval: %', v_reason;
    ELSIF v_reason = 'LIMIT_EXCEEDED_APPROVAL' THEN
      -- fail-closed: exige aprovacao financeira formal (approve_b2b_credit).
      UPDATE public.partner_orders
         SET credit_block_reason = v_reason, updated_at = now()
       WHERE id = p_order_id;
      RAISE EXCEPTION 'credit_approval_required: %', v_reason;
    END IF;
  END IF;

  UPDATE public.partner_orders
     SET status = 'aprovado', approved_by = v_uid, approved_at = now(),
         approval_notes = NULLIF(p_approval_notes,''),
         estimated_delivery_date = COALESCE(p_estimated_delivery_date, estimated_delivery_date),
         ready_for_production = CASE WHEN c2_external_origin_snapshot IS NOT NULL THEN false ELSE true END, updated_at = now()
   WHERE id = p_order_id AND status = v_prev;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'concurrent_update: status do pedido mudou durante a aprovação';
  END IF;

  SELECT status, ready_for_production, credit_block_reason
    INTO v_final_status, v_final_ready, v_block
    FROM public.partner_orders WHERE id = p_order_id;

  IF v_final_status <> 'aprovado' OR (v_final_ready IS NOT TRUE AND NOT EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_order_id AND c2_external_origin_snapshot IS NOT NULL AND internal_economic_snapshot IS NOT NULL)) THEN
    RAISE EXCEPTION 'credit_block: %', COALESCE(v_block, 'aprovacao_credito_pendente');
  END IF;

  INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_anteriores, dados_novos)
  VALUES (p_order_id, v_pid, v_uid, 'approved',
          jsonb_build_object('status', v_prev),
          jsonb_build_object('status','aprovado','approval_notes',p_approval_notes,
                             'estimated_delivery_date',p_estimated_delivery_date,
                             'credit_reason_code', v_reason));

  FOR v_partner_user IN SELECT r FROM platform_private.c2_order_partner_recipients(v_pid) r LOOP -- c2_ord_recipients
    INSERT INTO public.notificacoes_operacionais(usuario_id, tipo, titulo, mensagem, link)
    VALUES (v_partner_user, 'pedido_b2b_aprovado',
            'Pedido ' || v_numero || ' aprovado',
            CASE WHEN EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_order_id AND c2_external_origin_snapshot IS NOT NULL)
            THEN 'Seu pedido recebeu aprovação comercial. Planejamento de produção ainda não liberado.'
            ELSE 'Seu pedido foi aprovado e seguirá para planejamento de produção.' END,
            '/portal-parceiro/pedidos');
  END LOOP;
  PERFORM platform_private.b2b_financial_forecast_after_approval_v1(p_order_id, v_credit);
END
$function$
;
DO $$ BEGIN
 IF md5(pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure)) IS DISTINCT FROM '0d3b85049e3b3b799ba81b4cb95be0da' THEN RAISE EXCEPTION 'B2B_FORECAST_APPROVE_INSTALL_POST_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.approve_b2b_payment_terms_secure(uuid,text)'::regprocedure)) IS DISTINCT FROM '28e65625e0a481b93af85cc37cb0af5f' THEN RAISE EXCEPTION 'B2B_FORECAST_TERMS_INSTALL_POST_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.approve_b2b_credit(uuid,text)'::regprocedure)) IS DISTINCT FROM '26c77e55dfcb2b48fdb63cbc5b2819ed' THEN RAISE EXCEPTION 'B2B_FORECAST_CREDIT_APPROVAL_INSTALL_POST_DRIFT';END IF;
 IF md5(pg_get_functiondef('public.fn_b2b_credit_exposure(uuid,numeric,uuid)'::regprocedure)) IS DISTINCT FROM '213ac31f3a30816ead75365b0d1fed18' THEN RAISE EXCEPTION 'B2B_FORECAST_CREDIT_INSTALL_POST_DRIFT';END IF;
END$$;
DO $$ BEGIN
 IF EXISTS(SELECT 1 FROM platform_private.b2b_forecast_creation_allowlist_v1)
  OR (SELECT enabled FROM platform_private.b2b_forecast_creation_gate_v1 WHERE singleton) IS DISTINCT FROM false THEN
  RAISE EXCEPTION 'B2B_FORECAST_CREATION_NOT_CLOSED' USING ERRCODE='42501';END IF;
 IF has_function_privilege('authenticated','platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)','EXECUTE')
  OR has_function_privilege('service_role','platform_private.b2b_forecast_creation_allowed_v1(uuid,uuid,uuid,uuid)','EXECUTE')
  OR has_function_privilege('authenticated','platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)','EXECUTE')
  OR has_function_privilege('service_role','platform_private.b2b_forecast_creation_scope_v1(uuid,uuid,uuid,uuid)','EXECUTE')
  OR has_table_privilege('authenticated','platform_private.b2b_forecast_creation_allowlist_v1','SELECT,INSERT,UPDATE,DELETE')
  OR has_table_privilege('authenticated','platform_private.b2b_forecast_creation_gate_v1','SELECT,INSERT,UPDATE,DELETE') THEN
  RAISE EXCEPTION 'B2B_FORECAST_CREATION_ACL_INVALID' USING ERRCODE='42501';END IF;
END$$;
COMMIT;
