-- REVIEW ONLY INACTIVE; fase 2 service-only, um definitivo por NF.
BEGIN;
SET LOCAL lock_timeout='3s';
CREATE FUNCTION platform_private.b2b_financial_forecast_reconcile_fiscal_v1(p_document uuid,p_receivable uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE a platform_private.b2b_document_allocations;f platform_private.b2b_financial_forecasts;residual numeric;new_state text;
BEGIN
 SELECT * INTO a FROM platform_private.b2b_document_allocations WHERE document_id=p_document AND receivable_id=p_receivable;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_FORECAST_FISCAL_ALLOCATION_UNPROVEN' USING ERRCODE='42501';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=a.order_id FOR UPDATE;
 IF NOT FOUND THEN RETURN jsonb_build_object('forecast_found',false,'legacy_order',true);END IF;
 -- Only the existing fiscal bridge owns this transaction permit. Payloads,
 -- service_role and caller-supplied IDs cannot attest authorization or tenant.
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_fiscal_service_permits p
  WHERE p.transaction_id=txid_current() AND p.document_id=p_document AND p.invoice_id=p_document
   AND p.order_id=a.order_id AND p.order_id=f.order_id AND p.organization_id=f.organization_id AND p.partner_id=f.partner_id) THEN
  RAISE EXCEPTION 'B2B_FISCAL_SERVICE_PERMIT_REQUIRED' USING ERRCODE='42501';END IF;
 PERFORM platform_private.b2b_integration_dependencies();
 IF EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecast_events WHERE forecast_id=f.id AND event_type='FISCAL_CONFIRMED' AND event_reference=p_document::text) THEN
  RETURN jsonb_build_object('forecast_id',f.id,'state',f.state,'version',f.version,'replayed',true);END IF;
 IF f.state IN ('cancelado_antes_nf','cancelado_residual') THEN
  RAISE EXCEPTION 'B2B_FORECAST_RESIDUAL_CANCELED' USING ERRCODE='PT409';END IF;
 residual:=platform_private.b2b_order_residual(a.order_id);new_state:=CASE WHEN residual=0 THEN 'faturado_total' ELSE 'faturado_parcial' END;
 UPDATE platform_private.b2b_financial_forecasts SET residual_amount=residual,state=new_state,fiscal_intent_id=NULL,last_error_code=NULL,version=version+1,updated_at=now() WHERE id=f.id;
 INSERT INTO platform_private.b2b_financial_forecast_events(forecast_id,event_type,event_reference,payload)
 VALUES(f.id,'FISCAL_CONFIRMED',p_document::text,jsonb_build_object('receivable_id',p_receivable,'residual',residual,'due_dates_estimated',false));
 RETURN jsonb_build_object('forecast_id',f.id,'state',new_state,'residual_amount',residual,'version',f.version+1,'replayed',false);
END$$;


REVOKE ALL ON FUNCTION platform_private.b2b_financial_forecast_reconcile_fiscal_v1(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
-- Owner-only nested invocation from the existing fiscal bridge; no service grant.
DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('public.rpc_fiscal_sefaz_transmit_begin_v1(text,text,text,text,uuid,uuid,uuid,uuid)','4d93bb04e4a18771ed9185d2f3c5d6dc','postgres','578c00048ab38c285e229e11ff6211ec')) x(sig,body_md5,owner,acl_md5) LOOP
  IF to_regprocedure(d.sig) IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_PRE_MISSING:%',d.sig USING ERRCODE='42501'; END IF;
  IF md5(pg_get_functiondef(d.sig::regprocedure)) IS DISTINCT FROM d.body_md5 THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_PRE_BODY:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=d.sig::regprocedure) IS DISTINCT FROM d.owner THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_PRE_OWNER:%',d.sig USING ERRCODE='42501'; END IF;
  IF d.acl_md5 IS NOT NULL AND (SELECT md5(string_agg(v.entry,'|' ORDER BY v.entry)) FROM (
    SELECT CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE a.grantee::regrole::text END||'='||a.privilege_type||CASE WHEN a.is_grantable THEN '*' ELSE '' END||'/'||a.grantor::regrole::text entry
    FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=d.sig::regprocedure) v) IS DISTINCT FROM d.acl_md5
  THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_PRE_ACL:%',d.sig USING ERRCODE='42501'; END IF;
 END LOOP;
END $guard$;
CREATE OR REPLACE FUNCTION public.rpc_fiscal_sefaz_transmit_begin_v1(_service text, _idempotency_key text, _request_fingerprint text, _endpoint_url text, _invoice_id uuid DEFAULT NULL::uuid, _xml_run_id uuid DEFAULT NULL::uuid, _actor uuid DEFAULT NULL::uuid, _event_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_ref       text;
  v_prod      boolean;
  v_tpamb     text;
  v_host      text;
  v_run       public.fiscal_xml_runs;
  v_ev        record;
  v_invoice   uuid := _invoice_id;
  v_existing  public.fiscal_sefaz_transmissions;
  v_row       public.fiscal_sefaz_transmissions;
BEGIN
  IF coalesce(btrim(_idempotency_key), '') = '' OR length(_idempotency_key) > 200 THEN
    RAISE EXCEPTION 'FISCAL_TRANSMISSION_IDEMPOTENCY_INVALID';
  END IF;
  IF coalesce(btrim(_request_fingerprint), '') = '' THEN
    RAISE EXCEPTION 'FISCAL_TRANSMISSION_FINGERPRINT_REQUIRED';
  END IF;

  SELECT project_ref, production_emission_allowed INTO v_ref, v_prod
    FROM public.fiscal_environment_marker LIMIT 1;
  IF v_ref IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' OR coalesce(v_prod, true) THEN
    RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
  END IF;

  SELECT coalesce(nfe_environment_code, '') INTO v_tpamb
    FROM public.company_fiscal_settings WHERE is_active LIMIT 1;
  IF v_tpamb IS DISTINCT FROM '2' THEN
    RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
  END IF;

  v_host := split_part(split_part(_endpoint_url, '://', 2), '/', 1);
  IF _endpoint_url NOT LIKE 'https://hnfe.fazenda.mg.gov.br/%'
     OR v_host <> 'hnfe.fazenda.mg.gov.br' THEN
    RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
  END IF;

  -- H7G-001: na autorização, o invoice é DERIVADO do XML run. O parâmetro do
  -- chamador nunca é autoridade; divergência é bloqueio duro.
  IF _service = 'NFeAutorizacao4' THEN
    IF _xml_run_id IS NULL THEN RAISE EXCEPTION 'SEFAZ_RUN_REQUIRED'; END IF;
    SELECT * INTO v_run FROM public.fiscal_xml_runs WHERE id = _xml_run_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'SEFAZ_RUN_NOT_FOUND'; END IF;
    IF v_run.state IS DISTINCT FROM 'SIGNED' OR coalesce(v_run.signed_path, '') = '' THEN
      RAISE EXCEPTION 'SEFAZ_DOCUMENT_NOT_SIGNED';
    END IF;
    IF coalesce(v_run.environment_code, '') <> '2' THEN
      RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
    END IF;
    IF coalesce(v_run.access_key, '') !~ '^[0-9]{44}$' THEN
      RAISE EXCEPTION 'SEFAZ_ACCESS_KEY_INVALID';
    END IF;
    IF v_run.fiscal_invoice_id IS NULL THEN RAISE EXCEPTION 'SEFAZ_RUN_INVOICE_MISSING'; END IF;
    IF _invoice_id IS NOT NULL AND _invoice_id IS DISTINCT FROM v_run.fiscal_invoice_id THEN
      RAISE EXCEPTION 'SEFAZ_INVOICE_RUN_MISMATCH';
    END IF;
    v_invoice := v_run.fiscal_invoice_id;
  END IF;

  -- H7G-002: no evento, invoice e chave vêm do evento fiscal canônico.
  IF _service = 'NFeRecepcaoEvento4' THEN
    IF _event_id IS NULL THEN RAISE EXCEPTION 'SEFAZ_EVENT_REQUIRED'; END IF;
    SELECT * INTO v_ev FROM public.v_fiscal_sefaz_event_state WHERE event_id = _event_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'SEFAZ_EVENT_NOT_FOUND'; END IF;
    IF v_ev.state <> 'SIGNED' THEN RAISE EXCEPTION 'SEFAZ_EVENT_NOT_SIGNED'; END IF;
    IF _invoice_id IS NOT NULL AND _invoice_id IS DISTINCT FROM v_ev.fiscal_invoice_id THEN
      RAISE EXCEPTION 'SEFAZ_EVENT_INVOICE_MISMATCH';
    END IF;
    v_invoice := v_ev.fiscal_invoice_id;
  END IF;

  -- Shared serialization with cancel: invoice -> order -> forecast, as H13.
  -- Runs in the canonical worker writer, before any transmission insert/replay.
  IF v_invoice IS NOT NULL AND _service IN ('NFeAutorizacao4','NFeRetAutorizacao4','NFeConsultaProtocolo4') THEN
    PERFORM i.id FROM public.fiscal_invoices i WHERE i.id=v_invoice FOR SHARE;
    PERFORM po.id FROM public.partner_orders po JOIN public.fiscal_invoices i ON i.partner_order_id=po.id
      WHERE i.id=v_invoice FOR UPDATE OF po;
    PERFORM f.id FROM platform_private.b2b_financial_forecasts f JOIN public.fiscal_invoices i ON i.partner_order_id=f.order_id
      WHERE i.id=v_invoice FOR UPDATE OF f;
    IF _service='NFeAutorizacao4' AND EXISTS(SELECT 1 FROM platform_private.b2b_financial_forecasts f
      JOIN public.fiscal_invoices i ON i.partner_order_id=f.order_id WHERE i.id=v_invoice
      AND (f.organization_id IS DISTINCT FROM i.organization_id OR f.partner_id IS DISTINCT FROM i.debtor_partner_id
       OR f.state IN ('cancelado_antes_nf','cancelado_residual','consulta_fiscal_obrigatoria','faturado_total')
       OR i.total_amount>f.residual_amount OR i.total_amount<=0)) THEN
      RAISE EXCEPTION 'B2B_FORECAST_BEGIN_BLOCKED' USING ERRCODE='PT409';
    END IF;
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('fiscal_sefaz_tx:' || _idempotency_key, 0));

  SELECT * INTO v_existing FROM public.fiscal_sefaz_transmissions
   WHERE idempotency_key = _idempotency_key;

  IF FOUND THEN
    IF v_existing.request_fingerprint IS DISTINCT FROM _request_fingerprint THEN
      RAISE EXCEPTION 'FISCAL_TRANSMISSION_IDEMPOTENCY_MISMATCH';
    END IF;
    RETURN jsonb_build_object(
      'transmissionId', v_existing.id, 'state', v_existing.state,
      'outcome', v_existing.outcome,
      'service', v_existing.service, 'correlationId', v_existing.correlation_id,
      'invoiceId', v_existing.fiscal_invoice_id, 'eventId', v_existing.fiscal_event_id,
      'cStat', v_existing.c_stat, 'xMotivo', v_existing.x_motivo,
      'chNFe', v_existing.ch_nfe, 'nProt', v_existing.n_prot,
      'idempotentReplay', true);
  END IF;

  -- Documento já autorizado nunca é reenviado (invoice canônico).
  IF v_invoice IS NOT NULL AND _service IN ('NFeAutorizacao4','NFeRetAutorizacao4') THEN
    SELECT * INTO v_existing FROM public.fiscal_sefaz_transmissions
     WHERE fiscal_invoice_id = v_invoice
       AND state = 'SUCCEEDED'
       AND outcome = 'AUTHORIZED'
     ORDER BY created_at DESC LIMIT 1;
    IF FOUND THEN
      RETURN jsonb_build_object(
        'transmissionId', v_existing.id, 'state', v_existing.state,
        'outcome', v_existing.outcome,
        'service', v_existing.service, 'correlationId', v_existing.correlation_id,
        'invoiceId', v_existing.fiscal_invoice_id,
        'cStat', v_existing.c_stat, 'xMotivo', v_existing.x_motivo,
        'chNFe', v_existing.ch_nfe, 'nProt', v_existing.n_prot,
        'alreadyAuthorized', true, 'idempotentReplay', true);
    END IF;
  END IF;

  INSERT INTO public.fiscal_sefaz_transmissions (
    fiscal_invoice_id, xml_run_id, fiscal_event_id, service, environment_code,
    endpoint_host, endpoint_url, idempotency_key, request_fingerprint,
    state, outcome, attempt, created_by)
  VALUES (v_invoice, _xml_run_id, _event_id, _service, '2',
          v_host, _endpoint_url, _idempotency_key, _request_fingerprint,
          'PENDING', 'PENDING', 1, _actor)
  RETURNING * INTO v_row;

  RETURN jsonb_build_object(
    'transmissionId', v_row.id, 'state', v_row.state, 'outcome', v_row.outcome,
    'service', v_row.service, 'correlationId', v_row.correlation_id,
    'invoiceId', v_row.fiscal_invoice_id, 'eventId', v_row.fiscal_event_id,
    'idempotentReplay', false);
END $function$
;
DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('public.rpc_fiscal_sefaz_transmit_begin_v1(text,text,text,text,uuid,uuid,uuid,uuid)','215f8368520d3cd53fc937f25aff0879','postgres','578c00048ab38c285e229e11ff6211ec')) x(sig,body_md5,owner,acl_md5) LOOP
  IF to_regprocedure(d.sig) IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_POST_MISSING:%',d.sig USING ERRCODE='42501'; END IF;
  IF md5(pg_get_functiondef(d.sig::regprocedure)) IS DISTINCT FROM d.body_md5 THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_POST_BODY:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=d.sig::regprocedure) IS DISTINCT FROM d.owner THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_POST_OWNER:%',d.sig USING ERRCODE='42501'; END IF;
  IF d.acl_md5 IS NOT NULL AND (SELECT md5(string_agg(v.entry,'|' ORDER BY v.entry)) FROM (
    SELECT CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE a.grantee::regrole::text END||'='||a.privilege_type||CASE WHEN a.is_grantable THEN '*' ELSE '' END||'/'||a.grantor::regrole::text entry
    FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=d.sig::regprocedure) v) IS DISTINCT FROM d.acl_md5
  THEN RAISE EXCEPTION 'B2B_FORECAST_BEGIN_POST_ACL:%',d.sig USING ERRCODE='42501'; END IF;
 END LOOP;
END $guard$;
CREATE OR REPLACE FUNCTION public.rpc_b2b_forecast_fiscal_sync_v1(p_transmission_id uuid, p_expected_version integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE t public.fiscal_sefaz_transmissions;inv public.fiscal_invoices;f platform_private.b2b_financial_forecasts;
 v_invoice uuid;org uuid;ev text;payload jsonb;att integer;result jsonb;
BEGIN
 -- Authority is derived server-side from the JWT actor; payload/IDs never attest it.
 org:=platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro']::public.app_role[]);
 IF org IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_FISCAL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 IF p_transmission_id IS NULL OR p_expected_version IS NULL OR p_expected_version<1 THEN
  RAISE EXCEPTION 'B2B_FORECAST_EVENT_INVALID' USING ERRCODE='22023';END IF;
 SELECT t0.fiscal_invoice_id INTO v_invoice FROM public.fiscal_sefaz_transmissions t0
 JOIN public.fiscal_invoices i ON i.id=t0.fiscal_invoice_id
 WHERE t0.id=p_transmission_id AND i.organization_id=org
 AND platform_private.c2p1_settings_allowed(i.debtor_partner_id,true);
 IF v_invoice IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_FISCAL_SOURCE_UNPROVEN' USING ERRCODE='42501';END IF;
 -- Canonical H13 order: fiscal invoice, transmission, then forecast (bridge: invoice, order, forecast).
 SELECT * INTO inv FROM public.fiscal_invoices WHERE id=v_invoice AND organization_id=org FOR SHARE;
 SELECT * INTO t FROM public.fiscal_sefaz_transmissions WHERE id=p_transmission_id FOR SHARE;
 IF NOT FOUND OR t.fiscal_invoice_id IS DISTINCT FROM inv.id THEN
  RAISE EXCEPTION 'FISCAL_TRANSMISSION_LINK_CHANGED' USING ERRCODE='PT409';END IF;
 IF inv.partner_order_id IS NULL OR inv.organization_id IS DISTINCT FROM org OR inv.debtor_partner_id IS NULL THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_SOURCE_UNPROVEN' USING ERRCODE='42501';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=inv.partner_order_id AND organization_id=org FOR UPDATE;
 IF NOT FOUND OR f.organization_id IS DISTINCT FROM inv.organization_id OR f.partner_id IS DISTINCT FROM inv.debtor_partner_id THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_SOURCE_UNPROVEN' USING ERRCODE='42501';END IF;
 -- Re-authorize after every wait: role, profile, tenant and seller scope may have been revoked.
 IF platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro']::public.app_role[]) IS DISTINCT FROM f.organization_id
  OR NOT platform_private.c2p1_settings_allowed(f.partner_id,true) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 IF t.outcome='AUTHORIZED' THEN
  -- Definitive confirmation exists only through the H13 callback and fiscal bridge permit.
  RETURN jsonb_build_object('forecast_id',f.id,'state',f.state,'version',f.version,'event',NULL,
   'fiscal_confirmation','H13_BRIDGE_ONLY','transmission_id',t.id,'invoice_id',inv.id);
 END IF;
 IF t.service='NFeAutorizacao4' THEN
  ev:=CASE WHEN t.state IN ('PENDING','SENT') AND coalesce(t.outcome,'PENDING') IN ('PENDING','PROCESSING') THEN 'EMISSION_STARTED'
           WHEN t.state IN ('FAILED','BLOCKED') AND t.outcome='TRANSPORT_ERROR' THEN 'EMISSION_TIMEOUT'
           WHEN t.state='SUCCEEDED' AND t.outcome='REJECTED' THEN 'EMISSION_REJECTED' END;
 ELSIF t.service IN ('NFeRetAutorizacao4','NFeConsultaProtocolo4') THEN
  -- Only protocol consultation 217, for the current exact document/key/environment,
  -- concludes absence. Receipt/schema/auth failures (including RetAutorizacao) do not.
  IF t.service='NFeConsultaProtocolo4' AND t.state='SUCCEEDED' AND t.outcome='REJECTED'
   AND t.c_stat='217' AND t.ch_nfe=inv.access_key AND inv.environment='HOMOLOGATION'
   AND t.environment_code='2' AND t.ambiente_retorno='2'
   AND t.xml_run_id IS NOT NULL AND EXISTS(SELECT 1 FROM public.fiscal_xml_runs r
     WHERE r.id=t.xml_run_id AND r.fiscal_invoice_id=inv.id AND r.access_key=inv.access_key AND r.environment_code='2')
   AND t.n_prot IS NULL AND t.n_rec IS NULL
   AND f.fiscal_intent_id=inv.id
   AND NOT EXISTS(SELECT 1 FROM public.fiscal_sefaz_transmissions newer
     JOIN public.fiscal_invoices ni ON ni.id=newer.fiscal_invoice_id
     WHERE ni.partner_order_id=inv.partner_order_id AND newer.id<>t.id
      AND (newer.created_at,newer.id)>(t.created_at,t.id)) THEN
    ev:='CONSULTATION_NOT_AUTHORIZED';
  END IF;
 END IF;
 IF ev IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_FISCAL_OUTCOME_NOT_SYNCABLE' USING ERRCODE='PT409';END IF;
 IF ev='EMISSION_STARTED' AND (inv.total_amount IS NULL OR inv.total_amount<=0 OR inv.total_amount>f.residual_amount) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_AMOUNT_EXCEEDS_RESIDUAL' USING ERRCODE='PT409';END IF;
 att:=coalesce(t.attempt,0)+1;
 payload:=jsonb_build_object('attempt',att::text,'invoice_id',inv.id,'transmission_id',t.id,'service',t.service,'source','fiscal_sefaz_transmissions')
  ||CASE WHEN ev='EMISSION_STARTED' THEN '{}'::jsonb
         ELSE jsonb_build_object('error_code',coalesce(nullif(t.error_code,''),nullif(t.c_stat,''),t.outcome)) END;
 result:=platform_private.b2b_financial_forecast_transition_v1(f.id,p_expected_version,ev,inv.id::text,payload);
 RETURN result||jsonb_build_object('event',ev,'transmission_id',t.id,'invoice_id',inv.id);
END
$function$;
CREATE OR REPLACE FUNCTION public.rpc_b2b_forecast_cancel_residual_v1(p_order uuid, p_expected_version integer, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE po public.partner_orders;f platform_private.b2b_financial_forecasts;org uuid;
BEGIN
 org:=platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro']::public.app_role[]);
 IF org IS NULL THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 IF p_order IS NULL OR p_expected_version IS NULL OR nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN
  RAISE EXCEPTION 'B2B_FORECAST_CANCEL_REASON_REQUIRED' USING ERRCODE='22023';END IF;
 -- Canonical order: order row first, then forecast (same as approval and the bridge).
 SELECT * INTO po FROM public.partner_orders WHERE id=p_order
  AND EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=partner_orders.partner_id
   AND pa.commercial_owner_organization_id=org)
  AND platform_private.c2p1_settings_allowed(partner_id,true) FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 SELECT * INTO f FROM platform_private.b2b_financial_forecasts WHERE order_id=p_order AND organization_id=org FOR UPDATE;
 IF NOT FOUND OR f.partner_id IS DISTINCT FROM po.partner_id THEN
  RAISE EXCEPTION 'B2B_FORECAST_CAS_CONFLICT' USING ERRCODE='PT409';END IF;
 IF platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro']::public.app_role[]) IS DISTINCT FROM f.organization_id
  OR NOT platform_private.c2p1_settings_allowed(f.partner_id,true) THEN
  RAISE EXCEPTION 'B2B_FORECAST_CANCEL_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 -- An emission/consultation still open or an authorized return awaiting close must settle first.
 IF EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN public.fiscal_sefaz_transmissions t ON t.fiscal_invoice_id=i.id
   WHERE i.partner_order_id=p_order AND t.state IN ('PENDING','SENT')) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_IN_FLIGHT' USING ERRCODE='PT409';END IF;
 IF EXISTS(SELECT 1 FROM public.fiscal_invoices i JOIN platform_private.fiscal_close_pending cp ON cp.fiscal_invoice_id=i.id
   WHERE i.partner_order_id=p_order) THEN
  RAISE EXCEPTION 'B2B_FORECAST_FISCAL_RECONCILIATION_PENDING' USING ERRCODE='PT409';END IF;
 RETURN platform_private.b2b_financial_forecast_cancel_residual_v1(f.id,p_expected_version,p_reason)
  ||jsonb_build_object('actor',auth.uid(),'order_id',p_order);
END
$function$;
REVOKE ALL ON FUNCTION public.rpc_b2b_forecast_fiscal_sync_v1(uuid,integer),public.rpc_b2b_forecast_cancel_residual_v1(uuid,integer,text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_b2b_forecast_fiscal_sync_v1(uuid,integer),public.rpc_b2b_forecast_cancel_residual_v1(uuid,integer,text) TO authenticated;
-- Private transition/cancel/reconcile keep NO grant: only these owner wrappers and the bridge nest them.

COMMIT;
