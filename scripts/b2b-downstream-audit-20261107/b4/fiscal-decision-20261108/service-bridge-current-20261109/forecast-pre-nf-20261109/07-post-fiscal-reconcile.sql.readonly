 IF md5(pg_get_functiondef('public.rpc_b2b_forecast_fiscal_sync_v1(uuid,integer)'::regprocedure)) IS DISTINCT FROM 'ac88b7fb8d7d792eb589f0c6cce348b9' OR md5(pg_get_functiondef('public.rpc_b2b_forecast_cancel_residual_v1(uuid,integer,text)'::regprocedure)) IS DISTINCT FROM '00cb8bcda7716bb4fa15a93acc4c1c5f' THEN RAISE EXCEPTION 'B2B_FORECAST_WRAPPER_BODY_DRIFT';END IF;
