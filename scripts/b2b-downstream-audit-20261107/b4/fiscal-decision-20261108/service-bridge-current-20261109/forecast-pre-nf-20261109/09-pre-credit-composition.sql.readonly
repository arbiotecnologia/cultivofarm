-- REVIEW ONLY READ ONLY. 09: composição de crédito exige B4 POST exato (nunca LIVE nem pré-B4 residual).
BEGIN READ ONLY;
DO $$ BEGIN
 IF current_setting('b2b_forecast.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_REF_NOT_VERIFIED';END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_FORECAST_MISSING';END IF;
 IF to_regclass('platform_private.b2b_document_allocations') IS NULL OR to_regclass('platform_private.b2b_allocation_reversals') IS NULL THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_B4_MISSING';END IF;
END$$;
DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('public.fn_b2b_credit_exposure(uuid,numeric,uuid)','44e8768ff53d7fe5ff3b9f0889258946','postgres','578c00048ab38c285e229e11ff6211ec'),('public.fn_b2b_order_billing_eligibility(uuid)','db977875e15ea49ce10fb3e5388d7dfb','postgres','578c00048ab38c285e229e11ff6211ec'),('platform_private.b2b_credit_balances(uuid,uuid)','9fbf08a16f6bcbec379945886c85c245','postgres','aae127bcdd4f7096876d7094c14eabd1'),('platform_private.b2b_order_residual(uuid)','93769163bfc7c72a4bbc722e62313179','postgres','aae127bcdd4f7096876d7094c14eabd1')) x(sig,body_md5,owner,acl_md5) LOOP
  IF to_regprocedure(d.sig) IS NULL THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_PRE_MISSING:%',d.sig USING ERRCODE='42501'; END IF;
  IF md5(pg_get_functiondef(d.sig::regprocedure)) IS DISTINCT FROM d.body_md5 THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_PRE_BODY:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=d.sig::regprocedure) IS DISTINCT FROM d.owner THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_PRE_OWNER:%',d.sig USING ERRCODE='42501'; END IF;
  IF d.acl_md5 IS NOT NULL AND (SELECT md5(string_agg(v.entry,'|' ORDER BY v.entry)) FROM (
    SELECT CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE a.grantee::regrole::text END||'='||a.privilege_type||CASE WHEN a.is_grantable THEN '*' ELSE '' END||'/'||a.grantor::regrole::text entry
    FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=d.sig::regprocedure) v) IS DISTINCT FROM d.acl_md5
  THEN RAISE EXCEPTION 'B2B_CREDIT_COMPOSITION_PRE_ACL:%',d.sig USING ERRCODE='42501'; END IF;
 END LOOP;
END $guard$;
ROLLBACK;
