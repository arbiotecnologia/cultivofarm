-- REVIEW ONLY INACTIVE; executar somente após 01-pre e ponte estrita.
BEGIN;
SET LOCAL lock_timeout='3s';
DO $$ BEGIN
 IF current_setting('b2b_fiscal_bridge.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_FISCAL_REF_NOT_VERIFIED'; END IF;
 IF md5(pg_get_functiondef('public.tg_h7_fiscal_invoice_immutable_v1()'::regprocedure)) IS DISTINCT FROM '37b2342921df8bf839f4597ad033696d' THEN RAISE EXCEPTION 'H7_LINK_INSTALL_PRE_DRIFT'; END IF;
END $$;
CREATE OR REPLACE FUNCTION public.tg_h7_fiscal_invoice_immutable_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  IF NOT public.fn_fiscal_status_is_terminal(OLD.normalized_status) THEN
    RETURN NEW;
  END IF;

  IF NEW.invoice_number IS DISTINCT FROM OLD.invoice_number
     OR NEW.series        IS DISTINCT FROM OLD.series
     OR NEW.access_key    IS DISTINCT FROM OLD.access_key
     OR NEW.total_amount  IS DISTINCT FROM OLD.total_amount
     OR NEW.issue_date    IS DISTINCT FROM OLD.issue_date
     OR NEW.invoice_type  IS DISTINCT FROM OLD.invoice_type
     OR (NEW.receivable_id IS DISTINCT FROM OLD.receivable_id
       AND NOT (
         OLD.normalized_status = 'AUTHORIZED'
         AND NEW.normalized_status = 'AUTHORIZED'
         AND OLD.receivable_id IS NULL
         AND NEW.receivable_id IS NOT NULL
         AND EXISTS (
           SELECT 1
             FROM platform_private.b2b_fiscal_service_permits p
             JOIN public.accounts_receivable ar ON ar.id = NEW.receivable_id
            WHERE p.transaction_id = txid_current()
              AND p.invoice_id = OLD.id
              AND p.document_id = OLD.id
              AND p.organization_id = OLD.organization_id
              AND p.order_id = OLD.partner_order_id
              AND p.partner_id = OLD.debtor_partner_id
              AND ar.b2b_document_id = OLD.id
              AND ar.organization_id = OLD.organization_id
              AND ar.origin_type = 'B2B_ORDER'
              AND ar.origin_id = OLD.partner_order_id
              AND ar.partner_id = OLD.debtor_partner_id
         )
       ))
  THEN
    RAISE EXCEPTION
      'FISCAL_DOCUMENT_LOCKED: documento em estado % nao aceita alteracao economica/fiscal informal.',
      OLD.normalized_status
      USING ERRCODE = 'P0001';
  END IF;

  -- Transições de estado permitidas a partir de um estado terminal.
  IF NEW.normalized_status IS DISTINCT FROM OLD.normalized_status THEN
    IF NOT (OLD.normalized_status = 'AUTHORIZED'
            AND NEW.normalized_status IN ('CANCEL_REQUESTED','CANCELED','SUBSTITUTED')) THEN
      RAISE EXCEPTION
        'FISCAL_STATE_TRANSITION_INVALID: % -> % nao permitida.',
        OLD.normalized_status, NEW.normalized_status
        USING ERRCODE = 'P0001';
    END IF;
  END IF;

  RETURN NEW;
END;
$function$
;
DO $$ BEGIN
 IF md5(pg_get_functiondef('public.tg_h7_fiscal_invoice_immutable_v1()'::regprocedure)) IS DISTINCT FROM '8476dc6c6672b500406d0388da380e83' THEN RAISE EXCEPTION 'H7_LINK_INSTALL_POST_DRIFT'; END IF;
END $$;
COMMIT;
