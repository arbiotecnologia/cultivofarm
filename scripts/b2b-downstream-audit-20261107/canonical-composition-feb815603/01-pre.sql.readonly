DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('public.fn_b2b_credit_exposure(uuid,numeric,uuid)','213ac31f3a30816ead75365b0d1fed18','postgres','578c00048ab38c285e229e11ff6211ec'),('public.fn_generate_receivable_installments()','f632f15c9f46cb9889082fc533a27ea1','postgres','578c00048ab38c285e229e11ff6211ec'),('public.generate_b2b_receivable_secure_impl(uuid)','1bdac7fae6d702fb42d3a30539e9c9c3','postgres','578c00048ab38c285e229e11ff6211ec'),('public.rpc_register_receivable_payment(uuid,jsonb)','db41f7e2cfcb196ef64536f62746f365','postgres','04e771375e06113da45adc7fa45d56af'),('public.tg_auto_b2b_receivable()','0f679538fe394924b140e54938a3bb9e','postgres','578c00048ab38c285e229e11ff6211ec')) x(sig,body_md5,owner,acl_md5) LOOP
  IF to_regprocedure(d.sig) IS NULL THEN RAISE EXCEPTION 'B4_PRE_SHARED_MISSING:%',d.sig USING ERRCODE='42501'; END IF;
  IF md5(pg_get_functiondef(d.sig::regprocedure)) IS DISTINCT FROM d.body_md5 THEN RAISE EXCEPTION 'B4_PRE_SHARED_BODY:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=d.sig::regprocedure) IS DISTINCT FROM d.owner THEN RAISE EXCEPTION 'B4_PRE_SHARED_OWNER:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT md5(string_agg(v.entry,'|' ORDER BY v.entry)) FROM (
    SELECT CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE a.grantee::regrole::text END||'='||a.privilege_type||CASE WHEN a.is_grantable THEN '*' ELSE '' END||'/'||a.grantor::regrole::text entry
    FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=d.sig::regprocedure) v) IS DISTINCT FROM d.acl_md5
  THEN RAISE EXCEPTION 'B4_PRE_SHARED_ACL:%',d.sig USING ERRCODE='42501'; END IF;
 END LOOP;
END $guard$;DO $guard$ BEGIN
 IF (SELECT pg_get_userbyid(relowner) FROM pg_class WHERE oid='public.accounts_receivable'::regclass)<>'postgres' THEN RAISE EXCEPTION 'B4_PRE_TABLE_OWNER' USING ERRCODE='42501'; END IF;
