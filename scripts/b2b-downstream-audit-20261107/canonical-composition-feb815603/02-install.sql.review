-- REVIEW ONLY INATIVO/NÃO APROVADO; ordem canônica planos→B4→ponte.
SET commercial_plans.review_project_ref='swzpzcwiasxmjutrmvkm';
-- REVIEW ONLY; não aplicar sem autorização. Gerado de capturas LIVE completas.
BEGIN;
SET LOCAL lock_timeout='3s';
DO $$
DECLARE sig text; expected text; BEGIN
  IF current_setting('commercial_plans.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_REF_NOT_VERIFIED'; END IF;
  IF to_regclass('public.commercial_payment_plans') IS NULL OR to_regclass('platform_private.b2b_condition_versions') IS NULL THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_BASE_MISSING'; END IF;
  IF EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans' AND column_name='organization_id') THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_ALREADY_INSTALLED'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type,',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans') IS DISTINCT FROM 'fa11d3b5c4d1737c9a5e98cdece94c55' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_COLUMNS_DRIFT'; END IF;
  IF (SELECT indexdef FROM pg_indexes WHERE schemaname='public' AND tablename='commercial_payment_plans' AND indexname='uq_cpp_single_default') IS DISTINCT FROM 'CREATE UNIQUE INDEX uq_cpp_single_default ON public.commercial_payment_plans USING btree ((true)) WHERE is_default' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_DEFAULT_INDEX_DRIFT'; END IF;
  IF (SELECT pg_get_constraintdef(c.oid) FROM pg_constraint c WHERE c.conrelid='public.commercial_payment_plans'::regclass AND c.conname='commercial_payment_plans_code_key' AND c.contype='u') IS DISTINCT FROM 'UNIQUE (code)' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_CODE_CONSTRAINT_DRIFT'; END IF;
  IF to_regprocedure('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'::regprocedure)) IS DISTINCT FROM '58c003869c6c6159a78fd3009296476a' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_PIN_DRIFT: public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'; END IF;
