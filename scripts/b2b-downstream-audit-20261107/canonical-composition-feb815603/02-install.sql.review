 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='a01_b2b_fiscal_title_fence' AND tgrelid='public.accounts_receivable'::regclass AND NOT tgisinternal AND tgenabled='O') THEN RAISE EXCEPTION 'B4_POST_TRIGGER:public.accounts_receivable.a01_b2b_fiscal_title_fence' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='a01_b2b_fiscal_title_identity' AND tgrelid='public.accounts_receivable'::regclass AND NOT tgisinternal AND tgenabled='O') THEN RAISE EXCEPTION 'B4_POST_TRIGGER:public.accounts_receivable.a01_b2b_fiscal_title_identity' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='cancellation_scope_lock' AND tgrelid='platform_private.b2b_cancellation_attestations'::regclass AND NOT tgisinternal AND tgenabled='O') THEN RAISE EXCEPTION 'B4_POST_TRIGGER:platform_private.b2b_cancellation_attestations.cancellation_scope_lock' USING ERRCODE='42501'; END IF;
END $guard$;SELECT 'POST_OK' AS status;

SET b2b_fiscal_bridge.review_project_ref='swzpzcwiasxmjutrmvkm';
-- REVIEW ONLY; ponte service-only inativa até revisão e autorização.
BEGIN;
SET LOCAL lock_timeout='3s';
-- READONLY PRE da ponte; ref e fontes exatas.
DO $$ BEGIN
 IF current_setting('b2b_fiscal_bridge.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_FISCAL_REF_NOT_VERIFIED'; END IF;
 IF to_regprocedure('platform_private.b2b_fiscal_invoice_bridge_v1(uuid)') IS NOT NULL THEN RAISE EXCEPTION 'B2B_FISCAL_BRIDGE_ALREADY_INSTALLED'; END IF;
 IF to_regclass('platform_private.b2b_fiscal_invoice_snapshots') IS NOT NULL THEN RAISE EXCEPTION 'B2B_FISCAL_SNAPSHOT_ALREADY_EXISTS'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_integration_actor(uuid,boolean)'::regprocedure)) IS DISTINCT FROM 'c6c25ebcb29ba64adafb0bc42295d3b6' THEN RAISE EXCEPTION 'B2B_FISCAL_ACTOR_PIN_DRIFT'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_title_insert_fence()'::regprocedure)) IS DISTINCT FROM '39d8b85a715722b4a976db4e2fd21167' THEN RAISE EXCEPTION 'B2B_FISCAL_FENCE_PIN_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid)'::regprocedure)) IS DISTINCT FROM '9c94985d80502c8aea8bfb5da3abdecd' THEN RAISE EXCEPTION 'B2B_FISCAL_AUTH_PIN_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb)'::regprocedure)) IS DISTINCT FROM 'e340a643e46c6cc0dea0fcebd207f612' THEN RAISE EXCEPTION 'B2B_FISCAL_H13_PIN_DRIFT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='accounts_receivable' AND column_name='created_by' AND is_nullable='NO') THEN RAISE EXCEPTION 'B2B_FISCAL_CREATED_BY_BASELINE_DRIFT'; END IF;
 IF EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='fiscal_sefaz_transmissions' AND column_name='protocol_c_stat') THEN RAISE EXCEPTION 'B2B_FISCAL_PROTOCOL_CSTAT_ALREADY_EXISTS'; END IF;
END $$;

CREATE TABLE platform_private.b2b_fiscal_service_permits(
 transaction_id bigint NOT NULL,invoice_id uuid NOT NULL,document_id uuid NOT NULL,
 organization_id uuid NOT NULL,order_id uuid NOT NULL,partner_id uuid NOT NULL,
 created_at timestamptz NOT NULL DEFAULT now(),PRIMARY KEY(transaction_id,invoice_id));
ALTER TABLE platform_private.b2b_fiscal_service_permits ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_fiscal_service_permits FROM PUBLIC,anon,authenticated,service_role;
CREATE TABLE platform_private.b2b_fiscal_invoice_snapshots(
 invoice_id uuid PRIMARY KEY,transmission_id uuid NOT NULL,protocol text NOT NULL,
 source_digest text NOT NULL,snapshot jsonb NOT NULL,created_at timestamptz NOT NULL DEFAULT now());
ALTER TABLE platform_private.b2b_fiscal_invoice_snapshots ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_fiscal_invoice_snapshots FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.b2b_title_permits ALTER COLUMN actor_id DROP NOT NULL;
ALTER TABLE public.accounts_receivable ALTER COLUMN created_by DROP NOT NULL;
ALTER TABLE public.fiscal_sefaz_transmissions ADD COLUMN protocol_c_stat text;

CREATE FUNCTION platform_private.b2b_fiscal_snapshot_immutable() RETURNS trigger
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
BEGIN RAISE EXCEPTION 'B2B_FISCAL_SNAPSHOT_IMMUTABLE' USING ERRCODE='42501'; END $$;
CREATE TRIGGER b2b_fiscal_snapshot_immutable BEFORE UPDATE OR DELETE ON platform_private.b2b_fiscal_invoice_snapshots
FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_fiscal_snapshot_immutable();
CREATE TRIGGER b2b_fiscal_snapshot_no_truncate BEFORE TRUNCATE ON platform_private.b2b_fiscal_invoice_snapshots
FOR EACH STATEMENT EXECUTE FUNCTION platform_private.b2b_fiscal_snapshot_immutable();

CREATE FUNCTION platform_private.b2b_fiscal_created_by_guard() RETURNS trigger
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
BEGIN
 -- A exceção NULL existe somente para título B2B ligado a uma NF e permit exato.
 -- Nas demais origens preserva-se a antiga obrigatoriedade de created_by.
 IF NEW.b2b_document_id IS NULL THEN
  IF NEW.created_by IS NULL THEN RAISE EXCEPTION 'RECEIVABLE_CREATED_BY_REQUIRED' USING ERRCODE='23502'; END IF;
  RETURN NEW;
 END IF;
 IF NEW.created_by IS NULL AND NOT EXISTS(
   SELECT 1 FROM platform_private.b2b_fiscal_service_permits p
   WHERE p.transaction_id=txid_current() AND p.document_id=NEW.b2b_document_id
    AND p.organization_id=NEW.organization_id AND p.partner_id=NEW.partner_id
 ) THEN RAISE EXCEPTION 'B2B_SERVICE_ORIGIN_REQUIRED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER b2b_fiscal_created_by_guard BEFORE INSERT OR UPDATE OF created_by,b2b_document_id,organization_id,partner_id
ON public.accounts_receivable FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_fiscal_created_by_guard();

CREATE FUNCTION platform_private.b2b_fiscal_invoice_bridge_v1(p_invoice uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE inv public.fiscal_invoices; po public.partner_orders; tx public.fiscal_sefaz_transmissions;
 org uuid; items jsonb; snapshot_items jsonb; canonical_snapshot jsonb; digest_snapshot jsonb; digest text; result jsonb;
 existing platform_private.b2b_authorized_documents; saved platform_private.b2b_fiscal_invoice_snapshots;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'B2B_READ_COMMITTED_REQUIRED' USING ERRCODE='0A000'; END IF;
 SELECT * INTO inv FROM public.fiscal_invoices WHERE id=p_invoice FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_INVOICE_NOT_FOUND' USING ERRCODE='42501'; END IF;
 IF inv.normalized_status IS DISTINCT FROM 'AUTHORIZED' THEN
  RETURN jsonb_build_object('success',true,'skipped',true,'reason',coalesce(inv.normalized_status,inv.status),'receivable_id',NULL);
 END IF;
 -- Nenhum vínculo B2B: preserva o fluxo fiscal existente. Qualquer vínculo parcial,
 -- item de pedido ou documento B4 existente torna a nota B2B e falha fechado se inválida.
 IF inv.partner_order_id IS NULL AND inv.debtor_partner_id IS NULL
  AND NOT EXISTS(SELECT 1 FROM public.fiscal_invoice_items i WHERE i.fiscal_invoice_id=inv.id AND i.partner_order_item_id IS NOT NULL)
  AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_authorized_documents d WHERE d.id=inv.id) THEN
  RETURN jsonb_build_object('success',true,'skipped',true,'reason','NON_B2B','receivable_id',NULL);
 END IF;
 IF inv.partner_order_id IS NULL OR inv.debtor_partner_id IS NULL THEN
  RAISE EXCEPTION 'B2B_FISCAL_ORDER_SCOPE_INVALID' USING ERRCODE='42501';
 END IF;
 IF inv.invoice_type='NFSE' THEN RAISE EXCEPTION 'B2B_FISCAL_NFSE_CALLBACK_UNPROVEN' USING ERRCODE='42501'; END IF;
 IF inv.invoice_type IS DISTINCT FROM 'NFE' OR inv.authorized_at IS NULL OR inv.issue_date IS NULL
  OR inv.environment IS DISTINCT FROM 'HOMOLOGATION' OR coalesce(inv.access_key,'')!~'^[0-9]{44}$'
 THEN RAISE EXCEPTION 'B2B_FISCAL_CONFIRMATION_UNPROVEN' USING ERRCODE='42501'; END IF;
 SELECT * INTO saved FROM platform_private.b2b_fiscal_invoice_snapshots WHERE invoice_id=inv.id;
 IF saved.invoice_id IS NOT NULL THEN
  SELECT * INTO tx FROM public.fiscal_sefaz_transmissions t
  WHERE t.id=saved.transmission_id AND t.fiscal_invoice_id=inv.id AND t.state='SUCCEEDED' AND t.outcome='AUTHORIZED'
   AND coalesce(t.protocol_c_stat,t.c_stat) IN ('100','150') AND t.ch_nfe=inv.access_key AND t.n_prot IS NOT NULL AND t.ambiente_retorno='2';
 ELSE
  SELECT * INTO tx FROM public.fiscal_sefaz_transmissions t
  WHERE t.fiscal_invoice_id=inv.id AND t.state='SUCCEEDED' AND t.outcome='AUTHORIZED'
   AND coalesce(t.protocol_c_stat,t.c_stat) IN ('100','150') AND t.ch_nfe=inv.access_key AND t.n_prot IS NOT NULL AND t.ambiente_retorno='2'
  ORDER BY t.completed_at ASC NULLS LAST,t.id ASC LIMIT 1;
 END IF;
 IF tx.id IS NULL OR NOT EXISTS(SELECT 1 FROM public.fiscal_xml_runs r
   WHERE r.fiscal_invoice_id=inv.id AND r.signed_path IS NOT NULL AND (r.access_key IS NULL OR r.access_key=inv.access_key))
 THEN RAISE EXCEPTION 'B2B_FISCAL_CONFIRMATION_UNPROVEN' USING ERRCODE='42501'; END IF;
 SELECT c.organization_id INTO org FROM public.company_fiscal_settings c
 WHERE c.id=inv.company_settings_id AND c.is_active IS TRUE;
 IF org IS NULL OR inv.organization_id IS DISTINCT FROM org THEN RAISE EXCEPTION 'B2B_FISCAL_TENANT_MISMATCH' USING ERRCODE='42501'; END IF;
 SELECT * INTO po FROM public.partner_orders WHERE id=inv.partner_order_id;
 IF po.id IS NULL OR po.partner_id IS DISTINCT FROM inv.debtor_partner_id OR NOT EXISTS(
   SELECT 1 FROM public.partner_accounts pa WHERE pa.id=po.partner_id AND pa.commercial_owner_organization_id=org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
 ) THEN RAISE EXCEPTION 'B2B_FISCAL_ORDER_SCOPE_INVALID' USING ERRCODE='42501'; END IF;
 SELECT jsonb_agg(jsonb_build_object('item_id',x.partner_order_item_id,'quantity',x.quantity,
   'commercial_unit',x.commercial_unit,'taxable_quantity',x.taxable_quantity,'taxable_unit',x.taxable_unit) ORDER BY x.partner_order_item_id),
 jsonb_agg(jsonb_build_object('item_id',x.partner_order_item_id,'quantity',x.quantity,
   'commercial_unit',x.commercial_unit,'taxable_quantity',x.taxable_quantity,'taxable_unit',x.taxable_unit,'net_value',x.net_value) ORDER BY x.partner_order_item_id)
 INTO items,snapshot_items FROM (
   SELECT i.partner_order_item_id,sum(i.quantity) quantity,i.commercial_unit,sum(i.taxable_quantity) taxable_quantity,i.taxable_unit,sum(i.net_value) net_value
   FROM public.fiscal_invoice_items i WHERE i.fiscal_invoice_id=inv.id
    GROUP BY i.partner_order_item_id,i.commercial_unit,i.taxable_unit
 ) x;
 IF items IS NULL OR jsonb_array_length(items)=0 OR EXISTS(
   SELECT 1 FROM public.fiscal_invoice_items i LEFT JOIN public.partner_order_items oi ON oi.id=i.partner_order_item_id AND oi.order_id=po.id
   WHERE i.fiscal_invoice_id=inv.id AND (i.partner_order_item_id IS NULL OR oi.id IS NULL OR i.quantity IS NULL OR i.quantity<=0
    OR i.taxable_quantity IS NULL OR i.taxable_quantity<=0 OR i.commercial_unit IS NULL OR i.taxable_unit IS NULL OR i.net_value IS NULL OR i.net_value<0)
 ) OR (SELECT sum(i.net_value) FROM public.fiscal_invoice_items i WHERE i.fiscal_invoice_id=inv.id) IS DISTINCT FROM inv.total_amount
 THEN RAISE EXCEPTION 'B2B_FISCAL_ITEMS_UNPROVEN' USING ERRCODE='23514'; END IF;
 canonical_snapshot:=jsonb_build_object(
  'invoice_id',inv.id,'invoice_type',inv.invoice_type,'access_key',inv.access_key,'authorized_at',inv.authorized_at,
  'environment',inv.environment,'organization_id',inv.organization_id,'company_settings_id',inv.company_settings_id,
  'partner_order_id',inv.partner_order_id,'debtor_partner_id',inv.debtor_partner_id,'debtor_customer_id',inv.debtor_customer_id,
  'issue_date',inv.issue_date,'total_amount',inv.total_amount,'provider_reference',inv.provider_reference,
  'provider_status_raw',inv.provider_status_raw,'tax_authority_notes',inv.tax_authority_notes,
  'transmission_id',tx.id,'protocol',tx.n_prot,'transmission_c_stat',coalesce(tx.protocol_c_stat,tx.c_stat),
  'transmission_outcome',tx.outcome,'transmission_environment',tx.ambiente_retorno,'items',snapshot_items);
 -- O ID identifica a evidência original, mas não a identidade fiscal do evento.
 -- Nova confirmação da mesma chave/protocolo não altera digest nem referência.
 digest_snapshot:=canonical_snapshot-'transmission_id';
 digest:=encode(extensions.digest(convert_to(digest_snapshot::text,'UTF8'),'sha256'),'hex');
 SELECT * INTO existing FROM platform_private.b2b_authorized_documents WHERE id=inv.id;
 -- Uma confirmação divergente é negada pelo H12 no próprio callback; ela não
 -- contamina nem substitui a referência original usada por replays diretos.
 IF existing.id IS NOT NULL AND (saved.invoice_id IS NULL OR saved.source_digest IS DISTINCT FROM digest OR saved.snapshot IS DISTINCT FROM canonical_snapshot
   OR (existing.organization_id,existing.partner_id,existing.order_id,existing.kind,existing.issue_date,existing.event_key,existing.source_digest,existing.items,existing.state)
   IS DISTINCT FROM (org,po.partner_id,po.id,inv.invoice_type,inv.issue_date,'fiscal_invoice:'||inv.id::text,digest,items,'AUTHORIZED'))
 THEN RAISE EXCEPTION 'FISCAL_REPLAY_DIVERGENCE' USING ERRCODE='PT409'; END IF;
 IF existing.id IS NULL THEN
  INSERT INTO platform_private.b2b_fiscal_invoice_snapshots(invoice_id,transmission_id,protocol,source_digest,snapshot)
  VALUES(inv.id,tx.id,tx.n_prot,digest,canonical_snapshot);
  INSERT INTO platform_private.b2b_authorized_documents(id,organization_id,partner_id,order_id,kind,issue_date,event_key,source_digest,items,state)
  VALUES(inv.id,org,po.partner_id,po.id,inv.invoice_type,inv.issue_date,'fiscal_invoice:'||inv.id::text,digest,items,'AUTHORIZED');
 END IF;
 INSERT INTO platform_private.b2b_fiscal_service_permits(transaction_id,invoice_id,document_id,organization_id,order_id,partner_id)
 VALUES(txid_current(),inv.id,inv.id,org,po.id,po.partner_id);
 result:=platform_private.b2b_allocate_document(inv.id);
 UPDATE public.fiscal_invoices SET receivable_id=(result->>'receivable_id')::uuid,updated_at=now() WHERE id=inv.id;
 INSERT INTO public.fiscal_audit_log(table_name,record_id,action,old_values,new_values,changed_by)
 VALUES('fiscal_invoices',inv.id,'B2B_RECEIVABLE_RECONCILED',jsonb_build_object('receivable_id',inv.receivable_id),
   jsonb_build_object('receivable_id',result->>'receivable_id','document_id',inv.id,'replayed',result->>'replayed','source_digest',digest),NULL);
 DELETE FROM platform_private.b2b_fiscal_service_permits WHERE transaction_id=txid_current() AND invoice_id=inv.id;
 RETURN result||jsonb_build_object('invoice_id',inv.id,'skipped',false,'source_digest',digest);
END $$;
REVOKE ALL ON FUNCTION platform_private.b2b_fiscal_snapshot_immutable(),platform_private.b2b_fiscal_created_by_guard(),platform_private.b2b_fiscal_invoice_bridge_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION platform_private.b2b_fiscal_invoice_bridge_v1(uuid) TO service_role;
REVOKE ALL ON FUNCTION public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid),public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb) FROM PUBLIC,anon,authenticated;
GRANT EXECUTE ON FUNCTION public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid),public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb) TO service_role;

CREATE OR REPLACE FUNCTION platform_private.b2b_integration_actor(p_partner uuid, p_internal boolean DEFAULT false) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE u uuid:=auth.uid(); org uuid:=public.h15_actor_organization(); owner_org uuid;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'B2B_READ_COMMITTED_REQUIRED' USING ERRCODE='0A000'; END IF;
 IF u IS NULL AND org IS NULL AND p_internal THEN
  SELECT p.organization_id INTO owner_org FROM platform_private.b2b_fiscal_service_permits p
  WHERE p.transaction_id=txid_current() AND p.partner_id=p_partner;
  IF owner_org IS NOT NULL AND EXISTS(SELECT 1 FROM public.partner_accounts pa
    WHERE pa.id=p_partner AND pa.commercial_owner_organization_id=owner_org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL) THEN
   RETURN owner_org;
  END IF;
 END IF;
 IF u IS NULL OR org IS NULL THEN RAISE EXCEPTION 'B2B_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.c2_order_actor_scope(u,p_partner);
 SELECT commercial_owner_organization_id INTO owner_org FROM public.partner_accounts WHERE id=p_partner AND ativo IS TRUE AND deleted_at IS NULL;
 IF owner_org IS DISTINCT FROM org THEN RAISE EXCEPTION 'B2B_TENANT_DENIED' USING ERRCODE='42501'; END IF;
 IF p_internal AND (public.is_financial_staff(u) IS NOT TRUE
  OR public.has_role(u,'parceiro_b2b'::public.app_role) OR public.has_role(u,'parceiro_b2b_tecnico'::public.app_role)
  OR public.has_role(u,'cliente_produtor'::public.app_role)) THEN RAISE EXCEPTION 'B2B_INTERNAL_ONLY' USING ERRCODE='42501'; END IF;
 RETURN org;
END $$;;
CREATE OR REPLACE FUNCTION platform_private.b2b_title_insert_fence() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE p platform_private.b2b_title_permits;
BEGIN
 IF TG_OP='UPDATE' THEN
  IF (OLD.origin_type IN ('B2B_ORDER','DELIVERY') OR NEW.origin_type IN ('B2B_ORDER','DELIVERY') OR OLD.b2b_document_id IS NOT NULL OR NEW.b2b_document_id IS NOT NULL)
  AND (OLD.organization_id,OLD.origin_type,OLD.origin_id,OLD.partner_id,OLD.customer_id,OLD.b2b_document_id) IS DISTINCT FROM (NEW.organization_id,NEW.origin_type,NEW.origin_id,NEW.partner_id,NEW.customer_id,NEW.b2b_document_id)
  THEN RAISE EXCEPTION 'B2B_TITLE_IDENTITY_IMMUTABLE' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 IF NEW.origin_type='B2B_ORDER' OR (NEW.origin_type='DELIVERY' AND EXISTS(SELECT 1 FROM public.entregas e WHERE e.id=NEW.origin_id AND e.partner_order_id IS NOT NULL)) THEN
  SELECT * INTO p FROM platform_private.b2b_title_permits WHERE transaction_id=txid_current() AND title_id=NEW.id;
  IF NOT FOUND OR p.actor_id IS DISTINCT FROM auth.uid()
  OR (auth.uid() IS NULL AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_fiscal_service_permits sp
    WHERE sp.transaction_id=txid_current() AND sp.document_id=NEW.b2b_document_id AND sp.organization_id=NEW.organization_id AND sp.partner_id=NEW.partner_id))
  OR (auth.uid() IS NOT NULL AND p.organization_id IS DISTINCT FROM public.h15_actor_organization())
  OR NEW.organization_id IS DISTINCT FROM p.organization_id OR NEW.origin_type<>'B2B_ORDER' OR NEW.origin_id IS DISTINCT FROM p.order_id
  OR NEW.partner_id IS DISTINCT FROM p.partner_id OR NEW.customer_id IS DISTINCT FROM p.customer_id
  OR NOT EXISTS(SELECT 1 FROM platform_private.b2b_authorized_documents d WHERE d.id=NEW.b2b_document_id AND d.order_id=p.order_id AND d.organization_id=p.organization_id AND d.partner_id=p.partner_id AND d.state='AUTHORIZED')
  OR NEW.total_amount IS DISTINCT FROM (SELECT sum((r->>'amount')::numeric) FROM jsonb_array_elements(p.rows) r)
  THEN RAISE EXCEPTION 'B2B_FISCAL_ONE_SHOT_PERMIT_REQUIRED' USING ERRCODE='42501'; END IF;
  PERFORM platform_private.b2b_integration_actor(p.partner_id,true);
 END IF;
 RETURN NEW;
END $$;;
CREATE OR REPLACE FUNCTION public.rpc_fiscal_invoice_apply_authorization_v1(_invoice_id uuid, _access_key text, _protocol text, _dh_recbto timestamp with time zone, _c_stat text, _x_motivo text, _transmission_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE v_inv public.fiscal_invoices%ROWTYPE; v_xml uuid; v_bridge jsonb; v_tx public.fiscal_sefaz_transmissions%ROWTYPE; v_saved platform_private.b2b_fiscal_invoice_snapshots%ROWTYPE;
BEGIN
  IF nullif(btrim(coalesce(_protocol,'')),'') IS NULL
     OR coalesce(_access_key,'') !~ '^[0-9]{44}$'
     OR _c_stat NOT IN ('100','150') OR _transmission_id IS NULL OR _dh_recbto IS NULL THEN
    RAISE EXCEPTION 'FISCAL_AUTHORIZATION_PAYLOAD_INVALID';
  END IF;

  SELECT * INTO v_inv FROM public.fiscal_invoices WHERE id = _invoice_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_INVOICE_NOT_FOUND'; END IF;
  IF coalesce(v_inv.environment,'HOMOLOGATION') = 'PRODUCTION' THEN
    RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
  END IF;

  SELECT * INTO v_tx FROM public.fiscal_sefaz_transmissions
   WHERE id=_transmission_id AND fiscal_invoice_id=_invoice_id FOR UPDATE;
  IF NOT FOUND OR v_tx.state IS DISTINCT FROM 'SUCCEEDED'
    OR v_tx.outcome IS DISTINCT FROM 'AUTHORIZED' OR coalesce(v_tx.protocol_c_stat,v_tx.c_stat) IS DISTINCT FROM _c_stat
    OR v_tx.ch_nfe IS DISTINCT FROM _access_key OR v_tx.n_prot IS DISTINCT FROM _protocol
    OR v_tx.ambiente_retorno IS DISTINCT FROM '2' THEN
    RAISE EXCEPTION 'FISCAL_AUTHORIZATION_TRANSMISSION_MISMATCH';
  END IF;

  -- Evidencia assinada e retorno protocolado sao obrigatorios tambem no replay.
  SELECT r.id INTO v_xml
    FROM public.fiscal_xml_runs r
   WHERE r.fiscal_invoice_id = _invoice_id
     AND r.signed_path IS NOT NULL
     AND (r.access_key IS NULL OR r.access_key = _access_key)
   ORDER BY coalesce(r.signed_at, r.updated_at) DESC LIMIT 1;
  IF v_xml IS NULL THEN RAISE EXCEPTION 'FISCAL_SIGNED_XML_REQUIRED'; END IF;

  -- Idempotente: documento ja autorizado nunca e reescrito, mas a ponte revalida o snapshot.
  IF v_inv.normalized_status = 'AUTHORIZED' THEN
    IF coalesce(v_inv.access_key,'') <> _access_key THEN
      RAISE EXCEPTION 'FISCAL_AUTHORIZATION_CONFLICT: documento ja autorizado com outra chave.';
    END IF;
    SELECT * INTO v_saved FROM platform_private.b2b_fiscal_invoice_snapshots WHERE invoice_id=v_inv.id;
    IF v_saved.invoice_id IS NOT NULL AND (
      v_saved.protocol IS DISTINCT FROM _protocol
      OR v_saved.snapshot->>'access_key' IS DISTINCT FROM _access_key
      OR v_saved.snapshot->>'transmission_c_stat' IS DISTINCT FROM _c_stat
      OR v_saved.snapshot->>'transmission_environment' IS DISTINCT FROM v_tx.ambiente_retorno
    ) THEN RAISE EXCEPTION 'FISCAL_REPLAY_DIVERGENCE' USING ERRCODE='PT409'; END IF;
    v_bridge := platform_private.b2b_fiscal_invoice_bridge_v1(v_inv.id);
    RETURN jsonb_build_object('invoiceId', v_inv.id, 'applied', false,
      'normalizedStatus', v_inv.normalized_status,
      'reconciliationStatus', v_inv.reconciliation_status,
      'receivableId', v_bridge->>'receivable_id', 'b2bReplay', v_bridge->>'replayed',
      'b2bSkipped', v_bridge->>'skipped', 'b2bReason', v_bridge->>'reason');
  END IF;

  UPDATE public.fiscal_invoices
     SET status = 'ISSUED',
         normalized_status = 'AUTHORIZED',
         access_key = _access_key,
         authorized_at = coalesce(_dh_recbto, now()),
         provider_status_raw = coalesce(_c_stat, provider_status_raw),
         tax_authority_notes = coalesce(_x_motivo, tax_authority_notes),
         -- xml_document_id NAO e sobrescrito aqui: o nfeProc protocolado ainda
         -- nao e gerado/armazenado pelo transporte (gate documentado).
         reconciliation_status = 'PENDING',
         updated_at = now()
   WHERE id = _invoice_id;

  INSERT INTO public.fiscal_audit_log (table_name, record_id, action, old_values, new_values, changed_by)
  VALUES ('fiscal_invoices', _invoice_id, 'UPDATE',
          jsonb_build_object('normalizedStatus', v_inv.normalized_status, 'status', v_inv.status),
          jsonb_build_object('normalizedStatus','AUTHORIZED','status','ISSUED',
                             'accessKey', _access_key, 'protocol', _protocol,
                             'transmissionId', _transmission_id,
                             'signedXmlRunId', v_xml,
                             'protocoledXmlStored', false), NULL);

  v_bridge := platform_private.b2b_fiscal_invoice_bridge_v1(_invoice_id);
  RETURN jsonb_build_object('invoiceId', _invoice_id, 'applied', true,
    'receivableId', v_bridge->>'receivable_id', 'b2bReplay', v_bridge->>'replayed',
    'b2bSkipped', v_bridge->>'skipped', 'b2bReason', v_bridge->>'reason',
    'normalizedStatus','AUTHORIZED',
    'reconciliationStatus','PENDING',
    'signedXmlRunId', v_xml,
    'protocoledXmlStored', false);
END $function$
;
CREATE OR REPLACE FUNCTION public.rpc_fiscal_sefaz_transmit_record_v1(_transmission_id uuid, _state text, _patch jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_row     public.fiscal_sefaz_transmissions;
  v_cur     public.fiscal_sefaz_transmissions;
  v_cstat   text;
  v_prot    text;
  v_outcome text;
  v_close_error text := NULL;
BEGIN
  IF _state NOT IN ('SENT','SUCCEEDED','FAILED','BLOCKED') THEN
    RAISE EXCEPTION 'FISCAL_TRANSMISSION_STATE_INVALID';
  END IF;

  SELECT * INTO v_cur FROM public.fiscal_sefaz_transmissions WHERE id = _transmission_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_TRANSMISSION_NOT_FOUND'; END IF;

  v_cstat := coalesce(_patch->>'protocolCStat', _patch->>'cStat', v_cur.protocol_c_stat, v_cur.c_stat);
  v_prot  := coalesce(_patch->>'nProt', v_cur.n_prot);

  IF _state IN ('FAILED','BLOCKED') THEN
    v_outcome := 'TRANSPORT_ERROR';
  ELSIF _state = 'SENT' THEN
    v_outcome := 'PENDING';
  ELSIF v_cstat IN ('100','150') AND v_prot IS NOT NULL THEN
    v_outcome := 'AUTHORIZED';
  ELSIF v_cstat IN ('135','136','155') THEN
    v_outcome := 'EVENT_REGISTERED';
  ELSIF v_cstat IN ('103','105','104','106','107','108','109','111','128') THEN
    v_outcome := CASE WHEN v_cur.service = 'NFeStatusServico4'
                      THEN 'SERVICE_INFO' ELSE 'PROCESSING' END;
  ELSE
    v_outcome := 'REJECTED';
  END IF;

  IF v_cur.outcome = 'AUTHORIZED' AND v_outcome IS DISTINCT FROM 'AUTHORIZED' THEN
    RETURN jsonb_build_object(
      'transmissionId',v_cur.id,'state',v_cur.state,'outcome',v_cur.outcome,
      'cStat',v_cur.c_stat,'protocolCStat',coalesce(v_cur.protocol_c_stat,v_cur.c_stat),
      'xMotivo',v_cur.x_motivo,'chNFe',v_cur.ch_nfe,'nProt',v_cur.n_prot,'nRec',v_cur.n_rec,
      'reconciliationPending',v_cur.error_code='FISCAL_AUTHORIZATION_CLOSE_PENDING',
      'reconciliationCode',CASE WHEN v_cur.error_code='FISCAL_AUTHORIZATION_CLOSE_PENDING' THEN v_cur.error_code ELSE NULL END);
  END IF;
  IF v_cur.outcome = 'AUTHORIZED' AND (
    v_cur.ch_nfe IS DISTINCT FROM coalesce(_patch->>'chNFe',v_cur.ch_nfe)
    OR v_cur.n_prot IS DISTINCT FROM v_prot
    OR coalesce(v_cur.protocol_c_stat,v_cur.c_stat) IS DISTINCT FROM v_cstat
  ) THEN RAISE EXCEPTION 'FISCAL_AUTHORIZATION_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;

  UPDATE public.fiscal_sefaz_transmissions SET
    state            = _state,
    outcome          = v_outcome,
    c_stat           = coalesce(_patch->>'cStat', c_stat),
    protocol_c_stat  = CASE WHEN _patch ? 'protocolCStat' THEN _patch->>'protocolCStat'
                            WHEN _patch->>'cStat' IN ('100','150') THEN _patch->>'cStat'
                            ELSE protocol_c_stat END,
    x_motivo         = coalesce(_patch->>'xMotivo', x_motivo),
    ch_nfe           = coalesce(_patch->>'chNFe', ch_nfe),
    n_prot           = coalesce(_patch->>'nProt', n_prot),
    n_rec            = coalesce(_patch->>'nRec', n_rec),
    ambiente_retorno = coalesce(_patch->>'tpAmb', ambiente_retorno),
    dh_recbto        = coalesce((_patch->>'dhRecbto')::timestamptz, dh_recbto),
    error_code       = coalesce(_patch->>'errorCode', error_code),
    response_summary = coalesce(_patch->'responseSummary', response_summary),
    completed_at     = CASE WHEN _state IN ('SUCCEEDED','FAILED','BLOCKED')
                            THEN now() ELSE completed_at END
  WHERE id = _transmission_id
  RETURNING * INTO v_row;

  IF v_row.ambiente_retorno IS NOT NULL AND v_row.ambiente_retorno <> '2' THEN
    RAISE EXCEPTION 'FISCAL_PRODUCTION_ENDPOINT_BLOCKED';
  END IF;

  IF v_row.service = 'NFeRecepcaoEvento4' AND v_row.fiscal_event_id IS NOT NULL
     AND _state = 'SUCCEEDED' AND v_cstat IS NOT NULL THEN
    BEGIN
      PERFORM public.rpc_fiscal_event_sefaz_reconcile_v1(
        v_row.fiscal_event_id, v_row.id, v_cstat,
        coalesce(_patch->>'xMotivo', ''), v_row.n_prot, v_row.dh_recbto);
    EXCEPTION WHEN OTHERS THEN
      v_close_error := 'FISCAL_EVENT_RECONCILIATION_PENDING';
    END;
  END IF;

  -- H13: o fechamento documental nao pode descartar o retorno ja recebido.
  IF v_row.outcome = 'AUTHORIZED' AND v_row.fiscal_invoice_id IS NOT NULL
     AND v_row.ch_nfe IS NOT NULL AND v_row.n_prot IS NOT NULL THEN
    BEGIN
      PERFORM public.rpc_fiscal_invoice_apply_authorization_v1(
        v_row.fiscal_invoice_id, v_row.ch_nfe, v_row.n_prot, v_row.dh_recbto,
        coalesce(v_row.protocol_c_stat,v_row.c_stat), v_row.x_motivo, v_row.id);
    EXCEPTION WHEN OTHERS THEN
      v_close_error := 'FISCAL_AUTHORIZATION_CLOSE_PENDING';
    END;
  END IF;

  IF v_close_error IS NOT NULL THEN
    UPDATE public.fiscal_sefaz_transmissions
       SET error_code = v_close_error
     WHERE id = _transmission_id
    RETURNING * INTO v_row;
  ELSIF v_row.outcome = 'AUTHORIZED' AND v_row.error_code = 'FISCAL_AUTHORIZATION_CLOSE_PENDING' THEN
    UPDATE public.fiscal_sefaz_transmissions
       SET error_code = NULL
     WHERE id = _transmission_id
    RETURNING * INTO v_row;
  END IF;

  RETURN jsonb_build_object(
    'transmissionId', v_row.id, 'state', v_row.state, 'outcome', v_row.outcome,
    'cStat', v_row.c_stat, 'protocolCStat', coalesce(v_row.protocol_c_stat,v_row.c_stat), 'xMotivo', v_row.x_motivo,
    'chNFe', v_row.ch_nfe, 'nProt', v_row.n_prot, 'nRec', v_row.n_rec,
    'reconciliationPending', v_close_error IS NOT NULL,
    'reconciliationCode', v_close_error);
END $function$
;
-- READONLY POST da ponte; não certifica provedor/JWT/RLS hosted.
DO $$ BEGIN
 IF current_setting('b2b_fiscal_bridge.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_FISCAL_REF_NOT_VERIFIED'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_integration_actor(uuid,boolean)'::regprocedure)) IS DISTINCT FROM 'd75b9aff1d4c01c08869dfc24033f7af' THEN RAISE EXCEPTION 'B2B_FISCAL_ACTOR_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_title_insert_fence()'::regprocedure)) IS DISTINCT FROM '1c52d40031b79294adb6fa7f72bcdc61' THEN RAISE EXCEPTION 'B2B_FISCAL_FENCE_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid)'::regprocedure)) IS DISTINCT FROM '766fb81a3c7dafa71de7806e559f0730' THEN RAISE EXCEPTION 'B2B_FISCAL_AUTH_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb)'::regprocedure)) IS DISTINCT FROM '5d6f6ed522cb7b10f1bf9510c2eb2dd6' THEN RAISE EXCEPTION 'B2B_FISCAL_H13_POST_DRIFT'; END IF;
 IF has_function_privilege('authenticated','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') OR has_function_privilege('anon','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') OR NOT has_function_privilege('service_role','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') THEN RAISE EXCEPTION 'B2B_FISCAL_BRIDGE_ACL_INVALID'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='accounts_receivable' AND column_name='created_by' AND is_nullable='YES') THEN RAISE EXCEPTION 'B2B_FISCAL_CREATED_BY_POST_DRIFT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='b2b_fiscal_created_by_guard' AND tgrelid='public.accounts_receivable'::regclass AND tgenabled='O') THEN RAISE EXCEPTION 'B2B_FISCAL_CREATED_BY_GUARD_MISSING'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_class WHERE oid='platform_private.b2b_fiscal_invoice_snapshots'::regclass AND relrowsecurity) THEN RAISE EXCEPTION 'B2B_FISCAL_SNAPSHOT_RLS_MISSING'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='fiscal_sefaz_transmissions' AND column_name='protocol_c_stat' AND is_nullable='YES') THEN RAISE EXCEPTION 'B2B_FISCAL_PROTOCOL_CSTAT_POST_DRIFT'; END IF;
END $$;

COMMIT;
-- READONLY POST final; não certifica JWT/RLS/Storage/provedor.
SET commercial_plans.review_project_ref='swzpzcwiasxmjutrmvkm';
SET b2b_fiscal_bridge.review_project_ref='swzpzcwiasxmjutrmvkm';
-- READONLY POST: estrutura e corpos candidatos; não certifica JWT/RLS hosted.
DO $$
BEGIN
  IF current_setting('commercial_plans.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_REF_NOT_VERIFIED'; END IF;
  IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans' AND column_name='organization_id') THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_TENANT_COLUMN_MISSING'; END IF;
  IF (SELECT indexdef FROM pg_indexes WHERE schemaname='public' AND tablename='commercial_payment_plans' AND indexname='uq_cpp_single_default') IS DISTINCT FROM 'CREATE UNIQUE INDEX uq_cpp_single_default ON public.commercial_payment_plans USING btree (organization_id) NULLS NOT DISTINCT WHERE is_default' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_TENANT_DEFAULT_INDEX_MISSING'; END IF;
  IF (SELECT indexdef FROM pg_indexes WHERE schemaname='public' AND tablename='commercial_payment_plans' AND indexname='uq_cpp_tenant_code') IS DISTINCT FROM 'CREATE UNIQUE INDEX uq_cpp_tenant_code ON public.commercial_payment_plans USING btree (organization_id, code) WHERE (organization_id IS NOT NULL)' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_TENANT_CODE_INDEX_MISSING'; END IF;
  IF EXISTS(SELECT 1 FROM pg_constraint c WHERE c.conrelid='public.commercial_payment_plans'::regclass AND c.conname='commercial_payment_plans_code_key') THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_GLOBAL_CODE_CONSTRAINT_REMAINS'; END IF;
  IF EXISTS(SELECT 1 FROM public.commercial_payment_plans p LEFT JOIN public.organizations o ON o.id=p.organization_id WHERE p.organization_id IS NOT NULL AND o.id IS NULL) THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_ORPHAN_TENANT'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'::regprocedure)) IS DISTINCT FROM 'f0d3ff51f5a4164da41db1a6ef262c8f' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_config_list()'::regprocedure)) IS DISTINCT FROM '728b3b92bc4848873f6df85779585295' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_config_list()'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'::regprocedure)) IS DISTINCT FROM 'c6fbe15906c5d893ab80e962ee162b3c' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_retire(uuid,text,integer)'::regprocedure)) IS DISTINCT FROM 'a049478a9e2b74f315d6c5baf204efa1' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_retire(uuid,text,integer)'; END IF;
  IF md5(pg_get_functiondef('public.convert_partner_simulation_to_order_secure(uuid,text,uuid,date,integer,boolean)'::regprocedure)) IS DISTINCT FROM 'cb179ec0c999b6a566b9431a11ad0212' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.convert_partner_simulation_to_order_secure(uuid,text,uuid,date,integer,boolean)'; END IF;
  IF md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) IS DISTINCT FROM 'fe82f5381d426136f2627803f3b0005d' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'; END IF;
  IF md5(pg_get_functiondef('platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'::regprocedure)) IS DISTINCT FROM 'abbffddb1a3062fd7dabbf14c5af8822' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_assignment_fence()'::regprocedure)) IS DISTINCT FROM 'fe958e7d52fb36faa77881933a808434' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_assignment_fence()'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_history_allowed(text,uuid,jsonb,jsonb)'::regprocedure)) IS DISTINCT FROM '775c1540b15842d3ce0696e4a5d27f3b' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_history_allowed(text,uuid,jsonb,jsonb)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_item_allowed(uuid,uuid,text,uuid,uuid)'::regprocedure)) IS DISTINCT FROM '8212432313c52b2a12a1398ec40c814e' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_item_allowed(uuid,uuid,text,uuid,uuid)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_item_fence()'::regprocedure)) IS DISTINCT FROM 'c1c88697a57168ba49c30692e7a85046' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_item_fence()'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_rule_fence()'::regprocedure)) IS DISTINCT FROM '4337496c5ece403ad072adcaee88faf2' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_rule_fence()'; END IF;
  IF md5(pg_get_functiondef('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)'::regprocedure)) IS DISTINCT FROM '4926a99c3fa3086b34ff25bb4b4038bb' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_create_commercial_plan(jsonb)'::regprocedure)) IS DISTINCT FROM '6136f97079a2b445c949b047aac62108' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_create_commercial_plan(jsonb)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_list_commercial_plans(text,text,integer,integer)'::regprocedure)) IS DISTINCT FROM 'c6672029349b7a312066341defb625ab' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_list_commercial_plans(text,text,integer,integer)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_reorder_commercial_plans(jsonb)'::regprocedure)) IS DISTINCT FROM '0c6825b70cdc5650855784e4b39585d7' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_reorder_commercial_plans(jsonb)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_set_commercial_plan_active(uuid,boolean,text)'::regprocedure)) IS DISTINCT FROM 'bf83cf4a8a35861b723bdcb278112697' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_set_commercial_plan_active(uuid,boolean,text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_set_default_commercial_plan(uuid)'::regprocedure)) IS DISTINCT FROM '0bf1ce6d0a62f06d962c5dcb8657f760' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_set_default_commercial_plan(uuid)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_update_commercial_plan_metadata(uuid,text,text,integer)'::regprocedure)) IS DISTINCT FROM '7bbfe461fdcc5da0d9fbaff3793d730d' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_update_commercial_plan_metadata(uuid,text,text,integer)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_version_commercial_plan(uuid,jsonb,text)'::regprocedure)) IS DISTINCT FROM '8e2cf62e686d9f0aa5d181a18f33df65' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_version_commercial_plan(uuid,jsonb,text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_b2b_list_selectable_payment_plans()'::regprocedure)) IS DISTINCT FROM '5bceeda188eee7525172eadeed17f7c0' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_b2b_list_selectable_payment_plans()'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_list_assignments(text)'::regprocedure)) IS DISTINCT FROM '72af313fcbdd40436e45a36ecf854ac9' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_list_assignments(text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_simulate_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)'::regprocedure)) IS DISTINCT FROM '3aa53f85f13a3a1d9322673c40d262bd' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_simulate_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_validate_matrix(uuid,text,uuid,uuid)'::regprocedure)) IS DISTINCT FROM 'b4f0ff6f4f0856c90faef8654e0c4980' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_validate_matrix(uuid,text,uuid,uuid)'; END IF;
  IF md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) IS DISTINCT FROM '6e81e29397a9bd633f2fe6ec364d8cf3' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'; END IF;
END $$;
SELECT count(*) AS plans,count(organization_id) AS owned,count(*)-count(organization_id) AS denied_unresolved FROM public.commercial_payment_plans;

-- READONLY POST da ponte; não certifica provedor/JWT/RLS hosted.
DO $$ BEGIN
 IF current_setting('b2b_fiscal_bridge.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'B2B_FISCAL_REF_NOT_VERIFIED'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_integration_actor(uuid,boolean)'::regprocedure)) IS DISTINCT FROM 'd75b9aff1d4c01c08869dfc24033f7af' THEN RAISE EXCEPTION 'B2B_FISCAL_ACTOR_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_title_insert_fence()'::regprocedure)) IS DISTINCT FROM '1c52d40031b79294adb6fa7f72bcdc61' THEN RAISE EXCEPTION 'B2B_FISCAL_FENCE_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid)'::regprocedure)) IS DISTINCT FROM '766fb81a3c7dafa71de7806e559f0730' THEN RAISE EXCEPTION 'B2B_FISCAL_AUTH_POST_DRIFT'; END IF;
 IF md5(pg_get_functiondef('public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb)'::regprocedure)) IS DISTINCT FROM '5d6f6ed522cb7b10f1bf9510c2eb2dd6' THEN RAISE EXCEPTION 'B2B_FISCAL_H13_POST_DRIFT'; END IF;
 IF has_function_privilege('authenticated','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') OR has_function_privilege('anon','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') OR NOT has_function_privilege('service_role','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE') THEN RAISE EXCEPTION 'B2B_FISCAL_BRIDGE_ACL_INVALID'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='accounts_receivable' AND column_name='created_by' AND is_nullable='YES') THEN RAISE EXCEPTION 'B2B_FISCAL_CREATED_BY_POST_DRIFT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='b2b_fiscal_created_by_guard' AND tgrelid='public.accounts_receivable'::regclass AND tgenabled='O') THEN RAISE EXCEPTION 'B2B_FISCAL_CREATED_BY_GUARD_MISSING'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_class WHERE oid='platform_private.b2b_fiscal_invoice_snapshots'::regclass AND relrowsecurity) THEN RAISE EXCEPTION 'B2B_FISCAL_SNAPSHOT_RLS_MISSING'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='fiscal_sefaz_transmissions' AND column_name='protocol_c_stat' AND is_nullable='YES') THEN RAISE EXCEPTION 'B2B_FISCAL_PROTOCOL_CSTAT_POST_DRIFT'; END IF;
END $$;

DO $guard$ BEGIN
 IF md5(pg_get_functiondef('platform_private.b2b_integration_dependencies()'::regprocedure)) IS DISTINCT FROM '605e722506de23bfd69c890c4123d4b6'
 THEN RAISE EXCEPTION 'COMPOSED_ALWAYS_DENY_DRIFT' USING ERRCODE='42501'; END IF;
 IF has_function_privilege('authenticated','platform_private.b2b_allocate_document(uuid)','EXECUTE')
   OR has_function_privilege('service_role','platform_private.b2b_allocate_document(uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'COMPOSED_ALLOCATOR_GRANT_OPEN' USING ERRCODE='42501'; END IF;
END $guard$;
SELECT 'COMPOSED_POST_OK' AS status;
