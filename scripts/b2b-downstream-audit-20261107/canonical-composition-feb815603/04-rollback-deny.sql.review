-- DENY-ONLY conjunto reverso: ponte, B4 e planos; preserva dados/histórico.
-- DENY-ONLY: fecha ponte e callbacks; preserva NF, títulos, snapshots e histórico.
BEGIN;
REVOKE ALL ON FUNCTION platform_private.b2b_fiscal_invoice_bridge_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION public.rpc_fiscal_invoice_apply_authorization_v1(uuid,text,text,timestamptz,text,text,uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION public.rpc_fiscal_sefaz_transmit_record_v1(uuid,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;
COMMIT;

BEGIN;
REVOKE EXECUTE ON FUNCTION public.generate_b2b_receivable_secure(uuid) FROM PUBLIC,anon,authenticated;
REVOKE EXECUTE ON FUNCTION public.rpc_receivable_money_projection_v1(uuid,integer,integer) FROM PUBLIC,anon,authenticated;
COMMIT;
-- DENY-ONLY: não restaura funções, unicidade global de código nem índice global vulneráveis; preserva dados, versões e cercas.
BEGIN;
REVOKE ALL ON FUNCTION public.rpc_admin_list_commercial_plans(text,text,integer,integer) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_create_commercial_plan(jsonb) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_version_commercial_plan(uuid,jsonb,text) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_update_commercial_plan_metadata(uuid,text,text,integer) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_set_commercial_plan_active(uuid,boolean,text) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_set_default_commercial_plan(uuid) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_admin_reorder_commercial_plans(jsonb) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_b2b_list_selectable_payment_plans() FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_cc_list_assignments(text) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_cc_validate_matrix(uuid,text,uuid,uuid) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.rpc_cc_simulate_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_condition_config_list() FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_condition_retire(uuid,text,integer) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.b2b_list_payment_condition_options_secure(uuid,uuid) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.convert_partner_simulation_to_order_secure(uuid,text,uuid,date,integer,boolean) FROM PUBLIC,anon,authenticated;
REVOKE ALL ON FUNCTION public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text) FROM PUBLIC,anon,authenticated;
ALTER POLICY cpp_tenant_read ON public.commercial_payment_plans USING(false);
ALTER POLICY cppa_admin_read ON public.commercial_payment_plan_assignments USING(false);
ALTER POLICY ccip_admin_read ON public.commercial_condition_item_prices USING(false);
ALTER POLICY cpr_internal_select ON public.commercial_price_rules USING(false);
COMMIT;
DO $guard$ BEGIN
 IF has_function_privilege('authenticated','public.rpc_admin_list_commercial_plans(text,text,integer,integer)','EXECUTE')
   OR has_function_privilege('service_role','platform_private.b2b_fiscal_invoice_bridge_v1(uuid)','EXECUTE')
   OR has_function_privilege('authenticated','public.generate_b2b_receivable_secure(uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'COMPOSED_ROLLBACK_STILL_OPEN' USING ERRCODE='42501'; END IF;
END $guard$;
SELECT 'COMPOSED_ROLLBACK_OK' AS status;
