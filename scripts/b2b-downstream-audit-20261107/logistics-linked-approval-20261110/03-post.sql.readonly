BEGIN READ ONLY;
DO $$DECLARE p oid:=to_regprocedure('platform_private.b2b_resale_os_valid_v1(public.ordens_servico)');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '30d5e9dea53862e3c3ca0608e95deac4' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p)<>'postgres'
 THEN RAISE EXCEPTION 'LINKED_APPROVAL_CONSUMER_DRIFT %','platform_private.b2b_resale_os_valid_v1(public.ordens_servico)';END IF;END$$;
