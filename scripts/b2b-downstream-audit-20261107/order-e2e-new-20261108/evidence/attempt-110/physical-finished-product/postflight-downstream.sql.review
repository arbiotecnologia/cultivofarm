DO $$DECLARE p oid:=to_regprocedure('platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '9820bb30d293dfea68d41391ae1aaf24' THEN RAISE EXCEPTION 'FINISHED_PRE_FUNCTION_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
 IF (SELECT r.rolname FROM pg_proc x JOIN pg_roles r ON r.oid=x.proowner WHERE x.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'FINISHED_PRE_OWNER_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
 IF (SELECT coalesce(x.proacl::text,'') FROM pg_proc x WHERE x.oid=p) IS DISTINCT FROM '{postgres=X/postgres}' THEN RAISE EXCEPTION 'FINISHED_PRE_ACL_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
END$$;
DO $$DECLARE p oid:=to_regprocedure('platform_private.delivery_send_apply_v1(uuid,timestamptz,text)');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM 'c592075fe3719b69b7768b541bfad533' THEN RAISE EXCEPTION 'FINISHED_PRE_FUNCTION_DRIFT platform_private.delivery_send_apply_v1(uuid,timestamptz,text)';END IF;
 IF (SELECT r.rolname FROM pg_proc x JOIN pg_roles r ON r.oid=x.proowner WHERE x.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'FINISHED_PRE_OWNER_DRIFT platform_private.delivery_send_apply_v1(uuid,timestamptz,text)';END IF;
 IF (SELECT coalesce(x.proacl::text,'') FROM pg_proc x WHERE x.oid=p) IS DISTINCT FROM '{postgres=X/postgres}' THEN RAISE EXCEPTION 'FINISHED_PRE_ACL_DRIFT platform_private.delivery_send_apply_v1(uuid,timestamptz,text)';END IF;
END$$;
DO $$BEGIN IF EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE enabled IS TRUE) THEN RAISE EXCEPTION 'FINISHED_POST_GATE_OPEN';END IF;END$$;
