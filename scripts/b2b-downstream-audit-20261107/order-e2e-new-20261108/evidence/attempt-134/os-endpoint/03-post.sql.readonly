BEGIN READ ONLY;
DO $$BEGIN
 IF md5(pg_get_functiondef('public.rpc_b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)'::regprocedure)) IS DISTINCT FROM 'ff875e2afcf52dcf3f64b48135536f81'
 OR md5(pg_get_functiondef('public.rpc_b2b_resale_os_availability_v1(uuid)'::regprocedure)) IS DISTINCT FROM 'de78e9ca6c11963669beb80d519e7c81'
 OR NOT has_function_privilege('authenticated','public.rpc_b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)','EXECUTE')
 OR NOT has_function_privilege('authenticated','public.rpc_b2b_resale_os_availability_v1(uuid)','EXECUTE')
 OR has_function_privilege('anon','public.rpc_b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)','EXECUTE') OR has_function_privilege('service_role','public.rpc_b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)','EXECUTE')
 OR has_function_privilege('anon','public.rpc_b2b_resale_os_availability_v1(uuid)','EXECUTE') OR has_function_privilege('service_role','public.rpc_b2b_resale_os_availability_v1(uuid)','EXECUTE')
 OR has_function_privilege('authenticated','platform_private.b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)','EXECUTE') OR has_function_privilege('service_role','platform_private.b2b_resale_os_create_v1(uuid,uuid,timestamptz,text)','EXECUTE')
 THEN RAISE EXCEPTION 'RESALE_ENDPOINT_POST_DRIFT'; END IF; END$$;
ROLLBACK;
