SELECT jsonb_build_object(
 'private_columns',(SELECT jsonb_agg(jsonb_build_array(a.attrelid::regclass::text,a.attname,format_type(a.atttypid,a.atttypmod),a.attnotnull,a.attacl::text,pg_get_expr(d.adbin,d.adrelid)) ORDER BY a.attrelid::regclass::text COLLATE "C",a.attname COLLATE "C") FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attnum>0 AND NOT a.attisdropped AND a.attrelid IN (SELECT oid FROM pg_class WHERE (relnamespace='platform_private'::regnamespace AND relname IN ('envase_insert_permits_v1','delivery_confirm_permits_v1')) OR (relnamespace='cf_user_guards_v1'::regnamespace AND relname='state'))),
 'private_constraints',(SELECT jsonb_agg(jsonb_build_array(conrelid::regclass::text,conname,pg_get_constraintdef(oid),convalidated) ORDER BY conrelid::regclass::text COLLATE "C",conname COLLATE "C") FROM pg_constraint WHERE conrelid IN (SELECT oid FROM pg_class WHERE (relnamespace='platform_private'::regnamespace AND relname IN ('envase_insert_permits_v1','delivery_confirm_permits_v1')) OR (relnamespace='cf_user_guards_v1'::regnamespace AND relname='state'))),
 'functions',(SELECT jsonb_agg(jsonb_build_array(n.nspname,p.proname,pg_get_function_identity_arguments(p.oid),md5(pg_get_functiondef(p.oid)),p.proacl::text,pg_get_userbyid(p.proowner),p.proconfig,p.prosecdef) ORDER BY n.nspname COLLATE "C",p.proname COLLATE "C",pg_get_function_identity_arguments(p.oid) COLLATE "C") FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.prokind='f' AND n.nspname IN ('public','platform_private','cf_user_guards_v1')),
 'relations',(SELECT jsonb_agg(jsonb_build_array(c.oid::regclass::text,c.relacl::text,c.relrowsecurity,c.relforcerowsecurity,pg_get_userbyid(c.relowner)) ORDER BY c.oid::regclass::text COLLATE "C") FROM pg_class c WHERE (c.relnamespace='public'::regnamespace AND c.relname IN ('envase','estoque_produto','estoque_movimentacoes','lotes','controle_qualidade','ordens_servico','programacao_producao','entregas','produto_etiquetas','entrega_etiquetas','cockpit_operacao_idempotencia','laboratorio_esteira_eventos','organizations','organization_subscriptions','saas_plan_versions','saas_plan_version_features','saas_features','saas_modules','organization_feature_overrides','clientes','profiles','user_roles','platform_org_admin_invites','entrega_comprovantes','entrega_documentos','entrega_checklist','entrega_termos','entrega_conferencia_itens','production_order_link')) OR (c.relnamespace='platform_private'::regnamespace AND c.relname IN ('envase_insert_permits_v1','delivery_confirm_permits_v1'))),
 'columns',(SELECT jsonb_agg(jsonb_build_array(a.attrelid::regclass::text,a.attname,format_type(a.atttypid,a.atttypmod),a.attnotnull,a.attacl::text) ORDER BY a.attrelid::regclass::text COLLATE "C",a.attname COLLATE "C") FROM pg_attribute a WHERE a.attnum>0 AND NOT a.attisdropped AND a.attrelid IN (SELECT oid FROM pg_class WHERE relnamespace='public'::regnamespace AND relname IN ('envase','estoque_produto','estoque_movimentacoes','lotes','controle_qualidade','ordens_servico','programacao_producao','entregas','produto_etiquetas','entrega_etiquetas','cockpit_operacao_idempotencia','laboratorio_esteira_eventos','organizations','organization_subscriptions','saas_plan_versions','saas_plan_version_features','saas_features','saas_modules','organization_feature_overrides','clientes','profiles','user_roles','platform_org_admin_invites','entrega_comprovantes','entrega_documentos','entrega_checklist','entrega_termos','entrega_conferencia_itens','production_order_link'))),
 'constraints',(SELECT jsonb_agg(jsonb_build_array(conrelid::regclass::text,conname,pg_get_constraintdef(oid),convalidated) ORDER BY conrelid::regclass::text COLLATE "C",conname COLLATE "C") FROM pg_constraint WHERE conrelid IN (SELECT oid FROM pg_class WHERE relnamespace='public'::regnamespace AND relname IN ('envase','estoque_produto','estoque_movimentacoes','lotes','controle_qualidade','ordens_servico','programacao_producao','entregas','produto_etiquetas','entrega_etiquetas','cockpit_operacao_idempotencia','laboratorio_esteira_eventos','organizations','organization_subscriptions','saas_plan_versions','saas_plan_version_features','saas_features','saas_modules','organization_feature_overrides','clientes','profiles','user_roles','platform_org_admin_invites','entrega_comprovantes','entrega_documentos','entrega_checklist','entrega_termos','entrega_conferencia_itens','production_order_link'))),
 'policies',(SELECT jsonb_agg(jsonb_build_array(tablename,policyname,permissive,roles::text,cmd,qual,with_check) ORDER BY tablename COLLATE "C",policyname COLLATE "C") FROM pg_policies WHERE schemaname='public' AND tablename IN ('envase','estoque_produto','estoque_movimentacoes','lotes','controle_qualidade','ordens_servico','programacao_producao','entregas','produto_etiquetas','entrega_etiquetas','cockpit_operacao_idempotencia','laboratorio_esteira_eventos','organizations','organization_subscriptions','saas_plan_versions','saas_plan_version_features','saas_features','saas_modules','organization_feature_overrides','clientes','profiles','user_roles','platform_org_admin_invites','entrega_comprovantes','entrega_documentos','entrega_checklist','entrega_termos','entrega_conferencia_itens','production_order_link')),
 'triggers',(SELECT jsonb_agg(jsonb_build_array(tgrelid::regclass::text,tgname,tgenabled,pg_get_triggerdef(oid)) ORDER BY tgrelid::regclass::text COLLATE "C",tgname COLLATE "C",tgenabled::text COLLATE "C") FROM pg_trigger WHERE NOT tgisinternal AND tgrelid IN (SELECT oid FROM pg_class WHERE relnamespace='public'::regnamespace AND relname IN ('envase','estoque_produto','estoque_movimentacoes','lotes','controle_qualidade','ordens_servico','programacao_producao','entregas','produto_etiquetas','entrega_etiquetas','cockpit_operacao_idempotencia','laboratorio_esteira_eventos','organizations','organization_subscriptions','saas_plan_versions','saas_plan_version_features','saas_features','saas_modules','organization_feature_overrides','clientes','profiles','user_roles','platform_org_admin_invites','entrega_comprovantes','entrega_documentos','entrega_checklist','entrega_termos','entrega_conferencia_itens','production_order_link'))), 'storage_objects_schema',(SELECT jsonb_agg(jsonb_build_array(attname,format_type(atttypid,atttypmod),attnotnull) ORDER BY attname COLLATE "C") FROM pg_attribute WHERE attrelid='storage.objects'::regclass AND attnum>0 AND NOT attisdropped));
