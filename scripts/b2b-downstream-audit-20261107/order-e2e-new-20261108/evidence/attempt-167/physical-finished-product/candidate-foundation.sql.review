
CREATE TABLE platform_private.finished_product_gate_v1(singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false);
INSERT INTO platform_private.finished_product_gate_v1(singleton,enabled) VALUES(true,false);
REVOKE ALL ON platform_private.finished_product_gate_v1 FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.finished_product_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.estoque_produto ADD COLUMN origem_estoque text,ADD COLUMN unidade_comercial text,ADD COLUMN conteudo_por_unidade numeric,ADD COLUMN unidade_conteudo text,ADD COLUMN quantidade_conteudo numeric,ADD COLUMN embalagem_id uuid,ADD COLUMN embalagem_versao integer;
ALTER TABLE public.entregas ADD COLUMN origem_estoque text,ADD COLUMN unidade_comercial text,ADD COLUMN conteudo_por_unidade numeric,ADD COLUMN unidade_conteudo text,ADD COLUMN quantidade_conteudo numeric,ADD COLUMN embalagem_id uuid,ADD COLUMN embalagem_versao integer;
ALTER TABLE public.estoque_produto ADD CONSTRAINT finished_product_unit_contract CHECK (
 (origem_estoque IS NULL AND unidade_comercial IS NULL AND conteudo_por_unidade IS NULL AND unidade_conteudo IS NULL AND quantidade_conteudo IS NULL AND embalagem_id IS NULL AND embalagem_versao IS NULL)
 OR ((origem_estoque='compra_produto_acabado_revenda' AND envase_id IS NULL
  AND unidade_comercial IS NOT NULL AND unidade_comercial='unidade'
  AND conteudo_por_unidade IS NOT NULL AND conteudo_por_unidade>0 AND conteudo_por_unidade::text NOT IN ('NaN','Infinity','-Infinity')
  AND unidade_conteudo IS NOT NULL AND unidade_conteudo IN ('kg','g','l','ml')
  AND quantidade IS NOT NULL AND quantidade=trunc(quantidade)
  AND (quantidade_reservada IS NULL OR quantidade_reservada=trunc(quantidade_reservada))
  AND quantidade_conteudo IS NOT NULL AND quantidade_conteudo=quantidade*conteudo_por_unidade
  AND embalagem_id IS NOT NULL AND embalagem_versao IS NOT NULL AND embalagem_versao>0
  AND ((unidade_conteudo IN ('kg','g') AND volume_total IS NULL)
    OR (unidade_conteudo='l' AND volume_total IS NOT NULL AND volume_total=quantidade_conteudo)
    OR (unidade_conteudo='ml' AND volume_total IS NOT NULL AND volume_total=quantidade_conteudo/1000))) IS TRUE)
);
-- A referência de embalagem é snapshot imutável; a composição B3 é dependência de revisão, não simulada por FK no catálogo líquido antigo.
CREATE FUNCTION platform_private.finished_product_stock_valid_v1(s public.estoque_produto) RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 SELECT (s.origem_estoque='compra_produto_acabado_revenda'
  AND s.unidade_comercial IS NOT NULL AND s.unidade_comercial='unidade'
  AND s.conteudo_por_unidade IS NOT NULL AND s.conteudo_por_unidade>0
  AND s.unidade_conteudo IS NOT NULL AND s.unidade_conteudo IN ('kg','g','l','ml')
  AND s.quantidade IS NOT NULL AND s.quantidade>0 AND s.quantidade=trunc(s.quantidade)
  AND s.quantidade_conteudo IS NOT NULL AND s.quantidade_conteudo=s.quantidade*s.conteudo_por_unidade
  AND s.embalagem_id IS NOT NULL AND s.embalagem_versao IS NOT NULL AND s.embalagem_versao>0 AND s.envase_id IS NULL
  AND EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled IS TRUE)
  AND EXISTS(SELECT 1 FROM public.lotes l WHERE l.id=s.lote_id AND l.produto_id=s.produto_id)
  AND ((s.unidade_conteudo IN ('kg','g') AND s.volume_total IS NULL)
    OR (s.unidade_conteudo='l' AND s.volume_total IS NOT NULL AND s.volume_total=s.quantidade_conteudo)
    OR (s.unidade_conteudo='ml' AND s.volume_total IS NOT NULL AND s.volume_total=s.quantidade_conteudo/1000))) IS TRUE;
$$;
REVOKE ALL ON FUNCTION platform_private.finished_product_stock_valid_v1(public.estoque_produto) FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.finished_product_delivery_valid_v1(s public.estoque_produto,e public.entregas,l public.lotes) RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 SELECT (platform_private.finished_product_stock_valid_v1(s) IS TRUE AND l.id IS NOT NULL AND l.programacao_id IS NULL
  AND e.origem_estoque=s.origem_estoque AND e.unidade_comercial IS NOT NULL AND e.unidade_comercial=s.unidade_comercial
  AND e.conteudo_por_unidade IS NOT NULL AND e.conteudo_por_unidade=s.conteudo_por_unidade
  AND e.unidade_conteudo IS NOT NULL AND e.unidade_conteudo=s.unidade_conteudo
  AND e.quantidade_conteudo IS NOT NULL AND e.quantidade_conteudo=s.quantidade_conteudo
  AND e.embalagem_id=s.embalagem_id AND e.embalagem_versao IS NOT NULL AND e.embalagem_versao=s.embalagem_versao
  AND e.quantidade_entregue=s.quantidade
  AND ((s.unidade_conteudo IN ('kg','g') AND e.volume_entregue_ml IS NULL)
    OR (s.unidade_conteudo='l' AND e.volume_entregue_ml IS NOT NULL AND e.volume_entregue_ml=round(s.quantidade_conteudo*1000,6))
    OR (s.unidade_conteudo='ml' AND e.volume_entregue_ml IS NOT NULL AND e.volume_entregue_ml=round(s.quantidade_conteudo,6)))) IS TRUE;
$$;
REVOKE ALL ON FUNCTION platform_private.finished_product_delivery_valid_v1(public.estoque_produto,public.entregas,public.lotes) FROM PUBLIC,anon,authenticated,service_role;



CREATE FUNCTION platform_private.finished_product_purchase_entry_v1(
 p_produto_id uuid,p_embalagem_id uuid,p_lote_fornecedor text,p_quantidade numeric,
 p_compra_referencia text,p_fornecedor_nome text,p_idempotency_key text,p_validade date DEFAULT NULL
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $purchase$
DECLARE
 v_uid uuid:=auth.uid(); v_org uuid; v_fp text;
 v_prev public.estoque_movimentacoes%ROWTYPE; v_mov public.estoque_movimentacoes%ROWTYPE;
 v_product public.produtos%ROWTYPE; v_sale public.product_sale_units%ROWTYPE;
 v_pack public.product_packagings%ROWTYPE; v_volume public.catalogo_volumes%ROWTYPE;
 v_lote uuid:=gen_random_uuid(); v_stock uuid:=gen_random_uuid();
 v_unit text; v_content numeric; v_version integer; v_total numeric; v_volume_total numeric; v_ctx jsonb;
BEGIN
 IF NOT EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_GATE_CLOSED' USING ERRCODE='42501';
 END IF;
 v_org:=platform_private.stock_motor_actor('entrada');
 IF p_produto_id IS NULL OR p_embalagem_id IS NULL OR nullif(btrim(coalesce(p_lote_fornecedor,'')),'') IS NULL
  OR nullif(btrim(coalesce(p_compra_referencia,'')),'') IS NULL OR nullif(btrim(coalesce(p_fornecedor_nome,'')),'') IS NULL THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_PURCHASE_PARAMS_INVALID' USING ERRCODE='22023';
 END IF;
 IF p_quantidade IS NULL OR p_quantidade<=0 OR p_quantidade::text IN ('NaN','Infinity','-Infinity') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_QUANTITY_INVALID' USING ERRCODE='23514';
 END IF;
 IF p_quantidade<>trunc(p_quantidade) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_WHOLE_PACK_REQUIRED' USING ERRCODE='23514';
 END IF;
 IF p_idempotency_key IS NULL OR length(btrim(p_idempotency_key))<8 THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_IDEMPOTENCY_REQUIRED' USING ERRCODE='23514';
 END IF;
 v_fp:=encode(extensions.digest(jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','product',p_produto_id,'packaging',p_embalagem_id,'supplier_lot',btrim(p_lote_fornecedor),'quantity',p_quantidade,'purchase',btrim(p_compra_referencia),'supplier',btrim(p_fornecedor_nome),'validity',p_validade)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtext('finished_product_purchase:'||p_idempotency_key));
 v_org:=platform_private.stock_motor_actor('entrada');
 IF NOT EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_GATE_CLOSED' USING ERRCODE='42501';
 END IF;
 SELECT * INTO v_prev FROM public.estoque_movimentacoes WHERE idempotency_key=p_idempotency_key LIMIT 1;
  IF FOUND THEN
  IF v_prev.usuario_id IS DISTINCT FROM v_uid OR v_prev.request_fingerprint IS DISTINCT FROM v_fp
   OR v_prev.acao IS DISTINCT FROM 'entrada' OR v_prev.origem IS DISTINCT FROM 'finished_product_purchase_entry_v1'
   OR v_prev.metadata->>'produto_id' IS DISTINCT FROM p_produto_id::text
   OR v_prev.metadata->>'embalagem_id' IS DISTINCT FROM p_embalagem_id::text
   OR v_prev.metadata->>'unidade_conteudo' IS NULL OR v_prev.metadata->>'conteudo_por_unidade' IS NULL
   OR v_prev.metadata->>'quantidade_conteudo' IS NULL OR v_prev.metadata->>'embalagem_versao' IS NULL
   OR NOT EXISTS(SELECT 1 FROM public.estoque_produto s JOIN public.lotes l ON l.id=s.lote_id WHERE s.id=v_prev.estoque_produto_id AND l.id=v_prev.lote_id AND l.organization_id=v_org AND s.origem_estoque='compra_produto_acabado_revenda') THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_IDEMPOTENCY_CONFLICT' USING ERRCODE='23505';
  END IF;
  RETURN jsonb_build_object('ok',true,'replay',true,'lote_id',v_prev.lote_id,'estoque_produto_id',v_prev.estoque_produto_id,'movimentacao_id',v_prev.id,
   'origem_estoque','compra_produto_acabado_revenda','unidade_conteudo',v_prev.metadata->>'unidade_conteudo',
   'conteudo_por_unidade',(v_prev.metadata->>'conteudo_por_unidade')::numeric,
   'quantidade_conteudo',(v_prev.metadata->>'quantidade_conteudo')::numeric,
   'embalagem_versao',(v_prev.metadata->>'embalagem_versao')::integer);
 END IF;
 SELECT * INTO v_product FROM public.produtos WHERE id=p_produto_id FOR SHARE;
 IF NOT FOUND OR v_product.owner_organization_id IS DISTINCT FROM v_org OR v_product.ativo IS NOT TRUE
  OR v_product.familia_catalogo NOT IN ('quimico','fertilizante_adubo') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_CATALOG_DENIED' USING ERRCODE='42501';
 END IF;
 SELECT * INTO v_sale FROM public.product_sale_units WHERE product_id=p_produto_id AND owner_organization_id=v_org FOR SHARE;
 IF NOT FOUND OR v_sale.unidade_conteudo NOT IN ('kg','g','l','ml') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_SALE_UNIT_REQUIRED' USING ERRCODE='23514';
 END IF;
 v_unit:=v_sale.unidade_conteudo;
 SELECT * INTO v_volume FROM public.catalogo_volumes WHERE id=p_embalagem_id AND produto_id=p_produto_id AND owner_organization_id=v_org AND ativo IS TRUE FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FINISHED_PRODUCT_PACKAGING_DENIED' USING ERRCODE='42501'; END IF;
 IF v_unit IN ('kg','g') THEN
  SELECT * INTO v_pack FROM public.product_packagings
   WHERE id=p_embalagem_id AND product_id=p_produto_id AND owner_organization_id=v_org AND ativo IS TRUE
    AND valid_from<=now() AND (valid_to IS NULL OR valid_to>=now()) FOR SHARE;
  IF NOT FOUND OR v_volume.medida IS DISTINCT FROM 'embalagem' OR v_pack.peso_liquido_kg<=0 OR v_pack.peso_liquido_kg::text IN ('NaN','Infinity','-Infinity') THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_PACKAGING_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  v_content:=v_pack.peso_liquido_kg*CASE WHEN v_unit='g' THEN 1000 ELSE 1 END;
  v_version:=v_pack.version;
 ELSE
  IF v_volume.medida IS DISTINCT FROM 'volume' OR v_volume.volume_ml IS NULL OR v_volume.volume_ml<=0
   OR v_volume.volume_ml::text IN ('NaN','Infinity','-Infinity') OR EXISTS(SELECT 1 FROM public.product_packagings x WHERE x.id=p_embalagem_id) THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_PRESENTATION_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  v_content:=v_volume.volume_ml/CASE WHEN v_unit='l' THEN 1000 ELSE 1 END;
  v_version:=v_sale.version;
 END IF;
 v_org:=platform_private.stock_motor_actor('entrada');
 v_total:=p_quantidade*v_content;
 v_volume_total:=CASE WHEN v_unit IN ('kg','g') THEN NULL WHEN v_unit='l' THEN v_total ELSE v_total/1000 END;
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(pg_catalog.txid_current(),'finished_product_purchase_entry_v1',v_lote);
 INSERT INTO public.lotes(id,codigo_lote,produto_id,programacao_id,volume_produzido,status,organization_id,observacoes_tecnicas)
 -- Código interno globalmente único vem do UUID servidor; lote externo permanece nos snapshots/ledger.
 VALUES(v_lote,'BUY-'||v_lote::text,p_produto_id,NULL,NULL,'aprovado',v_org,
  jsonb_build_object('origem','compra_produto_acabado_revenda','compra_referencia',btrim(p_compra_referencia),'fornecedor',btrim(p_fornecedor_nome),'lote_fornecedor',btrim(p_lote_fornecedor),'embalagem_id',p_embalagem_id,'embalagem_versao',v_version)::text);
 DELETE FROM platform_private.authz_tickets WHERE txid=pg_catalog.txid_current() AND scope='finished_product_purchase_entry_v1' AND target=v_lote;
 v_ctx:=jsonb_build_object('acao','entrada','origem','finished_product_purchase_entry_v1','usuario_id',v_uid,'unidade','un',
  'idempotency_key',p_idempotency_key,'request_fingerprint',v_fp,'referencia_tipo','lote',
  'metadata',jsonb_build_object('stock_request_item',v_stock,'stock_request_actor',v_uid,'origem_estoque','compra_produto_acabado_revenda',
   'compra_referencia',btrim(p_compra_referencia),'fornecedor',btrim(p_fornecedor_nome),'lote_fornecedor',btrim(p_lote_fornecedor),'produto_id',p_produto_id,
   'embalagem_id',p_embalagem_id,'embalagem_versao',v_version,'unidade_conteudo',v_unit,'conteudo_por_unidade',v_content,'quantidade_conteudo',v_total));
 PERFORM platform_private.stock_motor_context_set(v_ctx);
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(pg_catalog.txid_current(),'finished_product_purchase_entry_v1',v_stock);
 INSERT INTO public.estoque_produto(id,lote_id,produto_id,quantidade,volume_total,validade,quantidade_reservada,status,origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao)
 VALUES(v_stock,v_lote,p_produto_id,p_quantidade,v_volume_total,p_validade,NULL,'disponivel','compra_produto_acabado_revenda','unidade',v_content,v_unit,v_total,p_embalagem_id,v_version);
 DELETE FROM platform_private.authz_tickets WHERE txid=pg_catalog.txid_current() AND scope='finished_product_purchase_entry_v1' AND target=v_stock;
 PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close();
 SELECT * INTO v_mov FROM public.estoque_movimentacoes WHERE idempotency_key=p_idempotency_key AND estoque_produto_id=v_stock;
 IF NOT FOUND OR v_mov.acao IS DISTINCT FROM 'entrada' OR v_mov.usuario_id IS DISTINCT FROM v_uid
  OR v_mov.request_fingerprint IS DISTINCT FROM v_fp OR v_mov.quantidade IS DISTINCT FROM p_quantidade
  OR v_mov.metadata->>'compra_referencia' IS DISTINCT FROM btrim(p_compra_referencia) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_ENTRY_LEDGER_DENIED' USING ERRCODE='42501';
 END IF;
 RETURN jsonb_build_object('ok',true,'replay',false,'lote_id',v_lote,'estoque_produto_id',v_stock,'movimentacao_id',v_mov.id,
  'origem_estoque','compra_produto_acabado_revenda','unidade_conteudo',v_unit,'conteudo_por_unidade',v_content,'quantidade_conteudo',v_total,'embalagem_versao',v_version);
EXCEPTION WHEN OTHERS THEN
 PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close(); RAISE;
END;$purchase$;
REVOKE ALL ON FUNCTION platform_private.finished_product_purchase_entry_v1(uuid,uuid,text,numeric,text,text,text,date) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION public.rpc_finished_product_purchase_capability_v1()
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; v_available boolean:=false;
BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'FINISHED_PRODUCT_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 BEGIN
  v_org:=platform_private.stock_motor_actor('entrada');
 EXCEPTION WHEN insufficient_privilege THEN
  RETURN jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','available',false,'reason','ACTOR_DENIED');
 END;
 v_available:=EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled IS TRUE);
 RETURN jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','available',v_available);
END $$;
REVOKE ALL ON FUNCTION public.rpc_finished_product_purchase_capability_v1() FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_finished_product_purchase_capability_v1() TO authenticated;

CREATE FUNCTION public.rpc_finished_product_purchase_entry_v1(
 p_produto_id uuid,p_embalagem_id uuid,p_lote_fornecedor text,p_quantidade numeric,
 p_compra_referencia text,p_fornecedor_nome text,p_idempotency_key text,p_validade date DEFAULT NULL
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
BEGIN
 RETURN platform_private.finished_product_purchase_entry_v1(p_produto_id,p_embalagem_id,p_lote_fornecedor,p_quantidade,p_compra_referencia,p_fornecedor_nome,p_idempotency_key,p_validade);
END $$;
REVOKE ALL ON FUNCTION public.rpc_finished_product_purchase_entry_v1(uuid,uuid,text,numeric,text,text,text,date) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_finished_product_purchase_entry_v1(uuid,uuid,text,numeric,text,text,text,date) TO authenticated;


CREATE OR REPLACE FUNCTION public.reservar_estoque_item(p_item_id uuid, p_qty numeric, p_os_id uuid, p_os_tipo text, p_cliente_id uuid DEFAULT NULL::uuid, p_partner_id uuid DEFAULT NULL::uuid, p_partner_order_id uuid DEFAULT NULL::uuid, p_observacao text DEFAULT NULL::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_item public.estoque_produto%ROWTYPE;
  v_volume_reservado numeric;
  v_new_id uuid;
  v_parent_ctx jsonb;
BEGIN
  PERFORM platform_private.stock_motor_actor('reserva');
  IF p_qty IS NULL OR p_qty::text IN ('NaN','Infinity','-Infinity') OR p_qty <= 0 THEN
    RAISE EXCEPTION 'ESTQ_QUANTIDADE_INVALIDA: quantidade deve ser finita e maior que zero.' USING ERRCODE='23514';
  END IF;
  PERFORM platform_private.stock_motor_item(p_item_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id,'partner_id',p_partner_id,'partner_order_id',p_partner_order_id));
  IF auth.uid() IS NULL OR NOT public.fn_estoque_pode_operar(auth.uid(), 'reserva') THEN
    RAISE EXCEPTION 'ESTQ_SEM_PERMISSAO: perfil sem permissão para reservar estoque'
      USING ERRCODE = '42501';
  END IF;

  SELECT c.ctx INTO v_parent_ctx FROM platform_private.stock_motor_context c WHERE c.txid=txid_current() AND c.actor=auth.uid() AND c.item=p_item_id;
  IF v_parent_ctx IS NOT NULL AND (v_parent_ctx->>'acao' IS DISTINCT FROM 'reserva' OR v_parent_ctx->'reserve_args' IS DISTINCT FROM jsonb_strip_nulls(jsonb_build_object('os_id',p_os_id::text,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id::text,'partner_id',p_partner_id::text,'partner_order_id',p_partner_order_id::text,'observacao',p_observacao))) THEN RAISE EXCEPTION 'ESTQ_PAYLOAD_INVALIDO' USING ERRCODE='22023'; END IF;
  IF v_parent_ctx IS NULL THEN
   v_parent_ctx:=jsonb_build_object('acao','reserva','origem','reservar_estoque_item','usuario_id',auth.uid()::text,'metadata',jsonb_build_object('stock_request_item',p_item_id::text,'stock_request_actor',auth.uid()::text));
  END IF;
  PERFORM public.fn_estoque_ctx_force(v_parent_ctx);
  IF p_qty IS NULL OR p_qty <= 0 THEN
    RAISE EXCEPTION 'Quantidade a reservar deve ser maior que zero.'
      USING ERRCODE = 'check_violation';
  END IF;
  IF p_os_id IS NULL THEN
    RAISE EXCEPTION 'Reserva requer uma OS vinculada.'
      USING ERRCODE = 'check_violation';
  END IF;

  SELECT * INTO v_item
  FROM public.estoque_produto
  WHERE id = p_item_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Item de estoque % não encontrado.', p_item_id
      USING ERRCODE = 'no_data_found';
  END IF;

  PERFORM platform_private.stock_motor_item(p_item_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id,'partner_id',p_partner_id,'partner_order_id',p_partner_order_id));
  IF v_item.status::text <> 'disponivel' THEN
    RAISE EXCEPTION 'Item % não está disponível para reserva (status: %).', p_item_id, v_item.status
      USING ERRCODE = 'check_violation';
  END IF;

  IF p_qty > COALESCE(v_item.quantidade, 0) THEN
    RAISE EXCEPTION 'Quantidade solicitada (%) excede o disponível (%) para esta embalagem.',
      p_qty, COALESCE(v_item.quantidade, 0)
      USING ERRCODE = 'check_violation';
  END IF;

  IF v_item.origem_estoque IS NOT NULL AND platform_private.finished_product_stock_valid_v1(v_item) IS NOT TRUE THEN
    RAISE EXCEPTION 'FINISHED_PRODUCT_STOCK_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  IF v_item.unidade_comercial='unidade' AND p_qty<>trunc(p_qty) THEN
    RAISE EXCEPTION 'FINISHED_PRODUCT_WHOLE_PACK_REQUIRED' USING ERRCODE='23514';
  END IF;

  v_volume_reservado := CASE
    WHEN COALESCE(v_item.volume_total, 0) > 0 AND COALESCE(v_item.quantidade, 0) > 0
      THEN (p_qty * v_item.volume_total) / v_item.quantidade
    ELSE NULL
  END;

  IF p_qty = v_item.quantidade THEN
    UPDATE public.estoque_produto SET
      status = 'reservado',
      reservado_para_os_id = p_os_id,
      reservado_para_os_tipo = p_os_tipo,
      reservado_para_cliente_id = CASE WHEN p_os_tipo = 'b2b' THEN NULL ELSE p_cliente_id END,
      reservado_para_partner_id = CASE WHEN p_os_tipo = 'b2b' THEN p_partner_id ELSE NULL END,
      reservado_para_partner_order_id = CASE WHEN p_os_tipo = 'b2b' THEN p_partner_order_id ELSE NULL END,
      quantidade_reservada = p_qty,
      observacao_reserva = p_observacao
    WHERE id = p_item_id;
    v_new_id := p_item_id;
  ELSE
    INSERT INTO public.estoque_produto (
      produto_id, lote_id, microrganismo_id, envase_id,
      quantidade, volume_total, validade, status,
      reservado_para_os_id, reservado_para_os_tipo,
      reservado_para_cliente_id, reservado_para_partner_id, reservado_para_partner_order_id,
      quantidade_reservada, observacao_reserva,
      origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao
    ) VALUES (
      v_item.produto_id, v_item.lote_id, v_item.microrganismo_id, v_item.envase_id,
      p_qty, v_volume_reservado, v_item.validade, 'reservado',
      p_os_id, p_os_tipo,
      CASE WHEN p_os_tipo = 'b2b' THEN NULL ELSE p_cliente_id END,
      CASE WHEN p_os_tipo = 'b2b' THEN p_partner_id ELSE NULL END,
      CASE WHEN p_os_tipo = 'b2b' THEN p_partner_order_id ELSE NULL END,
      p_qty, p_observacao,
      v_item.origem_estoque,v_item.unidade_comercial,v_item.conteudo_por_unidade,v_item.unidade_conteudo,p_qty*v_item.conteudo_por_unidade,v_item.embalagem_id,v_item.embalagem_versao
    ) RETURNING id INTO v_new_id;

    UPDATE public.estoque_produto SET
      quantidade = v_item.quantidade - p_qty,
      quantidade_conteudo = CASE WHEN v_item.conteudo_por_unidade IS NOT NULL THEN (v_item.quantidade-p_qty)*v_item.conteudo_por_unidade ELSE NULL END,
      volume_total = CASE
        WHEN COALESCE(v_item.volume_total, 0) > 0 THEN v_item.volume_total - v_volume_reservado
        ELSE volume_total
      END
    WHERE id = p_item_id;
  END IF;

  PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close();
  RETURN v_new_id;
EXCEPTION WHEN OTHERS THEN PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close(); RAISE;
END;
$function$;

CREATE OR REPLACE FUNCTION public.rpc_cockpit_criar_entrega_v1(p_os_id uuid, p_origem text, p_estoque_produto_id uuid, p_quantidade numeric, p_dados jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_origem text;
  v_est public.estoque_produto%ROWTYPE;
  v_existente record;
  v_id uuid;
  v_cliente_os uuid;
BEGIN
  v_origem := public.fn_cockpit_assert_operador_origem(p_origem);

  IF p_os_id IS NULL OR p_estoque_produto_id IS NULL THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_PARAMS_INVALIDOS';
  END IF;
  IF coalesce(p_quantidade, 0) <= 0 THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_QUANTIDADE_INVALIDA';
  END IF;

  PERFORM pg_advisory_xact_lock(hashtext('cockpit_criar_entrega:' || p_os_id::text || ':' || p_estoque_produto_id::text));

  SELECT * INTO v_est
  FROM public.estoque_produto
  WHERE id = p_estoque_produto_id
  FOR UPDATE;

  IF v_est.id IS NULL THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_ESTOQUE_NAO_ENCONTRADO';
  END IF;

  IF v_origem = 'onfarm' THEN
    SELECT cliente_id INTO v_cliente_os
    FROM public.ordens_servico_onfarm
    WHERE id = p_os_id;
  ELSE
    SELECT cliente_id INTO v_cliente_os
    FROM public.ordens_servico
    WHERE id = p_os_id;
  END IF;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_OS_NAO_ENCONTRADA';
  END IF;

  IF v_est.status::text NOT IN ('reservado', 'expedido') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_STATUS_ESTOQUE_INVALIDO';
  END IF;
  IF v_est.reservado_para_os_id IS DISTINCT FROM p_os_id THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_ESTOQUE';
  END IF;
  IF coalesce(v_est.reservado_para_os_tipo, v_origem) IS DISTINCT FROM v_origem THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_ORIGEM';
  END IF;
  IF p_quantidade > coalesce(v_est.quantidade, 0) THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_QUANTIDADE_EXCEDE_RESERVA';
  END IF;
  IF v_est.reservado_para_cliente_id IS NOT NULL
     AND v_est.reservado_para_cliente_id IS DISTINCT FROM v_cliente_os THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_CLIENTE';
  END IF;
  IF nullif(p_dados->>'cliente_id','') IS NOT NULL
     AND nullif(p_dados->>'cliente_id','')::uuid IS DISTINCT FROM v_cliente_os THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_CLIENTE';
  END IF;

  SELECT e.id, e.status::text AS status INTO v_existente
  FROM public.entregas e
  WHERE e.estoque_produto_id = p_estoque_produto_id
    AND e.status::text <> 'cancelada'
    AND (
      (v_origem = 'onfarm' AND e.ordem_servico_onfarm_id = p_os_id)
      OR (v_origem <> 'onfarm' AND e.ordem_servico_id = p_os_id)
    )
  ORDER BY e.created_at DESC
  LIMIT 1;

  IF v_existente.id IS NOT NULL THEN
    RETURN jsonb_build_object('success', true, 'replay', true, 'entrega_id', v_existente.id, 'status', v_existente.status, 'message', 'Entrega ja registrada para este item da OS.');
  END IF;


  IF coalesce(nullif(p_dados->>'tipo_entrega',''), 'motorista') NOT IN ('motorista','retirada') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_MODALIDADE_INVALIDA';
  END IF;
  IF coalesce(nullif(p_dados->>'endereco_origem',''), 'cadastro') NOT IN ('cadastro','personalizado') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_ENDERECO_ORIGEM_INVALIDA';
  END IF;
  IF v_est.quantidade IS NULL OR v_est.quantidade <= 0 THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_VOLUME_ESTOQUE_INVALIDO';
  END IF;
  IF v_est.origem_estoque IS NOT NULL THEN
    IF platform_private.finished_product_stock_valid_v1(v_est) IS NOT TRUE THEN
      RAISE EXCEPTION 'FINISHED_PRODUCT_STOCK_CONTRACT_DENIED' USING ERRCODE='23514';
    END IF;
  ELSIF v_est.volume_total IS NULL OR v_est.volume_total <= 0 OR v_est.volume_total::text IN ('NaN','Infinity','-Infinity') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_VOLUME_ESTOQUE_INVALIDO';
  END IF;

  INSERT INTO public.entregas (
    ordem_servico_id, ordem_servico_onfarm_id, estoque_produto_id,
    lote_id, produto_id, quantidade_entregue, status, cliente_id,
    data_saida, motorista, veiculo,
    origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao
  ) VALUES (
    CASE WHEN v_origem = 'onfarm' THEN NULL ELSE p_os_id END,
    CASE WHEN v_origem = 'onfarm' THEN p_os_id ELSE NULL END,
    p_estoque_produto_id,
    v_est.lote_id,
    v_est.produto_id,
    p_quantidade,
    'separado'::public.status_entrega,
    v_cliente_os,
    nullif(p_dados->>'data_saida','')::date,
    nullif(p_dados->>'motorista',''),
    nullif(p_dados->>'veiculo',''),
    v_est.origem_estoque,v_est.unidade_comercial,v_est.conteudo_por_unidade,v_est.unidade_conteudo,CASE WHEN v_est.origem_estoque='compra_produto_acabado_revenda' THEN p_quantidade*v_est.conteudo_por_unidade ELSE NULL END,v_est.embalagem_id,v_est.embalagem_versao
  ) RETURNING id INTO v_id;


  -- Only newly created delivery: preserve replay semantics and never overwrite existing history.
  UPDATE public.entregas SET
    volume_entregue_ml = CASE WHEN v_est.origem_estoque='compra_produto_acabado_revenda' AND v_est.unidade_conteudo IN ('kg','g') THEN NULL ELSE round((v_est.volume_total / v_est.quantidade) * p_quantidade * 1000, 6) END,
    tipo_entrega = coalesce(nullif(p_dados->>'tipo_entrega',''), 'motorista'),
    endereco_origem = coalesce(nullif(p_dados->>'endereco_origem',''), 'cadastro'),
    grupo_entrega_id = nullif(p_dados->>'grupo_entrega_id','')::uuid,
    hora_saida_prevista = nullif(p_dados->>'hora_saida_prevista','')::time,
    data_chegada_prevista = nullif(p_dados->>'data_chegada_prevista','')::date,
    hora_chegada_prevista = nullif(p_dados->>'hora_chegada_prevista','')::time,
    motorista_telefone = nullif(p_dados->>'motorista_telefone',''),
    motorista_documento = nullif(p_dados->>'motorista_documento',''),
    veiculo_placa = nullif(p_dados->>'veiculo_placa',''),
    veiculo_tipo = nullif(p_dados->>'veiculo_tipo',''),
    destinatario_nome = nullif(p_dados->>'destinatario_nome',''),
    destinatario_telefone = nullif(p_dados->>'destinatario_telefone',''),
    destinatario_whatsapp = nullif(p_dados->>'destinatario_whatsapp',''),
    endereco_logradouro = nullif(p_dados->>'endereco_logradouro',''),
    endereco_numero = nullif(p_dados->>'endereco_numero',''),
    endereco_complemento = nullif(p_dados->>'endereco_complemento',''),
    endereco_bairro = nullif(p_dados->>'endereco_bairro',''),
    endereco_cidade = nullif(p_dados->>'endereco_cidade',''),
    endereco_uf = nullif(p_dados->>'endereco_uf',''),
    endereco_cep = nullif(p_dados->>'endereco_cep',''),
    endereco_referencia = nullif(p_dados->>'endereco_referencia','')
  WHERE id = v_id;

  INSERT INTO public.laboratorio_esteira_eventos
    (os_id, origem_os, etapa_nova, acao, usuario_id, observacao)
  VALUES
    (p_os_id, v_origem, 'entrega_criada', 'criar_entrega_v1', v_uid,
     format('Entrega %s criada (motor transacional).', v_id));

  RETURN jsonb_build_object('success', true, 'replay', false, 'entrega_id', v_id, 'status', 'separado', 'message', 'Entrega registrada. Confirme a entrega para concluir a OS.');
END;
$function$;

CREATE OR REPLACE FUNCTION platform_private.delivery_merge_split_20261030(p_item uuid,p_ctx jsonb,p_payload jsonb)
RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; v_s public.estoque_produto%ROWTYPE; v_main public.estoque_produto%ROWTYPE;
 v_ent uuid:=NULLIF(p_payload->>'referencia_id','')::uuid; v_total numeric; v_volume numeric;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('cancel');
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND organization_id=v_org AND action='cancel' AND target=v_ent AND NOT consumed)
 OR NOT EXISTS(SELECT 1 FROM platform_private.stock_motor_context WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND item=p_item AND ctx=p_ctx AND ctx->>'acao'='cancelamento_reserva')
 THEN RAISE EXCEPTION 'DELIVERY_MERGE_CONTEXT_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=p_item FOR UPDATE;
 PERFORM platform_private.stock_motor_item(p_item,'cancelamento_reserva',p_payload);
 IF v_s.status::text<>'reservado' OR v_s.quantidade IS DISTINCT FROM v_s.quantidade_reservada OR v_s.quantidade IS NULL OR v_s.quantidade<=0 OR v_s.quantidade::text IN ('NaN','Infinity','-Infinity') OR (v_s.origem_estoque IS NULL AND (v_s.volume_total IS NULL OR v_s.volume_total<=0 OR v_s.volume_total::text IN ('NaN','Infinity','-Infinity'))) OR (v_s.origem_estoque IS NOT NULL AND platform_private.finished_product_stock_valid_v1(v_s) IS NOT TRUE) OR NOT EXISTS(SELECT 1 FROM public.entregas WHERE id=v_ent AND organization_id=v_org AND estoque_produto_id=p_item AND quantidade_entregue=v_s.quantidade) THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 SELECT * INTO v_main FROM public.estoque_produto WHERE lote_id=v_s.lote_id AND status='disponivel' AND coalesce(quantidade_reservada,0)=0 AND id<>p_item ORDER BY id LIMIT 1 FOR UPDATE;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF v_main.id IS NULL THEN
  UPDATE public.estoque_produto SET status='disponivel' WHERE id=p_item;
  RETURN;
 END IF;
 PERFORM platform_private.stock_motor_item(v_main.id,'cancelamento_reserva','{}'::jsonb);
 IF v_main.envase_id IS DISTINCT FROM v_s.envase_id OR v_main.produto_id IS DISTINCT FROM v_s.produto_id OR v_main.microrganismo_id IS DISTINCT FROM v_s.microrganismo_id OR v_main.validade IS DISTINCT FROM v_s.validade OR v_main.origem_estoque IS DISTINCT FROM v_s.origem_estoque OR v_main.unidade_comercial IS DISTINCT FROM v_s.unidade_comercial OR v_main.conteudo_por_unidade IS DISTINCT FROM v_s.conteudo_por_unidade OR v_main.unidade_conteudo IS DISTINCT FROM v_s.unidade_conteudo OR v_main.embalagem_id IS DISTINCT FROM v_s.embalagem_id OR v_main.embalagem_versao IS DISTINCT FROM v_s.embalagem_versao OR v_main.reservado_para_os_id IS NOT NULL OR v_main.reservado_para_cliente_id IS NOT NULL OR v_main.reservado_para_partner_id IS NOT NULL OR v_main.reservado_para_partner_order_id IS NOT NULL THEN RAISE EXCEPTION 'DELIVERY_MERGE_INCOMPATIBLE' USING ERRCODE='PT409'; END IF;
 IF v_main.quantidade IS NULL OR v_main.quantidade<=0 OR v_main.quantidade::text IN ('NaN','Infinity','-Infinity') OR (v_main.origem_estoque IS NULL AND (v_main.volume_total IS NULL OR v_main.volume_total<=0 OR v_main.volume_total::text IN ('NaN','Infinity','-Infinity'))) THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 v_total:=v_main.quantidade+v_s.quantidade; v_volume:=CASE WHEN v_main.volume_total IS NULL AND v_s.volume_total IS NULL THEN NULL ELSE coalesce(v_main.volume_total,0)+coalesce(v_s.volume_total,0) END;
 IF v_total IS NULL OR v_total<=0 OR v_total::text IN ('NaN','Infinity','-Infinity') OR (v_main.origem_estoque IS NULL AND (v_volume IS NULL OR v_volume<=0 OR v_volume::text IN ('NaN','Infinity','-Infinity'))) THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 -- Keep source row and immutable movement history; retire it BEFORE growing the unique main row.
 UPDATE public.estoque_produto SET status='estornado',quantidade=0,volume_total=CASE WHEN origem_estoque='compra_produto_acabado_revenda' AND unidade_conteudo IN ('kg','g') THEN NULL ELSE 0 END,quantidade_conteudo=CASE WHEN origem_estoque IS NOT NULL THEN 0 ELSE quantidade_conteudo END,quantidade_reservada=0,reservado_para_os_id=NULL,reservado_para_os_tipo=NULL,reservado_para_cliente_id=NULL,reservado_para_partner_id=NULL,reservado_para_partner_order_id=NULL WHERE id=p_item;
 UPDATE public.estoque_produto SET quantidade=v_total,volume_total=v_volume,quantidade_conteudo=CASE WHEN v_main.conteudo_por_unidade IS NOT NULL THEN v_total*v_main.conteudo_por_unidade ELSE NULL END WHERE id=v_main.id;
 IF NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=p_item AND idempotency_key=p_ctx->>'idempotency_key' AND saldo_posterior=0 AND acao='cancelamento_reserva')
 OR NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_main.id AND metadata->>'operacao_key'=p_ctx->>'idempotency_key' AND saldo_anterior=v_main.quantidade AND saldo_posterior=v_total AND volume_posterior=coalesce(v_volume,0) AND acao='cancelamento_reserva')
 THEN RAISE EXCEPTION 'DELIVERY_MERGE_LEDGER_DENIED' USING ERRCODE='PT409'; END IF;
END $$;

CREATE OR REPLACE FUNCTION public.fn_sync_os_classica_downstream()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_prog_id uuid;
  v_lote_id uuid;
BEGIN
  IF (OLD.status IS NOT DISTINCT FROM NEW.status) THEN
    RETURN NEW;
  END IF;

  SELECT id INTO v_prog_id FROM public.programacao_producao
   WHERE ordem_servico_id = NEW.id ORDER BY created_at DESC LIMIT 1;

  IF v_prog_id IS NULL
     AND NEW.status::text IN ('aprovada','programada','em_producao','em_cq','envase','pronto_entrega','entregue','finalizada')
     AND (NEW.produto_id IS NOT NULL OR NEW.microrganismo_id IS NOT NULL)
     AND NOT EXISTS(SELECT 1 FROM public.entregas d JOIN public.estoque_produto s ON s.id=d.estoque_produto_id WHERE d.ordem_servico_id=NEW.id AND d.produto_id=NEW.produto_id AND d.status::text<>'cancelada' AND s.origem_estoque='compra_produto_acabado_revenda') THEN
    INSERT INTO public.programacao_producao
      (produto_id, microrganismo_id, volume_necessario, data_programada, status, ordem_servico_id)
    VALUES
      (NEW.produto_id, NEW.microrganismo_id, NEW.volume_total_ml,
       COALESCE(NEW.data_programada, CURRENT_DATE), 'aguardando', NEW.id)
    RETURNING id INTO v_prog_id;
  END IF;

  IF v_prog_id IS NOT NULL THEN
    SELECT id INTO v_lote_id FROM public.lotes
      WHERE programacao_id = v_prog_id ORDER BY created_at DESC LIMIT 1;
  END IF;

  CASE NEW.status::text
    WHEN 'aprovada' THEN
      IF v_prog_id IS NOT NULL THEN
        UPDATE public.programacao_producao SET status = 'aguardando' WHERE id = v_prog_id;
      END IF;
    WHEN 'programada' THEN
      IF v_prog_id IS NOT NULL THEN
        UPDATE public.programacao_producao
           SET status = 'aguardando',
               data_programada = COALESCE(NEW.data_programada, data_programada, CURRENT_DATE)
         WHERE id = v_prog_id;
      END IF;
    WHEN 'em_producao' THEN
      IF v_prog_id IS NOT NULL THEN
        UPDATE public.programacao_producao SET status = 'em_producao' WHERE id = v_prog_id;
      END IF;
      IF v_lote_id IS NULL AND (NEW.produto_id IS NOT NULL OR NEW.microrganismo_id IS NOT NULL) THEN
        INSERT INTO public.lotes (codigo_lote, produto_id, microrganismo_id, programacao_id, status, volume_produzido, data_producao)
        VALUES (public.gerar_codigo_lote(), NEW.produto_id, NEW.microrganismo_id, v_prog_id,
                'em_producao', NEW.volume_total_ml, CURRENT_DATE);
      END IF;
    WHEN 'em_cq' THEN
      IF v_prog_id IS NOT NULL THEN
        UPDATE public.programacao_producao SET status = 'aguardando_cq' WHERE id = v_prog_id;
      END IF;
      IF v_lote_id IS NOT NULL THEN
        UPDATE public.lotes SET status = 'aguardando_cq' WHERE id = v_lote_id;
      END IF;
    WHEN 'envase' THEN
      IF v_prog_id IS NOT NULL THEN
        UPDATE public.programacao_producao SET status = 'aprovado' WHERE id = v_prog_id;
      END IF;
    ELSE
      NULL;
  END CASE;

  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION platform_private.guard_manual_lot_write_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
 p public.programacao_producao%ROWTYPE;
 old_manual boolean:=false;
 old_programacao uuid;
 org uuid;
BEGIN
 -- Lock old/new parents in deterministic order. An UPDATE cannot escape the
 -- manual fence by changing programacao_id to onfarm or NULL.
 IF TG_OP='UPDATE' THEN old_programacao:=OLD.programacao_id; END IF;
 PERFORM 1 FROM public.programacao_producao
 WHERE id=NEW.programacao_id OR id=old_programacao
 ORDER BY id FOR SHARE;
 IF TG_OP='UPDATE' THEN
  SELECT EXISTS(SELECT 1 FROM public.programacao_producao
    WHERE id=OLD.programacao_id AND ordem_servico_id IS NOT NULL) INTO old_manual;
 END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=NEW.programacao_id;
 IF old_manual OR p.ordem_servico_id IS NOT NULL OR p.id IS NULL THEN
  IF TG_OP='UPDATE' AND old_manual THEN
   org:=platform_private.h15_actor_organization();
   IF auth.uid() IS NOT NULL AND org IS NOT NULL AND public.technical_actor_ready(auth.uid()) IS TRUE
    AND (public.has_role(auth.uid(),'administrador') OR public.has_role(auth.uid(),'gestor') OR public.has_role(auth.uid(),'producao')) IS TRUE
    AND p.id IS NOT NULL AND p.ordem_servico_onfarm_id IS NULL AND p.organization_id=org AND NEW.organization_id=org AND OLD.organization_id=org
    AND (to_jsonb(NEW)-'status'-'updated_at') IS NOT DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    AND EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org AND o.status::text='em_cq'
     AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL AND o.origem IS DISTINCT FROM 'b2b')
    AND ((OLD.status::text='em_producao' AND NEW.status::text='aguardando_cq' AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=NEW.id))
     OR (OLD.status::text='aguardando_cq' AND NEW.status::text IN ('aprovado','reprovado') AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_'||NEW.status::text||'_v1' AND target=NEW.id)
     AND EXISTS(SELECT 1 FROM public.controle_qualidade c WHERE c.lote_id=NEW.id AND c.organization_id=org AND c.resultado::text=NEW.status::text
      AND c.responsavel='DADOS FICTICIOS SEM VALOR COMERCIAL' AND c.ph IS NOT NULL AND c.concentracao IS NOT NULL)))
   THEN RETURN NEW; END IF;
  END IF;

  org:=platform_private.h15_actor_organization();
 -- Compra de produto acabado para revenda: ticket privado, tenant e catálogo atual.
 IF TG_OP='INSERT' AND NEW.programacao_id IS NULL AND NEW.microrganismo_id IS NULL
  AND NEW.produto_id IS NOT NULL AND NEW.volume_produzido IS NULL AND NEW.status::text='aprovado'
  AND org IS NOT NULL AND NEW.organization_id=org AND public.technical_actor_ready(auth.uid()) IS TRUE
  AND public.fn_estoque_pode_operar(auth.uid(),'entrada') IS TRUE
  AND EXISTS(SELECT 1 FROM public.produtos pr WHERE pr.id=NEW.produto_id AND pr.owner_organization_id=org AND pr.ativo IS TRUE AND pr.familia_catalogo IN ('quimico','fertilizante_adubo'))
  AND EXISTS(SELECT 1 FROM platform_private.authz_tickets t WHERE t.txid=pg_catalog.txid_current() AND t.scope='finished_product_purchase_entry_v1' AND t.target=NEW.id)
 THEN RETURN NEW; END IF;

 -- No JWT/GUC/current_user/service-role escape: only the reviewed insert RPC
  -- can issue this private, target-specific ticket; it removes it after INSERT.
  org:=platform_private.h15_actor_organization();
  IF TG_OP<>'INSERT' OR org IS NULL OR auth.uid() IS NULL
   OR public.technical_actor_ready(auth.uid()) IS NOT TRUE
   OR p.id IS NULL OR p.ordem_servico_id IS NULL OR p.ordem_servico_onfarm_id IS NOT NULL
   OR p.organization_id IS DISTINCT FROM org OR NEW.organization_id IS DISTINCT FROM org
   OR p.produto_id IS DISTINCT FROM NEW.produto_id OR p.microrganismo_id IS DISTINCT FROM NEW.microrganismo_id
   OR p.status::text IS DISTINCT FROM 'aguardando' OR NEW.status::text IS DISTINCT FROM 'em_producao'
   OR NOT EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org
     AND o.status::text='programada' AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL
     AND o.origem IS DISTINCT FROM 'b2b')
   OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets
     WHERE txid=pg_catalog.txid_current() AND scope='manual_lot_insert_v1' AND target=NEW.id)
  THEN RAISE EXCEPTION 'MANUAL_LOT_WRITE_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION platform_private.trg_lab_lot_biological_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP='INSERT' AND NEW.programacao_id IS NULL AND NEW.microrganismo_id IS NULL AND NEW.volume_produzido IS NULL
   AND EXISTS(SELECT 1 FROM platform_private.authz_tickets t WHERE t.txid=pg_catalog.txid_current() AND t.scope='finished_product_purchase_entry_v1' AND t.target=NEW.id)
  THEN RETURN NEW; END IF;
  IF TG_OP='UPDATE' AND NEW.produto_id IS NOT DISTINCT FROM OLD.produto_id
                    AND NEW.microrganismo_id IS NOT DISTINCT FROM OLD.microrganismo_id THEN RETURN NEW; END IF;
  PERFORM platform_private.lab_assert_manufacturable(NEW.produto_id,NEW.microrganismo_id);
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION public.validate_estoque_entrada()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  -- Reservas parciais (têm quantidade_reservada preenchida) seguem normalmente
  IF NEW.quantidade_reservada IS NOT NULL THEN
    -- Só uma divisão parcial no contexto canônico pode usar o retorno de reserva.
    IF NEW.origem_estoque='compra_produto_acabado_revenda' AND NOT EXISTS(
      SELECT 1 FROM platform_private.stock_motor_context x
      JOIN public.estoque_produto parent ON parent.id=x.item
      WHERE x.txid=pg_catalog.txid_current() AND x.actor=auth.uid() AND x.ctx->>'acao'='reserva'
        AND parent.id IS DISTINCT FROM NEW.id AND parent.origem_estoque='compra_produto_acabado_revenda'
        AND parent.lote_id=NEW.lote_id AND parent.status::text='disponivel'
        AND NEW.status::text='reservado' AND NEW.quantidade>0 AND NEW.quantidade<parent.quantidade
        AND NEW.quantidade_reservada=NEW.quantidade
    ) THEN
      RAISE EXCEPTION 'FINISHED_PRODUCT_RESERVATION_CONTEXT_DENIED' USING ERRCODE='42501';
    END IF;
    RETURN NEW;
  END IF;

  -- Compra para revenda usa ticket privado e snapshot; demais entradas continuam exigindo envase.
  IF NEW.origem_estoque='compra_produto_acabado_revenda' THEN
    IF platform_private.finished_product_stock_valid_v1(NEW) IS NOT TRUE
     OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets t WHERE t.txid=pg_catalog.txid_current() AND t.scope='finished_product_purchase_entry_v1' AND t.target=NEW.id) THEN
      RAISE EXCEPTION 'FINISHED_PRODUCT_PURCHASE_ENTRY_DENIED' USING ERRCODE='42501';
    END IF;
  ELSIF NOT EXISTS (SELECT 1 FROM public.envase WHERE lote_id = NEW.lote_id) THEN
    RAISE EXCEPTION 'Não é possível criar entrada no estoque: o lote ainda não possui registro de envase.'
      USING ERRCODE = 'check_violation';
  END IF;

  -- Bloquear duplicidade por envase_id (não mais por lote)
  IF NEW.envase_id IS NOT NULL AND EXISTS (
    SELECT 1 FROM public.estoque_produto
    WHERE envase_id = NEW.envase_id
      AND quantidade_reservada IS NULL
      AND id <> COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::uuid)
  ) THEN
    RAISE EXCEPTION 'Já existe entrada de estoque para este envase.'
      USING ERRCODE = 'unique_violation';
  END IF;

  -- Compat: se a entrada vier sem envase_id, manter a regra antiga de 1 por lote
  IF NEW.envase_id IS NULL AND EXISTS (
    SELECT 1 FROM public.estoque_produto
    WHERE lote_id = NEW.lote_id
      AND envase_id IS NULL
      AND quantidade_reservada IS NULL
      AND id <> COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::uuid)
  ) THEN
    RAISE EXCEPTION 'Já existe uma entrada de estoque agregada para este lote.'
      USING ERRCODE = 'unique_violation';
  END IF;

  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION platform_private.envase_insert_guard_v1() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $entry$
DECLARE p platform_private.envase_insert_permits_v1%ROWTYPE; c record; parent public.estoque_produto%ROWTYPE; a jsonb; org uuid;
BEGIN
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed' THEN RAISE EXCEPTION 'ENVASE_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 UPDATE platform_private.envase_insert_permits_v1 SET admitted=true WHERE txid=txid_current() AND actor=auth.uid() AND action=TG_TABLE_NAME AND target=NEW.id AND admitted=false RETURNING * INTO p;
 IF FOUND THEN
  IF p.organization_id IS DISTINCT FROM platform_private.stock_envase_scope_v1(p.lote,p.prog,p.os,'manual')
   OR NEW.lote_id IS DISTINCT FROM p.lote OR (to_jsonb(NEW)-'created_at'-'updated_at'-'origem_estoque'-'unidade_comercial'-'conteudo_por_unidade'-'unidade_conteudo'-'quantidade_conteudo'-'embalagem_id'-'embalagem_versao') IS DISTINCT FROM (p.payload-'origem_estoque'-'unidade_comercial'-'conteudo_por_unidade'-'unidade_conteudo'-'quantidade_conteudo'-'embalagem_id'-'embalagem_versao') THEN RAISE EXCEPTION 'ENVASE_INSERT_PERMIT_MISMATCH' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 -- Compra para revenda: contexto transacional e ticket específicos do writer privado.
 IF TG_TABLE_NAME='estoque_produto' AND NEW.origem_estoque='compra_produto_acabado_revenda'
  AND NEW.quantidade_reservada IS NULL
  AND EXISTS(SELECT 1 FROM platform_private.stock_motor_context x WHERE x.txid=txid_current() AND x.actor=auth.uid() AND x.ctx->>'acao'='entrada') THEN
  SELECT * INTO c FROM platform_private.stock_motor_context WHERE txid=txid_current() AND actor=auth.uid();
  IF FOUND AND c.item=NEW.id AND c.ctx->>'acao'='entrada' AND c.ctx->>'origem'='finished_product_purchase_entry_v1'
   AND c.ctx->'metadata'->>'stock_request_item'=NEW.id::text
   AND c.ctx->'metadata'->>'produto_id'=NEW.produto_id::text
   AND c.ctx->'metadata'->>'embalagem_id'=NEW.embalagem_id::text
   AND c.ctx->'metadata'->>'unidade_conteudo'=NEW.unidade_conteudo
   AND (c.ctx->'metadata'->>'conteudo_por_unidade')::numeric=NEW.conteudo_por_unidade
   AND (c.ctx->'metadata'->>'quantidade_conteudo')::numeric=NEW.quantidade_conteudo
   AND platform_private.finished_product_stock_valid_v1(NEW) IS TRUE
   AND EXISTS(SELECT 1 FROM platform_private.authz_tickets t WHERE t.txid=txid_current() AND t.scope='finished_product_purchase_entry_v1' AND t.target=NEW.id)
  THEN RETURN NEW; END IF;
  RAISE EXCEPTION 'FINISHED_PRODUCT_PURCHASE_CONTEXT_DENIED' USING ERRCODE='42501';
 END IF;
 -- Preserve ONLY the installed canonical partial reservation semantics under
 -- its private txid/actor/parent context, not an invented envase permit.
 IF TG_TABLE_NAME='estoque_produto' THEN
  SELECT * INTO c FROM platform_private.stock_motor_context WHERE txid=txid_current() AND actor=auth.uid();
  IF FOUND AND c.ctx->>'acao'='reserva' AND c.item IS NOT NULL AND NEW.id<>c.item THEN
   SELECT * INTO parent FROM public.estoque_produto WHERE id=c.item;
   a:=c.ctx->'reserve_args'; org:=platform_private.stock_motor_actor('reserva');
   IF parent.status::text='disponivel' AND NEW.status::text='reservado' AND NEW.quantidade>0 AND NEW.quantidade<parent.quantidade
    AND NEW.quantidade_reservada=NEW.quantidade AND NEW.lote_id=parent.lote_id
    AND NEW.envase_id IS NOT DISTINCT FROM parent.envase_id AND NEW.produto_id IS NOT DISTINCT FROM parent.produto_id AND NEW.microrganismo_id IS NOT DISTINCT FROM parent.microrganismo_id
    AND NEW.validade IS NOT DISTINCT FROM parent.validade
    AND ((parent.origem_estoque IS NULL AND NEW.volume_total=NEW.quantidade*parent.volume_total/parent.quantidade) OR (parent.origem_estoque='compra_produto_acabado_revenda' AND platform_private.finished_product_stock_valid_v1(parent) IS TRUE AND NEW.origem_estoque=parent.origem_estoque AND NEW.unidade_comercial=parent.unidade_comercial AND NEW.conteudo_por_unidade=parent.conteudo_por_unidade AND NEW.unidade_conteudo=parent.unidade_conteudo AND NEW.quantidade_conteudo=NEW.quantidade*parent.conteudo_por_unidade AND NEW.embalagem_id=parent.embalagem_id AND NEW.embalagem_versao=parent.embalagem_versao AND NEW.volume_total IS NOT DISTINCT FROM (NEW.quantidade*parent.volume_total/parent.quantidade)))
    AND NEW.reservado_para_os_id::text IS NOT DISTINCT FROM a->>'os_id' AND NEW.reservado_para_os_tipo IS NOT DISTINCT FROM a->>'os_tipo'
    AND NEW.reservado_para_cliente_id::text IS NOT DISTINCT FROM a->>'cliente_id'
    AND NEW.reservado_para_partner_id::text IS NOT DISTINCT FROM a->>'partner_id' AND NEW.reservado_para_partner_order_id::text IS NOT DISTINCT FROM a->>'partner_order_id'
    AND NEW.observacao_reserva IS NOT DISTINCT FROM a->>'observacao'
    AND EXISTS(SELECT 1 FROM public.lotes WHERE id=parent.lote_id AND organization_id=org) THEN RETURN NEW; END IF;
  END IF;
 END IF;
 RAISE EXCEPTION 'ENVASE_INSERT_CLOSED' USING ERRCODE='42501';
END $entry$;

CREATE OR REPLACE FUNCTION platform_private.envase_insert_final_v1() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $final$
DECLARE p platform_private.envase_insert_permits_v1%ROWTYPE;
BEGIN
 DELETE FROM platform_private.envase_insert_permits_v1 WHERE txid=txid_current() AND actor=auth.uid() AND action=TG_TABLE_NAME AND target=NEW.id AND admitted RETURNING * INTO p;
 IF FOUND THEN
  IF p.organization_id IS DISTINCT FROM platform_private.stock_envase_scope_v1(p.lote,p.prog,p.os,'manual')
   OR (to_jsonb(NEW)-'created_at'-'updated_at'-'origem_estoque'-'unidade_comercial'-'conteudo_por_unidade'-'unidade_conteudo'-'quantidade_conteudo'-'embalagem_id'-'embalagem_versao') IS DISTINCT FROM (p.payload-'origem_estoque'-'unidade_comercial'-'conteudo_por_unidade'-'unidade_conteudo'-'quantidade_conteudo'-'embalagem_id'-'embalagem_versao') THEN RAISE EXCEPTION 'ENVASE_FINAL_PERMIT_MISMATCH' USING ERRCODE='42501'; END IF;
 ELSIF TG_TABLE_NAME='envase' THEN RAISE EXCEPTION 'ENVASE_FINAL_PERMIT_MISSING' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $final$;
