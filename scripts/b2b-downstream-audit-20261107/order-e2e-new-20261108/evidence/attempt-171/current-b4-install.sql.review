    FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=d.sig::regprocedure) v) IS DISTINCT FROM d.acl_md5
  THEN RAISE EXCEPTION 'B4_POST_SHARED_ACL:%',d.sig USING ERRCODE='42501'; END IF;
 END LOOP;
END $guard$;DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('platform_private.b2b_allocate_document(uuid)'),('platform_private.b2b_allocation_money_row(uuid)'),('platform_private.b2b_cancellation_fence()'),('platform_private.b2b_credit_balances(uuid,uuid)'),('platform_private.b2b_credit_config_block(uuid)'),('platform_private.b2b_debtor_partner(uuid,uuid)'),('platform_private.b2b_integration_actor(uuid,boolean)'),('platform_private.b2b_integration_dependencies()'),('platform_private.b2b_legacy_money_row(uuid)'),('platform_private.b2b_order_residual(uuid)'),('platform_private.b2b_proven_money_row(uuid)'),('platform_private.b2b_proven_money_row_internal(uuid,uuid)'),('platform_private.b2b_receivable_partner_scope(uuid)'),('platform_private.b2b_reverse_allocation(uuid,uuid)'),('platform_private.b2b_shared_receivable_credit_guard()'),('platform_private.b2b_title_insert_fence()'),('platform_private.b4_assert_order_eligible(uuid)'),('platform_private.b4_schedule_from_nf(numeric,numeric,integer,date,integer,platform_private.holiday_calendars)'),('platform_private.price_adjusted_due(date,platform_private.holiday_calendars)'),('platform_private.price_calendar_load(text,text)'),('platform_private.price_immutable()'),('platform_private.price_pinned_calendar()'),('public.rpc_receivable_money_projection_v1(uuid,integer,integer)'),('public.generate_b2b_receivable_secure_impl(uuid)'),('public.tg_auto_b2b_receivable()')) x(sig) LOOP
  IF to_regprocedure(d.sig) IS NULL THEN RAISE EXCEPTION 'B4_POST_MISSING:%',d.sig USING ERRCODE='42501'; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=d.sig::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'B4_POST_OWNER:%',d.sig USING ERRCODE='42501'; END IF;
