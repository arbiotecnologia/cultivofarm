CREATE TABLE platform_private.b2b_authorized_documents (
 id uuid PRIMARY KEY, organization_id uuid NOT NULL, partner_id uuid NOT NULL, order_id uuid NOT NULL REFERENCES public.partner_orders(id),
 kind text NOT NULL CHECK(kind IN ('NFE','NFSE')), issue_date date NOT NULL CHECK(isfinite(issue_date)),
 event_key text NOT NULL, source_digest text NOT NULL CHECK(source_digest ~ '^[0-9a-f]{64}$'),
 items jsonb NOT NULL, state text NOT NULL CHECK(state IN ('AUTHORIZED','CANCELED')),
 UNIQUE(organization_id,kind,event_key)
);

CREATE TABLE platform_private.b2b_document_allocations (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_authorized_documents(id), organization_id uuid NOT NULL,
 order_id uuid NOT NULL REFERENCES public.partner_orders(id), partner_id uuid NOT NULL,
 receivable_id uuid NOT NULL UNIQUE REFERENCES public.accounts_receivable(id), source_digest text NOT NULL,
 principal numeric NOT NULL CHECK(principal>0), financed_interest numeric NOT NULL CHECK(financed_interest>=0),
 items jsonb NOT NULL, item_money jsonb NOT NULL CHECK(jsonb_typeof(item_money)='array'), rows jsonb NOT NULL, created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE platform_private.b2b_allocation_reversals (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_document_allocations(document_id),
 replacement_document_id uuid REFERENCES platform_private.b2b_authorized_documents(id), source_digest text NOT NULL,
 created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE platform_private.b2b_title_permits (
 transaction_id bigint NOT NULL, actor_id uuid NOT NULL, organization_id uuid NOT NULL, title_id uuid NOT NULL,
 order_id uuid NOT NULL, partner_id uuid NOT NULL, customer_id uuid NOT NULL, rows jsonb NOT NULL,
 PRIMARY KEY(transaction_id,title_id)
);

CREATE TABLE platform_private.b2b_cancellation_attestations (
 document_id uuid PRIMARY KEY REFERENCES platform_private.b2b_authorized_documents(id), organization_id uuid NOT NULL,
 event_key text NOT NULL, source_digest text NOT NULL CHECK(source_digest ~ '^[0-9a-f]{64}$'), UNIQUE(organization_id,event_key)
);

ALTER TABLE public.accounts_receivable ADD COLUMN b2b_document_id uuid REFERENCES platform_private.b2b_authorized_documents(id);
CREATE UNIQUE INDEX b2b_one_title_per_document ON public.accounts_receivable(b2b_document_id) WHERE b2b_document_id IS NOT NULL;
DROP INDEX public.ux_ar_one_active_per_b2b_order;
CREATE UNIQUE INDEX ux_ar_one_active_per_b2b_order ON public.accounts_receivable(origin_id) WHERE origin_type='B2B_ORDER' AND status<>'CANCELED' AND b2b_document_id IS NULL;


CREATE VIEW platform_private.b4_order_condition_snapshots AS
SELECT order_id,organization_id,partner_id,actor_id,plan_id,choice,condition,request_hash,rows,principal,financed_interest,financed_total,
       quote,payment_terms_id,cart_hash,payment_method_name,estimated,due_basis,estimated_reference_date,condition_version,condition_method,created_at
FROM platform_private.b2b_order_condition_snapshots WHERE quote IS FALSE
UNION ALL
SELECT order_id,organization_id,partner_id,actor_id,plan_id,choice,condition,request_hash,rows,principal,financed_interest,financed_total,
       FALSE AS quote,payment_terms_id,cart_hash,payment_method_name,estimated,due_basis,estimated_reference_date,condition_version,condition_method,created_at
FROM platform_private.b2b_order_condition_quote_snapshots;
REVOKE ALL ON platform_private.b4_order_condition_snapshots FROM PUBLIC,anon,authenticated,service_role;


DO $$ DECLARE t text; BEGIN
 FOREACH t IN ARRAY ARRAY['b2b_authorized_documents','b2b_document_allocations','b2b_allocation_reversals','b2b_cancellation_attestations'] LOOP
  EXECUTE format('ALTER TABLE platform_private.%I ENABLE ROW LEVEL SECURITY',t);
  EXECUTE format('REVOKE ALL ON platform_private.%I FROM PUBLIC,anon,authenticated,service_role',t);
  EXECUTE format('CREATE TRIGGER immutable_update_delete BEFORE UPDATE OR DELETE ON platform_private.%I FOR EACH ROW EXECUTE FUNCTION platform_private.price_immutable()',t);
  EXECUTE format('CREATE TRIGGER immutable_truncate BEFORE TRUNCATE ON platform_private.%I FOR EACH STATEMENT EXECUTE FUNCTION platform_private.price_immutable()',t);
 END LOOP;
END $$;
ALTER TABLE platform_private.b2b_title_permits ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.b2b_title_permits FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.b2b_integration_dependencies() RETURNS void
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN RAISE EXCEPTION 'B2B_FISCAL_ATTESTATION_ACCOUNTING_UNPROVEN' USING ERRCODE='42501'; END $$;

CREATE FUNCTION platform_private.b2b_integration_actor(p_partner uuid, p_internal boolean DEFAULT false) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE u uuid:=auth.uid(); org uuid:=public.h15_actor_organization(); owner_org uuid;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'B2B_READ_COMMITTED_REQUIRED' USING ERRCODE='0A000'; END IF;
 IF u IS NULL OR org IS NULL THEN RAISE EXCEPTION 'B2B_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.c2_order_actor_scope(u,p_partner);
 SELECT commercial_owner_organization_id INTO owner_org FROM public.partner_accounts WHERE id=p_partner AND ativo IS TRUE AND deleted_at IS NULL;
 IF owner_org IS DISTINCT FROM org THEN RAISE EXCEPTION 'B2B_TENANT_DENIED' USING ERRCODE='42501'; END IF;
 IF p_internal AND (public.is_financial_staff(u) IS NOT TRUE
  OR public.has_role(u,'parceiro_b2b'::public.app_role) OR public.has_role(u,'parceiro_b2b_tecnico'::public.app_role)
  OR public.has_role(u,'cliente_produtor'::public.app_role)) THEN RAISE EXCEPTION 'B2B_INTERNAL_ONLY' USING ERRCODE='42501'; END IF;
 RETURN org;
END $$;

CREATE OR REPLACE FUNCTION platform_private.b4_schedule_from_nf(principal numeric, rate numeric, n integer, issue date, deadline integer, cal platform_private.holiday_calendars)
 RETURNS jsonb
 LANGUAGE plpgsql
 IMMUTABLE
 SET search_path TO ''
AS $function$
DECLARE bal numeric; pmt numeric; intr numeric; amort numeric; amount numeric; first date; nom date; rows jsonb:='[]';
BEGIN
 IF principal IS NULL OR principal::text IN ('NaN','Infinity','-Infinity') OR principal<=0 OR principal<>round(principal,2)
 OR rate IS NULL OR rate::text IN ('NaN','Infinity','-Infinity') OR rate<0 OR n IS NULL OR n NOT BETWEEN 1 AND 120
 OR issue IS NULL OR NOT isfinite(issue) OR deadline IS NULL OR deadline<0 THEN RAISE EXCEPTION 'SCHEDULE_INVALID' USING ERRCODE='23514'; END IF;
 bal:=principal; first:=issue+deadline;
 pmt:=round(CASE WHEN rate=0 THEN principal/n ELSE principal*(rate/100)/(1-power(1+rate/100,-n)) END,2);
 FOR k IN 1..n LOOP
  intr:=round(bal*rate/100,2); amount:=CASE WHEN k=n THEN bal+intr ELSE pmt END; amort:=amount-intr;
  IF amort<0 THEN RAISE EXCEPTION 'SCHEDULE_INVALID' USING ERRCODE='23514'; END IF;
  nom:=(first+make_interval(months=>k-1))::date;
  rows:=rows||jsonb_build_array(jsonb_build_object('installment_number',k,'principal_amount',amort,'interest_amount',intr,'amount',amount,'nominal_due_date',nom,'due_date',platform_private.price_adjusted_due(nom,cal),'received_amount',0));
  bal:=bal-amort;
 END LOOP;
 IF bal<>0 THEN RAISE EXCEPTION 'SCHEDULE_RESIDUAL' USING ERRCODE='23514'; END IF;
 RETURN rows;
END $function$;

CREATE FUNCTION platform_private.b2b_credit_config_block(p_partner uuid) RETURNS text
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = '' AS $$
  SELECT CASE
    WHEN NOT EXISTS (SELECT 1 FROM public.partner_financial_settings s WHERE s.partner_id = p_partner AND s.active IS TRUE) THEN 'configuracao_financeira_inativa'
    WHEN NOT EXISTS (SELECT 1 FROM public.partner_financial_settings s WHERE s.partner_id = p_partner AND s.active IS TRUE AND s.credit_limit IS NOT NULL AND s.credit_limit >= 0 AND s.credit_limit::text NOT IN ('NaN','Infinity','-Infinity')) THEN 'limite_nao_definido'
    WHEN NOT EXISTS (SELECT 1 FROM public.partner_financial_settings s WHERE s.partner_id = p_partner AND s.active IS TRUE
      AND s.overdue_tolerance_days IS NOT NULL AND s.overdue_tolerance_days >= 0
      AND s.block_if_overdue IS NOT NULL AND s.credit_limit_action IN ('block','approval_required')) THEN 'configuracao_financeira_incompleta'
  END $$;

CREATE FUNCTION platform_private.b2b_debtor_partner(p_org uuid, p_customer uuid) RETURNS uuid[]
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = '' AS $$
  SELECT array_agg(pa.id ORDER BY pa.id) FROM public.partner_accounts pa
   WHERE pa.client_id = p_customer AND pa.commercial_owner_organization_id = p_org
     AND pa.ativo IS TRUE AND pa.deleted_at IS NULL $$;
REVOKE ALL ON FUNCTION platform_private.b2b_debtor_partner(uuid, uuid) FROM PUBLIC;

CREATE FUNCTION platform_private.b2b_shared_receivable_credit_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_p uuid[]; v_partner uuid; v jsonb; v_delta numeric(14,2); v_po_id uuid; v_po record; v_cfg text;
BEGIN
  IF NEW.customer_id IS NULL AND NEW.origin_type IS DISTINCT FROM 'B2B_ORDER' THEN RETURN NEW; END IF;
  IF NEW.organization_id IS NULL THEN RAISE EXCEPTION 'CREDIT_TENANT_REQUIRED' USING ERRCODE = '42501'; END IF;
  v_p := platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id);
  IF cardinality(v_p) > 1 THEN RAISE EXCEPTION 'CREDIT_PARTNER_LINK_AMBIGUOUS' USING ERRCODE = '42501'; END IF;
  v_partner := v_p[1];
  -- Order-linked origins are never trusted from the row: the order must exist server-side, belong to
  -- the resolved/declared partner, and its amount is netted only while it is still counted as committed.
  IF NEW.origin_type = 'B2B_ORDER' THEN
    v_po_id := NEW.origin_id;
    IF v_po_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id = v_po_id) THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_UNPROVEN' USING ERRCODE = '23514';
    END IF;
  ELSIF NEW.origin_type = 'DELIVERY' AND NEW.origin_id IS NOT NULL THEN
    SELECT e.partner_order_id INTO v_po_id FROM public.entregas e WHERE e.id = NEW.origin_id;
  END IF;
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id FOR UPDATE;  -- order row before b2b_credit
    IF v_partner IS NULL AND NEW.origin_type = 'B2B_ORDER' THEN v_partner := v_po.partner_id; END IF;
    IF v_po.partner_id IS NULL OR v_po.partner_id IS DISTINCT FROM v_partner THEN
      RAISE EXCEPTION 'CREDIT_ORDER_PARTNER_MISMATCH' USING ERRCODE = '23514';
    END IF;
    IF NEW.origin_type = 'B2B_ORDER' AND EXISTS (SELECT 1 FROM public.accounts_receivable ar WHERE ar.origin_type = 'B2B_ORDER'
         AND ar.origin_id = v_po_id AND ar.status <> 'CANCELED') THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_ALREADY_BILLED' USING ERRCODE = 'PT409';
    END IF;
  END IF;
  IF v_partner IS NULL THEN RETURN NEW; END IF;  -- not a partner debtor of this tenant: untouched
  IF NEW.partner_id IS NOT NULL AND NEW.partner_id IS DISTINCT FROM v_partner THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE = '23514';
  END IF;
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'CREDIT_ISOLATION_UNSUPPORTED' USING ERRCODE = '0A000';  -- stale snapshot after wait
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || v_partner::text, 0));
  -- Fresh statement snapshots from here on (READ COMMITTED): re-resolve the link after any wait.
  IF platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id) IS DISTINCT FROM v_p THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';  -- unlinked/relinked/transferred while waiting
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_accounts pa WHERE pa.id = v_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
                  AND pa.commercial_owner_organization_id = NEW.organization_id) THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';
  END IF;
  v_cfg := platform_private.b2b_credit_config_block(v_partner);
  IF v_cfg = 'configuracao_financeira_inativa' THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INACTIVE' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg = 'limite_nao_definido' THEN RAISE EXCEPTION 'CREDIT_NO_LIMIT_DEFINED' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg IS NOT NULL THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE = 'PT409'; END IF;
  v := public.fn_b2b_credit_exposure(v_partner, 0, NULL);
  IF (v->>'block_if_overdue')::boolean AND (v->>'tem_vencidos')::boolean THEN
    RAISE EXCEPTION 'CREDIT_OVERDUE_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  v_delta := round(NEW.total_amount, 2);
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id;
    IF COALESCE(v_po.receivable_generated, false) = false
       AND v_po.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue',
                           'pendente','solicitado','em_analise_comercial','aguardando_aprovacao_credito','aguardando_ajuste_comercial','aguardando_itens')
       AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id = v_po_id) THEN
      v_delta := v_delta - round(COALESCE(v_po.final_amount_with_interest, v_po.total, 0), 2);
    END IF;
  END IF;
  -- A title that does not increase exposure (conversion/delivery of an already counted, possibly
  -- credit-approved order) is never refused for limit; any increase must fit.
  IF v_delta > 0 AND (v->>'exposicao_atual')::numeric + v_delta > (v->>'credit_limit')::numeric THEN
    IF v->>'credit_limit_action' = 'approval_required' THEN
      RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_APPROVAL' USING ERRCODE = 'PT409';
    END IF;
    RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  NEW.partner_id := v_partner;  -- canonical exposure sees the title afterwards (no second ledger)
  RETURN NEW;
END $$;

CREATE FUNCTION platform_private.b2b_receivable_partner_scope(p_receivable uuid) RETURNS uuid
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $$
DECLARE a public.accounts_receivable; links uuid[];
BEGIN
 SELECT * INTO a FROM public.accounts_receivable WHERE id=p_receivable;
 IF NOT FOUND THEN RAISE EXCEPTION 'CREDIT_RECEIVABLE_NOT_FOUND' USING ERRCODE='23514'; END IF;
 links:=platform_private.b2b_debtor_partner(a.organization_id,a.customer_id);
 IF coalesce(cardinality(links),0)>1 THEN RAISE EXCEPTION 'CREDIT_PARTNER_LINK_AMBIGUOUS' USING ERRCODE='42501'; END IF;
 IF a.partner_id IS NOT NULL THEN
  IF NOT EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=a.partner_id
    AND pa.commercial_owner_organization_id=a.organization_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL)
  THEN RAISE EXCEPTION 'CREDIT_PARTNER_OWNER_MISMATCH' USING ERRCODE='23514'; END IF;
  IF coalesce(cardinality(links),0)=1 AND links[1] IS DISTINCT FROM a.partner_id
  THEN RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE='23514'; END IF;
  RETURN a.partner_id;
 END IF;
 RETURN links[1];
END $$;

CREATE OR REPLACE FUNCTION platform_private.b4_assert_order_eligible(p_order uuid) RETURNS void
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $$
DECLARE e jsonb;
BEGIN
 IF EXISTS(SELECT 1 FROM public.partner_orders o WHERE o.id=p_order AND o.internal_origin_snapshot IS NOT NULL) THEN
  RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_orders o WHERE o.id=p_order AND o.c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1') THEN
  RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501'; END IF;
 e:=public.fn_b2b_order_billing_eligibility(p_order);
 IF coalesce(e->>'eligible','false')<>'true' THEN
  RAISE EXCEPTION 'B2B_ORDER_NOT_BILLABLE:%',coalesce(e->>'reason_code','UNKNOWN') USING ERRCODE='PT409'; END IF;
END $$;
REVOKE ALL ON FUNCTION platform_private.b4_assert_order_eligible(uuid) FROM PUBLIC,anon,authenticated,service_role;

-- INACTIVE: canonical proof reads existing immutable history, never rewrites it.
CREATE FUNCTION platform_private.b2b_legacy_money_row(p_id uuid) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE i public.accounts_receivable_installments; a public.accounts_receivable; po public.partner_orders;
 org uuid; sealed jsonb; sch jsonb; terms jsonb; audit jsonb;
 financing numeric; principal numeric; late_interest numeric; received numeric; disc numeric; penalty numeric;
BEGIN
 SELECT * INTO i FROM public.accounts_receivable_installments WHERE id=p_id;
 org:=i.organization_id;
 SELECT * INTO a FROM public.accounts_receivable WHERE id=i.receivable_id AND organization_id=org;
 IF a.origin_type IS DISTINCT FROM 'B2B_ORDER' THEN RETURN NULL; END IF;
 SELECT * INTO po FROM public.partner_orders WHERE id=a.origin_id AND partner_id=a.partner_id;
 sealed:=po.internal_economic_snapshot; terms:=sealed->'terms';
 IF sealed IS NULL OR sealed->>'schema_version' IS DISTINCT FROM '1' OR sealed->>'sealed_by' IS NULL
 OR coalesce(sealed->'origin'->>'organization_id',sealed->'origin'->>'creditor_organization_id') IS DISTINCT FROM org::text
 OR sealed->'origin'->>'partner_id' IS DISTINCT FROM a.partner_id::text
 OR NOT EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=a.partner_id AND pa.commercial_owner_organization_id=org)
 OR terms->>'id' IS DISTINCT FROM po.payment_terms_id::text OR terms->>'partner_order_id' IS DISTINCT FROM po.id::text
 OR (SELECT count(*) FROM public.partner_order_financial_links l WHERE l.partner_order_id=po.id AND l.receivable_id=a.id AND l.partner_id=a.partner_id)<>1
 OR (SELECT count(*) FROM public.partner_order_financial_links l WHERE l.receivable_id=a.id)<>1
 OR EXISTS(SELECT 1 FROM platform_private.price_schedule_snapshots s WHERE s.receivable_id=a.id)
 OR EXISTS(SELECT 1 FROM platform_private.b2b_document_allocations x WHERE x.receivable_id=a.id)
 THEN RAISE EXCEPTION 'B2B_LEGACY_ORIGIN_UNPROVEN' USING ERRCODE='23514'; END IF;
 IF jsonb_typeof(sealed->'schedule') IS DISTINCT FROM 'array' THEN RAISE EXCEPTION 'B2B_LEGACY_ORIGIN_UNPROVEN' USING ERRCODE='23514'; END IF;
 IF (SELECT count(*) FROM jsonb_array_elements(sealed->'schedule') s WHERE (s->>'installment_number')::int=i.installment_number)<>1 THEN RAISE EXCEPTION 'B2B_LEGACY_SCHEDULE_AMBIGUOUS' USING ERRCODE='23514'; END IF;
 SELECT s INTO sch FROM jsonb_array_elements(sealed->'schedule') s WHERE (s->>'installment_number')::int=i.installment_number;
 IF (SELECT count(*) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=po.id AND s.payment_terms_id=po.payment_terms_id AND s.installment_number=i.installment_number AND s.receivable_installment_id=i.id)<>1
 OR NOT EXISTS(SELECT 1 FROM public.partner_order_payment_schedule s WHERE s.id=(sch->>'id')::uuid AND s.receivable_installment_id=i.id AND (to_jsonb(s)-ARRAY['created_at','status','receivable_installment_id'])=sch)
 OR (SELECT count(*) FROM public.accounts_receivable_installments s WHERE s.receivable_id=a.id)<>(terms->>'installment_count')::int
 THEN RAISE EXCEPTION 'B2B_LEGACY_LINK_MISMATCH' USING ERRCODE='23514'; END IF;
 -- Captured writer's immutable INSERT audit is required, not merely a current schedule match.
 IF (SELECT count(*) FROM public.financial_audit_log f WHERE f.entity_type='accounts_receivable_installments' AND f.entity_id=i.id AND f.action='INSERT')<>1 THEN RAISE EXCEPTION 'B2B_LEGACY_WRITER_UNPROVEN' USING ERRCODE='23514'; END IF;
 SELECT f.new_data INTO audit FROM public.financial_audit_log f WHERE f.entity_type='accounts_receivable_installments' AND f.entity_id=i.id AND f.action='INSERT';
 financing:=(sch->>'interest_amount')::numeric; principal:=(sch->>'principal_amount')::numeric;
 IF principal IS NULL OR financing IS NULL OR principal<0 OR financing<0 OR principal+financing IS DISTINCT FROM i.original_amount
 OR i.original_amount IS DISTINCT FROM (sch->>'amount')::numeric OR i.due_date IS DISTINCT FROM (sch->>'due_date')::date
 OR audit->>'receivable_id' IS DISTINCT FROM a.id::text OR audit->>'organization_id' IS DISTINCT FROM org::text
 OR (audit->>'original_amount')::numeric IS DISTINCT FROM i.original_amount OR (audit->>'interest_amount')::numeric IS DISTINCT FROM financing
 OR (terms->>'final_amount')::numeric IS DISTINCT FROM a.total_amount
 OR (SELECT sum((s->>'amount')::numeric) FROM jsonb_array_elements(sealed->'schedule') s) IS DISTINCT FROM a.total_amount
 THEN RAISE EXCEPTION 'B2B_LEGACY_WRITER_INCOMPATIBLE' USING ERRCODE='23514'; END IF;
 IF EXISTS(SELECT 1 FROM public.receivable_payments p WHERE p.installment_id=i.id AND p.organization_id IS DISTINCT FROM org)
 OR EXISTS(SELECT 1 FROM public.receivable_payments p WHERE p.installment_id=i.id AND p.is_reversal AND NOT EXISTS(SELECT 1 FROM public.receivable_payments r WHERE r.id=p.reversed_payment_id AND r.installment_id=i.id AND r.organization_id=org AND NOT r.is_reversal))
 THEN RAISE EXCEPTION 'B2B_LEGACY_LEDGER_INCOMPATIBLE' USING ERRCODE='23514'; END IF;
 SELECT coalesce(sum(p.interest_amount),0),coalesce(sum(p.amount_received),0),coalesce(sum(p.discount_amount),0),coalesce(sum(p.penalty_amount),0)
 INTO late_interest,received,disc,penalty FROM public.receivable_payments p WHERE p.installment_id=i.id;
 IF received IS DISTINCT FROM i.received_amount OR disc IS DISTINCT FROM i.discount_amount OR penalty IS DISTINCT FROM i.penalty_amount
 OR (EXISTS(SELECT 1 FROM public.receivable_payments p WHERE p.installment_id=i.id) AND i.interest_amount IS DISTINCT FROM late_interest)
 OR (NOT EXISTS(SELECT 1 FROM public.receivable_payments p WHERE p.installment_id=i.id) AND i.interest_amount IS DISTINCT FROM financing)
 THEN RAISE EXCEPTION 'B2B_LEGACY_LEDGER_MISMATCH' USING ERRCODE='23514'; END IF;
 RETURN to_jsonb(i)||jsonb_build_object('monetary_semantics','financed_total_v1','interest_amount',financing+late_interest,'financed_interest_amount',financing,
 'monetary_origin',jsonb_build_object('contract','RECEIVABLE_MONEY_V1','source','b2b_immutable_schedule_v1','installment_id',i.id,'receivable_id',a.id,'organization_id',org,'order_id',po.id,'schedule_id',sch->>'id','snapshot_principal',principal,'snapshot_interest',financing));
END $$;

CREATE FUNCTION platform_private.b2b_allocation_money_row(p_id uuid) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE i public.accounts_receivable_installments; a public.accounts_receivable; x platform_private.b2b_document_allocations; row jsonb;
BEGIN
 SELECT * INTO i FROM public.accounts_receivable_installments WHERE id=p_id;
 SELECT * INTO a FROM public.accounts_receivable WHERE id=i.receivable_id AND organization_id=i.organization_id;
 SELECT * INTO x FROM platform_private.b2b_document_allocations WHERE receivable_id=a.id AND organization_id=a.organization_id;
 IF NOT FOUND THEN RETURN NULL; END IF;
 IF a.origin_type IS DISTINCT FROM 'B2B_ORDER' OR a.origin_id IS DISTINCT FROM x.order_id OR a.partner_id IS DISTINCT FROM x.partner_id OR a.b2b_document_id IS DISTINCT FROM x.document_id
 OR (SELECT count(*) FROM public.accounts_receivable_installments s WHERE s.receivable_id=a.id)<>jsonb_array_length(x.rows)
 OR (SELECT count(DISTINCT s.installment_number) FROM public.accounts_receivable_installments s WHERE s.receivable_id=a.id)<>jsonb_array_length(x.rows)
 OR (SELECT sum((r->>'principal_amount')::numeric) FROM jsonb_array_elements(x.rows) r) IS DISTINCT FROM x.principal
 OR (SELECT sum((r->>'interest_amount')::numeric) FROM jsonb_array_elements(x.rows) r) IS DISTINCT FROM x.financed_interest
 OR NOT EXISTS(SELECT 1 FROM platform_private.b2b_authorized_documents d WHERE d.id=x.document_id AND d.organization_id=x.organization_id AND d.order_id=x.order_id AND d.partner_id=x.partner_id AND d.source_digest=x.source_digest AND d.state='AUTHORIZED')
 OR EXISTS(SELECT 1 FROM platform_private.price_schedule_snapshots s WHERE s.receivable_id=a.id)
 OR (SELECT count(*) FROM jsonb_array_elements(x.rows) r WHERE (r->>'installment_number')::int=i.installment_number)<>1
 THEN RAISE EXCEPTION 'B2B_ALLOCATION_ORIGIN_INVALID' USING ERRCODE='23514'; END IF;
 SELECT r INTO row FROM jsonb_array_elements(x.rows) r WHERE (r->>'installment_number')::int=i.installment_number;
 IF i.original_amount IS DISTINCT FROM (row->>'amount')::numeric OR i.due_date IS DISTINCT FROM (row->>'due_date')::date
 OR i.original_amount IS DISTINCT FROM (row->>'principal_amount')::numeric+(row->>'interest_amount')::numeric
 OR a.total_amount IS DISTINCT FROM x.principal+x.financed_interest
 THEN RAISE EXCEPTION 'B2B_ALLOCATION_ORIGIN_INVALID' USING ERRCODE='23514'; END IF;
 RETURN to_jsonb(i)||jsonb_build_object('monetary_semantics','financed_total_v1','interest_amount',i.interest_amount+(row->>'interest_amount')::numeric,'financed_interest_amount',(row->>'interest_amount')::numeric,
 'monetary_origin',jsonb_build_object('contract','RECEIVABLE_MONEY_V1','source','b2b_document_allocation_v1','installment_id',i.id,'receivable_id',a.id,'organization_id',a.organization_id,'order_id',x.order_id,'document_id',x.document_id,'snapshot_principal',(row->>'principal_amount')::numeric,'snapshot_interest',(row->>'interest_amount')::numeric));
END $$;

-- Single origin resolver shared by projection and credit; no legacy fallback.
CREATE FUNCTION platform_private.b2b_proven_money_row_internal(p_id uuid,p_org uuid) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid:=p_org; i public.accounts_receivable_installments; row jsonb; r jsonb;
BEGIN
 IF org IS NULL THEN RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE='42501'; END IF;
 SELECT s.* INTO i FROM public.accounts_receivable_installments s JOIN public.accounts_receivable a ON a.id=s.receivable_id WHERE s.id=p_id AND s.organization_id=org AND a.organization_id=org;
 IF NOT FOUND THEN RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE='42501'; END IF;
 row:=NULL;
  IF EXISTS(SELECT 1 FROM platform_private.price_schedule_snapshots s WHERE s.receivable_id=i.receivable_id AND s.organization_id=org) THEN
   IF EXISTS(SELECT 1 FROM public.accounts_receivable a WHERE a.id=i.receivable_id AND a.origin_type='B2B_ORDER') THEN RAISE EXCEPTION 'MONEY_ORIGIN_MIXED' USING ERRCODE='23514'; END IF;
   IF (SELECT count(*) FROM platform_private.price_schedule_snapshots s CROSS JOIN LATERAL jsonb_array_elements(s.rows) x WHERE s.receivable_id=i.receivable_id AND s.organization_id=org AND (x->>'installment_number')::int=i.installment_number)<>1 THEN RAISE EXCEPTION 'MONEY_ORIGIN_INVALID' USING ERRCODE='23514'; END IF;
   SELECT x INTO r FROM platform_private.price_schedule_snapshots s CROSS JOIN LATERAL jsonb_array_elements(s.rows) x WHERE s.receivable_id=i.receivable_id AND s.organization_id=org AND (x->>'installment_number')::int=i.installment_number;
   IF i.original_amount IS DISTINCT FROM (r->>'amount')::numeric OR i.original_amount IS DISTINCT FROM (r->>'principal')::numeric+(r->>'interest')::numeric THEN RAISE EXCEPTION 'MONEY_ORIGIN_INVALID' USING ERRCODE='23514'; END IF;
   row:=to_jsonb(i)||jsonb_build_object('monetary_semantics','financed_total_v1','interest_amount',i.interest_amount+(r->>'interest')::numeric,'financed_interest_amount',(r->>'interest')::numeric,'monetary_origin',jsonb_build_object('contract','RECEIVABLE_MONEY_V1','source','price_snapshot_v1','installment_id',i.id,'receivable_id',i.receivable_id,'organization_id',org,'snapshot_principal',(r->>'principal')::numeric,'snapshot_interest',(r->>'interest')::numeric));
  ELSE
   row:=platform_private.b2b_allocation_money_row(i.id);
   IF row IS NULL THEN row:=platform_private.b2b_legacy_money_row(i.id); END IF;
  END IF;
  IF row IS NULL THEN RAISE EXCEPTION 'MONEY_ORIGIN_UNPROVEN' USING ERRCODE='23514'; END IF;
 RETURN row;
END $$;
CREATE FUNCTION platform_private.b2b_proven_money_row(p_id uuid) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid:=public.h15_actor_organization();
BEGIN
 IF auth.uid() IS NULL OR org IS NULL OR public.is_financial_staff(auth.uid()) IS NOT TRUE THEN RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE='42501'; END IF;
 RETURN platform_private.b2b_proven_money_row_internal(p_id,org);
END $$;
REVOKE ALL ON FUNCTION platform_private.b2b_proven_money_row(uuid),platform_private.b2b_proven_money_row_internal(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE OR REPLACE FUNCTION public.rpc_receivable_money_projection_v1(p_receivable_id uuid DEFAULT NULL,p_offset int DEFAULT 0,p_limit int DEFAULT 1000)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid:=public.h15_actor_organization(); i record; row jsonb; r jsonb; result jsonb:='[]';
BEGIN
 IF auth.uid() IS NULL OR org IS NULL OR public.is_financial_staff(auth.uid()) IS NOT TRUE THEN RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE='42501'; END IF;
 IF p_offset IS NULL OR p_offset<0 OR p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 1000 THEN RAISE EXCEPTION 'MONEY_ORIGIN_PAGE_INVALID' USING ERRCODE='23514'; END IF;
 IF p_receivable_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.accounts_receivable a WHERE a.id=p_receivable_id AND a.organization_id=org) THEN RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE='42501'; END IF;
 FOR i IN SELECT s.* FROM public.accounts_receivable_installments s JOIN public.accounts_receivable a ON a.id=s.receivable_id WHERE s.organization_id=org AND a.organization_id=org AND (p_receivable_id IS NULL OR a.id=p_receivable_id) ORDER BY s.id OFFSET p_offset LIMIT p_limit LOOP
  row:=platform_private.b2b_proven_money_row(i.id);
  result:=result||jsonb_build_array(row);
 END LOOP;
 RETURN result;
END $$;
REVOKE ALL ON FUNCTION platform_private.b2b_legacy_money_row(uuid),platform_private.b2b_allocation_money_row(uuid),public.rpc_receivable_money_projection_v1(uuid,int,int) FROM PUBLIC,anon,authenticated,service_role;
-- INACTIVE. Append-only allocations replace neither old links nor historical rows.
CREATE OR REPLACE FUNCTION platform_private.b2b_order_residual(p_order uuid)
 RETURNS numeric
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE po public.partner_orders; s platform_private.b4_order_condition_snapshots; allocated numeric; total numeric; org uuid;
BEGIN
 SELECT * INTO po FROM public.partner_orders WHERE id=p_order;
 SELECT pa.commercial_owner_organization_id INTO org FROM public.partner_accounts pa WHERE pa.id=po.partner_id;
 IF org IS NULL THEN RAISE EXCEPTION 'CREDIT_ORDER_AMOUNT_UNPROVEN' USING ERRCODE='23514'; END IF;
 SELECT * INTO s FROM platform_private.b4_order_condition_snapshots WHERE order_id=p_order;
 total:=coalesce(s.financed_total,po.final_amount_with_interest);
 IF total IS NULL OR total<0 OR total::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'CREDIT_ORDER_AMOUNT_UNPROVEN' USING ERRCODE='23514'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id=p_order) THEN
  -- Legacy 1:1 can be netted only when the complete title is proven by the same projection.
  IF s.order_id IS NOT NULL OR (SELECT count(*) FROM public.partner_order_financial_links l WHERE l.partner_order_id=p_order)<>1 THEN RAISE EXCEPTION 'CREDIT_LEGACY_ALLOCATION_UNPROVEN' USING ERRCODE='23514'; END IF;
  PERFORM platform_private.b2b_proven_money_row_internal(i.id,org) FROM public.partner_order_financial_links l JOIN public.accounts_receivable a ON a.id=l.receivable_id JOIN public.accounts_receivable_installments i ON i.receivable_id=a.id WHERE l.partner_order_id=p_order;
  IF NOT EXISTS(SELECT 1 FROM public.partner_order_financial_links l JOIN public.accounts_receivable a ON a.id=l.receivable_id WHERE l.partner_order_id=p_order AND a.total_amount=total AND a.status<>'CANCELED') THEN RAISE EXCEPTION 'CREDIT_LEGACY_ALLOCATION_UNPROVEN' USING ERRCODE='23514'; END IF;
  RETURN 0;
 END IF;
 IF po.receivable_generated AND s.order_id IS NULL THEN RAISE EXCEPTION 'CREDIT_LEGACY_ALLOCATION_UNPROVEN' USING ERRCODE='23514'; END IF;
 SELECT coalesce(sum(x.principal+x.financed_interest),0) INTO allocated FROM platform_private.b2b_document_allocations x WHERE x.order_id=p_order AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=x.document_id);
 IF allocated>total THEN RAISE EXCEPTION 'CREDIT_OVERALLOCATED' USING ERRCODE='23514'; END IF;
 RETURN total-allocated;
END $function$;

CREATE FUNCTION platform_private.b2b_credit_balances(p_partner uuid,p_exclude uuid DEFAULT NULL) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid:=platform_private.b2b_integration_actor(p_partner); po record; i record; row jsonb; open_amount numeric:=0; overdue numeric:=0; committed numeric:=0; pending numeric:=0; balance numeric; residual numeric; tolerance int; debtor uuid;
BEGIN
 IF platform_private.b2b_credit_config_block(p_partner) IS NOT NULL THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE='23514'; END IF;
 SELECT overdue_tolerance_days INTO tolerance FROM public.partner_financial_settings WHERE partner_id=p_partner AND active IS TRUE;
 IF tolerance IS NULL OR tolerance<0 THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE='23514'; END IF;
 FOR i IN SELECT a.id AS receivable_id,s.id,s.due_date FROM public.accounts_receivable_installments s JOIN public.accounts_receivable a ON a.id=s.receivable_id
  WHERE a.organization_id=org AND s.organization_id=org AND a.status<>'CANCELED' AND s.status<>'CANCELED'
   AND (a.partner_id=p_partner OR EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=p_partner AND pa.client_id=a.customer_id
        AND pa.commercial_owner_organization_id=org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL)) LOOP
  debtor:=platform_private.b2b_receivable_partner_scope(i.receivable_id);
  IF debtor IS DISTINCT FROM p_partner THEN RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE='23514'; END IF;
  row:=platform_private.b2b_proven_money_row_internal(i.id,org);
  IF row IS NULL THEN RAISE EXCEPTION 'CREDIT_MONEY_ORIGIN_UNPROVEN' USING ERRCODE='23514'; END IF;
  balance:=greatest((row->>'original_amount')::numeric+(row->>'interest_amount')::numeric-(row->>'financed_interest_amount')::numeric+(row->>'penalty_amount')::numeric-(row->>'discount_amount')::numeric-(row->>'received_amount')::numeric,0);
  open_amount:=open_amount+balance;
  IF i.due_date<CURRENT_DATE-tolerance THEN overdue:=overdue+balance; END IF;
 END LOOP;
 FOR po IN SELECT id,status::text AS status FROM public.partner_orders WHERE partner_id=p_partner AND id IS DISTINCT FROM p_exclude AND status::text IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue','pendente','solicitado','em_analise_comercial','aguardando_aprovacao_credito','aguardando_ajuste_comercial','aguardando_itens') LOOP
  residual:=platform_private.b2b_order_residual(po.id);
  IF po.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue') THEN committed:=committed+residual; ELSE pending:=pending+residual; END IF;
 END LOOP;
 RETURN jsonb_build_object('saldo_em_aberto',open_amount,'saldo_vencido',overdue,'comprometido_nao_faturado',committed,'comprometido_pendente',pending);
END $$;

CREATE OR REPLACE FUNCTION platform_private.b2b_allocate_document(p_document uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE d platform_private.b2b_authorized_documents; s platform_private.b4_order_condition_snapshots; x platform_private.b2b_document_allocations;
 org uuid; u uuid:=auth.uid(); it jsonb; accepted jsonb:='[]'; base jsonb; qty numeric; previous numeric; totalqty numeric; pr numeric; intr numeric; principal numeric:=0; financing numeric:=0; active_pr numeric; active_intr numeric;
 tid uuid:=gen_random_uuid(); rows jsonb; final numeric; cfg jsonb; cal platform_private.holiday_calendars; customer uuid; category uuid; method_id uuid; item_net numeric; item_financing numeric;
 commercial_unit text; taxable_unit text; content_unit text; content_per_unit numeric; commercial_qty numeric; taxable_qty numeric;
 normalized_commercial numeric; normalized_taxable numeric; wholepack boolean;
BEGIN
 SELECT * INTO d FROM platform_private.b2b_authorized_documents WHERE id=p_document;
 org:=platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM platform_private.b2b_integration_dependencies();
 IF d.organization_id IS DISTINCT FROM org OR d.state IS DISTINCT FROM 'AUTHORIZED' THEN RAISE EXCEPTION 'FISCAL_DOCUMENT_NOT_AUTHORIZED' USING ERRCODE='42501'; END IF;
 -- Order row precedes shared credit, same as approval. Document lock follows order.
 PERFORM 1 FROM public.partner_orders WHERE id=d.order_id FOR UPDATE;
 PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM platform_private.b4_assert_order_eligible(d.order_id);
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:'||d.partner_id::text,0));
 PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 SELECT * INTO d FROM platform_private.b2b_authorized_documents WHERE id=p_document FOR SHARE;
 PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM platform_private.b4_assert_order_eligible(d.order_id);
 PERFORM platform_private.b2b_integration_dependencies();
 IF d.organization_id IS DISTINCT FROM org OR d.state IS DISTINCT FROM 'AUTHORIZED' THEN RAISE EXCEPTION 'FISCAL_DOCUMENT_NOT_AUTHORIZED' USING ERRCODE='42501'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_cancellation_attestations c WHERE c.document_id=p_document) THEN RAISE EXCEPTION 'FISCAL_DOCUMENT_CANCELED' USING ERRCODE='PT409'; END IF;
 SELECT * INTO s FROM platform_private.b4_order_condition_snapshots WHERE order_id=d.order_id AND organization_id=org AND partner_id=d.partner_id;
 IF NOT FOUND OR s.quote IS NOT FALSE OR s.payment_terms_id IS NULL OR s.estimated IS NOT TRUE OR s.due_basis IS DISTINCT FROM 'nf_issue'
 OR EXISTS(SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id=d.order_id) THEN RAISE EXCEPTION 'B2B_ORDER_SNAPSHOT_UNPROVEN' USING ERRCODE='23514'; END IF;
 SELECT * INTO x FROM platform_private.b2b_document_allocations WHERE document_id=p_document;
 IF FOUND THEN
  IF x.source_digest IS DISTINCT FROM d.source_digest OR x.order_id IS DISTINCT FROM d.order_id OR x.organization_id IS DISTINCT FROM org OR x.items IS DISTINCT FROM d.items THEN RAISE EXCEPTION 'FISCAL_REPLAY_DIVERGENCE' USING ERRCODE='PT409'; END IF;
  IF EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=p_document) THEN RAISE EXCEPTION 'FISCAL_DOCUMENT_CANCELED' USING ERRCODE='PT409'; END IF;
  RETURN jsonb_build_object('success',true,'document_id',p_document,'receivable_id',x.receivable_id,'replayed',true);
 END IF;
 IF jsonb_typeof(d.items) IS DISTINCT FROM 'array' OR jsonb_array_length(d.items)=0 OR (SELECT count(DISTINCT j->>'item_id') FROM jsonb_array_elements(d.items) j)<>jsonb_array_length(d.items) THEN RAISE EXCEPTION 'FISCAL_ITEMS_INVALID' USING ERRCODE='23514'; END IF;
 -- Subtotals must ALREADY be the accepted net item bases (as written by the
 -- canonical cart). Never invent a discount allocation from aggregate totals.
 IF (SELECT sum(i.subtotal) FROM public.partner_order_items i WHERE i.order_id=d.order_id) IS DISTINCT FROM s.principal
 OR EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=d.order_id AND (i.subtotal IS NULL OR i.subtotal<0 OR i.quantidade IS NULL OR i.quantidade<=0))
 THEN RAISE EXCEPTION 'FISCAL_NET_ITEM_BASE_UNPROVEN' USING ERRCODE='23514'; END IF;
 FOR it IN SELECT j FROM jsonb_array_elements(d.items) j ORDER BY j->>'item_id' COLLATE "C" LOOP
  IF NOT (it ?& ARRAY['item_id','quantity','commercial_unit','taxable_quantity','taxable_unit']) THEN RAISE EXCEPTION 'FISCAL_UNIT_CONTRACT_REQUIRED' USING ERRCODE='23514'; END IF;
  IF jsonb_typeof(it) IS DISTINCT FROM 'object'
   OR EXISTS(SELECT 1 FROM jsonb_object_keys(it) k WHERE k NOT IN ('item_id','quantity','commercial_unit','taxable_quantity','taxable_unit'))
   OR jsonb_typeof(it->'quantity') IS DISTINCT FROM 'number' OR jsonb_typeof(it->'taxable_quantity') IS DISTINCT FROM 'number'
   OR jsonb_typeof(it->'commercial_unit') IS DISTINCT FROM 'string' OR jsonb_typeof(it->'taxable_unit') IS DISTINCT FROM 'string'
  THEN RAISE EXCEPTION 'FISCAL_ITEMS_INVALID' USING ERRCODE='23514'; END IF;
  commercial_qty:=(it->>'quantity')::numeric; taxable_qty:=(it->>'taxable_quantity')::numeric;
  commercial_unit:=upper(btrim(it->>'commercial_unit')); taxable_unit:=upper(btrim(it->>'taxable_unit'));
  SELECT to_jsonb(i) INTO base FROM public.partner_order_items i WHERE i.id=(it->>'item_id')::uuid AND i.order_id=d.order_id;
  IF base IS NULL OR commercial_qty<=0 OR taxable_qty<=0
   OR commercial_qty::text IN ('NaN','Infinity','-Infinity') OR taxable_qty::text IN ('NaN','Infinity','-Infinity')
  THEN RAISE EXCEPTION 'FISCAL_ITEMS_INVALID' USING ERRCODE='23514'; END IF;
  wholepack:=NULLIF(base->>'packaging_id_snapshot','') IS NOT NULL;
  IF wholepack THEN
   -- product_packagings.peso_liquido_kg e seu snapshot armazenam SEMPRE kg.
   -- packaging_unidade_conteudo_snapshot='g' controla apenas o rótulo (0,500 kg -> 500 g),
   -- nunca a dimensão do número guardado. Whole-pack líquido não é presumido: o writer exige sólido.
   IF lower(base->>'packaging_unidade_conteudo_snapshot') NOT IN ('kg','g')
   THEN RAISE EXCEPTION 'FISCAL_ITEM_UNIT_SNAPSHOT_UNPROVEN' USING ERRCODE='23514'; END IF;
   content_unit:='kg'; content_per_unit:=(base->>'packaging_peso_liquido_kg_snapshot')::numeric;
  ELSE
   content_unit:='ml';
   IF NULLIF(base->>'volume_ml','') IS NOT NULL AND NULLIF(base->>'volume_ml_snapshot','') IS NOT NULL
    AND (base->>'volume_ml')::numeric IS DISTINCT FROM (base->>'volume_ml_snapshot')::numeric
   THEN RAISE EXCEPTION 'FISCAL_ITEM_UNIT_SNAPSHOT_UNPROVEN' USING ERRCODE='23514'; END IF;
   content_per_unit:=coalesce(NULLIF(base->>'volume_ml','')::numeric,NULLIF(base->>'volume_ml_snapshot','')::numeric);
  END IF;
  IF content_per_unit IS NULL OR content_per_unit<=0 OR content_per_unit::text IN ('NaN','Infinity','-Infinity')
   OR content_unit NOT IN ('kg','g','ml','l') THEN RAISE EXCEPTION 'FISCAL_ITEM_UNIT_SNAPSHOT_UNPROVEN' USING ERRCODE='23514'; END IF;
  IF commercial_unit='UN' THEN
   qty:=commercial_qty; normalized_commercial:=commercial_qty*content_per_unit;
  ELSE
   normalized_commercial:=CASE commercial_unit||'>'||upper(content_unit)
    WHEN 'KG>KG' THEN commercial_qty WHEN 'KG>G' THEN commercial_qty*1000 WHEN 'G>KG' THEN commercial_qty/1000 WHEN 'G>G' THEN commercial_qty
    WHEN 'L>L' THEN commercial_qty WHEN 'L>ML' THEN commercial_qty*1000 WHEN 'ML>L' THEN commercial_qty/1000 WHEN 'ML>ML' THEN commercial_qty ELSE NULL END;
   IF normalized_commercial IS NULL THEN RAISE EXCEPTION 'FISCAL_UNIT_MISMATCH' USING ERRCODE='23514'; END IF;
   qty:=normalized_commercial/content_per_unit;
  END IF;
  IF taxable_unit='UN' THEN normalized_taxable:=taxable_qty*content_per_unit;
  ELSE normalized_taxable:=CASE taxable_unit||'>'||upper(content_unit)
   WHEN 'KG>KG' THEN taxable_qty WHEN 'KG>G' THEN taxable_qty*1000 WHEN 'G>KG' THEN taxable_qty/1000 WHEN 'G>G' THEN taxable_qty
   WHEN 'L>L' THEN taxable_qty WHEN 'L>ML' THEN taxable_qty*1000 WHEN 'ML>L' THEN taxable_qty/1000 WHEN 'ML>ML' THEN taxable_qty ELSE NULL END;
  END IF;
  IF normalized_taxable IS NULL THEN RAISE EXCEPTION 'FISCAL_UNIT_MISMATCH' USING ERRCODE='23514'; END IF;
  IF normalized_commercial IS DISTINCT FROM normalized_taxable THEN RAISE EXCEPTION 'FISCAL_QUANTITY_UNIT_DIVERGENCE' USING ERRCODE='23514'; END IF;
  IF wholepack AND qty<>trunc(qty) THEN RAISE EXCEPTION 'FISCAL_WHOLE_PACKAGE_FRACTION' USING ERRCODE='23514'; END IF;
  IF qty<=0 OR qty::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'FISCAL_ITEMS_INVALID' USING ERRCODE='23514'; END IF;
  -- Item monetary base is the immutable order snapshot, never callback price.
  IF NOT EXISTS(SELECT 1 FROM public.partner_orders po CROSS JOIN LATERAL jsonb_array_elements(po.internal_economic_snapshot->'items') b WHERE po.id=d.order_id AND b->>'id'=base->>'id' AND (b->>'quantidade')::numeric=(base->>'quantidade')::numeric AND (b->>'subtotal')::numeric=(base->>'subtotal')::numeric) THEN RAISE EXCEPTION 'FISCAL_ITEM_SNAPSHOT_UNPROVEN' USING ERRCODE='23514'; END IF;
  totalqty:=(base->>'quantidade')::numeric;
  SELECT coalesce(sum((j->>'quantity')::numeric),0) INTO previous FROM platform_private.b2b_document_allocations a CROSS JOIN LATERAL jsonb_array_elements(a.item_money) j WHERE a.order_id=d.order_id AND j->>'item_id'=it->>'item_id' AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=a.document_id);
  IF previous+qty>totalqty THEN RAISE EXCEPTION 'FISCAL_QUANTITY_OVERALLOCATED' USING ERRCODE='PT409'; END IF;
  item_net:=(base->>'subtotal')::numeric;
  -- Financing distribution is cumulative; final item absorbs cent residual deterministically.
  SELECT round(s.financed_interest*sum(i.subtotal)/s.principal,2)-round(s.financed_interest*(sum(i.subtotal)-item_net)/s.principal,2) INTO item_financing FROM public.partner_order_items i WHERE i.order_id=d.order_id AND i.id<=(base->>'id')::uuid;
  -- Quantity alone cannot reconstruct cents after a middle reversal. Retain
  -- each item's money append-only and reconcile the ACTIVE monetary ledger.
  IF EXISTS(SELECT 1 FROM platform_private.b2b_document_allocations a CROSS JOIN LATERAL jsonb_array_elements(a.items) j
   WHERE a.order_id=d.order_id AND j->>'item_id'=it->>'item_id'
   AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=a.document_id)
   AND (SELECT count(*) FROM jsonb_array_elements(a.item_money) m WHERE m->>'item_id'=it->>'item_id')<>1)
  THEN RAISE EXCEPTION 'FISCAL_ITEM_MONEY_UNPROVEN' USING ERRCODE='23514'; END IF;
  SELECT coalesce(sum((m->>'principal')::numeric),0),coalesce(sum((m->>'financed_interest')::numeric),0)
   INTO active_pr,active_intr FROM platform_private.b2b_document_allocations a CROSS JOIN LATERAL jsonb_array_elements(a.item_money) m
   WHERE a.order_id=d.order_id AND m->>'item_id'=it->>'item_id' AND NOT EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=a.document_id);
  IF active_pr<0 OR active_pr>item_net OR active_intr<0 OR active_intr>item_financing THEN RAISE EXCEPTION 'FISCAL_ITEM_MONEY_UNPROVEN' USING ERRCODE='23514'; END IF;
  pr:=CASE WHEN previous+qty=totalqty THEN item_net-active_pr ELSE least(item_net-active_pr,round(item_net*(previous+qty)/totalqty,2)-round(item_net*previous/totalqty,2)) END;
  intr:=CASE WHEN previous+qty=totalqty THEN item_financing-active_intr ELSE least(item_financing-active_intr,round(item_financing*(previous+qty)/totalqty,2)-round(item_financing*previous/totalqty,2)) END;
  principal:=principal+pr; financing:=financing+intr; accepted:=accepted||jsonb_build_array(jsonb_build_object('item_id',it->>'item_id','quantity',qty,'order_quantity',qty,'normalized_quantity',normalized_commercial,'normalized_unit',content_unit,'commercial_quantity',commercial_qty,'commercial_unit',commercial_unit,'taxable_quantity',taxable_qty,'taxable_unit',taxable_unit,'whole_package',wholepack,'principal',pr,'financed_interest',intr));
 END LOOP;
 final:=principal+financing;
 IF principal<=0 OR final>platform_private.b2b_order_residual(d.order_id) THEN RAISE EXCEPTION 'FISCAL_AMOUNT_OVERALLOCATED' USING ERRCODE='PT409'; END IF;
 cal:=platform_private.price_pinned_calendar();
 rows:=platform_private.b4_schedule_from_nf(principal,(s.condition->>'monthly_rate')::numeric,(s.condition->>'installment_count')::int,d.issue_date,(s.choice->>'payment_deadline_days')::int,cal);
 -- Keep accepted order financing, even on partial documents: allocate breakdown cumulatively,
 -- not a new interest contract. Due dates use issue date of THIS authorized document.
 WITH r AS (SELECT j, (j->>'installment_number')::int n FROM jsonb_array_elements(rows) j), weights AS (
 SELECT r.n,r.j,sum((o->>'principal_amount')::numeric) OVER(ORDER BY r.n) cp,
 sum((o->>'interest_amount')::numeric) OVER(ORDER BY r.n) cf,(o->>'principal_amount')::numeric p,(o->>'interest_amount')::numeric f
 FROM r JOIN LATERAL (SELECT o FROM jsonb_array_elements(s.rows) o WHERE (o->>'installment_number')::int=r.n) original ON true), dist AS (
 SELECT n,j,round(principal*cp/s.principal,2)-round(principal*(cp-p)/s.principal,2) p,
 CASE WHEN s.financed_interest=0 THEN 0 ELSE round(financing*cf/s.financed_interest,2)-round(financing*(cf-f)/s.financed_interest,2) END f FROM weights)
 SELECT jsonb_agg(j||jsonb_build_object('amount',p+f,'principal_amount',p,'interest_amount',f) ORDER BY n) INTO rows FROM dist;
 SELECT client_id INTO customer FROM public.partner_accounts WHERE id=d.partner_id AND commercial_owner_organization_id=org;
 category:=(s.condition->>'category_id')::uuid; method_id:=(s.condition->>'payment_method_id')::uuid;
 IF customer IS NULL OR category IS NULL OR method_id IS NULL OR NOT EXISTS(SELECT 1 FROM public.financial_categories WHERE id=category AND active AND upper(btrim(type))='RECEITA') OR NOT EXISTS(SELECT 1 FROM public.payment_methods WHERE id=method_id AND active) THEN RAISE EXCEPTION 'FINANCIAL_REFS_UNPROVEN' USING ERRCODE='23514'; END IF;
 INSERT INTO platform_private.b2b_title_permits VALUES(txid_current(),u,org,tid,d.order_id,d.partner_id,customer,rows);
 INSERT INTO public.accounts_receivable(id,organization_id,origin_type,origin_id,customer_id,partner_id,description,category_id,total_amount,issue_date,first_due_date,installment_count,status,payment_method_id,created_by,b2b_document_id)
 VALUES(tid,org,'B2B_ORDER',d.order_id,customer,d.partner_id,'Documento fiscal autorizado — candidato interno',category,final,d.issue_date,(rows->0->>'due_date')::date,jsonb_array_length(rows),'OPEN',method_id,u,d.id);
 IF EXISTS(SELECT 1 FROM platform_private.b2b_title_permits WHERE transaction_id=txid_current() AND title_id=tid) THEN RAISE EXCEPTION 'B2B_TITLE_PERMIT_NOT_CONSUMED' USING ERRCODE='23514'; END IF;
 INSERT INTO platform_private.b2b_document_allocations(document_id,organization_id,order_id,partner_id,receivable_id,source_digest,principal,financed_interest,items,item_money,rows) VALUES(d.id,org,d.order_id,d.partner_id,tid,d.source_digest,principal,financing,d.items,accepted,rows);
 RETURN jsonb_build_object('success',true,'document_id',d.id,'receivable_id',tid,'principal',principal,'financed_interest',financing,'residual',platform_private.b2b_order_residual(d.order_id),'replayed',false);
END $function$;

CREATE FUNCTION platform_private.b2b_reverse_allocation(p_document uuid,p_replacement uuid DEFAULT NULL) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE x platform_private.b2b_document_allocations; org uuid; d platform_private.b2b_authorized_documents;
BEGIN
 SELECT * INTO x FROM platform_private.b2b_document_allocations WHERE document_id=p_document;
 org:=platform_private.b2b_integration_actor(x.partner_id,true); PERFORM platform_private.b2b_integration_dependencies();
 PERFORM 1 FROM public.partner_orders WHERE id=x.order_id FOR UPDATE; PERFORM platform_private.b2b_integration_actor(x.partner_id,true);
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:'||x.partner_id::text,0)); PERFORM platform_private.b2b_integration_actor(x.partner_id,true);
 IF x.organization_id IS DISTINCT FROM org THEN RAISE EXCEPTION 'B2B_TENANT_DENIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=p_document) THEN
  IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_allocation_reversals r WHERE r.document_id=p_document AND r.replacement_document_id IS NOT DISTINCT FROM p_replacement) THEN RAISE EXCEPTION 'FISCAL_REPLAY_DIVERGENCE' USING ERRCODE='PT409'; END IF;
  RETURN jsonb_build_object('success',true,'replayed',true);
 END IF;
 -- Paid or adjusted histories require independent reconciliation, never automatic cancellation.
 PERFORM 1 FROM public.accounts_receivable_installments WHERE receivable_id=x.receivable_id ORDER BY id FOR UPDATE;
 PERFORM platform_private.b2b_integration_actor(x.partner_id,true);
 PERFORM platform_private.b2b_integration_dependencies();
 IF EXISTS(SELECT 1 FROM public.receivable_payments p JOIN public.accounts_receivable_installments i ON i.id=p.installment_id WHERE i.receivable_id=x.receivable_id) THEN RAISE EXCEPTION 'FISCAL_PAID_RECONCILIATION_REQUIRED' USING ERRCODE='PT409'; END IF;
 IF (SELECT count(*) FROM public.accounts_receivable_installments i WHERE i.receivable_id=x.receivable_id)<>jsonb_array_length(x.rows)
 OR NOT EXISTS(SELECT 1 FROM public.accounts_receivable a WHERE a.id=x.receivable_id AND a.status='OPEN' AND a.b2b_document_id=x.document_id AND a.total_amount=x.principal+x.financed_interest)
 OR EXISTS(SELECT 1 FROM public.accounts_receivable_installments i WHERE i.receivable_id=x.receivable_id AND
 (i.status<>'OPEN' OR i.received_amount IS DISTINCT FROM 0::numeric OR i.interest_amount IS DISTINCT FROM 0::numeric OR i.penalty_amount IS DISTINCT FROM 0::numeric OR i.discount_amount IS DISTINCT FROM 0::numeric
 OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(x.rows) r WHERE (r->>'installment_number')::int=i.installment_number AND (r->>'amount')::numeric=i.original_amount AND (r->>'due_date')::date=i.due_date)))
 THEN RAISE EXCEPTION 'FISCAL_PAID_RECONCILIATION_REQUIRED' USING ERRCODE='PT409'; END IF;
 SELECT * INTO d FROM platform_private.b2b_authorized_documents WHERE id=p_replacement AND organization_id=org AND order_id=x.order_id AND partner_id=x.partner_id AND state='AUTHORIZED';
 IF p_replacement IS NOT NULL AND (NOT FOUND OR p_replacement=p_document OR EXISTS(SELECT 1 FROM platform_private.b2b_cancellation_attestations c WHERE c.document_id=p_replacement)) THEN RAISE EXCEPTION 'FISCAL_REPLACEMENT_INVALID' USING ERRCODE='23514'; END IF;
 -- Cancellation ingestion itself remains an unproven dependency; no buyer callback accepted.
 IF NOT EXISTS(SELECT 1 FROM platform_private.b2b_cancellation_attestations c WHERE c.document_id=p_document AND c.organization_id=org) THEN RAISE EXCEPTION 'FISCAL_CANCELLATION_UNPROVEN' USING ERRCODE='42501'; END IF;
 INSERT INTO platform_private.b2b_allocation_reversals VALUES(p_document,p_replacement,x.source_digest,now());
 UPDATE public.accounts_receivable_installments SET status='CANCELED' WHERE receivable_id=x.receivable_id;
 UPDATE public.accounts_receivable SET status='CANCELED' WHERE id=x.receivable_id;
 IF p_replacement IS NOT NULL THEN PERFORM platform_private.b2b_allocate_document(p_replacement); END IF;
 RETURN jsonb_build_object('success',true,'replayed',false);
END $$;
REVOKE ALL ON FUNCTION platform_private.b2b_order_residual(uuid),platform_private.b2b_credit_balances(uuid,uuid),platform_private.b2b_allocate_document(uuid),platform_private.b2b_reverse_allocation(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;
CREATE OR REPLACE FUNCTION public.fn_b2b_credit_exposure(p_partner_id uuid, p_new_order_amount numeric DEFAULT 0, p_exclude_order_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_settings_json jsonb;
  v_limit numeric(14,2); v_open numeric(14,2); v_overdue numeric(14,2);
  v_committed numeric(14,2); v_pending numeric(14,2);
  v_new numeric(14,2) := ROUND(COALESCE(p_new_order_amount,0),2);
  v_proj numeric(14,2); v_disp numeric(14,2); v_pct numeric;
  v_tolerance int; v_block boolean; v_action text; v_reason text;
BEGIN
  PERFORM platform_private.b2b_integration_actor(p_partner_id);
  IF p_new_order_amount IS NULL OR p_new_order_amount<0 OR p_new_order_amount::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'CREDIT_AMOUNT_INVALID' USING ERRCODE='23514'; END IF;
  IF platform_private.b2b_credit_config_block(p_partner_id) IS NOT NULL THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE='PT409'; END IF;
  SELECT COALESCE(credit_limit,0), COALESCE(overdue_tolerance_days,0),
         COALESCE(block_if_overdue,false), COALESCE(credit_limit_action,'block')
    INTO v_limit, v_tolerance, v_block, v_action
  FROM public.partner_financial_settings WHERE partner_id = p_partner_id;
  v_limit := COALESCE(v_limit,0); v_tolerance := COALESCE(v_tolerance,0);
  v_block := COALESCE(v_block,false); v_action := COALESCE(v_action,'block');

  v_settings_json:=platform_private.b2b_credit_balances(p_partner_id,p_exclude_order_id);
  v_open:=(v_settings_json->>'saldo_em_aberto')::numeric;
  v_overdue:=(v_settings_json->>'saldo_vencido')::numeric;
  v_committed:=(v_settings_json->>'comprometido_nao_faturado')::numeric;
  v_pending:=(v_settings_json->>'comprometido_pendente')::numeric;
  v_proj := ROUND(v_open + v_committed + v_pending + v_new, 2);
  v_disp := GREATEST(v_limit - v_proj, 0);
  v_pct  := CASE WHEN v_limit > 0 THEN ROUND((v_proj / v_limit) * 100, 2) ELSE 0 END;

  v_reason := CASE
    WHEN v_block AND v_overdue > 0 THEN 'OVERDUE_BLOCK'
    WHEN v_proj > v_limit AND v_action = 'approval_required' THEN 'LIMIT_EXCEEDED_APPROVAL'
    WHEN v_proj > v_limit THEN 'LIMIT_EXCEEDED_BLOCK'
    ELSE 'OK' END;

  RETURN jsonb_build_object(
    'partner_id', p_partner_id,
    'credit_limit', v_limit,
    'saldo_em_aberto', v_open,
    'saldo_vencido', v_overdue,
    'comprometido_nao_faturado', v_committed,
    'comprometido_pendente', v_pending,
    'novo_pedido', v_new,
    'exposicao_atual', ROUND(v_open + v_committed + v_pending, 2),
    'exposicao_projetada', v_proj,
    'credito_disponivel', v_disp,
    'percentual_utilizado', v_pct,
    'overdue_tolerance_days', v_tolerance,
    'block_if_overdue', v_block,
    'credit_limit_action', v_action,
    'tem_vencidos', v_overdue > 0,
    'reason_code', v_reason
  );
END $function$;
CREATE OR REPLACE FUNCTION public.rpc_register_receivable_payment(p_installment_id uuid, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_proven jsonb; v_origin public.accounts_receivable%ROWTYPE; v_interest numeric; v_financed numeric; v_debtor uuid;
  v_uid uuid := auth.uid();
  v_org uuid := platform_private.h15_actor_organization();
  v_inst public.accounts_receivable_installments%ROWTYPE;
  v_amount numeric; v_disc numeric; v_int numeric; v_pen numeric; v_saldo numeric;
  v_pm uuid; v_ba uuid; v_pay_date date; v_notes text;
  v_has_receipt boolean; v_require_receipt boolean;
  v_payment_id uuid; v_idem text; v_fp text; v_existing record;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'Sessão inválida.' USING ERRCODE='insufficient_privilege';
  END IF;
  IF NOT public.is_financial_staff(v_uid) THEN
    RAISE EXCEPTION 'Sem permissão para registrar recebimento.' USING ERRCODE='insufficient_privilege';
  END IF;

  -- H6-001: idempotency_key obrigatoria (fail-closed)
  IF v_org IS NULL OR NOT EXISTS (SELECT 1 FROM public.accounts_receivable_installments WHERE id=p_installment_id AND organization_id=v_org) THEN
    RAISE EXCEPTION 'FINANCIAL_SCOPE_DENIED' USING ERRCODE='42501';
  END IF;
  IF (p_payload ? 'organization_id' AND NULLIF(p_payload->>'organization_id','')::uuid IS DISTINCT FROM v_org)
     OR (p_payload ? 'tenant_id' AND NULLIF(p_payload->>'tenant_id','')::uuid IS DISTINCT FROM v_org) THEN
    RAISE EXCEPTION 'FINANCIAL_TENANT_MISMATCH' USING ERRCODE='42501';
  END IF;
  v_idem := NULLIF(trim(p_payload->>'idempotency_key'), '');
  IF v_idem IS NULL OR length(v_idem) < 8 THEN
    RAISE EXCEPTION 'FIN_IDEMPOTENCY_REQUIRED: idempotency_key obrigatória (mín. 8 caracteres).'
      USING ERRCODE='check_violation';
  END IF;

  v_fp := public.fn_h6b_payment_fingerprint('receivable', p_installment_id, p_payload);

  -- lock determinístico por tipo + parcela + chave, ANTES da decisao de replay
  PERFORM pg_advisory_xact_lock(
    hashtextextended('fin_pay:receivable:' || p_installment_id::text || ':' || v_idem, 0));

  SELECT * INTO v_inst FROM public.accounts_receivable_installments
   WHERE id = p_installment_id AND organization_id=v_org FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Parcela não encontrada.'; END IF;

  IF auth.uid() IS DISTINCT FROM v_uid OR public.h15_actor_organization() IS DISTINCT FROM v_org OR public.is_financial_staff(v_uid) IS NOT TRUE THEN RAISE EXCEPTION 'FINANCIAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  SELECT * INTO v_origin FROM public.accounts_receivable WHERE id=v_inst.receivable_id AND organization_id=v_org;
  IF NOT FOUND THEN RAISE EXCEPTION 'FINANCIAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  v_debtor:=platform_private.b2b_receivable_partner_scope(v_origin.id);
  IF v_origin.origin_type='B2B_ORDER' OR v_debtor IS NOT NULL THEN
   SELECT r INTO v_proven FROM jsonb_array_elements(public.rpc_receivable_money_projection_v1(v_inst.receivable_id,0,1000)) r WHERE r->>'id'=v_inst.id::text;
   IF v_proven IS NULL THEN RAISE EXCEPTION 'MONEY_ORIGIN_UNPROVEN' USING ERRCODE='23514'; END IF;
   v_interest:=(v_proven->>'interest_amount')::numeric;
   v_financed:=(v_proven->>'financed_interest_amount')::numeric;
  ELSE
   -- Caminho capturado para MANUAL não B2B sem parceiro; não é prova de origem B4.
   v_interest:=v_inst.interest_amount; v_financed:=0;
  END IF;
  SELECT id, request_fingerprint INTO v_existing FROM public.receivable_payments
   WHERE installment_id = p_installment_id AND idempotency_key = v_idem;
  IF v_existing.id IS NOT NULL THEN
    IF v_existing.request_fingerprint IS NOT NULL AND v_existing.request_fingerprint <> v_fp THEN
      RAISE EXCEPTION 'FIN_IDEMPOTENCY_CONFLICT: mesma idempotency_key com payload divergente.'
        USING ERRCODE='check_violation';
    END IF;
    RETURN v_existing.id;
  END IF;

  IF v_inst.status = 'CANCELED' THEN
    RAISE EXCEPTION 'Parcela cancelada.' USING ERRCODE='check_violation';
  END IF;
  IF v_inst.status = 'PAID' THEN
    RAISE EXCEPTION 'Parcela já quitada.' USING ERRCODE='check_violation';
  END IF;

  v_amount   := COALESCE((p_payload->>'amount_received')::numeric, 0);
  v_disc     := COALESCE((p_payload->>'discount_amount')::numeric, 0);
  v_int      := COALESCE((p_payload->>'interest_amount')::numeric, 0);
  v_pen      := COALESCE((p_payload->>'penalty_amount')::numeric, 0);
  v_pm       := NULLIF(p_payload->>'payment_method_id','')::uuid;
  v_ba       := NULLIF(p_payload->>'bank_account_id','')::uuid;
  v_pay_date := COALESCE((p_payload->>'payment_date')::date, (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date);
  v_notes    := NULLIF(p_payload->>'notes','');
  v_has_receipt := COALESCE((p_payload->>'has_receipt')::boolean, false);

  IF v_amount::text IN ('NaN','Infinity','-Infinity') OR v_disc::text IN ('NaN','Infinity','-Infinity') OR v_int::text IN ('NaN','Infinity','-Infinity') OR v_pen::text IN ('NaN','Infinity','-Infinity') OR v_disc < 0 OR v_int < 0 OR v_pen < 0 OR v_amount <> round(v_amount,2) OR v_disc <> round(v_disc,2) OR v_int <> round(v_int,2) OR v_pen <> round(v_pen,2) THEN
 RAISE EXCEPTION 'FIN_INVALID_AMOUNT: valores monetários inválidos.' USING ERRCODE='23514';
 END IF;
 IF v_amount <= 0 THEN
    RAISE EXCEPTION 'Valor inválido.' USING ERRCODE='check_violation';
  END IF;
  IF v_pm IS NULL OR NOT EXISTS (SELECT 1 FROM public.payment_methods WHERE id = v_pm AND active) THEN
    RAISE EXCEPTION 'Forma de pagamento inválida ou inativa.' USING ERRCODE='check_violation';
  END IF;
  IF v_ba IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.bank_accounts WHERE id = v_ba AND active) THEN
    RAISE EXCEPTION 'Conta bancária inválida ou inativa.' USING ERRCODE='check_violation';
  END IF;

  v_saldo := v_inst.original_amount + (v_interest-v_financed) + COALESCE(v_inst.penalty_amount,0) - COALESCE(v_inst.discount_amount,0) - COALESCE(v_inst.received_amount,0) + v_int + v_pen - v_disc;
  IF v_amount - v_saldo > 0.005 THEN
    RAISE EXCEPTION 'Valor excede o saldo da parcela (saldo: %).', v_saldo USING ERRCODE='check_violation';
  END IF;

  SELECT require_receipt_on_receivable_payment INTO v_require_receipt
    FROM public.financial_settings LIMIT 1;
  IF COALESCE(v_require_receipt,false) AND NOT v_has_receipt THEN
    RAISE EXCEPTION 'Comprovante de recebimento é obrigatório.' USING ERRCODE='check_violation';
  END IF;

  BEGIN
    INSERT INTO public.receivable_payments (
      organization_id, installment_id, payment_date, amount_received, payment_method_id, bank_account_id,
      discount_amount, interest_amount, penalty_amount, notes, created_by,
      idempotency_key, request_fingerprint
    ) VALUES (
      v_org, p_installment_id, v_pay_date, v_amount, v_pm, v_ba,
      v_disc, v_int, v_pen, v_notes, v_uid, v_idem, v_fp
    ) RETURNING id INTO v_payment_id;
  EXCEPTION WHEN unique_violation THEN
    SELECT id, request_fingerprint INTO v_existing FROM public.receivable_payments
     WHERE installment_id = p_installment_id AND idempotency_key = v_idem;
    IF v_existing.request_fingerprint IS NOT NULL AND v_existing.request_fingerprint <> v_fp THEN
      RAISE EXCEPTION 'FIN_IDEMPOTENCY_CONFLICT: mesma idempotency_key com payload divergente.'
        USING ERRCODE='check_violation';
    END IF;
    RETURN v_existing.id;
  END;

  INSERT INTO public.financial_audit_log (entity_type, entity_id, action, new_data, performed_by)
  VALUES ('receivable_payments', v_payment_id, 'PAYMENT_REGISTERED',
    jsonb_build_object('installment_id', p_installment_id, 'amount', v_amount,
      'payment_method_id', v_pm, 'bank_account_id', v_ba, 'payment_date', v_pay_date,
      'idempotency_key', v_idem, 'request_fingerprint', v_fp), v_uid);

  RETURN v_payment_id;
END $function$;
CREATE OR REPLACE FUNCTION public.fn_generate_receivable_installments()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  i int;
  v_context platform_private.financial_initial_installments;
  v_inst jsonb;
  v_fiscal platform_private.b2b_title_permits;
  v_qtd int := NEW.installment_count;
  v_base numeric(14,2) := ROUND(NEW.total_amount / v_qtd, 2);
  v_acc numeric(14,2) := 0;
  v_amt numeric(14,2);
BEGIN
  IF NEW.organization_id IS NULL THEN
    RAISE EXCEPTION 'FINANCIAL_TENANT_REQUIRED' USING ERRCODE = '23514';
  END IF;
  DELETE FROM platform_private.b2b_title_permits WHERE transaction_id=txid_current() AND title_id=NEW.id RETURNING * INTO v_fiscal;
  IF FOUND THEN
    IF NEW.origin_type<>'B2B_ORDER' OR NEW.origin_id IS DISTINCT FROM v_fiscal.order_id OR NEW.organization_id IS DISTINCT FROM v_fiscal.organization_id OR auth.uid() IS DISTINCT FROM v_fiscal.actor_id THEN RAISE EXCEPTION 'B2B_GENERATOR_PERMIT_INVALID' USING ERRCODE='42501'; END IF;
    PERFORM platform_private.b2b_integration_actor(v_fiscal.partner_id,true);
    FOR v_inst IN SELECT r FROM jsonb_array_elements(v_fiscal.rows) r LOOP
      INSERT INTO public.accounts_receivable_installments(organization_id,receivable_id,installment_number,due_date,original_amount,net_amount,status) VALUES(NEW.organization_id,NEW.id,(v_inst->>'installment_number')::int,(v_inst->>'due_date')::date,(v_inst->>'amount')::numeric,(v_inst->>'amount')::numeric,'OPEN');
    END LOOP;
    RETURN NEW;
  END IF;
  IF NEW.origin_type='B2B_ORDER' THEN RAISE EXCEPTION 'B2B_GENERATOR_PERMIT_REQUIRED' USING ERRCODE='42501'; END IF;
  DELETE FROM platform_private.financial_initial_installments
    WHERE transaction_id=txid_current() AND title_id=NEW.id AND kind='receivable'
    RETURNING * INTO v_context;
  IF FOUND THEN
    IF v_context.actor_id IS DISTINCT FROM auth.uid() OR v_context.organization_id IS DISTINCT FROM NEW.organization_id
       OR NEW.created_by IS DISTINCT FROM v_context.actor_id OR NEW.origin_type <> 'MANUAL'
       OR platform_private.h15_actor_organization() IS DISTINCT FROM NEW.organization_id
       OR NOT public.is_financial_staff(auth.uid()) THEN
      RAISE EXCEPTION 'FIN_INITIAL_CONTEXT_DENIED' USING ERRCODE='42501';
    END IF;
    IF jsonb_array_length(v_context.installments) <> NEW.installment_count
       OR (SELECT sum((x->>'amount')::numeric) FROM jsonb_array_elements(v_context.installments) x) IS DISTINCT FROM NEW.total_amount THEN
      RAISE EXCEPTION 'FIN_TITLE_INVALID_SUM' USING ERRCODE='23514';
    END IF;
    FOR v_inst IN SELECT * FROM jsonb_array_elements(v_context.installments) LOOP
      INSERT INTO public.accounts_receivable_installments(organization_id,receivable_id,installment_number,due_date,original_amount,net_amount,status)
        VALUES(NEW.organization_id,NEW.id,(v_inst->>'installment_number')::int,(v_inst->>'due_date')::date,
          (v_inst->>'amount')::numeric,(v_inst->>'amount')::numeric,'OPEN');
    END LOOP;
    RETURN NEW;
  END IF;
  FOR i IN 1..v_qtd LOOP
    IF i < v_qtd THEN
      v_amt := v_base;
      v_acc := v_acc + v_amt;
    ELSE
      v_amt := NEW.total_amount - v_acc;
    END IF;
    INSERT INTO public.accounts_receivable_installments
      (receivable_id, installment_number, due_date, original_amount, net_amount, status, organization_id)
    VALUES
      (NEW.id, i, (NEW.first_due_date + ((i-1) || ' months')::interval)::date, v_amt, v_amt, 'OPEN', NEW.organization_id);
  END LOOP;
  RETURN NEW;
END
$function$
;

CREATE OR REPLACE FUNCTION platform_private.b2b_shared_receivable_credit_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_p uuid[]; v_partner uuid; v jsonb; v_delta numeric(14,2); v_po_id uuid; v_po record; v_cfg text;
BEGIN
  IF EXISTS(SELECT 1 FROM platform_private.b2b_title_permits p WHERE p.transaction_id=txid_current() AND p.title_id=NEW.id) THEN
    PERFORM platform_private.b2b_integration_actor(NEW.partner_id,true);
    IF NEW.total_amount>platform_private.b2b_order_residual(NEW.origin_id) THEN RAISE EXCEPTION 'CREDIT_OVERALLOCATED' USING ERRCODE='PT409'; END IF;
    RETURN NEW;
  END IF;
  IF NEW.customer_id IS NULL AND NEW.origin_type IS DISTINCT FROM 'B2B_ORDER' THEN RETURN NEW; END IF;
  IF NEW.organization_id IS NULL THEN RAISE EXCEPTION 'CREDIT_TENANT_REQUIRED' USING ERRCODE = '42501'; END IF;
  v_p := platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id);
  IF cardinality(v_p) > 1 THEN RAISE EXCEPTION 'CREDIT_PARTNER_LINK_AMBIGUOUS' USING ERRCODE = '42501'; END IF;
  v_partner := v_p[1];
  -- Order-linked origins are never trusted from the row: the order must exist server-side, belong to
  -- the resolved/declared partner, and its amount is netted only while it is still counted as committed.
  IF NEW.origin_type = 'B2B_ORDER' THEN
    v_po_id := NEW.origin_id;
    IF v_po_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id = v_po_id) THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_UNPROVEN' USING ERRCODE = '23514';
    END IF;
  ELSIF NEW.origin_type = 'DELIVERY' AND NEW.origin_id IS NOT NULL THEN
    SELECT e.partner_order_id INTO v_po_id FROM public.entregas e WHERE e.id = NEW.origin_id;
  END IF;
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id FOR UPDATE;  -- order row before b2b_credit
    IF v_partner IS NULL AND NEW.origin_type = 'B2B_ORDER' THEN v_partner := v_po.partner_id; END IF;
    IF v_po.partner_id IS NULL OR v_po.partner_id IS DISTINCT FROM v_partner THEN
      RAISE EXCEPTION 'CREDIT_ORDER_PARTNER_MISMATCH' USING ERRCODE = '23514';
    END IF;
    IF NEW.origin_type = 'B2B_ORDER' AND EXISTS (SELECT 1 FROM public.accounts_receivable ar WHERE ar.origin_type = 'B2B_ORDER'
         AND ar.origin_id = v_po_id AND ar.status <> 'CANCELED') THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_ALREADY_BILLED' USING ERRCODE = 'PT409';
    END IF;
  END IF;
  IF v_partner IS NULL THEN RETURN NEW; END IF;  -- not a partner debtor of this tenant: untouched
  IF NEW.partner_id IS NOT NULL AND NEW.partner_id IS DISTINCT FROM v_partner THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE = '23514';
  END IF;
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'CREDIT_ISOLATION_UNSUPPORTED' USING ERRCODE = '0A000';  -- stale snapshot after wait
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || v_partner::text, 0));
  -- Fresh statement snapshots from here on (READ COMMITTED): re-resolve the link after any wait.
  IF platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id) IS DISTINCT FROM v_p THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';  -- unlinked/relinked/transferred while waiting
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_accounts pa WHERE pa.id = v_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
                  AND pa.commercial_owner_organization_id = NEW.organization_id) THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';
  END IF;
  v_cfg := platform_private.b2b_credit_config_block(v_partner);
  IF v_cfg = 'configuracao_financeira_inativa' THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INACTIVE' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg = 'limite_nao_definido' THEN RAISE EXCEPTION 'CREDIT_NO_LIMIT_DEFINED' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg IS NOT NULL THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE = 'PT409'; END IF;
  v := public.fn_b2b_credit_exposure(v_partner, 0, NULL);
  IF (v->>'block_if_overdue')::boolean AND (v->>'tem_vencidos')::boolean THEN
    RAISE EXCEPTION 'CREDIT_OVERDUE_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  v_delta := round(NEW.total_amount, 2);
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id;
    IF COALESCE(v_po.receivable_generated, false) = false
       AND v_po.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue',
                           'pendente','solicitado','em_analise_comercial','aguardando_aprovacao_credito','aguardando_ajuste_comercial','aguardando_itens')
       AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id = v_po_id) THEN
      v_delta := v_delta - round(COALESCE(v_po.final_amount_with_interest, v_po.total, 0), 2);
    END IF;
  END IF;
  -- A title that does not increase exposure (conversion/delivery of an already counted, possibly
  -- credit-approved order) is never refused for limit; any increase must fit.
  IF v_delta > 0 AND (v->>'exposicao_atual')::numeric + v_delta > (v->>'credit_limit')::numeric THEN
    IF v->>'credit_limit_action' = 'approval_required' THEN
      RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_APPROVAL' USING ERRCODE = 'PT409';
    END IF;
    RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  NEW.partner_id := v_partner;  -- canonical exposure sees the title afterwards (no second ledger)
  RETURN NEW;
END $$;
CREATE OR REPLACE FUNCTION platform_private.b2b_shared_receivable_credit_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_p uuid[]; v_partner uuid; v jsonb; v_delta numeric(14,2); v_po_id uuid; v_po record; v_cfg text;
BEGIN
  IF EXISTS(SELECT 1 FROM platform_private.b2b_title_permits p WHERE p.transaction_id=txid_current() AND p.title_id=NEW.id) THEN
    PERFORM platform_private.b2b_integration_actor(NEW.partner_id,true);
    IF NEW.total_amount>platform_private.b2b_order_residual(NEW.origin_id) THEN RAISE EXCEPTION 'CREDIT_OVERALLOCATED' USING ERRCODE='PT409'; END IF;
    RETURN NEW;
  END IF;
  IF NEW.customer_id IS NULL AND NEW.origin_type IS DISTINCT FROM 'B2B_ORDER' THEN RETURN NEW; END IF;
  IF NEW.organization_id IS NULL THEN RAISE EXCEPTION 'CREDIT_TENANT_REQUIRED' USING ERRCODE = '42501'; END IF;
  v_p := platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id);
  IF cardinality(v_p) > 1 THEN RAISE EXCEPTION 'CREDIT_PARTNER_LINK_AMBIGUOUS' USING ERRCODE = '42501'; END IF;
  v_partner := v_p[1];
  -- Order-linked origins are never trusted from the row: the order must exist server-side, belong to
  -- the resolved/declared partner, and its amount is netted only while it is still counted as committed.
  IF NEW.origin_type = 'B2B_ORDER' THEN
    v_po_id := NEW.origin_id;
    IF v_po_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_orders po WHERE po.id = v_po_id) THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_UNPROVEN' USING ERRCODE = '23514';
    END IF;
  ELSIF NEW.origin_type = 'DELIVERY' AND NEW.origin_id IS NOT NULL THEN
    SELECT e.partner_order_id INTO v_po_id FROM public.entregas e WHERE e.id = NEW.origin_id;
  END IF;
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id FOR UPDATE;  -- order row before b2b_credit
    IF v_partner IS NULL AND NEW.origin_type = 'B2B_ORDER' THEN v_partner := v_po.partner_id; END IF;
    IF v_po.partner_id IS NULL OR v_po.partner_id IS DISTINCT FROM v_partner THEN
      RAISE EXCEPTION 'CREDIT_ORDER_PARTNER_MISMATCH' USING ERRCODE = '23514';
    END IF;
    IF NEW.origin_type = 'B2B_ORDER' AND EXISTS (SELECT 1 FROM public.accounts_receivable ar WHERE ar.origin_type = 'B2B_ORDER'
         AND ar.origin_id = v_po_id AND ar.status <> 'CANCELED') THEN
      RAISE EXCEPTION 'CREDIT_B2B_ORIGIN_ALREADY_BILLED' USING ERRCODE = 'PT409';
    END IF;
  END IF;
  IF v_partner IS NULL THEN RETURN NEW; END IF;  -- not a partner debtor of this tenant: untouched
  IF NEW.partner_id IS NOT NULL AND NEW.partner_id IS DISTINCT FROM v_partner THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE = '23514';
  END IF;
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'CREDIT_ISOLATION_UNSUPPORTED' USING ERRCODE = '0A000';  -- stale snapshot after wait
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || v_partner::text, 0));
  -- Fresh statement snapshots from here on (READ COMMITTED): re-resolve the link after any wait.
  IF platform_private.b2b_debtor_partner(NEW.organization_id, NEW.customer_id) IS DISTINCT FROM v_p THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';  -- unlinked/relinked/transferred while waiting
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_accounts pa WHERE pa.id = v_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
                  AND pa.commercial_owner_organization_id = NEW.organization_id) THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_LINK_CHANGED' USING ERRCODE = 'PT409';
  END IF;
  v_cfg := platform_private.b2b_credit_config_block(v_partner);
  IF v_cfg = 'configuracao_financeira_inativa' THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INACTIVE' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg = 'limite_nao_definido' THEN RAISE EXCEPTION 'CREDIT_NO_LIMIT_DEFINED' USING ERRCODE = 'PT409'; END IF;
  IF v_cfg IS NOT NULL THEN RAISE EXCEPTION 'CREDIT_SETTINGS_INCOMPLETE' USING ERRCODE = 'PT409'; END IF;
  v := public.fn_b2b_credit_exposure(v_partner, 0, NULL);
  IF (v->>'block_if_overdue')::boolean AND (v->>'tem_vencidos')::boolean THEN
    RAISE EXCEPTION 'CREDIT_OVERDUE_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  v_delta := round(NEW.total_amount, 2);
  IF v_po_id IS NOT NULL THEN
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id;
    IF COALESCE(v_po.receivable_generated, false) = false
       AND v_po.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue',
                           'pendente','solicitado','em_analise_comercial','aguardando_aprovacao_credito','aguardando_ajuste_comercial','aguardando_itens')
       AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id = v_po_id) THEN
      v_delta := v_delta - round(COALESCE(v_po.final_amount_with_interest, v_po.total, 0), 2);
    END IF;
  END IF;
  -- A title that does not increase exposure (conversion/delivery of an already counted, possibly
  -- credit-approved order) is never refused for limit; any increase must fit.
  IF v_delta > 0 AND (v->>'exposicao_atual')::numeric + v_delta > (v->>'credit_limit')::numeric THEN
    IF v->>'credit_limit_action' = 'approval_required' THEN
      RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_APPROVAL' USING ERRCODE = 'PT409';
    END IF;
    RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  NEW.partner_id := v_partner;  -- canonical exposure sees the title afterwards (no second ledger)
  RETURN NEW;
END $$;
CREATE TRIGGER zz_b2b_shared_credit_guard BEFORE INSERT ON public.accounts_receivable FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_shared_receivable_credit_guard();

CREATE FUNCTION platform_private.b2b_title_insert_fence() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE p platform_private.b2b_title_permits;
BEGIN
 IF TG_OP='UPDATE' THEN
  IF (OLD.origin_type IN ('B2B_ORDER','DELIVERY') OR NEW.origin_type IN ('B2B_ORDER','DELIVERY') OR OLD.b2b_document_id IS NOT NULL OR NEW.b2b_document_id IS NOT NULL)
  AND (OLD.organization_id,OLD.origin_type,OLD.origin_id,OLD.partner_id,OLD.customer_id,OLD.b2b_document_id) IS DISTINCT FROM (NEW.organization_id,NEW.origin_type,NEW.origin_id,NEW.partner_id,NEW.customer_id,NEW.b2b_document_id)
  THEN RAISE EXCEPTION 'B2B_TITLE_IDENTITY_IMMUTABLE' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 IF NEW.origin_type='B2B_ORDER' OR (NEW.origin_type='DELIVERY' AND EXISTS(SELECT 1 FROM public.entregas e WHERE e.id=NEW.origin_id AND e.partner_order_id IS NOT NULL)) THEN
  SELECT * INTO p FROM platform_private.b2b_title_permits WHERE transaction_id=txid_current() AND title_id=NEW.id;
  IF NOT FOUND OR p.actor_id IS DISTINCT FROM auth.uid() OR p.organization_id IS DISTINCT FROM public.h15_actor_organization()
  OR NEW.organization_id IS DISTINCT FROM p.organization_id OR NEW.origin_type<>'B2B_ORDER' OR NEW.origin_id IS DISTINCT FROM p.order_id
  OR NEW.partner_id IS DISTINCT FROM p.partner_id OR NEW.customer_id IS DISTINCT FROM p.customer_id
  OR NOT EXISTS(SELECT 1 FROM platform_private.b2b_authorized_documents d WHERE d.id=NEW.b2b_document_id AND d.order_id=p.order_id AND d.organization_id=p.organization_id AND d.partner_id=p.partner_id AND d.state='AUTHORIZED')
  OR NEW.total_amount IS DISTINCT FROM (SELECT sum((r->>'amount')::numeric) FROM jsonb_array_elements(p.rows) r)
  THEN RAISE EXCEPTION 'B2B_FISCAL_ONE_SHOT_PERMIT_REQUIRED' USING ERRCODE='42501'; END IF;
  PERFORM platform_private.b2b_integration_actor(p.partner_id,true);
 END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER a01_b2b_fiscal_title_fence BEFORE INSERT ON public.accounts_receivable FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_title_insert_fence();
CREATE TRIGGER a01_b2b_fiscal_title_identity BEFORE UPDATE ON public.accounts_receivable FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_title_insert_fence();
-- Serialize private cancellation attestation with fiscal allocation, including cancel-before-title.
CREATE FUNCTION platform_private.b2b_cancellation_fence() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE d platform_private.b2b_authorized_documents; org uuid;
BEGIN
 SELECT * INTO d FROM platform_private.b2b_authorized_documents WHERE id=NEW.document_id;
 org:=platform_private.b2b_integration_actor(d.partner_id,true);PERFORM platform_private.b2b_integration_dependencies();
 PERFORM 1 FROM public.partner_orders WHERE id=d.order_id FOR UPDATE;PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:'||d.partner_id::text,0));PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM 1 FROM platform_private.b2b_authorized_documents WHERE id=d.id FOR SHARE;PERFORM platform_private.b2b_integration_actor(d.partner_id,true);
 PERFORM platform_private.b2b_integration_dependencies();
 IF NEW.organization_id IS DISTINCT FROM org OR d.organization_id IS DISTINCT FROM org THEN RAISE EXCEPTION 'B2B_TENANT_DENIED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER cancellation_scope_lock BEFORE INSERT ON platform_private.b2b_cancellation_attestations FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_cancellation_fence();
REVOKE ALL ON FUNCTION platform_private.b2b_cancellation_fence() FROM PUBLIC,anon,authenticated,service_role;

-- Approval/delivery/production cannot call the old integral generator in parallel.
CREATE OR REPLACE FUNCTION public.tg_auto_b2b_receivable()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ BEGIN RETURN NEW; END $function$;
CREATE OR REPLACE FUNCTION public.generate_b2b_receivable_secure_impl(p_partner_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ BEGIN RAISE EXCEPTION 'B2B_AUTHORIZED_FISCAL_DOCUMENT_REQUIRED' USING ERRCODE='42501'; END $function$;

REVOKE ALL ON FUNCTION platform_private.b2b_title_insert_fence(),public.generate_b2b_receivable_secure_impl(uuid),public.tg_auto_b2b_receivable() FROM PUBLIC,anon,authenticated,service_role;

-- Captured broad internal-own-finance reader requires a separate owner-only 1:N review;
-- current own-obligation reader stays closed rather than returning incomplete legacy results.
REVOKE ALL ON FUNCTION platform_private.b2b_own_obligations(uuid,timestamptz,uuid) FROM PUBLIC,anon,authenticated,service_role;

