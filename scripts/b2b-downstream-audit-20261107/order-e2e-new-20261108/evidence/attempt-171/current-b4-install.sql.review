 IF to_regclass('platform_private.b2b_cancellation_attestations') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='cancellation_scope_lock' AND tgrelid=to_regclass('platform_private.b2b_cancellation_attestations') AND NOT tgisinternal) THEN RAISE EXCEPTION 'B4_PRE_UNEXPECTED_EXISTING_TRIGGER:platform_private.b2b_cancellation_attestations.cancellation_scope_lock' USING ERRCODE='42501'; END IF;
