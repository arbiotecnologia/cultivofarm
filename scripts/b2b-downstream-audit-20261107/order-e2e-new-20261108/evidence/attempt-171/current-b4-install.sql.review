DO $guard$ DECLARE d record; BEGIN
 FOR d IN SELECT * FROM (VALUES ('public.fn_b2b_credit_exposure(uuid,numeric,uuid)','44e8768ff53d7fe5ff3b9f0889258946','postgres','578c00048ab38c285e229e11ff6211ec'),('public.fn_generate_receivable_installments()','4fa47b35665c13d3c9f0ce15262dd98c','postgres','578c00048ab38c285e229e11ff6211ec'),('public.rpc_register_receivable_payment(uuid,jsonb)','db0ef1369e8a98630afb98368d391678','postgres','04e771375e06113da45adc7fa45d56af')) x(sig,body_md5,owner,acl_md5) LOOP
