 IF to_regclass('public.accounts_receivable') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='zz_b2b_shared_credit_guard' AND tgrelid=to_regclass('public.accounts_receivable') AND NOT tgisinternal) THEN RAISE EXCEPTION 'B4_PRE_UNEXPECTED_EXISTING_TRIGGER:public.accounts_receivable.zz_b2b_shared_credit_guard' USING ERRCODE='42501'; END IF;
 IF to_regclass('public.accounts_receivable') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='a01_b2b_fiscal_title_fence' AND tgrelid=to_regclass('public.accounts_receivable') AND NOT tgisinternal) THEN RAISE EXCEPTION 'B4_PRE_UNEXPECTED_EXISTING_TRIGGER:public.accounts_receivable.a01_b2b_fiscal_title_fence' USING ERRCODE='42501'; END IF;
