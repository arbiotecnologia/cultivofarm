DO $$DECLARE actual jsonb;expected jsonb:=(SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=arwdDxtm/postgres}'::aclitem[]) AS acl_items(item));BEGIN
 SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(c.relacl) AS acl_items(item)) INTO actual FROM pg_class c WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='platform_private' AND c.relname='authz_tickets');
 IF (SELECT r.rolname FROM pg_class c JOIN pg_roles r ON r.oid=c.relowner WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='platform_private' AND c.relname='authz_tickets')) IS DISTINCT FROM 'postgres'
  OR actual IS DISTINCT FROM expected THEN RAISE EXCEPTION 'FINISHED_PRE_RELATION_DRIFT platform_private.authz_tickets';END IF;
END$$;

