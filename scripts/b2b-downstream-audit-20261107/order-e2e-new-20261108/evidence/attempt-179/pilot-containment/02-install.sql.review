BEGIN;SET LOCAL lock_timeout='3s';
DO $$BEGIN IF to_regclass('platform_private.resale_pilot_allowlist_v1') IS NOT NULL OR to_regprocedure('platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)') IS NOT NULL OR to_regprocedure('platform_private.resale_pilot_allowed_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)') IS NOT NULL OR to_regprocedure('platform_private.resale_pilot_delivery_scope_v1(text,text,uuid,uuid,uuid)') IS NOT NULL OR to_regprocedure('platform_private.resale_pilot_delivery_allowed_v1(text,text,uuid,uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'PILOT_CONTAINMENT_ALREADY_EXISTS'; END IF;END$$;
