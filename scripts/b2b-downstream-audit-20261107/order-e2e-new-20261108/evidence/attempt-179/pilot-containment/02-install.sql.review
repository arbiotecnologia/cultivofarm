CREATE TABLE platform_private.resale_pilot_allowlist_v1(
 id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
 gate text NOT NULL CHECK(gate IN ('finished_product','b2b_resale')),
 operation text NOT NULL CHECK(operation IN ('purchase','read','os_create','reserve','delivery_create','send','proof','confirm','cancel')),
 actor_id uuid NOT NULL,organization_id uuid NOT NULL,
 partner_id uuid,order_id uuid,order_item_id uuid,product_id uuid,stock_id uuid,delivery_id uuid,
 synthetic boolean NOT NULL DEFAULT true CHECK(synthetic IS TRUE),
 valid_from timestamptz NOT NULL DEFAULT now(),valid_until timestamptz NOT NULL,
 revoked_at timestamptz,revoked_by uuid,revoke_reason text,
 created_at timestamptz NOT NULL DEFAULT now(),created_by uuid,
 CHECK(valid_until>valid_from),
 CHECK((revoked_at IS NULL) OR (revoked_at>=valid_from)),
 CHECK(
  (operation='purchase' AND gate='finished_product' AND partner_id IS NULL AND order_id IS NULL AND order_item_id IS NULL AND product_id IS NOT NULL AND stock_id IS NULL AND delivery_id IS NULL)
  OR (operation='read' AND gate='b2b_resale' AND partner_id IS NOT NULL AND order_id IS NOT NULL AND order_item_id IS NULL AND product_id IS NULL AND stock_id IS NULL AND delivery_id IS NULL)
  OR (operation='os_create' AND gate='b2b_resale' AND partner_id IS NOT NULL AND order_id IS NOT NULL AND order_item_id IS NOT NULL AND product_id IS NOT NULL AND stock_id IS NULL AND delivery_id IS NULL)
  OR (operation IN ('reserve','delivery_create') AND ((gate='b2b_resale' AND partner_id IS NOT NULL AND order_id IS NOT NULL AND order_item_id IS NOT NULL) OR (gate='finished_product' AND partner_id IS NULL AND order_id IS NULL AND order_item_id IS NULL)) AND product_id IS NOT NULL AND stock_id IS NOT NULL AND delivery_id IS NULL)
  OR (operation IN ('send','proof','confirm','cancel') AND product_id IS NOT NULL AND stock_id IS NOT NULL AND delivery_id IS NOT NULL)
 ));
ALTER TABLE platform_private.resale_pilot_allowlist_v1 ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.resale_pilot_allowlist_v1 FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.resale_pilot_scope_v1(
 p_gate text,p_operation text,p_actor uuid,p_org uuid,p_partner uuid,p_order uuid,
 p_item uuid,p_product uuid,p_stock uuid,p_delivery uuid)
RETURNS boolean LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path='' AS $$
 SELECT (
  (CASE p_gate
    WHEN 'finished_product' THEN EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled IS TRUE)
    WHEN 'b2b_resale' THEN EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE singleton AND enabled IS TRUE)
    ELSE false END)
  AND p_actor IS NOT NULL AND p_org IS NOT NULL
  AND EXISTS(
   SELECT 1 FROM platform_private.resale_pilot_allowlist_v1 a
   WHERE a.gate=p_gate AND (p_operation IS NULL OR a.operation=p_operation)
    AND a.actor_id=p_actor AND a.organization_id=p_org AND a.synthetic IS TRUE
    AND a.valid_from<=pg_catalog.clock_timestamp() AND a.valid_until>pg_catalog.clock_timestamp() AND a.revoked_at IS NULL
    AND a.partner_id IS NOT DISTINCT FROM p_partner
    AND a.order_id IS NOT DISTINCT FROM p_order
    AND a.order_item_id IS NOT DISTINCT FROM p_item
    AND a.product_id IS NOT DISTINCT FROM p_product
    AND a.stock_id IS NOT DISTINCT FROM p_stock
    AND a.delivery_id IS NOT DISTINCT FROM p_delivery
  )) IS TRUE;
$$;
REVOKE ALL ON FUNCTION platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.resale_pilot_allowed_v1(
 p_gate text,p_operation text,p_actor uuid,p_org uuid,p_partner uuid,p_order uuid,
 p_item uuid,p_product uuid,p_stock uuid,p_delivery uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_grant record;v_enabled boolean;
BEGIN
 -- Pré-checagem somente: nunca é a autorização final e não retém lock.
 IF NOT (CASE p_gate
   WHEN 'finished_product' THEN EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled IS TRUE)
   WHEN 'b2b_resale' THEN EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE singleton AND enabled IS TRUE)
   ELSE false END) OR p_actor IS NULL OR p_org IS NULL THEN RETURN false; END IF;
 -- Ordem única dos locks: concessão -> gate. Quem ainda espera a concessão não
 -- segura o gate, portanto gate OFF/revogação pode confirmar e será releído.
 -- Depois da autorização, ambos os locks permanecem até o commit/rollback do
 -- writer; gate OFF e revogação serializam com a escrita já autorizada.
 FOR v_grant IN
  SELECT a.* FROM platform_private.resale_pilot_allowlist_v1 a
  WHERE a.gate=p_gate AND (p_operation IS NULL OR a.operation=p_operation)
   AND a.actor_id=p_actor AND a.organization_id=p_org
   AND a.partner_id IS NOT DISTINCT FROM p_partner
   AND a.order_id IS NOT DISTINCT FROM p_order
   AND a.order_item_id IS NOT DISTINCT FROM p_item
   AND a.product_id IS NOT DISTINCT FROM p_product
   AND a.stock_id IS NOT DISTINCT FROM p_stock
   AND a.delivery_id IS NOT DISTINCT FROM p_delivery
   ORDER BY a.id FOR UPDATE
 LOOP
  IF p_gate='finished_product' THEN
   SELECT g.enabled INTO v_enabled FROM platform_private.finished_product_gate_v1 g WHERE g.singleton FOR UPDATE;
  ELSIF p_gate='b2b_resale' THEN
   SELECT g.enabled INTO v_enabled FROM platform_private.b2b_resale_logistics_gate_v1 g WHERE g.singleton FOR UPDATE;
  ELSE RETURN false; END IF;
  -- enabled e o relógio são medidos DEPOIS de TODA espera dos dois locks.
  IF v_enabled IS NOT TRUE THEN RETURN false; END IF;
  IF v_grant.synthetic IS TRUE AND v_grant.revoked_at IS NULL
   AND v_grant.valid_from<=pg_catalog.clock_timestamp()
   AND v_grant.valid_until>pg_catalog.clock_timestamp() THEN RETURN true; END IF;
 END LOOP;
 RETURN false;
END;
$$;
REVOKE ALL ON FUNCTION platform_private.resale_pilot_allowed_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.resale_pilot_delivery_scope_v1(
 p_gate text,p_operation text,p_actor uuid,p_org uuid,p_delivery uuid)
RETURNS boolean LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path='' AS $$
 SELECT EXISTS(
  SELECT 1 FROM public.entregas e
  JOIN public.estoque_produto s ON s.id=e.estoque_produto_id
  LEFT JOIN public.ordens_servico os ON os.id=e.ordem_servico_id
  LEFT JOIN public.partner_orders po ON po.id=e.partner_order_id
  WHERE e.id=p_delivery AND e.organization_id=p_org
   AND ((p_gate='finished_product' AND e.partner_order_id IS NULL)
     OR (p_gate='b2b_resale' AND e.partner_order_id IS NOT NULL))
   AND platform_private.resale_pilot_scope_v1(p_gate,p_operation,p_actor,p_org,
    po.partner_id,e.partner_order_id,os.partner_order_item_id,e.produto_id,s.id,e.id) IS TRUE
 );
$$;
REVOKE ALL ON FUNCTION platform_private.resale_pilot_delivery_scope_v1(text,text,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.resale_pilot_delivery_allowed_v1(
 p_gate text,p_operation text,p_actor uuid,p_org uuid,p_delivery uuid)
RETURNS boolean LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path='' AS $$
 SELECT EXISTS(
  SELECT 1 FROM public.entregas e
  JOIN public.estoque_produto s ON s.id=e.estoque_produto_id
  LEFT JOIN public.ordens_servico os ON os.id=e.ordem_servico_id
  LEFT JOIN public.partner_orders po ON po.id=e.partner_order_id
  WHERE e.id=p_delivery AND e.organization_id=p_org
   AND ((p_gate='finished_product' AND e.partner_order_id IS NULL)
     OR (p_gate='b2b_resale' AND e.partner_order_id IS NOT NULL))
   AND platform_private.resale_pilot_allowed_v1(p_gate,p_operation,p_actor,p_org,
    po.partner_id,e.partner_order_id,os.partner_order_item_id,e.produto_id,s.id,e.id) IS TRUE
 );
$$;
REVOKE ALL ON FUNCTION platform_private.resale_pilot_delivery_allowed_v1(text,text,uuid,uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE OR REPLACE FUNCTION platform_private.finished_product_delivery_valid_v1(s estoque_produto, e entregas, l lotes)
 RETURNS boolean
 LANGUAGE sql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT ((e.status::text='separado' OR e.partner_order_id IS NOT NULL OR e.origem_estoque IS NULL OR platform_private.resale_pilot_delivery_scope_v1('finished_product',NULL,auth.uid(),e.organization_id,e.id) IS TRUE)
  AND platform_private.finished_product_stock_valid_v1(s) IS TRUE AND l.id IS NOT NULL AND l.programacao_id IS NULL
  AND e.origem_estoque=s.origem_estoque AND e.unidade_comercial IS NOT NULL AND e.unidade_comercial=s.unidade_comercial
  AND e.conteudo_por_unidade IS NOT NULL AND e.conteudo_por_unidade=s.conteudo_por_unidade
  AND e.unidade_conteudo IS NOT NULL AND e.unidade_conteudo=s.unidade_conteudo
  AND e.quantidade_conteudo IS NOT NULL AND e.quantidade_conteudo=s.quantidade_conteudo
  AND e.embalagem_id=s.embalagem_id AND e.embalagem_versao IS NOT NULL AND e.embalagem_versao=s.embalagem_versao
  AND e.quantidade_entregue=s.quantidade
  AND ((s.unidade_conteudo IN ('kg','g') AND e.volume_entregue_ml IS NULL)
    OR (s.unidade_conteudo='l' AND e.volume_entregue_ml IS NOT NULL AND e.volume_entregue_ml=round(s.quantidade_conteudo*1000,6))
    OR (s.unidade_conteudo='ml' AND e.volume_entregue_ml IS NOT NULL AND e.volume_entregue_ml=round(s.quantidade_conteudo,6)))) IS TRUE;
$function$;

CREATE OR REPLACE FUNCTION platform_private.finished_product_purchase_entry_v1(p_produto_id uuid, p_embalagem_id uuid, p_lote_fornecedor text, p_quantidade numeric, p_compra_referencia text, p_fornecedor_nome text, p_idempotency_key text, p_validade date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE
 v_uid uuid:=auth.uid(); v_org uuid; v_fp text;
 v_prev public.estoque_movimentacoes%ROWTYPE; v_mov public.estoque_movimentacoes%ROWTYPE;
 v_product public.produtos%ROWTYPE; v_sale public.product_sale_units%ROWTYPE;
 v_pack public.product_packagings%ROWTYPE; v_volume public.catalogo_volumes%ROWTYPE;
 v_lote uuid:=gen_random_uuid(); v_stock uuid:=gen_random_uuid();
 v_unit text; v_content numeric; v_version integer; v_total numeric; v_volume_total numeric; v_ctx jsonb;
BEGIN
 v_org:=platform_private.stock_motor_actor('entrada');
 IF NOT platform_private.resale_pilot_scope_v1('finished_product','purchase',v_uid,v_org,NULL,NULL,NULL,p_produto_id,NULL,NULL) THEN
  RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';
 END IF;
 IF p_produto_id IS NULL OR p_embalagem_id IS NULL OR nullif(btrim(coalesce(p_lote_fornecedor,'')),'') IS NULL
  OR nullif(btrim(coalesce(p_compra_referencia,'')),'') IS NULL OR nullif(btrim(coalesce(p_fornecedor_nome,'')),'') IS NULL THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_PURCHASE_PARAMS_INVALID' USING ERRCODE='22023';
 END IF;
 IF p_quantidade IS NULL OR p_quantidade<=0 OR p_quantidade::text IN ('NaN','Infinity','-Infinity') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_QUANTITY_INVALID' USING ERRCODE='23514';
 END IF;
 IF p_quantidade<>trunc(p_quantidade) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_WHOLE_PACK_REQUIRED' USING ERRCODE='23514';
 END IF;
 IF p_idempotency_key IS NULL OR length(btrim(p_idempotency_key))<8 THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_IDEMPOTENCY_REQUIRED' USING ERRCODE='23514';
 END IF;
 v_fp:=encode(extensions.digest(jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','product',p_produto_id,'packaging',p_embalagem_id,'supplier_lot',btrim(p_lote_fornecedor),'quantity',p_quantidade,'purchase',btrim(p_compra_referencia),'supplier',btrim(p_fornecedor_nome),'validity',p_validade)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtext('finished_product_purchase:'||p_idempotency_key));
 v_org:=platform_private.stock_motor_actor('entrada');
 IF NOT platform_private.resale_pilot_scope_v1('finished_product','purchase',v_uid,v_org,NULL,NULL,NULL,p_produto_id,NULL,NULL) THEN
  RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';
 END IF;
 SELECT * INTO v_prev FROM public.estoque_movimentacoes WHERE idempotency_key=p_idempotency_key LIMIT 1;
  IF FOUND THEN
  IF v_prev.usuario_id IS DISTINCT FROM v_uid OR v_prev.request_fingerprint IS DISTINCT FROM v_fp
   OR v_prev.acao IS DISTINCT FROM 'entrada' OR v_prev.origem IS DISTINCT FROM 'finished_product_purchase_entry_v1'
   OR v_prev.metadata->>'produto_id' IS DISTINCT FROM p_produto_id::text
   OR v_prev.metadata->>'embalagem_id' IS DISTINCT FROM p_embalagem_id::text
   OR v_prev.metadata->>'unidade_conteudo' IS NULL OR v_prev.metadata->>'conteudo_por_unidade' IS NULL
   OR v_prev.metadata->>'quantidade_conteudo' IS NULL OR v_prev.metadata->>'embalagem_versao' IS NULL
   OR NOT EXISTS(SELECT 1 FROM public.estoque_produto s JOIN public.lotes l ON l.id=s.lote_id WHERE s.id=v_prev.estoque_produto_id AND l.id=v_prev.lote_id AND l.organization_id=v_org AND s.origem_estoque='compra_produto_acabado_revenda') THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_IDEMPOTENCY_CONFLICT' USING ERRCODE='23505';
  END IF;
  RETURN jsonb_build_object('ok',true,'replay',true,'lote_id',v_prev.lote_id,'estoque_produto_id',v_prev.estoque_produto_id,'movimentacao_id',v_prev.id,
   'origem_estoque','compra_produto_acabado_revenda','unidade_conteudo',v_prev.metadata->>'unidade_conteudo',
   'conteudo_por_unidade',(v_prev.metadata->>'conteudo_por_unidade')::numeric,
   'quantidade_conteudo',(v_prev.metadata->>'quantidade_conteudo')::numeric,
   'embalagem_versao',(v_prev.metadata->>'embalagem_versao')::integer);
 END IF;
 SELECT * INTO v_product FROM public.produtos WHERE id=p_produto_id FOR SHARE;
 IF NOT FOUND OR v_product.owner_organization_id IS DISTINCT FROM v_org OR v_product.ativo IS NOT TRUE
  OR v_product.familia_catalogo NOT IN ('quimico','fertilizante_adubo') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_CATALOG_DENIED' USING ERRCODE='42501';
 END IF;
 SELECT * INTO v_sale FROM public.product_sale_units WHERE product_id=p_produto_id AND owner_organization_id=v_org FOR SHARE;
 IF NOT FOUND OR v_sale.unidade_conteudo NOT IN ('kg','g','l','ml') THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_SALE_UNIT_REQUIRED' USING ERRCODE='23514';
 END IF;
 v_unit:=v_sale.unidade_conteudo;
 SELECT * INTO v_volume FROM public.catalogo_volumes WHERE id=p_embalagem_id AND produto_id=p_produto_id AND owner_organization_id=v_org AND ativo IS TRUE FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FINISHED_PRODUCT_PACKAGING_DENIED' USING ERRCODE='42501'; END IF;
 IF v_unit IN ('kg','g') THEN
  SELECT * INTO v_pack FROM public.product_packagings
   WHERE id=p_embalagem_id AND product_id=p_produto_id AND owner_organization_id=v_org AND ativo IS TRUE
    AND valid_from<=now() AND (valid_to IS NULL OR valid_to>=now()) FOR SHARE;
  IF NOT FOUND OR v_volume.medida IS DISTINCT FROM 'embalagem' OR v_pack.peso_liquido_kg<=0 OR v_pack.peso_liquido_kg::text IN ('NaN','Infinity','-Infinity') THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_PACKAGING_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  v_content:=v_pack.peso_liquido_kg*CASE WHEN v_unit='g' THEN 1000 ELSE 1 END;
  v_version:=v_pack.version;
 ELSE
  IF v_volume.medida IS DISTINCT FROM 'volume' OR v_volume.volume_ml IS NULL OR v_volume.volume_ml<=0
   OR v_volume.volume_ml::text IN ('NaN','Infinity','-Infinity') OR EXISTS(SELECT 1 FROM public.product_packagings x WHERE x.id=p_embalagem_id) THEN
   RAISE EXCEPTION 'FINISHED_PRODUCT_PRESENTATION_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  v_content:=v_volume.volume_ml/CASE WHEN v_unit='l' THEN 1000 ELSE 1 END;
  v_version:=v_sale.version;
 END IF;
 v_org:=platform_private.stock_motor_actor('entrada');
 v_total:=p_quantidade*v_content;
 v_volume_total:=CASE WHEN v_unit IN ('kg','g') THEN NULL WHEN v_unit='l' THEN v_total ELSE v_total/1000 END;
 IF NOT platform_private.resale_pilot_allowed_v1('finished_product','purchase',v_uid,v_org,NULL,NULL,NULL,p_produto_id,NULL,NULL) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(pg_catalog.txid_current(),'finished_product_purchase_entry_v1',v_lote);
 INSERT INTO public.lotes(id,codigo_lote,produto_id,programacao_id,volume_produzido,status,organization_id,observacoes_tecnicas)
 -- Código interno globalmente único vem do UUID servidor; lote externo permanece nos snapshots/ledger.
 VALUES(v_lote,'BUY-'||v_lote::text,p_produto_id,NULL,NULL,'aprovado',v_org,
  jsonb_build_object('origem','compra_produto_acabado_revenda','compra_referencia',btrim(p_compra_referencia),'fornecedor',btrim(p_fornecedor_nome),'lote_fornecedor',btrim(p_lote_fornecedor),'embalagem_id',p_embalagem_id,'embalagem_versao',v_version)::text);
 DELETE FROM platform_private.authz_tickets WHERE txid=pg_catalog.txid_current() AND scope='finished_product_purchase_entry_v1' AND target=v_lote;
 v_ctx:=jsonb_build_object('acao','entrada','origem','finished_product_purchase_entry_v1','usuario_id',v_uid,'unidade','un',
  'idempotency_key',p_idempotency_key,'request_fingerprint',v_fp,'referencia_tipo','lote',
  'metadata',jsonb_build_object('stock_request_item',v_stock,'stock_request_actor',v_uid,'origem_estoque','compra_produto_acabado_revenda',
   'compra_referencia',btrim(p_compra_referencia),'fornecedor',btrim(p_fornecedor_nome),'lote_fornecedor',btrim(p_lote_fornecedor),'produto_id',p_produto_id,
   'embalagem_id',p_embalagem_id,'embalagem_versao',v_version,'unidade_conteudo',v_unit,'conteudo_por_unidade',v_content,'quantidade_conteudo',v_total));
 PERFORM platform_private.stock_motor_context_set(v_ctx);
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(pg_catalog.txid_current(),'finished_product_purchase_entry_v1',v_stock);
 INSERT INTO public.estoque_produto(id,lote_id,produto_id,quantidade,volume_total,validade,quantidade_reservada,status,origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao)
 VALUES(v_stock,v_lote,p_produto_id,p_quantidade,v_volume_total,p_validade,NULL,'disponivel','compra_produto_acabado_revenda','unidade',v_content,v_unit,v_total,p_embalagem_id,v_version);
 DELETE FROM platform_private.authz_tickets WHERE txid=pg_catalog.txid_current() AND scope='finished_product_purchase_entry_v1' AND target=v_stock;
 PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close();
 SELECT * INTO v_mov FROM public.estoque_movimentacoes WHERE idempotency_key=p_idempotency_key AND estoque_produto_id=v_stock;
 IF NOT FOUND OR v_mov.acao IS DISTINCT FROM 'entrada' OR v_mov.usuario_id IS DISTINCT FROM v_uid
  OR v_mov.request_fingerprint IS DISTINCT FROM v_fp OR v_mov.quantidade IS DISTINCT FROM p_quantidade
  OR v_mov.metadata->>'compra_referencia' IS DISTINCT FROM btrim(p_compra_referencia) THEN
  RAISE EXCEPTION 'FINISHED_PRODUCT_ENTRY_LEDGER_DENIED' USING ERRCODE='42501';
 END IF;
 RETURN jsonb_build_object('ok',true,'replay',false,'lote_id',v_lote,'estoque_produto_id',v_stock,'movimentacao_id',v_mov.id,
  'origem_estoque','compra_produto_acabado_revenda','unidade_conteudo',v_unit,'conteudo_por_unidade',v_content,'quantidade_conteudo',v_total,'embalagem_versao',v_version);
EXCEPTION WHEN OTHERS THEN
 PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close(); RAISE;
END;$function$;

CREATE OR REPLACE FUNCTION public.rpc_finished_product_purchase_capability_v1()
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_available boolean:=false;
BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'FINISHED_PRODUCT_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 BEGIN
  v_org:=platform_private.stock_motor_actor('entrada');
 EXCEPTION WHEN insufficient_privilege THEN
  RETURN jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','available',false,'reason','ACTOR_DENIED');
 END;
 v_available:=EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE singleton AND enabled IS TRUE)
  AND EXISTS(SELECT 1 FROM platform_private.resale_pilot_allowlist_v1 a WHERE a.gate='finished_product' AND a.operation='purchase' AND a.actor_id=auth.uid() AND a.organization_id=v_org AND a.synthetic AND a.valid_from<=pg_catalog.clock_timestamp() AND a.valid_until>pg_catalog.clock_timestamp() AND a.revoked_at IS NULL);
 RETURN jsonb_build_object('contract','FINISHED_PRODUCT_PURCHASE_V1','available',v_available);
END $function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_resale_os_valid_v1(o ordens_servico)
 RETURNS boolean
 LANGUAGE sql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT (platform_private.resale_pilot_scope_v1('b2b_resale',NULL,auth.uid(),o.organization_id,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=o.partner_order_id),o.partner_order_id,o.partner_order_item_id,o.produto_id,NULL,NULL)
  AND o.id IS NOT NULL AND o.origem='b2b' AND o.status::text='pronto_entrega'
  AND o.organization_id IS NOT NULL AND o.partner_order_id IS NOT NULL AND o.partner_order_item_id IS NOT NULL
  AND o.produto_id IS NOT NULL AND o.microrganismo_id IS NULL AND o.cliente_id IS NULL
  AND o.fazenda_id IS NULL AND o.talhao_id IS NULL AND o.volume_total_ml IS NULL AND o.area_hectares IS NULL
  AND EXISTS(
   SELECT 1 FROM public.partner_orders po
   JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=o.organization_id
    AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
   JOIN public.partner_order_items i ON i.id=o.partner_order_item_id AND i.order_id=po.id
   JOIN public.produtos p ON p.id=i.product_id AND p.owner_organization_id=o.organization_id
    AND p.ativo IS TRUE AND p.familia_catalogo IN ('quimico','fertilizante_adubo')
   WHERE po.id=o.partner_order_id AND po.status::text='aprovado' AND po.ready_for_production IS FALSE
    AND po.receivable_generated IS FALSE AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id
       AND po.payment_condition_status IN ('defined','approved')
       AND ((po.requires_financial_approval IS FALSE AND po.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
    AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
    AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
    AND i.product_id=o.produto_id AND i.microrganismo_id IS NULL
    AND i.quantidade>0 AND i.quantidade=trunc(i.quantidade) AND i.unidade_medida='unidade'
    AND i.packaging_id_snapshot IS NOT NULL AND i.packaging_version_snapshot>0
    AND i.packaging_unidade_conteudo_snapshot IN ('kg','g','l','ml')
    AND ((i.packaging_unidade_conteudo_snapshot IN ('kg','g') AND i.packaging_peso_liquido_kg_snapshot>0)
      OR (i.packaging_unidade_conteudo_snapshot IN ('l','ml') AND i.packaging_peso_liquido_kg_snapshot IS NULL))
  )) IS TRUE;
$function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_resale_os_operational_valid_v1(o ordens_servico)
 RETURNS boolean
 LANGUAGE sql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT (platform_private.resale_pilot_scope_v1('b2b_resale',NULL,auth.uid(),o.organization_id,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=o.partner_order_id),o.partner_order_id,o.partner_order_item_id,o.produto_id,NULL,NULL)
  AND o.id IS NOT NULL AND o.origem='b2b' AND o.status::text='pronto_entrega'
  AND o.organization_id IS NOT NULL AND o.partner_order_id IS NOT NULL AND o.partner_order_item_id IS NOT NULL
  AND o.produto_id IS NOT NULL AND o.microrganismo_id IS NULL AND o.cliente_id IS NULL
  AND o.fazenda_id IS NULL AND o.talhao_id IS NULL AND o.volume_total_ml IS NULL AND o.area_hectares IS NULL
  AND EXISTS(
   SELECT 1 FROM public.partner_orders po
    JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=o.organization_id
    AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
   JOIN public.partner_order_items i ON i.id=o.partner_order_item_id AND i.order_id=po.id
   JOIN public.produtos p ON p.id=i.product_id AND p.owner_organization_id=o.organization_id
    AND p.ativo IS TRUE AND p.familia_catalogo IN ('quimico','fertilizante_adubo')
   WHERE po.id=o.partner_order_id AND po.status::text IN ('aprovado','aguardando_entrega','em_separacao','enviado','entregue','faturado')
    AND po.ready_for_production IS FALSE AND po.receivable_generated IS FALSE
    AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id
       AND po.payment_condition_status IN ('defined','approved')
       AND ((po.requires_financial_approval IS FALSE AND po.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
    AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
    AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
    AND i.product_id=o.produto_id AND i.microrganismo_id IS NULL
    AND i.quantidade>0 AND i.quantidade=trunc(i.quantidade) AND i.unidade_medida='unidade'
    AND i.packaging_id_snapshot IS NOT NULL AND i.packaging_version_snapshot>0
    AND i.packaging_unidade_conteudo_snapshot IN ('kg','g','l','ml')
    AND ((i.packaging_unidade_conteudo_snapshot IN ('kg','g') AND i.packaging_peso_liquido_kg_snapshot>0)
      OR (i.packaging_unidade_conteudo_snapshot IN ('l','ml') AND i.packaging_peso_liquido_kg_snapshot IS NULL))
  )) IS TRUE;
$function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_resale_delivery_lineage_valid_v1(s estoque_produto, e entregas, l lotes)
 RETURNS boolean
 LANGUAGE sql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT (platform_private.resale_pilot_delivery_scope_v1('b2b_resale',NULL,auth.uid(),e.organization_id,e.id)
  AND platform_private.finished_product_delivery_valid_v1(s,e,l) IS TRUE
  AND e.partner_order_id IS NOT NULL AND e.cliente_id IS NULL
  AND s.reservado_para_os_id=e.ordem_servico_id AND s.reservado_para_os_tipo='b2b'
  AND s.reservado_para_partner_order_id=e.partner_order_id AND s.reservado_para_cliente_id IS NULL
  AND EXISTS(
   SELECT 1 FROM public.ordens_servico os
   JOIN public.partner_orders po ON po.id=os.partner_order_id AND po.id=e.partner_order_id
   JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=os.organization_id
   WHERE os.id=e.ordem_servico_id AND os.organization_id=e.organization_id AND os.origem='b2b'
    AND os.partner_order_item_id IS NOT NULL AND os.produto_id=e.produto_id AND os.microrganismo_id IS NULL
    AND po.status::text IN ('aprovado','aguardando_entrega','em_separacao','enviado','entregue','faturado')
    AND po.ready_for_production IS FALSE AND po.receivable_generated IS FALSE
    AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
    AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
    AND s.reservado_para_partner_id=po.partner_id
    AND EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.id=os.partner_order_item_id AND i.order_id=po.id
      AND i.product_id=os.produto_id AND i.microrganismo_id IS NULL AND i.quantidade>0 AND i.quantidade=trunc(i.quantidade)
      AND i.packaging_id_snapshot=s.embalagem_id AND i.packaging_version_snapshot=s.embalagem_versao)
  )) IS TRUE;
$function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_resale_delivery_order_valid_v1(e entregas)
 RETURNS boolean
 LANGUAGE sql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT (EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE singleton AND enabled IS TRUE)
  AND (e.status::text='separado' OR platform_private.resale_pilot_delivery_scope_v1('b2b_resale',NULL,auth.uid(),e.organization_id,e.id) IS TRUE)
  AND e.id IS NOT NULL AND e.organization_id IS NOT NULL AND e.partner_order_id IS NOT NULL
  AND e.receivable_id IS NULL AND e.ordem_servico_id IS NOT NULL AND e.ordem_servico_onfarm_id IS NULL
  AND e.cliente_id IS NULL AND EXISTS(
   SELECT 1 FROM public.ordens_servico os
   JOIN public.partner_orders po ON po.id=os.partner_order_id AND po.id=e.partner_order_id
   JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=os.organization_id
    AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
   WHERE os.id=e.ordem_servico_id AND os.organization_id=e.organization_id AND os.origem='b2b'
    AND os.partner_order_item_id IS NOT NULL AND os.produto_id=e.produto_id AND os.microrganismo_id IS NULL
    AND po.status::text IN ('aprovado','aguardando_entrega','em_separacao','enviado','entregue','faturado')
    AND po.ready_for_production IS FALSE AND po.receivable_generated IS FALSE
    AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id
       AND po.payment_condition_status IN ('defined','approved')
       AND ((po.requires_financial_approval IS FALSE AND po.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
    AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
    AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
  )) IS TRUE;
$function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_resale_os_create_v1(p_order_id uuid, p_order_item_id uuid, p_expected_updated_at timestamp with time zone, p_request_key text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE v_uid uuid:=auth.uid();v_org uuid;v_order public.partner_orders%ROWTYPE;
 v_item public.partner_order_items%ROWTYPE;v_prev platform_private.b2b_resale_os_requests_v1%ROWTYPE;
 v_os uuid:=gen_random_uuid();v_fp text;v_result jsonb;
BEGIN
 IF platform_private.b2b_internal_commercial_actor() IS NOT TRUE THEN RAISE EXCEPTION 'B2B_RESALE_ACTOR_DENIED' USING ERRCODE='42501';END IF;
 v_org:=platform_private.stock_motor_actor('reserva');
 IF NOT platform_private.resale_pilot_scope_v1('b2b_resale','os_create',v_uid,v_org,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=p_order_id),p_order_id,p_order_item_id,(SELECT i.product_id FROM public.partner_order_items i WHERE i.id=p_order_item_id AND i.order_id=p_order_id),NULL,NULL) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';END IF;
 IF p_order_id IS NULL OR p_order_item_id IS NULL OR p_expected_updated_at IS NULL OR p_request_key IS NULL
  OR length(btrim(p_request_key))<8 OR length(p_request_key)>128 THEN RAISE EXCEPTION 'B2B_RESALE_REQUEST_INVALID' USING ERRCODE='22023';END IF;
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_resale_os_request:'||p_request_key,0));
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_resale_os_item:'||p_order_item_id::text,0));
 v_org:=platform_private.stock_motor_actor('reserva');
 IF platform_private.b2b_internal_commercial_actor() IS NOT TRUE THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501';END IF;
 IF NOT platform_private.resale_pilot_scope_v1('b2b_resale','os_create',v_uid,v_org,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=p_order_id),p_order_id,p_order_item_id,(SELECT i.product_id FROM public.partner_order_items i WHERE i.id=p_order_item_id AND i.order_id=p_order_id),NULL,NULL) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';END IF;
 SELECT * INTO v_order FROM public.partner_orders po WHERE po.id=p_order_id
  AND EXISTS(SELECT 1 FROM public.partner_accounts pa WHERE pa.id=po.partner_id AND pa.commercial_owner_organization_id=v_org AND pa.ativo AND pa.deleted_at IS NULL)
  AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
  AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL AND po.ready_for_production IS FALSE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_RESALE_ORDER_SCOPE_DENIED' USING ERRCODE='42501';END IF;
 v_fp:=encode(extensions.digest(jsonb_build_object('contract','B2B_RESALE_OS_V1','actor',v_uid,'org',v_org,'order',p_order_id,'item',p_order_item_id,'observed',p_expected_updated_at)::text,'sha256'),'hex');
 SELECT * INTO v_prev FROM platform_private.b2b_resale_os_requests_v1 WHERE actor=v_uid AND organization_id=v_org AND request_key=p_request_key;
 IF FOUND THEN
  IF v_prev.fingerprint IS DISTINCT FROM v_fp OR v_prev.order_id IS DISTINCT FROM p_order_id OR v_prev.order_item_id IS DISTINCT FROM p_order_item_id THEN RAISE EXCEPTION 'B2B_RESALE_REPLAY_CONFLICT' USING ERRCODE='PT409';END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 SELECT * INTO v_order FROM public.partner_orders WHERE id=p_order_id FOR UPDATE;
 IF v_order.status::text IS DISTINCT FROM 'aprovado' OR v_order.updated_at IS DISTINCT FROM p_expected_updated_at
  OR v_order.receivable_generated IS TRUE OR NOT (EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=v_order.payment_terms_id AND t.partner_order_id=v_order.id
       AND v_order.payment_condition_status IN ('defined','approved')
       AND ((v_order.requires_financial_approval IS FALSE AND v_order.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))) THEN RAISE EXCEPTION 'B2B_RESALE_ORDER_CONFLICT' USING ERRCODE='PT409';END IF;
 SELECT * INTO v_item FROM public.partner_order_items i WHERE i.id=p_order_item_id AND i.order_id=p_order_id
  AND i.product_id IS NOT NULL AND i.microrganismo_id IS NULL AND i.quantidade>0 AND i.quantidade=trunc(i.quantidade)
  AND i.unidade_medida='unidade' AND i.packaging_id_snapshot IS NOT NULL AND i.packaging_version_snapshot>0
  AND i.packaging_unidade_conteudo_snapshot IN ('kg','g','l','ml')
  AND EXISTS(SELECT 1 FROM public.produtos p WHERE p.id=i.product_id AND p.owner_organization_id=v_org AND p.ativo
   AND p.familia_catalogo IN ('quimico','fertilizante_adubo')) FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_RESALE_ITEM_DENIED' USING ERRCODE='42501';END IF;
 -- O FOR SHARE do item é o último lock explícito antes do ticket/INSERT. Toda
 -- autoridade e o escopo precisam ser observados novamente aqui: revogação de
 -- papel, perfil, tenant, parceiro ou gate durante a espera não pode criar OS,
 -- recibo, ticket ou efeito posterior. O replay continua reautorizado acima.
 IF auth.uid() IS DISTINCT FROM v_uid OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501';END IF;
 IF platform_private.stock_motor_actor('reserva') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501';END IF;
 IF NOT platform_private.resale_pilot_allowed_v1('b2b_resale','os_create',v_uid,v_org,v_order.partner_id,p_order_id,p_order_item_id,v_item.product_id,NULL,NULL) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';END IF;
 IF NOT EXISTS(
  SELECT 1 FROM public.partner_orders po
  JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=v_org
   AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
  WHERE po.id=p_order_id AND po.status::text='aprovado'
   AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
   AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
   AND po.ready_for_production IS FALSE AND po.receivable_generated IS FALSE
   AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id
       AND po.payment_condition_status IN ('defined','approved')
       AND ((po.requires_financial_approval IS FALSE AND po.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
 ) THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501';END IF;
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(txid_current(),'b2b_resale_os_create_v1',v_os);
 INSERT INTO public.ordens_servico(id,organization_id,cliente_id,fazenda_id,talhao_id,produto_id,microrganismo_id,
  volume_total_ml,area_hectares,prioridade,status,tipo_item,partner_order_id,partner_order_item_id,origem)
 VALUES(v_os,v_org,NULL,NULL,NULL,v_item.product_id,NULL,NULL,NULL,'media','pronto_entrega','produto',p_order_id,p_order_item_id,'b2b');
 DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='b2b_resale_os_create_v1' AND target=v_os;
 v_result:=jsonb_build_object('ok',true,'replay',false,'contract','B2B_RESALE_OS_V1','os_id',v_os,'order_id',p_order_id,'order_item_id',p_order_item_id);
 INSERT INTO platform_private.b2b_resale_os_requests_v1(request_key,actor,organization_id,order_id,order_item_id,fingerprint,result)
 VALUES(p_request_key,v_uid,v_org,p_order_id,p_order_item_id,v_fp,v_result);
 RETURN v_result;
EXCEPTION WHEN OTHERS THEN
 DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='b2b_resale_os_create_v1';
 RAISE;
END;$function$;

CREATE OR REPLACE FUNCTION public.rpc_b2b_resale_os_availability_v1(p_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 VOLATILE SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE actor uuid:=auth.uid(); org uuid; result jsonb; gate_open boolean;
 v_order public.partner_orders%ROWTYPE; duplicate_os integer;
BEGIN
 IF actor IS NULL OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE
 THEN RAISE EXCEPTION 'B2B_RESALE_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 org:=platform_private.stock_motor_actor('reserva');
 IF p_order_id IS NULL THEN RAISE EXCEPTION 'B2B_RESALE_REQUEST_INVALID' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_order FROM public.partner_orders po
  JOIN public.partner_accounts pa ON pa.id=po.partner_id
  WHERE po.id=p_order_id AND pa.commercial_owner_organization_id=org
   AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
   AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
   AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL
   AND po.ready_for_production IS FALSE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_RESALE_ORDER_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT platform_private.resale_pilot_scope_v1('b2b_resale','read',actor,org,v_order.partner_id,p_order_id,NULL,NULL,NULL,NULL) INTO gate_open;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE singleton AND enabled IS TRUE) AND gate_open IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT count(*) INTO duplicate_os FROM (
   SELECT i.id FROM public.partner_order_items i
   WHERE i.order_id=p_order_id
    AND (SELECT count(*) FROM public.ordens_servico os
      WHERE os.partner_order_id=p_order_id AND os.partner_order_item_id=i.id AND os.origem='b2b')>1
 ) d;
 IF duplicate_os<>0 THEN RAISE EXCEPTION 'B2B_RESALE_OS_CARDINALITY_CONFLICT' USING ERRCODE='PT409'; END IF;
 SELECT jsonb_build_object(
  'contract','B2B_RESALE_OS_AVAILABILITY_V1','order_id',p_order_id,
  'actor_id',actor,'organization_id',org,'observed_updated_at',v_order.updated_at,
  'available',gate_open,'items',coalesce(jsonb_agg(jsonb_build_object(
    'order_item_id',i.id,'os_id',os.id,
    'create_available',gate_open AND os.id IS NULL AND v_order.status::text='aprovado'
     AND v_order.receivable_generated IS FALSE AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=v_order.payment_terms_id AND t.partner_order_id=v_order.id
       AND v_order.payment_condition_status IN ('defined','approved')
       AND ((v_order.requires_financial_approval IS FALSE AND v_order.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
     AND i.product_id IS NOT NULL AND i.microrganismo_id IS NULL
     AND i.quantidade>0 AND i.quantidade=trunc(i.quantidade) AND i.unidade_medida='unidade'
     AND i.packaging_id_snapshot IS NOT NULL AND i.packaging_version_snapshot>0
     AND i.packaging_unidade_conteudo_snapshot IN ('kg','g','l','ml')
     AND p.id IS NOT NULL
   ) ORDER BY i.created_at,i.id),'[]'::jsonb)
 ) INTO result
 FROM public.partner_order_items i
 LEFT JOIN public.produtos p ON p.id=i.product_id AND p.owner_organization_id=org
  AND p.ativo IS TRUE AND p.familia_catalogo IN ('quimico','fertilizante_adubo')
 LEFT JOIN public.ordens_servico os ON os.partner_order_id=p_order_id
  AND os.partner_order_item_id=i.id AND os.origem='b2b'
 WHERE i.order_id=p_order_id;
 IF platform_private.resale_pilot_scope_v1('b2b_resale','read',actor,org,v_order.partner_id,p_order_id,NULL,NULL,NULL,NULL) IS DISTINCT FROM gate_open THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF auth.uid() IS DISTINCT FROM actor OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE
 OR platform_private.stock_motor_actor('reserva') IS DISTINCT FROM org
 THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 RETURN result;
END;$function$;

CREATE OR REPLACE FUNCTION public.rpc_b2b_resale_os_create_v1(p_order_id uuid, p_order_item_id uuid, p_expected_updated_at timestamp with time zone, p_request_key text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE actor uuid:=auth.uid(); org uuid; result jsonb;
BEGIN
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed'
 THEN RAISE EXCEPTION 'B2B_RESALE_ISOLATION_DENIED' USING ERRCODE='42501'; END IF;
 IF actor IS NULL OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE
 THEN RAISE EXCEPTION 'B2B_RESALE_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 org:=platform_private.stock_motor_actor('reserva');
 IF p_order_id IS NULL OR p_order_item_id IS NULL OR p_expected_updated_at IS NULL
 OR NOT isfinite(p_expected_updated_at) OR p_request_key IS NULL
 OR length(btrim(p_request_key))<8 OR length(p_request_key)>128
 THEN RAISE EXCEPTION 'B2B_RESALE_REQUEST_INVALID' USING ERRCODE='22023'; END IF;
 -- Exact helper lock order. No unowned row lock or existence oracle.
 IF NOT EXISTS(SELECT 1 FROM public.partner_orders po JOIN public.partner_accounts pa ON pa.id=po.partner_id
  WHERE po.id=p_order_id AND pa.commercial_owner_organization_id=org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL)
 THEN RAISE EXCEPTION 'B2B_RESALE_ORDER_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_resale_os_request:'||p_request_key,0));
 PERFORM pg_advisory_xact_lock(hashtextextended('b2b_resale_os_item:'||p_order_item_id::text,0));
 PERFORM 1 FROM public.partner_orders WHERE id=p_order_id FOR UPDATE;
 PERFORM 1 FROM public.partner_order_items WHERE id=p_order_item_id AND order_id=p_order_id FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'B2B_RESALE_ITEM_DENIED' USING ERRCODE='42501'; END IF;
 IF auth.uid() IS DISTINCT FROM actor OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE
 OR platform_private.stock_motor_actor('reserva') IS DISTINCT FROM org
 THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF NOT platform_private.resale_pilot_allowed_v1('b2b_resale','os_create',actor,org,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=p_order_id),p_order_id,p_order_item_id,(SELECT i.product_id FROM public.partner_order_items i WHERE i.id=p_order_item_id AND i.order_id=p_order_id),NULL,NULL)
 THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Replays also require current approved-origin authority, not just a receipt.
 IF NOT EXISTS(SELECT 1 FROM public.partner_orders po JOIN public.partner_accounts pa ON pa.id=po.partner_id
   WHERE po.id=p_order_id AND pa.commercial_owner_organization_id=org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
  AND po.status::text IN ('aprovado','entregue') AND po.ready_for_production IS FALSE
  AND po.receivable_generated IS FALSE AND EXISTS(SELECT 1 FROM public.partner_order_payment_terms t
      WHERE t.id=po.payment_terms_id AND t.partner_order_id=po.id
       AND po.payment_condition_status IN ('defined','approved')
       AND ((po.requires_financial_approval IS FALSE AND po.financial_approval_status NOT IN ('pending','rejected'))
        OR (t.approval_status='approved' AND t.approved_by IS NOT NULL AND t.approved_at IS NOT NULL)))
  AND platform_private.c2_external_origin_contract_valid(po.c2_external_origin_snapshot) IS TRUE
  AND po.internal_economic_snapshot IS NOT NULL AND po.internal_origin_snapshot IS NULL)
 THEN RAISE EXCEPTION 'B2B_RESALE_ORDER_CONFLICT' USING ERRCODE='PT409'; END IF;
 -- No actor, org, price, quantity or accounting input; existing core owns CAS/receipt/INSERT.
 result:=platform_private.b2b_resale_os_create_v1(p_order_id,p_order_item_id,p_expected_updated_at,p_request_key);
 IF auth.uid() IS DISTINCT FROM actor OR platform_private.b2b_internal_commercial_actor() IS NOT TRUE
  OR platform_private.stock_motor_actor('reserva') IS DISTINCT FROM org
 THEN RAISE EXCEPTION 'B2B_RESALE_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF result->>'contract' IS DISTINCT FROM 'B2B_RESALE_OS_V1' OR (result->>'ok')::boolean IS NOT TRUE
 OR result->>'order_id' IS DISTINCT FROM p_order_id::text
 OR result->>'order_item_id' IS DISTINCT FROM p_order_item_id::text OR result->>'os_id' IS NULL
 THEN RAISE EXCEPTION 'B2B_RESALE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 RETURN result;
END;$function$;

CREATE OR REPLACE FUNCTION public.reservar_estoque_item(p_item_id uuid, p_qty numeric, p_os_id uuid, p_os_tipo text, p_cliente_id uuid DEFAULT NULL::uuid, p_partner_id uuid DEFAULT NULL::uuid, p_partner_order_id uuid DEFAULT NULL::uuid, p_observacao text DEFAULT NULL::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_item public.estoque_produto%ROWTYPE;
  v_volume_reservado numeric;
  v_new_id uuid;
  v_parent_ctx jsonb;
  v_org uuid;
  v_order_item uuid;
BEGIN
  PERFORM platform_private.stock_motor_actor('reserva');
  IF p_qty IS NULL OR p_qty::text IN ('NaN','Infinity','-Infinity') OR p_qty <= 0 THEN
    RAISE EXCEPTION 'ESTQ_QUANTIDADE_INVALIDA: quantidade deve ser finita e maior que zero.' USING ERRCODE='23514';
  END IF;
  PERFORM platform_private.stock_motor_item(p_item_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id,'partner_id',p_partner_id,'partner_order_id',p_partner_order_id));
  IF auth.uid() IS NULL OR NOT public.fn_estoque_pode_operar(auth.uid(), 'reserva') THEN
    RAISE EXCEPTION 'ESTQ_SEM_PERMISSAO: perfil sem permissão para reservar estoque'
      USING ERRCODE = '42501';
  END IF;

  SELECT c.ctx INTO v_parent_ctx FROM platform_private.stock_motor_context c WHERE c.txid=txid_current() AND c.actor=auth.uid() AND c.item=p_item_id;
  IF v_parent_ctx IS NOT NULL AND (v_parent_ctx->>'acao' IS DISTINCT FROM 'reserva' OR v_parent_ctx->'reserve_args' IS DISTINCT FROM jsonb_strip_nulls(jsonb_build_object('os_id',p_os_id::text,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id::text,'partner_id',p_partner_id::text,'partner_order_id',p_partner_order_id::text,'observacao',p_observacao))) THEN RAISE EXCEPTION 'ESTQ_PAYLOAD_INVALIDO' USING ERRCODE='22023'; END IF;
  IF v_parent_ctx IS NULL THEN
   v_parent_ctx:=jsonb_build_object('acao','reserva','origem','reservar_estoque_item','usuario_id',auth.uid()::text,'metadata',jsonb_build_object('stock_request_item',p_item_id::text,'stock_request_actor',auth.uid()::text));
  END IF;
  PERFORM public.fn_estoque_ctx_force(v_parent_ctx);
  IF p_qty IS NULL OR p_qty <= 0 THEN
    RAISE EXCEPTION 'Quantidade a reservar deve ser maior que zero.'
      USING ERRCODE = 'check_violation';
  END IF;
  IF p_os_id IS NULL THEN
    RAISE EXCEPTION 'Reserva requer uma OS vinculada.'
      USING ERRCODE = 'check_violation';
  END IF;

  SELECT * INTO v_item
  FROM public.estoque_produto
  WHERE id = p_item_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Item de estoque % não encontrado.', p_item_id
      USING ERRCODE = 'no_data_found';
  END IF;

  PERFORM platform_private.stock_motor_item(p_item_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo',p_os_tipo,'cliente_id',p_cliente_id,'partner_id',p_partner_id,'partner_order_id',p_partner_order_id));
  IF v_item.origem_estoque IS NOT NULL THEN
    v_org:=platform_private.stock_motor_actor('reserva');
    SELECT os.partner_order_item_id INTO v_order_item FROM public.ordens_servico os WHERE os.id=p_os_id AND os.organization_id=v_org;
    IF p_os_tipo='b2b' THEN
      IF platform_private.resale_pilot_allowed_v1('b2b_resale','reserve',auth.uid(),v_org,p_partner_id,p_partner_order_id,v_order_item,v_item.produto_id,p_item_id,NULL) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
    ELSIF p_os_tipo='manual' THEN
      IF platform_private.resale_pilot_allowed_v1('finished_product','reserve',auth.uid(),v_org,NULL,NULL,NULL,v_item.produto_id,p_item_id,NULL) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
    ELSE RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  END IF;
  IF v_item.status::text <> 'disponivel' THEN
    RAISE EXCEPTION 'Item % não está disponível para reserva (status: %).', p_item_id, v_item.status
      USING ERRCODE = 'check_violation';
  END IF;

  IF p_qty > COALESCE(v_item.quantidade, 0) THEN
    RAISE EXCEPTION 'Quantidade solicitada (%) excede o disponível (%) para esta embalagem.',
      p_qty, COALESCE(v_item.quantidade, 0)
      USING ERRCODE = 'check_violation';
  END IF;

  IF v_item.origem_estoque IS NOT NULL AND platform_private.finished_product_stock_valid_v1(v_item) IS NOT TRUE THEN
    RAISE EXCEPTION 'FINISHED_PRODUCT_STOCK_CONTRACT_DENIED' USING ERRCODE='23514';
  END IF;
  IF v_item.unidade_comercial='unidade' AND p_qty<>trunc(p_qty) THEN
    RAISE EXCEPTION 'FINISHED_PRODUCT_WHOLE_PACK_REQUIRED' USING ERRCODE='23514';
  END IF;

  v_volume_reservado := CASE
    WHEN COALESCE(v_item.volume_total, 0) > 0 AND COALESCE(v_item.quantidade, 0) > 0
      THEN (p_qty * v_item.volume_total) / v_item.quantidade
    ELSE NULL
  END;

  IF p_qty = v_item.quantidade THEN
    UPDATE public.estoque_produto SET
      status = 'reservado',
      reservado_para_os_id = p_os_id,
      reservado_para_os_tipo = p_os_tipo,
      reservado_para_cliente_id = CASE WHEN p_os_tipo = 'b2b' THEN NULL ELSE p_cliente_id END,
      reservado_para_partner_id = CASE WHEN p_os_tipo = 'b2b' THEN p_partner_id ELSE NULL END,
      reservado_para_partner_order_id = CASE WHEN p_os_tipo = 'b2b' THEN p_partner_order_id ELSE NULL END,
      quantidade_reservada = p_qty,
      observacao_reserva = p_observacao
    WHERE id = p_item_id;
    v_new_id := p_item_id;
  ELSE
    INSERT INTO public.estoque_produto (
      produto_id, lote_id, microrganismo_id, envase_id,
      quantidade, volume_total, validade, status,
      reservado_para_os_id, reservado_para_os_tipo,
      reservado_para_cliente_id, reservado_para_partner_id, reservado_para_partner_order_id,
      quantidade_reservada, observacao_reserva,
      origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao
    ) VALUES (
      v_item.produto_id, v_item.lote_id, v_item.microrganismo_id, v_item.envase_id,
      p_qty, v_volume_reservado, v_item.validade, 'reservado',
      p_os_id, p_os_tipo,
      CASE WHEN p_os_tipo = 'b2b' THEN NULL ELSE p_cliente_id END,
      CASE WHEN p_os_tipo = 'b2b' THEN p_partner_id ELSE NULL END,
      CASE WHEN p_os_tipo = 'b2b' THEN p_partner_order_id ELSE NULL END,
      p_qty, p_observacao,
      v_item.origem_estoque,v_item.unidade_comercial,v_item.conteudo_por_unidade,v_item.unidade_conteudo,p_qty*v_item.conteudo_por_unidade,v_item.embalagem_id,v_item.embalagem_versao
    ) RETURNING id INTO v_new_id;

    UPDATE public.estoque_produto SET
      quantidade = v_item.quantidade - p_qty,
      quantidade_conteudo = CASE WHEN v_item.conteudo_por_unidade IS NOT NULL THEN (v_item.quantidade-p_qty)*v_item.conteudo_por_unidade ELSE NULL END,
      volume_total = CASE
        WHEN COALESCE(v_item.volume_total, 0) > 0 THEN v_item.volume_total - v_volume_reservado
        ELSE volume_total
      END
    WHERE id = p_item_id;
  END IF;

  PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close();
  RETURN v_new_id;
EXCEPTION WHEN OTHERS THEN PERFORM platform_private.stock_motor_context_set(NULL); PERFORM public.fn_estoque_ctx_close(); RAISE;
END;
$function$;

CREATE OR REPLACE FUNCTION public.rpc_cockpit_criar_entrega_v1(p_os_id uuid, p_origem text, p_itens jsonb, p_request_key text, p_dados jsonb, p_os_observed timestamp with time zone)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE v_org uuid; v_actor uuid:=auth.uid(); v_os public.ordens_servico%ROWTYPE;
 v_item jsonb; v_id uuid; v_qty numeric; v_items jsonb:='[]'; v_fp text;
 v_prev platform_private.delivery_requests_20261030%ROWTYPE; v_batch jsonb; v_call jsonb;
 v_row public.estoque_produto%ROWTYPE; v_free jsonb:='[]'; v_fi integer:=0; v_dk text; v_dv text;
 v_result jsonb:='[]'; v_index integer:=0; v_ent uuid; v_reserved uuid; v_current timestamptz; v_original_client uuid; v_partner uuid;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('group');
 IF p_origem NOT IN ('manual','b2b') OR p_os_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 IF p_os_observed IS NULL THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_REQUIRED' USING ERRCODE='22023'; END IF;
 IF p_request_key IS NULL OR length(btrim(p_request_key))<8 OR length(p_request_key)>128 THEN RAISE EXCEPTION 'DELIVERY_REQUEST_INVALID' USING ERRCODE='22023'; END IF;
 IF p_dados IS NULL OR jsonb_typeof(p_dados)<>'object' OR EXISTS(SELECT 1 FROM jsonb_each(p_dados) WHERE key NOT IN ('data_saida','motorista','veiculo','tipo_entrega','endereco_origem',
   'motorista_telefone','motorista_documento','veiculo_placa','veiculo_tipo','hora_saida_prevista','data_chegada_prevista','hora_chegada_prevista',
   'destinatario_nome','destinatario_telefone','destinatario_whatsapp','endereco_logradouro','endereco_numero','endereco_complemento',
   'endereco_bairro','endereco_cidade','endereco_uf','endereco_cep','endereco_referencia') OR jsonb_typeof(value) NOT IN ('string','null')
   OR (jsonb_typeof(value)='string' AND length(value#>>'{}')>300)) THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END IF;
 FOR v_dk IN SELECT key FROM jsonb_each_text(p_dados) WHERE nullif(value,'') IS NOT NULL LOOP
  v_dv:=p_dados->>v_dk;
  IF v_dk IN ('data_saida','data_chegada_prevista') THEN
   IF v_dv !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END IF;
   BEGIN IF to_char(v_dv::date,'YYYY-MM-DD')<>v_dv THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END IF;
   EXCEPTION WHEN datetime_field_overflow OR invalid_datetime_format THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END;
  ELSIF v_dk IN ('hora_saida_prevista','hora_chegada_prevista') THEN
   IF v_dv !~ '^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$' THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END IF;
  ELSIF v_dk='tipo_entrega' AND v_dv NOT IN ('motorista','retirada') THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023';
  ELSIF v_dk='endereco_origem' AND v_dv NOT IN ('cadastro','personalizado') THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023';
  ELSIF btrim(v_dv)='' OR v_dv ~ '[[:cntrl:]]' THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023';
  END IF;
 END LOOP;
 IF p_itens IS NULL OR jsonb_typeof(p_itens)<>'array' THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
 IF jsonb_array_length(p_itens)=0 OR jsonb_array_length(p_itens)>100 THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_os FROM public.ordens_servico WHERE id=p_os_id AND organization_id=v_org;
 IF NOT FOUND OR (p_origem='manual' AND (v_os.partner_order_id IS NOT NULL OR v_os.origem IS DISTINCT FROM 'agronomica')) OR (p_origem='b2b' AND platform_private.b2b_resale_os_operational_valid_v1(v_os) IS NOT TRUE) THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(
  SELECT 1 FROM jsonb_array_elements(p_itens) x
  JOIN public.estoque_produto s ON s.id=(x.value->>'item_id')::uuid
  WHERE (p_origem='b2b' AND platform_private.resale_pilot_scope_v1('b2b_resale','delivery_create',v_actor,v_org,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=v_os.partner_order_id),v_os.partner_order_id,v_os.partner_order_item_id,s.produto_id,s.id,NULL) IS NOT TRUE)
    OR (p_origem='manual' AND s.origem_estoque IS NOT NULL AND platform_private.resale_pilot_scope_v1('finished_product','delivery_create',v_actor,v_org,NULL,NULL,NULL,s.produto_id,s.id,NULL) IS NOT TRUE)
 ) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 v_original_client:=v_os.cliente_id;
 FOR v_item IN SELECT value FROM jsonb_array_elements(p_itens) LOOP
  IF jsonb_typeof(v_item)<>'object' OR NOT(v_item ? 'item_id' AND v_item ? 'quantidade' AND v_item ? 'observed_updated_at') OR v_item->>'observed_updated_at' IS NULL OR EXISTS(SELECT 1 FROM jsonb_each(v_item) WHERE key NOT IN ('item_id','quantidade','observed_updated_at')) THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
  v_id:=(v_item->>'item_id')::uuid; v_qty:=(v_item->>'quantidade')::numeric;
  IF v_id IS NULL OR v_qty IS NULL OR v_qty<=0 OR v_qty::text IN ('NaN','Infinity','-Infinity') OR EXISTS(SELECT 1 FROM jsonb_array_elements(v_items) WHERE value->>'item_id'=v_id::text) THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
  v_items:=v_items||jsonb_build_array(jsonb_build_object('item_id',v_id,'quantidade',v_qty,'observed_updated_at',(v_item->>'observed_updated_at')::timestamptz));
 END LOOP;
 SELECT jsonb_agg(value ORDER BY value->>'item_id') INTO v_items FROM jsonb_array_elements(v_items);
 v_fp:=md5(jsonb_build_object('actor',v_actor,'org',v_org,'os',p_os_id,'observed',p_os_observed,'origin',p_origem,'items',v_items,'data',p_dados)::text);
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('delivery_request:'||jsonb_build_array(v_org,v_actor,'group',p_request_key)::text,0));
 IF platform_private.delivery_actor_20261030('group') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 -- Canonical global gate is acquired BEFORE every OS/stock row lock.
 PERFORM platform_private.delivery_gate_20261030(v_org,'group');
 SELECT * INTO v_os FROM public.ordens_servico WHERE id=p_os_id AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND OR (p_origem='manual' AND (v_os.partner_order_id IS NOT NULL OR v_os.origem IS DISTINCT FROM 'agronomica')) OR (p_origem='b2b' AND platform_private.b2b_resale_os_operational_valid_v1(v_os) IS NOT TRUE) THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(
  SELECT 1 FROM jsonb_array_elements(p_itens) x
  JOIN public.estoque_produto s ON s.id=(x.value->>'item_id')::uuid
  WHERE (p_origem='b2b' AND platform_private.resale_pilot_allowed_v1('b2b_resale','delivery_create',v_actor,v_org,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=v_os.partner_order_id),v_os.partner_order_id,v_os.partner_order_item_id,s.produto_id,s.id,NULL) IS NOT TRUE)
    OR (p_origem='manual' AND s.origem_estoque IS NOT NULL AND platform_private.resale_pilot_allowed_v1('finished_product','delivery_create',v_actor,v_org,NULL,NULL,NULL,s.produto_id,s.id,NULL) IS NOT TRUE)
 ) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030 WHERE request_key=p_request_key AND actor=v_actor AND organization_id=v_org AND action='group';
 IF FOUND THEN
  IF v_prev.fingerprint IS DISTINCT FROM v_fp THEN RAISE EXCEPTION 'DELIVERY_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  -- Reference scope still binds the replay: client unchanged during the wait, still in tenant, and every receipt
  -- delivery belongs to this tenant/OS/client. Only the fresh-dispatch CAS/status/stock state is not required.
  IF v_os.cliente_id IS DISTINCT FROM v_original_client OR (p_origem='manual' AND NOT EXISTS(SELECT 1 FROM public.clientes WHERE id=v_os.cliente_id AND organization_id=v_org))
  OR EXISTS(SELECT 1 FROM jsonb_array_elements(v_prev.result->'itens') i LEFT JOIN public.entregas e ON e.id=(i.value->>'entrega_id')::uuid
   WHERE e.id IS NULL OR e.organization_id IS DISTINCT FROM v_org OR e.ordem_servico_id IS DISTINCT FROM p_os_id OR e.cliente_id IS DISTINCT FROM v_os.cliente_id OR e.partner_order_id IS DISTINCT FROM (CASE WHEN p_origem='b2b' THEN v_os.partner_order_id ELSE NULL END))
  THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  IF platform_private.delivery_actor_20261030('group') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 SELECT partner_id INTO v_partner FROM public.partner_orders WHERE id=v_os.partner_order_id;
 IF v_os.cliente_id IS DISTINCT FROM v_original_client OR v_os.updated_at IS DISTINCT FROM p_os_observed THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF p_origem='manual' THEN PERFORM 1 FROM public.clientes WHERE id=v_os.cliente_id AND organization_id=v_org FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 ELSIF v_os.cliente_id IS NOT NULL OR v_partner IS NULL THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  v_id:=(v_item->>'item_id')::uuid;
  SELECT * INTO v_row FROM public.estoque_produto WHERE id=v_id FOR UPDATE;
  IF v_row.status::text='reservado' THEN
   IF (p_origem='manual' AND (v_row.reservado_para_os_id IS DISTINCT FROM p_os_id OR v_row.reservado_para_os_tipo IS DISTINCT FROM 'manual'
      OR v_row.reservado_para_cliente_id IS DISTINCT FROM v_os.cliente_id OR v_row.reservado_para_partner_id IS NOT NULL
      OR v_row.reservado_para_partner_order_id IS NOT NULL OR v_row.quantidade_reservada IS DISTINCT FROM v_row.quantidade
      OR v_row.quantidade IS DISTINCT FROM (v_item->>'quantidade')::numeric))
     OR (p_origem='b2b' AND (v_row.reservado_para_os_id IS DISTINCT FROM p_os_id OR v_row.reservado_para_os_tipo IS DISTINCT FROM 'b2b'
      OR v_row.reservado_para_cliente_id IS NOT NULL OR v_row.reservado_para_partner_id IS DISTINCT FROM v_partner
      OR v_row.reservado_para_partner_order_id IS DISTINCT FROM v_os.partner_order_id OR v_row.quantidade_reservada IS DISTINCT FROM v_row.quantidade
      OR v_row.quantidade IS DISTINCT FROM (v_item->>'quantidade')::numeric))
     THEN RAISE EXCEPTION 'DELIVERY_RESERVATION_NOT_OWNED' USING ERRCODE='PT409'; END IF;
   PERFORM platform_private.stock_motor_item(v_id,'expedicao',jsonb_build_object('os_id',p_os_id,'os_tipo',p_origem,'cliente_id',v_os.cliente_id,'partner_id',v_partner,'partner_order_id',v_os.partner_order_id));
  ELSIF v_row.status::text='disponivel' THEN
   PERFORM platform_private.stock_motor_item(v_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo',p_origem,'cliente_id',v_os.cliente_id,'partner_id',v_partner,'partner_order_id',v_os.partner_order_id));
   v_free:=v_free||jsonb_build_array(v_item-'observed_updated_at');
  ELSE RAISE EXCEPTION 'DELIVERY_STOCK_UNAVAILABLE' USING ERRCODE='PT409'; END IF;
  IF platform_private.delivery_actor_20261030('group') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 END LOOP;
 PERFORM platform_private.delivery_gate_20261030(v_org,'group');
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030 WHERE request_key=p_request_key AND actor=v_actor AND organization_id=v_org AND action='group';
 IF FOUND THEN
  IF v_prev.actor IS DISTINCT FROM v_actor OR v_prev.organization_id IS DISTINCT FROM v_org OR v_prev.action IS DISTINCT FROM 'group' OR v_prev.fingerprint IS DISTINCT FROM v_fp THEN RAISE EXCEPTION 'DELIVERY_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 IF v_os.updated_at IS DISTINCT FROM p_os_observed OR v_os.status::text<>'pronto_entrega' THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  SELECT updated_at INTO v_current FROM public.estoque_produto WHERE id=(v_item->>'item_id')::uuid;
  IF v_current IS DISTINCT FROM (v_item->>'observed_updated_at')::timestamptz THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 END LOOP;
 IF EXISTS(SELECT 1 FROM public.entregas WHERE ordem_servico_id=p_os_id AND status::text<>'cancelada' AND estoque_produto_id IN (SELECT (value->>'item_id')::uuid FROM jsonb_array_elements(v_items))) THEN RAISE EXCEPTION 'DELIVERY_EXISTING_UNOWNED' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target) VALUES(pg_catalog.txid_current(),v_actor,v_org,'group',p_os_id);
 IF jsonb_array_length(v_free)>0 THEN
 v_batch:=public.rpc_estoque_reservar_v1(p_os_id,p_origem,v_free,'delivery-reserve:'||md5(jsonb_build_array(v_actor,v_org,p_request_key)::text),CASE WHEN p_origem='b2b' THEN jsonb_build_object('partner_id',v_partner,'partner_order_id',v_os.partner_order_id) ELSE jsonb_build_object('cliente_id',v_os.cliente_id) END);
 IF v_batch->>'ok' IS DISTINCT FROM 'true' OR v_batch->>'replay' IS DISTINCT FROM 'false' OR jsonb_array_length(v_batch->'itens')<>jsonb_array_length(v_free) THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 IF NOT EXISTS(SELECT 1 FROM platform_private.stock_batch_requests WHERE request_key='delivery-reserve:'||md5(jsonb_build_array(v_actor,v_org,p_request_key)::text) AND result=v_batch) THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  IF v_free @> jsonb_build_array(jsonb_build_object('item_id',v_item->'item_id')) THEN
   v_reserved:=(v_batch->'itens'->>v_fi)::uuid; v_fi:=v_fi+1;
  ELSE v_reserved:=(v_item->>'item_id')::uuid; END IF;
  v_qty:=(v_item->>'quantidade')::numeric;
  IF v_reserved IS NULL THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  PERFORM platform_private.delivery_gate_20261030(v_org,'group');
  UPDATE platform_private.delivery_context_20261030 SET item=v_reserved,delivery=NULL,mutation='create' WHERE txid=pg_catalog.txid_current();
  v_call:=public.rpc_cockpit_criar_entrega_v1(p_os_id,p_origem,v_reserved,v_qty,p_dados||CASE WHEN p_origem='b2b' THEN '{}'::jsonb ELSE jsonb_build_object('cliente_id',v_os.cliente_id) END);
  IF v_call->>'success' IS DISTINCT FROM 'true' OR v_call->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CREATE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  v_ent:=(v_call->>'entrega_id')::uuid;
  IF v_ent IS NULL OR NOT EXISTS(SELECT 1 FROM public.entregas WHERE id=v_ent AND organization_id=v_org AND ordem_servico_id=p_os_id AND estoque_produto_id=v_reserved AND quantidade_entregue=v_qty AND receivable_id IS NULL AND partner_order_id IS NOT DISTINCT FROM (CASE WHEN p_origem='b2b' THEN v_os.partner_order_id ELSE NULL END)) THEN RAISE EXCEPTION 'DELIVERY_CREATE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  v_call:=public.rpc_estoque_operar_v1('expedicao',v_reserved,v_qty,'delivery-exp:'||md5(jsonb_build_array(v_actor,v_org,p_request_key,v_index)::text),jsonb_build_object('referencia_tipo','entrega','referencia_id',v_ent,'os_id',p_os_id,'os_tipo',p_origem,'cliente_id',v_os.cliente_id,'partner_id',v_partner,'partner_order_id',v_os.partner_order_id));
  IF v_call->>'ok' IS DISTINCT FROM 'true' OR v_call->>'replay' IS DISTINCT FROM 'false' OR NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE id=(v_call->>'movimentacao_id')::uuid AND estoque_produto_id=v_reserved AND referencia_id=v_ent AND referencia_tipo='entrega' AND acao='expedicao' AND usuario_id=v_actor) THEN RAISE EXCEPTION 'DELIVERY_MOVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  PERFORM platform_private.delivery_gate_20261030(v_org,'group');
  v_result:=v_result||jsonb_build_array(jsonb_build_object('entrega_id',v_ent,'estoque_produto_id',v_reserved,'movimentacao_id',v_call->>'movimentacao_id'));
  v_index:=v_index+1;
 END LOOP;
 v_call:=jsonb_build_object('success',true,'replay',false,'organization_id',v_org,'os_id',p_os_id,'itens',v_result);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_request_key,v_actor,v_org,'group',v_fp,v_call);
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current();
 RETURN v_call;
END $function$;

CREATE OR REPLACE FUNCTION public.rpc_cockpit_criar_entrega_v1(p_os_id uuid, p_origem text, p_estoque_produto_id uuid, p_quantidade numeric, p_dados jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_origem text;
  v_est public.estoque_produto%ROWTYPE;
  v_existente record;
  v_id uuid;
  v_cliente_os uuid;
  v_os public.ordens_servico%ROWTYPE;
BEGIN
  v_origem := public.fn_cockpit_assert_operador_origem(p_origem);

  IF p_os_id IS NULL OR p_estoque_produto_id IS NULL THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_PARAMS_INVALIDOS';
  END IF;
  IF coalesce(p_quantidade, 0) <= 0 THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_QUANTIDADE_INVALIDA';
  END IF;

  PERFORM pg_advisory_xact_lock(hashtext('cockpit_criar_entrega:' || p_os_id::text || ':' || p_estoque_produto_id::text));

  SELECT * INTO v_est
  FROM public.estoque_produto
  WHERE id = p_estoque_produto_id
  FOR UPDATE;

  IF v_est.id IS NULL THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_ESTOQUE_NAO_ENCONTRADO';
  END IF;

  IF v_origem = 'onfarm' THEN
    SELECT cliente_id INTO v_cliente_os
    FROM public.ordens_servico_onfarm
    WHERE id = p_os_id;
  ELSE
    SELECT * INTO v_os FROM public.ordens_servico WHERE id = p_os_id;
    v_cliente_os:=v_os.cliente_id;
  END IF;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_OS_NAO_ENCONTRADA';
  END IF;
  IF v_origem='b2b' AND platform_private.b2b_resale_os_valid_v1(v_os) IS NOT TRUE THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501';END IF;
  IF v_est.origem_estoque IS NOT NULL AND ((v_origem='b2b' AND platform_private.resale_pilot_allowed_v1('b2b_resale','delivery_create',auth.uid(),v_os.organization_id,(SELECT po.partner_id FROM public.partner_orders po WHERE po.id=v_os.partner_order_id),v_os.partner_order_id,v_os.partner_order_item_id,v_est.produto_id,v_est.id,NULL) IS NOT TRUE)
   OR (v_origem='manual' AND platform_private.resale_pilot_allowed_v1('finished_product','delivery_create',auth.uid(),v_os.organization_id,NULL,NULL,NULL,v_est.produto_id,v_est.id,NULL) IS NOT TRUE)) THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501';END IF;

  IF v_est.status::text NOT IN ('reservado', 'expedido') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_STATUS_ESTOQUE_INVALIDO';
  END IF;
  IF v_est.reservado_para_os_id IS DISTINCT FROM p_os_id THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_ESTOQUE';
  END IF;
  IF coalesce(v_est.reservado_para_os_tipo, v_origem) IS DISTINCT FROM v_origem THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_ORIGEM';
  END IF;
  IF p_quantidade > coalesce(v_est.quantidade, 0) THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_QUANTIDADE_EXCEDE_RESERVA';
  END IF;
  IF v_origem='b2b' AND (v_est.reservado_para_partner_order_id IS DISTINCT FROM v_os.partner_order_id OR v_est.reservado_para_partner_id IS DISTINCT FROM (SELECT partner_id FROM public.partner_orders WHERE id=v_os.partner_order_id)) THEN RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_PARCEIRO' USING ERRCODE='42501';END IF;
  IF v_est.reservado_para_cliente_id IS NOT NULL
     AND v_est.reservado_para_cliente_id IS DISTINCT FROM v_cliente_os THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_CLIENTE';
  END IF;
  IF nullif(p_dados->>'cliente_id','') IS NOT NULL
     AND nullif(p_dados->>'cliente_id','')::uuid IS DISTINCT FROM v_cliente_os THEN
    RAISE EXCEPTION 'COCKPIT_RELATION_MISMATCH_ENTREGA_CLIENTE';
  END IF;

  SELECT e.id, e.status::text AS status INTO v_existente
  FROM public.entregas e
  WHERE e.estoque_produto_id = p_estoque_produto_id
    AND e.status::text <> 'cancelada'
    AND (
      (v_origem = 'onfarm' AND e.ordem_servico_onfarm_id = p_os_id)
      OR (v_origem <> 'onfarm' AND e.ordem_servico_id = p_os_id)
    )
  ORDER BY e.created_at DESC
  LIMIT 1;

  IF v_existente.id IS NOT NULL THEN
    RETURN jsonb_build_object('success', true, 'replay', true, 'entrega_id', v_existente.id, 'status', v_existente.status, 'message', 'Entrega ja registrada para este item da OS.');
  END IF;


  IF coalesce(nullif(p_dados->>'tipo_entrega',''), 'motorista') NOT IN ('motorista','retirada') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_MODALIDADE_INVALIDA';
  END IF;
  IF coalesce(nullif(p_dados->>'endereco_origem',''), 'cadastro') NOT IN ('cadastro','personalizado') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_ENDERECO_ORIGEM_INVALIDA';
  END IF;
  IF v_est.quantidade IS NULL OR v_est.quantidade <= 0 THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_VOLUME_ESTOQUE_INVALIDO';
  END IF;
  IF v_est.origem_estoque IS NOT NULL THEN
    IF platform_private.finished_product_stock_valid_v1(v_est) IS NOT TRUE THEN
      RAISE EXCEPTION 'FINISHED_PRODUCT_STOCK_CONTRACT_DENIED' USING ERRCODE='23514';
    END IF;
  ELSIF v_est.volume_total IS NULL OR v_est.volume_total <= 0 OR v_est.volume_total::text IN ('NaN','Infinity','-Infinity') THEN
    RAISE EXCEPTION 'COCKPIT_ENTREGA_VOLUME_ESTOQUE_INVALIDO';
  END IF;

  INSERT INTO public.entregas (
    ordem_servico_id, ordem_servico_onfarm_id, estoque_produto_id,
    lote_id, produto_id, quantidade_entregue, status, cliente_id,
    data_saida, motorista, veiculo, partner_order_id,
    origem_estoque,unidade_comercial,conteudo_por_unidade,unidade_conteudo,quantidade_conteudo,embalagem_id,embalagem_versao
  ) VALUES (
    CASE WHEN v_origem = 'onfarm' THEN NULL ELSE p_os_id END,
    CASE WHEN v_origem = 'onfarm' THEN p_os_id ELSE NULL END,
    p_estoque_produto_id,
    v_est.lote_id,
    v_est.produto_id,
    p_quantidade,
    'separado'::public.status_entrega,
    v_cliente_os,
    nullif(p_dados->>'data_saida','')::date,
    nullif(p_dados->>'motorista',''),
    nullif(p_dados->>'veiculo',''), CASE WHEN v_origem='b2b' THEN v_os.partner_order_id ELSE NULL END,
    v_est.origem_estoque,v_est.unidade_comercial,v_est.conteudo_por_unidade,v_est.unidade_conteudo,CASE WHEN v_est.origem_estoque='compra_produto_acabado_revenda' THEN p_quantidade*v_est.conteudo_por_unidade ELSE NULL END,v_est.embalagem_id,v_est.embalagem_versao
  ) RETURNING id INTO v_id;


  -- Only newly created delivery: preserve replay semantics and never overwrite existing history.
  UPDATE public.entregas SET
    volume_entregue_ml = CASE WHEN v_est.origem_estoque='compra_produto_acabado_revenda' AND v_est.unidade_conteudo IN ('kg','g') THEN NULL ELSE round((v_est.volume_total / v_est.quantidade) * p_quantidade * 1000, 6) END,
    tipo_entrega = coalesce(nullif(p_dados->>'tipo_entrega',''), 'motorista'),
    endereco_origem = coalesce(nullif(p_dados->>'endereco_origem',''), 'cadastro'),
    grupo_entrega_id = nullif(p_dados->>'grupo_entrega_id','')::uuid,
    hora_saida_prevista = nullif(p_dados->>'hora_saida_prevista','')::time,
    data_chegada_prevista = nullif(p_dados->>'data_chegada_prevista','')::date,
    hora_chegada_prevista = nullif(p_dados->>'hora_chegada_prevista','')::time,
    motorista_telefone = nullif(p_dados->>'motorista_telefone',''),
    motorista_documento = nullif(p_dados->>'motorista_documento',''),
    veiculo_placa = nullif(p_dados->>'veiculo_placa',''),
    veiculo_tipo = nullif(p_dados->>'veiculo_tipo',''),
    destinatario_nome = nullif(p_dados->>'destinatario_nome',''),
    destinatario_telefone = nullif(p_dados->>'destinatario_telefone',''),
    destinatario_whatsapp = nullif(p_dados->>'destinatario_whatsapp',''),
    endereco_logradouro = nullif(p_dados->>'endereco_logradouro',''),
    endereco_numero = nullif(p_dados->>'endereco_numero',''),
    endereco_complemento = nullif(p_dados->>'endereco_complemento',''),
    endereco_bairro = nullif(p_dados->>'endereco_bairro',''),
    endereco_cidade = nullif(p_dados->>'endereco_cidade',''),
    endereco_uf = nullif(p_dados->>'endereco_uf',''),
    endereco_cep = nullif(p_dados->>'endereco_cep',''),
    endereco_referencia = nullif(p_dados->>'endereco_referencia','')
  WHERE id = v_id;

  INSERT INTO public.laboratorio_esteira_eventos
    (os_id, origem_os, etapa_nova, acao, usuario_id, observacao)
  VALUES
    (p_os_id, v_origem, 'entrega_criada', 'criar_entrega_v1', v_uid,
     format('Entrega %s criada (motor transacional).', v_id));

  RETURN jsonb_build_object('success', true, 'replay', false, 'entrega_id', v_id, 'status', 'separado', 'message', 'Entrega registrada. Confirme a entrega para concluir a OS.');
END;
$function$;

CREATE OR REPLACE FUNCTION platform_private.delivery_send_apply_v1(p_entrega uuid, p_observed timestamp with time zone, p_key text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE org uuid; v_actor uuid:=auth.uid(); e public.entregas; initial public.entregas; s public.estoque_produto; l public.lotes; pp public.programacao_producao; c public.entrega_comprovantes; prev platform_private.delivery_requests_20261030;
 fp text; result jsonb; ack jsonb; pend int; total numeric; reserved numeric; finalizada boolean:=false; os_status text; p jsonb; k text; v jsonb; path text; image jsonb; proof_image jsonb;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'DELIVERY_SEND_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 org:=platform_private.delivery_confirm_actor_v1();
 IF p_entrega IS NULL OR p_observed IS NULL OR NOT isfinite(p_observed) OR p_key IS NULL OR p_key !~ '^[A-Za-z0-9:_-]{8,128}$' THEN RAISE EXCEPTION 'DELIVERY_SEND_INVALID' USING ERRCODE='22023'; END IF;
 p:='{}';
 initial:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 fp:=encode(extensions.digest(jsonb_build_array(v_actor,org,p_entrega,p_observed,p)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtextextended('delivery_send:'||jsonb_build_array(v_actor,org,p_key)::text,0));
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SEND_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.organizations WHERE id=org AND ativo FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.ordens_servico WHERE id=initial.ordem_servico_id AND organization_id=org FOR UPDATE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.entregas WHERE id=p_entrega AND organization_id=org FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF e.status::text='cancelada' THEN RAISE EXCEPTION 'DELIVERY_SEND_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF e.ordem_servico_id IS DISTINCT FROM initial.ordem_servico_id OR e.estoque_produto_id IS DISTINCT FROM initial.estoque_produto_id OR e.cliente_id IS DISTINCT FROM initial.cliente_id OR e.lote_id IS DISTINCT FROM initial.lote_id OR e.partner_order_id IS DISTINCT FROM initial.partner_order_id THEN RAISE EXCEPTION 'DELIVERY_SEND_ROOT_CHANGED' USING ERRCODE='42501'; END IF;
 IF e.cliente_id IS NOT NULL THEN PERFORM 1 FROM public.clientes WHERE id=e.cliente_id AND organization_id=org FOR SHARE; END IF;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO s FROM public.estoque_produto WHERE id=e.estoque_produto_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO l FROM public.lotes WHERE id=s.lote_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO pp FROM public.programacao_producao WHERE id=l.programacao_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF s.id IS NULL OR l.id IS NULL OR e.lote_id IS DISTINCT FROM l.id
 OR s.produto_id IS DISTINCT FROM l.produto_id OR e.produto_id IS DISTINCT FROM l.produto_id
 OR (s.origem_estoque IS NULL AND (pp.id IS NULL OR pp.ordem_servico_id IS DISTINCT FROM e.ordem_servico_id OR pp.ordem_servico_onfarm_id IS NOT NULL OR pp.produto_id IS DISTINCT FROM l.produto_id))
 OR (s.origem_estoque IS NOT NULL AND platform_private.finished_product_delivery_valid_v1(s,e,l) IS NOT TRUE)
 OR (e.partner_order_id IS NULL AND (s.reservado_para_os_id IS DISTINCT FROM e.ordem_servico_id OR s.reservado_para_os_tipo IS DISTINCT FROM 'manual' OR s.reservado_para_cliente_id IS DISTINCT FROM e.cliente_id OR s.reservado_para_partner_order_id IS NOT NULL))
 OR (e.partner_order_id IS NOT NULL AND platform_private.b2b_resale_delivery_lineage_valid_v1(s,e,l) IS NOT TRUE)
 THEN RAISE EXCEPTION 'DELIVERY_SEND_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;

 IF s.status::text<>'expedido' OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
 OR (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND os_id=e.ordem_servico_id AND os_tipo=CASE WHEN e.partner_order_id IS NOT NULL THEN 'b2b' ELSE 'manual' END AND lote_id=l.id AND quantidade=e.quantidade_entregue)<>1
 OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('estorno_expedicao','entrega','devolucao'))
 OR NOT EXISTS(SELECT 1 FROM public.ordens_servico WHERE id=e.ordem_servico_id AND organization_id=org AND status::text IN ('pronto_entrega','entregue')) THEN RAISE EXCEPTION 'DELIVERY_SEND_STATE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id ORDER BY id FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'send',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO prev FROM platform_private.delivery_requests_20261030 WHERE organization_id=org AND actor=v_actor AND action='send' AND request_key=p_key;
 IF FOUND THEN
  IF prev.fingerprint IS DISTINCT FROM fp OR e.status::text<>'em_rota' THEN RAISE EXCEPTION 'DELIVERY_SEND_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN prev.result||jsonb_build_object('replay',true);
 END IF;
 IF e.status::text<>'separado' OR e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_SEND_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 image:=to_jsonb(e)||jsonb_build_object('status','em_rota','updated_at',now());
 INSERT INTO platform_private.delivery_send_permits_v1 VALUES(txid_current(),v_actor,org,e.id,to_jsonb(e),image,false);
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_actor,org,'send',e.id,'send');
 UPDATE public.entregas SET status='em_rota' WHERE id=e.id AND updated_at=p_observed RETURNING * INTO e;
 IF e.id IS NULL OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_send_permits_v1 WHERE txid=txid_current() AND consumed) OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done') THEN RAISE EXCEPTION 'DELIVERY_SEND_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 result:=jsonb_build_object('success',true,'action','send','replay',false,'actor_id',v_actor,'organization_id',org,'entrega_id',e.id,'os_id',e.ordem_servico_id,'status','em_rota','updated_at',e.updated_at);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_key,v_actor,org,'send',fp,result);
 DELETE FROM platform_private.delivery_send_permits_v1 WHERE txid=txid_current();DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();RETURN result;
 END $function$;

CREATE OR REPLACE FUNCTION platform_private.delivery_confirm_apply_v1(p_entrega uuid, p_observed timestamp with time zone, p_key text, p_recebedor jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE org uuid; v_actor uuid:=auth.uid(); e public.entregas; initial public.entregas; s public.estoque_produto; l public.lotes; pp public.programacao_producao; c public.entrega_comprovantes; prev platform_private.delivery_requests_20261030;
 fp text; result jsonb; ack jsonb; pend int; total numeric; reserved numeric; finalizada boolean:=false; os_status text; p jsonb; k text; v jsonb; path text; image jsonb; proof_image jsonb;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 org:=platform_private.delivery_confirm_actor_v1();
 IF p_entrega IS NULL OR p_observed IS NULL OR p_key IS NULL OR p_key !~ '^[A-Za-z0-9:_-]{8,128}$' OR p_recebedor IS NULL OR jsonb_typeof(p_recebedor)<>'object' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
 p:='{}';
 FOR k,v IN SELECT * FROM jsonb_each(p_recebedor) LOOP
  IF k NOT IN ('nome','cargo','documento','observacoes') OR jsonb_typeof(v) NOT IN ('string','null') OR length(coalesce(v#>>'{}',''))>(CASE WHEN k='observacoes' THEN 1000 ELSE 255 END) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
  p:=p||jsonb_build_object(k,nullif(btrim(v#>>'{}'),''));
 END LOOP;
 IF nullif(p->>'nome','') IS NULL THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_RECEIVER_REQUIRED' USING ERRCODE='22023'; END IF;
 initial:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 fp:=encode(extensions.digest(jsonb_build_array(v_actor,org,p_entrega,p_observed,p)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtextextended('delivery_confirm:'||jsonb_build_array(v_actor,org,p_key)::text,0));
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.organizations WHERE id=org AND ativo FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF initial.partner_order_id IS NOT NULL THEN
  PERFORM 1 FROM public.partner_orders WHERE id=initial.partner_order_id FOR UPDATE;
  PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 END IF;
 PERFORM 1 FROM public.ordens_servico WHERE id=initial.ordem_servico_id AND organization_id=org FOR UPDATE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.entregas WHERE id=p_entrega AND organization_id=org FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF e.status::text='cancelada' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF e.ordem_servico_id IS DISTINCT FROM initial.ordem_servico_id OR e.estoque_produto_id IS DISTINCT FROM initial.estoque_produto_id OR e.cliente_id IS DISTINCT FROM initial.cliente_id OR e.lote_id IS DISTINCT FROM initial.lote_id OR e.partner_order_id IS DISTINCT FROM initial.partner_order_id THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ROOT_CHANGED' USING ERRCODE='42501'; END IF;
 IF e.cliente_id IS NOT NULL THEN PERFORM 1 FROM public.clientes WHERE id=e.cliente_id AND organization_id=org FOR SHARE; END IF;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO s FROM public.estoque_produto WHERE id=e.estoque_produto_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO l FROM public.lotes WHERE id=s.lote_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO pp FROM public.programacao_producao WHERE id=l.programacao_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF s.id IS NULL OR l.id IS NULL OR e.lote_id IS DISTINCT FROM l.id
 OR s.produto_id IS DISTINCT FROM l.produto_id OR e.produto_id IS DISTINCT FROM l.produto_id
 OR (s.origem_estoque IS NULL AND (pp.id IS NULL OR pp.ordem_servico_id IS DISTINCT FROM e.ordem_servico_id OR pp.ordem_servico_onfarm_id IS NOT NULL OR pp.produto_id IS DISTINCT FROM l.produto_id))
 OR (s.origem_estoque IS NOT NULL AND platform_private.finished_product_delivery_valid_v1(s,e,l) IS NOT TRUE)
 OR (e.partner_order_id IS NULL AND (s.reservado_para_os_id IS DISTINCT FROM e.ordem_servico_id OR s.reservado_para_os_tipo IS DISTINCT FROM 'manual' OR s.reservado_para_cliente_id IS DISTINCT FROM e.cliente_id OR s.reservado_para_partner_order_id IS NOT NULL))
 OR (e.partner_order_id IS NOT NULL AND platform_private.b2b_resale_delivery_lineage_valid_v1(s,e,l) IS NOT TRUE)
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.entrega_comprovantes WHERE id=e.comprovante_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 c:=platform_private.delivery_confirm_proof_v1(e);
 path:=CASE WHEN c.assinatura_tipo='digital_tela' THEN c.assinatura_digital_png_path ELSE c.arquivo_path END;
 IF path IS NOT NULL THEN
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=path FOR SHARE;
  e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF; c:=platform_private.delivery_confirm_proof_v1(e);
 END IF;
 SELECT * INTO prev FROM platform_private.delivery_requests_20261030 WHERE organization_id=org AND actor=v_actor AND action='confirm' AND request_key=p_key;
 IF FOUND THEN
  SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
  IF (os_status NOT IN ('entregue','finalizada') AND NOT (e.partner_order_id IS NOT NULL AND os_status='pronto_entrega')) OR s.status::text<>'expedido' OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
   OR (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue AND os_id=e.ordem_servico_id AND os_tipo=CASE WHEN e.partner_order_id IS NOT NULL THEN 'b2b' ELSE 'manual' END AND lote_id=l.id)<>1
   OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('entrega','estorno_expedicao','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_STATE_DENIED' USING ERRCODE='42501'; END IF;
  IF prev.fingerprint IS DISTINCT FROM fp OR e.status::text<>'entregue' OR c.status<>'confirmado' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN prev.result||jsonb_build_object('replay',true);
 END IF;
 IF e.status::text='entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEGACY_REVIEW_REQUIRED' USING ERRCODE='PT409'; END IF;
 IF e.status::text NOT IN ('separado','em_rota') OR e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
 IF os_status NOT IN ('pronto_entrega','entregue') OR s.status::text<>'expedido' OR e.quantidade_entregue IS NULL OR e.quantidade_entregue<=0 OR e.quantidade_entregue::text IN ('NaN','Infinity','-Infinity')
 OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_STATE_CONFLICT' USING ERRCODE='PT409'; END IF;
 -- Expedition was already performed by the reviewed group motor. Do not repeat it.
 IF (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue AND os_id=e.ordem_servico_id AND os_tipo=CASE WHEN e.partner_order_id IS NOT NULL THEN 'b2b' ELSE 'manual' END AND lote_id=l.id)<>1
 OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('estorno_expedicao','entrega','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEDGER_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id ORDER BY id FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF (e.partner_order_id IS NOT NULL OR e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'confirm',v_actor,org,e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Sob o lock do pedido, medir cobertura antes de qualquer confirmação.
 IF e.partner_order_id IS NOT NULL AND EXISTS(
  SELECT 1 FROM public.ordens_servico target_os
  JOIN public.partner_order_items i ON i.id=target_os.partner_order_item_id AND i.order_id=e.partner_order_id
  WHERE target_os.id=e.ordem_servico_id AND
   coalesce((SELECT sum(d.quantidade_entregue) FROM public.entregas d
    JOIN public.ordens_servico other_os ON other_os.id=d.ordem_servico_id
    WHERE other_os.partner_order_item_id=i.id AND d.partner_order_id=e.partner_order_id
     AND d.status::text='entregue' AND d.id<>e.id),0)+e.quantidade_entregue>i.quantidade
 ) THEN RAISE EXCEPTION 'B2B_RESALE_OVERDELIVERY' USING ERRCODE='PT409'; END IF;
 image:=to_jsonb(e)||jsonb_build_object('status','entregue','entregue_em',now(),'recebido_por_nome',p->>'nome','recebido_por_cargo',coalesce(p->>'cargo',e.recebido_por_cargo),'recebido_por_documento',coalesce(p->>'documento',e.recebido_por_documento),'observacoes_confirmacao',coalesce(p->>'observacoes',e.observacoes_confirmacao),'confirmado_por',v_actor,'recebimento_confirmado_em',now(),'recebimento_confirmado_por',v_actor,'comprovante_status','confirmado','updated_at',now());
 proof_image:=to_jsonb(c)||jsonb_build_object('status','confirmado','confirmado_por',v_actor,'confirmado_em',now(),'updated_at',now());
 INSERT INTO platform_private.delivery_confirm_permits_v1(txid,actor,organization_id,target,proof,old_delivery,new_delivery,old_proof,new_proof) VALUES(txid_current(),v_actor,org,e.id,c.id,to_jsonb(e),image,to_jsonb(c),proof_image);
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_actor,org,'confirm',e.id,'confirm');
 UPDATE public.entrega_comprovantes SET status='confirmado',confirmado_por=v_actor,confirmado_em=now(),updated_at=now() WHERE id=c.id;
 c:=platform_private.delivery_confirm_proof_v1(e);
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 UPDATE public.entregas SET status='entregue',entregue_em=now(),recebido_por_nome=p->>'nome',recebido_por_cargo=coalesce(p->>'cargo',recebido_por_cargo),recebido_por_documento=coalesce(p->>'documento',recebido_por_documento),observacoes_confirmacao=coalesce(p->>'observacoes',observacoes_confirmacao),confirmado_por=v_actor,
 recebimento_confirmado_em=now(),recebimento_confirmado_por=v_actor,comprovante_status='confirmado' WHERE id=e.id AND updated_at=p_observed;
 IF NOT FOUND OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done') THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 IF e.partner_order_id IS NULL OR EXISTS(
  SELECT 1 FROM public.ordens_servico target_os
  JOIN public.partner_order_items i ON i.id=target_os.partner_order_item_id AND i.order_id=e.partner_order_id
  WHERE target_os.id=e.ordem_servico_id AND i.quantidade=(
   SELECT coalesce(sum(d.quantidade_entregue),0) FROM public.entregas d
   WHERE d.ordem_servico_id=target_os.id AND d.partner_order_id=e.partner_order_id AND d.status::text='entregue')
 ) THEN
 ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','enviar_entrega',NULL);
 IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ADVANCE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 END IF;
 -- Coverage is independently measured per programming/product in canonical millilitres.
 -- Cancelled deliveries and reversed reservations never cover outstanding demand.
 PERFORM 1 FROM public.programacao_producao WHERE ordem_servico_id=e.ordem_servico_id ORDER BY id FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT count(*) INTO pend FROM public.entregas WHERE ordem_servico_id=e.ordem_servico_id AND status::text NOT IN ('entregue','cancelada');
 IF pend=0 AND EXISTS(SELECT 1 FROM public.programacao_producao WHERE ordem_servico_id=e.ordem_servico_id)
 AND NOT EXISTS(
  SELECT 1 FROM public.programacao_producao demand WHERE demand.ordem_servico_id=e.ordem_servico_id AND (
   demand.organization_id IS DISTINCT FROM org OR demand.produto_id IS NULL OR demand.volume_necessario IS NULL OR demand.volume_necessario<=0 OR demand.volume_necessario::text IN ('NaN','Infinity','-Infinity')
   OR coalesce((SELECT sum(st.volume_total*1000) FROM public.entregas delivered JOIN public.estoque_produto st ON st.id=delivered.estoque_produto_id JOIN public.lotes lot ON lot.id=st.lote_id
    WHERE delivered.ordem_servico_id=e.ordem_servico_id AND delivered.organization_id=org AND delivered.status::text='entregue' AND lot.programacao_id=demand.id AND lot.organization_id=org
    AND lot.produto_id=demand.produto_id AND st.produto_id=demand.produto_id AND delivered.produto_id=demand.produto_id AND delivered.lote_id=lot.id
    AND st.status::text='expedido' AND st.reservado_para_os_id=e.ordem_servico_id AND st.reservado_para_os_tipo='manual'
    AND st.quantidade=delivered.quantidade_entregue AND st.quantidade_reservada=delivered.quantidade_entregue AND st.volume_total>0 AND st.volume_total::text NOT IN ('NaN','Infinity','-Infinity')
    AND NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes m WHERE m.estoque_produto_id=st.id AND m.referencia_id=delivered.id AND m.acao IN ('estorno_expedicao','devolucao','entrega'))),0)<demand.volume_necessario)) THEN
  ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','finalizar_os',NULL);
  IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'finalizada' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_FINALIZE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  finalizada:=true;
 END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 result:=jsonb_build_object('success',true,'action','confirm','replay',false,'actor_id',v_actor,'organization_id',org,'entrega_id',e.id,'os_id',e.ordem_servico_id,'comprovante_id',c.id,'status','entregue','os_status',(SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id),'finalizada',finalizada,'updated_at',(SELECT updated_at FROM public.entregas WHERE id=e.id));
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_key,v_actor,org,'confirm',fp,result);
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current() AND delivery_consumed AND proof_consumed) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_EXACT_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 DELETE FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current();
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();
 RETURN result;
END $function$;

CREATE OR REPLACE FUNCTION public.rpc_entrega_cancelar_v1(p_entrega_id uuid, p_motivo text, p_observed timestamp with time zone)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE v_org uuid; v_actor uuid:=auth.uid(); v_e public.entregas%ROWTYPE; v_s public.estoque_produto%ROWTYPE;
 v_m public.estoque_movimentacoes%ROWTYPE; v_result jsonb; v_key text; v_fp text; v_prev platform_private.delivery_requests_20261030%ROWTYPE;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('cancel');
 IF p_entrega_id IS NULL OR p_motivo IS NULL OR length(btrim(p_motivo))=0 OR p_observed IS NULL THEN RAISE EXCEPTION 'DELIVERY_CANCEL_INVALID' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtext('entrega_cancelar:'||p_entrega_id::text));
 IF platform_private.delivery_actor_20261030('cancel') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'cancel',v_actor,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF platform_private.delivery_actor_20261030('cancel') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF v_e.ordem_servico_onfarm_id IS NOT NULL OR v_e.receivable_id IS NOT NULL OR v_e.status::text='entregue'
 OR (v_e.partner_order_id IS NULL AND NOT EXISTS(SELECT 1 FROM public.ordens_servico WHERE id=v_e.ordem_servico_id AND organization_id=v_org AND origem='agronomica' AND partner_order_id IS NULL))
 OR (v_e.partner_order_id IS NOT NULL AND platform_private.b2b_resale_delivery_order_valid_v1(v_e) IS NOT TRUE)
 THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 v_key:='cancel:'||p_entrega_id::text; v_fp:=md5(jsonb_build_array(v_actor,v_org,p_entrega_id,btrim(p_motivo),p_observed)::text);
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=v_e.estoque_produto_id FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_STOCK_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.stock_motor_item(v_s.id,'cancelamento_reserva',jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id));
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'cancel',v_actor,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_e.partner_order_id IS NULL THEN PERFORM 1 FROM public.ordens_servico WHERE id=v_e.ordem_servico_id AND organization_id=v_org AND origem='agronomica' AND partner_order_id IS NULL AND cliente_id=v_e.cliente_id FOR UPDATE;
 ELSE PERFORM 1 FROM public.ordens_servico WHERE id=v_e.ordem_servico_id AND organization_id=v_org AND origem='b2b' AND partner_order_id=v_e.partner_order_id AND cliente_id IS NULL FOR UPDATE;
 END IF;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 IF v_e.cliente_id IS NOT NULL THEN PERFORM 1 FROM public.clientes WHERE id=v_e.cliente_id AND organization_id=v_org FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'cancel',v_actor,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030 WHERE request_key=v_key AND actor=v_actor AND organization_id=v_org AND action='cancel';
 IF FOUND THEN
  IF v_prev.actor IS DISTINCT FROM v_actor OR v_prev.organization_id IS DISTINCT FROM v_org OR v_prev.fingerprint IS DISTINCT FROM v_fp OR v_prev.action IS DISTINCT FROM 'cancel' OR v_e.status::text<>'cancelada' THEN RAISE EXCEPTION 'DELIVERY_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 IF v_e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF v_e.status::text NOT IN ('separado','em_rota') OR v_s.reservado_para_os_id IS DISTINCT FROM v_e.ordem_servico_id OR v_s.reservado_para_os_tipo IS DISTINCT FROM (CASE WHEN v_e.partner_order_id IS NULL THEN 'manual' ELSE 'b2b' END)
 OR (v_e.partner_order_id IS NOT NULL AND (v_s.reservado_para_cliente_id IS NOT NULL OR v_s.reservado_para_partner_order_id IS DISTINCT FROM v_e.partner_order_id OR v_s.reservado_para_partner_id IS DISTINCT FROM (SELECT partner_id FROM public.partner_orders WHERE id=v_e.partner_order_id))) THEN RAISE EXCEPTION 'DELIVERY_CANCEL_STATE_CONFLICT' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target) VALUES(pg_catalog.txid_current(),v_actor,v_org,'cancel',v_e.id);
 IF (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_s.id AND referencia_tipo='entrega' AND referencia_id=v_e.id AND acao='expedicao')<>1 THEN RAISE EXCEPTION 'DELIVERY_CANCEL_LEDGER_UNPROVEN' USING ERRCODE='PT409'; END IF;
 SELECT * INTO v_m FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_s.id AND referencia_tipo='entrega' AND referencia_id=v_e.id AND acao='expedicao' FOR UPDATE;
 v_result:=public.rpc_estoque_operar_v1('estorno_expedicao',v_s.id,NULL,'delivery-cancel-exp:'||v_e.id::text,jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id,'movimentacao_origem_id',v_m.id,'motivo',btrim(p_motivo)));
 IF v_result->>'ok' IS DISTINCT FROM 'true' OR v_result->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'cancel',v_actor,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=v_e.estoque_produto_id;
 IF v_s.status::text<>'reservado' OR v_s.quantidade_reservada IS DISTINCT FROM v_e.quantidade_entregue THEN RAISE EXCEPTION 'DELIVERY_CANCEL_BALANCE_CONFLICT' USING ERRCODE='PT409'; END IF;
 v_result:=public.rpc_estoque_operar_v1('cancelamento_reserva',v_s.id,v_s.quantidade_reservada,'delivery-cancel-res:'||v_e.id::text,jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id,'motivo',btrim(p_motivo)));
 IF v_result->>'ok' IS DISTINCT FROM 'true' OR v_result->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'cancel',v_actor,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 UPDATE platform_private.delivery_context_20261030 SET mutation='cancel' WHERE txid=pg_catalog.txid_current();
 UPDATE public.entregas SET status='cancelada',motivo_cancelamento=btrim(p_motivo) WHERE id=v_e.id AND organization_id=v_org;
 IF NOT FOUND OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND consumed) THEN RAISE EXCEPTION 'DELIVERY_CANCEL_TICKET_INVALID' USING ERRCODE='42501'; END IF;
 v_result:=jsonb_build_object('success',true,'replay',false,'organization_id',v_org,'entrega_id',v_e.id,'estoque_estornado',true,'reserva_liberada',true);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(v_key,v_actor,v_org,'cancel',v_fp,v_result);
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current();
 RETURN v_result;
END $function$;

CREATE OR REPLACE FUNCTION platform_private.delivery_proof_apply_20261030(p_action text, p_entrega uuid, p_request_key text, p_payload jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE v_uid uuid:=auth.uid(); v_org uuid; v_e public.entregas%ROWTYPE; v_c public.entrega_comprovantes%ROWTYPE;
 v_p jsonb; v_fp text; v_prev platform_private.delivery_requests_20261030%ROWTYPE; v_action text:='proof:'||p_action;
 v_path text; v_num text; v_token uuid; v_hash text; v_result jsonb; v_reused boolean:=false;
BEGIN
 v_org:=platform_private.delivery_proof_actor_20261030();
 IF p_entrega IS NULL OR p_request_key IS NULL OR p_request_key !~ '^[A-Za-z0-9:_-]{8,128}$' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: key' USING ERRCODE='22023'; END IF;
 v_p:=platform_private.delivery_proof_payload_20261030(p_action,p_entrega,p_payload);
 v_fp:=pg_catalog.md5(pg_catalog.jsonb_build_object('entrega',p_entrega,'action',p_action,'payload',v_p)::text);
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega AND organization_id=v_org;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtext('entrega_proof:'||p_entrega::text));
 IF platform_private.delivery_proof_actor_20261030() IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_proof_gate_20261030(v_org);
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Replay only after full reauthorization under every lock (re-read, not the pre-lock copy).
 v_e:=platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',v_uid,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030
 WHERE organization_id=v_org AND actor=v_uid AND action=v_action AND request_key=p_request_key;
 IF FOUND THEN
  IF v_prev.fingerprint<>v_fp THEN RAISE EXCEPTION 'DELIVERY_PROOF_REQUEST_CONFLICT' USING ERRCODE='PT409'; END IF;
-- Injected only into exact sign receipt replay, after canonical actor/tenant/row locks.
-- No receipt/proof rewrite. Only a cryptographically reconstructed legacy delivery hash.
IF p_action='sign' THEN
 SELECT * INTO v_c FROM public.entrega_comprovantes WHERE id=v_e.comprovante_id AND entrega_id=v_e.id FOR UPDATE;
 v_e:=platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',v_uid,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_c.id IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_REPLAY_STATE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_e.validation_hash IS DISTINCT FROM v_c.validation_hash THEN
  v_path:=v_p->>'assinatura_digital_png_path';
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=v_path AND owner_id=v_uid::text FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
  v_e:=platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',v_uid,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,v_org);
  IF v_prev.result->>'success' IS DISTINCT FROM 'true' OR v_prev.result->>'action' IS DISTINCT FROM 'sign'
   OR v_prev.result->>'entrega_id' IS DISTINCT FROM v_e.id::text OR v_prev.result->>'comprovante_id' IS DISTINCT FROM v_c.id::text
   OR v_prev.result->>'object_path' IS DISTINCT FROM v_path OR v_prev.result->>'validation_token' IS DISTINCT FROM v_c.validation_token::text
   OR v_prev.result->>'numero_formulario' IS DISTINCT FROM v_c.numero_formulario
   OR v_e.comprovante_id IS DISTINCT FROM v_c.id OR v_c.entrega_id IS DISTINCT FROM v_e.id
   OR v_e.status::text NOT IN ('separado','em_rota') OR v_c.status IS DISTINCT FROM 'assinatura_digital_coletada'
   OR v_e.comprovante_status IS DISTINCT FROM 'assinatura_digital_coletada' OR v_c.tipo IS DISTINCT FROM 'formulario_entrega'
   OR v_c.assinatura_coletada IS NOT TRUE OR v_c.assinatura_tipo IS DISTINCT FROM 'digital_tela' OR v_e.assinatura_tipo IS DISTINCT FROM 'digital_tela'
   OR v_c.validation_token IS NULL OR v_e.validation_token IS DISTINCT FROM v_c.validation_token
   OR v_c.gerado_por IS DISTINCT FROM v_uid OR v_e.formulario_gerado_por IS DISTINCT FROM v_uid
   OR v_e.assinatura_digital_capturada_por IS DISTINCT FROM v_uid OR v_c.assinatura_digital_png_path IS DISTINCT FROM v_path
   OR v_c.assinatura_hash IS DISTINCT FROM v_p->>'assinatura_hash' OR v_c.assinatura_hash !~ '^[0-9a-f]{64}$'
   OR v_c.recebedor_nome IS DISTINCT FROM v_p->>'recebedor_nome'
   OR v_c.recebedor_documento IS DISTINCT FROM v_p->>'recebedor_documento'
   OR v_c.recebedor_cargo IS DISTINCT FROM v_p->>'recebedor_cargo'
   OR v_c.recebedor_telefone IS DISTINCT FROM v_p->>'recebedor_telefone'
   OR v_c.assinatura_digital_svg IS DISTINCT FROM v_p->>'assinatura_digital_svg'
   OR v_c.assinatura_user_agent IS DISTINCT FROM v_p->>'assinatura_user_agent'
   OR v_c.assinatura_capturada_em IS NULL OR v_c.gerado_em IS NULL
   OR v_c.data_assinatura IS DISTINCT FROM v_c.assinatura_capturada_em
   OR v_e.assinatura_digital_capturada_em IS DISTINCT FROM v_c.assinatura_capturada_em
   OR v_e.formulario_gerado_em IS DISTINCT FROM v_c.gerado_em
   OR v_c.validation_hash IS DISTINCT FROM encode(extensions.digest(v_e.id::text||v_c.assinatura_hash||v_c.assinatura_capturada_em::text,'sha256'),'hex')
   OR v_e.validation_hash IS DISTINCT FROM encode(extensions.digest(v_e.id::text||v_c.numero_formulario||v_c.validation_token::text||v_c.gerado_em::text,'sha256'),'hex')
   OR EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE id<>v_c.id AND (arquivo_path=v_path OR assinatura_digital_png_path=v_path))
  THEN RAISE EXCEPTION 'DELIVERY_PROOF_LEGACY_RECOVERY_DENIED' USING ERRCODE='42501'; END IF;
  -- Existing one-shot exact-image table; proof remains byte-for-byte unchanged.
  INSERT INTO platform_private.delivery_confirm_permits_v1(txid,actor,organization_id,target,proof,old_delivery,new_delivery,old_proof,new_proof)
  VALUES(txid_current(),v_uid,v_org,v_e.id,v_c.id,to_jsonb(v_e),to_jsonb(v_e)||jsonb_build_object('validation_hash',v_c.validation_hash,'updated_at',now()),to_jsonb(v_c),to_jsonb(v_c));
  INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_uid,v_org,'proof_recover',v_e.id,'recover_hash');
  PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,v_org);
  PERFORM platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
  UPDATE public.entregas SET validation_hash=v_c.validation_hash,updated_at=now() WHERE id=v_e.id;
  IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current() AND delivery_consumed AND NOT proof_consumed)
   OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done')
  THEN RAISE EXCEPTION 'DELIVERY_PROOF_RECOVERY_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
  DELETE FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current();
  DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();
 END IF;
END IF;
  RETURN v_prev.result||'{"replayed":true}'::jsonb;
 END IF;
 IF p_action IN ('sign','attach') THEN
  v_path:=CASE p_action WHEN 'sign' THEN v_p->>'assinatura_digital_png_path' ELSE v_p->>'arquivo_path' END;
  -- Object must exist, belong to the caller and stay locked until commit.
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=v_path AND owner_id=v_uid::text FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
  -- The FOR SHARE may have waited: re-authorize before trusting anything.
  v_e:=platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',v_uid,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
  IF EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE arquivo_path=v_path OR assinatura_digital_png_path=v_path) THEN
   RAISE EXCEPTION 'DELIVERY_PROOF_OBJECT_ALREADY_LINKED' USING ERRCODE='PT409';
  END IF;
 END IF;
 IF v_e.comprovante_id IS NOT NULL THEN
  SELECT * INTO v_c FROM public.entrega_comprovantes WHERE id=v_e.comprovante_id FOR UPDATE;
  IF NOT FOUND OR v_c.entrega_id<>v_e.id THEN RAISE EXCEPTION 'DELIVERY_PROOF_INCONSISTENT' USING ERRCODE='PT409'; END IF;
 ELSE
  SELECT * INTO v_c FROM public.entrega_comprovantes WHERE entrega_id=v_e.id AND tipo='formulario_entrega' ORDER BY gerado_em DESC LIMIT 1 FOR UPDATE;
 END IF;
 -- The comprovante FOR UPDATE may have waited: re-authorize again.
 v_e:=platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_allowed_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',v_uid,v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_c.id IS NOT NULL AND v_c.status IN ('rejeitado','cancelado') THEN v_c:=NULL; END IF;
 IF p_action<>'generate' AND v_c.status='confirmado' THEN RAISE EXCEPTION 'DELIVERY_PROOF_CLOSED' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation)
 VALUES(pg_catalog.txid_current(),v_uid,v_org,'proof',v_e.id,'proof');
 IF v_c.id IS NULL THEN
  v_token:=pg_catalog.gen_random_uuid();
  v_num:='AR-ENT-'||pg_catalog.lpad(pg_catalog.nextval('public.entrega_formulario_seq')::text,6,'0');
  v_hash:=pg_catalog.encode(extensions.digest(v_e.id::text||v_num||v_token::text||pg_catalog.now()::text,'sha256'),'hex');
  INSERT INTO public.entrega_comprovantes(entrega_id,numero_formulario,tipo,status,validation_token,validation_hash,qr_code_payload,gerado_por)
  VALUES(v_e.id,v_num,'formulario_entrega','gerado',v_token,v_hash,v_token::text,v_uid) RETURNING * INTO v_c;
  PERFORM public._entrega_seed_checklist(v_e.id);
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_FORM_GENERATED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'numero_formulario',v_num),v_uid);
 ELSE v_reused:=true; END IF;
 IF p_action='sign' THEN
  UPDATE public.entrega_comprovantes SET status='assinatura_digital_coletada',assinatura_coletada=true,assinatura_tipo='digital_tela',
   assinatura_digital_png_path=v_path,assinatura_digital_svg=v_p->>'assinatura_digital_svg',assinatura_hash=v_p->>'assinatura_hash',
   assinatura_user_agent=v_p->>'assinatura_user_agent',assinatura_capturada_em=pg_catalog.now(),
   recebedor_nome=v_p->>'recebedor_nome',recebedor_documento=v_p->>'recebedor_documento',recebedor_cargo=v_p->>'recebedor_cargo',recebedor_telefone=v_p->>'recebedor_telefone',
   data_assinatura=pg_catalog.now(),
   validation_hash=pg_catalog.encode(extensions.digest(v_e.id::text||(v_p->>'assinatura_hash')||pg_catalog.now()::text,'sha256'),'hex'),updated_at=pg_catalog.now()
  WHERE id=v_c.id RETURNING * INTO v_c;
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_DIGITAL_SIGNATURE_CAPTURED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'hash',v_p->>'assinatura_hash'),v_uid);
 ELSIF p_action='attach' THEN
  UPDATE public.entrega_comprovantes SET status='anexado',arquivo_path=v_path,arquivo_url=NULL,arquivo_nome=v_p->>'arquivo_nome',arquivo_mime=v_p->>'arquivo_mime',
   assinatura_coletada=true,assinatura_tipo='fisica_anexada',
   recebedor_nome=v_p->>'recebedor_nome',recebedor_documento=v_p->>'recebedor_documento',recebedor_cargo=v_p->>'recebedor_cargo',recebedor_telefone=v_p->>'recebedor_telefone',
   data_assinatura=pg_catalog.now(),anexado_por=v_uid,anexado_em=pg_catalog.now(),updated_at=pg_catalog.now()
  WHERE id=v_c.id RETURNING * INTO v_c;
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_PROOF_ATTACHED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'arquivo_path',v_path),v_uid);
 END IF;
 -- Immediately before the delivery writer: re-authorize (no wait is trusted).
 PERFORM platform_private.delivery_proof_recheck_20261030(p_entrega,v_org,p_action);
 -- Exactly one delivery row update; the barrier verifies the column set.
 UPDATE public.entregas SET
  comprovante_id=v_c.id,
  comprovante_status=CASE p_action WHEN 'generate' THEN CASE WHEN v_reused THEN comprovante_status ELSE 'formulario_gerado' END WHEN 'sign' THEN 'assinatura_digital_coletada' ELSE 'anexado' END,
  formulario_gerado_em=CASE WHEN v_reused THEN formulario_gerado_em ELSE pg_catalog.now() END,
  formulario_gerado_por=CASE WHEN v_reused THEN formulario_gerado_por ELSE v_uid END,
  validation_token=v_c.validation_token,
  validation_hash=v_c.validation_hash,
  assinatura_tipo=CASE p_action WHEN 'sign' THEN 'digital_tela' WHEN 'attach' THEN 'fisica_anexada' ELSE assinatura_tipo END,
  recebedor_nome=CASE WHEN p_action='generate' THEN recebedor_nome ELSE v_p->>'recebedor_nome' END,
  recebedor_documento=coalesce(v_p->>'recebedor_documento',recebedor_documento),
  recebedor_cargo=coalesce(v_p->>'recebedor_cargo',recebedor_cargo),
  recebedor_telefone=coalesce(v_p->>'recebedor_telefone',recebedor_telefone),
  assinatura_digital_capturada_em=CASE WHEN p_action='sign' THEN pg_catalog.now() ELSE assinatura_digital_capturada_em END,
  assinatura_digital_capturada_por=CASE WHEN p_action='sign' THEN v_uid ELSE assinatura_digital_capturada_por END,
  comprovante_anexado_em=CASE WHEN p_action='attach' THEN pg_catalog.now() ELSE comprovante_anexado_em END,
  comprovante_anexado_por=CASE WHEN p_action='attach' THEN v_uid ELSE comprovante_anexado_por END,
  updated_at=pg_catalog.now()
 WHERE id=v_e.id;
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND mutation='done') THEN
  RAISE EXCEPTION 'DELIVERY_PROOF_PERMIT_UNUSED' USING ERRCODE='42501';
 END IF;
 -- One-shot permit is removed on success; receipts are kept.
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND action='proof';
 v_result:=pg_catalog.jsonb_build_object('success',true,'action',p_action,'entrega_id',v_e.id,'comprovante_id',v_c.id,
  'numero_formulario',v_c.numero_formulario,'validation_token',v_c.validation_token,'reused',v_reused,'object_path',v_path);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result)
 VALUES(p_request_key,v_uid,v_org,v_action,v_fp,v_result);
 RETURN v_result;
END $function$;

CREATE OR REPLACE FUNCTION public.rpc_entrega_comprovacao_preflight_v1(p_entrega_id uuid, p_action text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_e public.entregas%ROWTYPE; BEGIN
 v_org:=platform_private.delivery_proof_actor_20261030();
 IF p_action NOT IN ('generate','sign','attach') OR p_entrega_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: action' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org;
 IF NOT FOUND OR NOT platform_private.delivery_proof_row_ok_20261030(v_e,v_org,p_action) THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF (v_e.partner_order_id IS NOT NULL OR v_e.origem_estoque IS NOT NULL) AND platform_private.resale_pilot_delivery_scope_v1(CASE WHEN v_e.partner_order_id IS NULL THEN 'finished_product' ELSE 'b2b_resale' END,'proof',auth.uid(),v_org,v_e.id) IS NOT TRUE THEN RAISE EXCEPTION 'RESALE_PILOT_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_action<>'generate' AND EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE id=v_e.comprovante_id AND status='confirmado') THEN
  RAISE EXCEPTION 'DELIVERY_PROOF_CLOSED' USING ERRCODE='PT409'; END IF;
 RETURN pg_catalog.jsonb_build_object('allowed',true,'entrega_id',v_e.id,'action',p_action);
END $function$;

COMMIT;
