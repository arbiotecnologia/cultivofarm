BEGIN READ ONLY;
DO $$ BEGIN
 IF NOT has_function_privilege('authenticated','public.rpc_receivable_money_projection_v1(uuid,integer,integer)','EXECUTE')
   OR has_function_privilege('anon','public.rpc_receivable_money_projection_v1(uuid,integer,integer)','EXECUTE')
