BEGIN READ ONLY;
DO $$DECLARE p oid:=to_regprocedure('platform_private.b2b_resale_os_valid_v1(public.ordens_servico)');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '4a94e2ab1530f1e23fc42ea8cf5ed469'
 OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres'
 OR (SELECT coalesce(proacl::text,'') FROM pg_proc WHERE oid=p) IS DISTINCT FROM '{postgres=X/postgres}'
 THEN RAISE EXCEPTION 'LINKED_TERMS_CONSUMER_DRIFT';END IF;END$$;
