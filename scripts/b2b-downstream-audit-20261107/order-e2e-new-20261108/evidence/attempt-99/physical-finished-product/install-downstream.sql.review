 IF (SELECT r.rolname FROM pg_proc x JOIN pg_roles r ON r.oid=x.proowner WHERE x.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'FINISHED_PRE_OWNER_DRIFT public.rpc_finished_product_purchase_entry_v1(uuid,uuid,text,numeric,text,text,text,date)';END IF;
 IF (SELECT coalesce(x.proacl::text,'') FROM pg_proc x WHERE x.oid=p) IS DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres}' THEN RAISE EXCEPTION 'FINISHED_PRE_ACL_DRIFT public.rpc_finished_product_purchase_entry_v1(uuid,uuid,text,numeric,text,text,text,date)';END IF;
END$$;

DO $$BEGIN IF EXISTS(SELECT 1 FROM platform_private.finished_product_gate_v1 WHERE enabled IS TRUE) THEN RAISE EXCEPTION 'FINISHED_POST_GATE_OPEN';END IF;END$$;

CREATE OR REPLACE FUNCTION platform_private.delivery_confirm_apply_v1(p_entrega uuid,p_observed timestamptz,p_key text,p_recebedor jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE org uuid; v_actor uuid:=auth.uid(); e public.entregas; initial public.entregas; s public.estoque_produto; l public.lotes; pp public.programacao_producao; c public.entrega_comprovantes; prev platform_private.delivery_requests_20261030;
 fp text; result jsonb; ack jsonb; pend int; total numeric; reserved numeric; finalizada boolean:=false; os_status text; p jsonb; k text; v jsonb; path text; image jsonb; proof_image jsonb;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 org:=platform_private.delivery_confirm_actor_v1();
 IF p_entrega IS NULL OR p_observed IS NULL OR p_key IS NULL OR p_key !~ '^[A-Za-z0-9:_-]{8,128}$' OR p_recebedor IS NULL OR jsonb_typeof(p_recebedor)<>'object' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
 p:='{}';
 FOR k,v IN SELECT * FROM jsonb_each(p_recebedor) LOOP
  IF k NOT IN ('nome','cargo','documento','observacoes') OR jsonb_typeof(v) NOT IN ('string','null') OR length(coalesce(v#>>'{}',''))>(CASE WHEN k='observacoes' THEN 1000 ELSE 255 END) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
  p:=p||jsonb_build_object(k,nullif(btrim(v#>>'{}'),''));
 END LOOP;
 IF nullif(p->>'nome','') IS NULL THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_RECEIVER_REQUIRED' USING ERRCODE='22023'; END IF;
 initial:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 fp:=encode(extensions.digest(jsonb_build_array(v_actor,org,p_entrega,p_observed,p)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtextextended('delivery_confirm:'||jsonb_build_array(v_actor,org,p_key)::text,0));
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.organizations WHERE id=org AND ativo FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.ordens_servico WHERE id=initial.ordem_servico_id AND organization_id=org FOR UPDATE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.entregas WHERE id=p_entrega AND organization_id=org FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF e.status::text='cancelada' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF e.ordem_servico_id IS DISTINCT FROM initial.ordem_servico_id OR e.estoque_produto_id IS DISTINCT FROM initial.estoque_produto_id OR e.cliente_id IS DISTINCT FROM initial.cliente_id OR e.lote_id IS DISTINCT FROM initial.lote_id THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ROOT_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.clientes WHERE id=e.cliente_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO s FROM public.estoque_produto WHERE id=e.estoque_produto_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO l FROM public.lotes WHERE id=s.lote_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO pp FROM public.programacao_producao WHERE id=l.programacao_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF s.id IS NULL OR l.id IS NULL OR e.lote_id IS DISTINCT FROM l.id
 OR s.produto_id IS DISTINCT FROM l.produto_id OR e.produto_id IS DISTINCT FROM l.produto_id
 OR (s.origem_estoque IS NULL AND (pp.id IS NULL OR pp.ordem_servico_id IS DISTINCT FROM e.ordem_servico_id OR pp.ordem_servico_onfarm_id IS NOT NULL OR pp.produto_id IS DISTINCT FROM l.produto_id))
 OR (s.origem_estoque IS NOT NULL AND platform_private.finished_product_delivery_valid_v1(s,e,l) IS NOT TRUE)
 OR s.reservado_para_os_id IS DISTINCT FROM e.ordem_servico_id OR s.reservado_para_os_tipo IS DISTINCT FROM 'manual' OR s.reservado_para_cliente_id IS DISTINCT FROM e.cliente_id OR s.reservado_para_partner_order_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.entrega_comprovantes WHERE id=e.comprovante_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 c:=platform_private.delivery_confirm_proof_v1(e);
 path:=CASE WHEN c.assinatura_tipo='digital_tela' THEN c.assinatura_digital_png_path ELSE c.arquivo_path END;
 IF path IS NOT NULL THEN
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=path FOR SHARE;
  e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org); c:=platform_private.delivery_confirm_proof_v1(e);
 END IF;
 SELECT * INTO prev FROM platform_private.delivery_requests_20261030 WHERE organization_id=org AND actor=v_actor AND action='confirm' AND request_key=p_key;
 IF FOUND THEN
  SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
  IF os_status NOT IN ('entregue','finalizada') OR s.status::text<>'expedido' OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
   OR (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue AND os_id=e.ordem_servico_id AND os_tipo='manual' AND lote_id=l.id)<>1
   OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('entrega','estorno_expedicao','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_STATE_DENIED' USING ERRCODE='42501'; END IF;
  IF prev.fingerprint IS DISTINCT FROM fp OR e.status::text<>'entregue' OR c.status<>'confirmado' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN prev.result||jsonb_build_object('replay',true);
 END IF;
 IF e.status::text='entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEGACY_REVIEW_REQUIRED' USING ERRCODE='PT409'; END IF;
 IF e.status::text NOT IN ('separado','em_rota') OR e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
 IF os_status NOT IN ('pronto_entrega','entregue') OR s.status::text<>'expedido' OR e.quantidade_entregue IS NULL OR e.quantidade_entregue<=0 OR e.quantidade_entregue::text IN ('NaN','Infinity','-Infinity')
 OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_STATE_CONFLICT' USING ERRCODE='PT409'; END IF;
 -- Expedition was already performed by the reviewed group motor. Do not repeat it.
 IF (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue AND os_id=e.ordem_servico_id AND os_tipo='manual' AND lote_id=l.id)<>1
 OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('estorno_expedicao','entrega','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEDGER_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id ORDER BY id FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 image:=to_jsonb(e)||jsonb_build_object('status','entregue','entregue_em',now(),'recebido_por_nome',p->>'nome','recebido_por_cargo',coalesce(p->>'cargo',e.recebido_por_cargo),'recebido_por_documento',coalesce(p->>'documento',e.recebido_por_documento),'observacoes_confirmacao',coalesce(p->>'observacoes',e.observacoes_confirmacao),'confirmado_por',v_actor,'recebimento_confirmado_em',now(),'recebimento_confirmado_por',v_actor,'comprovante_status','confirmado','updated_at',now());
 proof_image:=to_jsonb(c)||jsonb_build_object('status','confirmado','confirmado_por',v_actor,'confirmado_em',now(),'updated_at',now());
 INSERT INTO platform_private.delivery_confirm_permits_v1(txid,actor,organization_id,target,proof,old_delivery,new_delivery,old_proof,new_proof) VALUES(txid_current(),v_actor,org,e.id,c.id,to_jsonb(e),image,to_jsonb(c),proof_image);
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_actor,org,'confirm',e.id,'confirm');
 UPDATE public.entrega_comprovantes SET status='confirmado',confirmado_por=v_actor,confirmado_em=now(),updated_at=now() WHERE id=c.id;
 c:=platform_private.delivery_confirm_proof_v1(e);
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 UPDATE public.entregas SET status='entregue',entregue_em=now(),recebido_por_nome=p->>'nome',recebido_por_cargo=coalesce(p->>'cargo',recebido_por_cargo),recebido_por_documento=coalesce(p->>'documento',recebido_por_documento),observacoes_confirmacao=coalesce(p->>'observacoes',observacoes_confirmacao),confirmado_por=v_actor,
 recebimento_confirmado_em=now(),recebimento_confirmado_por=v_actor,comprovante_status='confirmado' WHERE id=e.id AND updated_at=p_observed;
 IF NOT FOUND OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done') THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','enviar_entrega',NULL);
 IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ADVANCE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 -- Coverage is independently measured per programming/product in canonical millilitres.
 -- Cancelled deliveries and reversed reservations never cover outstanding demand.
 PERFORM 1 FROM public.programacao_producao WHERE ordem_servico_id=e.ordem_servico_id ORDER BY id FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT count(*) INTO pend FROM public.entregas WHERE ordem_servico_id=e.ordem_servico_id AND status::text NOT IN ('entregue','cancelada');
 IF pend=0 AND EXISTS(SELECT 1 FROM public.programacao_producao WHERE ordem_servico_id=e.ordem_servico_id)
 AND NOT EXISTS(
  SELECT 1 FROM public.programacao_producao demand WHERE demand.ordem_servico_id=e.ordem_servico_id AND (
   demand.organization_id IS DISTINCT FROM org OR demand.produto_id IS NULL OR demand.volume_necessario IS NULL OR demand.volume_necessario<=0 OR demand.volume_necessario::text IN ('NaN','Infinity','-Infinity')
   OR coalesce((SELECT sum(st.volume_total*1000) FROM public.entregas delivered JOIN public.estoque_produto st ON st.id=delivered.estoque_produto_id JOIN public.lotes lot ON lot.id=st.lote_id
    WHERE delivered.ordem_servico_id=e.ordem_servico_id AND delivered.organization_id=org AND delivered.status::text='entregue' AND lot.programacao_id=demand.id AND lot.organization_id=org
    AND lot.produto_id=demand.produto_id AND st.produto_id=demand.produto_id AND delivered.produto_id=demand.produto_id AND delivered.lote_id=lot.id
    AND st.status::text='expedido' AND st.reservado_para_os_id=e.ordem_servico_id AND st.reservado_para_os_tipo='manual'
    AND st.quantidade=delivered.quantidade_entregue AND st.quantidade_reservada=delivered.quantidade_entregue AND st.volume_total>0 AND st.volume_total::text NOT IN ('NaN','Infinity','-Infinity')
    AND NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes m WHERE m.estoque_produto_id=st.id AND m.referencia_id=delivered.id AND m.acao IN ('estorno_expedicao','devolucao','entrega'))),0)<demand.volume_necessario)) THEN
  ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','finalizar_os',NULL);
  IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'finalizada' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_FINALIZE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  finalizada:=true;
 END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 result:=jsonb_build_object('success',true,'action','confirm','replay',false,'actor_id',v_actor,'organization_id',org,'entrega_id',e.id,'os_id',e.ordem_servico_id,'comprovante_id',c.id,'status','entregue','os_status',(SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id),'finalizada',finalizada,'updated_at',(SELECT updated_at FROM public.entregas WHERE id=e.id));
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_key,v_actor,org,'confirm',fp,result);
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current() AND delivery_consumed AND proof_consumed) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_EXACT_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 DELETE FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current();
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();
 RETURN result;
END $$;

CREATE OR REPLACE FUNCTION platform_private.delivery_send_apply_v1(p_entrega uuid,p_observed timestamptz,p_key text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE org uuid; v_actor uuid:=auth.uid(); e public.entregas; initial public.entregas; s public.estoque_produto; l public.lotes; pp public.programacao_producao; c public.entrega_comprovantes; prev platform_private.delivery_requests_20261030;
 fp text; result jsonb; ack jsonb; pend int; total numeric; reserved numeric; finalizada boolean:=false; os_status text; p jsonb; k text; v jsonb; path text; image jsonb; proof_image jsonb;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'DELIVERY_SEND_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 org:=platform_private.delivery_confirm_actor_v1();
 IF p_entrega IS NULL OR p_observed IS NULL OR NOT isfinite(p_observed) OR p_key IS NULL OR p_key !~ '^[A-Za-z0-9:_-]{8,128}$' THEN RAISE EXCEPTION 'DELIVERY_SEND_INVALID' USING ERRCODE='22023'; END IF;
 p:='{}';
 initial:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 fp:=encode(extensions.digest(jsonb_build_array(v_actor,org,p_entrega,p_observed,p)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtextextended('delivery_send:'||jsonb_build_array(v_actor,org,p_key)::text,0));
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SEND_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.organizations WHERE id=org AND ativo FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.ordens_servico WHERE id=initial.ordem_servico_id AND organization_id=org FOR UPDATE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.entregas WHERE id=p_entrega AND organization_id=org FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF e.status::text='cancelada' THEN RAISE EXCEPTION 'DELIVERY_SEND_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF e.ordem_servico_id IS DISTINCT FROM initial.ordem_servico_id OR e.estoque_produto_id IS DISTINCT FROM initial.estoque_produto_id OR e.cliente_id IS DISTINCT FROM initial.cliente_id OR e.lote_id IS DISTINCT FROM initial.lote_id THEN RAISE EXCEPTION 'DELIVERY_SEND_ROOT_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.clientes WHERE id=e.cliente_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO s FROM public.estoque_produto WHERE id=e.estoque_produto_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO l FROM public.lotes WHERE id=s.lote_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO pp FROM public.programacao_producao WHERE id=l.programacao_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF s.id IS NULL OR l.id IS NULL OR e.lote_id IS DISTINCT FROM l.id
 OR s.produto_id IS DISTINCT FROM l.produto_id OR e.produto_id IS DISTINCT FROM l.produto_id
 OR (s.origem_estoque IS NULL AND (pp.id IS NULL OR pp.ordem_servico_id IS DISTINCT FROM e.ordem_servico_id OR pp.ordem_servico_onfarm_id IS NOT NULL OR pp.produto_id IS DISTINCT FROM l.produto_id))
 OR (s.origem_estoque IS NOT NULL AND platform_private.finished_product_delivery_valid_v1(s,e,l) IS NOT TRUE)
 OR s.reservado_para_os_id IS DISTINCT FROM e.ordem_servico_id OR s.reservado_para_os_tipo IS DISTINCT FROM 'manual' OR s.reservado_para_cliente_id IS DISTINCT FROM e.cliente_id OR s.reservado_para_partner_order_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_SEND_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;

 IF s.status::text<>'expedido' OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
 OR (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND os_id=e.ordem_servico_id AND os_tipo='manual' AND lote_id=l.id AND quantidade=e.quantidade_entregue)<>1
 OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('estorno_expedicao','entrega','devolucao'))
 OR NOT EXISTS(SELECT 1 FROM public.ordens_servico WHERE id=e.ordem_servico_id AND organization_id=org AND status::text IN ('pronto_entrega','entregue')) THEN RAISE EXCEPTION 'DELIVERY_SEND_STATE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id ORDER BY id FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO prev FROM platform_private.delivery_requests_20261030 WHERE organization_id=org AND actor=v_actor AND action='send' AND request_key=p_key;
 IF FOUND THEN
  IF prev.fingerprint IS DISTINCT FROM fp OR e.status::text<>'em_rota' THEN RAISE EXCEPTION 'DELIVERY_SEND_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN prev.result||jsonb_build_object('replay',true);
 END IF;
 IF e.status::text<>'separado' OR e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_SEND_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 image:=to_jsonb(e)||jsonb_build_object('status','em_rota','updated_at',now());
 INSERT INTO platform_private.delivery_send_permits_v1 VALUES(txid_current(),v_actor,org,e.id,to_jsonb(e),image,false);
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_actor,org,'send',e.id,'send');
 UPDATE public.entregas SET status='em_rota' WHERE id=e.id AND updated_at=p_observed RETURNING * INTO e;
 IF e.id IS NULL OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_send_permits_v1 WHERE txid=txid_current() AND consumed) OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done') THEN RAISE EXCEPTION 'DELIVERY_SEND_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 result:=jsonb_build_object('success',true,'action','send','replay',false,'actor_id',v_actor,'organization_id',org,'entrega_id',e.id,'os_id',e.ordem_servico_id,'status','em_rota','updated_at',e.updated_at);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_key,v_actor,org,'send',fp,result);
 DELETE FROM platform_private.delivery_send_permits_v1 WHERE txid=txid_current();DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();RETURN result;
 END $$;
