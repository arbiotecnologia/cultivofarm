DO $$DECLARE p oid:=to_regprocedure('private.guard_os_separate_approval()');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM 'f00397fe862e611fbfa0eba3911d95c6' THEN RAISE EXCEPTION 'B2B_RESALE_PRE_FUNCTION_DRIFT private.guard_os_separate_approval()';END IF;
 IF (SELECT r.rolname FROM pg_proc f JOIN pg_roles r ON r.oid=f.proowner WHERE f.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'B2B_RESALE_PRE_OWNER_DRIFT private.guard_os_separate_approval()';END IF;
 IF (SELECT coalesce(f.proacl::text,'') FROM pg_proc f WHERE f.oid=p) IS DISTINCT FROM '{postgres=X/postgres}' THEN RAISE EXCEPTION 'B2B_RESALE_PRE_ACL_DRIFT private.guard_os_separate_approval()';END IF;
END$$;

