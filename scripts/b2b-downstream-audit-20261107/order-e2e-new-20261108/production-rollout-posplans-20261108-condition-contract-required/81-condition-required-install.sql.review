-- REVIEW ONLY. Not applied. Auditor installs after independent review.
-- Blocks NEW partner_orders on a plan with an approved, unretired B2B_PAYMENT_CONDITION_V1
-- version of the seller unless the same transaction wrote the private condition snapshot
-- (create_partner_order_condition_secure). Existing orders untouched (AFTER INSERT only).
BEGIN;
DO $pre$ BEGIN
  IF current_setting('server_version_num')::int < 170000 THEN RAISE EXCEPTION 'CCR_PRE_PG_VERSION'; END IF;
  IF to_regclass('platform_private.b2b_condition_versions') IS NULL OR to_regclass('platform_private.b2b_condition_retirements') IS NULL
     OR to_regclass('platform_private.b2b_order_condition_snapshots') IS NULL OR to_regclass('platform_private.b2b_order_condition_quote_snapshots') IS NULL
  THEN RAISE EXCEPTION 'CCR_PRE_MISSING_RELATION'; END IF;
  IF to_regprocedure('platform_private.b2b_condition_contract_required_guard()') IS NOT NULL
     OR EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='trg_zz_b2b_condition_contract_required')
  THEN RAISE EXCEPTION 'CCR_PRE_ALREADY_INSTALLED'; END IF;
END $pre$;

CREATE FUNCTION platform_private.b2b_condition_contract_required_guard()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_org uuid;
BEGIN
  IF NEW.payment_plan_id IS NULL THEN RETURN NULL; END IF;
  SELECT a.commercial_owner_organization_id INTO v_org FROM public.partner_accounts a WHERE a.id = NEW.partner_id;
  IF EXISTS (SELECT 1 FROM platform_private.b2b_condition_versions v
              WHERE v.organization_id = v_org AND v.plan_id = NEW.payment_plan_id AND v.configuration_approved IS TRUE
                AND NOT EXISTS (SELECT 1 FROM platform_private.b2b_condition_retirements r
                                 WHERE r.organization_id = v.organization_id AND r.plan_id = v.plan_id
                                   AND r.version = v.version AND r.method = v.method))
     AND NOT EXISTS (SELECT 1 FROM platform_private.b2b_order_condition_snapshots s WHERE s.order_id = NEW.id)
     AND NOT EXISTS (SELECT 1 FROM platform_private.b2b_order_condition_quote_snapshots q WHERE q.order_id = NEW.id)
  THEN
    RAISE EXCEPTION 'payment_condition_contract_required' USING ERRCODE = 'P0001',
      HINT = 'Plan has an approved payment condition; use the B2B_PAYMENT_CONDITION_V1 writer.';
  END IF;
  RETURN NULL;
END $f$;
ALTER FUNCTION platform_private.b2b_condition_contract_required_guard() OWNER TO postgres;
REVOKE ALL ON FUNCTION platform_private.b2b_condition_contract_required_guard() FROM PUBLIC;
DO $r$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='anon') THEN EXECUTE 'REVOKE ALL ON FUNCTION platform_private.b2b_condition_contract_required_guard() FROM anon'; END IF;
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN EXECUTE 'REVOKE ALL ON FUNCTION platform_private.b2b_condition_contract_required_guard() FROM authenticated'; END IF;
END $r$;

CREATE CONSTRAINT TRIGGER trg_zz_b2b_condition_contract_required
  AFTER INSERT ON public.partner_orders DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_condition_contract_required_guard();
COMMIT;
