-- READ ONLY preflight for 81 (rev2). Aborts on any drift; changes nothing.
-- Pins = installed B3 objects (B2B_PAYMENT_CONDITION_V1) as measured in the real-writer harness; the auditor must see
-- them match LIVE here before 81. Divergence = stop, never edit the pin to pass.
BEGIN READ ONLY;
SET LOCAL lock_timeout = '3s'; SET LOCAL statement_timeout = '30s';
DO $pre$
DECLARE v text;
BEGIN
  IF current_setting('server_version_num')::int < 150000 THEN RAISE EXCEPTION 'CCR2_PRE_PG_VERSION'; END IF;
  IF to_regclass('platform_private.b2b_order_condition_snapshots') IS NULL OR to_regclass('platform_private.b2b_order_condition_quote_snapshots') IS NULL
     OR to_regclass('platform_private.b2b_condition_activation') IS NULL OR to_regclass('platform_private.b2b_condition_versions') IS NULL
  THEN RAISE EXCEPTION 'CCR2_PRE_MISSING_RELATION'; END IF;
  -- rev1 (32cfcc905) must never have been installed; rev2 replaces it.
  IF to_regprocedure('platform_private.b2b_condition_contract_required_guard()') IS NOT NULL THEN RAISE EXCEPTION 'CCR2_PRE_REV1_PRESENT'; END IF;
  IF to_regprocedure('platform_private.b2b_condition_order_coherence_check(uuid,text)') IS NOT NULL
     OR to_regprocedure('platform_private.b2b_condition_order_coherence_trg()') IS NOT NULL
     OR to_regprocedure('platform_private.b2b_condition_snapshot_coherence_trg()') IS NOT NULL
  THEN RAISE EXCEPTION 'CCR2_PRE_ALREADY_INSTALLED'; END IF;
  -- Installed B3 scope objects reused unchanged (mode = pilot/enforced activation of the seller).
  FOR v IN SELECT format('%s|%s|%s|%s|%s', p.oid::regprocedure, md5(pg_get_functiondef(p.oid)), pg_get_userbyid(p.proowner),
                         array_to_string(ARRAY(SELECT x::text FROM unnest(p.proacl) x ORDER BY 1), ','), array_to_string(p.proconfig, ','))
             FROM pg_proc p WHERE p.oid IN ('platform_private.b2b_condition_mode(uuid)'::regprocedure, 'platform_private.b2b_condition_required_check()'::regprocedure)
  LOOP
    IF v NOT IN ('platform_private.b2b_condition_mode(uuid)|7830c32a4ae139d9ab7e377dd39c8df6|postgres|postgres=X/postgres|search_path=""',
                 'platform_private.b2b_condition_required_check()|236b821b0ca568c81a9667512dae5def|postgres|postgres=X/postgres|search_path=""')
    THEN RAISE EXCEPTION 'CCR2_PRE_B3_DRIFT %', v; END IF;
  END LOOP;
  IF (SELECT count(*) FROM pg_trigger t WHERE t.tgrelid = 'public.partner_orders'::regclass AND t.tgname = 'b2b_payment_condition_required'
        AND t.tgenabled = 'O' AND t.tgdeferrable AND t.tginitdeferred AND t.tgfoid = 'platform_private.b2b_condition_required_check()'::regprocedure
        AND pg_get_triggerdef(t.oid) = 'CREATE CONSTRAINT TRIGGER b2b_payment_condition_required AFTER INSERT ON public.partner_orders DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_condition_required_check()') <> 1
  THEN RAISE EXCEPTION 'CCR2_PRE_B3_TRIGGER_DRIFT'; END IF;
  IF EXISTS (SELECT 1 FROM pg_trigger t WHERE t.tgrelid IN ('public.partner_orders'::regclass, 'platform_private.b2b_order_condition_snapshots'::regclass,
               'platform_private.b2b_order_condition_quote_snapshots'::regclass) AND t.tgname LIKE 'b2b_condition_zz_coherence%')
  THEN RAISE EXCEPTION 'CCR2_PRE_TRIGGER_PRESENT'; END IF;
  -- Columns the guard reads.
  IF (SELECT count(*) FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'partner_orders'
        AND column_name IN ('id', 'partner_id', 'payment_plan_id') AND data_type = 'uuid') <> 3
     OR (SELECT count(*) FROM information_schema.columns WHERE table_schema = 'platform_private' AND table_name IN ('b2b_order_condition_snapshots', 'b2b_order_condition_quote_snapshots')
        AND column_name IN ('order_id', 'organization_id', 'partner_id', 'plan_id', 'choice', 'condition', 'condition_version', 'condition_method')) <> 16
     OR (SELECT count(*) FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'partner_order_payment_terms'
        AND column_name IN ('id', 'partner_order_id') AND data_type = 'uuid') <> 2
     OR (SELECT count(*) FROM information_schema.columns WHERE table_schema = 'platform_private' AND table_name = 'b2b_order_condition_snapshots'
        AND column_name IN ('quote', 'payment_terms_id')) <> 2
  THEN RAISE EXCEPTION 'CCR2_PRE_COLUMNS'; END IF;
  RAISE NOTICE 'CCR2_PRE_OK';
END $pre$;
ROLLBACK;
