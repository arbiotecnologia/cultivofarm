-- READ ONLY. Abort unless the hosted body/owner/ACL equal the reviewed LIVE pins (ACL pinned from mirror: auditor must confirm).
BEGIN READ ONLY;
DO $r$BEGIN IF current_setting('app.reviewed_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'RESPOND_FIX_REF_NOT_ASSERTED';END IF;END$r$;
DO $c$DECLARE p oid:=to_regprocedure('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)');BEGIN IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '4926a99c3fa3086b34ff25bb4b4038bb' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres' OR (SELECT array(SELECT x::text FROM unnest(proacl) x ORDER BY 1) FROM pg_proc WHERE oid=p) IS DISTINCT FROM (SELECT array(SELECT x FROM unnest('{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}'::text[]) x ORDER BY 1)) THEN RAISE EXCEPTION 'RESPOND_FIX_PRE_DRIFT public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)';END IF;END$c$;
DO $c$DECLARE p oid:=to_regprocedure('platform_private.b2b_owner_internal_partner_readable(uuid)');BEGIN IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM 'fa72ca18fc673cb4a5ff4867e65137cd' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'RESPOND_FIX_DEP_DRIFT platform_private.b2b_owner_internal_partner_readable(uuid)';END IF;END$c$;
DO $c$DECLARE p oid:=to_regprocedure('public.b2b_phase1_order_visible(uuid)');BEGIN IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '8812508716f279a88e3d5a31b15621d8' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'RESPOND_FIX_DEP_DRIFT public.b2b_phase1_order_visible(uuid)';END IF;END$c$;
DO $c$DECLARE p oid:=to_regprocedure('platform_private.b2b_phase1_partner_visible(uuid,boolean)');BEGIN IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '915f516e605af7cc14584e2e762a2661' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'RESPOND_FIX_DEP_DRIFT platform_private.b2b_phase1_partner_visible(uuid,boolean)';END IF;END$c$;
DO $o$BEGIN RAISE NOTICE 'RESPOND_FIX_PRE_OK';END$o$;
ROLLBACK;
