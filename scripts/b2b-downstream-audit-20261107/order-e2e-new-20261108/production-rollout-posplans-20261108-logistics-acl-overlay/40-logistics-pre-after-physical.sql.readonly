DO $$DECLARE p oid:=to_regprocedure('platform_private.b2b_internal_order_snapshot_guard()');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '9cad2aaa995277b913f8b40816fea504' THEN RAISE EXCEPTION 'B2B_RESALE_PRE_FUNCTION_DRIFT platform_private.b2b_internal_order_snapshot_guard()';END IF;
 IF (SELECT r.rolname FROM pg_proc f JOIN pg_roles r ON r.oid=f.proowner WHERE f.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'B2B_RESALE_PRE_OWNER_DRIFT platform_private.b2b_internal_order_snapshot_guard()';END IF;
 IF (SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(f.proacl) AS acl_items(item)) FROM pg_proc f WHERE f.oid=p) IS DISTINCT FROM (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=X/postgres,service_role=X/postgres}'::aclitem[]) AS acl_items(item)) THEN RAISE EXCEPTION 'B2B_RESALE_PRE_ACL_DRIFT platform_private.b2b_internal_order_snapshot_guard()';END IF;
END$$;

