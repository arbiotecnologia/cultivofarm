DO $$DECLARE orphans bigint;BEGIN
 SELECT count(*) INTO orphans FROM public.product_packagings child
 LEFT JOIN public.organizations parent ON parent.id=child.owner_organization_id
 WHERE parent.id IS NULL;
 IF orphans<>0 THEN
  RAISE EXCEPTION 'OWNER_FK_ORPHANS_PRESENT public.product_packagings count=%',orphans USING ERRCODE='23503';
 END IF;
END$$;
DO $$DECLARE orphans bigint;BEGIN
 SELECT count(*) INTO orphans FROM public.product_sale_units child
 LEFT JOIN public.organizations parent ON parent.id=child.owner_organization_id
 WHERE parent.id IS NULL;
 IF orphans<>0 THEN
  RAISE EXCEPTION 'OWNER_FK_ORPHANS_PRESENT public.product_sale_units count=%',orphans USING ERRCODE='23503';
 END IF;
END$$;
ROLLBACK;
