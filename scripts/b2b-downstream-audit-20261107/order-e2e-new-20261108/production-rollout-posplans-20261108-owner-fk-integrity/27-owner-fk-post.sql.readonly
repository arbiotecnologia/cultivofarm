 FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
 WHERE n.nspname='public' AND c.relname='produtos' AND a.attname='valor_dose_brl'
 AND a.attnum>0 AND NOT a.attisdropped) shape(type,column_default,is_not_null) INTO actual;
 IF actual.type IS DISTINCT FROM 'numeric'
  OR actual.column_default IS DISTINCT FROM NULL
  OR actual.is_not_null IS DISTINCT FROM false THEN
  RAISE EXCEPTION 'OWNER_FK_COLUMN_DRIFT produtos.valor_dose_brl';
 END IF;
END$$;
