DO $$DECLARE actual record;BEGIN
 SELECT pg_get_constraintdef(x.oid) definition,x.convalidated validated INTO actual
 FROM pg_constraint x JOIN pg_class c ON c.oid=x.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname='public' AND c.relname='catalogo_volumes' AND x.conname='catalogo_volumes_item_ref';
 IF actual.definition IS DISTINCT FROM 'CHECK ((((item_tipo = ''produto''::text) AND (produto_id IS NOT NULL) AND (microrganismo_id IS NULL)) OR ((item_tipo = ''microrganismo''::text) AND (microrganismo_id IS NOT NULL) AND (produto_id IS NULL))))'
  OR actual.validated IS DISTINCT FROM true THEN
  RAISE EXCEPTION 'OWNER_FK_CONSTRAINT_DRIFT catalogo_volumes.catalogo_volumes_item_ref';
 END IF;
END$$;
DO $$DECLARE actual record;BEGIN
 SELECT pg_get_constraintdef(x.oid) definition,x.convalidated validated INTO actual
 FROM pg_constraint x JOIN pg_class c ON c.oid=x.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname='public' AND c.relname='catalogo_volumes' AND x.conname='catalogo_volumes_item_tipo_check';
 IF actual.definition IS DISTINCT FROM 'CHECK ((item_tipo = ANY (ARRAY[''produto''::text, ''microrganismo''::text])))'
  OR actual.validated IS DISTINCT FROM true THEN
  RAISE EXCEPTION 'OWNER_FK_CONSTRAINT_DRIFT catalogo_volumes.catalogo_volumes_item_tipo_check';
 END IF;
END$$;
