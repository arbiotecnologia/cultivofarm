 IF actual.definition IS DISTINCT FROM 'CHECK ((((medida = ''volume''::text) AND (volume_ml IS NOT NULL) AND (volume_ml > (0)::numeric)) OR ((medida = ''embalagem''::text) AND (volume_ml IS NULL) AND (item_tipo = ''produto''::text) AND (preco_brl = (0)::numeric) AND (rotulo IS NOT NULL) AND (btrim(rotulo) <> ''''::text))))'
  OR actual.validated IS DISTINCT FROM true THEN
  RAISE EXCEPTION 'OWNER_FK_CONSTRAINT_DRIFT catalogo_volumes.catalogo_volumes_medida_shape';
