-- REVIEW_ONLY_INACTIVE_NOT_APPROVED; integridade owner; nenhum hosted/cleanup/grant.
BEGIN READ ONLY;
SET LOCAL statement_timeout='20s';
SELECT jsonb_build_object('contract','OWNER_FK_INTEGRITY_V1','product_packagings',jsonb_build_object(
  'total',(SELECT count(*) FROM public.product_packagings),
 'owner_null',(SELECT count(*) FROM public.product_packagings WHERE owner_organization_id IS NULL),
 'orphan_owner',(SELECT count(*) FROM public.product_packagings child
   LEFT JOIN public.organizations parent ON parent.id=child.owner_organization_id
   WHERE child.owner_organization_id IS NOT NULL AND parent.id IS NULL),
 'owner_product_mismatch',(SELECT count(*) FROM public.product_packagings child
   JOIN public.produtos product ON product.id=child.product_id
   WHERE product.owner_organization_id IS DISTINCT FROM child.owner_organization_id)),'product_sale_units',jsonb_build_object(
  'total',(SELECT count(*) FROM public.product_sale_units),
 'owner_null',(SELECT count(*) FROM public.product_sale_units WHERE owner_organization_id IS NULL),
 'orphan_owner',(SELECT count(*) FROM public.product_sale_units child
   LEFT JOIN public.organizations parent ON parent.id=child.owner_organization_id
   WHERE child.owner_organization_id IS NOT NULL AND parent.id IS NULL),
 'owner_product_mismatch',(SELECT count(*) FROM public.product_sale_units child
   JOIN public.produtos product ON product.id=child.product_id
   WHERE product.owner_organization_id IS DISTINCT FROM child.owner_organization_id))) AS owner_fk_integrity_audit;
DO $$DECLARE actual jsonb;expected jsonb:=(SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=arwdDxtm/postgres,authenticated=rm/postgres,service_role=arwdDxtm/postgres}'::aclitem[]) AS acl_items(item));BEGIN
 SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(c.relacl) AS acl_items(item)) INTO actual FROM pg_class c WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='catalogo_volumes');
 IF (SELECT r.rolname FROM pg_class c JOIN pg_roles r ON r.oid=c.relowner WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='catalogo_volumes')) IS DISTINCT FROM 'postgres'
  OR actual IS DISTINCT FROM expected THEN RAISE EXCEPTION 'FINISHED_PRE_RELATION_DRIFT public.catalogo_volumes';END IF;
END$$;
DO $$DECLARE actual jsonb;expected jsonb:=(SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=arwdDxtm/postgres}'::aclitem[]) AS acl_items(item));BEGIN
 SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(c.relacl) AS acl_items(item)) INTO actual FROM pg_class c WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='product_packagings');
 IF (SELECT r.rolname FROM pg_class c JOIN pg_roles r ON r.oid=c.relowner WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='product_packagings')) IS DISTINCT FROM 'postgres'
  OR actual IS DISTINCT FROM expected THEN RAISE EXCEPTION 'FINISHED_PRE_RELATION_DRIFT public.product_packagings';END IF;
END$$;
DO $$DECLARE actual jsonb;expected jsonb:=(SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=arwdDxtm/postgres}'::aclitem[]) AS acl_items(item));BEGIN
 SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(c.relacl) AS acl_items(item)) INTO actual FROM pg_class c WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='product_sale_units');
