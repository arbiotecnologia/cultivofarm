DO $$DECLARE actual jsonb;expected jsonb:=(SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest('{postgres=arwdDxtm/postgres,authenticated=r/postgres,service_role=arwdDxtm/postgres}'::aclitem[]) AS acl_items(item));BEGIN
 SELECT (SELECT coalesce(jsonb_agg(item::text ORDER BY item::text COLLATE "C"),'[]'::jsonb) FROM unnest(c.relacl) AS acl_items(item)) INTO actual FROM pg_class c WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='produtos');
 IF (SELECT r.rolname FROM pg_class c JOIN pg_roles r ON r.oid=c.relowner WHERE c.oid=(SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='produtos')) IS DISTINCT FROM 'postgres'
  OR actual IS DISTINCT FROM expected THEN RAISE EXCEPTION 'FINISHED_PRE_RELATION_DRIFT public.produtos';END IF;
END$$;
DO $$DECLARE actual record;BEGIN
 SELECT * FROM (SELECT format_type(a.atttypid,a.atttypmod),pg_get_expr(d.adbin,d.adrelid),a.attnotnull
 FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
 WHERE n.nspname='public' AND c.relname='catalogo_volumes' AND a.attname='id'
 AND a.attnum>0 AND NOT a.attisdropped) shape(type,column_default,is_not_null) INTO actual;
 IF actual.type IS DISTINCT FROM 'uuid'
  OR actual.column_default IS DISTINCT FROM 'gen_random_uuid()'
  OR actual.is_not_null IS DISTINCT FROM true THEN
  RAISE EXCEPTION 'OWNER_FK_COLUMN_DRIFT catalogo_volumes.id';
 END IF;
END$$;
