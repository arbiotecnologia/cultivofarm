CREATE OR REPLACE FUNCTION platform_private.produto_etiquetas_catalog_tenant_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_t uuid;
BEGIN
  IF NOT (NEW.produto_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF true THEN
    v_t := platform_private.catalog_tenant_agree(ARRAY[((SELECT l.organization_id FROM public.lotes l WHERE l.id = NEW.lote_id))::uuid, ((SELECT l.organization_id FROM public.estoque_embalagens eb JOIN public.lotes l ON l.id = eb.lote_id WHERE eb.id = NEW.embalagem_id))::uuid]);
    IF NEW.produto_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = NEW.produto_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'produto_etiquetas.produto_id'; END IF;
  END IF;
  RETURN NEW;
END $function$;

