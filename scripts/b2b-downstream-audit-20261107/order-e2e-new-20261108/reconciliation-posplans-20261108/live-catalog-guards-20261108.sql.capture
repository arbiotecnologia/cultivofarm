CREATE OR REPLACE FUNCTION platform_private.entregas_catalog_tenant_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_t uuid;
BEGIN
  IF NOT (NEW.produto_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF true THEN
    v_t := platform_private.catalog_tenant_agree(ARRAY[(NEW.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = NEW.ordem_servico_id))::uuid, ((SELECT l.organization_id FROM public.lotes l WHERE l.id = NEW.lote_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = NEW.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = NEW.cliente_id))::uuid]);
    IF NEW.produto_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = NEW.produto_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'entregas.produto_id'; END IF;
  END IF;
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION platform_private.estoque_produto_catalog_tenant_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_t uuid;
BEGIN
  IF NOT (NEW.produto_id IS NOT NULL OR NEW.microrganismo_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF true THEN
    v_t := (SELECT l.organization_id FROM public.lotes l WHERE l.id = NEW.lote_id);
    IF NEW.produto_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = NEW.produto_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'estoque_produto.produto_id'; END IF;
    IF NEW.microrganismo_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.microrganismos z WHERE z.id = NEW.microrganismo_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'estoque_produto.microrganismo_id'; END IF;
  END IF;
  RETURN NEW;
END $function$;

