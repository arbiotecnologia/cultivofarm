  "constraints": [
    {
      "name": "catalogo_volumes_item_ref",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "CHECK ((((item_tipo = 'produto'::text) AND (produto_id IS NOT NULL) AND (microrganismo_id IS NULL)) OR ((item_tipo = 'microrganismo'::text) AND (microrganismo_id IS NOT NULL) AND (produto_id IS NULL))))"
    },
    {
      "name": "catalogo_volumes_item_tipo_check",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "CHECK ((item_tipo = ANY (ARRAY['produto'::text, 'microrganismo'::text])))"
    },
    {
      "name": "catalogo_volumes_medida_shape",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "CHECK ((((medida = 'volume'::text) AND (volume_ml IS NOT NULL) AND (volume_ml > (0)::numeric)) OR ((medida = 'embalagem'::text) AND (volume_ml IS NULL) AND (item_tipo = 'produto'::text) AND (preco_brl = (0)::numeric) AND (rotulo IS NOT NULL) AND (btrim(rotulo) <> ''::text))))"
    },
    {
      "name": "catalogo_volumes_microrganismo_id_fkey",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "FOREIGN KEY (microrganismo_id) REFERENCES microrganismos(id) ON DELETE CASCADE"
    },
    {
      "name": "catalogo_volumes_owner_organization_id_fkey",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "FOREIGN KEY (owner_organization_id) REFERENCES organizations(id)"
    },
    {
      "name": "catalogo_volumes_pkey",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "catalogo_volumes_preco_brl_check",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "CHECK ((preco_brl >= (0)::numeric))"
    },
    {
      "name": "catalogo_volumes_produto_id_fkey",
      "relation": "catalogo_volumes",
      "validated": true,
      "definition": "FOREIGN KEY (produto_id) REFERENCES produtos(id) ON DELETE CASCADE"
    },
    {
      "name": "pp_codigo_version",
      "relation": "product_packagings",
      "validated": true,
      "definition": "UNIQUE (product_id, codigo, version)"
    },
    {
      "name": "pp_presentation_link",
      "relation": "product_packagings",
      "validated": true,
      "definition": "TRIGGER DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "name": "pp_window",
      "relation": "product_packagings",
      "validated": true,
      "definition": "CHECK (((valid_to IS NULL) OR (valid_to >= valid_from)))"
    },
    {
      "name": "product_packagings_codigo_check",
      "relation": "product_packagings",
      "validated": true,
      "definition": "CHECK ((btrim(codigo) <> ''::text))"
    },
    {
      "name": "product_packagings_id_fkey",
      "relation": "product_packagings",
      "validated": true,
      "definition": "FOREIGN KEY (id) REFERENCES catalogo_volumes(id) ON DELETE RESTRICT"
    },
    {
      "name": "product_packagings_peso_liquido_kg_check",
      "relation": "product_packagings",
      "validated": true,
      "definition": "CHECK ((peso_liquido_kg > (0)::numeric))"
    },
    {
      "name": "product_packagings_pkey",
      "relation": "product_packagings",
      "validated": true,
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "product_packagings_product_id_fkey",
      "relation": "product_packagings",
      "validated": true,
      "definition": "FOREIGN KEY (product_id) REFERENCES produtos(id)"
    },
    {
      "name": "product_packagings_version_check",
      "relation": "product_packagings",
      "validated": true,
      "definition": "CHECK ((version >= 1))"
    },
    {
      "name": "product_sale_units_pkey",
      "relation": "product_sale_units",
      "validated": true,
      "definition": "PRIMARY KEY (product_id)"
    },
    {
      "name": "product_sale_units_product_id_fkey",
      "relation": "product_sale_units",
      "validated": true,
      "definition": "FOREIGN KEY (product_id) REFERENCES produtos(id)"
    },
    {
      "name": "product_sale_units_unidade_conteudo_check",
      "relation": "product_sale_units",
      "validated": true,
      "definition": "CHECK ((unidade_conteudo = ANY (ARRAY['kg'::text, 'g'::text, 'ml'::text, 'l'::text])))"
    },
    {
      "name": "product_sale_units_version_check",
      "relation": "product_sale_units",
      "validated": true,
      "definition": "CHECK ((version >= 1))"
    },
    {
      "name": "produtos_familia_catalogo_check",
      "relation": "produtos",
      "validated": true,
      "definition": "CHECK (((familia_catalogo IS NULL) OR (familia_catalogo = ANY (ARRAY['biologico'::text, 'quimico'::text, 'fertilizante_adubo'::text]))))"
    },
    {
      "name": "produtos_owner_organization_id_fkey",
