DO $$DECLARE p oid:=to_regprocedure('platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)');BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) IS DISTINCT FROM '96344fea5616fda485be977a3d2d2a35' THEN RAISE EXCEPTION 'FINISHED_PRE_FUNCTION_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
 IF (SELECT r.rolname FROM pg_proc x JOIN pg_roles r ON r.oid=x.proowner WHERE x.oid=p) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'FINISHED_PRE_OWNER_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
 IF (SELECT coalesce(x.proacl::text,'') FROM pg_proc x WHERE x.oid=p) IS DISTINCT FROM '{postgres=X/postgres}' THEN RAISE EXCEPTION 'FINISHED_PRE_ACL_DRIFT platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb)';END IF;
END$$;
