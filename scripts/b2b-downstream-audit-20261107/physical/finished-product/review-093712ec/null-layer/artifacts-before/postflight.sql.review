DO $$DECLARE d text;e text;ty smallint;BEGIN
 SELECT pg_get_triggerdef(t.oid),t.tgenabled::text,t.tgtype INTO d,e,ty FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE NOT t.tgisinternal AND n.nspname='public' AND c.relname='estoque_produto' AND t.tgname='a000_estoque_produto_catalog_tenant_guard';
 IF NOT FOUND OR d IS DISTINCT FROM 'CREATE TRIGGER a000_estoque_produto_catalog_tenant_guard BEFORE INSERT OR UPDATE ON public.estoque_produto FOR EACH ROW EXECUTE FUNCTION platform_private.estoque_produto_catalog_tenant_guard()' OR e IS DISTINCT FROM 'O' OR ty IS DISTINCT FROM 23 THEN RAISE EXCEPTION 'FINISHED_TRIGGER_DRIFT public.estoque_produto.a000_estoque_produto_catalog_tenant_guard';END IF;
END$$;
