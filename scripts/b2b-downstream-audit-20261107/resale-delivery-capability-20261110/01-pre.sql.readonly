-- PRE somente leitura; falha fechada. Pins LIVE informados pelo auditor (readonly produção).
DO $$
DECLARE r record;
BEGIN
 IF to_regprocedure('public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text)') IS NOT NULL THEN RAISE EXCEPTION 'PRE_TARGET_PRESENT'; END IF;
 IF has_function_privilege('authenticated','public.rpc_entrega_confirmar_manual_v1(uuid,timestamptz,text,jsonb)','EXECUTE') THEN RAISE EXCEPTION 'PRE_WRITER_OPEN_NOT_LIVE'; END IF;
 FOR r IN SELECT * FROM (VALUES
  ('platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)','63f49feea167f6865fd7840cde7dc63b'),
  ('platform_private.delivery_actor_20261030(text)','c6da1f5d9581a0c290e5e27e4605682c'),
  ('public.fn_estoque_pode_operar(uuid,text)','d0d1e37b39e6f9f814c832ec63a540dd'),
  ('platform_private.b2b_resale_os_operational_valid_v1(public.ordens_servico)','7cd8ee22794bf57e6592867259c9397e')) v(sig,m) LOOP
  IF to_regprocedure(r.sig) IS NULL OR md5(pg_get_functiondef(r.sig::regprocedure)) IS DISTINCT FROM r.m THEN RAISE EXCEPTION 'PRE_BODY_DRIFT %',r.sig; END IF;
  IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=r.sig::regprocedure)<>'postgres' THEN RAISE EXCEPTION 'PRE_OWNER_DRIFT %',r.sig; END IF;
 END LOOP;
 FOR r IN SELECT unnest(ARRAY['platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)','platform_private.delivery_actor_20261030(text)','platform_private.b2b_resale_os_operational_valid_v1(public.ordens_servico)']) sig LOOP
  IF has_function_privilege('authenticated',r.sig,'EXECUTE') OR has_function_privilege('anon',r.sig,'EXECUTE') THEN RAISE EXCEPTION 'PRE_PRIVATE_ACL_DRIFT %',r.sig; END IF;
 END LOOP;
 -- Tabela real: sem organization_id em estoque_produto; tenant pelo lote.
 IF EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='estoque_produto' AND column_name='organization_id') THEN RAISE EXCEPTION 'PRE_SCHEMA_UNEXPECTED'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='lotes' AND column_name='organization_id') THEN RAISE EXCEPTION 'PRE_LOT_TENANT_ABSENT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='estoque_produto' AND column_name='origem_estoque') THEN RAISE EXCEPTION 'PRE_PHYSICAL_ABSENT'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'PRE_LOGISTICS_GATE_OPEN_UNEXPECTED'; END IF;
END$$;
SELECT 'PRE_PASS' AS result;
