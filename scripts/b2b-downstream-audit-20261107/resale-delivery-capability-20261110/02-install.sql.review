-- Candidato INATIVO revisável v2 (revisor: agente Codex). Somente leitura: sem escrita, sem locks,
-- sem EXECUTE a writers, sem mudar gates/concessões. Tenant do estoque = lote (estoque_produto não tem organization_id).
BEGIN;
DO $$BEGIN IF to_regprocedure('public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text)') IS NOT NULL THEN RAISE EXCEPTION 'RESALE_DELIVERY_CAP_ALREADY_INSTALLED'; END IF; END$$;

CREATE FUNCTION public.rpc_b2b_resale_delivery_capability_v1(p_os_id uuid, p_stock_ids uuid[], p_operation text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE
 v_uid uuid:=auth.uid(); v_org uuid; v_os public.ordens_servico%ROWTYPE; v_partner uuid; v_n int; v_ok int;
 -- Envelope fechado: não ecoa OS, empresa, saldo nem IDs.
 v_closed jsonb:=jsonb_build_object('capability','b2b_resale_delivery_v2','organization_id',NULL,'os_id',NULL,'operation',p_operation,'allowed',false,'stock_ids','[]'::jsonb);
BEGIN
 v_n:=coalesce(array_length(p_stock_ids,1),0);
 IF v_uid IS NULL OR p_os_id IS NULL OR p_operation IS NULL OR p_operation NOT IN ('reserve','delivery_create')
    OR v_n<1 OR v_n>100 OR array_position(p_stock_ids,NULL) IS NOT NULL
    OR (SELECT count(DISTINCT x) FROM unnest(p_stock_ids) x)<>v_n THEN RETURN v_closed; END IF;
 BEGIN v_org:=platform_private.delivery_actor_20261030('group'); EXCEPTION WHEN OTHERS THEN RETURN v_closed; END;
 IF v_org IS NULL THEN RETURN v_closed; END IF;
 IF p_operation='reserve' THEN
  BEGIN IF public.fn_estoque_pode_operar(v_uid,'reserva') IS NOT TRUE THEN RETURN v_closed; END IF; EXCEPTION WHEN OTHERS THEN RETURN v_closed; END;
 END IF;
 -- Escopo do ator conhecido antes de ler a OS; nenhuma linha de outra empresa é lida.
 SELECT * INTO v_os FROM public.ordens_servico WHERE id=p_os_id AND organization_id=v_org;
 IF NOT FOUND OR v_os.origem IS DISTINCT FROM 'b2b' OR v_os.partner_order_id IS NULL OR v_os.partner_order_item_id IS NULL THEN RETURN v_closed; END IF;
 -- OS operacional válida vale para reserve E delivery_create.
 BEGIN IF platform_private.b2b_resale_os_operational_valid_v1(v_os) IS NOT TRUE THEN RETURN v_closed; END IF; EXCEPTION WHEN OTHERS THEN RETURN v_closed; END;
 SELECT po.partner_id INTO v_partner FROM public.partner_orders po
  JOIN public.partner_accounts pa ON pa.id=po.partner_id AND pa.commercial_owner_organization_id=v_org
  WHERE po.id=v_os.partner_order_id;
 IF v_partner IS NULL THEN RETURN v_closed; END IF;
 -- Todos os itens: linhagem real lote->tenant/produto, produto acabado e concessão exata vigente.
 SELECT count(*) INTO v_ok FROM unnest(p_stock_ids) x
  JOIN public.estoque_produto s ON s.id=x
  JOIN public.lotes l ON l.id=s.lote_id AND l.organization_id=v_org AND l.produto_id=s.produto_id
  WHERE s.origem_estoque IS NOT NULL AND s.produto_id=v_os.produto_id
   AND platform_private.resale_pilot_scope_v1('b2b_resale',p_operation,v_uid,v_org,v_partner,v_os.partner_order_id,v_os.partner_order_item_id,s.produto_id,s.id,NULL) IS TRUE;
 IF v_ok<>v_n THEN RETURN v_closed; END IF;
 RETURN jsonb_build_object('capability','b2b_resale_delivery_v2','organization_id',v_org,'os_id',p_os_id,'operation',p_operation,'allowed',true,
  'stock_ids',(SELECT jsonb_agg(x ORDER BY x) FROM unnest(p_stock_ids) x));
END $$;
ALTER FUNCTION public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text) OWNER TO postgres;
REVOKE ALL ON FUNCTION public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text) FROM PUBLIC,anon,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text) TO authenticated;
COMMIT;
