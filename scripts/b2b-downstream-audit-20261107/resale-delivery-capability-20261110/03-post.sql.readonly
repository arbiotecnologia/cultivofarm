DO $$
DECLARE p regprocedure:='public.rpc_b2b_resale_delivery_capability_v1(uuid,uuid[],text)'::regprocedure;
BEGIN
 IF md5(pg_get_functiondef(p)) IS DISTINCT FROM ':CAP_MD5:' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
 IF (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p)<>'postgres' OR (SELECT prosecdef FROM pg_proc WHERE oid=p) IS NOT TRUE OR (SELECT provolatile FROM pg_proc WHERE oid=p)<>'v' THEN RAISE EXCEPTION 'POST_META_DRIFT'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid=p) IS DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres}' THEN RAISE EXCEPTION 'POST_ACL_DRIFT'; END IF;
 IF has_function_privilege('authenticated','public.rpc_entrega_confirmar_manual_v1(uuid,timestamptz,text,jsonb)','EXECUTE') THEN RAISE EXCEPTION 'POST_WRITER_OPENED'; END IF;
 IF EXISTS(SELECT 1 FROM platform_private.b2b_resale_logistics_gate_v1 WHERE enabled) THEN RAISE EXCEPTION 'POST_GATE_OPENED'; END IF;
END$$;
SELECT 'POST_PASS' AS result;
