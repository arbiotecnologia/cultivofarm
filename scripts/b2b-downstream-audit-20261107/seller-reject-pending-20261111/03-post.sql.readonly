BEGIN READ ONLY;
DO $$DECLARE p oid:=to_regprocedure('public.reject_b2b_payment_terms_secure(uuid,text)'); BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) NOT IN ('988935a5dfdbaa3914954f4b2fa66ec7') OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres'
 OR (SELECT array_agg(a::text ORDER BY a::text) FROM pg_proc,unnest(proacl) a WHERE oid=p) IS DISTINCT FROM ARRAY['authenticated=X/postgres','postgres=X/postgres','service_role=X/postgres']::text[] THEN
 RAISE EXCEPTION 'B2B_REJECT_CATALOG_DRIFT'; END IF;END$$;
SELECT 'POST_PASS';
ROLLBACK;
