BEGIN;
DO $$DECLARE p oid:=to_regprocedure('public.reject_b2b_payment_terms_secure(uuid,text)'); BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) NOT IN ('40777d0cec6a7d8a8d4dfcb3370b08b6','988935a5dfdbaa3914954f4b2fa66ec7','dae0d60c90d283401217bd4c7050397c') OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres'
 OR (SELECT array_agg(a::text ORDER BY a::text) FROM pg_proc,unnest(proacl) a WHERE oid=p) IS DISTINCT FROM ARRAY['authenticated=X/postgres','postgres=X/postgres','service_role=X/postgres']::text[] THEN
 RAISE EXCEPTION 'B2B_REJECT_CATALOG_DRIFT'; END IF;END$$;
CREATE OR REPLACE FUNCTION public.reject_b2b_payment_terms_secure(p_partner_order_id uuid, p_reason text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
 RAISE EXCEPTION 'B2B_REJECT_ROLLBACK_CLOSED' USING ERRCODE='42501';
END;
$function$
;
DO $$DECLARE p oid:=to_regprocedure('public.reject_b2b_payment_terms_secure(uuid,text)'); BEGIN
 IF p IS NULL OR md5(pg_get_functiondef(p)) NOT IN ('dae0d60c90d283401217bd4c7050397c') OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p) IS DISTINCT FROM 'postgres'
 OR (SELECT array_agg(a::text ORDER BY a::text) FROM pg_proc,unnest(proacl) a WHERE oid=p) IS DISTINCT FROM ARRAY['authenticated=X/postgres','postgres=X/postgres','service_role=X/postgres']::text[] THEN
 RAISE EXCEPTION 'B2B_REJECT_CATALOG_DRIFT'; END IF;END$$;
COMMIT;
