-- PRE somente leitura; falha fechada.
DO $$DECLARE p regprocedure:='public.rpc_estoque_reservar_v1(uuid,text,jsonb,text,jsonb)'::regprocedure;
BEGIN
 IF md5(pg_get_functiondef(p)) IS DISTINCT FROM '3e0dc7c48ab28f4402699b234476aa8a' THEN RAISE EXCEPTION 'PRE_BODY_DRIFT'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid=p) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p)<>'postgres' THEN RAISE EXCEPTION 'PRE_ACL_OWNER_DRIFT'; END IF;
 -- Helper de escopo: estágio INTERMEDIÁRIO 61-pilot-containment (mesmo pin do pacote de capability).
 IF md5(pg_get_functiondef('platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)'::regprocedure)) IS DISTINCT FROM '63f49feea167f6865fd7840cde7dc63b' THEN RAISE EXCEPTION 'PRE_SCOPE_DRIFT'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_resale_os_operational_valid_v1(public.ordens_servico)'::regprocedure)) IS DISTINCT FROM '7cd8ee22794bf57e6592867259c9397e' THEN RAISE EXCEPTION 'PRE_OS_OPERATIONAL_DRIFT'; END IF;
 IF has_function_privilege('authenticated','platform_private.resale_pilot_scope_v1(text,text,uuid,uuid,uuid,uuid,uuid,uuid,uuid,uuid)','EXECUTE') THEN RAISE EXCEPTION 'PRE_SCOPE_ACL_DRIFT'; END IF;
END$$;
SELECT 'PRE_PASS' AS result;
