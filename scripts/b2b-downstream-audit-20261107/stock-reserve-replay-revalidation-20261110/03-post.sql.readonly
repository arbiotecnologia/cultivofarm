DO $$DECLARE p regprocedure:='public.rpc_estoque_reservar_v1(uuid,text,jsonb,text,jsonb)'::regprocedure;
BEGIN
 IF md5(pg_get_functiondef(p)) IS DISTINCT FROM ':CAND_MD5:' THEN RAISE EXCEPTION 'POST_BODY_DRIFT'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid=p) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=p)<>'postgres' OR (SELECT prosecdef FROM pg_proc WHERE oid=p) IS NOT TRUE THEN RAISE EXCEPTION 'POST_ACL_DRIFT'; END IF;
END$$;
SELECT 'POST_PASS' AS result;
