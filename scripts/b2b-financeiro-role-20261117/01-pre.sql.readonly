-- PRE somente leitura do perfil Financeiro B2B. Falha fechada se ref/estado divergir.
DO $$
DECLARE k text; v text;
  pins jsonb := '{"admin_provision_user_profile_v1": ["admin_provision_user_profile_v1", "39ddbeec70147af43391d0da59a7412e"], "b2b_finish_provisioning": ["b2b_finish_provisioning", "b2e92f75d7f4f5c91ae26014c80773a3"], "fn_authz_uid_scope_ok": ["fn_authz_uid_scope_ok", "00a9a4d4a075d756d312d69778493b39"], "fn_b2b_credit_exposure": ["fn_b2b_credit_exposure", "7d841856ba1e2dd34b0fa6491c4914b5"], "is_financial_staff": ["is_financial_staff", "6e8f2fa7b92ca7e039d092353b3ebfe2"], "platform_private.b2b_allocation_money_row": ["platform_private.b2b_allocation_money_row", "2c8e4c323d1625bd06b9756c5fc7891d"], "platform_private.b2b_credit_balances": ["platform_private.b2b_credit_balances", "9fbf08a16f6bcbec379945886c85c245"], "platform_private.b2b_credit_config_block": ["platform_private.b2b_credit_config_block", "a9ff339b7a9151b0945a37ef9aef66e3"], "platform_private.b2b_debtor_partner": ["platform_private.b2b_debtor_partner", "19d096e643067fc3c73d0a0a1546d0ea"], "platform_private.b2b_integration_actor": ["platform_private.b2b_integration_actor", "d75b9aff1d4c01c08869dfc24033f7af"], "platform_private.b2b_legacy_money_row": ["platform_private.b2b_legacy_money_row", "72d0b11083230fa663da46df31b7af22"], "platform_private.b2b_order_residual": ["platform_private.b2b_order_residual", "93769163bfc7c72a4bbc722e62313179"], "platform_private.b2b_own_obligations_owner": ["platform_private.b2b_own_obligations_owner", "29d950dbb0a1790c8c500a2125102d1f"], "platform_private.b2b_proven_money_row_internal": ["platform_private.b2b_proven_money_row_internal", "b4cfcf65495322ce3c3b911a3597abe2"], "platform_private.b2b_receivable_partner_scope": ["platform_private.b2b_receivable_partner_scope", "cbebb71371eec7bd73fcdc2900088876"], "platform_private.external_provisioning_scope": ["platform_private.external_provisioning_scope", "8e95317dfc59ead452a55a09c8176ced"], "rpc_partner_message_counters": ["rpc_partner_message_counters", "5b049aa45efddf8aff1b92b14a759a46"]}';
BEGIN
  IF current_setting('app.expected_ref', true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_REF_UNPROVEN: execute SET app.expected_ref=''swzpzcwiasxmjutrmvkm'' após conferir o projeto';
  END IF;
  IF to_regprocedure('platform_private.b2b_finance_actor_partner()') IS NOT NULL
     OR to_regprocedure('public.b2b_finance_capability_v1()') IS NOT NULL THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_ALREADY_PRESENT';
  END IF;
  FOR k, v IN SELECT key, value->>1 FROM jsonb_each(pins) LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
       WHERE p.prokind='f' AND (n.nspname||'.'||p.proname = k OR (n.nspname='public' AND p.proname=k))
         AND CASE WHEN p.prokind='f' THEN md5(pg_get_functiondef(p.oid)) END = v) THEN
      RAISE EXCEPTION 'B2B_FIN_PRE_DRIFT:%', k;
    END IF;
  END LOOP;
  IF pg_get_constraintdef((SELECT oid FROM pg_constraint WHERE conname='partner_users_papel_check' AND conrelid='public.partner_users'::regclass))
     IS DISTINCT FROM 'CHECK ((papel = ANY (ARRAY[''gestor''::text, ''tecnico''::text])))' THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_DRIFT:partner_users_papel_check';
  END IF;
  IF EXISTS (SELECT 1 FROM public.partner_users WHERE papel NOT IN ('gestor','tecnico')) THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_UNEXPECTED_PAPEL';
  END IF;
END $$;
SELECT 'PRE_PASS' AS status,
  EXISTS (SELECT 1 FROM pg_enum e JOIN pg_type t ON t.oid=e.enumtypid WHERE t.typname='app_role' AND e.enumlabel='parceiro_b2b_financeiro') AS enum_present;
