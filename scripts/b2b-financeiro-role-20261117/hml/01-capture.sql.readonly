-- HML CAPTURA Financeiro B2B (somente leitura). Executar SOMENTE em vrlcdwmlytukrjezrrnf e devolver as 9 saídas (C0..C8) sem editar.
-- Não contém DDL/DML; roda em transação READ ONLY e aborta se algo tentar escrever. Não lê linhas de negócio, Auth, segredos ou Vault.
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;
-- C0 impressão digital (o SQL não lê o ref; o operador confirma o projeto no conector)
SELECT 'C0' k, current_database() db, version() v, (SELECT count(*) FROM pg_proc) n_proc, now() at;
-- C1 md5 HML × pino de produção para cada função do pacote/cadeia (match=true|false|absent)
WITH want(k) AS (SELECT unnest(ARRAY['admin_provision_user_profile_v1','assert_b2b_partner_scope','b2b_finance_capability_v1','b2b_finance_credit_v1','b2b_finish_provisioning','fn_authz_uid_scope_ok','fn_b2b_credit_exposure','get_user_partner_id','h15_actor_organization','has_role','is_financial_staff','is_platform_superadmin','is_valid_b2b_partner_user','platform_private.assert_b2b_partner_scope','platform_private.b2b_actor_scope','platform_private.b2b_allocation_money_row','platform_private.b2b_credit_balances','platform_private.b2b_credit_balances_core','platform_private.b2b_credit_config_block','platform_private.b2b_credit_exposure_core','platform_private.b2b_debtor_partner','platform_private.b2b_finance_actor_partner','platform_private.b2b_integration_actor','platform_private.b2b_legacy_money_row','platform_private.b2b_order_residual','platform_private.b2b_own_obligations','platform_private.b2b_own_obligations_owner','platform_private.b2b_proven_money_row_internal','platform_private.b2b_receivable_partner_scope','platform_private.c2_order_actor_scope','platform_private.entitlements_for_user','platform_private.external_provisioning_scope','platform_private.h15_actor_organization','platform_private.has_role','platform_private.platform_actor_access_ready','platform_private.require_service_role','platform_private.user_admin_change_access_type_core','rpc_partner_message_counters','rpc_portal_partner_financial','tenant_admin_partner_link_v1','tenant_admin_user_access_exec_v1']::text[])), pins AS (SELECT key k, value#>>'{}' h FROM jsonb_each('{"admin_provision_user_profile_v1": "39ddbeec70147af43391d0da59a7412e", "b2b_finish_provisioning": "b2e92f75d7f4f5c91ae26014c80773a3", "fn_authz_uid_scope_ok": "00a9a4d4a075d756d312d69778493b39", "fn_b2b_credit_exposure": "7d841856ba1e2dd34b0fa6491c4914b5", "h15_actor_organization": "55edafec08bcc84a00f1526c14334a2c", "has_role": "4d90e93d521a4819d9085f28d742030f", "is_financial_staff": "6e8f2fa7b92ca7e039d092353b3ebfe2", "is_platform_superadmin": "3dfe79d976821244d9b7a7f893d765f2", "is_valid_b2b_partner_user": "0bb0dea04be8ca84c66db7ca6329876c", "platform_private.b2b_allocation_money_row": "2c8e4c323d1625bd06b9756c5fc7891d", "platform_private.b2b_credit_balances": "9fbf08a16f6bcbec379945886c85c245", "platform_private.b2b_credit_config_block": "a9ff339b7a9151b0945a37ef9aef66e3", "platform_private.b2b_debtor_partner": "19d096e643067fc3c73d0a0a1546d0ea", "platform_private.b2b_integration_actor": "d75b9aff1d4c01c08869dfc24033f7af", "platform_private.b2b_legacy_money_row": "72d0b11083230fa663da46df31b7af22", "platform_private.b2b_order_residual": "93769163bfc7c72a4bbc722e62313179", "platform_private.b2b_own_obligations": "74cbea88f6f0ebe10dd8c1df3bdcb0ff", "platform_private.b2b_own_obligations_owner": "29d950dbb0a1790c8c500a2125102d1f", "platform_private.b2b_proven_money_row_internal": "b4cfcf65495322ce3c3b911a3597abe2", "platform_private.b2b_receivable_partner_scope": "cbebb71371eec7bd73fcdc2900088876", "platform_private.external_provisioning_scope": "8e95317dfc59ead452a55a09c8176ced", "platform_private.h15_actor_organization": "64e10608403238a41a9baf92857ca881", "platform_private.has_role": "c5af5b55de6d79da9b73a33948746ae2", "platform_private.platform_actor_access_ready": "47681a678f22fbedd183345395851790", "platform_private.require_service_role": "e70c34d474c739580520c58d806e33f5", "platform_private.user_admin_change_access_type_core": "c2d7f9dfd17fe919ed9fcbb9ea8e6a57", "rpc_partner_message_counters": "5b049aa45efddf8aff1b92b14a759a46", "rpc_portal_partner_financial": "d9d53c802ca11c59d235c7d32d6e8eee", "tenant_admin_user_access_exec_v1": "aa74b1d3705cdd76a9c621bc2593f85d"}'::jsonb))
SELECT 'C1' k, w.k fn, p.oid::regprocedure::text sig, md5(pg_get_functiondef(p.oid)) hml_md5, pins.h prod_md5,
 CASE WHEN p.oid IS NULL THEN 'absent' WHEN pins.h IS NULL THEN 'unpinned' ELSE (md5(pg_get_functiondef(p.oid))=pins.h)::text END match,
 p.prosecdef definer, coalesce(p.proacl::text,'<default>') acl, p.proconfig::text cfg
FROM want w LEFT JOIN pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
 ON p.prokind='f' AND (n.nspname||'.'||p.proname=w.k OR (n.nspname='public' AND p.proname=w.k))
LEFT JOIN pins ON pins.k=w.k ORDER BY 2,3;
-- C2 corpo completo SOMENTE das funções HML divergentes ou sem pino (para revisão; nunca reinstalar corpo de produção às cegas)
WITH want(k) AS (SELECT unnest(ARRAY['admin_provision_user_profile_v1','assert_b2b_partner_scope','b2b_finance_capability_v1','b2b_finance_credit_v1','b2b_finish_provisioning','fn_authz_uid_scope_ok','fn_b2b_credit_exposure','get_user_partner_id','h15_actor_organization','has_role','is_financial_staff','is_platform_superadmin','is_valid_b2b_partner_user','platform_private.assert_b2b_partner_scope','platform_private.b2b_actor_scope','platform_private.b2b_allocation_money_row','platform_private.b2b_credit_balances','platform_private.b2b_credit_balances_core','platform_private.b2b_credit_config_block','platform_private.b2b_credit_exposure_core','platform_private.b2b_debtor_partner','platform_private.b2b_finance_actor_partner','platform_private.b2b_integration_actor','platform_private.b2b_legacy_money_row','platform_private.b2b_order_residual','platform_private.b2b_own_obligations','platform_private.b2b_own_obligations_owner','platform_private.b2b_proven_money_row_internal','platform_private.b2b_receivable_partner_scope','platform_private.c2_order_actor_scope','platform_private.entitlements_for_user','platform_private.external_provisioning_scope','platform_private.h15_actor_organization','platform_private.has_role','platform_private.platform_actor_access_ready','platform_private.require_service_role','platform_private.user_admin_change_access_type_core','rpc_partner_message_counters','rpc_portal_partner_financial','tenant_admin_partner_link_v1','tenant_admin_user_access_exec_v1']::text[])), pins AS (SELECT key k, value#>>'{}' h FROM jsonb_each('{"admin_provision_user_profile_v1": "39ddbeec70147af43391d0da59a7412e", "b2b_finish_provisioning": "b2e92f75d7f4f5c91ae26014c80773a3", "fn_authz_uid_scope_ok": "00a9a4d4a075d756d312d69778493b39", "fn_b2b_credit_exposure": "7d841856ba1e2dd34b0fa6491c4914b5", "h15_actor_organization": "55edafec08bcc84a00f1526c14334a2c", "has_role": "4d90e93d521a4819d9085f28d742030f", "is_financial_staff": "6e8f2fa7b92ca7e039d092353b3ebfe2", "is_platform_superadmin": "3dfe79d976821244d9b7a7f893d765f2", "is_valid_b2b_partner_user": "0bb0dea04be8ca84c66db7ca6329876c", "platform_private.b2b_allocation_money_row": "2c8e4c323d1625bd06b9756c5fc7891d", "platform_private.b2b_credit_balances": "9fbf08a16f6bcbec379945886c85c245", "platform_private.b2b_credit_config_block": "a9ff339b7a9151b0945a37ef9aef66e3", "platform_private.b2b_debtor_partner": "19d096e643067fc3c73d0a0a1546d0ea", "platform_private.b2b_integration_actor": "d75b9aff1d4c01c08869dfc24033f7af", "platform_private.b2b_legacy_money_row": "72d0b11083230fa663da46df31b7af22", "platform_private.b2b_order_residual": "93769163bfc7c72a4bbc722e62313179", "platform_private.b2b_own_obligations": "74cbea88f6f0ebe10dd8c1df3bdcb0ff", "platform_private.b2b_own_obligations_owner": "29d950dbb0a1790c8c500a2125102d1f", "platform_private.b2b_proven_money_row_internal": "b4cfcf65495322ce3c3b911a3597abe2", "platform_private.b2b_receivable_partner_scope": "cbebb71371eec7bd73fcdc2900088876", "platform_private.external_provisioning_scope": "8e95317dfc59ead452a55a09c8176ced", "platform_private.h15_actor_organization": "64e10608403238a41a9baf92857ca881", "platform_private.has_role": "c5af5b55de6d79da9b73a33948746ae2", "platform_private.platform_actor_access_ready": "47681a678f22fbedd183345395851790", "platform_private.require_service_role": "e70c34d474c739580520c58d806e33f5", "platform_private.user_admin_change_access_type_core": "c2d7f9dfd17fe919ed9fcbb9ea8e6a57", "rpc_partner_message_counters": "5b049aa45efddf8aff1b92b14a759a46", "rpc_portal_partner_financial": "d9d53c802ca11c59d235c7d32d6e8eee", "tenant_admin_user_access_exec_v1": "aa74b1d3705cdd76a9c621bc2593f85d"}'::jsonb))
SELECT 'C2' k, p.oid::regprocedure::text sig, md5(pg_get_functiondef(p.oid)) hml_md5, pg_get_functiondef(p.oid) def
FROM want w JOIN pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
 ON p.prokind='f' AND (n.nspname||'.'||p.proname=w.k OR (n.nspname='public' AND p.proname=w.k))
LEFT JOIN pins ON pins.k=w.k WHERE pins.h IS NULL OR md5(pg_get_functiondef(p.oid))<>pins.h ORDER BY 2;
-- C3 dependências diretas das funções de crédito/financeiro no HML (nomes chamados que existem no catálogo)
WITH src AS (SELECT p.oid::regprocedure::text sig, pg_get_functiondef(p.oid) d FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
  WHERE p.proname IN ('fn_b2b_credit_exposure','b2b_credit_balances','b2b_credit_config_block','b2b_integration_actor','b2b_order_residual','b2b_proven_money_row_internal','b2b_receivable_partner_scope','b2b_allocation_money_row','b2b_legacy_money_row','b2b_debtor_partner','rpc_portal_partner_financial','b2b_own_obligations','b2b_own_obligations_owner','rpc_partner_message_counters','user_admin_change_access_type_core','tenant_admin_user_access_exec_v1'))
SELECT 'C3' k, s.sig caller, n.nspname||'.'||p.proname callee FROM src s JOIN pg_proc p ON s.d ~ ('\m'||p.proname||'\(') JOIN pg_namespace n ON n.oid=p.pronamespace
 WHERE n.nspname IN ('public','platform_private') GROUP BY 2,3 ORDER BY 2,3;
-- C4 colunas/NOT NULL/defaults das tabelas usadas (absent quando faltar)
SELECT 'C4' k, t tbl, to_regclass(t) IS NOT NULL present,
 (SELECT string_agg(a.attname||' '||format_type(a.atttypid,a.atttypmod)||CASE WHEN a.attnotnull THEN ' NN' ELSE '' END||coalesce(' ='||pg_get_expr(d.adbin,d.adrelid),''),', ' ORDER BY a.attnum)
  FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attrelid=to_regclass(t) AND a.attnum>0 AND NOT a.attisdropped) cols
FROM unnest(ARRAY['public.partner_users','public.partner_accounts','public.profiles','public.user_roles','public.organizations','public.partner_orders','public.partner_order_financial_links','public.partner_order_payment_schedule','public.partner_financial_settings','public.accounts_receivable','public.accounts_receivable_installments','public.receivable_payments','public.financial_audit_log','public.partner_order_messages','public.platform_org_admin_invites','platform_private.user_authz_epoch','platform_private.b2b_provisioning_receipts','platform_private.b2b_financial_forecasts','platform_private.b4_order_condition_snapshots','platform_private.b2b_document_allocations','platform_private.b2b_allocation_reversals','platform_private.b2b_authorized_documents','platform_private.b2b_fiscal_service_permits','platform_private.price_schedule_snapshots']::text[]) t ORDER BY 2;
-- C5 constraints, RLS e ACL de tabela
SELECT 'C5' k, c.oid::regclass::text tbl, c.relrowsecurity rls, c.relforcerowsecurity force_rls, coalesce(c.relacl::text,'<default>') acl,
 (SELECT string_agg(conname||': '||pg_get_constraintdef(oid),' | ' ORDER BY conname) FROM pg_constraint WHERE conrelid=c.oid) cons
FROM pg_class c WHERE c.oid IN (SELECT to_regclass(t) FROM unnest(ARRAY['public.partner_users','public.partner_accounts','public.profiles','public.user_roles','public.organizations','public.partner_orders','public.partner_order_financial_links','public.partner_order_payment_schedule','public.partner_financial_settings','public.accounts_receivable','public.accounts_receivable_installments','public.receivable_payments','public.financial_audit_log','public.partner_order_messages','public.platform_org_admin_invites','platform_private.user_authz_epoch','platform_private.b2b_provisioning_receipts','platform_private.b2b_financial_forecasts','platform_private.b4_order_condition_snapshots','platform_private.b2b_document_allocations','platform_private.b2b_allocation_reversals','platform_private.b2b_authorized_documents','platform_private.b2b_fiscal_service_permits','platform_private.price_schedule_snapshots']::text[]) t) ORDER BY 2;
-- C6 políticas
SELECT 'C6' k, schemaname||'.'||tablename tbl, policyname, permissive, roles::text, cmd, qual, with_check FROM pg_policies
 WHERE schemaname||'.'||tablename = ANY(ARRAY['public.partner_users','public.partner_accounts','public.profiles','public.user_roles','public.organizations','public.partner_orders','public.partner_order_financial_links','public.partner_order_payment_schedule','public.partner_financial_settings','public.accounts_receivable','public.accounts_receivable_installments','public.receivable_payments','public.financial_audit_log','public.partner_order_messages','public.platform_org_admin_invites','platform_private.user_authz_epoch','platform_private.b2b_provisioning_receipts','platform_private.b2b_financial_forecasts','platform_private.b4_order_condition_snapshots','platform_private.b2b_document_allocations','platform_private.b2b_allocation_reversals','platform_private.b2b_authorized_documents','platform_private.b2b_fiscal_service_permits','platform_private.price_schedule_snapshots']::text[]) ORDER BY 2,3;
-- C7 gatilhos (md5 da função do gatilho)
SELECT 'C7' k, t.tgrelid::regclass::text tbl, t.tgname, t.tgenabled, p.oid::regprocedure::text fn, md5(pg_get_functiondef(p.oid)) fn_md5
FROM pg_trigger t JOIN pg_proc p ON p.oid=t.tgfoid WHERE NOT t.tgisinternal AND t.tgrelid IN (SELECT to_regclass(t) FROM unnest(ARRAY['public.partner_users','public.partner_accounts','public.profiles','public.user_roles','public.organizations','public.partner_orders','public.partner_order_financial_links','public.partner_order_payment_schedule','public.partner_financial_settings','public.accounts_receivable','public.accounts_receivable_installments','public.receivable_payments','public.financial_audit_log','public.partner_order_messages','public.platform_org_admin_invites','platform_private.user_authz_epoch','platform_private.b2b_provisioning_receipts','platform_private.b2b_financial_forecasts','platform_private.b4_order_condition_snapshots','platform_private.b2b_document_allocations','platform_private.b2b_allocation_reversals','platform_private.b2b_authorized_documents','platform_private.b2b_fiscal_service_permits','platform_private.price_schedule_snapshots']::text[]) t) ORDER BY 2,3;
-- C8 enum app_role e Edge-relevant: valores e se o papel financeiro já existe
SELECT 'C8' k, string_agg(e.enumlabel,',' ORDER BY e.enumsortorder) app_role, bool_or(e.enumlabel='parceiro_b2b_financeiro') has_finance_role
FROM pg_enum e WHERE e.enumtypid='public.app_role'::regtype;
ROLLBACK;
