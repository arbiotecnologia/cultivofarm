-- VARIANTE HML gerada por hml/build_hml.py; não editar.
-- PRE somente leitura do perfil Financeiro B2B. Falha fechada se ref/estado divergir.
DO $$
DECLARE k text; v text;
  pins jsonb := '{"admin_provision_user_profile_v1": ["admin_provision_user_profile_v1", "9a2e228a68f369f32fe323c6c2a7f1b8"], "fn_b2b_credit_exposure": ["fn_b2b_credit_exposure", "213ac31f3a30816ead75365b0d1fed18"], "platform_private.b2b_own_obligations_owner": ["platform_private.b2b_own_obligations_owner", "29d950dbb0a1790c8c500a2125102d1f"], "rpc_partner_message_counters": ["rpc_partner_message_counters", "5b049aa45efddf8aff1b92b14a759a46"]}';
BEGIN
  IF current_setting('app.expected_ref', true) IS DISTINCT FROM 'vrlcdwmlytukrjezrrnf' THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_REF_UNPROVEN: execute SET app.expected_ref=''vrlcdwmlytukrjezrrnf'' após conferir o projeto';
  END IF;
  IF to_regprocedure('platform_private.b2b_finance_actor_partner()') IS NOT NULL
     OR to_regprocedure('public.b2b_finance_capability_v1()') IS NOT NULL THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_ALREADY_PRESENT';
  END IF;
  FOR k, v IN SELECT key, value->>1 FROM jsonb_each(pins) LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
       WHERE p.prokind='f' AND (n.nspname||'.'||p.proname = k OR (n.nspname='public' AND p.proname=k))
         AND CASE WHEN p.prokind='f' THEN md5(pg_get_functiondef(p.oid)) END = v) THEN
      RAISE EXCEPTION 'B2B_FIN_PRE_DRIFT:%', k;
    END IF;
  END LOOP;
  IF to_regprocedure('platform_private.external_provisioning_scope(uuid,public.app_role[],uuid,uuid[],uuid)') IS NOT NULL
     OR to_regprocedure('public.b2b_finish_provisioning(uuid,uuid,uuid)') IS NOT NULL THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_HML_PROVISIONING_CHANGED: recapturar';
  END IF;
  IF to_regprocedure('platform_private.b2b_credit_balances(uuid,uuid)') IS NOT NULL THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_HML_CREDIT_CHAIN_PRESENT: HML mudou; recapturar e gerar pacote de crédito revisado';
  END IF;
  IF pg_get_constraintdef((SELECT oid FROM pg_constraint WHERE conname='partner_users_papel_check' AND conrelid='public.partner_users'::regclass))
     IS DISTINCT FROM 'CHECK ((papel = ANY (ARRAY[''gestor''::text, ''tecnico''::text])))' THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_DRIFT:partner_users_papel_check';
  END IF;
  IF EXISTS (SELECT 1 FROM public.partner_users WHERE papel NOT IN ('gestor','tecnico')) THEN
    RAISE EXCEPTION 'B2B_FIN_PRE_UNEXPECTED_PAPEL';
  END IF;
END $$;
SELECT 'PRE_PASS' AS status,
  EXISTS (SELECT 1 FROM pg_enum e JOIN pg_type t ON t.oid=e.enumtypid WHERE t.typname='app_role' AND e.enumlabel='parceiro_b2b_financeiro') AS enum_present;
