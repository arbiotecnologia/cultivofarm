-- HML: exposure_core omitido (cadeia de crédito B4 ausente no HML; crédito fechado).

-- HML: fn_b2b_credit_exposure omitido (cadeia de crédito B4 ausente no HML; crédito fechado).

CREATE OR REPLACE FUNCTION public.rpc_partner_message_counters(p_partner_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE v_partner uuid := COALESCE(p_partner_id, get_user_partner_id());
BEGIN
  IF platform_private.b2b_finance_role_holder() THEN
    RAISE EXCEPTION 'permission_denied' USING ERRCODE = '42501';
  END IF;
  IF NOT (public.has_role(auth.uid(), 'administrador'::public.app_role)
      or public.has_role(auth.uid(), 'gestor_comercial'::public.app_role)
      or (public.get_user_partner_id() is not null
          and (p_partner_id is null or p_partner_id = public.get_user_partner_id()))) THEN
    RAISE EXCEPTION 'permission_denied' USING ERRCODE = '42501';
  END IF;
  RETURN (
    SELECT jsonb_build_object(
      'nao_lidas', COUNT(*) FILTER (WHERE m.status = 'nao_lida'),
      'pendentes', COUNT(*) FILTER (WHERE m.status IN ('nao_lida','lida')),
      'respondidas', COUNT(*) FILTER (WHERE m.status = 'respondida'),
      'encerradas', COUNT(*) FILTER (WHERE m.status = 'encerrada')
    )
    FROM public.partner_order_messages m
    JOIN public.partner_orders po ON po.id = m.order_id
    WHERE (v_partner IS NULL OR po.partner_id = v_partner)
  );
END $function$;

-- 6b. Leitor de crédito próprio: parceiro derivado do servidor, projeção sem parâmetros de política.
CREATE FUNCTION platform_private.b2b_finance_credit_core()
 RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO ''
AS $function$
BEGIN
 -- HML: cadeia canônica de crédito ausente; nunca cair na fórmula legada sem gate.
 RAISE EXCEPTION 'own_finance_credit_unavailable' USING ERRCODE='42501';
END $function$;
CREATE FUNCTION public.b2b_finance_credit_v1()
 RETURNS jsonb LANGUAGE sql STABLE SET search_path TO ''
AS $function$ SELECT platform_private.b2b_finance_credit_core(); $function$;

-- 7. ACL mínima (padrão do projeto concede service_role a funções novas: revogar).
REVOKE ALL ON FUNCTION platform_private.b2b_finance_role_holder() FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION platform_private.b2b_finance_role_holder() TO authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_finance_actor_partner() FROM PUBLIC, anon, authenticated, service_role;
REVOKE ALL ON FUNCTION platform_private.b2b_finance_capability_core() FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION platform_private.b2b_finance_capability_core() TO authenticated;
REVOKE ALL ON FUNCTION public.b2b_finance_capability_v1() FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION public.b2b_finance_capability_v1() TO authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_finance_credit_core() FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION platform_private.b2b_finance_credit_core() TO authenticated;
REVOKE ALL ON FUNCTION public.b2b_finance_credit_v1() FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION public.b2b_finance_credit_v1() TO authenticated;
COMMIT;
