-- GERADO por build_seed.py a partir de 05-seed.template.sql + _lib.sql; não editar.
-- SEED QA Financeiro B2B — SOMENTE HML vrlcdwmlytukrjezrrnf, como postgres, numa única transação (SQL editor do HML).
-- Pré-requisito: 04 (registro das assinaturas/overrides QA já criados pelo root). Parceiros e usuários QA já existem e são
-- identificados por IDs fixos (não recriados). Cria por parceiro 1 pedido + 1 título B2B_ORDER + parcelas + vínculo, com IDs
-- manifestados em qa_b2bfin.manifest. Única exceção: o bloqueio homolog de inserção de títulos, relaxado só para
-- postgres + ticket desta txid + IDs manifestados com descrição QA-FIN-, e restaurado (def/md5 idênticos) ANTES do COMMIT.
-- Nenhum gatilho é desativado; todas as demais guardas executam normalmente e qualquer recusa aborta tudo. Sem NF/cobrança.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $$ BEGIN
 IF session_user <> 'postgres' THEN RAISE EXCEPTION 'QA_SEED_REFUSED: session_user'; END IF;
 IF to_regprocedure('platform_private.homolog_validation_block_receivable_insert()') IS NULL THEN RAISE EXCEPTION 'QA_SEED_REFUSED: impressão digital HML ausente — alvo não é vrlcdwmlytukrjezrrnf'; END IF;
 IF to_regprocedure('platform_private.b2b_credit_balances(uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'QA_SEED_REFUSED: cadeia B4 presente — alvo parece produção'; END IF;
 IF (SELECT count(*) FROM public.organizations WHERE id IN ('525fea87-e27e-43f7-af7b-a30064188332','85ba8b71-8514-4ec9-90d3-bfc7ab3ed214')) <> 2 THEN RAISE EXCEPTION 'QA_SEED_REFUSED: tenants QA ausentes'; END IF;
 IF to_regclass('qa_b2bfin.manifest') IS NULL THEN RAISE EXCEPTION 'QA_SEED_REFUSED: rodar 04 e seed_saas.py antes'; END IF;
 IF NOT EXISTS (SELECT 1 FROM qa_b2bfin.manifest WHERE kind='subscription') THEN RAISE EXCEPTION 'QA_SEED_REFUSED: rodar 04 antes'; END IF;
 IF EXISTS (SELECT 1 FROM qa_b2bfin.manifest WHERE kind='receivable') THEN RAISE EXCEPTION 'QA_SEED_REFUSED: seed anterior existe — rodar 06 antes'; END IF;
END $$;
-- C11 (captura real HML 2026-11-18): todo gatilho das tabelas tocadas deve ter o corpo capturado (md5 de prosrc); qualquer
-- deriva ou gatilho não capturado recusa ANTES de escrever.
DO $$ DECLARE pins jsonb := '{"platform_private.b2b_internal_child_snapshot_guard()": "8b1e5f5c4daff773d9e381b935ad4850", "platform_private.b2b_internal_order_snapshot_guard()": "2f4e05cde1b715e627f75564b9852105", "platform_private.c2_accounting_pending_guard()": "236da166229dcab49a90a0cc41365814", "platform_private.c2_external_final_state_guard()": "c8acf08966b02dbb3bad0e64e9892bc2", "platform_private.c2p1_settings_fence()": "20f57a91f488e32a5b5aca0b6bc6a926", "platform_private.delivery_no_downstream_20261030()": "933f56e984a48d345bfbb6744527bb53", "platform_private.delivery_order_transition_guard_20261030()": "937ebddc16dc20f5d437ded927fba842", "platform_private.homolog_validation_block_receivable_insert()": "4b82354e6727da801a348607c8a5c5c4", "public._saas_trg_require_feature()": "acf6aa9d659f17a1082fb1147f9e8bdf", "public.audit_partner_order_payment_terms()": "ddd4e5725b6d069a357a7a3412dfac26", "public.d51_5_validate_financial_tenant_links()": "b161d97a97a94cdfe3d93df4689eb5b9", "public.fn_b2b_guard_credit_approval_fields()": "fd1ebc409ea4f31e3c3660c1abad5740", "public.fn_financial_audit()": "8ed2aa015bfdc43f32cb4009d9f7b9ad", "public.fn_generate_receivable_installments()": "aeb38c876ac3e1e5a7564844cecaca66", "public.fn_h6_guard_title_snapshot()": "bc877eab69e8a13c2147f6091134b54e", "public.fn_h6c_set_canonical_payment_terms()": "95daffec6d0f951cf92b3ffb9d0eccc2", "public.fn_h6d_block_hard_delete()": "353aa9a344ca7a4499514b02f6accbbc", "public.guard_tenant_organization_id()": "8f52469b9ba3ea8de23e57cbb46234fc", "public.partner_orders_audit_trigger()": "a40da5e75a575e558dbb638f75c37114", "public.tg_audit_partner_order_commercial()": "f9c5329c0b55c62a80d2a05c4457f100", "public.tg_auto_b2b_receivable()": "f9103f25e71af6d01fcdcd863069e2d5", "public.tg_b2b_block_receivable_before_approval()": "fbb80bceaa6c5bb3ffcc307188ec226a", "public.tg_b2b_enforce_plan_selectable()": "1f501989555b7c4803dd8a51a310a91d", "public.tg_block_partner_order_delete()": "adea2d875f45313127a8823ea11232a6", "public.tg_block_partner_order_edit_after_op()": "7f857f54a9cfcf39c5c9bb26a4ad9d0f", "public.tg_block_pofl_delete()": "2868ad7deee40259eb448a7b40f874ba", "public.tg_governance_audit()": "0eed19be81a10a21adc22258c8daef8e", "public.tg_notify_payment_terms_pending()": "9f7b6a5375680f2f27c3863cd1d6438e", "public.tg_partner_orders_credit_guard()": "8839601441fba1f1be9a24f8e1c90fc0", "public.tg_partner_orders_require_items()": "7a4125d9a007dfcfb02e801783dc5124", "public.tg_pfs_updated_at()": "e3addd320004eb7a8494e7a0c2614c97", "public.tg_pofl_updated_at()": "e3addd320004eb7a8494e7a0c2614c97", "public.tg_recalc_risk_on_ar_change()": "92ee484ac4c401d615ade529a65fecf3", "public.tg_refresh_engagement()": "e70bcec2bc81d38468d68dd70b941f8b", "public.tg_sync_b2b_financial_status()": "a7b7a13d9fd1082a8cff91c6dd5ae6fa", "public.trg_partner_order_timeline()": "aefd3dbbdc0d7081cce4c50cfa494bad", "public.trg_partner_order_to_planning_fn()": "21ed58dacbe9ab84c77a90956ca97c39", "public.update_updated_at_column()": "a27bb088c067b7b77a9f0707b0048e40"}'; k text; m text; f text; BEGIN
 FOR k IN SELECT jsonb_object_keys(pins) LOOP
  SELECT md5(prosrc) INTO m FROM pg_proc WHERE oid = to_regprocedure(k);
  IF m IS DISTINCT FROM pins->>k THEN RAISE EXCEPTION 'QA_SEED_REFUSED: deriva C11 em % (md5 %)', k, coalesce(m, 'ausente'); END IF;
 END LOOP;
 SELECT string_agg(DISTINCT t.tgrelid::regclass || ':' || t.tgfoid::regprocedure::text, ', ') INTO f FROM pg_trigger t
  WHERE NOT t.tgisinternal AND t.tgenabled <> 'D' AND t.tgrelid IN ('public.partner_orders'::regclass, 'public.accounts_receivable'::regclass,
   'public.accounts_receivable_installments'::regclass, 'public.partner_order_payment_terms'::regclass, 'public.partner_order_payment_schedule'::regclass,
   'public.partner_order_financial_links'::regclass, 'public.partner_financial_settings'::regclass)
   AND t.tgfoid NOT IN (SELECT to_regprocedure(x)::oid FROM jsonb_object_keys(pins) x);
 IF f IS NOT NULL THEN RAISE EXCEPTION 'QA_SEED_REFUSED: gatilho não capturado em C11: %', f; END IF;
END $$;
-- Biblioteca transacional QA (criada e destruída na MESMA transação de 05/06). Somente session_user=postgres.
CREATE TABLE IF NOT EXISTS qa_b2bfin.ticket(txid bigint PRIMARY KEY, op text NOT NULL);
CREATE TABLE IF NOT EXISTS qa_b2bfin.saved_fn(fn regprocedure PRIMARY KEY, def text NOT NULL, src_md5 text NOT NULL);
CREATE TABLE IF NOT EXISTS qa_b2bfin.rowmark(rowhash text PRIMARY KEY, tbl regclass NOT NULL);
REVOKE ALL ON ALL TABLES IN SCHEMA qa_b2bfin FROM PUBLIC;
-- Exceção estrita: postgres + ticket desta transação + linha manifestada (id pré-registrado ou hash de linha derivada).
CREATE OR REPLACE FUNCTION qa_b2bfin.allowed(j jsonb) RETURNS boolean LANGUAGE sql STABLE SET search_path TO '' AS $f$
 SELECT session_user = 'postgres' AND j IS NOT NULL
  AND EXISTS (SELECT 1 FROM qa_b2bfin.ticket t WHERE t.txid = txid_current())
  AND (EXISTS (SELECT 1 FROM qa_b2bfin.manifest m WHERE m.id::text = j->>'id' AND (m.kind <> 'receivable' OR j->>'description' LIKE 'QA-FIN-%'))
       OR EXISTS (SELECT 1 FROM qa_b2bfin.rowmark r WHERE r.rowhash = md5(j::text)))
$f$;
CREATE OR REPLACE FUNCTION qa_b2bfin.relax(f regprocedure) RETURNS void LANGUAGE plpgsql SET search_path TO '' AS $f$
DECLARE p pg_proc%ROWTYPE; d text; src text; pos int; inner_ text; pre text;
BEGIN
 SELECT * INTO p FROM pg_proc WHERE oid = f;
 IF (SELECT lanname FROM pg_language WHERE oid = p.prolang) <> 'plpgsql' OR p.prorettype <> 'trigger'::regtype THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: % não é trigger plpgsql', f; END IF;
 IF EXISTS (SELECT 1 FROM qa_b2bfin.saved_fn s WHERE s.fn = f) THEN RETURN; END IF;
 src := p.prosrc; IF src ~ '^\s*#' THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: diretiva em %', f; END IF;
 d := pg_get_functiondef(f); pos := position(src IN d); IF pos = 0 THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: corpo não localizado %', f; END IF;
 INSERT INTO qa_b2bfin.saved_fn VALUES (f, d, md5(src));
 inner_ := rtrim(src, E' \n\t\r'); IF right(inner_, 1) <> ';' THEN inner_ := inner_ || ';'; END IF;
 pre := E'\nBEGIN\n IF TG_LEVEL = ''ROW'' THEN\n  IF TG_OP = ''DELETE'' THEN IF qa_b2bfin.allowed(to_jsonb(OLD)) THEN RETURN OLD; END IF;\n'
     || E'  ELSIF qa_b2bfin.allowed(to_jsonb(NEW)) THEN RETURN NEW; END IF;\n END IF;\n';
 EXECUTE left(d, pos - 1) || pre || inner_ || E'\nEND;\n' || substr(d, pos + length(src));
END $f$;
CREATE OR REPLACE FUNCTION qa_b2bfin.restore_all() RETURNS jsonb LANGUAGE plpgsql SET search_path TO '' AS $f$
DECLARE s record; out jsonb := '[]';
BEGIN
 FOR s IN SELECT * FROM qa_b2bfin.saved_fn LOOP
  EXECUTE s.def;
  IF (SELECT md5(prosrc) FROM pg_proc WHERE oid = s.fn) <> s.src_md5 OR pg_get_functiondef(s.fn) <> s.def THEN RAISE EXCEPTION 'QA_RESTORE_DRIFT %', s.fn; END IF;
  out := out || jsonb_build_object('fn', s.fn::text, 'md5', s.src_md5);
 END LOOP;
 DELETE FROM qa_b2bfin.saved_fn; DELETE FROM qa_b2bfin.ticket;
 RETURN out;
END $f$;

-- Origem "legada provada" FICTÍCIA para o leitor de crédito de PRODUÇÃO (b2b_legacy_money_row): termos, cronograma, snapshot
-- econômico selado e auditoria INSERT das parcelas, todos marcados QA-FIN e manifestados. Exercita leitura/fórmula/isolamento;
-- NÃO prova a proveniência do writer canônico (é réplica sintética do que ele gravaria). Sem NF, sem cobrança.
CREATE OR REPLACE FUNCTION qa_b2bfin.seed_legacy_origin(p_order uuid, p_rec uuid, p_partner uuid, p_org uuid, p_label text) RETURNS void
LANGUAGE plpgsql SET search_path TO '' AS $f$
DECLARE t uuid := gen_random_uuid(); n int; tot numeric; sched jsonb;
BEGIN
 SELECT count(*), sum(original_amount) INTO n, tot FROM public.accounts_receivable_installments WHERE receivable_id = p_rec;
 IF n = 0 THEN RAISE EXCEPTION 'QA_SEED_INCOMPLETE: título % sem parcelas', p_label; END IF;
 INSERT INTO qa_b2bfin.manifest VALUES ('terms', p_label, 'public.partner_order_payment_terms', t);
 INSERT INTO public.partner_order_payment_terms (id, partner_order_id, plan_name_snapshot, plan_code_snapshot, discount_percent_snapshot,
   monthly_interest_percent_snapshot, months_count_snapshot, installment_count, first_due_date, table_amount, discount_amount,
   net_amount_after_discount, financial_interest_amount, final_amount, approval_status)
  SELECT t, p_order, 'QA-FIN fixture', 'QA-FIN', 0, 0, n, n, min(due_date), tot, 0, tot, 0, tot, 'not_required'
  FROM public.accounts_receivable_installments WHERE receivable_id = p_rec;
 INSERT INTO public.partner_order_payment_schedule (partner_order_id, payment_terms_id, installment_number, due_date, amount, principal_amount, interest_amount, status, receivable_installment_id)
  SELECT p_order, t, i.installment_number, i.due_date, i.original_amount, i.original_amount, 0, 'planned', i.id
  FROM public.accounts_receivable_installments i WHERE i.receivable_id = p_rec;
 INSERT INTO qa_b2bfin.manifest SELECT 'schedule', p_label, 'public.partner_order_payment_schedule', id FROM public.partner_order_payment_schedule WHERE payment_terms_id = t;
 SELECT jsonb_agg(to_jsonb(s) - ARRAY['created_at','status','receivable_installment_id'] ORDER BY s.installment_number) INTO sched
  FROM public.partner_order_payment_schedule s WHERE s.payment_terms_id = t;
 UPDATE public.partner_orders SET payment_terms_id = t, internal_economic_snapshot = jsonb_build_object('schema_version', '1',
   'sealed_by', 'QA-FIN-20261117 fixture sintética', 'qa_fixture', true,
   'origin', jsonb_build_object('organization_id', p_org, 'partner_id', p_partner),
   'terms', jsonb_build_object('id', t, 'partner_order_id', p_order, 'installment_count', n, 'final_amount', tot), 'schedule', sched)
  WHERE id = p_order;
 INSERT INTO public.financial_audit_log (entity_type, entity_id, action, new_data)
  SELECT 'accounts_receivable_installments', i.id, 'INSERT', jsonb_build_object('receivable_id', i.receivable_id, 'organization_id', i.organization_id,
    'original_amount', i.original_amount, 'interest_amount', 0, 'qa_fixture', 'QA-FIN-20261117 fixture sintética')
  FROM public.accounts_receivable_installments i WHERE i.receivable_id = p_rec
   AND NOT EXISTS (SELECT 1 FROM public.financial_audit_log f WHERE f.entity_type = 'accounts_receivable_installments' AND f.entity_id = i.id AND f.action = 'INSERT');
END $f$;

INSERT INTO qa_b2bfin.ticket VALUES (txid_current(), 'seed');
-- Exceções (somente linhas manifestadas desta txid; demais linhas/sessões seguem o corpo original):
--  bloqueio homolog de títulos; guarda de origem interna (auth_required/emitente validado — não se inventa ator nem atestado
--  fiscal: o pedido fica com internal_origin_snapshot NULL, marcado QA-FIN); exigência de itens na aprovação (pedido fictício
--  sem itens/produto); cerca C2P1 de configurações financeiras (limite fictício sem ticket de writer).
SELECT qa_b2bfin.relax('platform_private.homolog_validation_block_receivable_insert()'::regprocedure);
SELECT qa_b2bfin.relax('platform_private.b2b_internal_order_snapshot_guard()'::regprocedure);
SELECT qa_b2bfin.relax('public.tg_partner_orders_require_items()'::regprocedure);
SELECT qa_b2bfin.relax('platform_private.c2p1_settings_fence()'::regprocedure);
DO $$
DECLARE pmap jsonb := '{"A":["cdb78993-89e4-48db-956e-f40b014a8146","525fea87-e27e-43f7-af7b-a30064188332"],"B":["9d53f280-f828-4af8-a08c-3574263dc466","525fea87-e27e-43f7-af7b-a30064188332"],"C":["6100c3ac-ff5b-4596-a0e3-92665a5dcaab","85ba8b71-8514-4ec9-90d3-bfc7ab3ed214"]}'; k text; pid uuid; org uuid; cli uuid; cat uuid; oid_ uuid; rid uuid; sid uuid; n int; orgs uuid[] := '{525fea87-e27e-43f7-af7b-a30064188332,85ba8b71-8514-4ec9-90d3-bfc7ab3ed214}';
BEGIN
 SELECT id INTO cat FROM public.financial_categories WHERE active AND upper(type) = 'RECEITA' ORDER BY created_at, id LIMIT 1;
 IF cat IS NULL THEN RAISE EXCEPTION 'QA_SEED_BLOCKED: nenhuma categoria RECEITA ativa (não criada pelo seed)'; END IF;
 FOR k IN SELECT unnest('{A,B,C}'::text[]) LOOP
  SELECT id, commercial_owner_organization_id, client_id INTO STRICT pid, org, cli FROM public.partner_accounts WHERE id = (pmap->k->>0)::uuid AND deleted_at IS NULL;
  IF org IS DISTINCT FROM (pmap->k->>1)::uuid THEN RAISE EXCEPTION 'QA_SEED_REFUSED: parceiro % fora do tenant QA esperado', k; END IF;
  INSERT INTO qa_b2bfin.manifest VALUES ('partner', k, 'public.partner_accounts', pid);
  INSERT INTO qa_b2bfin.manifest SELECT 'partner_user', k, 'public.partner_users', id FROM public.partner_users WHERE partner_id = pid;
  IF EXISTS (SELECT 1 FROM public.accounts_receivable WHERE partner_id = pid) OR EXISTS (SELECT 1 FROM public.partner_orders WHERE partner_id = pid) THEN RAISE EXCEPTION 'QA_SEED_REFUSED: parceiro % já tem pedidos/títulos', k; END IF;
  oid_ := gen_random_uuid(); rid := gen_random_uuid();
  INSERT INTO qa_b2bfin.manifest VALUES ('order', k, 'public.partner_orders', oid_), ('receivable', k, 'public.accounts_receivable', rid);
  -- Status aprovado já na criação (vínculo financeiro exige pedido aprovado); sem itens, sem produção, sem NF.
  INSERT INTO public.partner_orders (id, numero, partner_id, cliente_id, status, subtotal, desconto_total, total, ready_for_production, observacoes)
   VALUES (oid_, 'QA-FIN-' || k || '-001', pid, cli, 'aprovado', 1000.00, 0, 1000.00, false, 'QA-FIN fixture sintética');
  IF (SELECT status::text FROM public.partner_orders WHERE id = oid_) <> 'aprovado' THEN RAISE EXCEPTION 'QA_SEED_INCOMPLETE: pedido % não ficou aprovado (guarda de crédito real)', k; END IF;
  INSERT INTO public.accounts_receivable (id, origin_type, origin_id, description, category_id, total_amount, issue_date, first_due_date, installment_count, partner_id, organization_id, notes, fiscal_invoice_required)
   VALUES (rid, 'B2B_ORDER', oid_, 'QA-FIN-' || k || ' título sentinela', cat, 1000.00, current_date, current_date + 30, 2, pid, org, 'QA-FIN fixture sintética sem NF/cobrança', false);
  SELECT count(*) INTO n FROM public.accounts_receivable_installments WHERE receivable_id = rid;
  IF n = 0 THEN
   INSERT INTO public.accounts_receivable_installments (receivable_id, installment_number, due_date, original_amount, received_amount, discount_amount, interest_amount, penalty_amount, net_amount, organization_id)
    VALUES (rid, 1, current_date + 30, 500.00, 0, 0, 0, 0, 500.00, org), (rid, 2, current_date + 60, 500.00, 0, 0, 0, 0, 500.00, org);
  END IF;
  INSERT INTO qa_b2bfin.manifest SELECT 'installment', k, 'public.accounts_receivable_installments', id FROM public.accounts_receivable_installments WHERE receivable_id = rid;
  INSERT INTO public.partner_order_financial_links (partner_order_id, partner_id, receivable_id) VALUES (oid_, pid, rid);
  PERFORM qa_b2bfin.seed_legacy_origin(oid_, rid, pid, org, k);
  INSERT INTO qa_b2bfin.manifest SELECT 'link', k, 'public.partner_order_financial_links', id FROM public.partner_order_financial_links WHERE receivable_id = rid;
  IF NOT EXISTS (SELECT 1 FROM public.partner_financial_settings WHERE partner_id = pid) THEN
   sid := gen_random_uuid(); INSERT INTO qa_b2bfin.manifest VALUES ('credit_settings', k, 'public.partner_financial_settings', sid);
   INSERT INTO public.partner_financial_settings (id, partner_id, credit_limit) VALUES (sid, pid, CASE k WHEN 'A' THEN 5000 WHEN 'B' THEN 7000 ELSE 9000 END);
  END IF;
  INSERT INTO qa_b2bfin.manifest SELECT 'credit_settings', k, 'public.partner_financial_settings', id FROM public.partner_financial_settings WHERE partner_id = pid ON CONFLICT DO NOTHING;
 END LOOP;
END $$;
DO $$ BEGIN IF (SELECT count(*) FROM qa_b2bfin.manifest WHERE kind='receivable') <> 3 OR (SELECT count(*) FROM qa_b2bfin.manifest WHERE kind='installment') < 3 THEN RAISE EXCEPTION 'QA_SEED_INCOMPLETE'; END IF; END $$;
DO $$ DECLARE r jsonb := qa_b2bfin.restore_all(); BEGIN IF jsonb_array_length(r) <> 4 THEN RAISE EXCEPTION 'QA_RESTORE_COUNT %', r; END IF; END $$;
DO $$ DECLARE pins jsonb := '{"platform_private.b2b_internal_child_snapshot_guard()": "8b1e5f5c4daff773d9e381b935ad4850", "platform_private.b2b_internal_order_snapshot_guard()": "2f4e05cde1b715e627f75564b9852105", "platform_private.c2_accounting_pending_guard()": "236da166229dcab49a90a0cc41365814", "platform_private.c2_external_final_state_guard()": "c8acf08966b02dbb3bad0e64e9892bc2", "platform_private.c2p1_settings_fence()": "20f57a91f488e32a5b5aca0b6bc6a926", "platform_private.delivery_no_downstream_20261030()": "933f56e984a48d345bfbb6744527bb53", "platform_private.delivery_order_transition_guard_20261030()": "937ebddc16dc20f5d437ded927fba842", "platform_private.homolog_validation_block_receivable_insert()": "4b82354e6727da801a348607c8a5c5c4", "public._saas_trg_require_feature()": "acf6aa9d659f17a1082fb1147f9e8bdf", "public.audit_partner_order_payment_terms()": "ddd4e5725b6d069a357a7a3412dfac26", "public.d51_5_validate_financial_tenant_links()": "b161d97a97a94cdfe3d93df4689eb5b9", "public.fn_b2b_guard_credit_approval_fields()": "fd1ebc409ea4f31e3c3660c1abad5740", "public.fn_financial_audit()": "8ed2aa015bfdc43f32cb4009d9f7b9ad", "public.fn_generate_receivable_installments()": "aeb38c876ac3e1e5a7564844cecaca66", "public.fn_h6_guard_title_snapshot()": "bc877eab69e8a13c2147f6091134b54e", "public.fn_h6c_set_canonical_payment_terms()": "95daffec6d0f951cf92b3ffb9d0eccc2", "public.fn_h6d_block_hard_delete()": "353aa9a344ca7a4499514b02f6accbbc", "public.guard_tenant_organization_id()": "8f52469b9ba3ea8de23e57cbb46234fc", "public.partner_orders_audit_trigger()": "a40da5e75a575e558dbb638f75c37114", "public.tg_audit_partner_order_commercial()": "f9c5329c0b55c62a80d2a05c4457f100", "public.tg_auto_b2b_receivable()": "f9103f25e71af6d01fcdcd863069e2d5", "public.tg_b2b_block_receivable_before_approval()": "fbb80bceaa6c5bb3ffcc307188ec226a", "public.tg_b2b_enforce_plan_selectable()": "1f501989555b7c4803dd8a51a310a91d", "public.tg_block_partner_order_delete()": "adea2d875f45313127a8823ea11232a6", "public.tg_block_partner_order_edit_after_op()": "7f857f54a9cfcf39c5c9bb26a4ad9d0f", "public.tg_block_pofl_delete()": "2868ad7deee40259eb448a7b40f874ba", "public.tg_governance_audit()": "0eed19be81a10a21adc22258c8daef8e", "public.tg_notify_payment_terms_pending()": "9f7b6a5375680f2f27c3863cd1d6438e", "public.tg_partner_orders_credit_guard()": "8839601441fba1f1be9a24f8e1c90fc0", "public.tg_partner_orders_require_items()": "7a4125d9a007dfcfb02e801783dc5124", "public.tg_pfs_updated_at()": "e3addd320004eb7a8494e7a0c2614c97", "public.tg_pofl_updated_at()": "e3addd320004eb7a8494e7a0c2614c97", "public.tg_recalc_risk_on_ar_change()": "92ee484ac4c401d615ade529a65fecf3", "public.tg_refresh_engagement()": "e70bcec2bc81d38468d68dd70b941f8b", "public.tg_sync_b2b_financial_status()": "a7b7a13d9fd1082a8cff91c6dd5ae6fa", "public.trg_partner_order_timeline()": "aefd3dbbdc0d7081cce4c50cfa494bad", "public.trg_partner_order_to_planning_fn()": "21ed58dacbe9ab84c77a90956ca97c39", "public.update_updated_at_column()": "a27bb088c067b7b77a9f0707b0048e40"}'; k text; BEGIN FOR k IN SELECT jsonb_object_keys(pins) LOOP
 IF (SELECT md5(prosrc) FROM pg_proc WHERE oid = to_regprocedure(k)) IS DISTINCT FROM pins->>k THEN RAISE EXCEPTION 'QA_RESTORE_DRIFT %', k; END IF; END LOOP; END $$;
SELECT 'QA_SEED_RESTORED' k, 'C11 md5 conferidos' v;
DROP FUNCTION qa_b2bfin.seed_legacy_origin(uuid,uuid,uuid,uuid,text);
SELECT 'QA_TITLES_JSON' k, jsonb_object_agg(label, t) v FROM (
 SELECT m.label, jsonb_agg(jsonb_build_object('id', m.id, 'total', (SELECT total_amount FROM public.accounts_receivable WHERE id = m.id), 'order_id', (SELECT id FROM qa_b2bfin.manifest o WHERE o.kind='order' AND o.label=m.label),
   'installments', (SELECT jsonb_agg(i.id ORDER BY i.id) FROM qa_b2bfin.manifest i WHERE i.kind='installment' AND i.label=m.label))) t
 FROM qa_b2bfin.manifest m WHERE m.kind = 'receivable' GROUP BY m.label) x;
COMMIT;
