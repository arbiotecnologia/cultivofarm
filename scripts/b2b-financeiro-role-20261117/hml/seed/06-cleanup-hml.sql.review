-- GERADO por build_seed.py; não editar.
-- LIMPEZA QA (HML vrlcdwmlytukrjezrrnf, postgres, transação única). Exige o DIGEST aprovado no dry-run:
--   SET app.qa_cleanup_digest = '<digest do 06a>';  (na mesma sessão, antes deste script)
-- Escopo: só linhas ligadas por coluna uuid aos 5 usuários, 3 parceiros, 2 assinaturas, 4 overrides e manifesto. Qualquer recusa
-- (tabela protegida, outro tenant, ator QA em linha de negócio, fixture proibida, referência só textual, volume) aborta.
-- Planos/versões/catálogo/tenants nunca entram. Relaxa SÓ gatilhos de DELETE das tabelas atingidas para os hashes exatos e
-- restaura def/md5 antes do COMMIT. auth.* intocado (contas saem pelo painel Auth depois).
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $$ BEGIN IF session_user <> 'postgres' OR to_regprocedure('platform_private.homolog_validation_block_receivable_insert()') IS NULL
  OR to_regprocedure('platform_private.b2b_credit_balances(uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'QA_CLEAN_REFUSED: alvo/sessão'; END IF;
 IF to_regnamespace('qa_b2bfin') IS NULL THEN CREATE SCHEMA qa_b2bfin; REVOKE ALL ON SCHEMA qa_b2bfin FROM PUBLIC;
  CREATE TABLE qa_b2bfin.manifest(kind text NOT NULL, label text, tbl regclass NOT NULL, id uuid NOT NULL, PRIMARY KEY (tbl, id)); END IF;
END $$;
-- Biblioteca transacional QA (criada e destruída na MESMA transação de 05/06). Somente session_user=postgres.
CREATE TABLE IF NOT EXISTS qa_b2bfin.ticket(txid bigint PRIMARY KEY, op text NOT NULL);
CREATE TABLE IF NOT EXISTS qa_b2bfin.saved_fn(fn regprocedure PRIMARY KEY, def text NOT NULL, src_md5 text NOT NULL);
CREATE TABLE IF NOT EXISTS qa_b2bfin.rowmark(rowhash text PRIMARY KEY, tbl regclass NOT NULL);
REVOKE ALL ON ALL TABLES IN SCHEMA qa_b2bfin FROM PUBLIC;
-- Exceção estrita: postgres + ticket desta transação + linha manifestada (id pré-registrado ou hash de linha derivada).
CREATE OR REPLACE FUNCTION qa_b2bfin.allowed(j jsonb) RETURNS boolean LANGUAGE sql STABLE SET search_path TO '' AS $f$
 SELECT session_user = 'postgres' AND j IS NOT NULL
  AND EXISTS (SELECT 1 FROM qa_b2bfin.ticket t WHERE t.txid = txid_current())
  AND (EXISTS (SELECT 1 FROM qa_b2bfin.manifest m WHERE m.id::text = j->>'id' AND (m.kind <> 'receivable' OR j->>'description' LIKE 'QA-FIN-%'))
       OR EXISTS (SELECT 1 FROM qa_b2bfin.rowmark r WHERE r.rowhash = md5(j::text)))
$f$;
CREATE OR REPLACE FUNCTION qa_b2bfin.relax(f regprocedure) RETURNS void LANGUAGE plpgsql SET search_path TO '' AS $f$
DECLARE p pg_proc%ROWTYPE; d text; src text; pos int; inner_ text; pre text;
BEGIN
 SELECT * INTO p FROM pg_proc WHERE oid = f;
 IF (SELECT lanname FROM pg_language WHERE oid = p.prolang) <> 'plpgsql' OR p.prorettype <> 'trigger'::regtype THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: % não é trigger plpgsql', f; END IF;
 IF EXISTS (SELECT 1 FROM qa_b2bfin.saved_fn s WHERE s.fn = f) THEN RETURN; END IF;
 src := p.prosrc; IF src ~ '^\s*#' THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: diretiva em %', f; END IF;
 d := pg_get_functiondef(f); pos := position(src IN d); IF pos = 0 THEN RAISE EXCEPTION 'QA_RELAX_REFUSED: corpo não localizado %', f; END IF;
 INSERT INTO qa_b2bfin.saved_fn VALUES (f, d, md5(src));
 inner_ := rtrim(src, E' \n\t\r'); IF right(inner_, 1) <> ';' THEN inner_ := inner_ || ';'; END IF;
 pre := E'\nBEGIN\n IF TG_LEVEL = ''ROW'' THEN\n  IF TG_OP = ''DELETE'' THEN IF qa_b2bfin.allowed(to_jsonb(OLD)) THEN RETURN OLD; END IF;\n'
     || E'  ELSIF qa_b2bfin.allowed(to_jsonb(NEW)) THEN RETURN NEW; END IF;\n END IF;\n';
 EXECUTE left(d, pos - 1) || pre || inner_ || E'\nEND;\n' || substr(d, pos + length(src));
END $f$;
CREATE OR REPLACE FUNCTION qa_b2bfin.restore_all() RETURNS jsonb LANGUAGE plpgsql SET search_path TO '' AS $f$
DECLARE s record; out jsonb := '[]';
BEGIN
 FOR s IN SELECT * FROM qa_b2bfin.saved_fn LOOP
  EXECUTE s.def;
  IF (SELECT md5(prosrc) FROM pg_proc WHERE oid = s.fn) <> s.src_md5 OR pg_get_functiondef(s.fn) <> s.def THEN RAISE EXCEPTION 'QA_RESTORE_DRIFT %', s.fn; END IF;
  out := out || jsonb_build_object('fn', s.fn::text, 'md5', s.src_md5);
 END LOOP;
 DELETE FROM qa_b2bfin.saved_fn; DELETE FROM qa_b2bfin.ticket;
 RETURN out;
END $f$;

-- ===== Descoberta (idêntica no dry-run e na execução). Só colunas uuid/uuid[]; texto/jsonb apenas RELATADOS e recusados.
CREATE TEMP TABLE qa_seed(id uuid PRIMARY KEY, kind text NOT NULL) ON COMMIT DROP;
CREATE TEMP TABLE qa_hit(tbl regclass, rowhash text, id uuid, col text, seed_kind text, lvl int, j jsonb, PRIMARY KEY (tbl, rowhash, col, seed_kind)) ON COMMIT DROP;
CREATE TEMP TABLE qa_text(tbl regclass, col text, rowhash text) ON COMMIT DROP;
CREATE TEMP TABLE qa_refuse(reason text, tbl regclass, rowhash text, id uuid) ON COMMIT DROP;
DO $$ BEGIN IF to_regclass('qa_b2bfin.manifest') IS NOT NULL THEN
  EXECUTE 'INSERT INTO qa_seed SELECT id, kind FROM qa_b2bfin.manifest WHERE kind NOT IN (''partner'',''partner_user'') ON CONFLICT DO NOTHING'; END IF; END $$;
INSERT INTO qa_seed VALUES ('cdb78993-89e4-48db-956e-f40b014a8146','partner'),('9d53f280-f828-4af8-a08c-3574263dc466','partner'),('6100c3ac-ff5b-4596-a0e3-92665a5dcaab','partner'),('7d15eddb-38b6-43dd-bbf5-43936155321d','user'),('5db79a8e-82af-419d-ae66-87a98c02fbec','user'),('c3ed723f-1017-478e-99b2-25b48b3ab77e','user'),('1d0ea582-1d46-4152-8fbe-f425c74942c1','user'),('51652ab6-da23-4a3d-8f29-417af15cc761','user'),('019fe16e-4a05-4ca1-8480-c2727b92dfa2','override'),('d69bf60a-faa2-4cc0-80df-fd8dc913e9e9','override'),('1aca4276-7043-4616-8dd5-839d2e4e86de','override'),('1eac8c31-6b09-43fd-bbec-e523a812e6ba','override'),('fcb4c72d-2040-4bbc-98fd-145f1463ec04','subscription'),('2624ff4a-c4dd-4885-af23-beb8463d2209','subscription') ON CONFLICT DO NOTHING;
DO $$
DECLARE c record; lvl int;
BEGIN
 FOR lvl IN 1..3 LOOP
  FOR c IN SELECT a.attrelid::regclass t, a.attname col, format_type(a.atttypid, NULL) ty
     FROM pg_attribute a JOIN pg_class r ON r.oid = a.attrelid JOIN pg_namespace s ON s.oid = r.relnamespace
     WHERE r.relkind IN ('r','p') AND a.attnum > 0 AND NOT a.attisdropped AND s.nspname IN ('public','platform_private')
       AND format_type(a.atttypid, NULL) IN ('uuid','uuid[]') LOOP
   EXECUTE format('INSERT INTO qa_hit SELECT %L::regclass, md5(to_jsonb(x)::text), CASE WHEN (to_jsonb(x)->>''id'') ~ ''^[0-9a-f-]{36}$'' THEN (to_jsonb(x)->>''id'')::uuid END, %L, s.kind, %s, to_jsonb(x) FROM %s x JOIN qa_seed s ON %s ON CONFLICT DO NOTHING',
     c.t, c.col, lvl, c.t, CASE c.ty WHEN 'uuid' THEN format('x.%I = s.id', c.col) ELSE format('s.id = ANY (x.%I)', c.col) END
       || CASE WHEN c.col = 'id' THEN ' AND s.kind NOT LIKE ''derived:%''' ELSE '' END);  -- id próprio nunca autojustifica
  END LOOP;
  INSERT INTO qa_seed SELECT DISTINCT id, 'derived:' || tbl::text FROM qa_hit WHERE id IS NOT NULL ON CONFLICT DO NOTHING;
 END LOOP;
 FOR c IN SELECT a.attrelid::regclass t, a.attname col FROM pg_attribute a JOIN pg_class r ON r.oid = a.attrelid JOIN pg_namespace s ON s.oid = r.relnamespace
     WHERE r.relkind IN ('r','p') AND a.attnum > 0 AND NOT a.attisdropped AND s.nspname IN ('public','platform_private')
       AND format_type(a.atttypid, NULL) IN ('text','jsonb','json') LOOP
  EXECUTE format('INSERT INTO qa_text SELECT %L::regclass, %L, md5(to_jsonb(x)::text) FROM %s x WHERE x.%I::text ~ (SELECT string_agg(id::text, ''|'') FROM qa_seed) AND md5(to_jsonb(x)::text) NOT IN (SELECT rowhash FROM qa_hit WHERE tbl = %L::regclass)', c.t, c.col, c.t, c.col, c.t);
 END LOOP;
 -- Recusas (nenhuma é contornável):
 INSERT INTO qa_refuse SELECT DISTINCT 'tabela_protegida', tbl, rowhash, id FROM qa_hit h JOIN pg_class r ON r.oid = h.tbl
  WHERE (r.relname ~ '^(saas_|catalog|catalogo|commercial_|fiscal_|organization(s|_profile|_status))' AND r.relname <> 'commercial_audit_log') OR r.relname IN ('financial_categories','payment_methods','configuracoes_sistema','bank_accounts','etiqueta_templates');
 INSERT INTO qa_refuse SELECT DISTINCT 'outro_tenant', tbl, rowhash, id FROM qa_hit
  WHERE coalesce(j->>'organization_id', j->>'tenant_id') IS NOT NULL AND coalesce(j->>'organization_id', j->>'tenant_id') NOT IN ('525fea87-e27e-43f7-af7b-a30064188332','85ba8b71-8514-4ec9-90d3-bfc7ab3ed214');
 INSERT INTO qa_refuse SELECT 'ator_qa_em_linha_de_negocio', h.tbl, h.rowhash, min(h.id::text)::uuid FROM qa_hit h JOIN pg_class r ON r.oid = h.tbl
  WHERE r.relname !~ '(audit|_log|logs|history|events|receipts|epoch|sessions|preferences)'
  GROUP BY h.tbl, h.rowhash HAVING bool_and(h.seed_kind = 'user' AND h.col NOT IN ('user_id','id'));
 INSERT INTO qa_refuse SELECT DISTINCT 'fixture_proibida', tbl, rowhash, id FROM qa_hit WHERE j::text ~ 'd7edc250-25a4-4ee2-8b62-27c1645cdfc0|5fa6d35b|c909c862';
 INSERT INTO qa_refuse SELECT DISTINCT 'referencia_so_textual', tbl, rowhash, NULL::uuid FROM qa_text;
 IF (SELECT count(DISTINCT (tbl, rowhash)) FROM qa_hit) > 2000 THEN INSERT INTO qa_refuse VALUES ('volume_implausivel', NULL, NULL, NULL); END IF;
END $$;
SELECT 'QA_CLEAN_PLAN' k, h.tbl::text tabela, h.id, h.rowhash, string_agg(DISTINCT h.col || '<-' || h.seed_kind, ',') vinculos, min(h.lvl) nivel FROM qa_hit h GROUP BY 2, 3, 4 ORDER BY 2, 3;
SELECT 'QA_CLEAN_REFUSALS' k, reason, tbl::text, id, rowhash FROM qa_refuse ORDER BY 2, 3;
SELECT 'QA_CLEAN_DIGEST' k, md5(coalesce(string_agg(x, ',' ORDER BY x), '')) digest, count(*) linhas FROM (SELECT DISTINCT tbl::text || ':' || rowhash x FROM qa_hit) d;

DO $$ DECLARE d text; BEGIN
 IF EXISTS (SELECT 1 FROM qa_refuse) THEN RAISE EXCEPTION 'QA_CLEAN_REFUSED: % recusa(s) — ver 06a', (SELECT count(*) FROM qa_refuse); END IF;
 SELECT md5(coalesce(string_agg(x, ',' ORDER BY x), '')) INTO d FROM (SELECT DISTINCT tbl::text || ':' || rowhash x FROM qa_hit) q;
 IF d IS DISTINCT FROM current_setting('app.qa_cleanup_digest', true) THEN RAISE EXCEPTION 'QA_CLEAN_REFUSED: digest % difere do aprovado no dry-run', d; END IF;
END $$;
INSERT INTO qa_b2bfin.ticket VALUES (txid_current(), 'cleanup');
INSERT INTO qa_b2bfin.rowmark SELECT rowhash, tbl FROM qa_hit ON CONFLICT DO NOTHING;
DO $$ DECLARE c record; BEGIN
 FOR c IN SELECT DISTINCT t.tgfoid::regprocedure f FROM pg_trigger t WHERE NOT t.tgisinternal AND t.tgrelid IN (SELECT tbl FROM qa_hit) AND (t.tgtype & 8) <> 0 AND (t.tgtype & 1) <> 0 LOOP
  PERFORM qa_b2bfin.relax(c.f); END LOOP; END $$;
DO $$ DECLARE pass int; t regclass; n bigint; c record; BEGIN
 FOR pass IN 1..12 LOOP
  FOR t IN SELECT DISTINCT tbl FROM qa_hit LOOP
   BEGIN EXECUTE format('DELETE FROM %s x WHERE md5(to_jsonb(x)::text) IN (SELECT rowhash FROM qa_hit WHERE tbl = %L::regclass)', t, t);
   EXCEPTION WHEN foreign_key_violation THEN NULL; END;
  END LOOP;
 END LOOP;
 FOR c IN SELECT a.attrelid::regclass t, a.attname col, format_type(a.atttypid, NULL) ty FROM pg_attribute a JOIN pg_class r ON r.oid = a.attrelid JOIN pg_namespace s ON s.oid = r.relnamespace
   WHERE r.relkind IN ('r','p') AND a.attnum > 0 AND NOT a.attisdropped AND s.nspname IN ('public','platform_private') AND format_type(a.atttypid, NULL) IN ('uuid','uuid[]') LOOP
  EXECUTE format('SELECT count(*) FROM %s x JOIN qa_seed s ON %s', c.t, CASE c.ty WHEN 'uuid' THEN format('x.%I = s.id', c.col) ELSE format('s.id = ANY (x.%I)', c.col) END) INTO n;
  IF n <> 0 THEN RAISE EXCEPTION 'QA_CLEAN_INCOMPLETE: % linhas ainda referenciam a semente em %.% (rollback integral)', n, c.t, c.col; END IF;
 END LOOP;
END $$;
SELECT 'QA_CLEAN_DELETED' k, jsonb_object_agg(tbl::text, n) v FROM (SELECT tbl, count(DISTINCT rowhash) n FROM qa_hit GROUP BY tbl) x;
SELECT 'QA_CLEAN_RESTORED' k, qa_b2bfin.restore_all() v;
DROP SCHEMA qa_b2bfin CASCADE;
SELECT 'QA_CLEAN_PASS' k, (SELECT count(*) FROM auth.users WHERE id IN ('7d15eddb-38b6-43dd-bbf5-43936155321d','5db79a8e-82af-419d-ae66-87a98c02fbec','c3ed723f-1017-478e-99b2-25b48b3ab77e','1d0ea582-1d46-4152-8fbe-f425c74942c1','51652ab6-da23-4a3d-8f29-417af15cc761')) contas_auth_a_remover_no_painel;
COMMIT;
