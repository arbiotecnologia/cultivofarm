-- HML somente leitura: confirma que não restou fixture QA-FIN e que o bloqueio homolog está com o corpo original.
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;
SELECT 'QA_VERIFY' k,
 to_regnamespace('qa_b2bfin') IS NULL schema_removido,
 (SELECT count(*) FROM public.partner_accounts WHERE id IN ('cdb78993-89e4-48db-956e-f40b014a8146','9d53f280-f828-4af8-a08c-3574263dc466','6100c3ac-ff5b-4596-a0e3-92665a5dcaab')) parceiros_qa,
 (SELECT count(*) FROM public.organization_subscriptions WHERE id IN ('fcb4c72d-2040-4bbc-98fd-145f1463ec04','2624ff4a-c4dd-4885-af23-beb8463d2209')) + (SELECT count(*) FROM public.organization_feature_overrides WHERE id IN ('019fe16e-4a05-4ca1-8480-c2727b92dfa2','d69bf60a-faa2-4cc0-80df-fd8dc913e9e9','1aca4276-7043-4616-8dd5-839d2e4e86de','1eac8c31-6b09-43fd-bbec-e523a812e6ba')) saas_qa,
 (SELECT count(*) FROM public.profiles WHERE user_id IN ('7d15eddb-38b6-43dd-bbf5-43936155321d','5db79a8e-82af-419d-ae66-87a98c02fbec','c3ed723f-1017-478e-99b2-25b48b3ab77e','1d0ea582-1d46-4152-8fbe-f425c74942c1','51652ab6-da23-4a3d-8f29-417af15cc761')) perfis_qa,
 (SELECT count(*) FROM public.accounts_receivable WHERE description LIKE 'QA-FIN-%') titulos_qa,
 (SELECT count(*) FROM public.partner_orders WHERE numero LIKE 'QA-FIN-%') pedidos_qa,
 (SELECT count(*) FROM auth.users WHERE id IN ('7d15eddb-38b6-43dd-bbf5-43936155321d','5db79a8e-82af-419d-ae66-87a98c02fbec','c3ed723f-1017-478e-99b2-25b48b3ab77e','1d0ea582-1d46-4152-8fbe-f425c74942c1','51652ab6-da23-4a3d-8f29-417af15cc761')) auth_qa_remover_via_admin_api,
 (SELECT count(*) FROM public.organization_subscription_history WHERE reason LIKE 'QA-FIN-20261117%') historico_assinatura_qa,
 (SELECT md5(prosrc) FROM pg_proc WHERE oid = to_regprocedure('platform_private.homolog_validation_block_receivable_insert()')) homolog_block_md5_comparar_com_QA_SEED_RESTORED;
ROLLBACK;
