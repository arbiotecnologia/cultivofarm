-- CANDIDATA v2 — Correção de revogação nos 3 helpers B2B (revogação ignorada)
-- Substitui a candidata reprovada f02cbcd8. Escopo: SOMENTE os 3 helpers
-- abaixo. Sem funções paralelas, sem contratos novos, sem UI, sem mudança de
-- RLS, sem reabrir PUC/PTC, sem DDL hosted por este agente. Aplicação
-- exclusivamente pelo auditor via Supabase.
--
-- Regra comum (folha = public.is_valid_b2b_partner_user):
--   * Conta TODOS os vínculos não revogados do usuário ANTES da elegibilidade;
--     exige exatamente 1 (0 ou 2+ falham fechado).
--   * Vínculo elegível: não revogado, parceiro ativo, deleted_at NULL,
--     owner (commercial_owner_organization_id) NÃO nulo e pu.tenant_id = owner.
--   * Papel consistente com role B2B ÚNICA do usuário:
--       papel 'gestor'  <=> role parceiro_b2b (e NÃO parceiro_b2b_tecnico)
--       papel 'tecnico' <=> role parceiro_b2b_tecnico (e NÃO parceiro_b2b)
--   * get_b2b_user_role_for_partner REUTILIZA is_valid (sem ciclo: is_valid
--     não chama get_role) e não resolve vínculo arbitrário (sem LIMIT 1).
--   * b2b_actor_scope valida user_partner com a MESMA folha; partner_valid
--     (parceiro da ORGANIZAÇÃO do ator) mantém a semântica ANTIGA
--     (ativo + deleted_at IS NULL, SEM exigir owner) para não bloquear
--     interno/legacy sem vínculo externo.
--   * profile_ok, org_partner e has_catalog preservados; NENHUMA expansão.
--   * Sem recursão: b2b_commercial_context -> b2b_phase1_partner_visible ->
--     b2b_actor_scope; o scope NÃO chama o context de volta.
--
-- Hashes PRE fixos (pg_get_functiondef, live revisado):
--   public.get_b2b_user_role_for_partner(uuid,uuid)  b2596473d00151ef41b4b2ce82e044cb
--   public.is_valid_b2b_partner_user(uuid,uuid)      7b17274fb6dce728741a2a9c77710a76
--   platform_private.b2b_actor_scope(uuid)           c85cb35201682c3c86b9a327d24c8482
-- Hashes POST fixos (apurados em PostgreSQL local que reproduz os PRE acima):
--   public.get_b2b_user_role_for_partner(uuid,uuid)  27efcdaf40dc0e5287abd4cf418a6571
--   public.is_valid_b2b_partner_user(uuid,uuid)      01ca51531eea52aab65c9d8138dd88d3
--   platform_private.b2b_actor_scope(uuid)           09b184da91c59f8b1f9be72217f8c37e

BEGIN;

SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '60s';

-- Guarda PRÉ fail-closed: hash EXATO de pg_get_functiondef + ACL + owner +
-- search_path de cada função. Qualquer divergência aborta SEM escrever.
DO $$
DECLARE
  v_pre CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', 'b2596473d00151ef41b4b2ce82e044cb',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    '7b17274fb6dce728741a2a9c77710a76',
    'platform_private.b2b_actor_scope(uuid)',         'c85cb35201682c3c86b9a327d24c8482'
  );
  v_acl CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', 'authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    'authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres',
    'platform_private.b2b_actor_scope(uuid)',         'postgres=X/postgres,service_role=X/postgres'
  );
  v_cfg CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', 'search_path=public',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    'search_path=public',
    'platform_private.b2b_actor_scope(uuid)',         'search_path=public, pg_temp'
  );
  v_sig text;
  v_md5 text; v_acl_now text; v_cfg_now text; v_owner text;
BEGIN
  FOR v_sig IN SELECT jsonb_object_keys(v_pre) LOOP
    SELECT md5(pg_get_functiondef(p.oid)),
           (SELECT string_agg(a::text, ',' ORDER BY a::text) FROM unnest(p.proacl) a),
           (SELECT string_agg(c, ',' ORDER BY c) FROM unnest(p.proconfig) c),
           r.rolname
      INTO v_md5, v_acl_now, v_cfg_now, v_owner
      FROM pg_proc p
      JOIN pg_namespace n ON n.oid = p.pronamespace
      JOIN pg_roles r ON r.oid = p.proowner
     WHERE p.oid = to_regprocedure(v_sig);
    IF v_md5 IS DISTINCT FROM (v_pre ->> v_sig) THEN
      RAISE EXCEPTION 'PRE FALHOU: hash de % diverge (esperado %, atual %). Abortando sem escrever.',
        v_sig, v_pre ->> v_sig, COALESCE(v_md5, '<ausente>');
    END IF;
    IF v_acl_now IS DISTINCT FROM (v_acl ->> v_sig) THEN
      RAISE EXCEPTION 'PRE FALHOU: ACL de % diverge (% != %). Abortando.', v_sig, v_acl_now, v_acl ->> v_sig;
    END IF;
    IF v_cfg_now IS DISTINCT FROM (v_cfg ->> v_sig) THEN
      RAISE EXCEPTION 'PRE FALHOU: search_path de % diverge (% != %). Abortando.', v_sig, v_cfg_now, v_cfg ->> v_sig;
    END IF;
    IF v_owner IS DISTINCT FROM 'postgres' THEN
      RAISE EXCEPTION 'PRE FALHOU: owner de % diverge (%). Abortando.', v_sig, v_owner;
    END IF;
  END LOOP;
END $$;

-- 1) is_valid_b2b_partner_user — FOLHA COMUM: cardinalidade (exatamente 1
--    vínculo não revogado) + elegibilidade completa + papel/role consistentes.
CREATE OR REPLACE FUNCTION public.is_valid_b2b_partner_user(p_user_id uuid, p_partner_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM public.partner_users pu
    JOIN public.partner_accounts pa ON pa.id = pu.partner_id
    WHERE pu.user_id = p_user_id
      AND pu.partner_id = p_partner_id
      AND pu.revoked_at IS NULL
      AND (SELECT count(*)
             FROM public.partner_users pu2
            WHERE pu2.user_id = p_user_id
              AND pu2.revoked_at IS NULL) = 1
      AND pa.ativo = true
      AND pa.deleted_at IS NULL
      AND pa.commercial_owner_organization_id IS NOT NULL
      AND pu.tenant_id = pa.commercial_owner_organization_id
      AND (
        (pu.papel = 'gestor'
          AND public.has_role(p_user_id, 'parceiro_b2b'::app_role)
          AND NOT public.has_role(p_user_id, 'parceiro_b2b_tecnico'::app_role))
        OR
        (pu.papel = 'tecnico'
          AND public.has_role(p_user_id, 'parceiro_b2b_tecnico'::app_role)
          AND NOT public.has_role(p_user_id, 'parceiro_b2b'::app_role))
      )
  );
$function$;

-- 2) get_b2b_user_role_for_partner — REUTILIZA a folha is_valid (sem ciclo).
--    Sem LIMIT 1: a folha garante cardinalidade 1, então o subselect é
--    determinístico; papel inconsistente ou vínculo inelegível => NULL.
CREATE OR REPLACE FUNCTION public.get_b2b_user_role_for_partner(p_user_id uuid, p_partner_id uuid)
 RETURNS text
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT CASE
    WHEN public.is_valid_b2b_partner_user(p_user_id, p_partner_id) THEN
      (SELECT CASE pu.papel
                WHEN 'tecnico' THEN 'parceiro_b2b_tecnico'
                ELSE 'parceiro_b2b'
              END
         FROM public.partner_users pu
        WHERE pu.user_id = p_user_id
          AND pu.partner_id = p_partner_id
          AND pu.revoked_at IS NULL)
    ELSE NULL
  END;
$function$;

-- 3) platform_private.b2b_actor_scope — user_partner validado pela MESMA
--    folha is_valid sobre o vínculo único não revogado; user_partner_count
--    conta TODOS os não revogados. partner_valid (parceiro da ORGANIZAÇÃO)
--    mantém a semântica ANTIGA (ativo + deleted_at IS NULL, sem exigir
--    owner) — endurecimento restrito ao vínculo EXTERNO user_partner, sem
--    bloquear interno/legacy. profile_ok/org_partner/has_catalog preservados.
CREATE OR REPLACE FUNCTION platform_private.b2b_actor_scope(_uid uuid)
 RETURNS TABLE(profile_ok boolean, org_partner uuid, user_partner uuid, user_partner_count integer, partner_valid boolean, has_catalog boolean)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  WITH pr AS (
    SELECT o.partner_account_id
      FROM public.profiles p JOIN public.organizations o ON o.id = p.organization_id
     WHERE p.user_id = _uid AND p.ativo = true AND o.ativo = true AND o.status = 'ativa'
     LIMIT 1
  ), pu AS (
    SELECT count(*)::int c, min(partner_id::text)::uuid pid
      FROM public.partner_users
     WHERE user_id = _uid AND revoked_at IS NULL
  )
  SELECT EXISTS (SELECT 1 FROM pr),
         (SELECT partner_account_id FROM pr),
         CASE WHEN (SELECT c FROM pu) = 1
                   AND public.is_valid_b2b_partner_user(_uid, (SELECT pid FROM pu))
              THEN (SELECT pid FROM pu) ELSE NULL END,
         (SELECT c FROM pu),
         EXISTS (SELECT 1 FROM pr JOIN public.partner_accounts pa ON pa.id = pr.partner_account_id
                  WHERE pa.ativo = true AND pa.deleted_at IS NULL),
         EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'catalogo_precos');
$function$;

-- Verificação PÓS: hash EXATO POST de cada função + ACL/owner/search_path
-- idênticos ao pré. Qualquer divergência => exceção => transação aborta.
DO $$
DECLARE
  v_post CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', '27efcdaf40dc0e5287abd4cf418a6571',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    '01ca51531eea52aab65c9d8138dd88d3',
    'platform_private.b2b_actor_scope(uuid)',         '09b184da91c59f8b1f9be72217f8c37e'
  );
  v_acl CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', 'authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    'authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres',
    'platform_private.b2b_actor_scope(uuid)',         'postgres=X/postgres,service_role=X/postgres'
  );
  v_cfg CONSTANT jsonb := jsonb_build_object(
    'public.get_b2b_user_role_for_partner(uuid,uuid)', 'search_path=public',
    'public.is_valid_b2b_partner_user(uuid,uuid)',    'search_path=public',
    'platform_private.b2b_actor_scope(uuid)',         'search_path=public, pg_temp'
  );
  v_sig text;
  v_md5 text; v_acl_now text; v_cfg_now text; v_owner text;
BEGIN
  FOR v_sig IN SELECT jsonb_object_keys(v_post) LOOP
    SELECT md5(pg_get_functiondef(p.oid)),
           (SELECT string_agg(a::text, ',' ORDER BY a::text) FROM unnest(p.proacl) a),
           (SELECT string_agg(c, ',' ORDER BY c) FROM unnest(p.proconfig) c),
           r.rolname
      INTO v_md5, v_acl_now, v_cfg_now, v_owner
      FROM pg_proc p
      JOIN pg_namespace n ON n.oid = p.pronamespace
      JOIN pg_roles r ON r.oid = p.proowner
     WHERE p.oid = to_regprocedure(v_sig);
    IF v_md5 IS DISTINCT FROM (v_post ->> v_sig) THEN
      RAISE EXCEPTION 'PÓS FALHOU: hash de % diverge do POST esperado (esperado %, atual %).',
        v_sig, v_post ->> v_sig, COALESCE(v_md5, '<ausente>');
    END IF;
    IF v_acl_now IS DISTINCT FROM (v_acl ->> v_sig) THEN
      RAISE EXCEPTION 'PÓS FALHOU: ACL de % diverge (% != %).', v_sig, v_acl_now, v_acl ->> v_sig;
    END IF;
    IF v_cfg_now IS DISTINCT FROM (v_cfg ->> v_sig) THEN
      RAISE EXCEPTION 'PÓS FALHOU: search_path de % diverge (% != %).', v_sig, v_cfg_now, v_cfg ->> v_sig;
    END IF;
    IF v_owner IS DISTINCT FROM 'postgres' THEN
      RAISE EXCEPTION 'PÓS FALHOU: owner de % diverge (%).', v_sig, v_owner;
    END IF;
  END LOOP;
  RAISE NOTICE 'PÓS OK: 3 helpers nos hashes POST fixos, ACL/owner/search_path preservados';
END $$;

COMMIT;
