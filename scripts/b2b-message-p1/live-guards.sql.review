CREATE OR REPLACE FUNCTION public.get_user_partner_id()
 RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public' AS $function$
 SELECT CASE WHEN count(*)=1 THEN min(partner_id) ELSE NULL::uuid END
 FROM public.partner_users WHERE user_id=auth.uid() AND revoked_at IS NULL;
$function$;
CREATE OR REPLACE FUNCTION public.get_partner_papel()
 RETURNS text LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public' AS $function$
 SELECT CASE WHEN count(*)=1 THEN min(papel) ELSE NULL::text END
 FROM public.partner_users WHERE user_id=auth.uid() AND revoked_at IS NULL;
$function$;
CREATE OR REPLACE FUNCTION platform_private.h15_actor_organization()
 RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
 SELECT p.organization_id FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE WHERE p.user_id=auth.uid() AND p.ativo IS TRUE AND platform_private.platform_actor_access_ready(p.user_id);
$function$;
CREATE OR REPLACE FUNCTION public.h15_actor_organization()
 RETURNS uuid LANGUAGE sql STABLE SET search_path TO '' AS $function$ SELECT platform_private.h15_actor_organization(); $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_actor_scope(_uid uuid)
 RETURNS TABLE(profile_ok boolean,org_partner uuid,user_partner uuid,user_partner_count integer,partner_valid boolean,has_catalog boolean)
 LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO 'public','pg_temp' AS $function$
 WITH pr AS (
 SELECT o.partner_account_id FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id
 WHERE p.user_id=_uid AND p.ativo=true AND o.ativo=true AND o.status='ativa' LIMIT 1
 ), pu AS (SELECT count(*)::int c,min(partner_id::text)::uuid pid FROM public.partner_users WHERE user_id=_uid)
 SELECT EXISTS(SELECT 1 FROM pr),(SELECT partner_account_id FROM pr),(SELECT pid FROM pu),(SELECT c FROM pu),
 EXISTS(SELECT 1 FROM pr JOIN public.partner_accounts pa ON pa.id=pr.partner_account_id WHERE pa.ativo=true AND pa.deleted_at IS NULL),
 EXISTS(SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key='catalogo_precos');
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_partner_visible(p_partner uuid,p_technical boolean DEFAULT false)
 RETURNS boolean LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO 'public','pg_temp' AS $function$
DECLARE s record; u uuid:=auth.uid();
BEGIN
 IF u IS NULL OR p_partner IS NULL THEN RETURN false; END IF;
 IF public.is_platform_superadmin(u) THEN RETURN true; END IF;
 SELECT * INTO s FROM platform_private.b2b_actor_scope(u);
 IF NOT s.profile_ok OR NOT s.partner_valid OR s.org_partner IS DISTINCT FROM p_partner THEN RETURN false; END IF;
 IF public.has_role(u,'parceiro_b2b_tecnico') THEN RETURN p_technical AND s.user_partner_count=1 AND s.user_partner=p_partner; END IF;
 IF public.has_role(u,'parceiro_b2b') THEN RETURN s.user_partner_count=1 AND s.user_partner=p_partner; END IF;
 RETURN true;
END $function$;
CREATE OR REPLACE FUNCTION public.tg_commercial_audit()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $function$
DECLARE v_pid uuid;v_oid uuid;
BEGIN
 v_pid:=COALESCE((to_jsonb(NEW)->>'partner_id')::uuid,(to_jsonb(OLD)->>'partner_id')::uuid);
 v_oid:=COALESCE((to_jsonb(NEW)->>'order_id')::uuid,(to_jsonb(OLD)->>'order_id')::uuid);
 IF TG_TABLE_NAME='partner_orders' THEN v_oid:=COALESCE(NEW.id,OLD.id); END IF;
 INSERT INTO public.commercial_audit_log(usuario_id,partner_id,order_id,acao,dados_anteriores,dados_novos)
 VALUES(auth.uid(),v_pid,v_oid,TG_TABLE_NAME||'.'||lower(TG_OP),CASE WHEN TG_OP<>'INSERT' THEN to_jsonb(OLD) END,CASE WHEN TG_OP<>'DELETE' THEN to_jsonb(NEW) END);
 RETURN COALESCE(NEW,OLD);
END $function$;
