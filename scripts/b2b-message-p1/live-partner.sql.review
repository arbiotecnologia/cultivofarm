-- READ-ONLY captured bodies, whitespace normalized. No production execution.
CREATE OR REPLACE FUNCTION platform_private.b2b_commercial_context() RETURNS jsonb
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $function$
DECLARE u uuid:=auth.uid(); org uuid; role_name text; link record; owner uuid; legacy uuid; mode text;
BEGIN
 IF u IS NULL OR NOT platform_private.platform_actor_access_ready(u) THEN RETURN NULL; END IF;
 org:=public.h15_actor_organization();
 IF org IS NULL OR (SELECT count(*) FROM public.user_roles r WHERE r.user_id=u)<>1 THEN RETURN NULL; END IF;
 SELECT r.role::text INTO role_name FROM public.user_roles r WHERE r.user_id=u;
 IF role_name NOT IN ('parceiro_b2b','parceiro_b2b_tecnico') THEN RETURN NULL; END IF;
 IF (SELECT count(*) FROM public.partner_users pu WHERE pu.user_id=u)<>1 THEN RETURN NULL; END IF;
 SELECT pu.partner_id,pu.papel INTO link FROM public.partner_users pu WHERE pu.user_id=u;
 IF link.papel IS DISTINCT FROM (CASE WHEN role_name='parceiro_b2b_tecnico' THEN 'tecnico' ELSE 'gestor' END) THEN RETURN NULL; END IF;
 SELECT pa.commercial_owner_organization_id INTO owner FROM public.partner_accounts pa WHERE pa.id=link.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
 IF owner IS NULL THEN RETURN NULL; END IF;
 IF NOT EXISTS(SELECT 1 FROM platform_private.entitlements_for_user(u) e WHERE e.feature_key='catalogo_precos') THEN RETURN NULL; END IF;
 SELECT o.partner_account_id INTO legacy FROM public.organizations o WHERE o.id=org AND o.ativo IS TRUE AND o.status='ativa';
 IF NOT FOUND THEN RETURN NULL; END IF;
 IF owner=org THEN
  IF legacy IS NOT NULL AND legacy IS DISTINCT FROM link.partner_id THEN RETURN NULL; END IF;
  mode:='commercial_owner';
 ELSIF legacy=link.partner_id AND COALESCE(platform_private.b2b_phase1_partner_visible(link.partner_id,true),false) THEN mode:='legacy_partner_tenant';
 ELSE RETURN NULL; END IF;
 RETURN jsonb_build_object('partner_id',link.partner_id,'organization_id',org,'commercial_owner_organization_id',owner,'role',role_name,'papel',link.papel,'mode',mode);
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_direct_partner_row_allowed() RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $function$
 SELECT NOT EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id=auth.uid()
 AND (r.role='parceiro_b2b_tecnico'::public.app_role OR (r.role='parceiro_b2b'::public.app_role AND EXISTS (
 SELECT 1 FROM public.profiles p JOIN public.partner_users pu ON pu.user_id=p.user_id JOIN public.partner_accounts pa ON pa.id=pu.partner_id
 WHERE p.user_id=r.user_id AND p.organization_id=pa.commercial_owner_organization_id))));
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_coherent_self_partner(p_partner uuid) RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $function$
 SELECT COALESCE((platform_private.b2b_commercial_context()->>'partner_id')::uuid=p_partner,false);
$function$;
CREATE OR REPLACE FUNCTION platform_private.entitlements_for_user(_uid uuid)
RETURNS TABLE(module_key text,feature_key text,limit_value numeric,config jsonb)
LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $function$
 WITH actor AS (
 SELECT p.organization_id FROM public.profiles p JOIN public.organizations org ON org.id=p.organization_id AND org.ativo IS TRUE
 WHERE p.user_id=_uid AND p.ativo IS TRUE AND p.organization_id IS NOT NULL ORDER BY p.created_at,p.organization_id LIMIT 1
 ), current_subscription AS (
 SELECT s.organization_id,s.plan_version_id FROM public.organization_subscriptions s JOIN actor a ON a.organization_id=s.organization_id
 JOIN public.saas_plan_versions v ON v.id=s.plan_version_id AND v.status='PUBLISHED' AND v.effective_from<=now() AND (v.effective_to IS NULL OR v.effective_to>now())
 WHERE s.plan_version_id IS NOT NULL AND (s.status='ACTIVE' OR (s.status='TRIAL' AND s.trial_ends_at IS NOT NULL AND s.trial_ends_at>now()))
 AND (s.cancel_at IS NULL OR s.cancel_at>now()) ORDER BY s.started_at DESC,s.id DESC LIMIT 1
 ), candidates AS (
 SELECT f.id AS feature_id,f.module_id,f.key AS feature_key,vf.enabled AS base_enabled,vf.limit_value AS base_limit,vf.config AS base_config
 FROM current_subscription s JOIN public.saas_plan_version_features vf ON vf.plan_version_id=s.plan_version_id JOIN public.saas_features f ON f.id=vf.feature_id AND f.active IS TRUE
 UNION SELECT f.id,f.module_id,f.key,false,NULL::numeric,NULL::jsonb FROM current_subscription s
 JOIN public.organization_feature_overrides o ON o.organization_id=s.organization_id JOIN public.saas_features f ON f.id=o.feature_id AND f.active IS TRUE
 WHERE o.ended_at IS NULL AND o.starts_at<=now() AND (o.ends_at IS NULL OR o.ends_at>now())
 ), effective AS (
 SELECT DISTINCT ON (c.feature_id) c.feature_id,c.module_id,c.feature_key,
 CASE WHEN o.mode='REVOKE' THEN false WHEN o.mode='GRANT' THEN true ELSE c.base_enabled END AS enabled,
 CASE WHEN o.mode='GRANT' THEN o.limit_value WHEN o.mode='REVOKE' THEN NULL::numeric ELSE c.base_limit END AS effective_limit,c.base_config AS effective_config
 FROM candidates c CROSS JOIN current_subscription s LEFT JOIN LATERAL (
 SELECT x.mode,x.limit_value FROM public.organization_feature_overrides x WHERE x.organization_id=s.organization_id AND x.feature_id=c.feature_id AND x.ended_at IS NULL
 AND x.starts_at<=now() AND (x.ends_at IS NULL OR x.ends_at>now()) ORDER BY x.created_at DESC,x.id DESC LIMIT 1
 ) o ON true ORDER BY c.feature_id
 ) SELECT m.key::text,e.feature_key::text,e.effective_limit::numeric,e.effective_config FROM effective e
 JOIN public.saas_modules m ON m.id=e.module_id AND m.active IS TRUE WHERE e.enabled IS TRUE ORDER BY m.key,e.feature_key
$function$;