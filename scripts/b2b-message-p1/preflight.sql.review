-- READ-ONLY canonical swzpzcwiasxmjutrmvkm; every ok must be true before review.
WITH expected(t,n,h) AS (VALUES
 ('partner_orders',5,'21dcad4df953b5a19e0ffc8515d3d31f'),
 ('partner_accounts',6,'f9847b3c9d9fc65a8cbb4c590484a713'),
 ('partner_order_messages',4,'94f81030b9075b4cfe4d5ca668dac915'),
 ('partner_order_message_attachments',3,'ba0e0aef613cda9166650ebec0485604')),
 actual AS (SELECT tablename,count(*) n,md5(string_agg(policyname||'|'||permissive||'|'||cmd||'|'||roles::text||'|'||coalesce(qual,'')||'|'||coalesce(with_check,''),E'\n' ORDER BY policyname)) h
 FROM pg_policies WHERE schemaname='public' GROUP BY tablename)
SELECT e.t,a.n,a.h,(a.n=e.n AND a.h=e.h) IS TRUE AS ok FROM expected e LEFT JOIN actual a ON a.tablename=e.t;
SELECT md5(string_agg(c.oid::regclass::text||'|'||coalesce(c.relacl::text,'')||'|'||c.relrowsecurity::text||'|'||c.relforcerowsecurity::text,E'\n' ORDER BY c.oid::regclass::text))='8aced6f91d2119f0f79ecef1e4eda223' AS acl_ok
FROM pg_class c WHERE c.oid IN ('public.partner_orders'::regclass,'public.partner_order_messages'::regclass,'public.partner_order_message_attachments'::regclass);
SELECT md5(coalesce(string_agg(t.tgrelid::regclass::text||'|'||pg_get_triggerdef(t.oid)||'|'||t.tgenabled::text||'|'||md5(pg_get_functiondef(t.tgfoid)),E'\n' ORDER BY t.tgrelid::regclass::text,t.tgname),''))='0ddbd7a5e55e0ae87c191f45bf4bcea4' AS triggers_ok
FROM pg_trigger t WHERE NOT t.tgisinternal AND t.tgrelid IN ('public.partner_order_messages'::regclass,'public.partner_order_message_attachments'::regclass);
SELECT md5(string_agg(conrelid::regclass::text||'|'||conname||'|'||pg_get_constraintdef(oid)||'|'||convalidated::text,E'\n' ORDER BY conrelid::regclass::text,conname))='33dff3248407591697078ab190e5f963' AS constraints_ok
FROM pg_constraint WHERE conrelid IN ('public.partner_order_messages'::regclass,'public.partner_order_message_attachments'::regclass);
SELECT md5(string_agg(tablename||'|'||indexname||'|'||indexdef,E'\n' ORDER BY tablename,indexname))='52ae2b332eeb83e5b7e3395de68bd7f5' AS indexes_ok
FROM pg_indexes WHERE schemaname='public' AND tablename IN ('partner_order_messages','partner_order_message_attachments');
SELECT c.oid::regclass AS relation,c.relrowsecurity,c.relforcerowsecurity,c.relacl,
 has_table_privilege('authenticated',c.oid,'SELECT') AS can_read,
 has_table_privilege('authenticated',c.oid,'INSERT') AS can_insert,
 has_table_privilege('authenticated',c.oid,'DELETE') AS can_delete
FROM pg_class c WHERE c.oid IN ('public.partner_orders'::regclass,'public.partner_accounts'::regclass,'public.partner_order_messages'::regclass,'public.partner_order_message_attachments'::regclass);
SELECT p.oid::regprocedure,p.provolatile,p.prosecdef,p.proconfig,p.proacl,md5(pg_get_functiondef(p.oid)) AS md5
FROM pg_proc p WHERE p.oid IN ('platform_private.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure,
 'platform_private.b2b_actor_scope(uuid)'::regprocedure,'public.h15_actor_organization()'::regprocedure,
 'platform_private.h15_actor_organization()'::regprocedure,'platform_private.has_role(uuid,public.app_role)'::regprocedure);
-- Review dependency output against live-contracts below, not just trigger names.
SELECT policyname,permissive,cmd,roles,qual,with_check FROM pg_policies
WHERE schemaname='public' AND tablename='partner_accounts' ORDER BY policyname;
SELECT NOT EXISTS(SELECT 1 FROM pg_policies WHERE schemaname='public'
 AND policyname IN ('p1_message_order_tenant_guard','p1_attachment_message_tenant_guard')) AS names_available;
SELECT md5(string_agg(table_name||'|'||column_name||'|'||udt_name||'|'||is_nullable||'|'||coalesce(column_default,''),E'\n' ORDER BY table_name,ordinal_position))='ec6d82bbe2baca9370947b427594db5e' AS columns_ok
FROM information_schema.columns WHERE table_schema='public' AND table_name IN ('partner_order_messages','partner_order_message_attachments');
WITH expected(sig,h) AS (VALUES
 ('platform_private.b2b_phase1_partner_visible(uuid,boolean)','35cfda5d5988fb6ad57944bd11a51c3c'),
 ('platform_private.b2b_actor_scope(uuid)','c85cb35201682c3c86b9a327d24c8482'),
 ('platform_private.has_role(uuid,public.app_role)','c5af5b55de6d79da9b73a33948746ae2'),
 ('platform_private.platform_actor_access_ready(uuid)','048249c0c2106c3761e26eacb8d0de84'),
 ('platform_private.h15_actor_organization()','64e10608403238a41a9baf92857ca881'),
 ('public.h15_actor_organization()','55edafec08bcc84a00f1526c14334a2c'),
 ('public.has_role(uuid,public.app_role)','4d90e93d521a4819d9085f28d742030f'),
 -- Hashes pós-Entrega 2 rev 2.3 (migration 20261018213517, aplicada 18/10):
 -- helpers agora respeitam revoked_at e tenant_id. NÃO sobrescrever.
 ('public.get_user_partner_id()','b334c3a454ebc4233d3b9e0d0a700d78'),
 ('public.get_partner_papel()','f84f898ead03dfd646ece50d16baf909'),
 ('public.is_platform_superadmin(uuid)','3dfe79d976821244d9b7a7f893d765f2'),
 ('platform_private.b2b_direct_partner_row_allowed()','8967832dbfa4ee782c4c063ca5e1e3d4'),
 ('platform_private.b2b_coherent_self_partner(uuid)','56d8f1e84bbf889eb2d3f990c3ed1162'),
 ('platform_private.b2b_commercial_context()','a31d198c9a9fc9a5e7c397ab36fe0fa4'),
 ('platform_private.entitlements_for_user(uuid)','7f4ec7facaebbdf35444dd490fdebe56'),
 ('public.tg_commercial_audit()','59f38730b9f37102cbf2ed4bd44a7e00'),
 -- Residual P1: contadores ainda DEFINER pré-candidata (corpo/ACL preservados).
 ('public.rpc_partner_message_counters(uuid)','5b049aa45efddf8aff1b92b14a759a46'))
SELECT e.sig,md5(pg_get_functiondef(p.oid)) AS actual_md5,
 (md5(pg_get_functiondef(p.oid))=e.h) IS TRUE AS body_ok,p.proacl,p.proconfig,p.provolatile,p.prosecdef
FROM expected e LEFT JOIN pg_proc p ON p.oid=to_regprocedure(e.sig);
-- Pré-candidata, rpc_partner_message_counters DEVE estar prosecdef=true;
-- pós-candidata, prosecdef=false com md5 de corpo e proacl INALTERADOS.
SELECT p.prosecdef AS counters_secdef, md5(pg_get_functiondef(p.oid)) AS counters_md5, p.proacl AS counters_acl
FROM pg_proc p WHERE p.oid='public.rpc_partner_message_counters(uuid)'::regprocedure;
-- ACLs must remain captured closed: authenticated only authorized callable
-- wrappers, b2b_actor_scope has postgres/service-only; never add grants.