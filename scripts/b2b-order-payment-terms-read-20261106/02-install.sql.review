-- 02 INSTALL (REVISÁVEL; NÃO APLICAR sem autorização).
BEGIN;
DO $$ BEGIN
  IF to_regprocedure('platform_private.b2b_phase1_order_visible(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_order_visible(uuid)'::regprocedure)) <> '8504f07fbc3a7975accf919f386d00eb' THEN RAISE EXCEPTION 'INSTALL: platform_private.b2b_phase1_order_visible(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '915f516e605af7cc14584e2e762a2661' THEN RAISE EXCEPTION 'INSTALL: platform_private.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('public.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '6b3defc01a66040146562c60ad224f03' THEN RAISE EXCEPTION 'INSTALL: public.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.is_valid_b2b_partner_user(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.is_valid_b2b_partner_user(uuid,uuid)'::regprocedure)) <> '0bb0dea04be8ca84c66db7ca6329876c' THEN RAISE EXCEPTION 'INSTALL: public.is_valid_b2b_partner_user(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_owner_internal_partner_readable(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_owner_internal_partner_readable(uuid)'::regprocedure)) <> 'fa72ca18fc673cb4a5ff4867e65137cd' THEN RAISE EXCEPTION 'INSTALL: platform_private.b2b_owner_internal_partner_readable(uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(polname||':'||polcmd::text||':'||polpermissive::text||':'||coalesce(pg_get_expr(polqual,polrelid),'')||':'||coalesce(pg_get_expr(polwithcheck,polrelid),''), '|' ORDER BY polname)) FROM pg_policy WHERE polrelid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM 'ddbf3800745ee333bfdb552a905078c0' THEN RAISE EXCEPTION 'policies de partner_order_payment_terms mudaram'; END IF;
  IF (SELECT md5(relacl::text) FROM pg_class WHERE oid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM '46875263bd6598c4534e2df7d1847a5e' THEN RAISE EXCEPTION 'ACL da tabela mudou'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NOT NULL THEN RAISE EXCEPTION 'INSTALL: leitor já existe'; END IF;
END $$;
CREATE OR REPLACE FUNCTION public.get_partner_order_payment_terms_secure(p_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
-- B2B_ORDER_PAYMENT_TERMS_READ_V1: somente leitura; não aprova, não altera e não expõe credit_decision_snapshot.
DECLARE v_uid uuid := auth.uid(); v_partner uuid; v_n integer; v_terms jsonb;
BEGIN
  IF v_uid IS NULL OR p_order_id IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  SELECT o.partner_id INTO v_partner FROM public.partner_orders o WHERE o.id = p_order_id;
  -- Mesmas portas do guard restritivo de SELECT de partner_orders; pedido inexistente nega igual (sem oráculo).
  IF v_partner IS NULL OR NOT (platform_private.b2b_phase1_partner_visible(v_partner, false) IS TRUE
                               OR platform_private.b2b_owner_internal_partner_readable(v_partner) IS TRUE) THEN
    RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  -- Mesma regra de papel da policy permissiva popt_select.
  IF NOT (platform_private.has_role(v_uid, 'administrador'::public.app_role) OR platform_private.has_role(v_uid, 'financeiro'::public.app_role)
          OR platform_private.has_role(v_uid, 'gestor_comercial'::public.app_role)
          OR (platform_private.has_role(v_uid, 'parceiro_b2b'::public.app_role)
              AND EXISTS (SELECT 1 FROM public.partner_users pu WHERE pu.partner_id = v_partner AND pu.user_id = v_uid))) THEN
    RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  SELECT count(*) INTO v_n FROM public.partner_order_payment_terms t WHERE t.partner_order_id = p_order_id;
  IF v_n > 1 THEN RAISE EXCEPTION 'payment_terms_ambiguous' USING ERRCODE='P0001'; END IF;
  SELECT jsonb_build_object('id', t.id, 'partner_order_id', t.partner_order_id, 'payment_plan_id', t.payment_plan_id, 'plan_name_snapshot', t.plan_name_snapshot, 'plan_code_snapshot', t.plan_code_snapshot, 'pricing_mode_snapshot', t.pricing_mode_snapshot, 'discount_percent_snapshot', t.discount_percent_snapshot, 'monthly_interest_percent_snapshot', t.monthly_interest_percent_snapshot, 'months_count_snapshot', t.months_count_snapshot, 'interest_type_snapshot', t.interest_type_snapshot, 'installment_count', t.installment_count, 'first_due_date', t.first_due_date, 'table_amount', t.table_amount, 'discount_amount', t.discount_amount, 'net_amount_after_discount', t.net_amount_after_discount, 'financial_interest_amount', t.financial_interest_amount, 'final_amount', t.final_amount, 'approval_status', t.approval_status, 'approved_at', t.approved_at, 'approval_notes', t.approval_notes, 'created_at', t.created_at, 'updated_at', t.updated_at) INTO v_terms FROM public.partner_order_payment_terms t WHERE t.partner_order_id = p_order_id;
  RETURN jsonb_build_object('contract', 'B2B_ORDER_PAYMENT_TERMS_READ_V1', 'order_id', p_order_id,
                            'present', v_terms IS NOT NULL, 'terms', v_terms);
END $function$;
REVOKE ALL ON FUNCTION public.get_partner_order_payment_terms_secure(uuid) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.get_partner_order_payment_terms_secure(uuid) TO authenticated;
DO $$ BEGIN
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'INSTALL_POST: leitor divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_phase1_order_visible(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_order_visible(uuid)'::regprocedure)) <> '8504f07fbc3a7975accf919f386d00eb' THEN RAISE EXCEPTION 'INSTALL_POST: platform_private.b2b_phase1_order_visible(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '915f516e605af7cc14584e2e762a2661' THEN RAISE EXCEPTION 'INSTALL_POST: platform_private.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('public.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '6b3defc01a66040146562c60ad224f03' THEN RAISE EXCEPTION 'INSTALL_POST: public.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.is_valid_b2b_partner_user(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.is_valid_b2b_partner_user(uuid,uuid)'::regprocedure)) <> '0bb0dea04be8ca84c66db7ca6329876c' THEN RAISE EXCEPTION 'INSTALL_POST: public.is_valid_b2b_partner_user(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_owner_internal_partner_readable(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_owner_internal_partner_readable(uuid)'::regprocedure)) <> 'fa72ca18fc673cb4a5ff4867e65137cd' THEN RAISE EXCEPTION 'INSTALL_POST: platform_private.b2b_owner_internal_partner_readable(uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(polname||':'||polcmd::text||':'||polpermissive::text||':'||coalesce(pg_get_expr(polqual,polrelid),'')||':'||coalesce(pg_get_expr(polwithcheck,polrelid),''), '|' ORDER BY polname)) FROM pg_policy WHERE polrelid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM 'ddbf3800745ee333bfdb552a905078c0' THEN RAISE EXCEPTION 'policies de partner_order_payment_terms mudaram'; END IF;
  IF (SELECT md5(relacl::text) FROM pg_class WHERE oid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM '46875263bd6598c4534e2df7d1847a5e' THEN RAISE EXCEPTION 'ACL da tabela mudou'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.get_partner_order_payment_terms_secure(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'ACL: PUBLIC/anon com EXECUTE'; END IF;
END $$;
COMMIT;
