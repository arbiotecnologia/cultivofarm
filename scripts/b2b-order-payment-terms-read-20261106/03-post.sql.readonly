-- 03 POST (somente leitura).
DO $$ BEGIN
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'POST: leitor divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_phase1_order_visible(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_order_visible(uuid)'::regprocedure)) <> '8504f07fbc3a7975accf919f386d00eb' THEN RAISE EXCEPTION 'POST: platform_private.b2b_phase1_order_visible(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '915f516e605af7cc14584e2e762a2661' THEN RAISE EXCEPTION 'POST: platform_private.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.b2b_phase1_partner_visible(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('public.b2b_phase1_partner_visible(uuid,boolean)'::regprocedure)) <> '6b3defc01a66040146562c60ad224f03' THEN RAISE EXCEPTION 'POST: public.b2b_phase1_partner_visible(uuid,boolean) divergente'; END IF;
  IF to_regprocedure('public.is_valid_b2b_partner_user(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.is_valid_b2b_partner_user(uuid,uuid)'::regprocedure)) <> '0bb0dea04be8ca84c66db7ca6329876c' THEN RAISE EXCEPTION 'POST: public.is_valid_b2b_partner_user(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_owner_internal_partner_readable(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_owner_internal_partner_readable(uuid)'::regprocedure)) <> 'fa72ca18fc673cb4a5ff4867e65137cd' THEN RAISE EXCEPTION 'POST: platform_private.b2b_owner_internal_partner_readable(uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(polname||':'||polcmd::text||':'||polpermissive::text||':'||coalesce(pg_get_expr(polqual,polrelid),'')||':'||coalesce(pg_get_expr(polwithcheck,polrelid),''), '|' ORDER BY polname)) FROM pg_policy WHERE polrelid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM 'ddbf3800745ee333bfdb552a905078c0' THEN RAISE EXCEPTION 'policies de partner_order_payment_terms mudaram'; END IF;
  IF (SELECT md5(relacl::text) FROM pg_class WHERE oid='public.partner_order_payment_terms'::regclass) IS DISTINCT FROM '46875263bd6598c4534e2df7d1847a5e' THEN RAISE EXCEPTION 'ACL da tabela mudou'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.get_partner_order_payment_terms_secure(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'ACL: PUBLIC/anon com EXECUTE'; END IF;
  RAISE NOTICE 'POST_OK';
END $$;
