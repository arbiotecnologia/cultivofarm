-- Rollback deny-only: mantém a assinatura, retira EXECUTE e troca o corpo por negação. Não toca RLS/volumes.
BEGIN;
CREATE OR REPLACE FUNCTION public.get_partner_catalog_volumes_secure(p_partner_id uuid)
RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO ''
AS $function$ BEGIN RAISE EXCEPTION 'b2b_partner_volumes_disabled' USING ERRCODE = '42501'; END $function$;
REVOKE ALL ON FUNCTION public.get_partner_catalog_volumes_secure(uuid) FROM PUBLIC, anon, authenticated;
COMMIT;
