-- 01 PRE (somente leitura). Ref canônico swzpzcwiasxmjutrmvkm conferido FORA do SQL antes de rodar.
DO $$ BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> 'c34e740473afb7a365d362db854069cb' THEN RAISE EXCEPTION 'PRE: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'PRE: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente'; END IF;
  IF to_regprocedure('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)') IS NULL OR md5(pg_get_functiondef('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)'::regprocedure)) <> 'e57d3a6416910937bd02c9180dff0cf1' THEN RAISE EXCEPTION 'PRE: public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN RAISE EXCEPTION 'PRE: platform_private.b2b_partner_catalog_reader(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881' THEN RAISE EXCEPTION 'PRE: platform_private.h15_actor_organization() divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'PRE: public.get_partner_order_payment_terms_secure(uuid) divergente'; END IF;
  IF to_regprocedure('public.fn_b2b_credit_exposure(uuid,numeric,uuid)') IS NULL OR md5(pg_get_functiondef('public.fn_b2b_credit_exposure(uuid,numeric,uuid)'::regprocedure)) <> '213ac31f3a30816ead75365b0d1fed18' THEN RAISE EXCEPTION 'PRE: public.fn_b2b_credit_exposure(uuid,numeric,uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='payment_methods') IS DISTINCT FROM '71f7ed4ddacf2392c9c327e64376c2be' THEN RAISE EXCEPTION 'PRE: colunas de payment_methods divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='partner_order_payment_terms') IS DISTINCT FROM 'f32804287d84d6467e33757064f715fa' THEN RAISE EXCEPTION 'PRE: colunas de partner_order_payment_terms divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans') IS DISTINCT FROM 'fa11d3b5c4d1737c9a5e98cdece94c55' THEN RAISE EXCEPTION 'PRE: colunas de commercial_payment_plans divergentes'; END IF;
  IF to_regclass('public.financial_categories') IS NULL OR (SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name='financial_categories' AND column_name IN ('id','type','active','name')) <> 4 THEN RAISE EXCEPTION 'PRE: financial_categories divergente'; END IF;
  IF to_regclass('platform_private.b2b_condition_versions') IS NOT NULL OR to_regclass('platform_private.b2b_condition_activation') IS NOT NULL OR to_regprocedure('public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)') IS NOT NULL OR to_regclass('public.b2b_payment_method_configs') IS NOT NULL OR to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text,jsonb)') IS NOT NULL THEN RAISE EXCEPTION 'já instalado ou contrato concorrente presente'; END IF;
  RAISE NOTICE 'PRE_OK';
END $$;
