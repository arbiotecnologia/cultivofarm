-- 03 POST (somente leitura).
DO $$ BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> 'c34e740473afb7a365d362db854069cb' THEN RAISE EXCEPTION 'POST: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'POST: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN RAISE EXCEPTION 'POST: platform_private.b2b_partner_catalog_reader(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881' THEN RAISE EXCEPTION 'POST: platform_private.h15_actor_organization() divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'POST: public.get_partner_order_payment_terms_secure(uuid) divergente'; END IF;
  IF to_regprocedure('public.fn_b2b_credit_exposure(uuid,numeric,uuid)') IS NULL OR md5(pg_get_functiondef('public.fn_b2b_credit_exposure(uuid,numeric,uuid)'::regprocedure)) <> '213ac31f3a30816ead75365b0d1fed18' THEN RAISE EXCEPTION 'POST: public.fn_b2b_credit_exposure(uuid,numeric,uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='payment_methods') IS DISTINCT FROM '71f7ed4ddacf2392c9c327e64376c2be' THEN RAISE EXCEPTION 'POST: colunas de payment_methods divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='partner_order_payment_terms') IS DISTINCT FROM 'f32804287d84d6467e33757064f715fa' THEN RAISE EXCEPTION 'POST: colunas de partner_order_payment_terms divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans') IS DISTINCT FROM 'fa11d3b5c4d1737c9a5e98cdece94c55' THEN RAISE EXCEPTION 'POST: colunas de commercial_payment_plans divergentes'; END IF;
  IF to_regclass('public.financial_categories') IS NULL OR (SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name='financial_categories' AND column_name IN ('id','type','active','name')) <> 4 THEN RAISE EXCEPTION 'POST: financial_categories divergente'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_condition_retire(uuid,text,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_condition_retire(uuid,text,integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_condition_retire(uuid,text,integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_condition_retire(uuid,text,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_condition_activation_set(text,uuid[],integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_condition_activation_set(text,uuid[],integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_condition_activation_set(text,uuid[],integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_condition_activation_set(text,uuid[],integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_condition_config_list()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_condition_config_list()'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_condition_config_list()', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_condition_config_list()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_list_payment_condition_options_secure(uuid,uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_list_payment_condition_options_secure(uuid,uuid)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_list_payment_condition_options_secure(uuid,uuid)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_list_payment_condition_options_secure(uuid,uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.get_partner_order_payment_condition_secure(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.get_partner_order_payment_condition_secure(uuid)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.get_partner_order_payment_condition_secure(uuid)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.get_partner_order_payment_condition_secure(uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_choice(jsonb)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_choice(jsonb)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_schedule(numeric,numeric,integer,date,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_schedule(numeric,numeric,integer,date,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_seller(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_seller(uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_hash(text,jsonb,jsonb,numeric)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_hash(text,jsonb,jsonb,numeric)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_mode(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_mode(uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_required_check()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_required_check()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_immutable()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_immutable()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_condition_cfg_actor(boolean)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid, 'service_role'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_condition_cfg_actor(boolean)'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_versions', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_versions', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_versions'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_versions exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_assignments', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_assignments', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_assignments'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_assignments exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_order_condition_snapshots', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_order_condition_snapshots', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_order_condition_snapshots'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_order_condition_snapshots exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_retirements', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_retirements', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_retirements'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_retirements exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_assignment_revocations', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_assignment_revocations', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_assignment_revocations'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_assignment_revocations exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_activation', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_activation', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_activation'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_activation exposta'; END IF;
  IF has_table_privilege('authenticated', 'platform_private.b2b_condition_activation_history', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'platform_private.b2b_condition_activation_history', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.b2b_condition_activation_history'::regclass) THEN RAISE EXCEPTION 'POST: tabela b2b_condition_activation_history exposta'; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='b2b_payment_condition_required' AND tgdeferrable AND tginitdeferred AND tgenabled='O') THEN RAISE EXCEPTION 'POST: trigger de exigência ausente'; END IF;
  RAISE NOTICE 'POST_OK';
END $$;
