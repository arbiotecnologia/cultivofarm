-- 04 ROLLBACK deny-only: RPCs novos passam a negar; gatilho, ativações, versões, snapshots e histórico PERMANECEM.
-- Empresas não ativadas seguem o contrato atual; empresas já ativadas ficam bloqueadas (nega, nunca reabre fallback).
BEGIN;
DO $$ BEGIN
  IF to_regprocedure('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'::regprocedure)) <> '5d410cdba3c34298389302fb91d2fb16' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer) divergente'; END IF;
