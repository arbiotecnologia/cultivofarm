DO $$ BEGIN
  IF to_regprocedure('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'::regprocedure)) <> 'e40a25e08476b1c70a82ce514731f829' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer) divergente'; END IF;
