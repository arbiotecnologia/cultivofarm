  IF to_regprocedure('public.b2b_payment_condition_config_list()') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_condition_config_list()'::regprocedure)) <> '561fa25917c7d3938faa82b1aa7d61de' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_condition_config_list() divergente'; END IF;
  IF to_regprocedure('public.b2b_list_payment_condition_options_secure(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.b2b_list_payment_condition_options_secure(uuid,uuid)'::regprocedure)) <> '8a7f29c199e77e653966ebdb8a4b3ed3' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_list_payment_condition_options_secure(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb)'::regprocedure)) <> 'd4c50e5880f39ea3a5dfa719c7d1e919' THEN RAISE EXCEPTION 'ROLLBACK: public.simulate_b2b_payment_condition_secure(uuid,uuid,jsonb,jsonb) divergente'; END IF;
  IF to_regprocedure('public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb)'::regprocedure)) <> 'b4044cf9489a00283e62bf43cfbadd90' THEN RAISE EXCEPTION 'ROLLBACK: public.create_partner_order_condition_secure(uuid,text,jsonb,date,uuid,text,text,jsonb) divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_condition_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_condition_secure(uuid)'::regprocedure)) <> '6836dd87a66e9daa58801a1656d6c67e' THEN RAISE EXCEPTION 'ROLLBACK: public.get_partner_order_payment_condition_secure(uuid) divergente'; END IF;
END $$;
CREATE OR REPLACE FUNCTION public.b2b_payment_condition_publish(p_plan_id uuid, p_method text, p_payment_method_id uuid, p_category_id uuid, p_deadline_days integer, p_installment_count integer, p_monthly_rate numeric, p_expected_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_condition_rolled_back' USING ERRCODE='42501';
END $function$;
