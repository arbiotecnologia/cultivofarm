  IF to_regprocedure('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'::regprocedure)) <> '58c003869c6c6159a78fd3009296476a' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean) divergente'; END IF;
