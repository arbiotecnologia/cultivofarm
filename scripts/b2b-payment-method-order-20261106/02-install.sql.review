REVOKE ALL ON FUNCTION public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) TO authenticated;
REVOKE ALL ON FUNCTION public.get_partner_order_payment_method_secure(uuid) FROM PUBLIC, anon;
