-- 02 INSTALL (REVISÁVEL; NÃO APLICAR sem autorização). Não altera corpos LIVE, planos, condições, PB-001036 ou configurações.
-- Nenhuma empresa fica ativada: sem linha em b2b_payment_method_activation todos seguem o contrato atual.
BEGIN;
SET LOCAL lock_timeout = '3s';
DO $$ BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> 'c34e740473afb7a365d362db854069cb' THEN RAISE EXCEPTION 'INSTALL: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'INSTALL: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN RAISE EXCEPTION 'INSTALL: platform_private.b2b_partner_catalog_reader(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881' THEN RAISE EXCEPTION 'INSTALL: platform_private.h15_actor_organization() divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'INSTALL: public.get_partner_order_payment_terms_secure(uuid) divergente'; END IF;
  IF to_regprocedure('public.fn_b2b_credit_exposure(uuid,numeric,uuid)') IS NULL OR md5(pg_get_functiondef('public.fn_b2b_credit_exposure(uuid,numeric,uuid)'::regprocedure)) <> '213ac31f3a30816ead75365b0d1fed18' THEN RAISE EXCEPTION 'INSTALL: public.fn_b2b_credit_exposure(uuid,numeric,uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='payment_methods') IS DISTINCT FROM '71f7ed4ddacf2392c9c327e64376c2be' THEN RAISE EXCEPTION 'INSTALL: colunas de payment_methods divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='partner_order_payment_terms') IS DISTINCT FROM 'f32804287d84d6467e33757064f715fa' THEN RAISE EXCEPTION 'INSTALL: colunas de partner_order_payment_terms divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans') IS DISTINCT FROM 'fa11d3b5c4d1737c9a5e98cdece94c55' THEN RAISE EXCEPTION 'INSTALL: colunas de commercial_payment_plans divergentes'; END IF;
  IF to_regclass('public.b2b_payment_method_configs') IS NOT NULL OR to_regclass('platform_private.b2b_payment_method_activation') IS NOT NULL OR to_regprocedure('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)') IS NOT NULL THEN RAISE EXCEPTION 'já instalado'; END IF;
END $$;

CREATE TABLE platform_private.b2b_payment_method_activation(
  organization_id uuid PRIMARY KEY REFERENCES public.organizations(id),
  mode text NOT NULL CHECK (mode IN ('off','pilot','enforced')),
  pilot_partner_ids uuid[] NOT NULL DEFAULT '{}',
  version integer NOT NULL CHECK (version > 0), updated_by uuid NOT NULL, updated_at timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT b2bpma_pilot_shape CHECK ((mode = 'pilot') = (cardinality(pilot_partner_ids) > 0)));
CREATE TABLE platform_private.b2b_payment_method_activation_history(
  organization_id uuid NOT NULL, version integer NOT NULL, snapshot jsonb NOT NULL, actor_id uuid NOT NULL,
  recorded_at timestamptz NOT NULL DEFAULT now(), PRIMARY KEY (organization_id, version));

CREATE TABLE public.b2b_payment_method_configs(
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  organization_id uuid NOT NULL REFERENCES public.organizations(id),
  payment_plan_id uuid NOT NULL REFERENCES public.commercial_payment_plans(id),
  method_kind text NOT NULL CHECK (method_kind IN ('dinheiro','pix','debito','boleto','promissoria','credito')),
  payment_method_id uuid NOT NULL REFERENCES public.payment_methods(id),
  status text NOT NULL CHECK (status IN ('active','revoked')),
  version integer NOT NULL CHECK (version > 0),
  due_days integer NOT NULL CHECK (due_days BETWEEN 0 AND 365),
  max_installments integer NOT NULL CHECK (max_installments BETWEEN 1 AND 36),
  price_monthly_rate_percent numeric(9,6) CHECK (price_monthly_rate_percent IS NULL OR price_monthly_rate_percent BETWEEN 0 AND 100),
  created_by uuid NOT NULL, created_at timestamptz NOT NULL DEFAULT now(),
  updated_by uuid NOT NULL, updated_at timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT b2b_pmc_unique UNIQUE (organization_id, payment_plan_id, method_kind),
  CONSTRAINT b2b_pmc_single_payment CHECK (method_kind NOT IN ('dinheiro','pix','debito') OR (max_installments = 1 AND price_monthly_rate_percent IS NULL)),
  CONSTRAINT b2b_pmc_boleto_max3 CHECK (method_kind <> 'boleto' OR max_installments <= 3),
  CONSTRAINT b2b_pmc_price_rate_explicit CHECK (max_installments = 1 OR price_monthly_rate_percent IS NOT NULL));

CREATE TABLE public.b2b_payment_method_config_versions(
  config_id uuid NOT NULL REFERENCES public.b2b_payment_method_configs(id), version integer NOT NULL,
  snapshot jsonb NOT NULL, actor_id uuid NOT NULL, recorded_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (config_id, version));

CREATE TABLE public.partner_order_payment_method_snapshots(
  partner_order_id uuid PRIMARY KEY REFERENCES public.partner_orders(id),
  payment_terms_id uuid,
  organization_id uuid NOT NULL, partner_id uuid NOT NULL,
  config_id uuid NOT NULL REFERENCES public.b2b_payment_method_configs(id), config_version integer NOT NULL,
  method_kind text NOT NULL, payment_method_id uuid NOT NULL, payment_method_name_snapshot text NOT NULL,
  due_days integer NOT NULL, installment_count integer NOT NULL, price_monthly_rate_percent numeric(9,6),
  due_basis text NOT NULL DEFAULT 'nf_issue' CHECK (due_basis = 'nf_issue'),
  schedule_estimated boolean NOT NULL DEFAULT true CHECK (schedule_estimated),
  estimated_reference_date date NOT NULL, estimated_schedule jsonb NOT NULL, final_amount numeric(14,2), cart_hash text NOT NULL,
  created_by uuid NOT NULL, created_at timestamptz NOT NULL DEFAULT now());

REVOKE ALL ON public.b2b_payment_method_configs, public.b2b_payment_method_config_versions,
  public.partner_order_payment_method_snapshots FROM PUBLIC, anon, authenticated;
REVOKE ALL ON platform_private.b2b_payment_method_activation, platform_private.b2b_payment_method_activation_history FROM PUBLIC, anon, authenticated;
ALTER TABLE public.b2b_payment_method_configs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.b2b_payment_method_config_versions ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.partner_order_payment_method_snapshots ENABLE ROW LEVEL SECURITY;
-- Sem policies para clientes: leitura e escrita somente pelos RPCs abaixo (empresa derivada no servidor).

CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_immutable()
 RETURNS trigger LANGUAGE plpgsql SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_history_immutable' USING ERRCODE='42501';
END $function$;
CREATE TRIGGER b2b_pm_snapshot_immutable BEFORE UPDATE OR DELETE ON public.partner_order_payment_method_snapshots
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_payment_method_immutable();
CREATE TRIGGER b2b_pm_versions_immutable BEFORE UPDATE OR DELETE ON public.b2b_payment_method_config_versions
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_payment_method_immutable();
CREATE TRIGGER b2b_pm_activation_history_immutable BEFORE UPDATE OR DELETE ON platform_private.b2b_payment_method_activation_history
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_payment_method_immutable();

-- Parcelas em centavos exatos. n>1 com taxa explícita: Price sobre o LÍQUIDO (o plano não pode ter juros próprios);
-- última parcela absorve o resíduo do principal. Caso contrário: total do plano (juros LIVE) dividido como no corpo LIVE.
-- 1ª data = base + due_days; seguintes no mesmo dia ou último dia do mês. ESTIMATIVA: dia útil/NF ficam no B4.
CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_schedule(p_net numeric, p_plan_final numeric, p_n integer, p_due_days integer, p_rate numeric, p_base date)
 RETURNS jsonb LANGUAGE plpgsql IMMUTABLE SET search_path TO '' AS $function$
DECLARE i numeric; pmt numeric(14,2); bal numeric(14,2); it numeric(14,2); pr numeric(14,2); amt numeric(14,2); acc numeric(14,2) := 0;
  out jsonb := '[]'::jsonb; k integer; first_due date; price boolean;
BEGIN
  IF p_net IS NULL OR p_net < 0 OR p_plan_final IS NULL OR p_plan_final < 0 OR p_n IS NULL OR p_n NOT BETWEEN 1 AND 36
     OR p_due_days IS NULL OR p_due_days NOT BETWEEN 0 AND 365 OR p_base IS NULL OR (p_rate IS NOT NULL AND (p_rate < 0 OR p_rate > 100)) THEN
    RAISE EXCEPTION 'payment_method_schedule_invalid' USING ERRCODE='22023'; END IF;
  price := p_n > 1 AND p_rate IS NOT NULL;
  IF price AND round(p_plan_final, 2) <> round(p_net, 2) THEN RAISE EXCEPTION 'payment_method_price_interest_conflict' USING ERRCODE='PT409'; END IF;
  first_due := p_base + p_due_days;
  IF price THEN
    i := p_rate / 100; bal := round(p_net, 2);
    IF i = 0 THEN pmt := round(bal / p_n, 2); ELSE pmt := round(bal * i / (1 - power(1 + i, -p_n)), 2); END IF;
    FOR k IN 1..p_n LOOP
      it := round(bal * i, 2);
      IF k < p_n THEN pr := pmt - it; ELSE pr := bal; END IF;
      out := out || jsonb_build_array(jsonb_build_object('installment_number', k,
        'estimated_due_date', (first_due + make_interval(months => k - 1))::date, 'amount', pr + it, 'principal_amount', pr, 'interest_amount', it));
      bal := bal - pr;
    END LOOP;
  ELSE
    amt := round(p_plan_final / p_n, 2);
    FOR k IN 1..p_n LOOP
      IF k = p_n THEN amt := round(p_plan_final - acc, 2); END IF;
      acc := acc + amt;
      pr := CASE WHEN p_plan_final = 0 THEN 0 ELSE round(amt * (p_net / p_plan_final), 2) END;
      out := out || jsonb_build_array(jsonb_build_object('installment_number', k,
        'estimated_due_date', (first_due + make_interval(months => k - 1))::date, 'amount', amt, 'principal_amount', pr, 'interest_amount', amt - pr));
    END LOOP;
  END IF;
  RETURN out;
END $function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_hash(p_base text, p_pm jsonb, p_total numeric)
 RETURNS text LANGUAGE sql IMMUTABLE SET search_path TO '' AS $function$
  SELECT encode(pg_catalog.sha256(convert_to('b2bpm_hash_v1|' || p_base || '|cfg=' || (p_pm->>'config_id') || '|v=' || (p_pm->>'version')
    || '|kind=' || (p_pm->>'method_kind') || '|n=' || (p_pm->>'installment_count') || '|due=' || (p_pm->>'due_days')
    || '|rate=' || COALESCE(p_pm->>'price_monthly_rate_percent', '-') || '|total=' || to_char(round(p_total, 2), 'FM9999999999990.00'), 'UTF8')), 'hex')
$function$;

-- Empresa vendedora do pedido: comprador externo -> leitor canônico; ator interno -> própria empresa (h15), que precisa
-- ser a dona comercial do parceiro. Nunca do payload.
CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_seller(p_partner_id uuid)
 RETURNS uuid LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  IF public.has_role(v_uid,'administrador'::public.app_role) IS TRUE OR public.has_role(v_uid,'gestor_comercial'::public.app_role) IS TRUE
     OR public.has_role(v_uid,'financeiro'::public.app_role) IS TRUE THEN
    v_org := platform_private.h15_actor_organization();
    IF v_org IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_accounts a WHERE a.id = p_partner_id AND a.commercial_owner_organization_id = v_org AND a.ativo IS TRUE) THEN
      RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501'; END IF;
    RETURN v_org;
  END IF;
  RETURN platform_private.b2b_partner_catalog_reader(p_partner_id);
END $function$;

CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_mode(p_partner_id uuid)
 RETURNS text LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
  SELECT CASE WHEN g.mode = 'enforced' OR (g.mode = 'pilot' AND p_partner_id = ANY (g.pilot_partner_ids)) THEN 'required' ELSE 'legacy' END
    FROM public.partner_accounts a LEFT JOIN platform_private.b2b_payment_method_activation g ON g.organization_id = a.commercial_owner_organization_id
   WHERE a.id = p_partner_id
$function$;

-- Resolve a configuração; com p_lock trava config -> plano -> atribuição -> meio (FOR SHARE), relendo depois de cada espera.
CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_resolve(p_partner_id uuid, p_plan_id uuid, p_config_id uuid, p_version integer, p_lock boolean)
 RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_seller uuid; c record; v_pm record; v_plan record; v_n integer; v_asg boolean;
BEGIN
  IF p_config_id IS NULL OR p_version IS NULL THEN RAISE EXCEPTION 'payment_method_required' USING ERRCODE='P0001'; END IF;
  v_seller := platform_private.b2b_payment_method_seller(p_partner_id);
  IF p_lock THEN
    SELECT * INTO c FROM public.b2b_payment_method_configs WHERE id = p_config_id FOR SHARE;
  ELSE
    SELECT * INTO c FROM public.b2b_payment_method_configs WHERE id = p_config_id;
  END IF;
  IF NOT FOUND OR c.organization_id IS DISTINCT FROM v_seller OR c.payment_plan_id IS DISTINCT FROM p_plan_id THEN
    RAISE EXCEPTION 'payment_method_unavailable' USING ERRCODE='42501'; END IF;
  IF c.version IS DISTINCT FROM p_version THEN RAISE EXCEPTION 'payment_method_stale' USING ERRCODE='PT409'; END IF;
  IF c.status <> 'active' THEN RAISE EXCEPTION 'payment_method_unavailable' USING ERRCODE='PT409'; END IF;
  IF p_lock THEN
    SELECT p.installment_count, p.monthly_interest_percent, p.active, p.max_days INTO v_plan FROM public.commercial_payment_plans p WHERE p.id = p_plan_id FOR SHARE;
    v_asg := EXISTS (SELECT 1 FROM (SELECT 1 FROM public.commercial_payment_plan_assignments a
                  WHERE a.plan_id = p_plan_id AND a.partner_id = p_partner_id AND a.buyer_scope = 'partner' AND a.status = 'published'
                    AND a.valid_from <= CURRENT_DATE AND (a.valid_until IS NULL OR a.valid_until >= CURRENT_DATE) FOR SHARE) x);
    SELECT pm.id, pm.name, pm.active INTO v_pm FROM public.payment_methods pm WHERE pm.id = c.payment_method_id FOR SHARE;
  ELSE
    SELECT p.installment_count, p.monthly_interest_percent, p.active, p.max_days INTO v_plan FROM public.commercial_payment_plans p WHERE p.id = p_plan_id;
    v_asg := EXISTS (SELECT 1 FROM public.commercial_payment_plan_assignments a
                  WHERE a.plan_id = p_plan_id AND a.partner_id = p_partner_id AND a.buyer_scope = 'partner' AND a.status = 'published'
                    AND a.valid_from <= CURRENT_DATE AND (a.valid_until IS NULL OR a.valid_until >= CURRENT_DATE));
    SELECT pm.id, pm.name, pm.active INTO v_pm FROM public.payment_methods pm WHERE pm.id = c.payment_method_id;
  END IF;
  IF v_plan.active IS NOT TRUE THEN RAISE EXCEPTION 'plan_inactive' USING ERRCODE='PT409'; END IF;
  IF NOT v_asg THEN RAISE EXCEPTION 'payment_method_unavailable' USING ERRCODE='PT409'; END IF;
  IF v_pm.id IS NULL OR v_pm.active IS NOT TRUE THEN RAISE EXCEPTION 'payment_method_unavailable' USING ERRCODE='PT409'; END IF;
  v_n := GREATEST(COALESCE(v_plan.installment_count, 1), 1);
  IF v_n > c.max_installments THEN RAISE EXCEPTION 'payment_method_installments_incompatible' USING ERRCODE='PT409'; END IF;
  IF v_n > 1 AND COALESCE(v_plan.monthly_interest_percent, 0) > 0 THEN RAISE EXCEPTION 'payment_method_price_interest_conflict' USING ERRCODE='PT409'; END IF;
  IF c.due_days > COALESCE(v_plan.max_days, 0) THEN RAISE EXCEPTION 'payment_method_due_exceeds_plan' USING ERRCODE='PT409'; END IF;
  RETURN jsonb_build_object('config_id', c.id, 'version', c.version, 'organization_id', c.organization_id, 'method_kind', c.method_kind,
    'payment_method_id', v_pm.id, 'payment_method_name', v_pm.name, 'due_days', c.due_days, 'installment_count', v_n,
    'price_monthly_rate_percent', CASE WHEN v_n > 1 THEN c.price_monthly_rate_percent END);
END $function$;

-- Exigência por empresa ativada: pedido sem snapshot de meio não fecha a transação (qualquer ator; sem bypass por papel).
CREATE OR REPLACE FUNCTION platform_private.b2b_payment_method_required_check()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  IF NEW.payment_plan_id IS NULL THEN RETURN NULL; END IF;
  IF platform_private.b2b_payment_method_mode(NEW.partner_id) IS DISTINCT FROM 'required' THEN RETURN NULL; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_order_payment_method_snapshots s WHERE s.partner_order_id = NEW.id) THEN
    RAISE EXCEPTION 'B2B_PAYMENT_METHOD_REQUIRED' USING ERRCODE='P0001',
      HINT = 'Selecione um meio de pagamento permitido pela empresa fornecedora (contrato B2B_PAYMENT_METHOD_V1).';
  END IF;
  RETURN NULL;
END $function$;
CREATE CONSTRAINT TRIGGER b2b_payment_method_required AFTER INSERT ON public.partner_orders
  DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_payment_method_required_check();

-- Escritor do VENDEDOR. Ordem: advisory -> reautorização -> linha FOR UPDATE -> plano/meio FOR SHARE -> CAS.
CREATE OR REPLACE FUNCTION public.b2b_payment_method_config_save(p_config_id uuid, p_payment_plan_id uuid, p_method_kind text, p_payment_method_id uuid,
  p_due_days integer, p_max_installments integer, p_price_monthly_rate_percent numeric, p_status text, p_expected_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; c record; v_row public.b2b_payment_method_configs;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL OR public.is_platform_superadmin(v_uid) IS NOT FALSE
     OR NOT (public.has_role(v_uid,'administrador'::public.app_role) IS TRUE OR public.has_role(v_uid,'financeiro'::public.app_role) IS TRUE)
     OR public.has_role(v_uid,'parceiro_b2b'::public.app_role) IS NOT FALSE OR public.has_role(v_uid,'parceiro_b2b_tecnico'::public.app_role) IS NOT FALSE THEN
    RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  IF p_status NOT IN ('active','revoked') OR p_expected_version IS NULL OR p_expected_version < 0 OR p_method_kind IS NULL OR p_payment_plan_id IS NULL THEN
    RAISE EXCEPTION 'payment_method_config_invalid' USING ERRCODE='22023'; END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_pmc:' || v_org::text || ':' || p_payment_plan_id::text || ':' || p_method_kind, 0));
  -- Reautoriza DEPOIS da espera (papel/perfil/empresa podem ter mudado).
  IF platform_private.h15_actor_organization() IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  IF v_org IS NULL OR public.is_platform_superadmin(v_uid) IS NOT FALSE
     OR NOT (public.has_role(v_uid,'administrador'::public.app_role) IS TRUE OR public.has_role(v_uid,'financeiro'::public.app_role) IS TRUE)
     OR public.has_role(v_uid,'parceiro_b2b'::public.app_role) IS NOT FALSE OR public.has_role(v_uid,'parceiro_b2b_tecnico'::public.app_role) IS NOT FALSE THEN
    RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  IF p_config_id IS NULL THEN
    IF p_expected_version <> 0 THEN RAISE EXCEPTION 'payment_method_config_stale' USING ERRCODE='PT409'; END IF;
    IF EXISTS (SELECT 1 FROM public.b2b_payment_method_configs x WHERE x.organization_id = v_org AND x.payment_plan_id = p_payment_plan_id AND x.method_kind = p_method_kind) THEN
      RAISE EXCEPTION 'payment_method_config_stale' USING ERRCODE='PT409'; END IF;
  ELSE
    SELECT * INTO c FROM public.b2b_payment_method_configs x WHERE x.id = p_config_id AND x.organization_id = v_org FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
    IF c.payment_plan_id IS DISTINCT FROM p_payment_plan_id OR c.method_kind IS DISTINCT FROM p_method_kind THEN
      RAISE EXCEPTION 'payment_method_config_identity_immutable' USING ERRCODE='P0001'; END IF;
    IF c.version <> p_expected_version THEN RAISE EXCEPTION 'payment_method_config_stale' USING ERRCODE='PT409'; END IF;
  END IF;
  IF p_status = 'active' THEN
    PERFORM 1 FROM public.commercial_payment_plans p WHERE p.id = p_payment_plan_id AND p.active IS TRUE AND p.superseded_by_id IS NULL FOR SHARE;
    IF NOT FOUND THEN RAISE EXCEPTION 'plan_inactive' USING ERRCODE='P0001'; END IF;
    PERFORM 1 FROM public.payment_methods pm WHERE pm.id = p_payment_method_id AND pm.active IS TRUE FOR SHARE;
    IF NOT FOUND THEN RAISE EXCEPTION 'payment_method_catalog_unavailable' USING ERRCODE='P0001'; END IF;
  END IF;
  IF p_config_id IS NULL THEN
    INSERT INTO public.b2b_payment_method_configs(organization_id, payment_plan_id, method_kind, payment_method_id, status, version, due_days,
      max_installments, price_monthly_rate_percent, created_by, updated_by)
    VALUES (v_org, p_payment_plan_id, p_method_kind, p_payment_method_id, p_status, 1, p_due_days, p_max_installments, p_price_monthly_rate_percent, v_uid, v_uid)
    RETURNING * INTO v_row;
  ELSE
    UPDATE public.b2b_payment_method_configs SET payment_method_id = p_payment_method_id, status = p_status, version = c.version + 1,
      due_days = p_due_days, max_installments = p_max_installments, price_monthly_rate_percent = p_price_monthly_rate_percent,
      updated_by = v_uid, updated_at = now()
     WHERE id = c.id RETURNING * INTO v_row;
  END IF;
  INSERT INTO public.b2b_payment_method_config_versions(config_id, version, snapshot, actor_id) VALUES (v_row.id, v_row.version, to_jsonb(v_row), v_uid);
  RETURN jsonb_build_object('contract','B2B_PAYMENT_METHOD_V1','config', to_jsonb(v_row));
END $function$;

-- Ativação por empresa: off -> pilot (parceiros listados da própria empresa) -> enforced. Só administrador; exige config ativa.
CREATE OR REPLACE FUNCTION public.b2b_payment_method_activation_set(p_mode text, p_pilot_partner_ids uuid[], p_expected_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; g record; v_row platform_private.b2b_payment_method_activation; v_ids uuid[];
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL OR public.is_platform_superadmin(v_uid) IS NOT FALSE OR public.has_role(v_uid,'administrador'::public.app_role) IS NOT TRUE
     OR public.has_role(v_uid,'parceiro_b2b'::public.app_role) IS NOT FALSE THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  IF p_mode NOT IN ('off','pilot','enforced') OR p_expected_version IS NULL OR p_expected_version < 0 THEN
    RAISE EXCEPTION 'payment_method_activation_invalid' USING ERRCODE='22023'; END IF;
  v_ids := CASE WHEN p_mode = 'pilot' THEN (SELECT COALESCE(array_agg(DISTINCT x ORDER BY x), '{}') FROM unnest(COALESCE(p_pilot_partner_ids,'{}')) x) ELSE '{}' END;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_pma:' || v_org::text, 0));
  IF platform_private.h15_actor_organization() IS DISTINCT FROM v_org OR public.has_role(v_uid,'administrador'::public.app_role) IS NOT TRUE THEN
    RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  SELECT * INTO g FROM platform_private.b2b_payment_method_activation WHERE organization_id = v_org FOR UPDATE;
  IF COALESCE(g.version, 0) <> p_expected_version THEN RAISE EXCEPTION 'payment_method_activation_stale' USING ERRCODE='PT409'; END IF;
  IF p_mode = 'pilot' AND (cardinality(v_ids) = 0 OR EXISTS (SELECT 1 FROM unnest(v_ids) x WHERE NOT EXISTS (
       SELECT 1 FROM public.partner_accounts a WHERE a.id = x AND a.commercial_owner_organization_id = v_org AND a.ativo IS TRUE))) THEN
    RAISE EXCEPTION 'payment_method_pilot_partner_invalid' USING ERRCODE='42501'; END IF;
  IF p_mode <> 'off' AND NOT EXISTS (SELECT 1 FROM public.b2b_payment_method_configs x WHERE x.organization_id = v_org AND x.status = 'active') THEN
    RAISE EXCEPTION 'payment_method_activation_requires_config' USING ERRCODE='P0001'; END IF;
  INSERT INTO platform_private.b2b_payment_method_activation(organization_id, mode, pilot_partner_ids, version, updated_by)
  VALUES (v_org, p_mode, v_ids, COALESCE(g.version, 0) + 1, v_uid)
  ON CONFLICT (organization_id) DO UPDATE SET mode = EXCLUDED.mode, pilot_partner_ids = EXCLUDED.pilot_partner_ids, version = EXCLUDED.version,
    updated_by = EXCLUDED.updated_by, updated_at = now()
  RETURNING * INTO v_row;
  INSERT INTO platform_private.b2b_payment_method_activation_history(organization_id, version, snapshot, actor_id) VALUES (v_org, v_row.version, to_jsonb(v_row), v_uid);
  RETURN jsonb_build_object('contract','B2B_PAYMENT_METHOD_V1','activation', to_jsonb(v_row) - 'updated_by');
END $function$;

CREATE OR REPLACE FUNCTION public.b2b_payment_method_config_list()
 RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL OR public.is_platform_superadmin(v_uid) IS NOT FALSE
     OR NOT (public.has_role(v_uid,'administrador'::public.app_role) IS TRUE OR public.has_role(v_uid,'financeiro'::public.app_role) IS TRUE
             OR public.has_role(v_uid,'gestor_comercial'::public.app_role) IS TRUE)
     OR public.has_role(v_uid,'parceiro_b2b'::public.app_role) IS NOT FALSE THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
  RETURN jsonb_build_object('contract','B2B_PAYMENT_METHOD_V1','organization_id', v_org,
    'can_edit', public.has_role(v_uid,'administrador'::public.app_role) IS TRUE OR public.has_role(v_uid,'financeiro'::public.app_role) IS TRUE,
    'can_activate', public.has_role(v_uid,'administrador'::public.app_role) IS TRUE,
    'activation', COALESCE((SELECT to_jsonb(g) - 'updated_by' FROM platform_private.b2b_payment_method_activation g WHERE g.organization_id = v_org),
                           jsonb_build_object('mode','off','pilot_partner_ids','[]'::jsonb,'version',0)),
    'configs', COALESCE((SELECT jsonb_agg(to_jsonb(x) - 'created_by' - 'updated_by' ORDER BY x.payment_plan_id, x.method_kind) FROM public.b2b_payment_method_configs x WHERE x.organization_id = v_org), '[]'::jsonb),
    'catalog', COALESCE((SELECT jsonb_agg(jsonb_build_object('id', pm.id, 'name', pm.name) ORDER BY pm.name) FROM public.payment_methods pm WHERE pm.active IS TRUE), '[]'::jsonb),
    'plans', COALESCE((SELECT jsonb_agg(jsonb_build_object('id', p.id, 'name', p.name, 'code', p.code, 'installment_count', p.installment_count,
               'max_days', p.max_days, 'monthly_interest_percent', p.monthly_interest_percent) ORDER BY p.name)
               FROM public.commercial_payment_plans p WHERE p.active IS TRUE AND p.superseded_by_id IS NULL), '[]'::jsonb),
    'partners', COALESCE((SELECT jsonb_agg(a.id ORDER BY a.id) FROM public.partner_accounts a WHERE a.commercial_owner_organization_id = v_org AND a.ativo IS TRUE), '[]'::jsonb));
END $function$;

-- Opções no pedido (comprador do parceiro ou ator interno do vendedor). mode=legacy: empresa não ativada (contrato atual).
CREATE OR REPLACE FUNCTION public.b2b_list_payment_method_options_secure(p_partner_id uuid, p_payment_plan_id uuid)
 RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_seller uuid; v_opts jsonb := '[]'::jsonb; c record; r jsonb; v_reason text;
BEGIN
  IF auth.uid() IS NULL OR p_payment_plan_id IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  IF public.has_role(auth.uid(),'parceiro_b2b_tecnico'::public.app_role) IS TRUE AND NOT (public.has_role(auth.uid(),'parceiro_b2b'::public.app_role) IS TRUE
     OR public.has_role(auth.uid(),'administrador'::public.app_role) IS TRUE OR public.has_role(auth.uid(),'gestor_comercial'::public.app_role) IS TRUE
     OR public.has_role(auth.uid(),'financeiro'::public.app_role) IS TRUE) THEN RAISE EXCEPTION 'forbidden_financial_terms' USING ERRCODE='42501'; END IF;
  v_seller := platform_private.b2b_payment_method_seller(p_partner_id);
  FOR c IN SELECT x.id, x.version, x.method_kind FROM public.b2b_payment_method_configs x
            WHERE x.organization_id = v_seller AND x.payment_plan_id = p_payment_plan_id AND x.status = 'active' ORDER BY x.method_kind LOOP
    BEGIN
      r := platform_private.b2b_payment_method_resolve(p_partner_id, p_payment_plan_id, c.id, c.version, false);
      v_opts := v_opts || jsonb_build_array((r - 'organization_id' - 'payment_method_id') || jsonb_build_object('available', true));
    EXCEPTION WHEN SQLSTATE 'PT409' THEN
      GET STACKED DIAGNOSTICS v_reason = MESSAGE_TEXT;
      IF v_reason IN ('payment_method_installments_incompatible','payment_method_price_interest_conflict','payment_method_due_exceeds_plan') THEN
        v_opts := v_opts || jsonb_build_array(jsonb_build_object('config_id', c.id, 'version', c.version, 'available', false, 'reason', v_reason, 'method_kind', c.method_kind));
      ELSIF v_reason IN ('payment_method_unavailable','plan_inactive') THEN NULL;
      ELSE RAISE; END IF;
    END;
  END LOOP;
  RETURN jsonb_build_object('contract','B2B_PAYMENT_METHOD_V1','partner_id', p_partner_id,'payment_plan_id', p_payment_plan_id,
    'mode', platform_private.b2b_payment_method_mode(p_partner_id), 'due_basis','nf_issue','options', v_opts);
END $function$;
CREATE OR REPLACE FUNCTION public.simulate_b2b_payment_plan_with_method_secure(p_partner_id uuid, p_payment_plan_id uuid, p_items jsonb, p_method_config_id uuid, p_method_config_version integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_is_admin boolean; v_is_finance boolean; v_is_gestor boolean;
  v_is_partner boolean; v_is_tech boolean; v_user_partner uuid;
  v_partner record; v_plan record; v_cart jsonb;
  v_table numeric(14,2); v_disc numeric(14,2); v_net numeric(14,2);
  v_interest numeric(14,2); v_final numeric(14,2);
  v_first_due date; v_installments integer;
  v_schedule jsonb := '[]'::jsonb; v_warnings jsonb := '[]'::jsonb;
  v_credit jsonb; v_inst numeric(14,2); v_accum numeric(14,2) := 0;
  v_amount_i numeric(14,2); v_principal_i numeric(14,2); v_interest_i numeric(14,2);
  v_due_i date; v_quote boolean; i integer;
  p_first_due_date date := NULL; v_pm jsonb; v_rows jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  PERFORM platform_private.c2_order_actor_scope(v_uid, p_partner_id); -- c2_ord_scope
  PERFORM platform_private.c2_owner_order_guard(v_uid, p_partner_id, p_payment_plan_id); -- c2_ord_guard

  v_is_admin   := has_role(v_uid,'administrador'::app_role);
  v_is_finance := has_role(v_uid,'financeiro'::app_role);
  v_is_gestor  := has_role(v_uid,'gestor_comercial'::app_role);
  v_is_partner := has_role(v_uid,'parceiro_b2b'::app_role);
  v_is_tech    := has_role(v_uid,'parceiro_b2b_tecnico'::app_role);
  v_user_partner := public.get_user_partner_id();

  IF has_role(v_uid,'cliente_produtor'::app_role)
     AND NOT (v_is_admin OR v_is_finance OR v_is_gestor OR v_is_partner) THEN
    RAISE EXCEPTION 'PRODUCER_DIRECT_NOT_ENABLED';
  END IF;

  -- Esta RPC e exclusivamente financeira (condicao, desconto, juros, parcelas,
  -- totais e credito). Tecnico de parceiro sem alcada interna/gestora nao pode
  -- obter nenhum desses dados: bloqueio ANTES de qualquer resolucao de preco.
  IF v_is_tech AND NOT (v_is_admin OR v_is_finance OR v_is_gestor OR v_is_partner) THEN
    RAISE EXCEPTION 'forbidden_financial_terms';
  END IF;

  IF NOT (v_is_admin OR v_is_finance OR v_is_gestor) THEN
    IF NOT (v_is_partner AND v_user_partner IS NOT NULL AND v_user_partner = p_partner_id) THEN
      RAISE EXCEPTION 'forbidden_partner';
    END IF;
  END IF;

  SELECT id, ativo INTO v_partner FROM public.partner_accounts WHERE id = p_partner_id;
  IF NOT FOUND OR v_partner.ativo = false THEN RAISE EXCEPTION 'partner_not_found'; END IF;

  SELECT * INTO v_plan FROM public.commercial_payment_plans WHERE id = p_payment_plan_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'plan_not_found'; END IF; IF NOT public.fn_b2b_plan_selectable(v_plan.id) THEN RAISE EXCEPTION 'plan_not_selectable'; END IF;
  IF v_plan.active = false THEN RAISE EXCEPTION 'plan_inactive'; END IF;
  IF v_plan.monthly_interest_percent < 0 THEN RAISE EXCEPTION 'invalid_interest_rate'; END IF;
  IF v_plan.discount_percent > 40 AND NOT v_is_admin THEN RAISE EXCEPTION 'discount_exceeds_limit'; END IF;
  v_pm := platform_private.b2b_payment_method_resolve(p_partner_id, v_plan.id, p_method_config_id, p_method_config_version, false);

  v_cart  := public.fn_resolve_b2b_cart(p_partner_id, p_payment_plan_id, p_items, current_date);
  v_quote := COALESCE((v_cart->>'quote_required')::boolean,false);
  v_table := (v_cart->>'table_amount')::numeric;
  v_disc  := (v_cart->>'discount_amount')::numeric;
  v_net   := (v_cart->>'net_amount')::numeric;

  IF v_quote THEN v_table := 0; v_disc := 0; v_net := 0; END IF;

  v_final    := CASE WHEN v_quote THEN 0
                     ELSE public.fn_b2b_apply_interest(v_net, v_plan.interest_type,
                            v_plan.monthly_interest_percent, v_plan.months_count) END;
  v_installments := (v_pm->>'installment_count')::integer;
  IF NOT v_quote THEN
    v_rows := platform_private.b2b_payment_method_schedule(v_net, v_final, v_installments, (v_pm->>'due_days')::integer,
                (v_pm->>'price_monthly_rate_percent')::numeric, current_date); -- b2bpm: UMA verdade monetária
    SELECT round(sum((r->>'amount')::numeric), 2) INTO v_final FROM jsonb_array_elements(v_rows) r;
  END IF;
  v_interest := ROUND(v_final - v_net, 2);

  IF p_first_due_date IS NOT NULL AND p_first_due_date < current_date THEN
    RAISE EXCEPTION 'invalid_due_date';
  END IF;
  v_first_due := COALESCE((v_rows->0->>'estimated_due_date')::date, current_date + (v_pm->>'due_days')::integer);
  IF v_first_due > current_date + v_plan.max_days AND NOT (v_is_admin OR v_is_finance OR v_is_gestor) THEN
    v_first_due := current_date + v_plan.max_days;
    v_warnings := v_warnings || jsonb_build_array('Data de vencimento ajustada ao limite do plano.');
  END IF;


  IF v_quote THEN
    v_warnings := v_warnings || to_jsonb('Condicao sob consulta: preco sera definido em cotacao.'::text);
  ELSE
    SELECT COALESCE(jsonb_agg(r || jsonb_build_object('due_date', r->>'estimated_due_date') ORDER BY (r->>'installment_number')::integer), '[]'::jsonb)
      INTO v_schedule FROM jsonb_array_elements(v_rows) r;
  END IF;

  IF v_plan.requires_financial_approval THEN
    v_warnings := v_warnings || to_jsonb('Plano exige aprovação financeira'::text); END IF;
  IF v_plan.requires_guarantee THEN
    v_warnings := v_warnings || to_jsonb('Plano exige garantia'::text); END IF;
  IF v_plan.requires_credit_approval THEN
    v_warnings := v_warnings || to_jsonb('Plano depende de limite de crédito'::text); END IF;
  IF NOT v_quote AND v_plan.minimum_order_amount IS NOT NULL AND v_table < v_plan.minimum_order_amount THEN
    v_warnings := v_warnings || to_jsonb('Pedido abaixo do valor mínimo para este plano'::text); END IF;

  BEGIN
    v_credit := public.fn_b2b_credit_exposure(p_partner_id, v_final, NULL);
    IF COALESCE((v_credit->>'tem_vencidos')::boolean,false) THEN
      v_warnings := v_warnings || to_jsonb('Parceiro possui saldo vencido'::text);
    END IF;
    IF COALESCE((v_credit->>'credit_limit')::numeric,0) > 0
       AND (v_credit->>'exposicao_projetada')::numeric > (v_credit->>'credit_limit')::numeric THEN
      v_warnings := v_warnings || to_jsonb('Pedido excede o limite de crédito projetado'::text);
    END IF;
  EXCEPTION WHEN OTHERS THEN v_credit := NULL; END;

  RETURN jsonb_build_object(
    'partner_id', p_partner_id,
    'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
    'quote_required', v_quote,
    'items', v_cart->'lines',
    'cart_hash', platform_private.b2b_payment_method_hash(public.fn_b2b_cart_hash(p_partner_id, p_payment_plan_id, v_cart, v_final), v_pm, v_final),
    'financial_visible', true,
    'payment_plan', jsonb_build_object(
      'id', v_plan.id, 'name', v_plan.name, 'code', v_plan.code,
      'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
      'discount_percent', v_plan.discount_percent,
      'monthly_interest_percent', v_plan.monthly_interest_percent,
      'months_count', v_plan.months_count,
      'installment_count', v_installments,
      'requires_financial_approval', v_plan.requires_financial_approval,
      'requires_credit_approval', v_plan.requires_credit_approval,
      'requires_guarantee', v_plan.requires_guarantee),
    'amounts', jsonb_build_object(
      'table_amount', v_table, 'discount_amount', v_disc,
      'net_amount_after_discount', v_net,
      'financial_interest_amount', v_interest, 'final_amount', v_final),
    'table_amount', v_table, 'discount_amount', v_disc,
    'net_amount_after_discount', v_net,
    'financial_interest_amount', v_interest, 'final_amount', v_final,
    'first_due_date', v_first_due,
    'schedule', v_schedule,
    'credit', v_credit,
    'warnings', v_warnings,
    'payment_method_contract', 'B2B_PAYMENT_METHOD_V1',
    'payment_method', (v_pm - 'organization_id' - 'payment_method_id') || jsonb_build_object('due_basis','nf_issue','schedule_estimated',true),
    'installment_count', v_installments, 'schedule_estimated', true, 'due_basis', 'nf_issue', 'estimated_reference_date', current_date);
END $function$;
CREATE OR REPLACE FUNCTION public.create_partner_order_with_method_secure(p_partner_id uuid, p_observacoes text, p_items jsonb, p_requested_delivery_date date, p_payment_plan_id uuid, p_expected_cart_hash text, p_idempotency_key text, p_method_config_id uuid, p_method_config_version integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_is_admin boolean; v_is_finance boolean; v_is_gestor boolean; v_is_internal boolean;
  v_is_partner boolean; v_is_partner_tech boolean; v_user_partner uuid;
  v_order_id uuid; v_numero text; v_plan record; v_cart jsonb; v_line jsonb;
  v_quote boolean; v_table numeric(14,2); v_disc numeric(14,2); v_net numeric(14,2);
  v_interest numeric(14,2); v_final numeric(14,2); v_hash text;
  v_installments integer; v_first_due date; v_terms_id uuid;
  v_status partner_order_status; v_fin_status text; v_approval_status text;
  v_credit jsonb; v_block_reason text := NULL;
  v_inst numeric(14,2); v_accum numeric(14,2) := 0;
  v_amount_i numeric(14,2); v_principal_i numeric(14,2); v_interest_i numeric(14,2);
  v_due_i date; v_admin record; i integer;
  v_idem text; v_prev_idem record; v_result jsonb;
  v_items_canon text; v_req_fp text;
  p_first_due_date date := NULL; p_installment_count integer := NULL; -- b2bpm: cliente não define vencimento nem parcelas
  v_pm jsonb; v_rows jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  PERFORM platform_private.c2_order_actor_scope(v_uid, p_partner_id); -- c2_ord_scope
  PERFORM platform_private.c2_owner_order_guard(v_uid, p_partner_id, p_payment_plan_id); -- c2_ord_guard
  IF p_items IS NULL OR jsonb_array_length(p_items) = 0 THEN RAISE EXCEPTION 'empty_cart'; END IF;
  IF p_payment_plan_id IS NULL THEN RAISE EXCEPTION 'payment_plan_required'; END IF;

  -- assinatura autoritativa obrigatoria para TODOS os chamadores
  IF NULLIF(btrim(COALESCE(p_expected_cart_hash,'')),'') IS NULL THEN
    RAISE EXCEPTION 'cart_hash_required';
  END IF;
  v_idem := NULLIF(btrim(COALESCE(p_idempotency_key,'')),'');
  IF v_idem IS NULL THEN RAISE EXCEPTION 'idempotency_key_required'; END IF;
  IF length(v_idem) > 120 THEN RAISE EXCEPTION 'invalid_idempotency_key'; END IF;

  -- ---------------------------------------------------------------
  -- request fingerprint canônico: reqfp_v2
  -- Cobre todos os parâmetros materialmente capazes de alterar o
  -- pedido resultante. Itens são normalizados (tipo|id|quantidade
  -- numérica canônica) e ordenados deterministicamente; textos são
  -- normalizados por btrim. cart_hash continua validado à parte.
  -- ---------------------------------------------------------------
  SELECT COALESCE(string_agg(t, ';' ORDER BY t), '')
    INTO v_items_canon
    FROM (
      SELECT lower(COALESCE(btrim(l->>'item_tipo'), '-')) || '|' ||
             lower(COALESCE(btrim(l->>'item_id'), '-'))   || '|' ||
             COALESCE(trim(to_char(COALESCE(NULLIF(btrim(l->>'quantidade'),'')::numeric, 0),
                                   'FM9999999990.000000')), '0')
             || CASE WHEN jsonb_typeof(l) = 'object' AND l ? 'packaging_id' THEN '|pk=' || lower(COALESCE(btrim(l->>'packaging_id'),'-')) ELSE '' END AS t
        FROM jsonb_array_elements(COALESCE(p_items,'[]'::jsonb)) AS l
    ) s;

  v_req_fp := encode(sha256(convert_to(
      'b2bpm_reqfp_v1'
      || '|partner='   || p_partner_id::text
      || '|plan='      || COALESCE(p_payment_plan_id::text,'-')
      || '|delivery='  || COALESCE(p_requested_delivery_date::text,'-')
      || '|firstdue='  || COALESCE(p_first_due_date::text,'-')
      || '|inst='      || COALESCE(p_installment_count::text,'-')
      || '|obs='       || COALESCE(btrim(p_observacoes),'-')
      || '|items='     || v_items_canon
      || '|pm='        || COALESCE(p_method_config_id::text,'-') || ':' || COALESCE(p_method_config_version::text,'-')
    ,'UTF8')),'hex');

  v_is_admin        := has_role(v_uid,'administrador'::app_role);
  v_is_finance      := has_role(v_uid,'financeiro'::app_role);
  v_is_gestor       := has_role(v_uid,'gestor_comercial'::app_role);
  v_is_internal     := v_is_admin OR v_is_finance OR v_is_gestor;
  v_is_partner      := has_role(v_uid,'parceiro_b2b'::app_role);
  v_is_partner_tech := has_role(v_uid,'parceiro_b2b_tecnico'::app_role);
  v_user_partner    := public.get_user_partner_id();

  IF has_role(v_uid,'cliente_produtor'::app_role) AND NOT (v_is_internal OR v_is_partner) THEN
    RAISE EXCEPTION 'PRODUCER_DIRECT_NOT_ENABLED';
  END IF;

  IF v_is_partner_tech AND NOT (v_is_internal OR v_is_partner) THEN
    RAISE EXCEPTION 'partner_tech_cannot_create_order';
  END IF;

  IF NOT v_is_internal THEN
    IF NOT v_is_partner OR v_user_partner IS NULL OR v_user_partner <> p_partner_id THEN
      RAISE EXCEPTION 'forbidden_partner';
    END IF;
  END IF;

  PERFORM 1 FROM public.partner_accounts WHERE id = p_partner_id AND ativo = true;
  IF NOT FOUND THEN RAISE EXCEPTION 'partner_not_found'; END IF;

  -- idempotencia (lock deterministico #1: parceiro+chave)
  PERFORM platform_private.c2_attempt_dispatch_guard(v_uid,p_partner_id,v_idem);
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_idem:' || p_partner_id::text || ':' || v_idem, 0));
  -- c2_attempt_closure_v2: a espera no lock pode atravessar revogações; revalida a
  -- autorização canônica APÓS o lock e antes de revelar replay ou criar (ponto de
  -- linearização = esta instrução; revogação confirmada depois dela não é observada).
  PERFORM platform_private.c2_partner_order_attempt_authz(v_uid, p_partner_id);
  IF NOT EXISTS(SELECT 1 FROM platform_private.partner_order_attempt_journal j JOIN public.profiles p ON p.user_id=j.actor_id AND p.organization_id=j.organization_id AND p.ativo WHERE j.actor_id=v_uid AND j.partner_id=p_partner_id AND j.idempotency_key=v_idem) THEN RAISE EXCEPTION 'C2DJ_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
  -- Fechamento durável sob ESTE MESMO lock: recusa envio tardio antes de qualquer efeito.
  -- (Corpos antigos em voo são cobertos pelo trigger c2_attempt_closure_guard.)
  IF EXISTS (SELECT 1 FROM platform_private.partner_order_idempotency_closures c
              WHERE c.partner_id = p_partner_id AND c.idempotency_key = v_idem) THEN
    RAISE EXCEPTION 'idempotency_key_closed';
  END IF;
  SELECT * INTO v_prev_idem FROM public.partner_order_idempotency
   WHERE partner_id = p_partner_id AND idempotency_key = v_idem;
  IF FOUND THEN
    -- linhas históricas sem fingerprint não podem ser reexecutadas em
    -- silêncio apenas com cart_hash: fail-safe, sem criar pedido.
    IF v_prev_idem.request_fingerprint IS NULL THEN
      RAISE EXCEPTION 'idempotency_legacy_unverifiable';
    END IF;
    IF v_prev_idem.cart_hash IS DISTINCT FROM p_expected_cart_hash THEN
      RAISE EXCEPTION 'idempotency_conflict';
    END IF;
    IF v_prev_idem.request_fingerprint IS DISTINCT FROM v_req_fp THEN
      RAISE EXCEPTION 'idempotency_conflict';
    END IF;
    RETURN v_prev_idem.result_snapshot;
  END IF;

  SELECT * INTO v_plan FROM public.commercial_payment_plans WHERE id = p_payment_plan_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'plan_not_found'; END IF;
  IF NOT public.fn_b2b_plan_selectable(v_plan.id) THEN RAISE EXCEPTION 'plan_not_selectable'; END IF;
  IF v_plan.active = false THEN RAISE EXCEPTION 'plan_inactive'; END IF;
  IF v_plan.monthly_interest_percent < 0 THEN RAISE EXCEPTION 'invalid_interest_rate'; END IF;
  IF v_plan.discount_percent > 40 AND NOT v_is_admin THEN RAISE EXCEPTION 'discount_exceeds_limit'; END IF;
  -- b2bpm: relido APÓS o lock de idempotência e a reautorização LIVE; trava config/plano/atribuição/meio (FOR SHARE).
  v_pm := platform_private.b2b_payment_method_resolve(p_partner_id, v_plan.id, p_method_config_id, p_method_config_version, true);

  v_credit := public.fn_b2b_credit_exposure(p_partner_id, 0, NULL);
  IF COALESCE((v_credit->>'block_if_overdue')::boolean,false)
     AND COALESCE((v_credit->>'tem_vencidos')::boolean,false) THEN
    RAISE EXCEPTION 'credit_blocked_overdue';
  END IF;

  IF NOT v_is_internal THEN
    v_installments := GREATEST(COALESCE(v_plan.installment_count,1),1);
  ELSE
    IF p_installment_count IS NOT NULL AND p_installment_count <= 0 THEN
      RAISE EXCEPTION 'invalid_installment_count';
    END IF;
    v_installments := GREATEST(COALESCE(p_installment_count, v_plan.installment_count, 1), 1);
  END IF;
  v_installments := (v_pm->>'installment_count')::integer; -- b2bpm: parcelas da configuração resolvida

  PERFORM platform_private.b2b_packaging_lock(p_items); -- b2b_pack_v1
  v_cart  := public.fn_resolve_b2b_cart(p_partner_id, p_payment_plan_id, p_items, current_date);
  v_quote := COALESCE((v_cart->>'quote_required')::boolean,false);
  v_table := (v_cart->>'table_amount')::numeric;
  v_disc  := (v_cart->>'discount_amount')::numeric;
  v_net   := (v_cart->>'net_amount')::numeric;
  v_final := CASE WHEN v_quote THEN 0
                  ELSE public.fn_b2b_apply_interest(v_net, v_plan.interest_type,
                         v_plan.monthly_interest_percent, v_plan.months_count) END;
  IF NOT v_quote THEN
    v_rows := platform_private.b2b_payment_method_schedule(v_net, v_final, v_installments, (v_pm->>'due_days')::integer,
                (v_pm->>'price_monthly_rate_percent')::numeric, current_date); -- b2bpm: UMA verdade monetária
    SELECT round(sum((r->>'amount')::numeric), 2) INTO v_final FROM jsonb_array_elements(v_rows) r;
  END IF;

  v_hash := public.fn_b2b_cart_hash(p_partner_id, p_payment_plan_id, v_cart, v_final);
  v_hash := platform_private.b2b_payment_method_hash(v_hash, v_pm, v_final); -- b2bpm: condição/meio/versão/total
  IF p_expected_cart_hash <> v_hash THEN
    RAISE EXCEPTION 'price_changed';
  END IF;

  IF v_quote THEN v_table := 0; v_disc := 0; v_net := 0; END IF;
  v_interest := ROUND(v_final - v_net, 2);

  IF NOT v_quote AND v_plan.minimum_order_amount IS NOT NULL AND v_table < v_plan.minimum_order_amount THEN
    RAISE EXCEPTION 'below_minimum_order_amount';
  END IF;

  IF p_first_due_date IS NOT NULL AND p_first_due_date < current_date THEN
    RAISE EXCEPTION 'invalid_due_date';
  END IF;
  v_first_due := COALESCE((v_rows->0->>'estimated_due_date')::date, current_date + (v_pm->>'due_days')::integer); -- b2bpm: ESTIMADA

  IF v_plan.requires_financial_approval OR v_plan.requires_guarantee THEN
    v_fin_status := 'pending'; v_approval_status := 'pending';
  ELSE
    v_fin_status := 'not_required'; v_approval_status := 'not_required';
  END IF;

  IF v_first_due > current_date + v_plan.max_days THEN
    IF NOT v_is_internal OR NOT (v_plan.requires_financial_approval OR v_plan.requires_guarantee) THEN
      v_first_due := current_date + v_plan.max_days;
    ELSE
      v_fin_status := 'pending'; v_approval_status := 'pending';
    END IF;
  END IF;

  IF v_quote THEN
    v_status := 'aguardando_cotacao'::partner_order_status;
  ELSE
    -- lock deterministico #2: credito do parceiro
    PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || p_partner_id::text, 0));
    v_credit := public.fn_b2b_credit_exposure(p_partner_id, v_final, NULL);

    IF COALESCE((v_credit->>'block_if_overdue')::boolean,false)
       AND COALESCE((v_credit->>'tem_vencidos')::boolean,false) THEN
      RAISE EXCEPTION 'credit_blocked_overdue';
    END IF;

    IF COALESCE((v_credit->>'credit_limit')::numeric,0) > 0
       AND (v_credit->>'exposicao_projetada')::numeric > (v_credit->>'credit_limit')::numeric THEN
      IF COALESCE(v_credit->>'credit_limit_action','block') = 'approval_required' THEN
        v_status := 'aguardando_aprovacao_credito'::partner_order_status;
        v_block_reason := 'limite_excedido';
      ELSE
        RAISE EXCEPTION 'credit_limit_exceeded';
      END IF;
    ELSE
      v_status := 'em_analise_comercial'::partner_order_status;
    END IF;
  END IF;

  -- b2bpm: reler autoridade do comprador/vendedor e a configuração depois das esperas de embalagem/crédito.
  PERFORM platform_private.b2b_payment_method_resolve(p_partner_id, v_plan.id, p_method_config_id, p_method_config_version, false);
  -- Issue only after canonical role/partner/plan/cart/hash/credit checks and idempotent replay.
  IF NOT v_is_internal AND platform_private.c2_owner_order_create_allowed(v_uid,p_partner_id) THEN
    PERFORM platform_private.issue_ticket('c2_external_order_create',p_partner_id);
  END IF;
  INSERT INTO public.partner_orders(
    partner_id, status, subtotal, desconto_total, total, observacoes, created_by,
    requested_delivery_date, ready_for_production, payment_plan_id, payment_condition_status,
    credit_block_reason
  ) VALUES (
    p_partner_id, v_status, 0, 0, 0, NULLIF(p_observacoes,''), v_uid,
    p_requested_delivery_date, false, p_payment_plan_id,
    CASE WHEN v_quote THEN 'quote_required' ELSE 'defined' END,
    v_block_reason
  ) RETURNING id, numero INTO v_order_id, v_numero;

  FOR v_line IN SELECT * FROM jsonb_array_elements(v_cart->'lines') LOOP
    INSERT INTO public.partner_order_items(
      order_id, product_id, microrganismo_id, quantidade, preco_unitario,
      desconto_percentual, subtotal, unidade_medida, volume_ml,
      produto_nome_snapshot, produto_codigo_snapshot,
      preco_tabela_snapshot, desconto_percentual_snapshot, preco_unitario_final_snapshot,
      pricing_mode_snapshot, price_source_snapshot, base_price_snapshot,
      condition_price_snapshot, plan_discount_percent_snapshot,
      unit_type_snapshot, volume_ml_snapshot, price_rule_id_snapshot,
      packaging_id_snapshot, packaging_codigo_snapshot, packaging_version_snapshot,
      packaging_peso_liquido_kg_snapshot, packaging_unidade_conteudo_snapshot, packaging_price_id_snapshot
    ) VALUES (
      v_order_id,
      CASE WHEN v_line->>'item_tipo'='produto' THEN (v_line->>'item_id')::uuid END,
      CASE WHEN v_line->>'item_tipo'='microrganismo' THEN (v_line->>'item_id')::uuid END,
      (v_line->>'quantidade')::numeric,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'final_unit_price')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'plan_discount_percent')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'line_final_amount')::numeric, 0) END,
      v_line->>'unidade_medida',
      NULLIF(v_line->>'volume_ml','')::numeric,
      v_line->>'nome', v_line->>'codigo',
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'base_price')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'plan_discount_percent')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'final_unit_price')::numeric, 0) END,
      v_line->>'pricing_mode', v_line->>'price_source',
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'base_price','')::numeric END,
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'condition_price','')::numeric END,
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'plan_discount_percent','')::numeric END,
      v_line->>'unidade_medida',
      NULLIF(v_line->>'volume_ml','')::numeric,
      NULLIF(v_line->>'rule_id','')::uuid,
      NULLIF(v_line->>'packaging_id','')::uuid, v_line->>'packaging_codigo', NULLIF(v_line->>'packaging_version','')::integer,
      NULLIF(v_line->>'peso_liquido_kg','')::numeric, v_line->>'unidade_conteudo', NULLIF(v_line->>'packaging_price_id','')::uuid
    );
  END LOOP;

  IF NOT v_quote THEN
    INSERT INTO public.partner_order_payment_terms(
      partner_order_id, payment_plan_id, plan_name_snapshot, plan_code_snapshot,
      discount_percent_snapshot, monthly_interest_percent_snapshot, months_count_snapshot,
      installment_count, first_due_date, interest_type_snapshot,
      table_amount, discount_amount, net_amount_after_discount,
      financial_interest_amount, final_amount, approval_status, created_by,
      pricing_mode_snapshot, credit_decision_snapshot
    ) VALUES (
      v_order_id, v_plan.id, v_plan.name, v_plan.code,
      v_plan.discount_percent, v_plan.monthly_interest_percent, v_plan.months_count,
      v_installments, v_first_due, v_plan.interest_type,
      v_table, v_disc, v_net, v_interest, v_final, v_approval_status, v_uid,
      COALESCE(v_plan.pricing_mode,'discount_from_base'), v_credit
    ) RETURNING id INTO v_terms_id;

    INSERT INTO public.partner_order_payment_schedule(
      partner_order_id, payment_terms_id, installment_number, due_date,
      amount, principal_amount, interest_amount)
    SELECT v_order_id, v_terms_id, (r->>'installment_number')::integer, (r->>'estimated_due_date')::date,
           (r->>'amount')::numeric, (r->>'principal_amount')::numeric, (r->>'interest_amount')::numeric
      FROM jsonb_array_elements(v_rows) r ORDER BY (r->>'installment_number')::integer; -- b2bpm: mesmas parcelas
  END IF;

  UPDATE public.partner_orders SET
    subtotal = v_table, desconto_total = v_disc, total = v_final,
    payment_terms_id = v_terms_id,
    table_amount = v_table, commercial_discount_amount = v_disc,
    net_amount_after_discount = v_net, financial_interest_amount = v_interest,
    final_amount_with_interest = v_final,
    requires_financial_approval = (NOT v_quote AND (v_plan.requires_financial_approval OR v_plan.requires_guarantee)),
    financial_approval_status = CASE WHEN v_quote THEN 'not_required' ELSE v_fin_status END
  WHERE id = v_order_id;

  INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
  VALUES (v_order_id, p_partner_id, v_uid, 'created_via_rpc',
          jsonb_build_object('numero', v_numero, 'total', v_final,
                             'items', jsonb_array_length(p_items),
                             'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
                             'quote_required', v_quote,
                             'cart_hash', v_hash,
                             'hash_validated', true,
                             'idempotency_key', v_idem,
                             'fingerprint_algo', 'b2bpm_reqfp_v1',
                             'credit_reason_code', v_credit->>'reason_code',
                             'requested_delivery_date', p_requested_delivery_date));

  IF NOT v_quote THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
    VALUES (v_order_id, p_partner_id, v_uid, 'payment_terms_defined',
            jsonb_build_object('payment_plan_id', v_plan.id, 'plan_code', v_plan.code,
              'table_amount', v_table, 'discount_amount', v_disc,
              'net_amount_after_discount', v_net, 'financial_interest_amount', v_interest,
              'final_amount', v_final, 'first_due_date', v_first_due,
              'installment_count', v_installments,
              'requires_financial_approval', (v_plan.requires_financial_approval OR v_plan.requires_guarantee)));
  END IF;

  IF COALESCE((v_credit->>'credit_limit')::numeric,0) <= 0 THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
    VALUES (v_order_id, p_partner_id, v_uid, 'credit_limit_not_defined',
            jsonb_build_object('reason_code', v_credit->>'reason_code',
                               'exposicao_projetada', v_credit->>'exposicao_projetada'));
  END IF;

  FOR v_admin IN
    SELECT r AS user_id FROM platform_private.c2_order_internal_recipients(p_partner_id) r -- c2_ord_recipients
  LOOP
    INSERT INTO public.notificacoes_operacionais(usuario_id, tipo, titulo, mensagem, link)
    VALUES (v_admin.user_id,
            CASE WHEN v_quote THEN 'pedido_b2b_cotacao' ELSE 'pedido_b2b_novo' END,
            CASE WHEN v_quote THEN 'Cotação B2B ' || v_numero ELSE 'Novo pedido B2B ' || v_numero END,
            CASE WHEN v_quote THEN 'Pedido sob consulta aguardando cotação comercial.'
                 ELSE 'Novo pedido B2B aguardando análise comercial. Total: R$ ' || to_char(v_final,'FM999G999G990D00') END,
            '/comercial/pedidos-b2b');
  END LOOP;

  v_result := jsonb_build_object(
    'id', v_order_id, 'numero', v_numero,
    'status', v_status::text,
    'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
    'quote_required', v_quote,
    'cart_hash', v_hash,
    'idempotency_key', v_idem,
    'subtotal', v_table, 'desconto_total', v_disc, 'total', v_final,
    'table_amount', v_table, 'discount_amount', v_disc,
    'net_amount_after_discount', v_net, 'financial_interest_amount', v_interest,
    'final_amount', v_final,
    'payment_terms_id', v_terms_id,
    'credit_reason_code', v_credit->>'reason_code',
    'credit_block_reason', v_block_reason,
    'requires_financial_approval', (NOT v_quote AND (v_plan.requires_financial_approval OR v_plan.requires_guarantee)),
    'financial_approval_status', CASE WHEN v_quote THEN 'not_required' ELSE v_fin_status END);

  INSERT INTO public.partner_order_payment_method_snapshots(partner_order_id, payment_terms_id, organization_id, partner_id,
    config_id, config_version, method_kind, payment_method_id, payment_method_name_snapshot, due_days, installment_count,
    price_monthly_rate_percent, estimated_reference_date, estimated_schedule, final_amount, cart_hash, created_by)
  VALUES (v_order_id, v_terms_id, (v_pm->>'organization_id')::uuid, p_partner_id, (v_pm->>'config_id')::uuid,
    (v_pm->>'version')::integer, v_pm->>'method_kind', (v_pm->>'payment_method_id')::uuid, v_pm->>'payment_method_name',
    (v_pm->>'due_days')::integer, v_installments, (v_pm->>'price_monthly_rate_percent')::numeric, current_date,
    COALESCE(v_rows, '[]'::jsonb), CASE WHEN v_quote THEN NULL ELSE v_final END, v_hash, v_uid);
  v_result := v_result || jsonb_build_object('payment_method_contract', 'B2B_PAYMENT_METHOD_V1',
    'payment_method', (v_pm - 'organization_id' - 'payment_method_id') || jsonb_build_object('due_basis','nf_issue','schedule_estimated',true),
    'schedule', COALESCE(v_rows, '[]'::jsonb), 'installment_count', v_installments, 'first_due_date', v_first_due);
  INSERT INTO public.partner_order_idempotency(
    partner_id, idempotency_key, cart_hash, order_id, result_snapshot, created_by, request_fingerprint)
  VALUES (p_partner_id, v_idem, p_expected_cart_hash, v_order_id, v_result, v_uid, v_req_fp);

  DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='c2_external_order_create' AND target=p_partner_id;
  RETURN v_result;
END
$function$;

CREATE OR REPLACE FUNCTION public.get_partner_order_payment_method_secure(p_order_id uuid)
 RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE s record;
BEGIN
  PERFORM public.get_partner_order_payment_terms_secure(p_order_id);  -- mesmas portas do leitor de condição instalado
  SELECT * INTO s FROM public.partner_order_payment_method_snapshots x WHERE x.partner_order_id = p_order_id;
  RETURN jsonb_build_object('contract','B2B_PAYMENT_METHOD_V1','order_id', p_order_id,'present', FOUND,
    'payment_method', CASE WHEN FOUND THEN jsonb_build_object('method_kind', s.method_kind, 'payment_method_name', s.payment_method_name_snapshot,
      'config_version', s.config_version, 'due_days', s.due_days, 'installment_count', s.installment_count, 'price_monthly_rate_percent', s.price_monthly_rate_percent,
      'due_basis', s.due_basis, 'schedule_estimated', s.schedule_estimated, 'estimated_reference_date', s.estimated_reference_date,
      'schedule', s.estimated_schedule, 'final_amount', s.final_amount) END);
END $function$;
REVOKE ALL ON FUNCTION public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) TO authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_method_config_list() FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.b2b_payment_method_config_list() TO authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_method_activation_set(text,uuid[],integer) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.b2b_payment_method_activation_set(text,uuid[],integer) TO authenticated;
REVOKE ALL ON FUNCTION public.b2b_list_payment_method_options_secure(uuid,uuid) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.b2b_list_payment_method_options_secure(uuid,uuid) TO authenticated;
REVOKE ALL ON FUNCTION public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) TO authenticated;
REVOKE ALL ON FUNCTION public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) TO authenticated;
REVOKE ALL ON FUNCTION public.get_partner_order_payment_method_secure(uuid) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.get_partner_order_payment_method_secure(uuid) TO authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_resolve(uuid,uuid,uuid,integer,boolean) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_seller(uuid) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_schedule(numeric,numeric,integer,integer,numeric,date) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_hash(text,jsonb,numeric) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_mode(uuid) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_required_check() FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.b2b_payment_method_immutable() FROM PUBLIC, anon, authenticated;
DO $$ BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> 'c34e740473afb7a365d362db854069cb' THEN RAISE EXCEPTION 'INSTALL_POST: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'INSTALL_POST: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN RAISE EXCEPTION 'INSTALL_POST: platform_private.b2b_partner_catalog_reader(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881' THEN RAISE EXCEPTION 'INSTALL_POST: platform_private.h15_actor_organization() divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'INSTALL_POST: public.get_partner_order_payment_terms_secure(uuid) divergente'; END IF;
