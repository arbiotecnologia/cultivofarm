-- 03 POST (somente leitura).
DO $$ BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> 'c34e740473afb7a365d362db854069cb' THEN RAISE EXCEPTION 'POST: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'POST: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN RAISE EXCEPTION 'POST: platform_private.b2b_partner_catalog_reader(uuid) divergente'; END IF;
  IF to_regprocedure('platform_private.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881' THEN RAISE EXCEPTION 'POST: platform_private.h15_actor_organization() divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_terms_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_terms_secure(uuid)'::regprocedure)) <> 'efb3d18c65088d7d69471fc5aa9ac859' THEN RAISE EXCEPTION 'POST: public.get_partner_order_payment_terms_secure(uuid) divergente'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='payment_methods') IS DISTINCT FROM '71f7ed4ddacf2392c9c327e64376c2be' THEN RAISE EXCEPTION 'POST: colunas de payment_methods divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='partner_order_payment_terms') IS DISTINCT FROM 'f32804287d84d6467e33757064f715fa' THEN RAISE EXCEPTION 'POST: colunas de partner_order_payment_terms divergentes'; END IF;
  IF (SELECT md5(string_agg(column_name||':'||data_type, ',' ORDER BY ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans') IS DISTINCT FROM 'fa11d3b5c4d1737c9a5e98cdece94c55' THEN RAISE EXCEPTION 'POST: colunas de commercial_payment_plans divergentes'; END IF;
  IF to_regprocedure('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure)) <> '45759f6f03ed148b407ccbc46a500276' THEN RAISE EXCEPTION 'POST: public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) divergente'; END IF;
  IF to_regprocedure('public.b2b_payment_method_config_list()') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_list()'::regprocedure)) <> '6b2267c23072a68bec19f5c9b8046f1f' THEN RAISE EXCEPTION 'POST: public.b2b_payment_method_config_list() divergente'; END IF;
  IF to_regprocedure('public.b2b_list_payment_method_options_secure(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.b2b_list_payment_method_options_secure(uuid,uuid)'::regprocedure)) <> 'd5ecaea6be5bb7fa9395cb2420fde29b' THEN RAISE EXCEPTION 'POST: public.b2b_list_payment_method_options_secure(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure)) <> '3fc7aff096ad61f23ef686589b29b133' THEN RAISE EXCEPTION 'POST: public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'::regprocedure)) <> 'c2a2878620cd4c632ff67688ea7ddc04' THEN RAISE EXCEPTION 'POST: public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_method_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_method_secure(uuid)'::regprocedure)) <> '7eb8864f421d6439fe2cc53bbd8987aa' THEN RAISE EXCEPTION 'POST: public.get_partner_order_payment_method_secure(uuid) divergente'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_method_config_list()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_payment_method_config_list()'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_payment_method_config_list()', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_payment_method_config_list()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_list_payment_method_options_secure(uuid,uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.b2b_list_payment_method_options_secure(uuid,uuid)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.b2b_list_payment_method_options_secure(uuid,uuid)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.b2b_list_payment_method_options_secure(uuid,uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.get_partner_order_payment_method_secure(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid)) THEN RAISE EXCEPTION 'POST: EXECUTE indevido em public.get_partner_order_payment_method_secure(uuid)'; END IF;
  IF NOT has_function_privilege('authenticated', 'public.get_partner_order_payment_method_secure(uuid)', 'EXECUTE') THEN RAISE EXCEPTION 'POST: authenticated sem EXECUTE em public.get_partner_order_payment_method_secure(uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_resolve(uuid,uuid,uuid,integer,boolean)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_payment_method_resolve(uuid,uuid,uuid,integer,boolean)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_estimate(numeric,integer,integer,numeric,date)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_payment_method_estimate(numeric,integer,integer,numeric,date)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_required_check()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_payment_method_required_check()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_immutable()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'POST: helper privado exposto platform_private.b2b_payment_method_immutable()'; END IF;
  IF has_table_privilege('authenticated', 'public.b2b_payment_method_configs', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.b2b_payment_method_configs', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.b2b_payment_method_configs'::regclass) THEN RAISE EXCEPTION 'POST: tabela public.b2b_payment_method_configs exposta'; END IF;
  IF has_table_privilege('authenticated', 'public.b2b_payment_method_config_versions', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.b2b_payment_method_config_versions', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.b2b_payment_method_config_versions'::regclass) THEN RAISE EXCEPTION 'POST: tabela public.b2b_payment_method_config_versions exposta'; END IF;
  IF has_table_privilege('authenticated', 'public.partner_order_payment_method_snapshots', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.partner_order_payment_method_snapshots', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.partner_order_payment_method_snapshots'::regclass) THEN RAISE EXCEPTION 'POST: tabela public.partner_order_payment_method_snapshots exposta'; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='b2b_payment_method_required' AND tgdeferrable AND tginitdeferred AND tgenabled='O') THEN RAISE EXCEPTION 'POST: trigger de exigência ausente'; END IF;
  IF (SELECT enforced FROM platform_private.b2b_payment_method_gate) IS NOT TRUE THEN RAISE EXCEPTION 'POST: gate não exigente'; END IF;
  RAISE NOTICE 'POST_OK';
END $$;
