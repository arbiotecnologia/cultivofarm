-- 04 ROLLBACK deny-only: RPCs novos passam a negar; gatilho, ativações, tabelas, snapshots e histórico PERMANECEM.
-- Empresas não ativadas seguem o contrato atual; empresas já ativadas ficam bloqueadas (nega, nunca reabre fallback).
BEGIN;
DO $$ BEGIN
  IF to_regprocedure('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure)) <> 'e57747479507e128f1441fac3a14f526' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) divergente'; END IF;
