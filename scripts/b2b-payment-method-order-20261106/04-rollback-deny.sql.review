  IF to_regprocedure('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure)) <> '7bb0a13fadd36c50ce965723ac9a56a0' THEN RAISE EXCEPTION 'ROLLBACK: public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) divergente'; END IF;
