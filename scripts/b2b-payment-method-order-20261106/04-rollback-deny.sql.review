-- 04 ROLLBACK deny-only: RPCs novos passam a negar; trigger/gate de exigência, tabelas, snapshots e histórico PERMANECEM.
-- Efeito: comprador externo não cria pedido (nem pelo contrato antigo) até nova revisão. Nunca reabre fallback.
BEGIN;
DO $$ BEGIN
  IF to_regprocedure('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure)) <> '45759f6f03ed148b407ccbc46a500276' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) divergente'; END IF;
  IF to_regprocedure('public.b2b_payment_method_config_list()') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_list()'::regprocedure)) <> '6b2267c23072a68bec19f5c9b8046f1f' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_payment_method_config_list() divergente'; END IF;
  IF to_regprocedure('public.b2b_list_payment_method_options_secure(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.b2b_list_payment_method_options_secure(uuid,uuid)'::regprocedure)) <> 'd5ecaea6be5bb7fa9395cb2420fde29b' THEN RAISE EXCEPTION 'ROLLBACK: public.b2b_list_payment_method_options_secure(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure)) <> '3fc7aff096ad61f23ef686589b29b133' THEN RAISE EXCEPTION 'ROLLBACK: public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'::regprocedure)) <> 'c2a2878620cd4c632ff67688ea7ddc04' THEN RAISE EXCEPTION 'ROLLBACK: public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_method_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_method_secure(uuid)'::regprocedure)) <> '7eb8864f421d6439fe2cc53bbd8987aa' THEN RAISE EXCEPTION 'ROLLBACK: public.get_partner_order_payment_method_secure(uuid) divergente'; END IF;
END $$;
CREATE OR REPLACE FUNCTION public.b2b_payment_method_config_save(p_config_id uuid, p_payment_plan_id uuid, p_method_kind text, p_payment_method_id uuid, p_due_days integer, p_max_installments integer, p_price_monthly_rate_percent numeric, p_status text, p_expected_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION public.b2b_payment_method_config_list()
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION public.b2b_list_payment_method_options_secure(p_partner_id uuid, p_payment_plan_id uuid)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION public.simulate_b2b_payment_plan_with_method_secure(p_partner_id uuid, p_payment_plan_id uuid, p_items jsonb, p_method_config_id uuid, p_method_config_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION public.create_partner_order_with_method_secure(p_partner_id uuid, p_observacoes text, p_items jsonb, p_requested_delivery_date date, p_payment_plan_id uuid, p_expected_cart_hash text, p_idempotency_key text, p_method_config_id uuid, p_method_config_version integer)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION public.get_partner_order_payment_method_secure(p_order_id uuid)
 RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  RAISE EXCEPTION 'b2b_payment_method_rolled_back' USING ERRCODE='42501';
END $function$;
REVOKE ALL ON FUNCTION public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.b2b_payment_method_config_list() FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.b2b_list_payment_method_options_secure(uuid,uuid) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.get_partner_order_payment_method_secure(uuid) FROM PUBLIC, anon, authenticated;
UPDATE platform_private.b2b_payment_method_gate SET enforced = true, changed_at = now();
DO $$ BEGIN
  IF to_regprocedure('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure)) <> '5fb5d830b0eac706fd2832b58c3dc937' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer) divergente'; END IF;
  IF to_regprocedure('public.b2b_payment_method_config_list()') IS NULL OR md5(pg_get_functiondef('public.b2b_payment_method_config_list()'::regprocedure)) <> '144a812e7101ccec50dfcd3da410ea09' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.b2b_payment_method_config_list() divergente'; END IF;
  IF to_regprocedure('public.b2b_list_payment_method_options_secure(uuid,uuid)') IS NULL OR md5(pg_get_functiondef('public.b2b_list_payment_method_options_secure(uuid,uuid)'::regprocedure)) <> 'f89bfea9d8748583616e2b4f187aed50' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.b2b_list_payment_method_options_secure(uuid,uuid) divergente'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure)) <> '8bc26955e341751dcc2a3d2da60f3651' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'::regprocedure)) <> '103459f3931a748e8dd00db8a53f514a' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer) divergente'; END IF;
  IF to_regprocedure('public.get_partner_order_payment_method_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_order_payment_method_secure(uuid)'::regprocedure)) <> '60e8db6a6b59e98ee82b13ec0a1685c2' THEN RAISE EXCEPTION 'ROLLBACK_POST: public.get_partner_order_payment_method_secure(uuid) divergente'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.b2b_payment_method_config_save(uuid,uuid,text,uuid,integer,integer,numeric,text,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_payment_method_config_list()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.b2b_payment_method_config_list()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.b2b_list_payment_method_options_secure(uuid,uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.b2b_list_payment_method_options_secure(uuid,uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.simulate_b2b_payment_plan_with_method_secure(uuid,uuid,jsonb,uuid,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.create_partner_order_with_method_secure(uuid,text,jsonb,date,uuid,text,text,uuid,integer)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='public.get_partner_order_payment_method_secure(uuid)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: EXECUTE indevido em public.get_partner_order_payment_method_secure(uuid)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_resolve(uuid,uuid,uuid,integer,boolean)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: helper privado exposto platform_private.b2b_payment_method_resolve(uuid,uuid,uuid,integer,boolean)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_estimate(numeric,integer,integer,numeric,date)'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: helper privado exposto platform_private.b2b_payment_method_estimate(numeric,integer,integer,numeric,date)'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_required_check()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: helper privado exposto platform_private.b2b_payment_method_required_check()'; END IF;
  IF EXISTS (SELECT 1 FROM pg_proc p, aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a WHERE p.oid='platform_private.b2b_payment_method_immutable()'::regprocedure AND a.privilege_type='EXECUTE' AND a.grantee IN (0, 'anon'::regrole::oid, 'authenticated'::regrole::oid)) THEN RAISE EXCEPTION 'ROLLBACK_POST: helper privado exposto platform_private.b2b_payment_method_immutable()'; END IF;
  IF has_table_privilege('authenticated', 'public.b2b_payment_method_configs', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.b2b_payment_method_configs', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.b2b_payment_method_configs'::regclass) THEN RAISE EXCEPTION 'ROLLBACK_POST: tabela public.b2b_payment_method_configs exposta'; END IF;
  IF has_table_privilege('authenticated', 'public.b2b_payment_method_config_versions', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.b2b_payment_method_config_versions', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.b2b_payment_method_config_versions'::regclass) THEN RAISE EXCEPTION 'ROLLBACK_POST: tabela public.b2b_payment_method_config_versions exposta'; END IF;
  IF has_table_privilege('authenticated', 'public.partner_order_payment_method_snapshots', 'SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon', 'public.partner_order_payment_method_snapshots', 'SELECT') OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.partner_order_payment_method_snapshots'::regclass) THEN RAISE EXCEPTION 'ROLLBACK_POST: tabela public.partner_order_payment_method_snapshots exposta'; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_orders'::regclass AND tgname='b2b_payment_method_required' AND tgdeferrable AND tginitdeferred AND tgenabled='O') THEN RAISE EXCEPTION 'ROLLBACK_POST: trigger de exigência ausente'; END IF;
  IF (SELECT enforced FROM platform_private.b2b_payment_method_gate) IS NOT TRUE THEN RAISE EXCEPTION 'ROLLBACK_POST: gate não exigente'; END IF;
END $$;
COMMIT;
