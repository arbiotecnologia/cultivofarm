-- READONLY PRE. project_ref swzpzcwiasxmjutrmvkm. Origem pins: captura LIVE já reproduzida em 13/14 (estágio projeção instalado). Falha fechado.
BEGIN READ ONLY;
DO $$ BEGIN
 IF to_regprocedure('public._saas_user_has_feature(uuid,text)') IS NULL OR md5(pg_get_functiondef('public._saas_user_has_feature(uuid,text)'::regprocedure))<>'501dd958e117d2df8a4d38f6bcbeed04' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public._saas_user_has_feature(uuid,text)'::regprocedure)<>'postgres' OR (SELECT coalesce(string_agg(CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type||':'||x.grantor::regrole::text||':'||CASE WHEN x.is_grantable THEN 'G' ELSE '-' END,',' ORDER BY CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type),'') FROM (SELECT * FROM pg_proc pp, aclexplode(coalesce(pp.proacl,acldefault('f',pp.proowner))) WHERE pp.oid='public._saas_user_has_feature(uuid,text)'::regprocedure) x)<>'postgres:EXECUTE:postgres:-,service_role:EXECUTE:postgres:-' THEN RAISE EXCEPTION 'REVENUE_TENANT_PRE_DEP_DRIFT: public._saas_user_has_feature(uuid,text)'; END IF;
 IF to_regprocedure('public.h15_actor_organization()') IS NULL OR md5(pg_get_functiondef('public.h15_actor_organization()'::regprocedure))<>'55edafec08bcc84a00f1526c14334a2c' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.h15_actor_organization()'::regprocedure)<>'postgres' OR (SELECT coalesce(string_agg(CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type||':'||x.grantor::regrole::text||':'||CASE WHEN x.is_grantable THEN 'G' ELSE '-' END,',' ORDER BY CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type),'') FROM (SELECT * FROM pg_proc pp, aclexplode(coalesce(pp.proacl,acldefault('f',pp.proowner))) WHERE pp.oid='public.h15_actor_organization()'::regprocedure) x)<>'authenticated:EXECUTE:postgres:-,postgres:EXECUTE:postgres:-,service_role:EXECUTE:postgres:-' THEN RAISE EXCEPTION 'REVENUE_TENANT_PRE_DEP_DRIFT: public.h15_actor_organization()'; END IF;
 IF to_regprocedure('public.is_financial_staff(uuid)') IS NULL OR md5(pg_get_functiondef('public.is_financial_staff(uuid)'::regprocedure))<>'6e8f2fa7b92ca7e039d092353b3ebfe2' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.is_financial_staff(uuid)'::regprocedure)<>'postgres' OR (SELECT coalesce(string_agg(CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type||':'||x.grantor::regrole::text||':'||CASE WHEN x.is_grantable THEN 'G' ELSE '-' END,',' ORDER BY CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type),'') FROM (SELECT * FROM pg_proc pp, aclexplode(coalesce(pp.proacl,acldefault('f',pp.proowner))) WHERE pp.oid='public.is_financial_staff(uuid)'::regprocedure) x)<>'authenticated:EXECUTE:postgres:-,postgres:EXECUTE:postgres:-,service_role:EXECUTE:postgres:-' THEN RAISE EXCEPTION 'REVENUE_TENANT_PRE_DEP_DRIFT: public.is_financial_staff(uuid)'; END IF;
 IF to_regprocedure('public.rpc_b2b_revenue_forecast_tenant_v1(uuid)') IS NOT NULL THEN RAISE EXCEPTION 'REVENUE_TENANT_PRE_TARGET_PREEXISTS'; END IF;
 IF to_regclass('platform_private.b2b_financial_forecasts') IS NULL THEN RAISE EXCEPTION 'REVENUE_TENANT_PRE_FORECAST_ABSENT'; END IF;
END $$;
ROLLBACK;
