-- READONLY POST. project_ref swzpzcwiasxmjutrmvkm.
BEGIN READ ONLY;
DO $$ BEGIN
 IF to_regprocedure('public.rpc_b2b_revenue_forecast_tenant_v1(uuid)') IS NULL OR md5(pg_get_functiondef('public.rpc_b2b_revenue_forecast_tenant_v1(uuid)'::regprocedure))<>'c49f76514411568b70768f7b1445bac0' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.rpc_b2b_revenue_forecast_tenant_v1(uuid)'::regprocedure)<>'postgres' OR (SELECT coalesce(string_agg(CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type||':'||x.grantor::regrole::text||':'||CASE WHEN x.is_grantable THEN 'G' ELSE '-' END,',' ORDER BY CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE x.grantee::regrole::text END||':'||x.privilege_type),'') FROM (SELECT * FROM pg_proc pp, aclexplode(coalesce(pp.proacl,acldefault('f',pp.proowner))) WHERE pp.oid='public.rpc_b2b_revenue_forecast_tenant_v1(uuid)'::regprocedure) x)<>'authenticated:EXECUTE:postgres:-,postgres:EXECUTE:postgres:-' THEN RAISE EXCEPTION 'REVENUE_TENANT_POST_DRIFT'; END IF;
 IF (SELECT prosecdef FROM pg_proc WHERE oid='public.rpc_b2b_revenue_forecast_tenant_v1(uuid)'::regprocedure) IS NOT TRUE OR NOT EXISTS (SELECT 1 FROM pg_proc WHERE oid='public.rpc_b2b_revenue_forecast_tenant_v1(uuid)'::regprocedure AND proconfig @> ARRAY['search_path=""']) THEN RAISE EXCEPTION 'REVENUE_TENANT_POST_DEFINER'; END IF;
END $$;
ROLLBACK;
