-- B2B_PARTNER_PACKAGING_ORDER_V1 — pedido B2B por embalagem inteira (sólidos e pedido misto). Gerado por generate.py.
-- REVISÃO: NÃO APLICAR sem 01-pre aprovado no ref swzpzcwiasxmjutrmvkm e autorização do proprietário.
-- Muda: +6 colunas de snapshot/CHECK/trigger em partner_order_items; +3 helpers privados; +1 leitor;
-- delta de fn_resolve_b2b_cart (ramo embalagem), fn_b2b_cart_hash (sufixo só para embalagem) e create_partner_order_secure
-- (fingerprint inclui packaging_id, trava FOR SHARE, grava snapshot). Simulação e cotação: corpos inalterados (pinados).
-- Não muda RLS/policies, papéis, features, gates, crédito, fiscal, recebíveis, envios nem linhas líquidas.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $pre$
BEGIN
  IF to_regprocedure('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)') IS NULL OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> '7ec41e17ca6cca8cd4ef1404a9edc936' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> '37d4f45e388ed7b38f6f397b672629ee' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)') IS NULL OR md5(pg_get_functiondef('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)'::regprocedure)) <> 'e57d3a6416910937bd02c9180dff0cf1' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.fn_resolve_b2b_cart(uuid,uuid,jsonb,date)') IS NULL OR md5(pg_get_functiondef('public.fn_resolve_b2b_cart(uuid,uuid,jsonb,date)'::regprocedure)) <> 'e8df538321d933a5ae9ef1acda4215de' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.fn_resolve_b2b_cart(uuid,uuid,jsonb,date) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.fn_b2b_cart_hash(uuid,uuid,jsonb,numeric)') IS NULL OR md5(pg_get_functiondef('public.fn_b2b_cart_hash(uuid,uuid,jsonb,numeric)'::regprocedure)) <> '26fd3c7724a40b919f240f4021176115' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.fn_b2b_cart_hash(uuid,uuid,jsonb,numeric) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.fn_resolve_commercial_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)') IS NULL OR md5(pg_get_functiondef('public.fn_resolve_commercial_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)'::regprocedure)) <> '0df0d9005d46b667db4433d3eae59e27' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.fn_resolve_commercial_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.recorte_a_legacy_solid(uuid)') IS NULL OR md5(pg_get_functiondef('public.recorte_a_legacy_solid(uuid)'::regprocedure)) <> '63f70a9eb885294aa081f4ce35d183c6' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.recorte_a_legacy_solid(uuid) divergente da captura 06/11'; END IF;
  IF to_regprocedure('platform_private.b2b_partner_catalog_reader(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.b2b_partner_catalog_reader(uuid)'::regprocedure)) <> 'bd985484b69c8fa6e63a920eff518369' THEN
    RAISE EXCEPTION 'PRE_DRIFT: platform_private.b2b_partner_catalog_reader(uuid) divergente da captura 06/11'; END IF;
  IF to_regprocedure('platform_private.solid_pack_presentation_link()') IS NULL OR md5(pg_get_functiondef('platform_private.solid_pack_presentation_link()'::regprocedure)) <> 'a912476c75a46d12b4619146e26af8b0' THEN
    RAISE EXCEPTION 'PRE_DRIFT: platform_private.solid_pack_presentation_link() divergente da captura 06/11'; END IF;
  IF to_regprocedure('platform_private.partner_order_items_catalog_tenant_guard()') IS NULL OR md5(pg_get_functiondef('platform_private.partner_order_items_catalog_tenant_guard()'::regprocedure)) <> '211a5c4db841fd3e5ce3859c6477c7ae' THEN
    RAISE EXCEPTION 'PRE_DRIFT: platform_private.partner_order_items_catalog_tenant_guard() divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.fn_b2b_guard_order_items_immutable()') IS NULL OR md5(pg_get_functiondef('public.fn_b2b_guard_order_items_immutable()'::regprocedure)) <> 'bc1c4dca3a9f5a247a3c098dcbe1c06f' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.fn_b2b_guard_order_items_immutable() divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.get_partner_catalog_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid)'::regprocedure)) <> '6b56cfb144ebc8dd947473e90e2d7768' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.get_partner_catalog_secure(uuid) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.get_partner_catalog_secure(uuid,boolean)') IS NULL OR md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid,boolean)'::regprocedure)) <> '1391adc2133b922e2dcea4b1d3e26820' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.get_partner_catalog_secure(uuid,boolean) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.get_partner_catalog_volumes_secure(uuid)') IS NULL OR md5(pg_get_functiondef('public.get_partner_catalog_volumes_secure(uuid)'::regprocedure)) <> 'efd27efca33735a9df54d5eeb2d7dfa5' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.get_partner_catalog_volumes_secure(uuid) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.solid_pack_price_set_v1(uuid,bigint,date,uuid,text)') IS NULL OR md5(pg_get_functiondef('public.solid_pack_price_set_v1(uuid,bigint,date,uuid,text)'::regprocedure)) <> '0bad25e18712c0266524230a5a464a3b' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.solid_pack_price_set_v1(uuid,bigint,date,uuid,text) divergente da captura 06/11'; END IF;
  IF to_regprocedure('public.solid_pack_offers_admin_v1(uuid)') IS NULL OR md5(pg_get_functiondef('public.solid_pack_offers_admin_v1(uuid)'::regprocedure)) <> '6c2ea4feef6100986e9fe51ed4842d9e' THEN
    RAISE EXCEPTION 'PRE_DRIFT: public.solid_pack_offers_admin_v1(uuid) divergente da captura 06/11'; END IF;
  IF (SELECT proacl::text FROM pg_proc WHERE oid = 'public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' THEN
    RAISE EXCEPTION 'PRE_DRIFT: ACL de public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text) divergente'; END IF;
  IF (SELECT proacl::text FROM pg_proc WHERE oid = 'public.fn_resolve_b2b_cart(uuid,uuid,jsonb,date)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres}' THEN
    RAISE EXCEPTION 'PRE_DRIFT: ACL de public.fn_resolve_b2b_cart(uuid,uuid,jsonb,date) divergente'; END IF;
  IF (SELECT proacl::text FROM pg_proc WHERE oid = 'public.fn_b2b_cart_hash(uuid,uuid,jsonb,numeric)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres}' THEN
    RAISE EXCEPTION 'PRE_DRIFT: ACL de public.fn_b2b_cart_hash(uuid,uuid,jsonb,numeric) divergente'; END IF;
  IF to_regprocedure('public.get_partner_packaging_offers_secure(uuid)') IS NOT NULL
     OR to_regprocedure('platform_private.b2b_packaging_line(uuid,uuid,jsonb,date)') IS NOT NULL
     OR to_regprocedure('platform_private.b2b_packaging_lock(jsonb)') IS NOT NULL
     OR to_regprocedure('platform_private.b2b_packaging_item_snapshot_guard()') IS NOT NULL
     OR EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='partner_order_items' AND column_name IN ('packaging_id_snapshot', 'packaging_codigo_snapshot', 'packaging_version_snapshot', 'packaging_peso_liquido_kg_snapshot', 'packaging_unidade_conteudo_snapshot', 'packaging_price_id_snapshot'))
     OR EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.partner_order_items'::regclass AND tgname='a001_b2b_packaging_item_snapshot') THEN
    RAISE EXCEPTION 'PRE_DRIFT: alvo B2B_PACKAGING_ORDER_V1 já existe (rerun recusado)'; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='public.partner_order_items'::regclass AND conname='partner_order_items_unidade_check'
                   AND pg_get_constraintdef(oid) LIKE '%''unidade''::text%') THEN
    RAISE EXCEPTION 'PRE_DRIFT: check de unidade_medida divergente'; END IF;
END $pre$;

CREATE FUNCTION platform_private.b2b_packaging_line(p_partner_id uuid, p_plan_id uuid, p_item jsonb, p_ref date)
RETURNS jsonb
LANGUAGE plpgsql
STABLE SECURITY DEFINER
SET search_path TO ''
AS $function$
-- B2B_PARTNER_PACKAGING_ORDER_V1: uma linha = N embalagens INTEIRAS de um produto do vendedor do parceiro.
-- Preço: catalogo_precos_embalagem vigente (fonte canônica da embalagem) do MESMO dono; o cliente nunca envia preço.
-- Peso líquido é só snapshot/frete; nunca vira quantidade vendida. Sem fallback para volume/litro/hectare.
DECLARE
  v_seller uuid; v_iid uuid; v_pid uuid; v_qty numeric; v_nome text; v_codigo text;
  v_unit text; k record; v_price_id uuid; v_base numeric(14,2); v_n integer;
  v_plan record; v_mode text; v_disc numeric(9,4); v_final numeric(14,2); v_quote boolean := false;
BEGIN
  IF p_item IS NULL OR jsonb_typeof(p_item) <> 'object' THEN RAISE EXCEPTION 'B2B_PACKAGING_LINE_INVALID' USING ERRCODE='22023'; END IF;
  IF p_item ?| ARRAY['preco','preco_unitario','preco_brl','price','unit_price','final_unit_price','base_price',
                     'subtotal','line_final_amount','line_table_amount','desconto_percentual','discount_percent','total'] THEN
    RAISE EXCEPTION 'B2B_PACKAGING_CLIENT_PRICE_FORBIDDEN' USING ERRCODE='22023'; END IF;
  IF p_item ?| ARRAY['volume_ml','volume_id','unidade_medida','area_ha','unidade_pedido'] THEN
    RAISE EXCEPTION 'B2B_PACKAGING_VOLUME_MIXED' USING ERRCODE='22023'; END IF;
  IF EXISTS (SELECT 1 FROM jsonb_object_keys(p_item) x WHERE x NOT IN ('item_id','item_tipo','packaging_id','quantidade')) THEN
    RAISE EXCEPTION 'B2B_PACKAGING_LINE_INVALID' USING ERRCODE='22023'; END IF;
  IF p_item->>'item_tipo' IS DISTINCT FROM 'produto' THEN RAISE EXCEPTION 'B2B_PACKAGING_PRODUCT_ONLY' USING ERRCODE='22023'; END IF;
  IF jsonb_typeof(p_item->'item_id') IS DISTINCT FROM 'string' OR jsonb_typeof(p_item->'packaging_id') IS DISTINCT FROM 'string'
     OR (p_item->>'item_id') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
     OR (p_item->>'packaging_id') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' THEN
    RAISE EXCEPTION 'B2B_PACKAGING_LINE_INVALID' USING ERRCODE='22023'; END IF;
  v_iid := (p_item->>'item_id')::uuid; v_pid := (p_item->>'packaging_id')::uuid;
  -- Quantidade: número JSON inteiro > 0 (limite apenas do tipo integer; nenhum limite comercial inventado).
  IF jsonb_typeof(p_item->'quantidade') IS DISTINCT FROM 'number' THEN RAISE EXCEPTION 'B2B_PACKAGING_QTY_NOT_INTEGER' USING ERRCODE='22023'; END IF;
  v_qty := (p_item->>'quantidade')::numeric;
  IF v_qty <= 0 OR v_qty <> trunc(v_qty) OR v_qty > 2147483647 THEN RAISE EXCEPTION 'B2B_PACKAGING_QTY_NOT_INTEGER' USING ERRCODE='22023'; END IF;

  SELECT pa.commercial_owner_organization_id INTO v_seller FROM public.partner_accounts pa
   WHERE pa.id = p_partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
  IF v_seller IS NULL THEN RAISE EXCEPTION 'partner_not_found' USING ERRCODE='42501'; END IF;

  SELECT pr.nome, pr.codigo INTO v_nome, v_codigo FROM public.produtos pr
   WHERE pr.id = v_iid AND pr.owner_organization_id = v_seller AND pr.ativo IS TRUE AND COALESCE(pr.b2b_enabled, true) IS TRUE;
  IF v_nome IS NULL THEN RAISE EXCEPTION 'product_unavailable' USING ERRCODE='P0001'; END IF;
  -- Publicação para ESTE parceiro: o item precisa estar no catálogo canônico do comprador (guard canônico incluso).
  IF NOT EXISTS (SELECT 1 FROM public.get_partner_catalog_secure(p_partner_id) c WHERE c.item_id = v_iid AND c.item_tipo = 'produto') THEN
    RAISE EXCEPTION 'B2B_PACKAGING_NOT_PUBLISHED' USING ERRCODE='42501'; END IF;

  SELECT pp.* INTO k FROM public.product_packagings pp WHERE pp.id = v_pid;
  IF NOT FOUND OR k.product_id IS DISTINCT FROM v_iid OR k.owner_organization_id IS DISTINCT FROM v_seller THEN
    RAISE EXCEPTION 'B2B_PACKAGING_FOREIGN' USING ERRCODE='42501'; END IF;
  IF k.ativo IS NOT TRUE OR k.valid_from > now() OR (k.valid_to IS NOT NULL AND k.valid_to <= now()) THEN
    RAISE EXCEPTION 'B2B_PACKAGING_INACTIVE' USING ERRCODE='42501'; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.catalogo_volumes cv WHERE cv.id = k.id AND cv.medida = 'embalagem' AND cv.ativo IS TRUE
                   AND cv.produto_id = v_iid AND cv.owner_organization_id = v_seller) THEN
    RAISE EXCEPTION 'B2B_PACKAGING_NOT_PUBLISHED' USING ERRCODE='42501'; END IF;
  SELECT s.unidade_conteudo INTO v_unit FROM public.product_sale_units s
   WHERE s.product_id = v_iid AND s.owner_organization_id = v_seller AND s.unidade_conteudo IN ('kg','g','ml','l');
  IF v_unit IS NULL THEN RAISE EXCEPTION 'B2B_PACKAGING_SALE_UNIT_MISSING' USING ERRCODE='42501'; END IF;

  SELECT count(*), min(c.id::text)::uuid, min(c.preco_brl) INTO v_n, v_price_id, v_base
    FROM public.catalogo_precos_embalagem c
   WHERE c.packaging_id = k.id AND c.produto_id = v_iid AND c.owner_organization_id = v_seller AND c.ativo IS TRUE
     AND c.valid_from <= p_ref AND (c.valid_until IS NULL OR c.valid_until >= p_ref);
  IF v_n IS DISTINCT FROM 1 OR v_base IS NULL OR v_base <= 0 THEN RAISE EXCEPTION 'B2B_PACKAGING_UNPRICED' USING ERRCODE='42501'; END IF;

  SELECT pl.* INTO v_plan FROM public.commercial_payment_plans pl WHERE pl.id = p_plan_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'plan_not_found' USING ERRCODE='P0001'; END IF;
  IF v_plan.active IS NOT TRUE THEN RAISE EXCEPTION 'plan_inactive' USING ERRCODE='P0001'; END IF;
  v_mode := COALESCE(v_plan.pricing_mode, 'discount_from_base');
  IF v_mode = 'quote_only' THEN
    v_quote := true; v_disc := NULL; v_final := NULL;
  ELSIF v_mode = 'discount_from_base' THEN
    -- Mesma semântica do motor canônico para o plano (desconto do plano sobre o preço-base); sem regra por item.
    v_disc := COALESCE(v_plan.discount_percent, 0);
    v_final := round(v_base * (1 - v_disc / 100.0), 2);
    IF v_final <= 0 THEN RAISE EXCEPTION 'ITEM_WITHOUT_PRICE' USING ERRCODE='P0001'; END IF;
  ELSE
    -- fixed_item_price não tem regra por embalagem no contrato atual: recusa, nunca inventa preço.
    RAISE EXCEPTION 'B2B_PACKAGING_PRICING_MODE_UNSUPPORTED' USING ERRCODE='P0001';
  END IF;

  RETURN jsonb_build_object(
    'item_id', v_iid, 'item_tipo', 'produto', 'quantidade', v_qty,
    'unidade_medida', 'unidade', 'volume_ml', NULL,
    'nome', v_nome, 'codigo', v_codigo,
    'pricing_mode', CASE WHEN v_quote THEN 'quote_only' ELSE 'discount_from_base' END,
    'price_source', CASE WHEN v_quote THEN 'quote_only' ELSE 'packaging_price' END,
    'reason_code', CASE WHEN v_quote THEN 'QUOTE_REQUIRED' ELSE 'OK' END,
    'quote_required', v_quote,
    'base_price', CASE WHEN v_quote THEN NULL ELSE v_base END,
    'condition_price', NULL,
    'plan_discount_percent', v_disc,
    'min_quantity', 0,
    'final_unit_price', v_final,
    'rule_id', NULL,
    'line_table_amount', CASE WHEN v_quote THEN 0 ELSE round(v_base * v_qty, 2) END,
    'line_final_amount', CASE WHEN v_quote THEN 0 ELSE round(v_final * v_qty, 2) END,
    'packaging_id', k.id, 'packaging_codigo', k.codigo, 'packaging_version', k.version,
    'peso_liquido_kg', k.peso_liquido_kg, 'unidade_conteudo', v_unit, 'packaging_price_id', v_price_id);
END $function$;
REVOKE ALL ON FUNCTION platform_private.b2b_packaging_line(uuid,uuid,jsonb,date) FROM PUBLIC, anon, authenticated, service_role;

CREATE FUNCTION platform_private.b2b_packaging_lock(p_items jsonb)
RETURNS void
LANGUAGE plpgsql
VOLATILE SECURITY DEFINER
SET search_path TO ''
AS $function$
-- Trava (FOR SHARE, ordem determinística por id) embalagens e preços vigentes citados no carrinho, para que
-- arquivamento/troca de preço concorrente espere o pedido ou seja vista por ele (sem mudança de estado aqui).
DECLARE v_ids uuid[];
BEGIN
  IF p_items IS NULL OR jsonb_typeof(p_items) <> 'array' THEN RETURN; END IF;
  SELECT array_agg(DISTINCT (l->>'packaging_id')::uuid ORDER BY (l->>'packaging_id')::uuid) INTO v_ids
    FROM jsonb_array_elements(p_items) l
   WHERE jsonb_typeof(l) = 'object' AND jsonb_typeof(l->'packaging_id') = 'string'
     AND (l->>'packaging_id') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$';
  IF v_ids IS NULL THEN RETURN; END IF;
  PERFORM 1 FROM public.product_packagings pp WHERE pp.id = ANY(v_ids) ORDER BY pp.id FOR SHARE;
  PERFORM 1 FROM public.catalogo_precos_embalagem c WHERE c.packaging_id = ANY(v_ids) AND c.ativo IS TRUE ORDER BY c.id FOR SHARE;
END $function$;
REVOKE ALL ON FUNCTION platform_private.b2b_packaging_lock(jsonb) FROM PUBLIC, anon, authenticated, service_role;

CREATE FUNCTION platform_private.b2b_packaging_item_snapshot_guard()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO ''
AS $function$
-- Snapshot de embalagem: no INSERT precisa casar com a embalagem/preço/unidade reais; depois é imutável
-- (cotação só pode mudar colunas de preço). Linhas legadas nunca ganham snapshot de embalagem por UPDATE.
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF NEW.packaging_id_snapshot IS NULL THEN RETURN NEW; END IF;
    IF NOT EXISTS (SELECT 1 FROM public.product_packagings k
                    JOIN public.product_sale_units s ON s.product_id = k.product_id AND s.owner_organization_id = k.owner_organization_id
                    JOIN public.catalogo_precos_embalagem c ON c.id = NEW.packaging_price_id_snapshot AND c.packaging_id = k.id
                         AND c.produto_id = k.product_id AND c.owner_organization_id = k.owner_organization_id
                   WHERE k.id = NEW.packaging_id_snapshot AND k.product_id = NEW.product_id
                     AND k.codigo = NEW.packaging_codigo_snapshot AND k.version = NEW.packaging_version_snapshot
                     AND k.peso_liquido_kg = NEW.packaging_peso_liquido_kg_snapshot
                     AND s.unidade_conteudo = NEW.packaging_unidade_conteudo_snapshot) THEN
      RAISE EXCEPTION 'B2B_PACKAGING_SNAPSHOT_MISMATCH' USING ERRCODE='42501'; END IF;
    RETURN NEW;
  END IF;
  IF (NEW.packaging_id_snapshot, NEW.packaging_codigo_snapshot, NEW.packaging_version_snapshot, NEW.packaging_peso_liquido_kg_snapshot,
      NEW.packaging_unidade_conteudo_snapshot, NEW.packaging_price_id_snapshot)
     IS DISTINCT FROM
     (OLD.packaging_id_snapshot, OLD.packaging_codigo_snapshot, OLD.packaging_version_snapshot, OLD.packaging_peso_liquido_kg_snapshot,
      OLD.packaging_unidade_conteudo_snapshot, OLD.packaging_price_id_snapshot)
     OR (OLD.packaging_id_snapshot IS NOT NULL AND (NEW.product_id, NEW.quantidade, NEW.unidade_medida, NEW.volume_ml, NEW.order_id)
          IS DISTINCT FROM (OLD.product_id, OLD.quantidade, OLD.unidade_medida, OLD.volume_ml, OLD.order_id)) THEN
    RAISE EXCEPTION 'B2B_PACKAGING_SNAPSHOT_IMMUTABLE' USING ERRCODE='42501'; END IF;
  RETURN NEW;
END $function$;
REVOKE ALL ON FUNCTION platform_private.b2b_packaging_item_snapshot_guard() FROM PUBLIC, anon, authenticated, service_role;

ALTER TABLE public.partner_order_items
  ADD COLUMN packaging_id_snapshot uuid,
  ADD COLUMN packaging_codigo_snapshot text,
  ADD COLUMN packaging_version_snapshot integer,
  ADD COLUMN packaging_peso_liquido_kg_snapshot numeric(14,3),
  ADD COLUMN packaging_unidade_conteudo_snapshot text,
  ADD COLUMN packaging_price_id_snapshot uuid;
ALTER TABLE public.partner_order_items ADD CONSTRAINT poi_packaging_snapshot_shape CHECK (
  (packaging_id_snapshot IS NULL AND packaging_codigo_snapshot IS NULL AND packaging_version_snapshot IS NULL
   AND packaging_peso_liquido_kg_snapshot IS NULL AND packaging_unidade_conteudo_snapshot IS NULL AND packaging_price_id_snapshot IS NULL)
  -- Segunda alternativa com IS NOT NULL explícito em todo operando: nenhuma comparação nula vira UNKNOWN (que o CHECK aceitaria).
  OR (packaging_id_snapshot IS NOT NULL AND product_id IS NOT NULL AND microrganismo_id IS NULL
      AND packaging_codigo_snapshot IS NOT NULL AND btrim(packaging_codigo_snapshot) <> ''
      AND packaging_version_snapshot IS NOT NULL AND packaging_version_snapshot >= 1
      AND packaging_peso_liquido_kg_snapshot IS NOT NULL AND packaging_peso_liquido_kg_snapshot > 0
      AND packaging_unidade_conteudo_snapshot IS NOT NULL AND packaging_unidade_conteudo_snapshot IN ('kg','g','ml','l')
      AND packaging_price_id_snapshot IS NOT NULL AND volume_ml IS NULL AND volume_ml_snapshot IS NULL
      AND unidade_medida IS NOT NULL AND unidade_medida = 'unidade'
      AND quantidade IS NOT NULL AND quantidade > 0 AND quantidade = trunc(quantidade)));
CREATE TRIGGER a001_b2b_packaging_item_snapshot BEFORE INSERT OR UPDATE ON public.partner_order_items
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_packaging_item_snapshot_guard();
-- trigger criado após a função
CREATE OR REPLACE FUNCTION public.fn_resolve_b2b_cart(p_partner_id uuid, p_plan_id uuid, p_items jsonb, p_ref_date date DEFAULT CURRENT_DATE)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE
 SET search_path TO 'public'
AS $function$
DECLARE
  v_item jsonb; v_iid uuid; v_itipo text; v_qty numeric(12,2);
  v_unidade text; v_volume_ml numeric(12,2);
  v_nome text; v_codigo text; v_res jsonb;
  v_lines jsonb := '[]'::jsonb;
  v_table numeric(14,2) := 0; v_net numeric(14,2) := 0;
  v_quote boolean := false;
  v_line_table numeric(14,2); v_line_final numeric(14,2);
  v_ok boolean; v_active boolean; v_b2b boolean;
  v_pk jsonb; v_pk_seen uuid[] := ARRAY[]::uuid[]; -- b2b_pack_v1
BEGIN
  IF p_items IS NULL OR jsonb_typeof(p_items) <> 'array' OR jsonb_array_length(p_items) = 0 THEN
    RAISE EXCEPTION 'empty_cart' USING ERRCODE='P0001';
  END IF;

  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    -- b2b_pack_v1: linha de embalagem inteira; nunca cai no ramo volume/litro/hectare.
    IF jsonb_typeof(v_item) = 'object' AND v_item ? 'packaging_id' THEN
      v_pk := platform_private.b2b_packaging_line(p_partner_id, p_plan_id, v_item, COALESCE(p_ref_date, current_date));
      IF (v_pk->>'packaging_id')::uuid = ANY(v_pk_seen) THEN RAISE EXCEPTION 'B2B_PACKAGING_DUPLICATE_LINE' USING ERRCODE='22023'; END IF;
      v_pk_seen := v_pk_seen || (v_pk->>'packaging_id')::uuid;
      IF (v_pk->>'quote_required')::boolean THEN v_quote := true;
      ELSE v_table := v_table + (v_pk->>'line_table_amount')::numeric; v_net := v_net + (v_pk->>'line_final_amount')::numeric; END IF;
      v_lines := v_lines || jsonb_build_array(v_pk);
      CONTINUE;
    END IF;
    v_iid     := COALESCE(NULLIF(v_item->>'item_id','')::uuid, NULLIF(v_item->>'product_id','')::uuid);
    v_itipo   := COALESCE(NULLIF(v_item->>'item_tipo',''), 'produto');
    v_qty     := COALESCE((v_item->>'quantidade')::numeric, 0);
    v_unidade := COALESCE(NULLIF(v_item->>'unidade_medida',''), 'hectare');
    v_volume_ml := NULLIF((v_item->>'volume_ml')::numeric, 0);

    IF v_iid IS NULL THEN RAISE EXCEPTION 'invalid_item' USING ERRCODE='P0001'; END IF;
    IF v_qty <= 0 THEN RAISE EXCEPTION 'invalid_qty' USING ERRCODE='P0001'; END IF;
    IF v_unidade NOT IN ('hectare','litro','dose','unidade') THEN
      RAISE EXCEPTION 'invalid_unidade_medida' USING ERRCODE='P0001'; END IF;
    IF v_unidade = 'unidade' AND COALESCE(v_volume_ml,0) <= 0 THEN
      RAISE EXCEPTION 'invalid_volume_ml' USING ERRCODE='P0001'; END IF;

    -- Recorte A: legacy cart cannot sell kg/g through liquid/hectare/dose snapshots.
    IF v_itipo = 'produto' AND public.recorte_a_legacy_solid(v_iid) THEN
      RAISE EXCEPTION 'A_SOLID_PACKAGING_FLOW_REQUIRED' USING ERRCODE='42501';
    END IF;

    IF v_itipo = 'produto' THEN
      SELECT nome, codigo, ativo, COALESCE(b2b_enabled,true) INTO v_nome, v_codigo, v_active, v_b2b
        FROM public.produtos WHERE id = v_iid;
    ELSIF v_itipo = 'microrganismo' THEN
      SELECT nome, codigo, ativo, COALESCE(b2b_enabled,false) INTO v_nome, v_codigo, v_active, v_b2b
        FROM public.microrganismos WHERE id = v_iid;
    ELSE
      RAISE EXCEPTION 'invalid_item_tipo' USING ERRCODE='P0001';
    END IF;
    IF v_nome IS NULL OR v_active IS NOT TRUE OR v_b2b IS NOT TRUE THEN
      RAISE EXCEPTION 'product_unavailable' USING ERRCODE='P0001';
    END IF;

    v_res := public.fn_resolve_commercial_price(
      'partner', p_partner_id, NULL, p_plan_id,
      CASE WHEN v_itipo='produto' THEN v_iid END,
      CASE WHEN v_itipo='microrganismo' THEN v_iid END,
      v_unidade, v_volume_ml, COALESCE(p_ref_date, current_date), v_qty);

    v_ok := COALESCE((v_res->>'ok')::boolean,false);

    IF COALESCE((v_res->>'quote_required')::boolean,false) THEN
      v_quote := true;
      v_line_table := 0; v_line_final := 0;
    ELSIF NOT v_ok THEN
      RAISE EXCEPTION '%', v_res->>'reason_code' USING ERRCODE='P0001';
    ELSE
      v_line_table := ROUND((v_res->>'base_price')::numeric * v_qty, 2);
      v_line_final := ROUND((v_res->>'final_unit_price')::numeric * v_qty, 2);
      v_table := v_table + v_line_table;
      v_net   := v_net + v_line_final;
    END IF;

    v_lines := v_lines || jsonb_build_array(jsonb_build_object(
      'item_id', v_iid, 'item_tipo', v_itipo, 'quantidade', v_qty,
      'unidade_medida', v_unidade, 'volume_ml', v_volume_ml,
      'nome', v_nome, 'codigo', v_codigo,
      'pricing_mode', v_res->>'pricing_mode',
      'price_source', v_res->>'price_source',
      'reason_code',  v_res->>'reason_code',
      'quote_required', COALESCE((v_res->>'quote_required')::boolean,false),
      'base_price', (v_res->>'base_price')::numeric,
      'condition_price', (v_res->>'condition_price')::numeric,
      'plan_discount_percent', (v_res->>'plan_discount_percent')::numeric,
      'min_quantity', (v_res->>'min_quantity')::numeric,
      'final_unit_price', (v_res->>'final_unit_price')::numeric,
      'rule_id', v_res->>'rule_id',
      'line_table_amount', v_line_table,
      'line_final_amount', v_line_final
    ));
  END LOOP;

  RETURN jsonb_build_object(
    'quote_required', v_quote,
    'table_amount', CASE WHEN v_quote THEN 0 ELSE v_table END,
    'discount_amount', CASE WHEN v_quote THEN 0 ELSE ROUND(v_table - v_net,2) END,
    'net_amount', CASE WHEN v_quote THEN 0 ELSE v_net END,
    'lines', v_lines);
END $function$;
CREATE OR REPLACE FUNCTION public.fn_b2b_cart_hash(p_partner_id uuid, p_plan_id uuid, p_cart jsonb, p_final numeric)
 RETURNS text
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO 'public'
AS $function$
  SELECT encode(sha256(convert_to(
    'v2|' || COALESCE(p_partner_id::text,'-') || '|' || COALESCE(p_plan_id::text,'-') || '|' ||
    to_char(ROUND(COALESCE(p_final,0),2),'FM9999999999990.00') || '|' ||
    COALESCE((
      SELECT string_agg(
        COALESCE(l->>'item_tipo','')      || '~' ||
        COALESCE(l->>'item_id','')        || '~' ||
        COALESCE(l->>'unidade_medida','') || '~' ||
        to_char(ROUND(COALESCE((l->>'volume_ml')::numeric,0),4),'FM9999999999990.0000') || '~' ||
        to_char(ROUND(COALESCE((l->>'quantidade')::numeric,0),4),'FM9999999999990.0000') || '~' ||
        COALESCE(l->>'pricing_mode','')   || '~' ||
        COALESCE(l->>'price_source','')   || '~' ||
        COALESCE(l->>'rule_id','')        || '~' ||
        to_char(ROUND(COALESCE((l->>'final_unit_price')::numeric,0),4),'FM9999999999990.0000') || '~' ||
        to_char(ROUND(COALESCE((l->>'line_final_amount')::numeric,0),2),'FM9999999999990.00')
        || CASE WHEN l ? 'packaging_id' THEN '~pk:' || COALESCE(l->>'packaging_id','') || ':' || COALESCE(l->>'packaging_version','')
                || ':' || COALESCE(l->>'packaging_price_id','') || ':' || COALESCE(l->>'peso_liquido_kg','') || ':' || COALESCE(l->>'unidade_conteudo','')
                ELSE '' END,
        ';' ORDER BY COALESCE(l->>'item_tipo',''),
                     COALESCE(l->>'item_id',''),
                     COALESCE(l->>'unidade_medida',''),
                     COALESCE((l->>'volume_ml')::numeric,0),
                     COALESCE((l->>'quantidade')::numeric,0),
                     COALESCE(l->>'rule_id',''),
                     COALESCE(l->>'packaging_id',''))
      FROM jsonb_array_elements(COALESCE(p_cart->'lines','[]'::jsonb)) l
    ),'') || '|' ||
    COALESCE((p_cart->>'quote_required'),'false')
  ,'UTF8')),'hex')
$function$;
CREATE OR REPLACE FUNCTION public.create_partner_order_secure(p_partner_id uuid, p_observacoes text DEFAULT NULL::text, p_items jsonb DEFAULT '[]'::jsonb, p_requested_delivery_date date DEFAULT NULL::date, p_payment_plan_id uuid DEFAULT NULL::uuid, p_first_due_date date DEFAULT NULL::date, p_installment_count integer DEFAULT NULL::integer, p_expected_cart_hash text DEFAULT NULL::text, p_idempotency_key text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_is_admin boolean; v_is_finance boolean; v_is_gestor boolean; v_is_internal boolean;
  v_is_partner boolean; v_is_partner_tech boolean; v_user_partner uuid;
  v_order_id uuid; v_numero text; v_plan record; v_cart jsonb; v_line jsonb;
  v_quote boolean; v_table numeric(14,2); v_disc numeric(14,2); v_net numeric(14,2);
  v_interest numeric(14,2); v_final numeric(14,2); v_hash text;
  v_installments integer; v_first_due date; v_terms_id uuid;
  v_status partner_order_status; v_fin_status text; v_approval_status text;
  v_credit jsonb; v_block_reason text := NULL;
  v_inst numeric(14,2); v_accum numeric(14,2) := 0;
  v_amount_i numeric(14,2); v_principal_i numeric(14,2); v_interest_i numeric(14,2);
  v_due_i date; v_admin record; i integer;
  v_idem text; v_prev_idem record; v_result jsonb;
  v_items_canon text; v_req_fp text;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  PERFORM platform_private.c2_order_actor_scope(v_uid, p_partner_id); -- c2_ord_scope
  PERFORM platform_private.c2_owner_order_guard(v_uid, p_partner_id, p_payment_plan_id); -- c2_ord_guard
  IF p_items IS NULL OR jsonb_array_length(p_items) = 0 THEN RAISE EXCEPTION 'empty_cart'; END IF;
  IF p_payment_plan_id IS NULL THEN RAISE EXCEPTION 'payment_plan_required'; END IF;

  -- assinatura autoritativa obrigatoria para TODOS os chamadores
  IF NULLIF(btrim(COALESCE(p_expected_cart_hash,'')),'') IS NULL THEN
    RAISE EXCEPTION 'cart_hash_required';
  END IF;
  v_idem := NULLIF(btrim(COALESCE(p_idempotency_key,'')),'');
  IF v_idem IS NULL THEN RAISE EXCEPTION 'idempotency_key_required'; END IF;
  IF length(v_idem) > 120 THEN RAISE EXCEPTION 'invalid_idempotency_key'; END IF;

  -- ---------------------------------------------------------------
  -- request fingerprint canônico: reqfp_v2
  -- Cobre todos os parâmetros materialmente capazes de alterar o
  -- pedido resultante. Itens são normalizados (tipo|id|quantidade
  -- numérica canônica) e ordenados deterministicamente; textos são
  -- normalizados por btrim. cart_hash continua validado à parte.
  -- ---------------------------------------------------------------
  SELECT COALESCE(string_agg(t, ';' ORDER BY t), '')
    INTO v_items_canon
    FROM (
      SELECT lower(COALESCE(btrim(l->>'item_tipo'), '-')) || '|' ||
             lower(COALESCE(btrim(l->>'item_id'), '-'))   || '|' ||
             COALESCE(trim(to_char(COALESCE(NULLIF(btrim(l->>'quantidade'),'')::numeric, 0),
                                   'FM9999999990.000000')), '0')
             || CASE WHEN jsonb_typeof(l) = 'object' AND l ? 'packaging_id' THEN '|pk=' || lower(COALESCE(btrim(l->>'packaging_id'),'-')) ELSE '' END AS t
        FROM jsonb_array_elements(COALESCE(p_items,'[]'::jsonb)) AS l
    ) s;

  v_req_fp := encode(sha256(convert_to(
      'reqfp_v2'
      || '|partner='   || p_partner_id::text
      || '|plan='      || COALESCE(p_payment_plan_id::text,'-')
      || '|delivery='  || COALESCE(p_requested_delivery_date::text,'-')
      || '|firstdue='  || COALESCE(p_first_due_date::text,'-')
      || '|inst='      || COALESCE(p_installment_count::text,'-')
      || '|obs='       || COALESCE(btrim(p_observacoes),'-')
      || '|items='     || v_items_canon
    ,'UTF8')),'hex');

  v_is_admin        := has_role(v_uid,'administrador'::app_role);
  v_is_finance      := has_role(v_uid,'financeiro'::app_role);
  v_is_gestor       := has_role(v_uid,'gestor_comercial'::app_role);
  v_is_internal     := v_is_admin OR v_is_finance OR v_is_gestor;
  v_is_partner      := has_role(v_uid,'parceiro_b2b'::app_role);
  v_is_partner_tech := has_role(v_uid,'parceiro_b2b_tecnico'::app_role);
  v_user_partner    := public.get_user_partner_id();

  IF has_role(v_uid,'cliente_produtor'::app_role) AND NOT (v_is_internal OR v_is_partner) THEN
    RAISE EXCEPTION 'PRODUCER_DIRECT_NOT_ENABLED';
  END IF;

  IF v_is_partner_tech AND NOT (v_is_internal OR v_is_partner) THEN
    RAISE EXCEPTION 'partner_tech_cannot_create_order';
  END IF;

  IF NOT v_is_internal THEN
    IF NOT v_is_partner OR v_user_partner IS NULL OR v_user_partner <> p_partner_id THEN
      RAISE EXCEPTION 'forbidden_partner';
    END IF;
  END IF;

  PERFORM 1 FROM public.partner_accounts WHERE id = p_partner_id AND ativo = true;
  IF NOT FOUND THEN RAISE EXCEPTION 'partner_not_found'; END IF;

  -- idempotencia (lock deterministico #1: parceiro+chave)
  PERFORM platform_private.c2_attempt_dispatch_guard(v_uid,p_partner_id,v_idem);
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_idem:' || p_partner_id::text || ':' || v_idem, 0));
  -- c2_attempt_closure_v2: a espera no lock pode atravessar revogações; revalida a
  -- autorização canônica APÓS o lock e antes de revelar replay ou criar (ponto de
  -- linearização = esta instrução; revogação confirmada depois dela não é observada).
  PERFORM platform_private.c2_partner_order_attempt_authz(v_uid, p_partner_id);
  IF NOT EXISTS(SELECT 1 FROM platform_private.partner_order_attempt_journal j JOIN public.profiles p ON p.user_id=j.actor_id AND p.organization_id=j.organization_id AND p.ativo WHERE j.actor_id=v_uid AND j.partner_id=p_partner_id AND j.idempotency_key=v_idem) THEN RAISE EXCEPTION 'C2DJ_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
  -- Fechamento durável sob ESTE MESMO lock: recusa envio tardio antes de qualquer efeito.
  -- (Corpos antigos em voo são cobertos pelo trigger c2_attempt_closure_guard.)
  IF EXISTS (SELECT 1 FROM platform_private.partner_order_idempotency_closures c
              WHERE c.partner_id = p_partner_id AND c.idempotency_key = v_idem) THEN
    RAISE EXCEPTION 'idempotency_key_closed';
  END IF;
  SELECT * INTO v_prev_idem FROM public.partner_order_idempotency
   WHERE partner_id = p_partner_id AND idempotency_key = v_idem;
  IF FOUND THEN
    -- linhas históricas sem fingerprint não podem ser reexecutadas em
    -- silêncio apenas com cart_hash: fail-safe, sem criar pedido.
    IF v_prev_idem.request_fingerprint IS NULL THEN
      RAISE EXCEPTION 'idempotency_legacy_unverifiable';
    END IF;
    IF v_prev_idem.cart_hash IS DISTINCT FROM p_expected_cart_hash THEN
      RAISE EXCEPTION 'idempotency_conflict';
    END IF;
    IF v_prev_idem.request_fingerprint IS DISTINCT FROM v_req_fp THEN
      RAISE EXCEPTION 'idempotency_conflict';
    END IF;
    RETURN v_prev_idem.result_snapshot;
  END IF;

  SELECT * INTO v_plan FROM public.commercial_payment_plans WHERE id = p_payment_plan_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'plan_not_found'; END IF;
  IF NOT public.fn_b2b_plan_selectable(v_plan.id) THEN RAISE EXCEPTION 'plan_not_selectable'; END IF;
  IF v_plan.active = false THEN RAISE EXCEPTION 'plan_inactive'; END IF;
  IF v_plan.monthly_interest_percent < 0 THEN RAISE EXCEPTION 'invalid_interest_rate'; END IF;
  IF v_plan.discount_percent > 40 AND NOT v_is_admin THEN RAISE EXCEPTION 'discount_exceeds_limit'; END IF;

  v_credit := public.fn_b2b_credit_exposure(p_partner_id, 0, NULL);
  IF COALESCE((v_credit->>'block_if_overdue')::boolean,false)
     AND COALESCE((v_credit->>'tem_vencidos')::boolean,false) THEN
    RAISE EXCEPTION 'credit_blocked_overdue';
  END IF;

  IF NOT v_is_internal THEN
    v_installments := GREATEST(COALESCE(v_plan.installment_count,1),1);
  ELSE
    IF p_installment_count IS NOT NULL AND p_installment_count <= 0 THEN
      RAISE EXCEPTION 'invalid_installment_count';
    END IF;
    v_installments := GREATEST(COALESCE(p_installment_count, v_plan.installment_count, 1), 1);
  END IF;

  PERFORM platform_private.b2b_packaging_lock(p_items); -- b2b_pack_v1
  v_cart  := public.fn_resolve_b2b_cart(p_partner_id, p_payment_plan_id, p_items, current_date);
  v_quote := COALESCE((v_cart->>'quote_required')::boolean,false);
  v_table := (v_cart->>'table_amount')::numeric;
  v_disc  := (v_cart->>'discount_amount')::numeric;
  v_net   := (v_cart->>'net_amount')::numeric;
  v_final := CASE WHEN v_quote THEN 0
                  ELSE public.fn_b2b_apply_interest(v_net, v_plan.interest_type,
                         v_plan.monthly_interest_percent, v_plan.months_count) END;

  v_hash := public.fn_b2b_cart_hash(p_partner_id, p_payment_plan_id, v_cart, v_final);
  IF p_expected_cart_hash <> v_hash THEN
    RAISE EXCEPTION 'price_changed';
  END IF;

  IF v_quote THEN v_table := 0; v_disc := 0; v_net := 0; END IF;
  v_interest := ROUND(v_final - v_net, 2);

  IF NOT v_quote AND v_plan.minimum_order_amount IS NOT NULL AND v_table < v_plan.minimum_order_amount THEN
    RAISE EXCEPTION 'below_minimum_order_amount';
  END IF;

  IF p_first_due_date IS NOT NULL AND p_first_due_date < current_date THEN
    RAISE EXCEPTION 'invalid_due_date';
  END IF;
  v_first_due := COALESCE(p_first_due_date, current_date + v_plan.max_days);

  IF v_plan.requires_financial_approval OR v_plan.requires_guarantee THEN
    v_fin_status := 'pending'; v_approval_status := 'pending';
  ELSE
    v_fin_status := 'not_required'; v_approval_status := 'not_required';
  END IF;

  IF v_first_due > current_date + v_plan.max_days THEN
    IF NOT v_is_internal OR NOT (v_plan.requires_financial_approval OR v_plan.requires_guarantee) THEN
      v_first_due := current_date + v_plan.max_days;
    ELSE
      v_fin_status := 'pending'; v_approval_status := 'pending';
    END IF;
  END IF;

  IF v_quote THEN
    v_status := 'aguardando_cotacao'::partner_order_status;
  ELSE
    -- lock deterministico #2: credito do parceiro
    PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || p_partner_id::text, 0));
    v_credit := public.fn_b2b_credit_exposure(p_partner_id, v_final, NULL);

    IF COALESCE((v_credit->>'block_if_overdue')::boolean,false)
       AND COALESCE((v_credit->>'tem_vencidos')::boolean,false) THEN
      RAISE EXCEPTION 'credit_blocked_overdue';
    END IF;

    IF COALESCE((v_credit->>'credit_limit')::numeric,0) > 0
       AND (v_credit->>'exposicao_projetada')::numeric > (v_credit->>'credit_limit')::numeric THEN
      IF COALESCE(v_credit->>'credit_limit_action','block') = 'approval_required' THEN
        v_status := 'aguardando_aprovacao_credito'::partner_order_status;
        v_block_reason := 'limite_excedido';
      ELSE
        RAISE EXCEPTION 'credit_limit_exceeded';
      END IF;
    ELSE
      v_status := 'em_analise_comercial'::partner_order_status;
    END IF;
  END IF;

  -- Issue only after canonical role/partner/plan/cart/hash/credit checks and idempotent replay.
  IF NOT v_is_internal AND platform_private.c2_owner_order_create_allowed(v_uid,p_partner_id) THEN
    PERFORM platform_private.issue_ticket('c2_external_order_create',p_partner_id);
  END IF;
  INSERT INTO public.partner_orders(
    partner_id, status, subtotal, desconto_total, total, observacoes, created_by,
    requested_delivery_date, ready_for_production, payment_plan_id, payment_condition_status,
    credit_block_reason
  ) VALUES (
    p_partner_id, v_status, 0, 0, 0, NULLIF(p_observacoes,''), v_uid,
    p_requested_delivery_date, false, p_payment_plan_id,
    CASE WHEN v_quote THEN 'quote_required' ELSE 'defined' END,
    v_block_reason
  ) RETURNING id, numero INTO v_order_id, v_numero;

  FOR v_line IN SELECT * FROM jsonb_array_elements(v_cart->'lines') LOOP
    INSERT INTO public.partner_order_items(
      order_id, product_id, microrganismo_id, quantidade, preco_unitario,
      desconto_percentual, subtotal, unidade_medida, volume_ml,
      produto_nome_snapshot, produto_codigo_snapshot,
      preco_tabela_snapshot, desconto_percentual_snapshot, preco_unitario_final_snapshot,
      pricing_mode_snapshot, price_source_snapshot, base_price_snapshot,
      condition_price_snapshot, plan_discount_percent_snapshot,
      unit_type_snapshot, volume_ml_snapshot, price_rule_id_snapshot,
      packaging_id_snapshot, packaging_codigo_snapshot, packaging_version_snapshot,
      packaging_peso_liquido_kg_snapshot, packaging_unidade_conteudo_snapshot, packaging_price_id_snapshot
    ) VALUES (
      v_order_id,
      CASE WHEN v_line->>'item_tipo'='produto' THEN (v_line->>'item_id')::uuid END,
      CASE WHEN v_line->>'item_tipo'='microrganismo' THEN (v_line->>'item_id')::uuid END,
      (v_line->>'quantidade')::numeric,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'final_unit_price')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'plan_discount_percent')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'line_final_amount')::numeric, 0) END,
      v_line->>'unidade_medida',
      NULLIF(v_line->>'volume_ml','')::numeric,
      v_line->>'nome', v_line->>'codigo',
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'base_price')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'plan_discount_percent')::numeric, 0) END,
      CASE WHEN v_quote THEN 0 ELSE COALESCE((v_line->>'final_unit_price')::numeric, 0) END,
      v_line->>'pricing_mode', v_line->>'price_source',
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'base_price','')::numeric END,
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'condition_price','')::numeric END,
      CASE WHEN v_quote THEN NULL ELSE NULLIF(v_line->>'plan_discount_percent','')::numeric END,
      v_line->>'unidade_medida',
      NULLIF(v_line->>'volume_ml','')::numeric,
      NULLIF(v_line->>'rule_id','')::uuid,
      NULLIF(v_line->>'packaging_id','')::uuid, v_line->>'packaging_codigo', NULLIF(v_line->>'packaging_version','')::integer,
      NULLIF(v_line->>'peso_liquido_kg','')::numeric, v_line->>'unidade_conteudo', NULLIF(v_line->>'packaging_price_id','')::uuid
    );
  END LOOP;

  IF NOT v_quote THEN
    INSERT INTO public.partner_order_payment_terms(
      partner_order_id, payment_plan_id, plan_name_snapshot, plan_code_snapshot,
      discount_percent_snapshot, monthly_interest_percent_snapshot, months_count_snapshot,
      installment_count, first_due_date, interest_type_snapshot,
      table_amount, discount_amount, net_amount_after_discount,
      financial_interest_amount, final_amount, approval_status, created_by,
      pricing_mode_snapshot, credit_decision_snapshot
    ) VALUES (
      v_order_id, v_plan.id, v_plan.name, v_plan.code,
      v_plan.discount_percent, v_plan.monthly_interest_percent, v_plan.months_count,
      v_installments, v_first_due, v_plan.interest_type,
      v_table, v_disc, v_net, v_interest, v_final, v_approval_status, v_uid,
      COALESCE(v_plan.pricing_mode,'discount_from_base'), v_credit
    ) RETURNING id INTO v_terms_id;

    IF v_installments = 1 THEN
      INSERT INTO public.partner_order_payment_schedule(
        partner_order_id, payment_terms_id, installment_number, due_date,
        amount, principal_amount, interest_amount)
      VALUES (v_order_id, v_terms_id, 1, v_first_due, v_final, v_net, v_interest);
    ELSE
      v_inst := ROUND(v_final / v_installments, 2);
      FOR i IN 1..v_installments LOOP
        IF i < v_installments THEN v_amount_i := v_inst; ELSE v_amount_i := ROUND(v_final - v_accum,2); END IF;
        v_accum := v_accum + v_amount_i;
        v_principal_i := ROUND(v_amount_i * (v_net / NULLIF(v_final,0)), 2);
        v_interest_i  := ROUND(v_amount_i - v_principal_i, 2);
        v_due_i := v_first_due + ((i-1)*30);
        INSERT INTO public.partner_order_payment_schedule(
          partner_order_id, payment_terms_id, installment_number, due_date,
          amount, principal_amount, interest_amount)
        VALUES (v_order_id, v_terms_id, i, v_due_i, v_amount_i, v_principal_i, v_interest_i);
      END LOOP;
    END IF;
  END IF;

  UPDATE public.partner_orders SET
    subtotal = v_table, desconto_total = v_disc, total = v_final,
    payment_terms_id = v_terms_id,
    table_amount = v_table, commercial_discount_amount = v_disc,
    net_amount_after_discount = v_net, financial_interest_amount = v_interest,
    final_amount_with_interest = v_final,
    requires_financial_approval = (NOT v_quote AND (v_plan.requires_financial_approval OR v_plan.requires_guarantee)),
    financial_approval_status = CASE WHEN v_quote THEN 'not_required' ELSE v_fin_status END
  WHERE id = v_order_id;

  INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
  VALUES (v_order_id, p_partner_id, v_uid, 'created_via_rpc',
          jsonb_build_object('numero', v_numero, 'total', v_final,
                             'items', jsonb_array_length(p_items),
                             'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
                             'quote_required', v_quote,
                             'cart_hash', v_hash,
                             'hash_validated', true,
                             'idempotency_key', v_idem,
                             'fingerprint_algo', 'reqfp_v2',
                             'credit_reason_code', v_credit->>'reason_code',
                             'requested_delivery_date', p_requested_delivery_date));

  IF NOT v_quote THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
    VALUES (v_order_id, p_partner_id, v_uid, 'payment_terms_defined',
            jsonb_build_object('payment_plan_id', v_plan.id, 'plan_code', v_plan.code,
              'table_amount', v_table, 'discount_amount', v_disc,
              'net_amount_after_discount', v_net, 'financial_interest_amount', v_interest,
              'final_amount', v_final, 'first_due_date', v_first_due,
              'installment_count', v_installments,
              'requires_financial_approval', (v_plan.requires_financial_approval OR v_plan.requires_guarantee)));
  END IF;

  IF COALESCE((v_credit->>'credit_limit')::numeric,0) <= 0 THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
    VALUES (v_order_id, p_partner_id, v_uid, 'credit_limit_not_defined',
            jsonb_build_object('reason_code', v_credit->>'reason_code',
                               'exposicao_projetada', v_credit->>'exposicao_projetada'));
  END IF;

  FOR v_admin IN
    SELECT r AS user_id FROM platform_private.c2_order_internal_recipients(p_partner_id) r -- c2_ord_recipients
  LOOP
    INSERT INTO public.notificacoes_operacionais(usuario_id, tipo, titulo, mensagem, link)
    VALUES (v_admin.user_id,
            CASE WHEN v_quote THEN 'pedido_b2b_cotacao' ELSE 'pedido_b2b_novo' END,
            CASE WHEN v_quote THEN 'Cotação B2B ' || v_numero ELSE 'Novo pedido B2B ' || v_numero END,
            CASE WHEN v_quote THEN 'Pedido sob consulta aguardando cotação comercial.'
                 ELSE 'Novo pedido B2B aguardando análise comercial. Total: R$ ' || to_char(v_final,'FM999G999G990D00') END,
            '/comercial/pedidos-b2b');
  END LOOP;

  v_result := jsonb_build_object(
    'id', v_order_id, 'numero', v_numero,
    'status', v_status::text,
    'pricing_mode', COALESCE(v_plan.pricing_mode,'discount_from_base'),
    'quote_required', v_quote,
    'cart_hash', v_hash,
    'idempotency_key', v_idem,
    'subtotal', v_table, 'desconto_total', v_disc, 'total', v_final,
    'table_amount', v_table, 'discount_amount', v_disc,
    'net_amount_after_discount', v_net, 'financial_interest_amount', v_interest,
    'final_amount', v_final,
    'payment_terms_id', v_terms_id,
    'credit_reason_code', v_credit->>'reason_code',
    'credit_block_reason', v_block_reason,
    'requires_financial_approval', (NOT v_quote AND (v_plan.requires_financial_approval OR v_plan.requires_guarantee)),
    'financial_approval_status', CASE WHEN v_quote THEN 'not_required' ELSE v_fin_status END);

  INSERT INTO public.partner_order_idempotency(
    partner_id, idempotency_key, cart_hash, order_id, result_snapshot, created_by, request_fingerprint)
  VALUES (p_partner_id, v_idem, p_expected_cart_hash, v_order_id, v_result, v_uid, v_req_fp);

  DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='c2_external_order_create' AND target=p_partner_id;
  RETURN v_result;
END
$function$;

CREATE FUNCTION public.get_partner_packaging_offers_secure(p_partner_id uuid)
RETURNS jsonb
LANGUAGE plpgsql
STABLE SECURITY DEFINER
SET search_path TO ''
AS $function$
-- Leitor do comprador: embalagens inteiras ativas, publicadas e com preço vigente do vendedor do parceiro.
-- Mesmo guard canônico do catálogo; preco_tabela_brl é só exibição — o pedido é sempre recalculado no servidor.
DECLARE v_seller uuid; v_offers jsonb;
BEGIN
  v_seller := platform_private.b2b_partner_catalog_reader(p_partner_id);
  IF v_seller IS NULL THEN RAISE EXCEPTION 'partner_not_found' USING ERRCODE='42501'; END IF;
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
           'product_id', k.product_id, 'unidade_conteudo', s.unidade_conteudo,
           'packaging_id', k.id, 'codigo', k.codigo, 'descricao', k.descricao, 'rotulo', cv.rotulo,
           'peso_liquido_kg', k.peso_liquido_kg, 'version', k.version, 'preco_tabela_brl', c.preco_brl)
         ORDER BY k.product_id, k.peso_liquido_kg, k.codigo, k.id), '[]'::jsonb)
    INTO v_offers
    FROM public.product_packagings k
    JOIN (SELECT DISTINCT g.item_id FROM public.get_partner_catalog_secure(p_partner_id) g WHERE g.item_tipo = 'produto') g ON g.item_id = k.product_id
    JOIN public.produtos pr ON pr.id = k.product_id AND pr.owner_organization_id = v_seller AND pr.ativo IS TRUE AND COALESCE(pr.b2b_enabled, true) IS TRUE
    JOIN public.product_sale_units s ON s.product_id = k.product_id AND s.owner_organization_id = v_seller AND s.unidade_conteudo IN ('kg','g','ml','l')
    JOIN public.catalogo_volumes cv ON cv.id = k.id AND cv.medida = 'embalagem' AND cv.ativo IS TRUE AND cv.produto_id = k.product_id AND cv.owner_organization_id = v_seller
    JOIN LATERAL (SELECT min(c.preco_brl) AS preco_brl, count(*) AS n FROM public.catalogo_precos_embalagem c
                   WHERE c.packaging_id = k.id AND c.produto_id = k.product_id AND c.owner_organization_id = v_seller AND c.ativo IS TRUE
                     AND c.valid_from <= current_date AND (c.valid_until IS NULL OR c.valid_until >= current_date)) c ON c.n = 1
   WHERE k.owner_organization_id = v_seller AND k.ativo IS TRUE AND k.valid_from <= now() AND (k.valid_to IS NULL OR k.valid_to > now());
  RETURN jsonb_build_object('contract', 'B2B_PARTNER_PACKAGING_ORDER_V1', 'partner_id', p_partner_id, 'offers', v_offers);
END $function$;
REVOKE ALL ON FUNCTION public.get_partner_packaging_offers_secure(uuid) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.get_partner_packaging_offers_secure(uuid) TO authenticated;
COMMIT;
