  IF md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid,boolean)'::regprocedure)) <> '1391adc2133b922e2dcea4b1d3e26820' THEN RAISE EXCEPTION 'POST_FAIL: public.get_partner_catalog_secure(uuid,boolean) alterada'; END IF;
