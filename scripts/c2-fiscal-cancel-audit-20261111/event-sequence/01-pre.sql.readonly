BEGIN READ ONLY;
DO $guard$ BEGIN IF (SELECT jsonb_build_object('md5',md5(pg_get_functiondef(p.oid)),'owner',pg_get_userbyid(p.proowner),'acl',(SELECT coalesce(jsonb_agg(x::text ORDER BY x::text),'[]'::jsonb) FROM unnest(p.proacl)x),'config',to_jsonb(p.proconfig),'secdef',p.prosecdef) FROM pg_proc p WHERE oid=to_regprocedure('public.rpc_fiscal_event_sefaz_prepare_v1(uuid,text,text,text,uuid)')) IS DISTINCT FROM '{"acl":["postgres=X/postgres","service_role=X/postgres"],"md5":"9af2e91f3dbea476bffb4328fa288b2f","owner":"postgres","config":["search_path=public, pg_temp"],"secdef":true}'::jsonb THEN RAISE EXCEPTION 'EVENT_PRE_DRIFT'; END IF; END $guard$;
ROLLBACK;
