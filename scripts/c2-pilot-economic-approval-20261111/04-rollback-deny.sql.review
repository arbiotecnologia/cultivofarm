-- ROLLBACK deny-only: fecha gate, revoga allowlist e EXECUTE das RPCs novas; preserva ledger, previsões, eventos e a barreira.
BEGIN;
SET LOCAL lock_timeout='3s';
DO $$BEGIN IF current_setting('c2pilot.expected_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_REF_UNPROVEN';END IF;END$$;
DO $$BEGIN
 IF to_regprocedure('platform_private.c2_pilot_econ_immutable_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_immutable_v1()'::regprocedure)) IS DISTINCT FROM 'b97e592e1b820be6edce6e85f35a78ac' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_immutable_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_forecast_insert_barrier_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure)) IS DISTINCT FROM '7064ddc0a6c7dae3efedf8558254ccca' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:platform_private.c2_pilot_forecast_insert_barrier_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_evidence_v1(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure)) IS DISTINCT FROM '64c7dbffed240f40170f79eb7f62ce8d' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_evidence_v1(uuid)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_actor_v1(text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure)) IS DISTINCT FROM 'd323852c7135c75a8edee28bc53ddc6f' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_actor_v1(text)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM '8d1dca245f3b4d416f1458f1172327c8' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM 'b08c17be53381782a446c5a2fbd12505' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_state_v1(uuid)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_state_v1(uuid)'::regprocedure)) IS DISTINCT FROM 'd8ad1d4d5e7e74a660d0db49b7b24cba' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_CANDIDATE_DRIFT:public.c2_pilot_economic_state_v1(uuid)';END IF;
END$$;
UPDATE platform_private.c2_pilot_econ_gate_v1 SET enabled=false,updated_at=now(),reason='ROLLBACK_DENY' WHERE singleton;
UPDATE platform_private.c2_pilot_econ_allowlist_v1 SET revoked_at=greatest(now(),valid_from),revoke_reason='ROLLBACK_DENY' WHERE revoked_at IS NULL;
REVOKE ALL ON FUNCTION public.c2_pilot_economic_approve_v1(uuid,text,text,text,text) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION public.c2_pilot_economic_state_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text) FROM PUBLIC,anon,authenticated,service_role;
DO $$BEGIN
 IF to_regprocedure('platform_private.c2_pilot_econ_immutable_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_immutable_v1()'::regprocedure)) IS DISTINCT FROM 'b97e592e1b820be6edce6e85f35a78ac' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_immutable_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_forecast_insert_barrier_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure)) IS DISTINCT FROM '7064ddc0a6c7dae3efedf8558254ccca' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:platform_private.c2_pilot_forecast_insert_barrier_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_evidence_v1(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure)) IS DISTINCT FROM '64c7dbffed240f40170f79eb7f62ce8d' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_evidence_v1(uuid)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_actor_v1(text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure)) IS DISTINCT FROM 'd323852c7135c75a8edee28bc53ddc6f' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_actor_v1(text)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM '8d1dca245f3b4d416f1458f1172327c8' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM 'b08c17be53381782a446c5a2fbd12505' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_state_v1(uuid)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_state_v1(uuid)'::regprocedure)) IS DISTINCT FROM 'd8ad1d4d5e7e74a660d0db49b7b24cba' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_CANDIDATE_DRIFT:public.c2_pilot_economic_state_v1(uuid)';END IF;
END$$;
DO $$BEGIN
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='public.c2_pilot_economic_state_v1(uuid)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='public.c2_pilot_economic_state_v1(uuid)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:public.c2_pilot_economic_state_v1(uuid)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_immutable_v1()'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_immutable_v1()'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:platform_private.c2_pilot_econ_immutable_v1()';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:platform_private.c2_pilot_forecast_insert_barrier_v1()';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:platform_private.c2_pilot_econ_evidence_v1(uuid)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_ACL_DRIFT:platform_private.c2_pilot_econ_actor_v1(text)';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_gate_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_gate_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_gate_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_gate_v1';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_allowlist_v1';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_approvals_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_approvals_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_approvals_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_approvals_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_gate_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_gate_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_gate_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_gate_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_allowlist_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_allowlist_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_allowlist_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_allowlist_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_approvals_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_approvals_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_approvals_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_approvals_v1';END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='platform_private.b2b_financial_forecasts'::regclass AND tgname='c2_pilot_forecast_insert_barrier' AND tgenabled='O') THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_BARRIER_MISSING';END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='platform_private.c2_pilot_econ_approvals_v1'::regclass AND tgname='c2_pilot_econ_approvals_no_change' AND tgenabled='O') THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_POST_IMMUTABLE_MISSING';END IF;
END$$;
DO $$BEGIN IF (SELECT enabled FROM platform_private.c2_pilot_econ_gate_v1) IS NOT FALSE OR EXISTS(SELECT 1 FROM platform_private.c2_pilot_econ_allowlist_v1 WHERE revoked_at IS NULL) THEN RAISE EXCEPTION 'C2PILOT_ROLLBACK_NOT_CLOSED';END IF;END$$;
SELECT 'C2PILOT_ROLLBACK_PASS';
COMMIT;
