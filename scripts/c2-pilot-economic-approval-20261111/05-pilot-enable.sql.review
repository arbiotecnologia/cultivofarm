-- HABILITAÇÃO DO PILOTO (separada da conferência). Requer settings explícitos (não interpolação):
--  SET c2pilot.expected_ref='swzpzcwiasxmjutrmvkm'; SET c2pilot.order_id='<uuid completo>'; SET c2pilot.commercial_actor='<uuid>';
--  SET c2pilot.credit_actor='<uuid>'; SET c2pilot.hours='4'; SET c2pilot.reason='<motivo>';
-- Falha fechada se o pedido não for C2 pendente contábil com evidência completa, ator sem perfil competente/ativo no tenant, ou pacote divergente.
BEGIN;
SET LOCAL lock_timeout='3s';
DO $$BEGIN IF current_setting('c2pilot.expected_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_REF_UNPROVEN';END IF;END$$;
DO $$BEGIN
 IF to_regprocedure('platform_private.c2_pilot_econ_immutable_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_immutable_v1()'::regprocedure)) IS DISTINCT FROM 'b97e592e1b820be6edce6e85f35a78ac' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_immutable_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_forecast_insert_barrier_v1()') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure)) IS DISTINCT FROM '7064ddc0a6c7dae3efedf8558254ccca' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:platform_private.c2_pilot_forecast_insert_barrier_v1()';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_evidence_v1(uuid)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure)) IS DISTINCT FROM '2259e1159c3645b7aae58df06e656fa9' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_evidence_v1(uuid)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_actor_v1(text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure)) IS DISTINCT FROM 'd323852c7135c75a8edee28bc53ddc6f' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_actor_v1(text)';END IF;
 IF to_regprocedure('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM '63f096b7e6e5c5dc944b378c1d97650a' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure)) IS DISTINCT FROM 'b08c17be53381782a446c5a2fbd12505' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)';END IF;
 IF to_regprocedure('public.c2_pilot_economic_state_v1(uuid)') IS NULL OR md5(pg_get_functiondef('public.c2_pilot_economic_state_v1(uuid)'::regprocedure)) IS DISTINCT FROM 'd87e12d2cdef8b9619677cfc3935bbc0' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CANDIDATE_DRIFT:public.c2_pilot_economic_state_v1(uuid)';END IF;
END$$;
DO $$BEGIN
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)'::regprocedure) IS DISTINCT FROM 'authenticated:EXECUTE:false,postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:public.c2_pilot_economic_approve_v1(uuid,text,text,text,text)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='public.c2_pilot_economic_state_v1(uuid)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='public.c2_pilot_economic_state_v1(uuid)'::regprocedure) IS DISTINCT FROM 'authenticated:EXECUTE:false,postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:public.c2_pilot_economic_state_v1(uuid)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)'::regprocedure) IS DISTINCT FROM 'authenticated:EXECUTE:false,postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:platform_private.c2_pilot_econ_approve_core_v1(uuid,text,text,text,text)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_immutable_v1()'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_immutable_v1()'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:platform_private.c2_pilot_econ_immutable_v1()';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_forecast_insert_barrier_v1()'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:platform_private.c2_pilot_forecast_insert_barrier_v1()';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_evidence_v1(uuid)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:platform_private.c2_pilot_econ_evidence_v1(uuid)';END IF;
 IF (SELECT coalesce(string_agg(x.grantee::regrole::text||':'||x.privilege_type||':'||x.is_grantable::text,',' ORDER BY x.grantee::regrole::text,x.privilege_type),'') FROM pg_proc p,aclexplode(coalesce(p.proacl,acldefault('f',p.proowner)))x WHERE p.oid='platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure AND x.grantee<>0)||'|'||(SELECT proowner::regrole::text FROM pg_proc WHERE oid='platform_private.c2_pilot_econ_actor_v1(text)'::regprocedure) IS DISTINCT FROM 'postgres:EXECUTE:false|postgres' THEN RAISE EXCEPTION 'C2PILOT_ENABLE_ACL_DRIFT:platform_private.c2_pilot_econ_actor_v1(text)';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_gate_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_gate_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_gate_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_gate_v1';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_allowlist_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_allowlist_v1';END IF;
 IF EXISTS(SELECT 1 FROM pg_class c,aclexplode(coalesce(c.relacl,acldefault('r',c.relowner)))x WHERE c.oid='platform_private.c2_pilot_econ_approvals_v1'::regclass AND x.grantee<>c.relowner) OR (SELECT relowner::regrole::text FROM pg_class WHERE oid='platform_private.c2_pilot_econ_approvals_v1'::regclass)<>'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='platform_private.c2_pilot_econ_approvals_v1'::regclass) THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_SET_DRIFT:platform_private.c2_pilot_econ_approvals_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_gate_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_gate_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_gate_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_gate_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_allowlist_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_allowlist_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_allowlist_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_allowlist_v1';END IF;
 IF has_table_privilege('authenticated','platform_private.c2_pilot_econ_approvals_v1','SELECT,INSERT,UPDATE,DELETE') OR has_table_privilege('anon','platform_private.c2_pilot_econ_approvals_v1','SELECT') OR has_table_privilege('service_role','platform_private.c2_pilot_econ_approvals_v1','SELECT,INSERT,UPDATE,DELETE') THEN RAISE EXCEPTION 'C2PILOT_ENABLE_TABLE_ACL_DRIFT:platform_private.c2_pilot_econ_approvals_v1';END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='platform_private.b2b_financial_forecasts'::regclass AND tgname='c2_pilot_forecast_insert_barrier' AND tgenabled='O') THEN RAISE EXCEPTION 'C2PILOT_ENABLE_BARRIER_MISSING';END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='platform_private.c2_pilot_econ_approvals_v1'::regclass AND tgname='c2_pilot_econ_approvals_no_change' AND tgenabled='O') THEN RAISE EXCEPTION 'C2PILOT_ENABLE_IMMUTABLE_MISSING';END IF;
END$$;
DO $$DECLARE o uuid:=nullif(current_setting('c2pilot.order_id',true),'')::uuid;ca uuid:=nullif(current_setting('c2pilot.commercial_actor',true),'')::uuid;
 ka uuid:=nullif(current_setting('c2pilot.credit_actor',true),'')::uuid;h integer:=nullif(current_setting('c2pilot.hours',true),'')::integer;rs text:=current_setting('c2pilot.reason',true);
 po public.partner_orders;org uuid;ev jsonb;
BEGIN
 IF o IS NULL OR ca IS NULL OR ka IS NULL OR h IS NULL OR h NOT BETWEEN 1 AND 24 OR coalesce(length(btrim(rs)),0)<5 THEN RAISE EXCEPTION 'C2PILOT_ENABLE_PARAMS_REQUIRED';END IF;
 SELECT * INTO po FROM public.partner_orders WHERE id=o FOR UPDATE;
 SELECT pa.commercial_owner_organization_id INTO org FROM public.partner_accounts pa WHERE pa.id=po.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
 IF org IS NULL THEN RAISE EXCEPTION 'C2PILOT_ENABLE_SCOPE';END IF;
 ev:=platform_private.c2_pilot_econ_evidence_v1(o);
 IF NOT EXISTS(SELECT 1 FROM public.profiles p WHERE p.user_id=ca AND p.ativo AND p.organization_id=org) OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=ca AND role IN ('administrador','gestor_comercial'))
  OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=ca AND role IN ('vendedor','parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor')) THEN RAISE EXCEPTION 'C2PILOT_ENABLE_COMMERCIAL_ACTOR_INVALID';END IF;
 IF NOT EXISTS(SELECT 1 FROM public.profiles p WHERE p.user_id=ka AND p.ativo AND p.organization_id=org) OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=ka AND role IN ('administrador','financeiro'))
  OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=ka AND role IN ('vendedor','parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor')) THEN RAISE EXCEPTION 'C2PILOT_ENABLE_CREDIT_ACTOR_INVALID';END IF;
 INSERT INTO platform_private.c2_pilot_econ_allowlist_v1(order_id,organization_id,partner_id,actor_id,kind,valid_until,reason)
 VALUES(o,org,po.partner_id,ca,'commercial',now()+make_interval(hours=>h),rs),(o,org,po.partner_id,ka,'credit',now()+make_interval(hours=>h),rs);
 UPDATE platform_private.c2_pilot_econ_gate_v1 SET enabled=true,updated_at=now(),reason='PILOT_ENABLED:'||rs WHERE singleton;
 RAISE NOTICE 'C2PILOT_ENABLE_EVIDENCE_HASH %',ev->>'evidence_hash';
END$$;
SELECT 'C2PILOT_ENABLE_PASS';
COMMIT;
