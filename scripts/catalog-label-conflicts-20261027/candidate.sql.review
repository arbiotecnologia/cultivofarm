CREATE OR REPLACE FUNCTION public.platform_update_catalog_label(p_id uuid, p_expected_updated_at timestamp with time zone, p_rotulo_exibicao text, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.catalog_family_labels%ROWTYPE; v_np public.catalog_family_labels%ROWTYPE;
  v_exib text := pg_catalog.btrim(COALESCE(p_rotulo_exibicao, ''));
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
     OR pg_catalog.char_length(v_exib) < 2 OR pg_catalog.char_length(v_exib) > 80
     OR p_idempotency_key IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id', p_id, 'expected_updated_at', p_expected_updated_at,
    'rotulo_exibicao', v_exib, 'reason', pg_catalog.btrim(COALESCE(p_reason, '')));
  v_replay := platform_private.catalog_entity_replay(v_actor, 'update_catalog_label', v_req, p_reason, p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  SELECT * INTO v_op FROM public.catalog_family_labels WHERE id = p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'catalog_label_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE = 'PT409', MESSAGE = 'catalog_label_conflict'; END IF;
  IF v_op.rotulo_exibicao IS NOT DISTINCT FROM v_exib THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_no_change'; END IF;

  UPDATE public.catalog_family_labels SET rotulo_exibicao = v_exib
   WHERE id = p_id AND updated_at = p_expected_updated_at
  RETURNING * INTO v_np;
  IF NOT FOUND OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR v_np.rotulo IS DISTINCT FROM v_op.rotulo OR v_np.familia IS DISTINCT FROM v_op.familia
     OR v_np.ativo IS DISTINCT FROM v_op.ativo THEN
    RAISE EXCEPTION USING ERRCODE = 'PT409', MESSAGE = 'catalog_label_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id', p_id, 'familia', v_np.familia, 'rotulo', v_np.rotulo,
    'rotulo_exibicao', v_exib, 'updated_at', v_np.updated_at, 'idempotency_key', p_idempotency_key,
    'audit_id', v_audit, 'idempotent', false);
  PERFORM platform_private.catalog_entity_audit(v_actor, 'update_catalog_label', p_reason, p_idempotency_key,
    v_req, v_receipt,
    pg_catalog.jsonb_build_object('id', p_id, 'rotulo_exibicao', v_op.rotulo_exibicao, 'updated_at', v_op.updated_at),
    pg_catalog.jsonb_build_object('id', p_id, 'rotulo_exibicao', v_exib, 'updated_at', v_np.updated_at));
  RETURN v_receipt;
END $function$;
CREATE OR REPLACE FUNCTION public.platform_set_catalog_label_active(p_id uuid, p_expected_updated_at timestamp with time zone, p_ativo boolean, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.catalog_family_labels%ROWTYPE; v_np public.catalog_family_labels%ROWTYPE;
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
     OR p_ativo IS NULL OR p_idempotency_key IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id', p_id, 'expected_updated_at', p_expected_updated_at,
    'ativo', p_ativo, 'reason', pg_catalog.btrim(COALESCE(p_reason, '')));
  v_replay := platform_private.catalog_entity_replay(v_actor, 'set_catalog_label_active', v_req, p_reason, p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  -- FOR UPDATE serializa com catalog_family_label_check (FOR KEY SHARE): ver comentário lá.
  SELECT * INTO v_op FROM public.catalog_family_labels WHERE id = p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'catalog_label_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE = 'PT409', MESSAGE = 'catalog_label_conflict'; END IF;
  IF v_op.ativo IS NOT DISTINCT FROM p_ativo THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_no_change'; END IF;

  -- Inativação NÃO altera atribuições existentes em produtos; o trigger de
  -- validação só barra NOVAS atribuições de rótulo inativo.
  UPDATE public.catalog_family_labels SET ativo = p_ativo
   WHERE id = p_id AND updated_at = p_expected_updated_at
  RETURNING * INTO v_np;
  IF NOT FOUND OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR v_np.rotulo IS DISTINCT FROM v_op.rotulo OR v_np.familia IS DISTINCT FROM v_op.familia
     OR v_np.rotulo_exibicao IS DISTINCT FROM v_op.rotulo_exibicao THEN
    RAISE EXCEPTION USING ERRCODE = 'PT409', MESSAGE = 'catalog_label_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id', p_id, 'familia', v_np.familia, 'rotulo', v_np.rotulo,
    'ativo', p_ativo, 'updated_at', v_np.updated_at, 'idempotency_key', p_idempotency_key,
    'audit_id', v_audit, 'idempotent', false);
  PERFORM platform_private.catalog_entity_audit(v_actor, 'set_catalog_label_active', p_reason, p_idempotency_key,
    v_req, v_receipt,
    pg_catalog.jsonb_build_object('id', p_id, 'ativo', v_op.ativo, 'updated_at', v_op.updated_at),
    pg_catalog.jsonb_build_object('id', p_id, 'ativo', p_ativo, 'updated_at', v_np.updated_at));
  RETURN v_receipt;
END $function$;
DO $guard$ BEGIN
IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.platform_update_catalog_label(uuid,timestamp with time zone,text,text,uuid)') AND oid=120766 AND md5(pg_get_functiondef(oid))='fdf3adc335996bc4ff90f7a57b8f4370' AND pg_get_userbyid(proowner)='postgres' AND proacl::text IS NOT DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}' AND to_jsonb(proconfig) IS NOT DISTINCT FROM '["search_path=\"\""]'::jsonb AND prosecdef=true) THEN RAISE EXCEPTION 'TARGET_DRIFT: %','platform_update_catalog_label(uuid,timestamp with time zone,text,text,uuid)'; END IF;
