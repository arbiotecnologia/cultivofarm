-- =============================================================================
-- CANDIDATA REVISÁVEL v2 — cadastro canônico de rótulos por família (21/10/2026)
-- NÃO APLICADA. Destino único: ref swzpzcwiasxmjutrmvkm, confirmado por operador
-- aprovado. Transacional, fail-closed. Único DML: semente dos 7 rótulos atuais.
-- Não altera preços, composição, fabricação, RLS de produtos, papéis ou sessões.
-- v2 (revisão independente): lock consistente na validação (FOR KEY SHARE),
-- revalidação mutante APÓS o replay de idempotência, guard de baseline com
-- definição/ACL/owner exatos e RPC de leitura para leitores autorizados.
-- =============================================================================
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '120s';

-- ------------------------------------------------------------- guardas de drift
DO $$
DECLARE
  v_md5 text; v_acl text; v_owner text; v_check text;
BEGIN
  IF to_regclass('public.catalog_family_labels') IS NOT NULL THEN
    RAISE EXCEPTION 'catalog_labels_already_installed';
  END IF;
  IF to_regprocedure('platform_private.catalog_metadata_require_actor()') IS NULL
     OR to_regprocedure('platform_private.catalog_entity_replay(uuid,text,jsonb,text,uuid)') IS NULL
     OR to_regprocedure('platform_private.catalog_entity_audit(uuid,text,text,uuid,jsonb,jsonb,jsonb,jsonb)') IS NULL THEN
    RAISE EXCEPTION 'catalog_labels_prerequisite_missing';
  END IF;
  -- Função substituída: definição (md5), ACL e owner EXATOS do baseline revisado,
  -- não apenas presença. Qualquer drift aborta a migration.
  SELECT pg_catalog.md5(pg_catalog.pg_get_functiondef(p.oid)), p.proacl::text, r.rolname
    INTO v_md5, v_acl, v_owner
  FROM pg_catalog.pg_proc p
  JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
  JOIN pg_catalog.pg_roles r ON r.oid = p.proowner
  WHERE n.nspname = 'platform_private' AND p.proname = 'set_global_product_family_core'
    AND p.oid = 'platform_private.set_global_product_family_core(uuid,timestamp with time zone,text,text,text,uuid)'::pg_catalog.regprocedure;
  IF v_md5 IS DISTINCT FROM '8bd3ce69c5bd55b678246acb9d264548'
     OR v_acl IS DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres}'
     OR v_owner IS DISTINCT FROM 'postgres' THEN
    RAISE EXCEPTION 'catalog_labels_core_baseline_drift';
  END IF;
  -- CHECK literal a remover: definição EXATA do baseline revisado.
  SELECT pg_catalog.md5(pg_catalog.pg_get_constraintdef(c.oid)) INTO v_check
  FROM pg_catalog.pg_constraint c
  WHERE c.conrelid = 'public.produtos'::pg_catalog.regclass
    AND c.conname = 'produtos_classe_catalogo_coerente_check';
  IF v_check IS DISTINCT FROM '0ae66545cef182ce716ee3958ef634b6' THEN
    RAISE EXCEPTION 'catalog_labels_check_baseline_drift';
  END IF;
END $$;

-- ------------------------------------------------------------- tabela canônica
CREATE TABLE public.catalog_family_labels (
  id uuid NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
  familia text NOT NULL,
  rotulo text NOT NULL,
  rotulo_exibicao text NOT NULL,
  ativo boolean NOT NULL DEFAULT true,
  created_by uuid,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT catalog_family_labels_familia_check
    CHECK (familia IN ('biologico','quimico','fertilizante_adubo')),
  CONSTRAINT catalog_family_labels_rotulo_format
    CHECK (rotulo ~ '^[a-z0-9][a-z0-9_]{1,39}$'),
  CONSTRAINT catalog_family_labels_exibicao_len
    CHECK (char_length(btrim(rotulo_exibicao)) BETWEEN 2 AND 80),
  CONSTRAINT catalog_family_labels_familia_rotulo_key UNIQUE (familia, rotulo)
);
COMMENT ON TABLE public.catalog_family_labels IS
  'Fonte canônica única de rótulos por família do catálogo global. Escrita somente via RPCs platform_* (Platform Superadmin). Nunca classificar por nome/tipo/composição.';
COMMENT ON COLUMN public.catalog_family_labels.rotulo IS
  'Chave imutável do rótulo; preserva atribuições e histórico.';
COMMENT ON COLUMN public.catalog_family_labels.ativo IS
  'Inativo preserva atribuições existentes; novas atribuições exigem rótulo ativo da família correta.';

REVOKE ALL ON public.catalog_family_labels FROM PUBLIC, anon, authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.catalog_family_labels TO service_role;
ALTER TABLE public.catalog_family_labels ENABLE ROW LEVEL SECURITY;
-- Sem policies: acesso direto negado a todos; leitura/escrita somente via RPCs DEFINER abaixo.

-- Semente mínima: SOMENTE os rótulos já existentes. Nenhuma taxonomia inventada;
-- fertilizante_adubo começa sem rótulos e passa a admitir cadastro autorizado.
INSERT INTO public.catalog_family_labels (familia, rotulo, rotulo_exibicao) VALUES
  ('biologico','biofungicida','Biofungicida'),
  ('biologico','bioinseticida','Bioinseticida'),
  ('biologico','inoculante','Inoculante'),
  ('biologico','solubilizador','Solubilizador'),
  ('quimico','fungicida','Fungicida'),
  ('quimico','inseticida','Inseticida'),
  ('quimico','herbicida','Herbicida');

-- ------------------------------------------------------------- updated_at
CREATE FUNCTION platform_private.catalog_family_labels_touch() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path = '' AS $$
BEGIN
  NEW.updated_at := pg_catalog.now();
  RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.catalog_family_labels_touch() FROM PUBLIC, anon, authenticated, service_role;
CREATE TRIGGER catalog_family_labels_touch BEFORE UPDATE ON public.catalog_family_labels
  FOR EACH ROW EXECUTE FUNCTION platform_private.catalog_family_labels_touch();

-- ------------------------------------------------------------- checagem com lock consistente
-- FOR KEY SHARE serializa com platform_set_catalog_label_active (FOR UPDATE na mesma
-- linha): uma atribuição concorrente ou conclui antes da inativação (e vale), ou espera
-- a inativação e falha. Sem esse lock, o EXISTS poderia ver ativo=true e a inativação
-- commitar em seguida, deixando atribuição nova de rótulo inativo.
-- VOLATILE é obrigatório: SELECT FOR KEY SHARE não é permitido em função STABLE.
CREATE FUNCTION platform_private.catalog_family_label_check(p_familia text, p_rotulo text) RETURNS boolean
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_ativo boolean;
BEGIN
  SELECT l.ativo INTO v_ativo
    FROM public.catalog_family_labels l
   WHERE l.familia = p_familia AND l.rotulo = p_rotulo
   FOR KEY SHARE;
  RETURN COALESCE(v_ativo, false);
END $$;
REVOKE ALL ON FUNCTION platform_private.catalog_family_label_check(text,text) FROM PUBLIC, anon, authenticated, service_role;

-- ------------------------------------------------------------- validação dinâmica em produtos
-- Substitui o CHECK literal. Valida SOMENTE atribuição nova/alterada: rótulo
-- legado/inativo já atribuído permanece enquanto a atribuição não mudar.
CREATE FUNCTION platform_private.catalog_family_label_validate() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
BEGIN
  IF NEW.classe_catalogo IS NULL THEN RETURN NEW; END IF;
  IF TG_OP = 'UPDATE'
     AND NEW.classe_catalogo IS NOT DISTINCT FROM OLD.classe_catalogo
     AND NEW.familia_catalogo IS NOT DISTINCT FROM OLD.familia_catalogo THEN
    RETURN NEW;
  END IF;
  IF NEW.familia_catalogo IS NULL
     OR NOT platform_private.catalog_family_label_check(NEW.familia_catalogo, NEW.classe_catalogo) THEN
    RAISE EXCEPTION USING ERRCODE = '23514', MESSAGE = 'catalog_label_not_active';
  END IF;
  RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.catalog_family_label_validate() FROM PUBLIC, anon, authenticated, service_role;
CREATE TRIGGER produtos_catalog_family_label_validate
  BEFORE INSERT OR UPDATE OF familia_catalogo, classe_catalogo ON public.produtos
  FOR EACH ROW EXECUTE FUNCTION platform_private.catalog_family_label_validate();
ALTER TABLE public.produtos DROP CONSTRAINT produtos_classe_catalogo_coerente_check;

-- ------------------------------------------------------------- core de classificação
-- CREATE OR REPLACE preserva assinatura/OID/ACL. Mudanças funcionais vs. baseline:
--  1) a validação do rótulo consulta a fonte canônica (com lock) em vez da lista literal;
--  2) a revalidação mutante (rótulo ativo) foi movida para DEPOIS do replay de
--     idempotência: um retry legítimo (mesma chave, mesmo fingerprint) retorna o recibo
--     original mesmo se o rótulo foi inativado depois — a inativação não pode rejeitar
--     um recibo já emitido. Validações de FORMA (família, fingerprint da requisição)
--     permanecem ANTES do replay, pois integram a identidade da operação.
-- Demais regras (ator, CAS, auditoria, imutabilidade de preços/composição/volumes)
-- permanecem byte-equivalentes ao original.
CREATE OR REPLACE FUNCTION platform_private.set_global_product_family_core(p_id uuid, p_expected_updated_at timestamptz,
  p_familia text, p_classe text, p_reason text, p_idempotency_key uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.produtos%ROWTYPE; v_np public.produtos%ROWTYPE; v_old jsonb; v_new jsonb;
  v_vols_before jsonb; v_vols_after jsonb; v_classe text := NULLIF(pg_catalog.btrim(COALESCE(p_classe,'')), '');
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) OR p_idempotency_key IS NULL
     OR p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo') THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,
    'familia_catalogo',p_familia,'classe_catalogo',v_classe,'reason',pg_catalog.btrim(COALESCE(p_reason,'')));
  v_replay := platform_private.catalog_entity_replay(v_actor,'set_global_product_family',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  -- Revalidação mutante APÓS o replay: só nova execução exige rótulo ativo (com lock).
  IF NOT (v_classe IS NULL OR platform_private.catalog_family_label_check(p_familia, v_classe)) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_invalid';
  END IF;

  SELECT * INTO v_op FROM public.produtos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_family_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_conflict'; END IF;
  IF v_op.familia_catalogo IS NOT DISTINCT FROM p_familia AND v_op.classe_catalogo IS NOT DISTINCT FROM v_classe THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_no_change'; END IF;
  v_old := pg_catalog.to_jsonb(v_op);
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_before
    FROM public.catalogo_volumes cv WHERE cv.produto_id=p_id;

  UPDATE public.produtos SET familia_catalogo=p_familia, classe_catalogo=v_classe
   WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_np;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_confirmation_failed'; END IF;
  v_new := pg_catalog.to_jsonb(v_np);
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_after
    FROM public.catalogo_volumes cv WHERE cv.produto_id=p_id;
  -- Somente família/classe/versão mudam (ativo, B2B, preços, dose, tipo, código, owner intactos).
  IF v_np.familia_catalogo IS DISTINCT FROM p_familia OR v_np.classe_catalogo IS DISTINCT FROM v_classe
     OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR (v_old - ARRAY['familia_catalogo','classe_catalogo','updated_at']) IS DISTINCT FROM (v_new - ARRAY['familia_catalogo','classe_catalogo','updated_at'])
     OR v_vols_before IS DISTINCT FROM v_vols_after THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',p_familia,'classe_catalogo',v_classe,
    'updated_at',v_np.updated_at,'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'set_global_product_family',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',v_op.familia_catalogo,'classe_catalogo',v_op.classe_catalogo,'updated_at',v_op.updated_at),
    pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',p_familia,'classe_catalogo',v_classe,'updated_at',v_np.updated_at));
  RETURN v_receipt;
END;
$$;

-- ------------------------------------------------------------- leitura canônica (gate Platform Superadmin)
CREATE FUNCTION public.platform_list_catalog_labels(p_familia text) RETURNS jsonb
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_result jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo') THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_family_invalid';
  END IF;
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'id', l.id, 'familia', l.familia, 'rotulo', l.rotulo, 'rotulo_exibicao', l.rotulo_exibicao,
      'ativo', l.ativo, 'updated_at', l.updated_at)
    ORDER BY pg_catalog.lower(l.rotulo_exibicao) COLLATE "C", l.id), '[]'::jsonb)
  INTO v_result
  FROM public.catalog_family_labels l
  WHERE l.familia = p_familia;
  RETURN v_result;
END $$;
REVOKE ALL ON FUNCTION public.platform_list_catalog_labels(text) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.platform_list_catalog_labels(text) TO authenticated, service_role;

-- ------------------------------------------------------------- leitura de exibição (leitores autorizados)
-- Taxonomia de EXIBIÇÃO para qualquer usuário autenticado com perfil ativo (técnico B2B,
-- tenant, admin): somente rótulos ATIVOS, sem id/updated_at/auditoria. Não expõe a RPC
-- administrativa nem concede consulta direta à tabela (que permanece sem grants).
CREATE FUNCTION public.catalog_family_labels_read(p_familia text) RETURNS jsonb
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_uid uuid := auth.uid(); v_result jsonb;
BEGIN
  IF v_uid IS NULL OR NOT EXISTS (SELECT 1 FROM public.profiles p WHERE p.user_id = v_uid AND p.ativo = true) THEN
    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'catalog_label_read_forbidden';
  END IF;
  IF p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo') THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_family_invalid';
  END IF;
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'familia', l.familia, 'rotulo', l.rotulo, 'rotulo_exibicao', l.rotulo_exibicao)
    ORDER BY pg_catalog.lower(l.rotulo_exibicao) COLLATE "C", l.id), '[]'::jsonb)
  INTO v_result
  FROM public.catalog_family_labels l
  WHERE l.familia = p_familia AND l.ativo = true;
  RETURN v_result;
END $$;
REVOKE ALL ON FUNCTION public.catalog_family_labels_read(text) FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION public.catalog_family_labels_read(text) TO authenticated, service_role;

-- ------------------------------------------------------------- criar rótulo
CREATE FUNCTION public.platform_create_catalog_label(p_familia text, p_rotulo text, p_rotulo_exibicao text,
  p_reason text, p_idempotency_key uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_id uuid; v_rotulo text := pg_catalog.lower(pg_catalog.btrim(COALESCE(p_rotulo, '')));
  v_exib text := pg_catalog.btrim(COALESCE(p_rotulo_exibicao, ''));
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo')
     OR v_rotulo !~ '^[a-z0-9][a-z0-9_]{1,39}$'
     OR pg_catalog.char_length(v_exib) < 2 OR pg_catalog.char_length(v_exib) > 80
     OR p_idempotency_key IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('familia', p_familia, 'rotulo', v_rotulo,
    'rotulo_exibicao', v_exib, 'reason', pg_catalog.btrim(COALESCE(p_reason, '')));
  v_replay := platform_private.catalog_entity_replay(v_actor, 'create_catalog_label', v_req, p_reason, p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  INSERT INTO public.catalog_family_labels (familia, rotulo, rotulo_exibicao, created_by)
  VALUES (p_familia, v_rotulo, v_exib, v_actor)
  RETURNING id INTO v_id;

  v_receipt := pg_catalog.jsonb_build_object('id', v_id, 'familia', p_familia, 'rotulo', v_rotulo,
    'rotulo_exibicao', v_exib, 'ativo', true, 'idempotency_key', p_idempotency_key, 'audit_id', v_audit, 'idempotent', false);
  PERFORM platform_private.catalog_entity_audit(v_actor, 'create_catalog_label', p_reason, p_idempotency_key,
    v_req, v_receipt, 'null'::jsonb, v_receipt);
  RETURN v_receipt;
END $$;
REVOKE ALL ON FUNCTION public.platform_create_catalog_label(text,text,text,text,uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.platform_create_catalog_label(text,text,text,text,uuid) TO authenticated, service_role;

-- ------------------------------------------------------------- renomear exibição (chave imutável)
CREATE FUNCTION public.platform_update_catalog_label(p_id uuid, p_expected_updated_at timestamptz,
  p_rotulo_exibicao text, p_reason text, p_idempotency_key uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.catalog_family_labels%ROWTYPE; v_np public.catalog_family_labels%ROWTYPE;
  v_exib text := pg_catalog.btrim(COALESCE(p_rotulo_exibicao, ''));
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
     OR pg_catalog.char_length(v_exib) < 2 OR pg_catalog.char_length(v_exib) > 80
     OR p_idempotency_key IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id', p_id, 'expected_updated_at', p_expected_updated_at,
    'rotulo_exibicao', v_exib, 'reason', pg_catalog.btrim(COALESCE(p_reason, '')));
  v_replay := platform_private.catalog_entity_replay(v_actor, 'update_catalog_label', v_req, p_reason, p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  SELECT * INTO v_op FROM public.catalog_family_labels WHERE id = p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'catalog_label_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE = '40001', MESSAGE = 'catalog_label_conflict'; END IF;
  IF v_op.rotulo_exibicao IS NOT DISTINCT FROM v_exib THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_no_change'; END IF;

  UPDATE public.catalog_family_labels SET rotulo_exibicao = v_exib
   WHERE id = p_id AND updated_at = p_expected_updated_at
  RETURNING * INTO v_np;
  IF NOT FOUND OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR v_np.rotulo IS DISTINCT FROM v_op.rotulo OR v_np.familia IS DISTINCT FROM v_op.familia
     OR v_np.ativo IS DISTINCT FROM v_op.ativo THEN
    RAISE EXCEPTION USING ERRCODE = '40001', MESSAGE = 'catalog_label_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id', p_id, 'familia', v_np.familia, 'rotulo', v_np.rotulo,
    'rotulo_exibicao', v_exib, 'updated_at', v_np.updated_at, 'idempotency_key', p_idempotency_key,
    'audit_id', v_audit, 'idempotent', false);
  PERFORM platform_private.catalog_entity_audit(v_actor, 'update_catalog_label', p_reason, p_idempotency_key,
    v_req, v_receipt,
    pg_catalog.jsonb_build_object('id', p_id, 'rotulo_exibicao', v_op.rotulo_exibicao, 'updated_at', v_op.updated_at),
    pg_catalog.jsonb_build_object('id', p_id, 'rotulo_exibicao', v_exib, 'updated_at', v_np.updated_at));
  RETURN v_receipt;
END $$;
REVOKE ALL ON FUNCTION public.platform_update_catalog_label(uuid,timestamptz,text,text,uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.platform_update_catalog_label(uuid,timestamptz,text,text,uuid) TO authenticated, service_role;

-- ------------------------------------------------------------- ativar/inativar (preserva atribuições)
CREATE FUNCTION public.platform_set_catalog_label_active(p_id uuid, p_expected_updated_at timestamptz,
  p_ativo boolean, p_reason text, p_idempotency_key uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.catalog_family_labels%ROWTYPE; v_np public.catalog_family_labels%ROWTYPE;
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
     OR p_ativo IS NULL OR p_idempotency_key IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id', p_id, 'expected_updated_at', p_expected_updated_at,
    'ativo', p_ativo, 'reason', pg_catalog.btrim(COALESCE(p_reason, '')));
  v_replay := platform_private.catalog_entity_replay(v_actor, 'set_catalog_label_active', v_req, p_reason, p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  -- FOR UPDATE serializa com catalog_family_label_check (FOR KEY SHARE): ver comentário lá.
  SELECT * INTO v_op FROM public.catalog_family_labels WHERE id = p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'catalog_label_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE = '40001', MESSAGE = 'catalog_label_conflict'; END IF;
  IF v_op.ativo IS NOT DISTINCT FROM p_ativo THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'catalog_label_no_change'; END IF;

  -- Inativação NÃO altera atribuições existentes em produtos; o trigger de
  -- validação só barra NOVAS atribuições de rótulo inativo.
  UPDATE public.catalog_family_labels SET ativo = p_ativo
   WHERE id = p_id AND updated_at = p_expected_updated_at
  RETURNING * INTO v_np;
  IF NOT FOUND OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR v_np.rotulo IS DISTINCT FROM v_op.rotulo OR v_np.familia IS DISTINCT FROM v_op.familia
     OR v_np.rotulo_exibicao IS DISTINCT FROM v_op.rotulo_exibicao THEN
    RAISE EXCEPTION USING ERRCODE = '40001', MESSAGE = 'catalog_label_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id', p_id, 'familia', v_np.familia, 'rotulo', v_np.rotulo,
    'ativo', p_ativo, 'updated_at', v_np.updated_at, 'idempotency_key', p_idempotency_key,
    'audit_id', v_audit, 'idempotent', false);
  PERFORM platform_private.catalog_entity_audit(v_actor, 'set_catalog_label_active', p_reason, p_idempotency_key,
    v_req, v_receipt,
    pg_catalog.jsonb_build_object('id', p_id, 'ativo', v_op.ativo, 'updated_at', v_op.updated_at),
    pg_catalog.jsonb_build_object('id', p_id, 'ativo', p_ativo, 'updated_at', v_np.updated_at));
  RETURN v_receipt;
END $$;
REVOKE ALL ON FUNCTION public.platform_set_catalog_label_active(uuid,timestamptz,boolean,text,uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.platform_set_catalog_label_active(uuid,timestamptz,boolean,text,uuid) TO authenticated, service_role;

-- ------------------------------------------------------------- whitelist de auditoria (estendida, nunca afrouxada)
ALTER TABLE public.catalog_platform_admin_audit DROP CONSTRAINT catalog_platform_admin_audit_operation_check;
ALTER TABLE public.catalog_platform_admin_audit ADD CONSTRAINT catalog_platform_admin_audit_operation_check
  CHECK (operation IN ('wipe_global_products','update_global_product_metadata','create_global_product','set_global_product_status',
    'create_global_microorganism','update_global_microorganism','set_global_microorganism_status',
    'create_global_culture','update_global_culture','set_global_culture_status',
    'create_global_volume','update_global_volume','set_global_volume_status',
    'set_global_b2b_enabled','set_global_product_family',
    'create_catalog_label','update_catalog_label','set_catalog_label_active'));

COMMIT;
