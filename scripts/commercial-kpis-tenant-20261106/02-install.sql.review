-- INSTALL REVISÁVEL — COMMERCIAL_KPIS_TENANT_V1. NÃO APLICAR sem autorização explícita do proprietário.
-- Alvo exclusivo: ref swzpzcwiasxmjutrmvkm. Mesmo contrato (assinatura, defaults, chaves jsonb, mensagem 'forbidden').
-- Delta: guard canônico h15_actor_organization + papéis originais preservados; propriedade
-- partner_accounts.commercial_owner_organization_id = tenant do ator em TODOS os agregados, no JOIN e em parceiros_novos;
-- p_partner_id de outro tenant (ou inexistente) é negado sem oráculo de existência. Nenhuma tabela/RLS/grant novo.
BEGIN;
SET LOCAL lock_timeout = '5s';

DO $pre$
BEGIN
  IF md5(pg_get_functiondef('public.rpc_commercial_kpis(date,date,uuid,uuid,text)'::regprocedure)) <> '96771c88d76993b92267bfe66113fc9d'
     OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881'
     OR md5(pg_get_functiondef('platform_private.platform_actor_access_ready(uuid)'::regprocedure)) <> '048249c0c2106c3761e26eacb8d0de84'
     OR md5(pg_get_functiondef('platform_private.has_role(uuid,public.app_role)'::regprocedure)) <> 'c5af5b55de6d79da9b73a33948746ae2' THEN
    RAISE EXCEPTION 'PRE_DRIFT: corpo capturado divergente; abortar';
  END IF;
END $pre$;

CREATE OR REPLACE FUNCTION public.rpc_commercial_kpis(p_from date DEFAULT ((now())::date - 30), p_to date DEFAULT (now())::date, p_partner_id uuid DEFAULT NULL::uuid, p_consultor uuid DEFAULT NULL::uuid, p_region text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  r jsonb;
  v_uid uuid := auth.uid();
  v_org uuid;
BEGIN
  -- COMMERCIAL_KPIS_TENANT_V1
  IF v_uid IS NULL THEN RAISE EXCEPTION 'forbidden'; END IF;
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL THEN RAISE EXCEPTION 'forbidden'; END IF;
  IF NOT (platform_private.has_role(v_uid, 'administrador'::public.app_role)
          OR platform_private.has_role(v_uid, 'gestor_comercial'::public.app_role)) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;
  IF p_partner_id IS NOT NULL AND NOT EXISTS (
       SELECT 1 FROM public.partner_accounts x
       WHERE x.id = p_partner_id AND x.commercial_owner_organization_id = v_org) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;
  SELECT jsonb_build_object(
    'pedidos_total', COUNT(*),
    'pedidos_aprovados', COUNT(*) FILTER (WHERE po.status='aprovado'),
    'pedidos_em_negociacao', COUNT(*) FILTER (WHERE po.status='em_analise_comercial'),
    'pedidos_aguardando_ajuste', COUNT(*) FILTER (WHERE po.status::text='aguardando_ajuste_comercial'),
    'receita_prevista', COALESCE(SUM(po.total) FILTER (WHERE po.status IN ('solicitado','em_analise_comercial','aprovado')),0),
    'receita_aprovada', COALESCE(SUM(po.total) FILTER (WHERE po.status='aprovado'),0),
    'parceiros_ativos', COUNT(DISTINCT po.partner_id),
    'parceiros_novos', (
      SELECT COUNT(*) FROM public.partner_accounts pa2
      WHERE pa2.commercial_owner_organization_id = v_org
        AND pa2.created_at::date BETWEEN p_from AND p_to
        AND (p_consultor IS NULL OR pa2.consultor_responsavel = p_consultor)
        AND (p_region IS NULL OR pa2.commercial_region = p_region)
    )
  ) INTO r
  FROM public.partner_orders po
  JOIN public.partner_accounts pa ON pa.id = po.partner_id AND pa.commercial_owner_organization_id = v_org
  WHERE po.created_at::date BETWEEN p_from AND p_to
    AND (p_partner_id IS NULL OR po.partner_id = p_partner_id)
    AND (p_consultor IS NULL OR pa.consultor_responsavel = p_consultor)
    AND (p_region IS NULL OR pa.commercial_region = p_region);
  RETURN r;
END $function$;

-- ACL idêntica à capturada (postgres/authenticated/service_role); PUBLIC e anon sem EXECUTE.
REVOKE ALL ON FUNCTION public.rpc_commercial_kpis(date,date,uuid,uuid,text) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.rpc_commercial_kpis(date,date,uuid,uuid,text) TO authenticated, service_role;
COMMIT;
