-- POST (somente leitura) — COMMERCIAL_KPIS_TENANT_V1. Toda coluna deve ser 't'.
WITH f AS (SELECT p.oid, p.prosecdef, p.proconfig, p.proacl, pg_get_functiondef(p.oid) AS def
           FROM pg_proc p WHERE p.oid = 'public.rpc_commercial_kpis(date,date,uuid,uuid,text)'::regprocedure)
SELECT
  md5(def) <> '96771c88d76993b92267bfe66113fc9d' AS vulnerable_body_gone,
  def LIKE '%COMMERCIAL_KPIS_TENANT_V1%' AS marker,
  def LIKE '%platform_private.h15_actor_organization()%' AS h15_guard,
  (length(def) - length(replace(def, 'commercial_owner_organization_id = v_org', ''))) / length('commercial_owner_organization_id = v_org') = 3 AS owner_filter_x3,
  prosecdef AS security_definer,
  proconfig = ARRAY['search_path=""'] AS search_path_empty,
  (SELECT array_agg(a ORDER BY a) FROM unnest(proacl::text[]) a) = ARRAY['authenticated=X/postgres','postgres=X/postgres','service_role=X/postgres'] AS acl_exact,
  NOT has_function_privilege('anon', oid, 'EXECUTE') AS anon_denied
FROM f;
