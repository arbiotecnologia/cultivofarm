-- REVIEW ONLY / INACTIVE. Never apply without independent review and owner-run release.
-- Single transaction: PRE, DDL and POST share one txid. Writer, accounting gate and downstream containment untouched.
BEGIN;
DO $pre$ BEGIN
 SET LOCAL lock_timeout='5s';
 IF md5(pg_get_functiondef('platform_private.c2_owner_order_create_allowed(uuid,uuid)'::regprocedure)) IS DISTINCT FROM 'a0417d6727d78412849916a95b250bde' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.c2_owner_order_create_allowed(uuid,uuid)'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_internal_commercial_actor()'::regprocedure)) IS DISTINCT FROM '6555396c4f8fe914177d2ccfc3891279' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.b2b_internal_commercial_actor()'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_actor_scope(uuid)'::regprocedure)) IS DISTINCT FROM 'c3f2997746f24bc2efd15db5c0ccc862' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.b2b_actor_scope(uuid)'; END IF;
 IF md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) IS DISTINCT FROM '12ea8b410e8fadf2da8f72fc1bbc83cf' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'; END IF;
 IF md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) IS DISTINCT FROM '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'; END IF;
 IF md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid,boolean)'::regprocedure)) IS DISTINCT FROM '1391adc2133b922e2dcea4b1d3e26820' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.get_partner_catalog_secure(uuid,boolean)'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid,boolean)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid,boolean)'::regprocedure) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'C2IOE_ACL_DRIFT:public.get_partner_catalog_secure(uuid,boolean)'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid)'::regprocedure) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'C2IOE_ACL_DRIFT:public.get_partner_catalog_secure(uuid)'; END IF;
 IF to_regprocedure('platform_private.c1b_catalog_visibility_scope(uuid)') IS NULL THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_MISSING:c1b_catalog_visibility_scope'; END IF;
 IF md5(pg_get_functiondef('platform_private.c2_order_actor_scope(uuid,uuid)'::regprocedure)) IS DISTINCT FROM '6802c693f459a92e70dade0c73d7faba' THEN RAISE EXCEPTION 'C2IOE_PRE_LIVE_DRIFT:platform_private.c2_order_actor_scope(uuid,uuid)'; END IF;
 IF md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid)'::regprocedure)) IS DISTINCT FROM '2c1944f3f95e4d2b44675306d5905b61' THEN RAISE EXCEPTION 'C2IOE_PRE_LIVE_DRIFT:public.get_partner_catalog_secure(uuid)'; END IF;
 IF to_regprocedure('public.c2_internal_order_entry_capability_v1()') IS NOT NULL OR to_regprocedure('platform_private.c2_internal_order_target_reason(uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'C2IOE_PRE_ALREADY_PRESENT'; END IF;
END $pre$;
CREATE OR REPLACE FUNCTION platform_private.c2_internal_order_target_reason(_uid uuid, _partner uuid)
 RETURNS text
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE s record; org uuid;
BEGIN
  -- Mirrors LIVE guards; NULL means allowed. Never authorizes by itself: callers must RAISE.
  IF _uid IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RETURN 'auth_required'; END IF;
  IF NOT platform_private.b2b_internal_commercial_actor() THEN RETURN 'actor_not_allowed'; END IF;
  SELECT * INTO s FROM platform_private.b2b_actor_scope(_uid);
  IF s.profile_ok IS NOT TRUE THEN RETURN 'inactive_scope'; END IF;
  IF NOT public._saas_user_has_feature(_uid,'pedidos_b2b') THEN RETURN 'feature_disabled'; END IF;
  org := public.h15_actor_organization();
  IF org IS NULL THEN RETURN 'actor_not_allowed'; END IF;
  IF _partner IS NULL THEN RETURN NULL; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_accounts p
       WHERE p.id=_partner AND p.ativo IS TRUE AND p.deleted_at IS NULL AND p.commercial_owner_organization_id=org
         AND (p.client_id IS NULL OR EXISTS (SELECT 1 FROM public.clientes c WHERE c.id=p.client_id AND c.organization_id=org))) THEN
    RETURN 'target_outside_portfolio';
  END IF;
  RETURN NULL;
END $function$;
ALTER FUNCTION platform_private.c2_internal_order_target_reason(uuid,uuid) OWNER TO postgres;
REVOKE ALL ON FUNCTION platform_private.c2_internal_order_target_reason(uuid,uuid) FROM PUBLIC, anon, authenticated;

CREATE OR REPLACE FUNCTION platform_private.c2_order_actor_scope(_uid uuid, _partner uuid)
 RETURNS void
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE s record; r text;
BEGIN
  -- C2_INTERNAL_ORDER_ENTRY_V1: exclusive internal commercial actor (admin/gestor_comercial,
  -- no external B2B role) may target only its own organization's portfolio.
  IF platform_private.b2b_internal_commercial_actor() AND auth.uid() IS NOT DISTINCT FROM _uid THEN
    r := platform_private.c2_internal_order_target_reason(_uid,_partner);
    IF r IS NOT NULL OR _partner IS NULL THEN
      RAISE EXCEPTION 'C2_INTERNAL_TARGET_DENIED:%', COALESCE(r,'target_required') USING ERRCODE='42501';
    END IF;
    RETURN;
  END IF;
  IF public.has_role(_uid,'parceiro_b2b_tecnico'::public.app_role) AND public.has_role(_uid,'parceiro_b2b'::public.app_role)
     AND NOT public.is_platform_superadmin(_uid) THEN
    IF _uid IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
    IF NOT platform_private.c2_owner_order_create_allowed(_uid,_partner) THEN
      RAISE EXCEPTION 'forbidden_financial_terms' USING ERRCODE='42501';
    END IF;
    SELECT * INTO s FROM platform_private.b2b_actor_scope(_uid);
    IF NOT s.profile_ok THEN RAISE EXCEPTION 'inactive_scope' USING ERRCODE='42501'; END IF;
    IF s.org_partner IS DISTINCT FROM _partner OR NOT s.partner_valid
       OR s.user_partner_count <> 1 OR s.user_partner IS DISTINCT FROM _partner THEN
      RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
    END IF;
    RETURN;
  END IF;
  PERFORM platform_private.assert_b2b_partner_scope(_uid,_partner);
END $function$;
ALTER FUNCTION platform_private.c2_order_actor_scope(uuid,uuid) OWNER TO postgres;
REVOKE ALL ON FUNCTION platform_private.c2_order_actor_scope(uuid,uuid) FROM PUBLIC, anon, authenticated, service_role;

CREATE OR REPLACE FUNCTION public.c2_internal_order_entry_capability_v1()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE uid uuid := auth.uid(); org uuid; r text; n integer; validated boolean; partners jsonb := '[]'::jsonb;
BEGIN
  IF uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  r := platform_private.c2_internal_order_target_reason(uid, NULL);
  IF r IS NULL THEN
    org := public.h15_actor_organization();
    -- Same issuer predicate as LIVE b2b_internal_order_snapshot_guard; read only, no lock.
    SELECT count(*), bool_and(c.configuration_status='VALIDATED' AND c.accounting_validated_at IS NOT NULL
             AND nullif(btrim(c.legal_name),'') IS NOT NULL AND nullif(btrim(c.cnpj),'') IS NOT NULL)
      INTO n, validated FROM public.company_fiscal_settings c WHERE c.organization_id=org AND c.is_active IS TRUE;
    IF n<>1 THEN r := 'issuer_ambiguous'; ELSIF validated IS NOT TRUE THEN r := 'issuer_not_validated'; END IF;
    SELECT COALESCE(jsonb_agg(jsonb_build_object('partner_id',p.id,'razao_social',p.razao_social,
             'commercial_owner_organization_id',p.commercial_owner_organization_id) ORDER BY p.razao_social, p.id),'[]'::jsonb)
      INTO partners FROM public.partner_accounts p
     WHERE platform_private.c2_internal_order_target_reason(uid,p.id) IS NULL;
    IF r IS NULL AND jsonb_array_length(partners)=0 THEN r := 'no_partner_in_scope'; END IF;
    -- Same catalogue feature as the canonical reader (b2b_actor_scope.has_catalog / catalogo_precos).
    IF r IS NULL AND NOT EXISTS (SELECT 1 FROM platform_private.b2b_actor_scope(uid) x WHERE x.has_catalog IS TRUE) THEN r := 'catalog_feature_disabled'; END IF;
    -- Catalogue reader must be exactly the reviewed portfolio-aware body; any drift closes order entry.
    IF r IS NULL AND md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid)'::regprocedure)) IS DISTINCT FROM 'b5684d350603d1db77ab9f1db0f4b253' THEN r := 'catalog_reader_pending'; END IF;
  END IF;
  RETURN jsonb_build_object('contract','C2_INTERNAL_ORDER_ENTRY_V1','organization_id',org,
    'profile_ok', r IS DISTINCT FROM 'inactive_scope' AND r IS DISTINCT FROM 'actor_not_allowed',
    'order_create', r IS NULL, 'reason', r,
    'partners', CASE WHEN org IS NULL THEN '[]'::jsonb ELSE partners END);
END $function$;
ALTER FUNCTION public.c2_internal_order_entry_capability_v1() OWNER TO postgres;
REVOKE ALL ON FUNCTION public.c2_internal_order_entry_capability_v1() FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.c2_internal_order_entry_capability_v1() TO authenticated, service_role;

-- C2_INTERNAL_ORDER_ENTRY_V1 catalogue: only the partner gate changes; visibility, prices, sheets, V2 wrapper untouched.
CREATE OR REPLACE FUNCTION public.get_partner_catalog_secure(p_partner_id uuid)
 RETURNS TABLE(item_id uuid, item_tipo text, product_id uuid, produto_nome text, produto_codigo text, descricao_curta text, preco_tabela numeric, desconto_percentual numeric, preco_parceiro numeric, produto_ativo boolean, resumo_curto text, explicacao_b2b text, beneficios_principais text, ficha_status text, ficha_aprovada boolean, valor_dose_brl numeric, valor_litro_brl numeric, valor_ha_brl numeric, unidade_preco_principal text)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_visibility_scope uuid[];
  v_uid uuid := auth.uid();
  v_super boolean; s record; r record;
  v_pid uuid; v_mid uuid; j_ha jsonb; j_li jsonb; j_do jsonb;
  n_ha numeric; n_li numeric; n_do numeric; v_base numeric; v_unid text;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  IF p_partner_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_accounts pa
       WHERE pa.id = p_partner_id AND pa.ativo = true AND pa.deleted_at IS NULL) THEN
    RAISE EXCEPTION 'partner_not_found' USING ERRCODE='42501';
  END IF;
  v_super := public.is_platform_superadmin(v_uid);
  IF NOT v_super THEN
    IF public.has_role(v_uid,'parceiro_b2b_tecnico'::app_role) THEN
      RAISE EXCEPTION 'forbidden_financial_terms' USING ERRCODE='42501';
    END IF;
    SELECT * INTO s FROM platform_private.b2b_actor_scope(v_uid);
    IF (NOT s.profile_ok OR s.org_partner IS DISTINCT FROM p_partner_id OR NOT s.partner_valid)
       AND NOT (platform_private.b2b_internal_commercial_actor()
                AND platform_private.c2_internal_order_target_reason(v_uid, p_partner_id) IS NULL) THEN
      RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
    END IF;
    IF public.has_role(v_uid,'parceiro_b2b'::app_role) THEN
      IF s.user_partner_count <> 1 OR s.user_partner IS DISTINCT FROM p_partner_id THEN
        RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
      END IF;
    ELSIF NOT (public.has_role(v_uid,'administrador'::app_role) OR public.has_role(v_uid,'gestor_comercial'::app_role)) THEN
      RAISE EXCEPTION 'forbidden_role' USING ERRCODE='42501';
    END IF;
    IF NOT s.has_catalog THEN RAISE EXCEPTION 'feature_not_entitled' USING ERRCODE='42501'; END IF;
  END IF;

  v_visibility_scope := platform_private.c1b_catalog_visibility_scope(p_partner_id);
  FOR r IN
    SELECT p.id, 'produto'::text AS tipo, p.nome, p.codigo, p.ativo,
           ptp.status_validacao, ptp.resumo_curto, ptp.explicacao_b2b, ptp.beneficio_combinado AS beneficios
      FROM public.produtos p LEFT JOIN public.product_technical_profiles ptp ON ptp.produto_id = p.id
     WHERE p.ativo = true AND p.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='produto' AND cv.hidden IS TRUE AND cv.produto_id=p.id)
    UNION ALL
    SELECT m.id, 'microrganismo'::text, m.nome, m.codigo, m.ativo,
           mtp.status_validacao, mtp.resumo_curto, mtp.explicacao_b2b, mtp.beneficios_agronomicos
      FROM public.microrganismos m LEFT JOIN public.microorganism_technical_profiles mtp ON mtp.microrganismo_id = m.id
     WHERE m.ativo = true AND m.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='microrganismo' AND cv.hidden IS TRUE AND cv.microrganismo_id=m.id)
  LOOP
    v_pid := CASE WHEN r.tipo='produto' THEN r.id END;
    v_mid := CASE WHEN r.tipo='microrganismo' THEN r.id END;
    j_ha := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'hectare', NULL, current_date);
    j_li := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'litro',   NULL, current_date);
    j_do := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'dose',    NULL, current_date);
    n_ha := CASE WHEN COALESCE((j_ha->>'ok')::boolean,false) THEN NULLIF((j_ha->>'base_price')::numeric,0) END;
    n_li := CASE WHEN COALESCE((j_li->>'ok')::boolean,false) THEN NULLIF((j_li->>'base_price')::numeric,0) END;
    n_do := CASE WHEN COALESCE((j_do->>'ok')::boolean,false) THEN NULLIF((j_do->>'base_price')::numeric,0) END;
    v_unid := CASE WHEN n_ha IS NOT NULL THEN 'hectare' WHEN n_li IS NOT NULL THEN 'litro'
                   WHEN n_do IS NOT NULL THEN 'dose_100ml' ELSE 'sob_consulta' END;
    v_base := COALESCE(n_ha, n_li, n_do);
    item_id := r.id; item_tipo := r.tipo; product_id := v_pid;
    produto_nome := r.nome; produto_codigo := r.codigo;
    descricao_curta := CASE WHEN r.status_validacao='aprovado' THEN LEFT(COALESCE(r.resumo_curto,''),220) END;
    preco_tabela := ROUND(v_base,2);
    desconto_percentual := CASE WHEN v_base IS NOT NULL THEN 0::numeric END;
    preco_parceiro := ROUND(v_base,2);
    produto_ativo := r.ativo;
    resumo_curto := CASE WHEN r.status_validacao='aprovado' THEN r.resumo_curto END;
    explicacao_b2b := CASE WHEN r.status_validacao='aprovado' THEN r.explicacao_b2b END;
    beneficios_principais := CASE WHEN r.status_validacao='aprovado' THEN r.beneficios END;
    ficha_status := COALESCE(r.status_validacao,'sem_ficha');
    ficha_aprovada := (r.status_validacao = 'aprovado');
    valor_dose_brl := ROUND(n_do,2); valor_litro_brl := ROUND(n_li,2); valor_ha_brl := ROUND(n_ha,2);
    unidade_preco_principal := v_unid;
    RETURN NEXT;
  END LOOP;
END;
$function$
;
ALTER FUNCTION public.get_partner_catalog_secure(uuid) OWNER TO postgres;
DO $post$ BEGIN
 IF md5(pg_get_functiondef('platform_private.c2_owner_order_create_allowed(uuid,uuid)'::regprocedure)) IS DISTINCT FROM 'a0417d6727d78412849916a95b250bde' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.c2_owner_order_create_allowed(uuid,uuid)'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_internal_commercial_actor()'::regprocedure)) IS DISTINCT FROM '6555396c4f8fe914177d2ccfc3891279' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.b2b_internal_commercial_actor()'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_actor_scope(uuid)'::regprocedure)) IS DISTINCT FROM 'c3f2997746f24bc2efd15db5c0ccc862' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:platform_private.b2b_actor_scope(uuid)'; END IF;
 IF md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) IS DISTINCT FROM '12ea8b410e8fadf2da8f72fc1bbc83cf' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'; END IF;
 IF md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) IS DISTINCT FROM '37d4f45e388ed7b38f6f397b672629ee' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'; END IF;
 IF md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid,boolean)'::regprocedure)) IS DISTINCT FROM '1391adc2133b922e2dcea4b1d3e26820' THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_DRIFT:public.get_partner_catalog_secure(uuid,boolean)'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid,boolean)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid,boolean)'::regprocedure) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'C2IOE_ACL_DRIFT:public.get_partner_catalog_secure(uuid,boolean)'; END IF;
 IF (SELECT proacl::text FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid)'::regprocedure) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid='public.get_partner_catalog_secure(uuid)'::regprocedure) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'C2IOE_ACL_DRIFT:public.get_partner_catalog_secure(uuid)'; END IF;
 IF to_regprocedure('platform_private.c1b_catalog_visibility_scope(uuid)') IS NULL THEN RAISE EXCEPTION 'C2IOE_DEPENDENCY_MISSING:c1b_catalog_visibility_scope'; END IF;
 IF md5(pg_get_functiondef('public.get_partner_catalog_secure(uuid)'::regprocedure)) IS DISTINCT FROM 'b5684d350603d1db77ab9f1db0f4b253' THEN RAISE EXCEPTION 'C2IOE_POST_DRIFT:public.get_partner_catalog_secure(uuid)'; END IF;
 IF has_function_privilege('authenticated','platform_private.c2_internal_order_target_reason(uuid,uuid)','EXECUTE') OR has_function_privilege('authenticated','platform_private.c2_order_actor_scope(uuid,uuid)','EXECUTE') OR has_function_privilege('anon','public.c2_internal_order_entry_capability_v1()','EXECUTE') OR NOT has_function_privilege('authenticated','public.c2_internal_order_entry_capability_v1()','EXECUTE') THEN RAISE EXCEPTION 'C2IOE_POST_ACL'; END IF;
END $post$;
COMMIT;
