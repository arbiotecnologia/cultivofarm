-- READONLY POST: estrutura e corpos candidatos; não certifica JWT/RLS hosted.
DO $$
BEGIN
  IF current_setting('commercial_plans.review_project_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_REF_NOT_VERIFIED'; END IF;
  IF NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='commercial_payment_plans' AND column_name='organization_id') THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_TENANT_COLUMN_MISSING'; END IF;
  IF (SELECT indexdef FROM pg_indexes WHERE schemaname='public' AND tablename='commercial_payment_plans' AND indexname='uq_cpp_single_default') IS DISTINCT FROM 'CREATE UNIQUE INDEX uq_cpp_single_default ON public.commercial_payment_plans USING btree (organization_id) NULLS NOT DISTINCT WHERE is_default' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_TENANT_DEFAULT_INDEX_MISSING'; END IF;
  IF EXISTS(SELECT 1 FROM public.commercial_payment_plans p LEFT JOIN public.organizations o ON o.id=p.organization_id WHERE p.organization_id IS NOT NULL AND o.id IS NULL) THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_ORPHAN_TENANT'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'::regprocedure)) IS DISTINCT FROM '2b7aef289d966b1af68daea1e3927348' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_assign(uuid,uuid,text,integer,boolean)'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_config_list()'::regprocedure)) IS DISTINCT FROM '728b3b92bc4848873f6df85779585295' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_config_list()'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'::regprocedure)) IS DISTINCT FROM 'b43aefacda669e17fe9bf9edc57471dd' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_publish(uuid,text,uuid,uuid,integer,integer,numeric,integer)'; END IF;
  IF md5(pg_get_functiondef('public.b2b_payment_condition_retire(uuid,text,integer)'::regprocedure)) IS DISTINCT FROM '5eb039bb1d7f220fa27d49cc58eec974' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.b2b_payment_condition_retire(uuid,text,integer)'; END IF;
  IF md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) IS DISTINCT FROM 'fe82f5381d426136f2627803f3b0005d' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'; END IF;
  IF md5(pg_get_functiondef('platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'::regprocedure)) IS DISTINCT FROM 'abbffddb1a3062fd7dabbf14c5af8822' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.b2b_resolve_condition(uuid,uuid,jsonb,boolean)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_assignment_fence()'::regprocedure)) IS DISTINCT FROM 'fe958e7d52fb36faa77881933a808434' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_assignment_fence()'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_history_allowed(text,uuid,jsonb,jsonb)'::regprocedure)) IS DISTINCT FROM '775c1540b15842d3ce0696e4a5d27f3b' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_history_allowed(text,uuid,jsonb,jsonb)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_item_allowed(uuid,uuid,text,uuid,uuid)'::regprocedure)) IS DISTINCT FROM '8212432313c52b2a12a1398ec40c814e' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_item_allowed(uuid,uuid,text,uuid,uuid)'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_item_fence()'::regprocedure)) IS DISTINCT FROM 'c1c88697a57168ba49c30692e7a85046' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_item_fence()'; END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_rule_fence()'::regprocedure)) IS DISTINCT FROM '4337496c5ece403ad072adcaee88faf2' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: platform_private.c2p1_rule_fence()'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_create_commercial_plan(jsonb)'::regprocedure)) IS DISTINCT FROM 'f1c3d700186723511be299dccc585504' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_create_commercial_plan(jsonb)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_list_commercial_plans(text,text,integer,integer)'::regprocedure)) IS DISTINCT FROM 'c6672029349b7a312066341defb625ab' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_list_commercial_plans(text,text,integer,integer)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_reorder_commercial_plans(jsonb)'::regprocedure)) IS DISTINCT FROM '84286eacbdbbb5215c939ac1c697956d' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_reorder_commercial_plans(jsonb)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_set_commercial_plan_active(uuid,boolean,text)'::regprocedure)) IS DISTINCT FROM '2a0d470eaf814102e7496bf6d4769834' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_set_commercial_plan_active(uuid,boolean,text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_set_default_commercial_plan(uuid)'::regprocedure)) IS DISTINCT FROM 'ace8953d10910df79f27ae77acc240cd' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_set_default_commercial_plan(uuid)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_update_commercial_plan_metadata(uuid,text,text,integer)'::regprocedure)) IS DISTINCT FROM 'cba4e12a1f21b0841317af02bcdf56b8' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_update_commercial_plan_metadata(uuid,text,text,integer)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_admin_version_commercial_plan(uuid,jsonb,text)'::regprocedure)) IS DISTINCT FROM '1f72b832eec3e438e780cdb4f1562b5a' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_admin_version_commercial_plan(uuid,jsonb,text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_b2b_list_selectable_payment_plans()'::regprocedure)) IS DISTINCT FROM '5bceeda188eee7525172eadeed17f7c0' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_b2b_list_selectable_payment_plans()'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_list_assignments(text)'::regprocedure)) IS DISTINCT FROM '72af313fcbdd40436e45a36ecf854ac9' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_list_assignments(text)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_simulate_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)'::regprocedure)) IS DISTINCT FROM '3aa53f85f13a3a1d9322673c40d262bd' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_simulate_price(text,uuid,uuid,uuid,uuid,uuid,text,numeric,date,numeric)'; END IF;
  IF md5(pg_get_functiondef('public.rpc_cc_validate_matrix(uuid,text,uuid,uuid)'::regprocedure)) IS DISTINCT FROM 'b4f0ff6f4f0856c90faef8654e0c4980' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.rpc_cc_validate_matrix(uuid,text,uuid,uuid)'; END IF;
  IF md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) IS DISTINCT FROM '6e81e29397a9bd633f2fe6ec364d8cf3' THEN RAISE EXCEPTION 'COMMERCIAL_PLAN_POST_DRIFT: public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'; END IF;
END $$;
SELECT count(*) AS plans,count(organization_id) AS owned,count(*)-count(organization_id) AS denied_unresolved FROM public.commercial_payment_plans;
