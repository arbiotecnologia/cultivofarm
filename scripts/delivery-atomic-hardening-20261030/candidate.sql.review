-- INACTIVE candidate. Installation preserves closed client ACLs.
CREATE TABLE platform_private.delivery_requests_20261030 (
 request_key text NOT NULL, actor uuid NOT NULL, organization_id uuid NOT NULL,
 action text NOT NULL, fingerprint text NOT NULL, result jsonb NOT NULL,
 created_at timestamptz NOT NULL DEFAULT pg_catalog.clock_timestamp(),
 PRIMARY KEY(organization_id,actor,action,request_key)
);
REVOKE ALL ON platform_private.delivery_requests_20261030 FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.delivery_requests_20261030 ENABLE ROW LEVEL SECURITY;
CREATE TABLE platform_private.delivery_context_20261030 (
 txid bigint PRIMARY KEY, actor uuid NOT NULL, organization_id uuid NOT NULL,
 action text NOT NULL, target uuid, consumed boolean NOT NULL DEFAULT false,
 item uuid, delivery uuid, mutation text
);
REVOKE ALL ON platform_private.delivery_context_20261030 FROM PUBLIC,anon,authenticated,service_role;
ALTER TABLE platform_private.delivery_context_20261030 ENABLE ROW LEVEL SECURITY;

CREATE FUNCTION platform_private.delivery_actor_20261030(p_action text)
RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'DELIVERY_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor','consultor_tecnico','aplicador','operador_onfarm','superadmin'))
 OR EXISTS(SELECT 1 FROM public.partner_users WHERE user_id=auth.uid() AND revoked_at IS NULL AND (valid_from IS NULL OR valid_from<=pg_catalog.now()))
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND (role IN ('administrador','gestor') OR (p_action='group' AND role='producao') OR (p_action='cancel' AND role='administrativo')))
 THEN RAISE EXCEPTION 'DELIVERY_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 IF NOT public.saas_has_feature('estoque_embalagens') THEN RAISE EXCEPTION 'DELIVERY_FEATURE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_actor_20261030(text) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.delivery_gate_20261030(p_org uuid,p_action text)
RETURNS void LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
BEGIN
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_AUTH_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 IF platform_private.delivery_actor_20261030(p_action) IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.organizations WHERE id=p_org AND ativo IS TRUE FOR SHARE;
 IF NOT FOUND OR platform_private.delivery_actor_20261030(p_action) IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_gate_20261030(uuid,text) FROM PUBLIC,anon,authenticated,service_role;

-- Every delivery writer, including DEFINER/service paths, must have an exact
-- private one-shot transaction/actor/tenant/action/row permit. GUCs are irrelevant.
CREATE FUNCTION platform_private.delivery_mutation_guard_20261030()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE c platform_private.delivery_context_20261030%ROWTYPE; v_org uuid;
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 SELECT * INTO c FROM platform_private.delivery_context_20261030
 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid();
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 v_org:=platform_private.delivery_actor_20261030(c.action);
 IF c.organization_id IS DISTINCT FROM v_org OR NEW.organization_id IS DISTINCT FROM v_org
 OR NEW.partner_order_id IS NOT NULL OR NEW.receivable_id IS NOT NULL OR NEW.ordem_servico_onfarm_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='group' AND TG_OP='INSERT' AND c.mutation='create' AND c.delivery IS NULL
 AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item AND NEW.status::text='separado' THEN
  UPDATE platform_private.delivery_context_20261030 SET delivery=NEW.id,mutation='decorate' WHERE txid=c.txid;
 ELSIF c.action='group' AND TG_OP='UPDATE' AND c.mutation='decorate' AND NEW.id=c.delivery
 AND OLD.id=c.delivery AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item
 AND NEW.organization_id=OLD.organization_id AND NEW.status=OLD.status THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSIF c.action='cancel' AND TG_OP='UPDATE' AND c.mutation='cancel' AND NEW.id=c.target AND OLD.id=c.target
 AND OLD.organization_id=v_org AND NEW.status::text='cancelada' AND NEW.financial_status='CANCELED'
 AND (pg_catalog.to_jsonb(NEW)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status'])
 IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status']) THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSE RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_mutation_guard_20261030() FROM PUBLIC,anon,authenticated,service_role;
-- Runs after tenant_organization_guard hydrates organization_id and after
-- canonical field validators; still BEFORE the row and downstream effects.
CREATE TRIGGER zz_delivery_mutation_closed BEFORE INSERT OR UPDATE OR DELETE ON public.entregas
FOR EACH ROW EXECUTE FUNCTION platform_private.delivery_mutation_guard_20261030();
-- Preserve SELECT/RLS and independent stock grants. Close table AND column DML.
REVOKE INSERT,UPDATE,DELETE,TRUNCATE ON public.entregas FROM PUBLIC,anon,authenticated;
DO $$ DECLARE c record; BEGIN
 FOR c IN SELECT attname FROM pg_catalog.pg_attribute WHERE attrelid='public.entregas'::regclass AND attnum>0 AND NOT attisdropped LOOP
  EXECUTE pg_catalog.format('REVOKE INSERT (%I), UPDATE (%I) ON public.entregas FROM PUBLIC,anon,authenticated',c.attname,c.attname);
 END LOOP;
END $$;

CREATE FUNCTION platform_private.delivery_no_downstream_20261030()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN
 IF EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current()) THEN
  RAISE EXCEPTION 'DELIVERY_DOWNSTREAM_FORBIDDEN: %.%',TG_TABLE_SCHEMA,TG_TABLE_NAME USING ERRCODE='42501';
 END IF;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_no_downstream_20261030() FROM PUBLIC,anon,authenticated,service_role;

-- Install the barriers with the candidate, not only in the test harness.
-- A receipt-table barrier alone is insufficient: tg_auto_b2b_receivable can catch child errors.
DO $$ DECLARE v_table text; BEGIN
 FOREACH v_table IN ARRAY ARRAY['accounts_receivable','accounts_receivable_installments','financial_receipts','financial_documents','fiscal_invoices','fiscal_invoice_items','fiscal_events','comunicacao_outbox','comunicacao_eventos','os_faturamento_base'] LOOP
  EXECUTE format('CREATE TRIGGER a00_delivery_no_downstream BEFORE INSERT OR UPDATE OR DELETE ON public.%I FOR EACH ROW EXECUTE FUNCTION platform_private.delivery_no_downstream_20261030()',v_table);
 END LOOP;
END $$;
CREATE FUNCTION platform_private.delivery_order_transition_guard_20261030()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN
 IF NEW.status IS DISTINCT FROM OLD.status AND EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current()) THEN
  RAISE EXCEPTION 'DELIVERY_B2B_TRANSITION_CLOSED' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_order_transition_guard_20261030() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER a00_delivery_order_transition_closed BEFORE UPDATE OF status ON public.partner_orders
FOR EACH ROW EXECUTE FUNCTION platform_private.delivery_order_transition_guard_20261030();

CREATE OR REPLACE FUNCTION public.fn_entrega_marcar_cancelamento()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN
 IF NEW.status::text='cancelada' AND (TG_OP='INSERT' OR OLD.status::text IS DISTINCT FROM 'cancelada') THEN
  UPDATE platform_private.delivery_context_20261030 SET consumed=true
   WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND organization_id=NEW.organization_id
    AND action='cancel' AND target=NEW.id AND consumed=false;
  IF NOT FOUND THEN RAISE EXCEPTION 'ENTREGA_CANCELAMENTO_EXIGE_RPC' USING ERRCODE='42501'; END IF;
  NEW.cancelada_em:=COALESCE(NEW.cancelada_em,pg_catalog.now()); NEW.cancelada_por:=auth.uid();
 END IF;
 RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION public.fn_entrega_marcar_cancelamento() FROM PUBLIC,anon,authenticated;

-- Called only by the canonical motor while releasing a proven delivery reservation.
CREATE FUNCTION platform_private.delivery_merge_split_20261030(p_item uuid,p_ctx jsonb,p_payload jsonb)
RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; v_s public.estoque_produto%ROWTYPE; v_main public.estoque_produto%ROWTYPE;
 v_ent uuid:=NULLIF(p_payload->>'referencia_id','')::uuid; v_total numeric; v_volume numeric;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('cancel');
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND organization_id=v_org AND action='cancel' AND target=v_ent AND NOT consumed)
 OR NOT EXISTS(SELECT 1 FROM platform_private.stock_motor_context WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND item=p_item AND ctx=p_ctx AND ctx->>'acao'='cancelamento_reserva')
 THEN RAISE EXCEPTION 'DELIVERY_MERGE_CONTEXT_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=p_item FOR UPDATE;
 PERFORM platform_private.stock_motor_item(p_item,'cancelamento_reserva',p_payload);
 IF v_s.status::text<>'reservado' OR v_s.quantidade IS DISTINCT FROM v_s.quantidade_reservada OR v_s.quantidade IS NULL OR v_s.quantidade<=0 OR v_s.quantidade::text IN ('NaN','Infinity','-Infinity') OR v_s.volume_total IS NULL OR v_s.volume_total<=0 OR v_s.volume_total::text IN ('NaN','Infinity','-Infinity') OR NOT EXISTS(SELECT 1 FROM public.entregas WHERE id=v_ent AND organization_id=v_org AND estoque_produto_id=p_item AND quantidade_entregue=v_s.quantidade) THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 SELECT * INTO v_main FROM public.estoque_produto WHERE lote_id=v_s.lote_id AND status='disponivel' AND coalesce(quantidade_reservada,0)=0 AND id<>p_item ORDER BY id LIMIT 1 FOR UPDATE;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 IF v_main.id IS NULL THEN
  UPDATE public.estoque_produto SET status='disponivel' WHERE id=p_item;
  RETURN;
 END IF;
 PERFORM platform_private.stock_motor_item(v_main.id,'cancelamento_reserva','{}'::jsonb);
 IF v_main.envase_id IS DISTINCT FROM v_s.envase_id OR v_main.produto_id IS DISTINCT FROM v_s.produto_id OR v_main.microrganismo_id IS DISTINCT FROM v_s.microrganismo_id OR v_main.validade IS DISTINCT FROM v_s.validade OR v_main.reservado_para_os_id IS NOT NULL OR v_main.reservado_para_cliente_id IS NOT NULL OR v_main.reservado_para_partner_id IS NOT NULL OR v_main.reservado_para_partner_order_id IS NOT NULL THEN RAISE EXCEPTION 'DELIVERY_MERGE_INCOMPATIBLE' USING ERRCODE='PT409'; END IF;
 IF v_main.quantidade IS NULL OR v_main.quantidade<=0 OR v_main.quantidade::text IN ('NaN','Infinity','-Infinity') OR v_main.volume_total IS NULL OR v_main.volume_total<=0 OR v_main.volume_total::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 v_total:=v_main.quantidade+v_s.quantidade; v_volume:=v_main.volume_total+v_s.volume_total;
 IF v_total IS NULL OR v_volume IS NULL OR v_total<=0 OR v_volume<=0 OR v_total::text IN ('NaN','Infinity','-Infinity') OR v_volume::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'DELIVERY_MERGE_BALANCE_DENIED' USING ERRCODE='PT409'; END IF;
 -- Keep source row and immutable movement history; retire it BEFORE growing the unique main row.
 UPDATE public.estoque_produto SET status='estornado',quantidade=0,volume_total=0,quantidade_reservada=0,reservado_para_os_id=NULL,reservado_para_os_tipo=NULL,reservado_para_cliente_id=NULL,reservado_para_partner_id=NULL,reservado_para_partner_order_id=NULL WHERE id=p_item;
 UPDATE public.estoque_produto SET quantidade=v_total,volume_total=v_volume WHERE id=v_main.id;
 IF NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=p_item AND idempotency_key=p_ctx->>'idempotency_key' AND saldo_posterior=0 AND acao='cancelamento_reserva')
 OR NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_main.id AND metadata->>'operacao_key'=p_ctx->>'idempotency_key' AND saldo_anterior=v_main.quantidade AND saldo_posterior=v_total AND volume_posterior=v_volume AND acao='cancelamento_reserva')
 THEN RAISE EXCEPTION 'DELIVERY_MERGE_LEDGER_DENIED' USING ERRCODE='PT409'; END IF;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_merge_split_20261030(uuid,jsonb,jsonb) FROM PUBLIC,anon,authenticated,service_role;

-- Canonical creation overload: manual/internal only; B2B/OnFarm remain contained.
CREATE FUNCTION public.rpc_cockpit_criar_entrega_v1(p_os_id uuid,p_origem text,p_itens jsonb,p_request_key text,p_dados jsonb,p_os_observed timestamptz)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE v_org uuid; v_actor uuid:=auth.uid(); v_os public.ordens_servico%ROWTYPE;
 v_item jsonb; v_id uuid; v_qty numeric; v_items jsonb:='[]'; v_fp text;
 v_prev platform_private.delivery_requests_20261030%ROWTYPE; v_batch jsonb; v_call jsonb;
 v_result jsonb:='[]'; v_index integer:=0; v_ent uuid; v_reserved uuid; v_current timestamptz; v_original_client uuid;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('group');
 IF p_origem IS DISTINCT FROM 'manual' OR p_os_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 IF p_os_observed IS NULL THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_REQUIRED' USING ERRCODE='22023'; END IF;
 IF p_request_key IS NULL OR length(btrim(p_request_key))<8 OR length(p_request_key)>128 THEN RAISE EXCEPTION 'DELIVERY_REQUEST_INVALID' USING ERRCODE='22023'; END IF;
 IF p_dados IS NULL OR jsonb_typeof(p_dados)<>'object' OR EXISTS(SELECT 1 FROM jsonb_each(p_dados) WHERE key NOT IN ('data_saida','motorista','veiculo','tipo_entrega','endereco_origem') OR jsonb_typeof(value) NOT IN ('string','null')) THEN RAISE EXCEPTION 'DELIVERY_DATA_INVALID' USING ERRCODE='22023'; END IF;
 IF p_itens IS NULL OR jsonb_typeof(p_itens)<>'array' THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
 IF jsonb_array_length(p_itens)=0 OR jsonb_array_length(p_itens)>100 THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_os FROM public.ordens_servico WHERE id=p_os_id AND organization_id=v_org;
 IF NOT FOUND OR v_os.partner_order_id IS NOT NULL OR v_os.origem IS DISTINCT FROM 'agronomica' THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_os.updated_at IS DISTINCT FROM p_os_observed THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 v_original_client:=v_os.cliente_id;
 FOR v_item IN SELECT value FROM jsonb_array_elements(p_itens) LOOP
  IF jsonb_typeof(v_item)<>'object' OR NOT(v_item ? 'item_id' AND v_item ? 'quantidade' AND v_item ? 'observed_updated_at') OR v_item->>'observed_updated_at' IS NULL OR EXISTS(SELECT 1 FROM jsonb_each(v_item) WHERE key NOT IN ('item_id','quantidade','observed_updated_at')) THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
  v_id:=(v_item->>'item_id')::uuid; v_qty:=(v_item->>'quantidade')::numeric;
  IF v_id IS NULL OR v_qty IS NULL OR v_qty<=0 OR v_qty::text IN ('NaN','Infinity','-Infinity') OR EXISTS(SELECT 1 FROM jsonb_array_elements(v_items) WHERE value->>'item_id'=v_id::text) THEN RAISE EXCEPTION 'DELIVERY_ITEMS_INVALID' USING ERRCODE='22023'; END IF;
  v_items:=v_items||jsonb_build_array(jsonb_build_object('item_id',v_id,'quantidade',v_qty,'observed_updated_at',(v_item->>'observed_updated_at')::timestamptz));
 END LOOP;
 SELECT jsonb_agg(value ORDER BY value->>'item_id') INTO v_items FROM jsonb_array_elements(v_items);
 v_fp:=md5(jsonb_build_object('actor',v_actor,'org',v_org,'os',p_os_id,'observed',p_os_observed,'origin','manual','items',v_items,'data',p_dados)::text);
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('delivery_request:'||jsonb_build_array(v_org,v_actor,'group',p_request_key)::text,0));
 IF platform_private.delivery_actor_20261030('group') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 -- Canonical global gate is acquired BEFORE every OS/stock row lock.
 PERFORM platform_private.delivery_gate_20261030(v_org,'group');
 SELECT * INTO v_os FROM public.ordens_servico WHERE id=p_os_id AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND OR v_os.partner_order_id IS NOT NULL OR v_os.origem IS DISTINCT FROM 'agronomica' THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF v_os.cliente_id IS DISTINCT FROM v_original_client OR v_os.updated_at IS DISTINCT FROM p_os_observed THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 PERFORM 1 FROM public.clientes WHERE id=v_os.cliente_id AND organization_id=v_org FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  v_id:=(v_item->>'item_id')::uuid;
  PERFORM 1 FROM public.estoque_produto WHERE id=v_id FOR UPDATE;
  PERFORM platform_private.stock_motor_item(v_id,'reserva',jsonb_build_object('os_id',p_os_id,'os_tipo','manual','cliente_id',v_os.cliente_id));
  IF platform_private.delivery_actor_20261030('group') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 END LOOP;
 PERFORM platform_private.delivery_gate_20261030(v_org,'group');
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030 WHERE request_key=p_request_key AND actor=v_actor AND organization_id=v_org AND action='group';
 IF FOUND THEN
  IF v_prev.actor IS DISTINCT FROM v_actor OR v_prev.organization_id IS DISTINCT FROM v_org OR v_prev.action IS DISTINCT FROM 'group' OR v_prev.fingerprint IS DISTINCT FROM v_fp THEN RAISE EXCEPTION 'DELIVERY_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 IF v_os.updated_at IS DISTINCT FROM p_os_observed OR v_os.status::text<>'pronto_entrega' THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  SELECT updated_at INTO v_current FROM public.estoque_produto WHERE id=(v_item->>'item_id')::uuid;
  IF v_current IS DISTINCT FROM (v_item->>'observed_updated_at')::timestamptz THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 END LOOP;
 IF EXISTS(SELECT 1 FROM public.entregas WHERE ordem_servico_id=p_os_id AND status::text<>'cancelada' AND estoque_produto_id IN (SELECT (value->>'item_id')::uuid FROM jsonb_array_elements(v_items))) THEN RAISE EXCEPTION 'DELIVERY_EXISTING_UNOWNED' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target) VALUES(pg_catalog.txid_current(),v_actor,v_org,'group',p_os_id);
 v_batch:=public.rpc_estoque_reservar_v1(p_os_id,'manual',(SELECT jsonb_agg(value-'observed_updated_at') FROM jsonb_array_elements(v_items)),'delivery-reserve:'||md5(jsonb_build_array(v_actor,v_org,p_request_key)::text),jsonb_build_object('cliente_id',v_os.cliente_id));
 IF v_batch->>'ok' IS DISTINCT FROM 'true' OR v_batch->>'replay' IS DISTINCT FROM 'false' OR jsonb_array_length(v_batch->'itens')<>jsonb_array_length(v_items) THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 IF NOT EXISTS(SELECT 1 FROM platform_private.stock_batch_requests WHERE request_key='delivery-reserve:'||md5(jsonb_build_array(v_actor,v_org,p_request_key)::text) AND result=v_batch) THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 FOR v_item IN SELECT value FROM jsonb_array_elements(v_items) LOOP
  v_reserved:=(v_batch->'itens'->>v_index)::uuid; v_qty:=(v_item->>'quantidade')::numeric;
  IF v_reserved IS NULL THEN RAISE EXCEPTION 'DELIVERY_RESERVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  PERFORM platform_private.delivery_gate_20261030(v_org,'group');
  UPDATE platform_private.delivery_context_20261030 SET item=v_reserved,delivery=NULL,mutation='create' WHERE txid=pg_catalog.txid_current();
  v_call:=public.rpc_cockpit_criar_entrega_v1(p_os_id,'manual',v_reserved,v_qty,p_dados||jsonb_build_object('cliente_id',v_os.cliente_id));
  IF v_call->>'success' IS DISTINCT FROM 'true' OR v_call->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CREATE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  v_ent:=(v_call->>'entrega_id')::uuid;
  IF v_ent IS NULL OR NOT EXISTS(SELECT 1 FROM public.entregas WHERE id=v_ent AND organization_id=v_org AND ordem_servico_id=p_os_id AND estoque_produto_id=v_reserved AND quantidade_entregue=v_qty AND receivable_id IS NULL AND partner_order_id IS NULL) THEN RAISE EXCEPTION 'DELIVERY_CREATE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  v_call:=public.rpc_estoque_operar_v1('expedicao',v_reserved,v_qty,'delivery-exp:'||md5(jsonb_build_array(v_actor,v_org,p_request_key,v_index)::text),jsonb_build_object('referencia_tipo','entrega','referencia_id',v_ent,'os_id',p_os_id,'os_tipo','manual','cliente_id',v_os.cliente_id));
  IF v_call->>'ok' IS DISTINCT FROM 'true' OR v_call->>'replay' IS DISTINCT FROM 'false' OR NOT EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE id=(v_call->>'movimentacao_id')::uuid AND estoque_produto_id=v_reserved AND referencia_id=v_ent AND referencia_tipo='entrega' AND acao='expedicao' AND usuario_id=v_actor) THEN RAISE EXCEPTION 'DELIVERY_MOVE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  PERFORM platform_private.delivery_gate_20261030(v_org,'group');
  v_result:=v_result||jsonb_build_array(jsonb_build_object('entrega_id',v_ent,'estoque_produto_id',v_reserved,'movimentacao_id',v_call->>'movimentacao_id'));
  v_index:=v_index+1;
 END LOOP;
 v_call:=jsonb_build_object('success',true,'replay',false,'organization_id',v_org,'os_id',p_os_id,'itens',v_result);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_request_key,v_actor,v_org,'group',v_fp,v_call);
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current();
 RETURN v_call;
END $$;
REVOKE ALL ON FUNCTION public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz) FROM PUBLIC,anon,authenticated,service_role;

-- Legacy remains deny-only; observed contract is a separate reviewed overload.
CREATE OR REPLACE FUNCTION public.rpc_entrega_cancelar_v1(p_entrega_id uuid,p_motivo text)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
BEGIN RAISE EXCEPTION 'DELIVERY_LEGACY_CLOSED' USING ERRCODE='42501'; END $$;
REVOKE ALL ON FUNCTION public.rpc_entrega_cancelar_v1(uuid,text) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION public.rpc_entrega_cancelar_v1(p_entrega_id uuid,p_motivo text,p_observed timestamptz)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE v_org uuid; v_actor uuid:=auth.uid(); v_e public.entregas%ROWTYPE; v_s public.estoque_produto%ROWTYPE;
 v_m public.estoque_movimentacoes%ROWTYPE; v_result jsonb; v_key text; v_fp text; v_prev platform_private.delivery_requests_20261030%ROWTYPE;
BEGIN
 v_org:=platform_private.delivery_actor_20261030('cancel');
 IF p_entrega_id IS NULL OR p_motivo IS NULL OR length(btrim(p_motivo))=0 OR p_observed IS NULL THEN RAISE EXCEPTION 'DELIVERY_CANCEL_INVALID' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtext('entrega_cancelar:'||p_entrega_id::text));
 IF platform_private.delivery_actor_20261030('cancel') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF platform_private.delivery_actor_20261030('cancel') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF v_e.ordem_servico_onfarm_id IS NOT NULL OR v_e.partner_order_id IS NOT NULL OR v_e.receivable_id IS NOT NULL OR v_e.status::text='entregue'
 OR NOT EXISTS(SELECT 1 FROM public.ordens_servico WHERE id=v_e.ordem_servico_id AND organization_id=v_org AND origem='agronomica' AND partner_order_id IS NULL)
 THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 v_key:='cancel:'||p_entrega_id::text; v_fp:=md5(jsonb_build_array(v_actor,v_org,p_entrega_id,btrim(p_motivo),p_observed)::text);
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=v_e.estoque_produto_id FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_STOCK_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.stock_motor_item(v_s.id,'cancelamento_reserva',jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id));
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 PERFORM 1 FROM public.ordens_servico WHERE id=v_e.ordem_servico_id AND organization_id=v_org AND origem='agronomica' AND partner_order_id IS NULL AND cliente_id=v_e.cliente_id FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ORIGIN_CLOSED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.clientes WHERE id=v_e.cliente_id AND organization_id=v_org FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030 WHERE request_key=v_key AND actor=v_actor AND organization_id=v_org AND action='cancel';
 IF FOUND THEN
  IF v_prev.actor IS DISTINCT FROM v_actor OR v_prev.organization_id IS DISTINCT FROM v_org OR v_prev.fingerprint IS DISTINCT FROM v_fp OR v_prev.action IS DISTINCT FROM 'cancel' OR v_e.status::text<>'cancelada' THEN RAISE EXCEPTION 'DELIVERY_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN v_prev.result||jsonb_build_object('replay',true);
 END IF;
 IF v_e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 IF v_e.status::text NOT IN ('separado','em_rota') OR v_s.reservado_para_os_id IS DISTINCT FROM v_e.ordem_servico_id OR v_s.reservado_para_os_tipo IS DISTINCT FROM 'manual' THEN RAISE EXCEPTION 'DELIVERY_CANCEL_STATE_CONFLICT' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target) VALUES(pg_catalog.txid_current(),v_actor,v_org,'cancel',v_e.id);
 IF (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_s.id AND referencia_tipo='entrega' AND referencia_id=v_e.id AND acao='expedicao')<>1 THEN RAISE EXCEPTION 'DELIVERY_CANCEL_LEDGER_UNPROVEN' USING ERRCODE='PT409'; END IF;
 SELECT * INTO v_m FROM public.estoque_movimentacoes WHERE estoque_produto_id=v_s.id AND referencia_tipo='entrega' AND referencia_id=v_e.id AND acao='expedicao' FOR UPDATE;
 v_result:=public.rpc_estoque_operar_v1('estorno_expedicao',v_s.id,NULL,'delivery-cancel-exp:'||v_e.id::text,jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id,'movimentacao_origem_id',v_m.id,'motivo',btrim(p_motivo)));
 IF v_result->>'ok' IS DISTINCT FROM 'true' OR v_result->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 SELECT * INTO v_s FROM public.estoque_produto WHERE id=v_e.estoque_produto_id;
 IF v_s.status::text<>'reservado' OR v_s.quantidade_reservada IS DISTINCT FROM v_e.quantidade_entregue THEN RAISE EXCEPTION 'DELIVERY_CANCEL_BALANCE_CONFLICT' USING ERRCODE='PT409'; END IF;
 v_result:=public.rpc_estoque_operar_v1('cancelamento_reserva',v_s.id,v_s.quantidade_reservada,'delivery-cancel-res:'||v_e.id::text,jsonb_build_object('referencia_tipo','entrega','referencia_id',v_e.id,'motivo',btrim(p_motivo)));
 IF v_result->>'ok' IS DISTINCT FROM 'true' OR v_result->>'replay' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'DELIVERY_CANCEL_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_gate_20261030(v_org,'cancel');
 UPDATE platform_private.delivery_context_20261030 SET mutation='cancel' WHERE txid=pg_catalog.txid_current();
 UPDATE public.entregas SET status='cancelada',motivo_cancelamento=btrim(p_motivo) WHERE id=v_e.id AND organization_id=v_org;
 IF NOT FOUND OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND consumed) THEN RAISE EXCEPTION 'DELIVERY_CANCEL_TICKET_INVALID' USING ERRCODE='42501'; END IF;
 v_result:=jsonb_build_object('success',true,'replay',false,'organization_id',v_org,'entrega_id',v_e.id,'estoque_estornado',true,'reserva_liberada',true);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(v_key,v_actor,v_org,'cancel',v_fp,v_result);
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current();
 RETURN v_result;
END $$;
REVOKE ALL ON FUNCTION public.rpc_entrega_cancelar_v1(uuid,text,timestamptz) FROM PUBLIC,anon,authenticated,service_role;