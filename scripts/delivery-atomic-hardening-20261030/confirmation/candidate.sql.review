-- Review-only manual physical confirmation. Never dispatches stock or billing.
CREATE FUNCTION platform_private.delivery_confirm_actor_v1()
RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid; BEGIN
 org:=public.h15_actor_organization();
 IF auth.uid() IS NULL OR org IS NULL
 OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor','consultor_tecnico','aplicador','operador_onfarm','superadmin'))
 OR EXISTS(SELECT 1 FROM public.partner_users WHERE user_id=auth.uid() AND revoked_at IS NULL AND (valid_from IS NULL OR valid_from<=now()))
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND role IN ('administrador','gestor','administrativo','producao'))
 OR NOT public.saas_has_feature('estoque_embalagens') OR NOT public.saas_has_feature('ordens_producao')
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN org;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_confirm_actor_v1() FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.delivery_confirm_recheck_v1(p_id uuid,p_org uuid)
RETURNS public.entregas LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE e public.entregas; BEGIN
 IF platform_private.delivery_confirm_actor_v1() IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 SELECT * INTO e FROM public.entregas WHERE id=p_id AND organization_id=p_org;
 IF NOT FOUND OR e.ordem_servico_id IS NULL OR e.partner_order_id IS NOT NULL OR e.ordem_servico_onfarm_id IS NOT NULL OR e.receivable_id IS NOT NULL OR e.os_faturamento_base_id IS NOT NULL
 OR NOT EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id WHERE o.id=e.ordem_servico_id AND o.organization_id=p_org AND c.organization_id=p_org AND o.cliente_id=e.cliente_id AND o.origem='agronomica' AND o.partner_order_id IS NULL)
 OR EXISTS(SELECT 1 FROM public.production_order_link WHERE ordem_servico_id=e.ordem_servico_id)
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN e;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_confirm_recheck_v1(uuid,uuid) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.delivery_confirm_proof_v1(p_e public.entregas)
RETURNS public.entrega_comprovantes LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE c public.entrega_comprovantes; path text; owner_actor uuid; BEGIN
 SELECT * INTO c FROM public.entrega_comprovantes WHERE id=p_e.comprovante_id AND entrega_id=p_e.id;
 IF NOT FOUND OR c.status IS NULL OR c.status NOT IN ('anexado','assinatura_digital_coletada','assinado','confirmado') OR p_e.validation_token IS DISTINCT FROM c.validation_token
 OR p_e.validation_hash IS DISTINCT FROM c.validation_hash OR c.validation_token IS NULL OR c.validation_hash IS NULL OR c.tipo IS DISTINCT FROM 'formulario_entrega'
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_PROOF_DENIED' USING ERRCODE='42501'; END IF;
 IF p_e.assinatura_obrigatoria AND (c.assinatura_coletada IS NOT TRUE OR c.status NOT IN ('anexado','assinatura_digital_coletada','assinado','confirmado') OR nullif(btrim(c.recebedor_nome),'') IS NULL)
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_SIGNATURE_REQUIRED' USING ERRCODE='42501'; END IF;
 IF c.assinatura_tipo='digital_tela' AND c.assinatura_coletada THEN
  path:=c.assinatura_digital_png_path; owner_actor:=p_e.assinatura_digital_capturada_por;
  IF path IS NULL OR path !~ ('^entregas/'||p_e.id::text||'/assinaturas/[0-9a-f-]{36}\.png$') OR coalesce(c.assinatura_hash,'') !~ '^[0-9a-f]{64}$' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
 ELSIF c.assinatura_tipo='fisica_anexada' OR c.arquivo_path IS NOT NULL THEN
  path:=c.arquivo_path; owner_actor:=c.anexado_por;
  IF path IS NULL OR path !~ ('^entregas/'||p_e.id::text||'/comprovantes/[0-9a-f-]{36}\.(pdf|png|jpg|jpeg|webp)$') THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
 ELSIF p_e.comprovante_entrega_obrigatorio OR p_e.assinatura_obrigatoria THEN
  RAISE EXCEPTION 'DELIVERY_CONFIRM_OBJECT_REQUIRED' USING ERRCODE='42501';
 END IF;
 IF path IS NOT NULL THEN
  -- Owner is the immutable canonical proof writer, never current profile ownership.
  IF owner_actor IS NULL OR NOT EXISTS(SELECT 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=path AND owner_id=owner_actor::text)
   OR EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE id<>c.id AND (arquivo_path=path OR assinatura_digital_png_path=path))
  THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN c;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_confirm_proof_v1(public.entregas) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.delivery_confirm_apply_v1(p_entrega uuid,p_observed timestamptz,p_key text,p_recebedor jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE org uuid; v_actor uuid:=auth.uid(); e public.entregas; initial public.entregas; s public.estoque_produto; l public.lotes; pp public.programacao_producao; c public.entrega_comprovantes; prev platform_private.delivery_requests_20261030;
 fp text; result jsonb; ack jsonb; pend int; total numeric; reserved numeric; finalizada boolean:=false; os_status text; p jsonb; k text; v jsonb; path text; image jsonb; proof_image jsonb;
BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 org:=platform_private.delivery_confirm_actor_v1();
 IF p_entrega IS NULL OR p_observed IS NULL OR p_key IS NULL OR p_key !~ '^[A-Za-z0-9:_-]{8,128}$' OR p_recebedor IS NULL OR jsonb_typeof(p_recebedor)<>'object' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
 p:='{}';
 FOR k,v IN SELECT * FROM jsonb_each(p_recebedor) LOOP
  IF k NOT IN ('nome','cargo','documento','observacoes') OR jsonb_typeof(v) NOT IN ('string','null') OR length(coalesce(v#>>'{}',''))>(CASE WHEN k='observacoes' THEN 1000 ELSE 255 END) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_INVALID' USING ERRCODE='22023'; END IF;
  p:=p||jsonb_build_object(k,nullif(btrim(v#>>'{}'),''));
 END LOOP;
 IF nullif(p->>'nome','') IS NULL THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_RECEIVER_REQUIRED' USING ERRCODE='22023'; END IF;
 initial:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 fp:=encode(extensions.digest(jsonb_build_array(v_actor,org,p_entrega,p_observed,p)::text,'sha256'),'hex');
 PERFORM pg_advisory_xact_lock(hashtextextended('delivery_confirm:'||jsonb_build_array(v_actor,org,p_key)::text,0));
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.organizations WHERE id=org AND ativo FOR SHARE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.ordens_servico WHERE id=initial.ordem_servico_id AND organization_id=org FOR UPDATE;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 PERFORM 1 FROM public.entregas WHERE id=p_entrega AND organization_id=org FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF e.ordem_servico_id IS DISTINCT FROM initial.ordem_servico_id OR e.estoque_produto_id IS DISTINCT FROM initial.estoque_produto_id OR e.cliente_id IS DISTINCT FROM initial.cliente_id OR e.lote_id IS DISTINCT FROM initial.lote_id THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ROOT_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.clientes WHERE id=e.cliente_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO s FROM public.estoque_produto WHERE id=e.estoque_produto_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO l FROM public.lotes WHERE id=s.lote_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT * INTO pp FROM public.programacao_producao WHERE id=l.programacao_id AND organization_id=org FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 IF s.id IS NULL OR l.id IS NULL OR pp.id IS NULL OR e.lote_id IS DISTINCT FROM l.id OR pp.ordem_servico_id IS DISTINCT FROM e.ordem_servico_id OR pp.ordem_servico_onfarm_id IS NOT NULL
 OR s.produto_id IS DISTINCT FROM l.produto_id OR e.produto_id IS DISTINCT FROM l.produto_id OR pp.produto_id IS DISTINCT FROM l.produto_id
 OR s.reservado_para_os_id IS DISTINCT FROM e.ordem_servico_id OR s.reservado_para_os_tipo IS DISTINCT FROM 'manual' OR s.reservado_para_cliente_id IS DISTINCT FROM e.cliente_id OR s.reservado_para_partner_order_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.entrega_comprovantes WHERE id=e.comprovante_id FOR UPDATE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 c:=platform_private.delivery_confirm_proof_v1(e);
 path:=CASE WHEN c.assinatura_tipo='digital_tela' THEN c.assinatura_digital_png_path ELSE c.arquivo_path END;
 IF path IS NOT NULL THEN
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=path FOR SHARE;
  e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org); c:=platform_private.delivery_confirm_proof_v1(e);
 END IF;
 SELECT * INTO prev FROM platform_private.delivery_requests_20261030 WHERE organization_id=org AND actor=v_actor AND action='confirm' AND request_key=p_key;
 IF FOUND THEN
  SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
  IF os_status NOT IN ('entregue','finalizada') OR s.status::text<>'expedido' OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
   OR (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue)<>1
   OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('entrega','estorno_expedicao','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_STATE_DENIED' USING ERRCODE='42501'; END IF;
  IF prev.fingerprint IS DISTINCT FROM fp OR e.status::text<>'entregue' OR c.status<>'confirmado' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_REPLAY_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN prev.result||jsonb_build_object('replay',true);
 END IF;
 IF e.status::text='entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEGACY_REVIEW_REQUIRED' USING ERRCODE='PT409'; END IF;
 IF e.status::text NOT IN ('separado','em_rota') OR e.updated_at IS DISTINCT FROM p_observed THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_OBSERVED_CONFLICT' USING ERRCODE='PT409'; END IF;
 SELECT status::text INTO os_status FROM public.ordens_servico WHERE id=e.ordem_servico_id;
 IF os_status NOT IN ('pronto_entrega','entregue') OR s.status::text<>'expedido' OR e.quantidade_entregue IS NULL OR e.quantidade_entregue<=0 OR e.quantidade_entregue::text IN ('NaN','Infinity','-Infinity')
 OR s.quantidade IS DISTINCT FROM e.quantidade_entregue OR s.quantidade_reservada IS DISTINCT FROM e.quantidade_entregue
 THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_STATE_CONFLICT' USING ERRCODE='PT409'; END IF;
 -- Expedition was already performed by the reviewed group motor. Do not repeat it.
 IF (SELECT count(*) FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_tipo='entrega' AND referencia_id=e.id AND acao='expedicao' AND quantidade=e.quantidade_entregue AND os_id=e.ordem_servico_id AND os_tipo='manual' AND lote_id=l.id)<>1
 OR EXISTS(SELECT 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id AND acao IN ('estorno_expedicao','entrega','devolucao')) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_LEDGER_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.estoque_movimentacoes WHERE estoque_produto_id=s.id AND referencia_id=e.id ORDER BY id FOR SHARE;
 e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 image:=to_jsonb(e)||jsonb_build_object('status','entregue','entregue_em',now(),'recebido_por_nome',p->>'nome','recebido_por_cargo',coalesce(p->>'cargo',e.recebido_por_cargo),'recebido_por_documento',coalesce(p->>'documento',e.recebido_por_documento),'observacoes_confirmacao',coalesce(p->>'observacoes',e.observacoes_confirmacao),'confirmado_por',v_actor,'recebimento_confirmado_em',now(),'recebimento_confirmado_por',v_actor,'comprovante_status','confirmado','updated_at',now());
 proof_image:=to_jsonb(c)||jsonb_build_object('status','confirmado','confirmado_por',v_actor,'confirmado_em',now(),'updated_at',now());
 INSERT INTO platform_private.delivery_confirm_permits_v1(txid,actor,organization_id,target,proof,old_delivery,new_delivery,old_proof,new_proof) VALUES(txid_current(),v_actor,org,e.id,c.id,to_jsonb(e),image,to_jsonb(c),proof_image);
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation) VALUES(txid_current(),v_actor,org,'confirm',e.id,'confirm');
 UPDATE public.entrega_comprovantes SET status='confirmado',confirmado_por=v_actor,confirmado_em=now(),updated_at=now() WHERE id=c.id;
 c:=platform_private.delivery_confirm_proof_v1(e);
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 UPDATE public.entregas SET status='entregue',entregue_em=now(),recebido_por_nome=p->>'nome',recebido_por_cargo=coalesce(p->>'cargo',recebido_por_cargo),recebido_por_documento=coalesce(p->>'documento',recebido_por_documento),observacoes_confirmacao=coalesce(p->>'observacoes',observacoes_confirmacao),confirmado_por=v_actor,
 recebimento_confirmado_em=now(),recebimento_confirmado_por=v_actor,comprovante_status='confirmado' WHERE id=e.id AND updated_at=p_observed;
 IF NOT FOUND OR NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=txid_current() AND mutation='done') THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','enviar_entrega',NULL);
 IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'entregue' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_ADVANCE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 SELECT count(*) FILTER(WHERE status::text NOT IN ('entregue','cancelada')),coalesce(sum(quantidade_entregue) FILTER(WHERE status::text='entregue'),0) INTO pend,total FROM public.entregas WHERE ordem_servico_id=e.ordem_servico_id;
 SELECT coalesce(sum(quantidade_reservada),0) INTO reserved FROM public.estoque_produto WHERE reservado_para_os_id=e.ordem_servico_id AND reservado_para_os_tipo='manual' AND status::text<>'estornado';
 IF pend=0 AND reserved>0 AND total>=reserved THEN
  ack:=public._rpc_avancar_esteira_laboratorio_internal(e.ordem_servico_id,'manual','finalizar_os',NULL);
  IF ack->>'success' IS DISTINCT FROM 'true' OR (SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id) IS DISTINCT FROM 'finalizada' THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_FINALIZE_ACK_INVALID' USING ERRCODE='PT409'; END IF;
  finalizada:=true;
 END IF;
 PERFORM platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 result:=jsonb_build_object('success',true,'action','confirm','replay',false,'actor_id',v_actor,'organization_id',org,'entrega_id',e.id,'os_id',e.ordem_servico_id,'comprovante_id',c.id,'status','entregue','os_status',(SELECT status::text FROM public.ordens_servico WHERE id=e.ordem_servico_id),'finalizada',finalizada,'updated_at',(SELECT updated_at FROM public.entregas WHERE id=e.id));
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result) VALUES(p_key,v_actor,org,'confirm',fp,result);
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current() AND delivery_consumed AND proof_consumed) THEN RAISE EXCEPTION 'DELIVERY_CONFIRM_EXACT_PERMIT_UNUSED' USING ERRCODE='42501'; END IF;
 DELETE FROM platform_private.delivery_confirm_permits_v1 WHERE txid=txid_current();
 DELETE FROM platform_private.delivery_context_20261030 WHERE txid=txid_current();
 RETURN result;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_confirm_apply_v1(uuid,timestamptz,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION public.rpc_entrega_confirmar_manual_v1(p_entrega uuid,p_observed timestamptz,p_request_key text,p_recebedor jsonb)
RETURNS jsonb LANGUAGE sql VOLATILE SECURITY DEFINER SET search_path='' AS $$ SELECT platform_private.delivery_confirm_apply_v1(p_entrega,p_observed,p_request_key,p_recebedor) $$;
REVOKE ALL ON FUNCTION public.rpc_entrega_confirmar_manual_v1(uuid,timestamptz,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;

CREATE OR REPLACE FUNCTION platform_private.delivery_mutation_guard_20261030()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE c platform_private.delivery_context_20261030%ROWTYPE; v_org uuid;
 v_proof text[]:=ARRAY['comprovante_status','assinatura_tipo','recebedor_nome','recebedor_documento','recebedor_cargo','recebedor_telefone','comprovante_anexado_em','comprovante_anexado_por','assinatura_digital_capturada_em','assinatura_digital_capturada_por','comprovante_id','formulario_gerado_em','formulario_gerado_por','validation_token','validation_hash','updated_at'];
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 SELECT * INTO c FROM platform_private.delivery_context_20261030
 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid();
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='confirm' THEN
  v_org:=platform_private.delivery_confirm_actor_v1();
  IF TG_OP='UPDATE' AND c.mutation='confirm' AND c.organization_id=v_org AND NEW.id=c.target AND OLD.id=c.target
   AND NEW.organization_id=OLD.organization_id AND OLD.organization_id=v_org AND OLD.status::text IN ('separado','em_rota') AND NEW.status::text='entregue'
   AND NEW.confirmado_por=auth.uid() AND NEW.recebimento_confirmado_por=auth.uid()
   AND (to_jsonb(NEW)-ARRAY['status','entregue_em','recebido_por_nome','recebido_por_cargo','recebido_por_documento','observacoes_confirmacao','confirmado_por','recebimento_confirmado_em','recebimento_confirmado_por','comprovante_status','updated_at'])
    IS NOT DISTINCT FROM (to_jsonb(OLD)-ARRAY['status','entregue_em','recebido_por_nome','recebido_por_cargo','recebido_por_documento','observacoes_confirmacao','confirmado_por','recebimento_confirmado_em','recebimento_confirmado_por','comprovante_status','updated_at'])
  THEN UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid; RETURN NEW; END IF;
  RAISE EXCEPTION 'DELIVERY_CONFIRM_MUTATION_DENIED' USING ERRCODE='42501';
 END IF;
 IF c.action='proof' THEN
  v_org:=platform_private.delivery_proof_actor_20261030();
  IF TG_OP='UPDATE' AND c.mutation='proof' AND c.organization_id=v_org AND NEW.id=c.target AND OLD.id=c.target
  AND OLD.organization_id=v_org AND NEW.organization_id=v_org
  AND OLD.partner_order_id IS NULL AND NEW.partner_order_id IS NULL
  AND OLD.ordem_servico_onfarm_id IS NULL AND NEW.ordem_servico_onfarm_id IS NULL
  AND NEW.status=OLD.status AND NEW.receivable_id IS NOT DISTINCT FROM OLD.receivable_id
  AND (pg_catalog.to_jsonb(NEW)-v_proof) IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-v_proof) THEN
   UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
   RETURN NEW;
  END IF;
  RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501';
 END IF;
 v_org:=platform_private.delivery_actor_20261030(c.action);
 IF c.organization_id IS DISTINCT FROM v_org OR NEW.organization_id IS DISTINCT FROM v_org
 OR NEW.partner_order_id IS NOT NULL OR NEW.receivable_id IS NOT NULL OR NEW.ordem_servico_onfarm_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='group' AND TG_OP='INSERT' AND c.mutation='create' AND c.delivery IS NULL
 AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item AND NEW.status::text='separado' THEN
  UPDATE platform_private.delivery_context_20261030 SET delivery=NEW.id,mutation='decorate' WHERE txid=c.txid;
 ELSIF c.action='group' AND TG_OP='UPDATE' AND c.mutation='decorate' AND NEW.id=c.delivery
 AND OLD.id=c.delivery AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item
 AND NEW.organization_id=OLD.organization_id AND NEW.status=OLD.status THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSIF c.action='cancel' AND TG_OP='UPDATE' AND c.mutation='cancel' AND NEW.id=c.target AND OLD.id=c.target
 AND OLD.organization_id=v_org AND NEW.status::text='cancelada' AND NEW.financial_status='CANCELED'
 AND (pg_catalog.to_jsonb(NEW)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status'])
 IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status']) THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSE RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_mutation_guard_20261030() FROM PUBLIC,anon,authenticated,service_role;


CREATE OR REPLACE FUNCTION public.fn_validate_entrega_confirmacao()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_anexos int;
BEGIN
  IF NEW.status::text = 'entregue'
     AND (TG_OP = 'INSERT' OR OLD.status::text IS DISTINCT FROM 'entregue') THEN

    IF TG_OP = 'UPDATE' AND OLD.status::text = 'cancelada' THEN
      RAISE EXCEPTION 'Não é possível confirmar uma entrega cancelada.'
        USING ERRCODE = 'check_violation';
    END IF;

    IF COALESCE(TRIM(NEW.recebido_por_nome), '') = '' THEN
      RAISE EXCEPTION 'Informe o nome de quem recebeu a entrega.'
        USING ERRCODE = 'check_violation';
    END IF;

    IF NEW.confirmado_por IS NULL THEN
      RAISE EXCEPTION 'A entrega precisa ser confirmada por um usuário autenticado.'
        USING ERRCODE = 'check_violation';
    END IF;

    IF NEW.entregue_em IS NULL THEN
      NEW.entregue_em := now();
    END IF;

    IF NEW.comprovante_entrega_obrigatorio THEN
      PERFORM platform_private.delivery_confirm_proof_v1(NEW);
      v_anexos:=1;
      IF v_anexos = 0 THEN
        RAISE EXCEPTION 'É obrigatório anexar pelo menos um comprovante para confirmar esta entrega.'
          USING ERRCODE = 'check_violation';
      END IF;
    END IF;
  END IF;

  RETURN NEW;
END;
$function$
;
CREATE FUNCTION public.rpc_entrega_confirmacao_capability_v1(p_entrega uuid) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE org uuid; e public.entregas; available boolean:=false; BEGIN
 BEGIN org:=platform_private.delivery_confirm_actor_v1(); e:=platform_private.delivery_confirm_recheck_v1(p_entrega,org);
 available:=has_function_privilege('authenticated','public.rpc_entrega_confirmar_manual_v1(uuid,timestamptz,text,jsonb)','EXECUTE') AND e.status::text IN ('separado','em_rota','entregue');
 EXCEPTION WHEN insufficient_privilege THEN available:=false; END;
 RETURN jsonb_build_object('capability','delivery_confirmation_manual_v1','available',available,'actor_id',auth.uid(),'organization_id',org,'entrega_id',p_entrega,'updated_at',e.updated_at,'status',e.status::text);
END $$;
REVOKE ALL ON FUNCTION public.rpc_entrega_confirmacao_capability_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_entrega_confirmacao_capability_v1(uuid) TO authenticated;

