-- INACTIVE A2. Not a release. No GRANT.
CREATE OR REPLACE FUNCTION public.fn_generate_receivable_from_entrega(_entrega_id uuid, _payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
 SET lock_timeout TO '3s'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_org uuid; v_initial_org uuid; v_ar public.accounts_receivable%ROWTYPE;
  v_entrega public.entregas%ROWTYPE;
  v_receivable_id uuid;
  v_total numeric(14,2);
  v_total_raw numeric;
  v_canon jsonb;
  v_canon_valor numeric;
  v_canon_origem text;
  v_manual boolean;
  v_manual_reason text;
  v_count integer;
  v_category uuid; v_cost_center uuid; v_payment_method uuid;
  v_first_due date; v_issue date;
  v_fiscal_required boolean; v_fiscal_status text;
  v_installments jsonb; v_sum numeric := 0; v_inst jsonb;
  v_num integer; v_due date; v_amt numeric; v_seen integer[] := '{}';
  v_desc text; v_notes text; v_guard jsonb;
BEGIN
  IF current_setting('transaction_isolation') <> 'read committed' THEN RAISE EXCEPTION 'DELIVERY_FINANCE_ISOLATION_UNSUPPORTED' USING ERRCODE='25000'; END IF;
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'Sessão inválida.' USING ERRCODE='insufficient_privilege';
  END IF;
  IF _entrega_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;

  -- 1) canonical revocation gate, then fresh authority
  PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'gate_unavailable' USING ERRCODE='55000'; END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  v_initial_org := v_org;

  -- 2) per-delivery serialization, then fresh authority
  PERFORM pg_advisory_xact_lock(hashtextextended('entrega_faturar:' || _entrega_id::text, 0));
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_org IS DISTINCT FROM v_initial_org THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;

  -- 3) tenant-scoped row lock; another tenant's row is indistinguishable from absent
  SELECT * INTO v_entrega FROM public.entregas
   WHERE id = _entrega_id AND organization_id = v_org FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'Sem permissão para faturar entregas.' USING ERRCODE='insufficient_privilege';
  END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_org IS DISTINCT FROM v_initial_org THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;

  -- Do not infer supplier-finance authority from B2B roles or order linkage.
  IF v_entrega.partner_order_id IS NOT NULL OR v_entrega.ordem_servico_onfarm_id IS NOT NULL THEN
    RAISE EXCEPTION 'DELIVERY_FINANCE_ORIGIN_UNREVIEWED' USING ERRCODE='42501';
  END IF;
  IF v_entrega.cliente_id IS NULL OR NOT EXISTS(SELECT 1 FROM public.clientes c
    WHERE c.id=v_entrega.cliente_id AND c.organization_id=v_org) THEN
    RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501';
  END IF;
  -- A stale/foreign link must never be returned as a successful replay.
  IF v_entrega.receivable_id IS NOT NULL THEN
    SELECT * INTO v_ar FROM public.accounts_receivable
     WHERE id=v_entrega.receivable_id AND organization_id=v_org
       AND origin_type='DELIVERY' AND origin_id=_entrega_id
       AND customer_id=v_entrega.cliente_id AND status<>'CANCELED';
    IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_RECEIVABLE_LINK_INVALID' USING ERRCODE='PT409'; END IF;
    IF _payload IS NULL OR jsonb_typeof(_payload)<>'object'
      OR round((_payload->>'total_amount')::numeric,2) IS DISTINCT FROM v_ar.total_amount
      OR NULLIF(_payload->>'category_id','')::uuid IS DISTINCT FROM v_ar.category_id
      OR NULLIF(_payload->>'payment_method_id','')::uuid IS DISTINCT FROM v_ar.payment_method_id
      OR COALESCE((_payload->>'installment_count')::int,1) IS DISTINCT FROM v_ar.installment_count
      OR COALESCE((_payload->>'issue_date')::date,v_ar.issue_date) IS DISTINCT FROM v_ar.issue_date
      OR COALESCE((_payload->>'first_due_date')::date,v_ar.first_due_date) IS DISTINCT FROM v_ar.first_due_date
      OR NULLIF(_payload->>'cost_center_id','')::uuid IS DISTINCT FROM v_ar.cost_center_id
      OR COALESCE((_payload->>'fiscal_invoice_required')::boolean,false) IS DISTINCT FROM v_ar.fiscal_invoice_required
      OR (_payload ? 'installments' AND jsonb_typeof(_payload->'installments') NOT IN ('array','null'))
      OR (CASE WHEN jsonb_typeof(_payload->'installments')='array' AND jsonb_array_length(_payload->'installments')>0 THEN
        jsonb_array_length(_payload->'installments')<>v_ar.installment_count
        OR (SELECT count(DISTINCT (x->>'installment_number')::int) FROM jsonb_array_elements(_payload->'installments') x)<>v_ar.installment_count
        OR EXISTS(SELECT 1 FROM jsonb_array_elements(_payload->'installments') x WHERE (x->>'installment_number')::int NOT BETWEEN 1 AND v_ar.installment_count)
        OR EXISTS(SELECT 1 FROM jsonb_array_elements(_payload->'installments') x FULL JOIN
          (SELECT installment_number,due_date,original_amount FROM public.accounts_receivable_installments
            WHERE receivable_id=v_ar.id AND organization_id=v_org) i
          ON i.installment_number=(x->>'installment_number')::int
          WHERE i.installment_number IS NULL OR x IS NULL OR i.due_date IS DISTINCT FROM (x->>'due_date')::date
            OR i.original_amount IS DISTINCT FROM (x->>'amount')::numeric) ELSE false END) THEN
      RAISE EXCEPTION 'DELIVERY_REPLAY_INTENT_CONFLICT' USING ERRCODE='PT409';
    END IF;
    RETURN v_ar.id;
  END IF;
  IF EXISTS(SELECT 1 FROM public.accounts_receivable WHERE origin_type='DELIVERY'
     AND origin_id=_entrega_id AND status<>'CANCELED') THEN
    RAISE EXCEPTION 'DELIVERY_RECEIVABLE_LINK_INVALID' USING ERRCODE='PT409';
  END IF;

  IF v_entrega.status = 'cancelada' THEN
    RAISE EXCEPTION 'Entrega cancelada não pode ser faturada.' USING ERRCODE='PT409';
  END IF;
  IF v_entrega.status <> 'entregue' THEN
    RAISE EXCEPTION 'Entrega precisa estar com status "entregue" para faturar.' USING ERRCODE='PT409';
  END IF;
  IF v_entrega.cliente_id IS NULL THEN
    RAISE EXCEPTION 'Entrega sem cliente vinculado.' USING ERRCODE='check_violation';
  END IF;
  IF v_entrega.financial_status = 'NOT_BILLABLE' THEN
    RAISE EXCEPTION 'Entrega marcada como não faturável.' USING ERRCODE='PT409';
  END IF;

  IF _payload IS NULL OR jsonb_typeof(_payload) <> 'object' THEN
    RAISE EXCEPTION 'Payload inválido.' USING ERRCODE='check_violation';
  END IF;
  v_total_raw       := COALESCE((_payload->>'total_amount')::numeric, 0);
  v_count           := COALESCE((_payload->>'installment_count')::integer, 1);
  v_category        := NULLIF(_payload->>'category_id','')::uuid;
  v_cost_center     := NULLIF(_payload->>'cost_center_id','')::uuid;
  v_payment_method  := NULLIF(_payload->>'payment_method_id','')::uuid;
  v_first_due       := COALESCE((_payload->>'first_due_date')::date, CURRENT_DATE);
  v_issue           := COALESCE((_payload->>'issue_date')::date, CURRENT_DATE);
  v_fiscal_required := COALESCE((_payload->>'fiscal_invoice_required')::boolean, false);
  v_fiscal_status   := CASE WHEN v_fiscal_required THEN 'PENDING' ELSE 'NOT_REQUIRED' END;
  v_installments    := _payload->'installments';
  v_desc            := COALESCE(NULLIF(_payload->>'description',''), 'Entrega ' || substr(_entrega_id::text,1,8));
  v_notes           := NULLIF(_payload->>'notes','');
  v_manual          := COALESCE((_payload->>'manual_financial_adjustment')::boolean, false);
  v_manual_reason   := NULLIF(trim(_payload->>'manual_adjustment_reason'), '');

  IF v_total_raw::text IN ('NaN','Infinity','-Infinity') THEN
    RAISE EXCEPTION 'Valor total inválido.' USING ERRCODE='check_violation';
  END IF;
  v_total := v_total_raw;

  -- category: global, active, RECEITA; no fallback
  IF v_category IS NULL THEN
    RAISE EXCEPTION 'Categoria financeira é obrigatória.' USING ERRCODE='check_violation';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.financial_categories
                  WHERE id = v_category AND active IS TRUE AND type = 'RECEITA' FOR SHARE) THEN
    RAISE EXCEPTION 'Categoria financeira de receita ativa não encontrada.' USING ERRCODE='check_violation';
  END IF;
  -- payment method: required and active; no fallback
  IF v_payment_method IS NULL THEN
    RAISE EXCEPTION 'Forma de pagamento é obrigatória.' USING ERRCODE='check_violation';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public.payment_methods WHERE id = v_payment_method AND active IS TRUE FOR SHARE) THEN
    RAISE EXCEPTION 'Forma de pagamento ativa não encontrada.' USING ERRCODE='check_violation';
  END IF;
  IF v_cost_center IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.financial_cost_centers
    WHERE id=v_cost_center AND active IS TRUE FOR SHARE) THEN
    RAISE EXCEPTION 'Centro de custo ativo não encontrado.' USING ERRCODE='23514';
  END IF;
  IF v_count < 1 OR v_count > 36 THEN
    RAISE EXCEPTION 'Número de parcelas deve estar entre 1 e 36.' USING ERRCODE='check_violation';
  END IF;
  IF v_first_due < v_issue THEN
    RAISE EXCEPTION 'Primeiro vencimento anterior à emissão.' USING ERRCODE='check_violation';
  END IF;

  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_org IS DISTINCT FROM v_initial_org THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  -- H6-003 canonical value (unchanged logic)
  v_canon := public.fn_entrega_valor_faturavel_v1(_entrega_id);
  v_canon_origem := v_canon->>'origem';
  SELECT r.valor_faturavel_max INTO v_canon_valor
    FROM public.entrega_reconciliacoes r
   WHERE r.entrega_id = _entrega_id AND r.status = 'reconciliada'
   LIMIT 1;
  IF v_canon_valor IS NULL THEN
    v_canon_valor := (v_canon->>'valor')::numeric;
  ELSE
    v_canon_origem := 'RECONCILIACAO:' || COALESCE(v_canon_origem,'-');
  END IF;
  IF v_canon_valor IS NOT NULL THEN
    IF v_canon_valor::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'Valor canônico inválido.' USING ERRCODE='23514'; END IF;
    IF abs(v_total - v_canon_valor) > 0.01 THEN
      RAISE EXCEPTION 'valor_divergente_do_canonico: informado %, canônico % (origem %).',
        v_total, v_canon_valor, v_canon_origem USING ERRCODE='check_violation';
    END IF;
    v_total := round(v_canon_valor, 2);
  ELSE
    IF NOT v_manual OR v_manual_reason IS NULL OR length(v_manual_reason) < 10 THEN
      RAISE EXCEPTION 'valor_canonico_indisponivel: informe manual_financial_adjustment com motivo (mín. 10 caracteres).'
        USING ERRCODE='check_violation';
    END IF;
  END IF;
  IF v_total <= 0 THEN
    RAISE EXCEPTION 'Valor total inválido.' USING ERRCODE='check_violation';
  END IF;

  v_guard := public.fn_entrega_guard_faturamento_v1(_entrega_id, v_total);

  -- installments: array, exact count, numbers 1..n unique, dates >= issue, amounts > 0
  IF v_installments IS NOT NULL AND jsonb_typeof(v_installments) <> 'null' THEN
    IF jsonb_typeof(v_installments) <> 'array' THEN
      RAISE EXCEPTION 'Parcelas inválidas.' USING ERRCODE='check_violation';
    END IF;
  END IF;
  IF v_installments IS NOT NULL AND jsonb_typeof(v_installments) = 'array'
     AND jsonb_array_length(v_installments) > 0 THEN
    IF jsonb_array_length(v_installments) <> v_count THEN
      RAISE EXCEPTION 'Quantidade de parcelas (%) diverge de installment_count (%).',
        jsonb_array_length(v_installments), v_count USING ERRCODE='check_violation';
    END IF;
    FOR v_inst IN SELECT * FROM jsonb_array_elements(v_installments) LOOP
      v_num := (v_inst->>'installment_number')::integer;
      v_due := (v_inst->>'due_date')::date;
      v_amt := (v_inst->>'amount')::numeric;
      IF v_num IS NULL OR v_num < 1 OR v_num > v_count OR v_num = ANY(v_seen) THEN
        RAISE EXCEPTION 'Número de parcela inválido ou repetido.' USING ERRCODE='check_violation';
      END IF;
      IF v_due IS NULL OR v_due < v_issue THEN
        RAISE EXCEPTION 'Vencimento de parcela inválido.' USING ERRCODE='check_violation';
      END IF;
      IF v_amt IS NULL OR v_amt::text IN ('NaN','Infinity','-Infinity') OR v_amt <= 0 THEN
        RAISE EXCEPTION 'Valor de parcela inválido.' USING ERRCODE='check_violation';
      END IF;
      v_seen := v_seen || v_num;
      v_sum := v_sum + v_amt;
    END LOOP;
    IF abs(v_sum - v_total) > 0.01 THEN
      RAISE EXCEPTION 'Soma das parcelas (%) difere do total (%).', v_sum, v_total USING ERRCODE='check_violation';
    END IF;
  END IF;

  BEGIN
    INSERT INTO public.accounts_receivable (
      organization_id, origin_type, origin_id, customer_id, description, category_id, cost_center_id,
      total_amount, issue_date, first_due_date, installment_count,
      payment_method_id, fiscal_invoice_required, fiscal_invoice_status,
      notes, created_by
    ) VALUES (
      v_org, 'DELIVERY', _entrega_id, v_entrega.cliente_id, v_desc, v_category, v_cost_center,
      v_total, v_issue, v_first_due, v_count,
      v_payment_method, v_fiscal_required, v_fiscal_status,
      v_notes, v_uid
    ) RETURNING id INTO v_receivable_id;
  EXCEPTION WHEN unique_violation THEN
    -- Never use a broad unique_violation as authority to return another title.
    RAISE EXCEPTION 'Entrega já possui conta a receber ativa.' USING ERRCODE='PT409';
  END;
  SELECT * INTO v_ar FROM public.accounts_receivable WHERE id=v_receivable_id
    AND organization_id=v_org AND origin_type='DELIVERY' AND origin_id=_entrega_id
    AND customer_id=v_entrega.cliente_id AND status<>'CANCELED';
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_RECEIVABLE_LINK_INVALID' USING ERRCODE='PT409'; END IF;
  -- Existing canonical trigger owns initial installments. Never DELETE/reinsert immutable history.
  IF (SELECT count(*) FROM public.accounts_receivable_installments WHERE receivable_id=v_ar.id
       AND organization_id=v_org) <> v_count
    OR EXISTS(SELECT 1 FROM public.accounts_receivable_installments WHERE receivable_id=v_ar.id AND organization_id=v_org
       AND (original_amount IS NULL OR original_amount::text IN ('NaN','Infinity','-Infinity') OR original_amount<=0
            OR due_date IS NULL OR due_date<v_issue))
    OR (SELECT sum(original_amount) FROM public.accounts_receivable_installments WHERE receivable_id=v_ar.id
       AND organization_id=v_org) IS DISTINCT FROM v_total THEN
    RAISE EXCEPTION 'DELIVERY_INSTALLMENT_SNAPSHOT_INVALID' USING ERRCODE='23514';
  END IF;
  IF v_installments IS NOT NULL AND jsonb_typeof(v_installments)='array' AND jsonb_array_length(v_installments)>0
    AND EXISTS(SELECT 1 FROM jsonb_array_elements(v_installments) x FULL JOIN
      (SELECT installment_number,due_date,original_amount FROM public.accounts_receivable_installments
        WHERE receivable_id=v_ar.id AND organization_id=v_org) i
      ON i.installment_number=(x->>'installment_number')::int
      WHERE i.installment_number IS NULL OR x IS NULL OR i.due_date IS DISTINCT FROM (x->>'due_date')::date
        OR i.original_amount IS DISTINCT FROM (x->>'amount')::numeric) THEN
    RAISE EXCEPTION 'DELIVERY_CUSTOM_SCHEDULE_REVIEW_PENDING' USING ERRCODE='PT409';
  END IF;

  UPDATE public.entregas
     SET receivable_id = v_receivable_id,
         financial_status = 'BILLED',
         billing_generated_at = now(),
         billing_generated_by = v_uid
   WHERE id = _entrega_id AND organization_id = v_org;

  INSERT INTO public.financial_audit_log (
    entity_type, entity_id, action, old_data, new_data, performed_by
  ) VALUES (
    'entregas', _entrega_id, 'DELIVERY_BILLED',
    jsonb_build_object('receivable_id', v_entrega.receivable_id,
                       'financial_status', v_entrega.financial_status),
    jsonb_build_object('receivable_id', v_receivable_id, 'total_amount', v_total,
      'installment_count', v_count, 'fiscal_invoice_required', v_fiscal_required,
      'payment_method_id', v_payment_method, 'origem', 'entrega',
      'valor_canonico', v_canon_valor, 'valor_canonico_origem', v_canon_origem,
      'manual_financial_adjustment', v_manual, 'manual_adjustment_reason', v_manual_reason,
      'reconciliacao', v_guard),
    v_uid
  );

  RETURN v_receivable_id;
END;
$function$;

CREATE OR REPLACE FUNCTION public.fn_mark_entrega_not_billable(_entrega_id uuid, _reason text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
 SET lock_timeout TO '3s'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_org uuid; v_initial_org uuid; v_ar public.accounts_receivable%ROWTYPE;
  v_entrega public.entregas%ROWTYPE;
BEGIN
  IF current_setting('transaction_isolation') <> 'read committed' THEN RAISE EXCEPTION 'DELIVERY_FINANCE_ISOLATION_UNSUPPORTED' USING ERRCODE='25000'; END IF;
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'Sessão inválida.' USING ERRCODE='insufficient_privilege';
  END IF;
  IF _entrega_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF _reason IS NULL OR length(trim(_reason)) = 0 THEN
    RAISE EXCEPTION 'Motivo é obrigatório.' USING ERRCODE='check_violation';
  END IF;

  PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'gate_unavailable' USING ERRCODE='55000'; END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  v_initial_org := v_org;

  -- same advisory key as billing: mark and bill on one delivery serialize
  PERFORM pg_advisory_xact_lock(hashtextextended('entrega_faturar:' || _entrega_id::text, 0));
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_org IS DISTINCT FROM v_initial_org THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;

  SELECT * INTO v_entrega FROM public.entregas
   WHERE id = _entrega_id AND organization_id = v_org FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'Sem permissão para marcar entrega como sem cobrança.' USING ERRCODE='insufficient_privilege';
  END IF;
  SELECT p.organization_id INTO v_org
    FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE
   WHERE p.user_id=v_uid AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
     AND EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('administrador','gestor','financeiro'))
     AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=v_uid
                 AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
     AND NOT EXISTS(SELECT 1 FROM public.partner_users pu WHERE pu.user_id=v_uid)
     AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=v_uid
       AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL
         AND auth.uid()=v_uid AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
  IF v_org IS NULL THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_org IS DISTINCT FROM v_initial_org THEN RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF v_entrega.partner_order_id IS NOT NULL OR v_entrega.ordem_servico_onfarm_id IS NOT NULL
    OR v_entrega.cliente_id IS NULL OR NOT EXISTS(SELECT 1 FROM public.clientes c
       WHERE c.id=v_entrega.cliente_id AND c.organization_id=v_org) THEN
    RAISE EXCEPTION 'DELIVERY_FINANCE_FORBIDDEN' USING ERRCODE='42501';
  END IF;
  IF v_entrega.receivable_id IS NOT NULL OR EXISTS(SELECT 1 FROM public.accounts_receivable
     WHERE origin_type='DELIVERY' AND origin_id=_entrega_id AND status<>'CANCELED') THEN
    RAISE EXCEPTION 'Entrega já foi faturada.' USING ERRCODE='PT409';
  END IF;

  IF v_entrega.financial_status='NOT_BILLABLE' THEN
    IF btrim(v_entrega.not_billable_reason) IS NOT DISTINCT FROM btrim(_reason) THEN RETURN; END IF;
    RAISE EXCEPTION 'DELIVERY_NOT_BILLABLE_INTENT_CONFLICT' USING ERRCODE='PT409';
  END IF;
  IF v_entrega.status<>'entregue' OR v_entrega.financial_status='BILLED' THEN
    RAISE EXCEPTION 'DELIVERY_NOT_BILLABLE_STATE_CONFLICT' USING ERRCODE='PT409';
  END IF;
  UPDATE public.entregas
    SET financial_status = 'NOT_BILLABLE',
        not_billable_reason = btrim(_reason)
    WHERE id = _entrega_id AND organization_id = v_org;

  INSERT INTO public.financial_audit_log (entity_type, entity_id, action, old_data, new_data, performed_by)
  VALUES ('entregas', _entrega_id, 'MARK_NOT_BILLABLE',
    jsonb_build_object('financial_status', v_entrega.financial_status),
    jsonb_build_object('financial_status', 'NOT_BILLABLE', 'reason', _reason),
    v_uid);
END $function$;

