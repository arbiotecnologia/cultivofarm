BEGIN;
SET LOCAL lock_timeout='3s';
SET LOCAL statement_timeout='30s';
DO $pre$ BEGIN
-- PRE
IF to_regprocedure('public.rpc_entrega_operacoes_capability_v1()') IS NOT NULL THEN RAISE EXCEPTION 'DELIVERY_CAP_ALREADY_INSTALLED'; END IF;
IF to_regprocedure('public.rpc_entrega_comprovante_anexar_v1(uuid,text,jsonb)') IS NULL OR NOT has_function_privilege('authenticated','public.rpc_entrega_comprovante_anexar_v1(uuid,text,jsonb)','EXECUTE') THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_PROOF_MISSING'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.entregas'::regclass AND tgname='zz_delivery_mutation_closed' AND tgenabled='O') THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_BARRIER_MISSING'; END IF;
IF has_table_privilege('authenticated','public.entregas','INSERT') OR has_table_privilege('authenticated','public.entregas','UPDATE') OR has_table_privilege('authenticated','public.entregas','DELETE') THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DML_OPEN'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('platform_private.delivery_actor_20261030(text)')))) IS DISTINCT FROM 'c6da1f5d9581a0c290e5e27e4605682c' OR (SELECT proacl::text FROM pg_proc WHERE oid=to_regprocedure('platform_private.delivery_actor_20261030(text)')) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=to_regprocedure('platform_private.delivery_actor_20261030(text)')) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DRIFT: %','platform_private.delivery_actor_20261030(text)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)')))) IS DISTINCT FROM '5da15a592037fc8e0c9d84a46bbebb54' OR (SELECT proacl::text FROM pg_proc WHERE oid=to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)')) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)')) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DRIFT: %','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)')))) IS DISTINCT FROM 'a4d47ccf5d116141ed46e9de9ea7eeaa' OR (SELECT proacl::text FROM pg_proc WHERE oid=to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)')) IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)')) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DRIFT: %','public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text)')))) IS DISTINCT FROM '925b6302ed3b72f0a5e2e208196fbc91' OR (SELECT proacl::text FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text)')) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text)')) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DRIFT: %','public.rpc_entrega_cancelar_v1(uuid,text)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)')))) IS DISTINCT FROM '3d517f1257d2e79fc89d173815955292' OR (SELECT proacl::text FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)')) IS DISTINCT FROM '{postgres=X/postgres}' OR (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)')) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'DELIVERY_CAP_PRE_DRIFT: %','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)'; END IF;
END $pre$;
CREATE FUNCTION public.rpc_entrega_operacoes_capability_v1()
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE g boolean:=false; c boolean:=false;
BEGIN
 -- Release gate only: reports whether the caller would pass the canonical actor check now.
 -- The writers re-authorize independently; this result never grants authority.
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'DELIVERY_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 BEGIN PERFORM platform_private.delivery_actor_20261030('group'); g:=true; EXCEPTION WHEN insufficient_privilege THEN g:=false; END;
 BEGIN PERFORM platform_private.delivery_actor_20261030('cancel'); c:=true; EXCEPTION WHEN insufficient_privilege THEN c:=false; END;
 RETURN jsonb_build_object('capability','delivery_operations_v1','group',g,'cancel',c);
END $$;
REVOKE ALL ON FUNCTION public.rpc_entrega_operacoes_capability_v1() FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_entrega_operacoes_capability_v1() TO authenticated;
GRANT EXECUTE ON FUNCTION public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz) TO authenticated;
GRANT EXECUTE ON FUNCTION public.rpc_entrega_cancelar_v1(uuid,text,timestamptz) TO authenticated;
DO $pre$ BEGIN
-- POST
IF (SELECT md5(pg_get_functiondef(to_regprocedure('platform_private.delivery_actor_20261030(text)')))) IS DISTINCT FROM 'c6da1f5d9581a0c290e5e27e4605682c' THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BODY: %','platform_private.delivery_actor_20261030(text)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)')))) IS DISTINCT FROM '5da15a592037fc8e0c9d84a46bbebb54' THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BODY: %','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)')))) IS DISTINCT FROM 'a4d47ccf5d116141ed46e9de9ea7eeaa' THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BODY: %','public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text)')))) IS DISTINCT FROM '925b6302ed3b72f0a5e2e208196fbc91' THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BODY: %','public.rpc_entrega_cancelar_v1(uuid,text)'; END IF;
IF (SELECT md5(pg_get_functiondef(to_regprocedure('public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)')))) IS DISTINCT FROM '3d517f1257d2e79fc89d173815955292' THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BODY: %','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)'; END IF;
IF NOT has_function_privilege('authenticated','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)','EXECUTE') OR has_function_privilege('anon','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)','EXECUTE') OR has_function_privilege('service_role','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)','EXECUTE') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_ACL: %','public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)'; END IF;
IF NOT has_function_privilege('authenticated','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)','EXECUTE') OR has_function_privilege('anon','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)','EXECUTE') OR has_function_privilege('service_role','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)','EXECUTE') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_ACL: %','public.rpc_entrega_cancelar_v1(uuid,text,timestamptz)'; END IF;
IF NOT has_function_privilege('authenticated','public.rpc_entrega_operacoes_capability_v1()','EXECUTE') OR has_function_privilege('anon','public.rpc_entrega_operacoes_capability_v1()','EXECUTE') OR has_function_privilege('service_role','public.rpc_entrega_operacoes_capability_v1()','EXECUTE') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_ACL: %','public.rpc_entrega_operacoes_capability_v1()'; END IF;
IF has_function_privilege('authenticated','public.rpc_entrega_cancelar_v1(uuid,text)','EXECUTE') OR has_function_privilege('authenticated','public.rpc_cockpit_criar_entrega_v1(uuid,text,uuid,numeric,jsonb)','EXECUTE') OR has_function_privilege('authenticated','platform_private.delivery_actor_20261030(text)','EXECUTE') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_LEGACY_OPEN'; END IF;
IF has_table_privilege('authenticated','public.entregas','INSERT') OR has_table_privilege('authenticated','public.entregas','UPDATE') OR has_table_privilege('authenticated','public.entregas','DELETE') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_DML_OPEN'; END IF;
IF NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.entregas'::regclass AND tgname='zz_delivery_mutation_closed' AND tgenabled='O') THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_BARRIER'; END IF;
IF (SELECT prosecdef FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_operacoes_capability_v1()')) IS NOT TRUE OR NOT (SELECT 'search_path=""'=ANY(proconfig) FROM pg_proc WHERE oid=to_regprocedure('public.rpc_entrega_operacoes_capability_v1()')) THEN RAISE EXCEPTION 'DELIVERY_CAP_POST_DEFINER'; END IF;
END $pre$;
COMMIT;
