-- INACTIVE candidate: delivery proof (form / digital signature / attachment).
-- Requires the delivery-atomic-hardening-20261030 install (pinned by PRE).
-- Authority: active actor + tenant derived server-side, role per legacy proof
-- staff matrix (is_delivery_staff + storage1_delivery_allowed), revalidated
-- after the advisory lock, the global guard lock, the org lock and the row lock,
-- and before any replay. GUCs, JWT metadata and client payload never authorize.

CREATE FUNCTION platform_private.delivery_proof_actor_20261030()
RETURNS uuid LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; v_uid uuid:=auth.uid(); BEGIN
 IF v_uid IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL
 OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=v_uid AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor','consultor_tecnico','superadmin'))
 OR EXISTS(SELECT 1 FROM public.partner_users WHERE user_id=v_uid AND revoked_at IS NULL AND (valid_from IS NULL OR valid_from<=pg_catalog.now()))
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=v_uid AND role IN ('administrador','gestor','administrativo','producao','operador_onfarm','aplicador'))
 THEN RAISE EXCEPTION 'DELIVERY_PROOF_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_proof_actor_20261030() FROM PUBLIC,anon,authenticated,service_role;

-- Row scope: same tenant for delivery and client; B2B/OnFarm closed; aplicador
-- without another staff role needs a client link (same rule as storage1).
CREATE FUNCTION platform_private.delivery_proof_row_ok_20261030(p_e public.entregas,p_org uuid,p_action text)
RETURNS boolean LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_uid uuid:=auth.uid(); BEGIN
 IF p_e.id IS NULL OR p_e.organization_id IS DISTINCT FROM p_org OR p_e.cliente_id IS NULL
 OR p_e.partner_order_id IS NOT NULL OR p_e.ordem_servico_onfarm_id IS NOT NULL THEN RETURN false; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.clientes WHERE id=p_e.cliente_id AND organization_id=p_org) THEN RETURN false; END IF;
 IF p_action='generate' THEN
  IF p_e.status::text NOT IN ('separado','em_rota','entregue') THEN RETURN false; END IF;
 ELSIF p_e.status::text NOT IN ('separado','em_rota') THEN RETURN false; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=v_uid AND role IN ('administrador','gestor','administrativo','producao','operador_onfarm'))
 AND NOT (p_e.cliente_id = ANY(public.get_cliente_ids_for_user(v_uid))) THEN RETURN false; END IF;
 RETURN true;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_proof_row_ok_20261030(public.entregas,uuid,text) FROM PUBLIC,anon,authenticated,service_role;

-- Same single gate mode as delivery/stock/billing (cf_user_guards_v1 FOR UPDATE).
CREATE FUNCTION platform_private.delivery_proof_gate_20261030(p_org uuid)
RETURNS void LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
BEGIN
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_AUTH_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 IF platform_private.delivery_proof_actor_20261030() IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.organizations WHERE id=p_org AND ativo IS TRUE FOR SHARE;
 IF NOT FOUND OR platform_private.delivery_proof_actor_20261030() IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_proof_gate_20261030(uuid) FROM PUBLIC,anon,authenticated,service_role;

-- Barrier: adds an exact 'proof' permit branch; group/cancel branches unchanged.
CREATE OR REPLACE FUNCTION platform_private.delivery_mutation_guard_20261030()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE c platform_private.delivery_context_20261030%ROWTYPE; v_org uuid;
 v_proof text[]:=ARRAY['comprovante_status','assinatura_tipo','recebedor_nome','recebedor_documento','recebedor_cargo','recebedor_telefone','comprovante_anexado_em','comprovante_anexado_por','assinatura_digital_capturada_em','assinatura_digital_capturada_por','comprovante_id','formulario_gerado_em','formulario_gerado_por','validation_token','validation_hash','updated_at'];
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 SELECT * INTO c FROM platform_private.delivery_context_20261030
 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid();
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='proof' THEN
  v_org:=platform_private.delivery_proof_actor_20261030();
  IF TG_OP='UPDATE' AND c.mutation='proof' AND c.organization_id=v_org AND NEW.id=c.target AND OLD.id=c.target
  AND OLD.organization_id=v_org AND NEW.organization_id=v_org
  AND OLD.partner_order_id IS NULL AND NEW.partner_order_id IS NULL
  AND OLD.ordem_servico_onfarm_id IS NULL AND NEW.ordem_servico_onfarm_id IS NULL
  AND NEW.status=OLD.status AND NEW.receivable_id IS NOT DISTINCT FROM OLD.receivable_id
  AND (pg_catalog.to_jsonb(NEW)-v_proof) IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-v_proof) THEN
   UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
   RETURN NEW;
  END IF;
  RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501';
 END IF;
 v_org:=platform_private.delivery_actor_20261030(c.action);
 IF c.organization_id IS DISTINCT FROM v_org OR NEW.organization_id IS DISTINCT FROM v_org
 OR NEW.partner_order_id IS NOT NULL OR NEW.receivable_id IS NOT NULL OR NEW.ordem_servico_onfarm_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='group' AND TG_OP='INSERT' AND c.mutation='create' AND c.delivery IS NULL
 AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item AND NEW.status::text='separado' THEN
  UPDATE platform_private.delivery_context_20261030 SET delivery=NEW.id,mutation='decorate' WHERE txid=c.txid;
 ELSIF c.action='group' AND TG_OP='UPDATE' AND c.mutation='decorate' AND NEW.id=c.delivery
 AND OLD.id=c.delivery AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item
 AND NEW.organization_id=OLD.organization_id AND NEW.status=OLD.status THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSIF c.action='cancel' AND TG_OP='UPDATE' AND c.mutation='cancel' AND NEW.id=c.target AND OLD.id=c.target
 AND OLD.organization_id=v_org AND NEW.status::text='cancelada' AND NEW.financial_status='CANCELED'
 AND (pg_catalog.to_jsonb(NEW)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status'])
 IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status']) THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSE RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_mutation_guard_20261030() FROM PUBLIC,anon,authenticated,service_role;

-- Payload validation: exact key set, bounded text, object path bound to the delivery.
CREATE FUNCTION platform_private.delivery_proof_payload_20261030(p_action text,p_entrega uuid,p_payload jsonb)
RETURNS jsonb LANGUAGE plpgsql IMMUTABLE SET search_path='' AS $$
DECLARE v_allowed text[]; k text; v jsonb; v_max int; v_out jsonb:='{}'::jsonb; v_path text;
 uuidre text:='[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}';
BEGIN
 IF p_action='generate' THEN
  IF p_payload IS NOT NULL AND p_payload<>'{}'::jsonb THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: payload' USING ERRCODE='22023'; END IF;
  RETURN '{}'::jsonb;
 END IF;
 IF p_payload IS NULL OR pg_catalog.jsonb_typeof(p_payload)<>'object' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: payload' USING ERRCODE='22023'; END IF;
 v_allowed:=CASE p_action
  WHEN 'sign' THEN ARRAY['assinatura_digital_png_path','assinatura_digital_svg','assinatura_hash','assinatura_user_agent','recebedor_nome','recebedor_documento','recebedor_cargo','recebedor_telefone']
  WHEN 'attach' THEN ARRAY['arquivo_path','arquivo_nome','arquivo_mime','recebedor_nome','recebedor_documento','recebedor_cargo','recebedor_telefone']
  ELSE NULL END;
 IF v_allowed IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: action' USING ERRCODE='22023'; END IF;
 FOR k,v IN SELECT * FROM pg_catalog.jsonb_each(p_payload) LOOP
  IF NOT k=ANY(v_allowed) THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: field %',k USING ERRCODE='22023'; END IF;
  IF pg_catalog.jsonb_typeof(v)='null' OR (pg_catalog.jsonb_typeof(v)='string' AND pg_catalog.btrim(v#>>'{}')='') THEN CONTINUE; END IF;
  IF pg_catalog.jsonb_typeof(v)<>'string' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: field %',k USING ERRCODE='22023'; END IF;
  v_max:=CASE WHEN k='assinatura_digital_svg' THEN 8000 WHEN k IN ('assinatura_user_agent','arquivo_path') THEN 512 ELSE 255 END;
  IF pg_catalog.length(v#>>'{}')>v_max THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: field %',k USING ERRCODE='22023'; END IF;
  v_out:=v_out||pg_catalog.jsonb_build_object(k,pg_catalog.btrim(v#>>'{}'));
 END LOOP;
 IF NOT v_out ? 'recebedor_nome' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: recebedor_nome' USING ERRCODE='22023'; END IF;
 IF p_action='sign' THEN
  v_path:=v_out->>'assinatura_digital_png_path';
  IF v_path IS NULL OR v_path !~ ('^entregas/'||p_entrega::text||'/assinaturas/'||uuidre||'\.png$') THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: path' USING ERRCODE='22023'; END IF;
  IF coalesce(v_out->>'assinatura_hash','') !~ '^[0-9a-f]{64}$' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: hash' USING ERRCODE='22023'; END IF;
 ELSE
  v_path:=v_out->>'arquivo_path';
  IF v_path IS NULL OR v_path !~ ('^entregas/'||p_entrega::text||'/comprovantes/'||uuidre||'\.(pdf|png|jpg|jpeg|webp)$') THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: path' USING ERRCODE='22023'; END IF;
  IF coalesce(v_out->>'arquivo_mime','') NOT IN ('application/pdf','image/png','image/jpeg','image/webp')
  OR NOT (v_out ? 'arquivo_nome')
  OR (v_out->>'arquivo_mime'='application/pdf' AND v_path !~ '\.pdf$')
  OR (v_out->>'arquivo_mime'='image/png' AND v_path !~ '\.png$')
  OR (v_out->>'arquivo_mime'='image/jpeg' AND v_path !~ '\.jpe?g$')
  OR (v_out->>'arquivo_mime'='image/webp' AND v_path !~ '\.webp$')
  THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: mime' USING ERRCODE='22023'; END IF;
 END IF;
 RETURN v_out;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_proof_payload_20261030(text,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;

CREATE FUNCTION platform_private.delivery_proof_apply_20261030(p_action text,p_entrega uuid,p_request_key text,p_payload jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $$
DECLARE v_uid uuid:=auth.uid(); v_org uuid; v_e public.entregas%ROWTYPE; v_c public.entrega_comprovantes%ROWTYPE;
 v_p jsonb; v_fp text; v_prev platform_private.delivery_requests_20261030%ROWTYPE; v_action text:='proof:'||p_action;
 v_path text; v_num text; v_token uuid; v_hash text; v_result jsonb; v_reused boolean:=false;
BEGIN
 v_org:=platform_private.delivery_proof_actor_20261030();
 IF p_entrega IS NULL OR p_request_key IS NULL OR p_request_key !~ '^[A-Za-z0-9:_-]{8,128}$' THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: key' USING ERRCODE='22023'; END IF;
 v_p:=platform_private.delivery_proof_payload_20261030(p_action,p_entrega,p_payload);
 v_fp:=pg_catalog.md5(pg_catalog.jsonb_build_object('entrega',p_entrega,'action',p_action,'payload',v_p)::text);
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega AND organization_id=v_org;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtext('entrega_proof:'||p_entrega::text));
 IF platform_private.delivery_proof_actor_20261030() IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 PERFORM platform_private.delivery_proof_gate_20261030(v_org);
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega AND organization_id=v_org FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF platform_private.delivery_proof_actor_20261030() IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'DELIVERY_SCOPE_CHANGED' USING ERRCODE='42501'; END IF;
 IF NOT platform_private.delivery_proof_row_ok_20261030(v_e,v_org,p_action) THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Replay only after full reauthorization under every lock.
 SELECT * INTO v_prev FROM platform_private.delivery_requests_20261030
 WHERE organization_id=v_org AND actor=v_uid AND action=v_action AND request_key=p_request_key;
 IF FOUND THEN
  IF v_prev.fingerprint<>v_fp THEN RAISE EXCEPTION 'DELIVERY_PROOF_REQUEST_CONFLICT' USING ERRCODE='PT409'; END IF;
  RETURN v_prev.result||'{"replayed":true}'::jsonb;
 END IF;
 IF p_action IN ('sign','attach') THEN
  v_path:=CASE p_action WHEN 'sign' THEN v_p->>'assinatura_digital_png_path' ELSE v_p->>'arquivo_path' END;
  -- Object must exist, belong to the caller and stay locked until commit.
  PERFORM 1 FROM storage.objects WHERE bucket_id='entrega-documentos' AND name=v_path AND owner_id=v_uid::text FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_PROOF_OBJECT_DENIED' USING ERRCODE='42501'; END IF;
  IF EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE arquivo_path=v_path OR assinatura_digital_png_path=v_path) THEN
   RAISE EXCEPTION 'DELIVERY_PROOF_OBJECT_ALREADY_LINKED' USING ERRCODE='PT409';
  END IF;
 END IF;
 IF v_e.comprovante_id IS NOT NULL THEN
  SELECT * INTO v_c FROM public.entrega_comprovantes WHERE id=v_e.comprovante_id FOR UPDATE;
  IF NOT FOUND OR v_c.entrega_id<>v_e.id THEN RAISE EXCEPTION 'DELIVERY_PROOF_INCONSISTENT' USING ERRCODE='PT409'; END IF;
 ELSE
  SELECT * INTO v_c FROM public.entrega_comprovantes WHERE entrega_id=v_e.id AND tipo='formulario_entrega' ORDER BY gerado_em DESC LIMIT 1 FOR UPDATE;
 END IF;
 IF v_c.id IS NOT NULL AND v_c.status IN ('rejeitado','cancelado') THEN v_c:=NULL; END IF;
 IF p_action<>'generate' AND v_c.status='confirmado' THEN RAISE EXCEPTION 'DELIVERY_PROOF_CLOSED' USING ERRCODE='PT409'; END IF;
 INSERT INTO platform_private.delivery_context_20261030(txid,actor,organization_id,action,target,mutation)
 VALUES(pg_catalog.txid_current(),v_uid,v_org,'proof',v_e.id,'proof');
 IF v_c.id IS NULL THEN
  v_token:=pg_catalog.gen_random_uuid();
  v_num:='AR-ENT-'||pg_catalog.lpad(pg_catalog.nextval('public.entrega_formulario_seq')::text,6,'0');
  v_hash:=pg_catalog.encode(extensions.digest(v_e.id::text||v_num||v_token::text||pg_catalog.now()::text,'sha256'),'hex');
  INSERT INTO public.entrega_comprovantes(entrega_id,numero_formulario,tipo,status,validation_token,validation_hash,qr_code_payload,gerado_por)
  VALUES(v_e.id,v_num,'formulario_entrega','gerado',v_token,v_hash,v_token::text,v_uid) RETURNING * INTO v_c;
  PERFORM public._entrega_seed_checklist(v_e.id);
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_FORM_GENERATED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'numero_formulario',v_num),v_uid);
 ELSE v_reused:=true; END IF;
 IF p_action='sign' THEN
  UPDATE public.entrega_comprovantes SET status='assinatura_digital_coletada',assinatura_coletada=true,assinatura_tipo='digital_tela',
   assinatura_digital_png_path=v_path,assinatura_digital_svg=v_p->>'assinatura_digital_svg',assinatura_hash=v_p->>'assinatura_hash',
   assinatura_user_agent=v_p->>'assinatura_user_agent',assinatura_capturada_em=pg_catalog.now(),
   recebedor_nome=v_p->>'recebedor_nome',recebedor_documento=v_p->>'recebedor_documento',recebedor_cargo=v_p->>'recebedor_cargo',recebedor_telefone=v_p->>'recebedor_telefone',
   data_assinatura=pg_catalog.now(),
   validation_hash=pg_catalog.encode(extensions.digest(v_e.id::text||(v_p->>'assinatura_hash')||pg_catalog.now()::text,'sha256'),'hex'),updated_at=pg_catalog.now()
  WHERE id=v_c.id RETURNING * INTO v_c;
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_DIGITAL_SIGNATURE_CAPTURED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'hash',v_p->>'assinatura_hash'),v_uid);
 ELSIF p_action='attach' THEN
  UPDATE public.entrega_comprovantes SET status='anexado',arquivo_path=v_path,arquivo_url=NULL,arquivo_nome=v_p->>'arquivo_nome',arquivo_mime=v_p->>'arquivo_mime',
   assinatura_coletada=true,assinatura_tipo='fisica_anexada',
   recebedor_nome=v_p->>'recebedor_nome',recebedor_documento=v_p->>'recebedor_documento',recebedor_cargo=v_p->>'recebedor_cargo',recebedor_telefone=v_p->>'recebedor_telefone',
   data_assinatura=pg_catalog.now(),anexado_por=v_uid,anexado_em=pg_catalog.now(),updated_at=pg_catalog.now()
  WHERE id=v_c.id RETURNING * INTO v_c;
  INSERT INTO public.financial_audit_log(entity_type,entity_id,action,new_data,performed_by)
  VALUES('entrega',v_e.id,'DELIVERY_PROOF_ATTACHED',pg_catalog.jsonb_build_object('comprovante_id',v_c.id,'arquivo_path',v_path),v_uid);
 END IF;
 -- Exactly one delivery row update; the barrier verifies the column set.
 UPDATE public.entregas SET
  comprovante_id=v_c.id,
  comprovante_status=CASE p_action WHEN 'generate' THEN CASE WHEN v_reused THEN comprovante_status ELSE 'formulario_gerado' END WHEN 'sign' THEN 'assinatura_digital_coletada' ELSE 'anexado' END,
  formulario_gerado_em=CASE WHEN v_reused THEN formulario_gerado_em ELSE pg_catalog.now() END,
  formulario_gerado_por=CASE WHEN v_reused THEN formulario_gerado_por ELSE v_uid END,
  validation_token=CASE WHEN v_reused THEN validation_token ELSE v_c.validation_token END,
  validation_hash=CASE WHEN v_reused THEN validation_hash ELSE v_c.validation_hash END,
  assinatura_tipo=CASE p_action WHEN 'sign' THEN 'digital_tela' WHEN 'attach' THEN 'fisica_anexada' ELSE assinatura_tipo END,
  recebedor_nome=CASE WHEN p_action='generate' THEN recebedor_nome ELSE v_p->>'recebedor_nome' END,
  recebedor_documento=coalesce(v_p->>'recebedor_documento',recebedor_documento),
  recebedor_cargo=coalesce(v_p->>'recebedor_cargo',recebedor_cargo),
  recebedor_telefone=coalesce(v_p->>'recebedor_telefone',recebedor_telefone),
  assinatura_digital_capturada_em=CASE WHEN p_action='sign' THEN pg_catalog.now() ELSE assinatura_digital_capturada_em END,
  assinatura_digital_capturada_por=CASE WHEN p_action='sign' THEN v_uid ELSE assinatura_digital_capturada_por END,
  comprovante_anexado_em=CASE WHEN p_action='attach' THEN pg_catalog.now() ELSE comprovante_anexado_em END,
  comprovante_anexado_por=CASE WHEN p_action='attach' THEN v_uid ELSE comprovante_anexado_por END,
  updated_at=pg_catalog.now()
 WHERE id=v_e.id;
 IF NOT EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current() AND mutation='done') THEN
  RAISE EXCEPTION 'DELIVERY_PROOF_PERMIT_UNUSED' USING ERRCODE='42501';
 END IF;
 v_result:=pg_catalog.jsonb_build_object('success',true,'action',p_action,'entrega_id',v_e.id,'comprovante_id',v_c.id,
  'numero_formulario',v_c.numero_formulario,'validation_token',v_c.validation_token,'reused',v_reused,'object_path',v_path);
 INSERT INTO platform_private.delivery_requests_20261030(request_key,actor,organization_id,action,fingerprint,result)
 VALUES(p_request_key,v_uid,v_org,v_action,v_fp,v_result);
 RETURN v_result;
END $$;
REVOKE ALL ON FUNCTION platform_private.delivery_proof_apply_20261030(text,uuid,text,jsonb) FROM PUBLIC,anon,authenticated,service_role;

-- Read-only pre-check before any upload; never replaces the final check.
CREATE FUNCTION public.rpc_entrega_comprovacao_preflight_v1(p_entrega_id uuid,p_action text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path='' AS $$
DECLARE v_org uuid; v_e public.entregas%ROWTYPE; BEGIN
 v_org:=platform_private.delivery_proof_actor_20261030();
 IF p_action NOT IN ('generate','sign','attach') OR p_entrega_id IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_INVALID: action' USING ERRCODE='22023'; END IF;
 SELECT * INTO v_e FROM public.entregas WHERE id=p_entrega_id AND organization_id=v_org;
 IF NOT FOUND OR NOT platform_private.delivery_proof_row_ok_20261030(v_e,v_org,p_action) THEN RAISE EXCEPTION 'DELIVERY_PROOF_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_action<>'generate' AND EXISTS(SELECT 1 FROM public.entrega_comprovantes WHERE id=v_e.comprovante_id AND status='confirmado') THEN
  RAISE EXCEPTION 'DELIVERY_PROOF_CLOSED' USING ERRCODE='PT409'; END IF;
 RETURN pg_catalog.jsonb_build_object('allowed',true,'entrega_id',v_e.id,'action',p_action);
END $$;
