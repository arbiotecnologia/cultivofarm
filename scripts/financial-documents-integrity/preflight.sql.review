BEGIN READ ONLY;
DO $guard$ DECLARE r record; v record; BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref='swzpzcwiasxmjutrmvkm') OR EXISTS(SELECT 1 FROM public.fiscal_environment_marker WHERE project_ref IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm') THEN RAISE EXCEPTION 'canonical_ref_required'; END IF;
 FOR r IN SELECT * FROM jsonb_to_recordset($json$[{"signature": "financial_storage_object_permitted(text,text)", "md5": "d03da0efc828ed0f99259c75390c6d13", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "fn_audit_financial_documents()", "md5": "5f9283679efe1b6503ece3ebb3f748b8", "acl": "{postgres=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=public"]}, {"signature": "fn_authz_uid_scope_ok(uuid)", "md5": "00a9a4d4a075d756d312d69778493b39", "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}", "owner": "postgres", "config": ["search_path=public, pg_temp"]}, {"signature": "fn_financial_audit()", "md5": "46f777c2020ff9a059a80ae6dab4bd12", "acl": "{postgres=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=public"]}, {"signature": "guard_tenant_organization_id()", "md5": "d01a740c1e3e02407131d2b9228bf658", "acl": "{postgres=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "h15_actor_organization()", "md5": "55edafec08bcc84a00f1526c14334a2c", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "has_role(uuid,app_role)", "md5": "4d90e93d521a4819d9085f28d742030f", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "is_financial_staff(uuid)", "md5": "6e8f2fa7b92ca7e039d092353b3ebfe2", "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}", "owner": "postgres", "config": ["search_path=public, pg_temp"]}, {"signature": "platform_private.h15_actor_organization()", "md5": "64e10608403238a41a9baf92857ca881", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "platform_private.has_role(uuid,app_role)", "md5": "c5af5b55de6d79da9b73a33948746ae2", "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "platform_private.platform_actor_access_ready(uuid)", "md5": "048249c0c2106c3761e26eacb8d0de84", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}, {"signature": "rpc_financial_document_soft_delete(uuid,text)", "md5": "bfce59fb3e68309d6d306a9c712fd1f3", "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}", "owner": "postgres", "config": ["search_path=public, pg_temp"]}, {"signature": "storage1_path_strict(text)", "md5": "94164fa3b90088b0a1f16ac465a635d4", "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}", "owner": "postgres", "config": ["search_path=\"\""]}]$json$::jsonb) AS x(signature text,md5 text,acl text,owner text,config text[]) LOOP
 SELECT md5(pg_get_functiondef(oid)) hash,proacl::text acl,pg_get_userbyid(proowner) owner,proconfig config INTO v FROM pg_proc WHERE oid=to_regprocedure(r.signature);
 IF NOT FOUND OR v.hash IS DISTINCT FROM r.md5 OR v.acl IS DISTINCT FROM r.acl OR v.owner IS DISTINCT FROM r.owner OR v.config IS DISTINCT FROM r.config THEN RAISE EXCEPTION 'contract_drift: %',r.signature; END IF;
 END LOOP;
 IF (SELECT relacl::text FROM pg_class WHERE oid='public.financial_documents'::regclass) IS DISTINCT FROM '{postgres=arwdDxtm/postgres,anon=arwdDxtm/postgres,authenticated=arwdDxtm/postgres,service_role=arwdDxtm/postgres}' OR (SELECT pg_get_userbyid(relowner) FROM pg_class WHERE oid='public.financial_documents'::regclass) <> 'postgres' OR NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.financial_documents'::regclass) THEN RAISE EXCEPTION 'table_acl_owner_rls_drift'; END IF;
 IF (SELECT md5(string_agg(policyname||'|'||cmd||'|'||permissive||'|'||roles::text||'|'||coalesce(qual,'')||'|'||coalesce(with_check,''),E'\n' ORDER BY policyname)) FROM pg_policies WHERE schemaname='public' AND tablename='financial_documents') IS DISTINCT FROM '2f1f0ad0472b8ec17b2841767f8416c7' THEN RAISE EXCEPTION 'policy_drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.financial_documents'::regclass AND NOT tgisinternal AND tgenabled <> 'O') THEN RAISE EXCEPTION 'trigger_enabled_drift'; END IF;
 IF (SELECT md5(string_agg(pg_get_triggerdef(oid),E'\n' ORDER BY tgname)) FROM pg_trigger WHERE tgrelid='public.financial_documents'::regclass AND NOT tgisinternal AND tgname<>'zz_financial_document_integrity') IS DISTINCT FROM '364a1ac7fc3c82f25e595afeef9059ae' THEN RAISE EXCEPTION 'trigger_drift'; END IF;
END $guard$;
DO $guard$ BEGIN
 IF to_regprocedure('public.guard_financial_document_integrity()') IS NOT NULL OR EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.financial_documents'::regclass AND tgname='zz_financial_document_integrity') THEN RAISE EXCEPTION 'candidate_already_present_or_drift'; END IF;
END $guard$;
WITH parents AS (
SELECT 'RECEIVABLE'::text owner_type,id,organization_id,NULL::text bucket,NULL::text path FROM public.accounts_receivable
UNION ALL SELECT 'PAYABLE',id,organization_id,NULL,NULL FROM public.accounts_payable
UNION ALL SELECT 'DELIVERY',id,organization_id,NULL,NULL FROM public.entregas
UNION ALL SELECT 'FISCAL_INVOICE',id,organization_id,NULL,NULL FROM public.fiscal_invoices
UNION ALL SELECT 'PAYMENT_RECEIVABLE',id,organization_id,NULL,NULL FROM public.receivable_payments
UNION ALL SELECT 'PAYMENT_PAYABLE',id,organization_id,NULL,NULL FROM public.payable_payments
UNION ALL SELECT 'FINANCIAL_RECEIPT',id,organization_id,storage_bucket,storage_path FROM public.financial_receipts
UNION ALL SELECT 'REPORT_EXPORT',id,organization_id,storage_bucket,storage_path FROM public.financial_report_exports
), inspected AS (
SELECT d.*, p.id parent_id,p.organization_id parent_org,
 coalesce(public.storage1_path_strict(d.storage_path),false) AND
 CASE WHEN d.owner_type IN ('FINANCIAL_RECEIPT','REPORT_EXPORT') THEN
 d.storage_path IS NOT DISTINCT FROM p.path AND split_part(d.storage_path,'/',1)=d.organization_id::text
 AND p.bucket IS NOT DISTINCT FROM (CASE WHEN d.owner_type='FINANCIAL_RECEIPT' THEN 'financial-receipts' ELSE 'financial-reports' END)
 ELSE cardinality(string_to_array(d.storage_path,'/'))=3 AND split_part(d.storage_path,'/',1)=d.owner_type AND split_part(d.storage_path,'/',2)=d.owner_id::text END path_ok
 FROM public.financial_documents d LEFT JOIN parents p ON p.owner_type=d.owner_type AND p.id=d.owner_id
)
SELECT owner_type,count(*) total,
 count(*) FILTER(WHERE organization_id IS NULL) legacy_null_tenant,
 count(*) FILTER(WHERE parent_id IS NULL) missing_parent,
 count(*) FILTER(WHERE parent_org IS NULL) parent_null_tenant,
 count(*) FILTER(WHERE organization_id IS NOT NULL AND parent_org IS DISTINCT FROM organization_id) tenant_mismatch,
 count(*) FILTER(WHERE path_ok IS DISTINCT FROM true) path_owner_bucket_mismatch,
 count(*) FILTER(WHERE uploaded_by IS NULL) missing_author
FROM inspected GROUP BY owner_type ORDER BY owner_type;
-- Aggregates only. Findings require review, never automatic backfill/delete.
COMMIT;
