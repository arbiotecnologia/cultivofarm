-- INACTIVE OFFLINE CANDIDATE. Disposable PostgreSQL only. No grants/hosted install.
-- Reads the generator's immutable snapshot; unknown legacy origins are NOT backfilled.
CREATE FUNCTION public.rpc_receivable_money_projection_v1(p_receivable_id uuid DEFAULT NULL, p_offset int DEFAULT 0, p_limit int DEFAULT 1000)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE u uuid := auth.uid(); org uuid := public.h15_actor_organization(); result jsonb;
BEGIN
  IF u IS NULL OR org IS NULL OR public.is_financial_staff(u) IS NOT TRUE THEN
    RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE = '42501';
  END IF;
  IF p_offset IS NULL OR p_offset < 0 OR p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 1000 THEN
    RAISE EXCEPTION 'MONEY_ORIGIN_PAGE_INVALID' USING ERRCODE = '23514';
  END IF;
  IF p_receivable_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.accounts_receivable a WHERE a.id=p_receivable_id AND a.organization_id=org) THEN
    RAISE EXCEPTION 'MONEY_ORIGIN_ACCESS_DENIED' USING ERRCODE = '42501';
  END IF;
  SELECT coalesce(jsonb_agg(projected ORDER BY id),'[]'::jsonb) INTO result FROM (
    SELECT i.id, to_jsonb(i) || jsonb_build_object(
      'monetary_semantics','financed_total_v1',
      -- Existing Price writer stores financing only in snapshot; column interest is late interest.
      'interest_amount',i.interest_amount + (r->>'interest')::numeric,
      'financed_interest_amount',(r->>'interest')::numeric,
      'monetary_origin',jsonb_build_object('contract','RECEIVABLE_MONEY_V1','source','price_snapshot_v1',
        'installment_id',i.id,'receivable_id',i.receivable_id,'snapshot_principal',(r->>'principal')::numeric,
        'snapshot_interest',(r->>'interest')::numeric)) AS projected
    FROM public.accounts_receivable_installments i
    JOIN public.accounts_receivable a ON a.id=i.receivable_id
    LEFT JOIN platform_private.price_schedule_snapshots s ON s.receivable_id=a.id AND s.organization_id=org
    LEFT JOIN LATERAL (SELECT x AS r FROM jsonb_array_elements(s.rows) x WHERE (x->>'installment_number')::int=i.installment_number) snapshot_row ON true
    WHERE a.organization_id=org AND (p_receivable_id IS NULL OR a.id=p_receivable_id)
    ORDER BY i.id OFFSET p_offset LIMIT p_limit
  ) rows;
  -- Missing snapshot yields null proof and is rejected by the operational consumer.
  RETURN result;
END $$;
REVOKE ALL ON FUNCTION public.rpc_receivable_money_projection_v1(uuid,int,int) FROM PUBLIC, anon, authenticated, service_role;