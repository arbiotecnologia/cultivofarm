-- INACTIVE REVIEW CANDIDATE — disposable PostgreSQL only. Never apply hosted, never copy into
-- supabase/migrations, never GRANT in production. Requires independent review + JWT/RLS A/B proof.
--
-- (1) tg_partner_orders_credit_guard: captured body (md5 b24a3c30910832e8b14456d912a67589) with ONE
--     change: absent/inactive partner_financial_settings or credit_limit <= 0 holds the order in the
--     EXISTING 'aguardando_aprovacao_credito' status (owner decision: no explicit limit = finance
--     blocked; zero is not unlimited). Statuses, lock key and every other branch are unchanged.
-- (2) zz_b2b_shared_credit_guard: one BEFORE INSERT trigger on accounts_receivable that applies the
--     same partner credit rule to the remaining receivable writers (manual rpc_create_financial_title,
--     fn_generate_receivable_from_entrega, fn_generate_recurring_title, Price candidate). Writer bodies
--     stay byte-identical. Lock order is always writer-own locks -> partner_orders row (delivery only)
--     -> b2b_credit:<partner>, matching approve/guard (order row -> b2b_credit). B2B_ORDER conversion is
--     skipped (already counted as committed and neutralized by its own generator). Debtors without an
--     active partner of the SAME tenant are untouched: no widening to other tenants or customers.

CREATE OR REPLACE FUNCTION public.tg_partner_orders_credit_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v jsonb;
  v_amount numeric(14,2);
  v_should_check boolean := false;
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF NEW.status NOT IN ('rascunho') THEN v_should_check := true; END IF;
  ELSIF TG_OP = 'UPDATE' THEN
    IF NEW.credit_approved_by IS NOT NULL
       AND NEW.status = 'em_analise_comercial'
       AND OLD.status = 'aguardando_aprovacao_credito'
       AND NEW.total IS NOT DISTINCT FROM OLD.total THEN
      NEW.credit_block_reason := NULL;
      RETURN NEW;
    END IF;

    IF NEW.credit_approved_by IS NOT NULL AND OLD.credit_approved_by IS NULL THEN
      NEW.credit_block_reason := NULL;
      RETURN NEW;
    END IF;

    IF OLD.credit_approved_by IS NOT NULL
       AND NEW.status = 'aprovado'
       AND OLD.status = 'em_analise_comercial'
       AND NEW.total IS NOT DISTINCT FROM OLD.total THEN
      RETURN NEW;
    END IF;

    IF NEW.status IS DISTINCT FROM OLD.status
       AND NEW.status IN ('em_analise_comercial','aprovado') THEN
      v_should_check := true;
    ELSIF (NEW.total IS DISTINCT FROM OLD.total
        OR NEW.final_amount_with_interest IS DISTINCT FROM OLD.final_amount_with_interest)
       AND NEW.status IN ('em_analise_comercial','aprovado','aguardando_aprovacao_credito') THEN
      v_should_check := true;
    END IF;
  END IF;

  IF NOT v_should_check THEN RETURN NEW; END IF;

  -- Serializa a avaliacao de credito por parceiro dentro da transacao corrente.
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || NEW.partner_id::text, 0));

  -- CANDIDATE: configuracao financeira ausente/inativa ou limite nao definido bloqueia (fresh read after lock).
  IF NOT EXISTS (SELECT 1 FROM public.partner_financial_settings s
                  WHERE s.partner_id = NEW.partner_id AND s.active IS TRUE) THEN
    NEW.status := 'aguardando_aprovacao_credito';
    NEW.credit_block_reason := 'configuracao_financeira_inativa';
    RETURN NEW;
  END IF;

  v_amount := ROUND(COALESCE(NEW.final_amount_with_interest, NEW.total, 0), 2);
  v := public.fn_b2b_credit_exposure(NEW.partner_id, v_amount, NEW.id);

  IF COALESCE((v->>'credit_limit')::numeric, 0) <= 0 THEN
    NEW.status := 'aguardando_aprovacao_credito';
    NEW.credit_block_reason := 'limite_nao_definido';
    RETURN NEW;
  END IF;

  IF (v->>'block_if_overdue')::boolean AND (v->>'tem_vencidos')::boolean THEN
    NEW.status := 'aguardando_aprovacao_credito';
    NEW.credit_block_reason := 'inadimplencia';
    RETURN NEW;
  END IF;

  IF COALESCE((v->>'credit_limit')::numeric,0) > 0
     AND (v->>'exposicao_projetada')::numeric > (v->>'credit_limit')::numeric THEN
    NEW.status := 'aguardando_aprovacao_credito';
    NEW.credit_block_reason := CASE
      WHEN (v->>'credit_limit_action') = 'approval_required' THEN 'limite_excedido'
      ELSE 'limite_excedido_bloqueado'
    END;
  END IF;

  RETURN NEW;
END $function$;

CREATE FUNCTION platform_private.b2b_shared_receivable_credit_guard() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_p uuid[]; v_partner uuid; v jsonb; v_delta numeric(14,2); v_po_id uuid; v_po record;
BEGIN
  IF NEW.origin_type = 'B2B_ORDER' THEN RETURN NEW; END IF;  -- conversion: committed order -> title, neutral
  IF NEW.customer_id IS NULL THEN RETURN NEW; END IF;
  IF NEW.organization_id IS NULL THEN RAISE EXCEPTION 'CREDIT_TENANT_REQUIRED' USING ERRCODE = '42501'; END IF;
  SELECT array_agg(pa.id ORDER BY pa.id) INTO v_p FROM public.partner_accounts pa
   WHERE pa.client_id = NEW.customer_id AND pa.commercial_owner_organization_id = NEW.organization_id AND pa.ativo IS TRUE;
  IF v_p IS NULL THEN RETURN NEW; END IF;  -- not a partner debtor of this tenant: untouched
  IF cardinality(v_p) > 1 THEN RAISE EXCEPTION 'CREDIT_PARTNER_LINK_AMBIGUOUS' USING ERRCODE = '42501'; END IF;
  v_partner := v_p[1];
  IF NEW.partner_id IS NOT NULL AND NEW.partner_id IS DISTINCT FROM v_partner THEN
    RAISE EXCEPTION 'CREDIT_PARTNER_CONFLICT' USING ERRCODE = '23514';
  END IF;
  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION 'CREDIT_ISOLATION_UNSUPPORTED' USING ERRCODE = '0A000';  -- stale snapshot after wait
  END IF;
  v_delta := round(NEW.total_amount, 2);
  IF NEW.origin_type = 'DELIVERY' AND NEW.origin_id IS NOT NULL THEN
    SELECT e.partner_order_id INTO v_po_id FROM public.entregas e WHERE e.id = NEW.origin_id;
    IF v_po_id IS NOT NULL THEN
      SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id FOR UPDATE;  -- row before b2b_credit
      IF v_po.partner_id IS DISTINCT FROM v_partner THEN
        RAISE EXCEPTION 'CREDIT_DELIVERY_ORDER_PARTNER_MISMATCH' USING ERRCODE = '23514';
      END IF;
    END IF;
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('b2b_credit:' || v_partner::text, 0));
  -- Fresh statement snapshots from here on (READ COMMITTED), after any wait.
  IF NOT EXISTS (SELECT 1 FROM public.partner_financial_settings s WHERE s.partner_id = v_partner AND s.active IS TRUE) THEN
    RAISE EXCEPTION 'CREDIT_SETTINGS_INACTIVE' USING ERRCODE = 'PT409';
  END IF;
  v := public.fn_b2b_credit_exposure(v_partner, 0, NULL);
  IF COALESCE((v->>'credit_limit')::numeric, 0) <= 0 THEN RAISE EXCEPTION 'CREDIT_NO_LIMIT_DEFINED' USING ERRCODE = 'PT409'; END IF;
  IF (v->>'block_if_overdue')::boolean AND (v->>'tem_vencidos')::boolean THEN
    RAISE EXCEPTION 'CREDIT_OVERDUE_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  IF v_po_id IS NOT NULL THEN
    -- Delivery of a still-committed order: the title replaces the order amount (fn_h6c link marks the
    -- order generated in this same transaction) — count only the difference, never both.
    SELECT po.* INTO v_po FROM public.partner_orders po WHERE po.id = v_po_id;
    IF COALESCE(v_po.receivable_generated, false) = false
       AND v_po.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue',
                           'pendente','solicitado','em_analise_comercial','aguardando_aprovacao_credito','aguardando_ajuste_comercial','aguardando_itens')
       AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links l WHERE l.partner_order_id = v_po_id) THEN
      v_delta := v_delta - round(COALESCE(v_po.final_amount_with_interest, v_po.total, 0), 2);
    END IF;
  END IF;
  IF (v->>'exposicao_atual')::numeric + v_delta > (v->>'credit_limit')::numeric THEN
    IF v->>'credit_limit_action' = 'approval_required' THEN
      RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_APPROVAL' USING ERRCODE = 'PT409';
    END IF;
    RAISE EXCEPTION 'CREDIT_LIMIT_EXCEEDED_BLOCK' USING ERRCODE = 'PT409';
  END IF;
  NEW.partner_id := v_partner;  -- canonical exposure sees the title afterwards (no second ledger)
  RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION platform_private.b2b_shared_receivable_credit_guard() FROM PUBLIC;
CREATE TRIGGER zz_b2b_shared_credit_guard BEFORE INSERT ON public.accounts_receivable
  FOR EACH ROW EXECUTE FUNCTION platform_private.b2b_shared_receivable_credit_guard();

-- ROLLBACK (deny-safe; never restores an unguarded writer silently):
--   DROP TRIGGER zz_b2b_shared_credit_guard ON public.accounts_receivable;
--   DROP FUNCTION platform_private.b2b_shared_receivable_credit_guard();
--   and re-create the captured tg_partner_orders_credit_guard body (md5 b24a3c30...) ONLY together
--   with a documented decision, because that restores "inactive settings accepted".
