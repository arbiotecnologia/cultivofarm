import { ReportShell } from "@/components/financeiro/relatorios/ReportShell";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { brl } from "@/lib/financial/format";
import type { ReceivableRow } from "./types";

export default function RelatorioContasReceber() {
  const today = new Date().toISOString().slice(0, 10);
  const first = today.slice(0, 8) + "01";
  return (
    <ReportShell<ReceivableRow[]>
      title="Contas a Receber — Detalhado"
      reportType="receivables"
      defaultFilters={{ from: first, to: today }}
      renderPreview={(data) => (
        <div className="overflow-x-auto">
          <Table>
            <TableHeader><TableRow>
              <TableHead>Vencimento</TableHead><TableHead>Cliente</TableHead><TableHead>Descrição</TableHead>
              <TableHead>Categoria</TableHead><TableHead className="text-right">Valor</TableHead>
              <TableHead className="text-right">Pago</TableHead><TableHead className="text-right">Saldo</TableHead><TableHead>Status</TableHead>
            </TableRow></TableHeader>
            <TableBody>
              {(data ?? []).map((r) => (
                <TableRow key={r.installment_id}>
                  <TableCell>{r.due_date}</TableCell><TableCell>{r.customer_name}</TableCell>
                  <TableCell className="max-w-xs truncate">{r.description}</TableCell><TableCell>{r.category ?? "—"}</TableCell>
                  <TableCell className="text-right">{brl(r.amount)}</TableCell>
                  <TableCell className="text-right">{brl(r.paid)}</TableCell>
                  <TableCell className="text-right font-medium">{brl(r.balance)}</TableCell>
                  <TableCell>{r.status}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      )}
    />
  );
}
