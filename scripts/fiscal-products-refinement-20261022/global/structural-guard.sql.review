DO $$ BEGIN IF EXISTS(WITH expected(relation,fingerprint) AS (VALUES ('cf_user_guards_v1.state','741e1b067c108c87405b02645e2722a2'),('public.platform_org_admin_invites','7fb915dba39c7995abf6e7de2d7df484'),('public.product_fiscal_profiles','13b492d60d4ec1717ba905b78fe6d045'),('public.produtos','203dcf0c094aca585a44153317fe03c9'),('public.profiles','7eed11fe20456881cabf262450c5aa52'),('public.user_roles','4b157ff7ba28af3009390e84057cf5c1')) SELECT 1 FROM expected e LEFT JOIN pg_class c ON c.oid=to_regclass(e.relation) WHERE c.oid IS NULL OR md5(jsonb_build_object('rls',c.relrowsecurity,'force',c.relforcerowsecurity,'acl',c.relacl::text,'owner',pg_get_userbyid(c.relowner),'columns',(SELECT jsonb_agg(jsonb_build_array(a.attname,a.atttypid::regtype::text,a.attnotnull,pg_get_expr(d.adbin,d.adrelid)) ORDER BY a.attnum) FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped),'constraints',(SELECT jsonb_agg(jsonb_build_array(conname,contype,pg_get_constraintdef(oid),convalidated,condeferrable) ORDER BY conname) FROM pg_constraint WHERE conrelid=c.oid),'indexes',(SELECT jsonb_agg(jsonb_build_array(i.indexrelid::regclass::text,pg_get_indexdef(i.indexrelid),i.indisvalid) ORDER BY i.indexrelid::regclass::text) FROM pg_index i WHERE i.indrelid=c.oid),'triggers',(SELECT jsonb_agg(jsonb_build_array(t.tgname,t.tgenabled,pg_get_triggerdef(t.oid),md5(pg_get_functiondef(t.tgfoid)),p.proacl::text,pg_get_userbyid(p.proowner)) ORDER BY t.tgname) FROM pg_trigger t JOIN pg_proc p ON p.oid=t.tgfoid WHERE t.tgrelid=c.oid AND NOT t.tgisinternal),'policies',(SELECT jsonb_agg(jsonb_build_array(pol.polname,pol.polcmd,pol.polroles::text,pg_get_expr(pol.polqual,pol.polrelid),pg_get_expr(pol.polwithcheck,pol.polrelid)) ORDER BY pol.polname) FROM pg_policy pol WHERE pol.polrelid=c.oid))::text) IS DISTINCT FROM e.fingerprint) THEN RAISE EXCEPTION 'review_structural_drift'; END IF; END $$;
