-- 00 PRE HOMOLOG — alinhamento EXCLUSIVO vrlcdwmlytukrjezrrnf. READ ONLY. NÃO executar em produção.
BEGIN TRANSACTION READ ONLY;
SET LOCAL search_path = public, pg_catalog;
DO $pre$
DECLARE v_fail text[] := ARRAY[]::text[]; r record; v_n bigint; v_cron text;
BEGIN
  -- 1. impressão digital: SOMENTE a homologação (empresas homolog presentes, nenhuma empresa de produção)
  IF NOT EXISTS (SELECT 1 FROM public.organizations WHERE id = 'c809e74f-486b-44b2-b2f4-4088f53421bb') OR NOT EXISTS (SELECT 1 FROM public.organizations WHERE id = 'dcf50a75-579a-4828-a0fc-1d8eadcb4b8a') THEN
    v_fail := v_fail || 'not_homolog:homolog_orgs_absent'::text; END IF;
  IF EXISTS (SELECT 1 FROM public.organizations WHERE id IN ('8eae2bc1-ad00-4402-9f57-564258e493ca','442444d9-263f-45d9-a991-a679498d06c3','4e537fd6-4632-4c70-a782-386dba3e8f9f','8f57c7dd-0557-4041-b401-7a00f7244626','007bb519-cba0-4704-be2c-cb93ad010048')) THEN v_fail := v_fail || 'not_homolog:production_org_present'::text; END IF;
  IF current_setting('server_version_num')::int < 170000 THEN v_fail := v_fail || 'pg_version_below_17'::text; END IF;
  -- trava homolog preservada (exatamente 1 gatilho habilitado)
  IF (SELECT count(*) FROM pg_trigger WHERE tgname = 'a00_homolog_validation_no_receivable' AND NOT tgisinternal AND tgenabled <> 'D') <> 1 THEN
    v_fail := v_fail || 'homolog_trava_missing_or_disabled'::text; END IF;
  -- automações e fiscal desligados
  IF to_regclass('cron.job') IS NOT NULL THEN
    -- estado pinado: exatamente 7 jobs, todos inativos (nunca reativados/excluídos); hash fixado na TX
    EXECUTE 'SELECT count(*) FROM cron.job' INTO v_n; IF v_n <> 7 THEN v_fail := v_fail || ('cron_jobs_count_drift:'||v_n); END IF;
    EXECUTE 'SELECT count(*) FROM cron.job WHERE active IS DISTINCT FROM false' INTO v_n; IF v_n <> 0 THEN v_fail := v_fail || ('cron_jobs_active:'||v_n); END IF;
    EXECUTE $c$SELECT md5(coalesce(string_agg(concat_ws('|',jobid,jobname,schedule,command,database,username,active),E'
' ORDER BY jobid),'')) FROM cron.job$c$ INTO v_cron;
    PERFORM set_config('homolog_align.cron_md5', v_cron, true);
  ELSE v_fail := v_fail || 'cron_schema_absent_unexpected'::text; END IF;
  IF to_regclass('public.company_fiscal_settings') IS NOT NULL THEN
    EXECUTE 'SELECT count(*) FROM public.company_fiscal_settings WHERE nfe_enabled OR nfse_enabled OR production_enabled' INTO v_n;
    IF v_n <> 0 THEN v_fail := v_fail || 'fiscal_enabled'::text; END IF; END IF;
  -- 1b. ACL cliente ENDURECIDA EXATA (04 aplicado em homolog e produção, 02/11): zero TRUNCATE/TRIGGER/REFERENCES de
  --     PUBLIC/anon/authenticated nas 59 tabelas do escopo. Estado pré-04 (capturado) aborta; nunca regrant.
  FOR r IN SELECT t, rl, pv FROM unnest(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t, unnest(ARRAY['public','anon','authenticated']) rl, unnest(ARRAY['TRUNCATE','TRIGGER','REFERENCES']) pv
           WHERE to_regclass('public.'||t) IS NOT NULL AND has_table_privilege(rl, 'public.'||t, pv) LOOP
    v_fail := v_fail || ('client_destructive_acl_not_hardened:'||r.t||':'||r.rl||':'||r.pv);
  END LOOP;
  -- 2. não aplicado antes / sem instalação parcial
  IF to_regclass('platform_private.homolog_alignment_ledger') IS NOT NULL THEN v_fail := v_fail || 'already_aligned_or_partial:ledger_present'::text; END IF;
  -- 3. as 459 assinaturas exatamente no estado capturado (204 iguais, 63 divergentes com md5 homolog, 192 ausentes)
  FOR r IN SELECT * FROM (VALUES
