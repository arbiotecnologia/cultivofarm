  ('produto_composicao_declaracoes','pcd_medida_check','CHECK (((quantidade IS NULL) OR (((quantidade > (0)::numeric) AND (quantidade <> ''NaN''::numeric) AND (unidade = ANY (ARRAY[''mL/L''::text, ''g/L''::text, ''g/kg''::text, ''%m/m''::text, ''%m/v''::text, ''%v/v''::text, ''UFC/mL''::text, ''UFC/g''::text])) AND (((unidade = ANY (ARRAY[''mL/L''::text, ''g/L''::text, ''%m/v''::text, ''%v/v''::text, ''UFC/mL''::text])) AND (base = ''por_volume_produto''::text)) OR ((unidade = ANY (ARRAY[''g/kg''::text, ''%m/m''::text, ''UFC/g''::text])) AND (base = ''por_massa_produto''::text))) AND (((unidade = ANY (ARRAY[''%m/m''::text, ''%m/v''::text, ''%v/v''::text])) AND (quantidade <= (100)::numeric)) OR ((unidade = ANY (ARRAY[''UFC/mL''::text, ''UFC/g''::text])) AND (quantidade <= ''1000000000000000''::numeric)) OR ((unidade = ANY (ARRAY[''mL/L''::text, ''g/L''::text, ''g/kg''::text])) AND (quantidade <= (1000)::numeric))) AND ((tipo_componente = ''microrganismo''::text) = (unidade = ANY (ARRAY[''UFC/mL''::text, ''UFC/g''::text])))) IS TRUE)))'),
  ('produto_composicao_declaracoes','pcd_medida_conjunta_check','CHECK ((((quantidade IS NULL) AND (unidade IS NULL) AND (base IS NULL)) OR ((quantidade IS NOT NULL) AND (unidade IS NOT NULL) AND (base IS NOT NULL))))'),
  ('produto_composicao_declaracoes','pcd_ordem_unique','UNIQUE (produto_id, ordem)'),
  ('produto_composicao_declaracoes','produto_composicao_declaracoes_natureza_check','CHECK ((natureza = ANY (ARRAY[''teor_garantido''::text, ''concentracao_declarada''::text])))'),
  ('produto_composicao_declaracoes','produto_composicao_declaracoes_ordem_check','CHECK (((ordem >= 1) AND (ordem <= 50)))'),
  ('produto_composicao_declaracoes','produto_composicao_declaracoes_pkey','PRIMARY KEY (id)'),
  ('produto_composicao_declaracoes','produto_composicao_declaracoes_tipo_componente_check','CHECK ((tipo_componente = ANY (ARRAY[''microrganismo''::text, ''ingrediente_ativo''::text, ''nutriente''::text, ''outro''::text])))'),
