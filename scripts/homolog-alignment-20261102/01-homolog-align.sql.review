  ('visitas_campo','visitas_campo_delete_admin','DELETE','PERMISSIVE','authenticated','platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role)',NULL),
  ('visitas_campo','visitas_campo_insert','INSERT','PERMISSIVE','authenticated',NULL,'((created_by = ( SELECT auth.uid() AS uid)) AND (platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = visitas_campo.registro_consultor_id) AND (r.created_by = ( SELECT auth.uid() AS uid))))) OR has_active_user_cliente_access(( SELECT auth.uid() AS uid), cliente_id, ARRAY[''execute''::text, ''manage''::text])))'),
  ('visitas_campo','visitas_campo_select','SELECT','PERMISSIVE','public','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = visitas_campo.registro_consultor_id) AND (r.created_by = ( SELECT auth.uid() AS uid))))) OR is_active_visit_participant(( SELECT auth.uid() AS uid), registro_consultor_id) OR has_active_user_cliente_access(( SELECT auth.uid() AS uid), cliente_id, ARRAY[''read''::text, ''execute''::text, ''manage''::text]))',NULL),
  ('visitas_campo','visitas_campo_update','UPDATE','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = visitas_campo.registro_consultor_id) AND (r.created_by = ( SELECT auth.uid() AS uid))))) OR has_active_user_cliente_access(( SELECT auth.uid() AS uid), cliente_id, ARRAY[''execute''::text, ''manage''::text]))','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = visitas_campo.registro_consultor_id) AND (r.created_by = ( SELECT auth.uid() AS uid))))) OR has_active_user_cliente_access(( SELECT auth.uid() AS uid), cliente_id, ARRAY[''execute''::text, ''manage''::text]))')) m(t, n, cmd, perm, roles, q, wc);
DO $pol$ DECLARE r record; v jsonb := '[]'; BEGIN
  FOR r IN SELECT c.*, p.policyname IS NOT NULL AS present,
                  (p.policyname IS NOT NULL AND (p.cmd <> c.cmd OR p.permissive <> c.perm OR array_to_string(ARRAY(SELECT unnest(p.roles) ORDER BY 1), ',') <> c.roles
                    OR p.qual IS DISTINCT FROM c.q OR p.with_check IS DISTINCT FROM c.wc)) AS drift,
                  to_jsonb(p) AS old
             FROM hal_pol c LEFT JOIN pg_policies p ON p.schemaname='public' AND p.tablename=c.t AND p.policyname=c.n LOOP
    IF r.present AND NOT r.drift THEN CONTINUE; END IF;
    IF r.drift THEN EXECUTE format('DROP POLICY %I ON public.%I', r.n, r.t); v := v || jsonb_build_object('replaced', r.old); END IF;
    CASE r.t||'|'||r.n
    WHEN 'catalogo_volumes|Admin gestor manage catalogo_volumes' THEN EXECUTE 'CREATE POLICY "Admin gestor manage catalogo_volumes" ON public.catalogo_volumes AS PERMISSIVE FOR ALL TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))) WITH CHECK ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role)));';
    WHEN 'catalogo_volumes|Cliente produtor read volumes aprovados' THEN EXECUTE 'CREATE POLICY "Cliente produtor read volumes aprovados" ON public.catalogo_volumes AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''cliente_produtor''::app_role) AND (ativo = true) AND (((produto_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM (produtos p
     JOIN product_technical_profiles ptp ON ((ptp.produto_id = p.id)))
  WHERE ((p.id = catalogo_volumes.produto_id) AND (p.ativo = true) AND (ptp.status_validacao = ''aprovado''::text))))) OR ((microrganismo_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM (microrganismos m
     JOIN microorganism_technical_profiles mtp ON ((mtp.microrganismo_id = m.id)))
  WHERE ((m.id = catalogo_volumes.microrganismo_id) AND (m.ativo = true) AND (mtp.status_validacao = ''aprovado''::text))))))));';
    WHEN 'catalogo_volumes|Partner B2B read enabled catalogo_volumes' THEN EXECUTE 'CREATE POLICY "Partner B2B read enabled catalogo_volumes" ON public.catalogo_volumes AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b''::app_role) AND (ativo = true) AND (((produto_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM produtos p
  WHERE ((p.id = catalogo_volumes.produto_id) AND (p.ativo = true) AND (COALESCE(p.b2b_enabled, true) = true))))) OR ((microrganismo_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM microrganismos m
  WHERE ((m.id = catalogo_volumes.microrganismo_id) AND (m.ativo = true) AND (COALESCE(m.b2b_enabled, false) = true))))))));';
    WHEN 'catalogo_volumes|Partner B2B tecnico read catalogo_volumes' THEN EXECUTE 'CREATE POLICY "Partner B2B tecnico read catalogo_volumes" ON public.catalogo_volumes AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b_tecnico''::app_role) AND (ativo = true) AND (((produto_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM produtos p
  WHERE ((p.id = catalogo_volumes.produto_id) AND (p.ativo = true) AND (COALESCE(p.b2b_enabled, true) = true))))) OR ((microrganismo_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM microrganismos m
  WHERE ((m.id = catalogo_volumes.microrganismo_id) AND (m.ativo = true) AND (COALESCE(m.b2b_enabled, false) = true))))))));';
    WHEN 'catalogo_volumes|Staff read catalogo_volumes' THEN EXECUTE 'CREATE POLICY "Staff read catalogo_volumes" ON public.catalogo_volumes AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''consultor_tecnico''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''tecnico_agronomo''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role)));';
    WHEN 'catalogo_volumes|catalog_volumes_sa_delete' THEN EXECUTE 'CREATE POLICY "catalog_volumes_sa_delete" ON public.catalogo_volumes AS RESTRICTIVE FOR DELETE TO authenticated USING (false);';
    WHEN 'catalogo_volumes|catalog_volumes_sa_insert' THEN EXECUTE 'CREATE POLICY "catalog_volumes_sa_insert" ON public.catalogo_volumes AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK (((auth.uid() IS NOT NULL) AND has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid()) AND platform_private.platform_actor_access_ready(auth.uid())));';
    WHEN 'catalogo_volumes|catalog_volumes_sa_update' THEN EXECUTE 'CREATE POLICY "catalog_volumes_sa_update" ON public.catalogo_volumes AS RESTRICTIVE FOR UPDATE TO authenticated USING (((auth.uid() IS NOT NULL) AND has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid()) AND platform_private.platform_actor_access_ready(auth.uid()))) WITH CHECK (((auth.uid() IS NOT NULL) AND has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid()) AND platform_private.platform_actor_access_ready(auth.uid())));';
    WHEN 'commercial_campaign_products|campanhas_products_admin' THEN EXECUTE 'CREATE POLICY "campanhas_products_admin" ON public.commercial_campaign_products AS PERMISSIVE FOR ALL TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role))) WITH CHECK ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role)));';
    WHEN 'commercial_campaign_products|campanhas_products_partner' THEN EXECUTE 'CREATE POLICY "campanhas_products_partner" ON public.commercial_campaign_products AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b''::app_role) AND (EXISTS ( SELECT 1
   FROM commercial_campaign_partners cp
  WHERE ((cp.campaign_id = commercial_campaign_products.campaign_id) AND (cp.partner_id = get_user_partner_id()))))));';
    WHEN 'commercial_campaigns|campanhas_admin_all' THEN EXECUTE 'CREATE POLICY "campanhas_admin_all" ON public.commercial_campaigns AS PERMISSIVE FOR ALL TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role))) WITH CHECK ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role)));';
    WHEN 'commercial_campaigns|campanhas_cliente_select' THEN EXECUTE 'CREATE POLICY "campanhas_cliente_select" ON public.commercial_campaigns AS PERMISSIVE FOR SELECT TO authenticated USING ((ativa AND (tipo_publico = ANY (ARRAY[''comercial''::text, ''ambos''::text])) AND (EXISTS ( SELECT 1
   FROM (commercial_campaign_clientes cc
     JOIN user_clientes uc ON ((uc.cliente_id = cc.cliente_id)))
  WHERE ((cc.campaign_id = commercial_campaigns.id) AND (uc.user_id = ( SELECT auth.uid() AS uid)) AND (uc.cliente_id = ANY (get_cliente_ids_for_user(( SELECT auth.uid() AS uid)))) AND (EXISTS ( SELECT 1
           FROM clientes c
          WHERE ((c.id = cc.cliente_id) AND (c.organization_id = h15_actor_organization())))))))));';
    WHEN 'commercial_campaigns|campanhas_partner_select' THEN EXECUTE 'CREATE POLICY "campanhas_partner_select" ON public.commercial_campaigns AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b''::app_role) AND ativa AND (tipo_publico = ANY (ARRAY[''b2b''::text, ''ambos''::text])) AND (EXISTS ( SELECT 1
   FROM commercial_campaign_partners cp
  WHERE ((cp.campaign_id = commercial_campaigns.id) AND (cp.partner_id = get_user_partner_id()))))));';
    WHEN 'culturas|Portal: Ler culturas' THEN EXECUTE 'CREATE POLICY "Portal: Ler culturas" ON public.culturas AS PERMISSIVE FOR SELECT TO authenticated USING (true);';
    WHEN 'culturas|Staff manage global catalog' THEN EXECUTE 'CREATE POLICY "Staff manage global catalog" ON public.culturas AS PERMISSIVE FOR ALL TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))) WITH CHECK ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role)));';
    WHEN 'microrganismos|d51_5_microorganism_global_mutation_delete' THEN EXECUTE 'CREATE POLICY "d51_5_microorganism_global_mutation_delete" ON public.microrganismos AS RESTRICTIVE FOR DELETE TO authenticated USING ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid())));';
    WHEN 'microrganismos|d51_5_microorganism_global_mutation_insert' THEN EXECUTE 'CREATE POLICY "d51_5_microorganism_global_mutation_insert" ON public.microrganismos AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid())));';
    WHEN 'microrganismos|d51_5_microorganism_global_mutation_update' THEN EXECUTE 'CREATE POLICY "d51_5_microorganism_global_mutation_update" ON public.microrganismos AS RESTRICTIVE FOR UPDATE TO authenticated USING ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid()))) WITH CHECK ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid())));';
    WHEN 'microrganismos|microrganismos_select_internal' THEN EXECUTE 'CREATE POLICY "microrganismos_select_internal" ON public.microrganismos AS PERMISSIVE FOR SELECT TO authenticated USING ((platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''financeiro''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''consultor_tecnico''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''tecnico_agronomo''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''administrativo''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''aplicador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''operador_onfarm''::app_role)));';
    WHEN 'microrganismos|micros_b2b_read' THEN EXECUTE 'CREATE POLICY "micros_b2b_read" ON public.microrganismos AS PERMISSIVE FOR SELECT TO authenticated USING (((platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b_tecnico''::app_role)) AND (ativo = true) AND (COALESCE(b2b_enabled, false) = true)));';
    WHEN 'organizations|Superadmin le empresas' THEN EXECUTE 'CREATE POLICY "Superadmin le empresas" ON public.organizations AS PERMISSIVE FOR SELECT TO authenticated USING (is_platform_superadmin(auth.uid()));';
    WHEN 'organizations|b2b_organization_full_row_containment' THEN EXECUTE 'CREATE POLICY "b2b_organization_full_row_containment" ON public.organizations AS RESTRICTIVE FOR SELECT TO authenticated USING (platform_private.b2b_organization_full_row_allowed());';
    WHEN 'organizations|organizations_select_scoped' THEN EXECUTE 'CREATE POLICY "organizations_select_scoped" ON public.organizations AS PERMISSIVE FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM profiles p
  WHERE ((p.user_id = ( SELECT auth.uid() AS uid)) AND (p.organization_id = organizations.id)))));';
    WHEN 'produtos|d51_5_catalog_global_mutation_delete' THEN EXECUTE 'CREATE POLICY "d51_5_catalog_global_mutation_delete" ON public.produtos AS RESTRICTIVE FOR DELETE TO authenticated USING ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid())));';
    WHEN 'produtos|d51_5_catalog_global_mutation_insert' THEN EXECUTE 'CREATE POLICY "d51_5_catalog_global_mutation_insert" ON public.produtos AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK ((has_role(auth.uid(), ''superadmin''::app_role) AND is_platform_superadmin(auth.uid())));';
