  ('commercial_price_rules','cpr_no_overlap','EXCLUDE USING gist (COALESCE(partner_id, ''00000000-0000-0000-0000-000000000000''::uuid) WITH =, COALESCE(customer_id, ''00000000-0000-0000-0000-000000000000''::uuid) WITH =, COALESCE(plan_id, ''00000000-0000-0000-0000-000000000000''::uuid) WITH =, COALESCE(product_id, ''00000000-0000-0000-0000-000000000000''::uuid) WITH =, COALESCE(microrganismo_id, ''00000000-0000-0000-0000-000000000000''::uuid) WITH =, unit_type WITH =, COALESCE(volume_ml, (- (1)::numeric)) WITH =, daterange(valid_from, valid_until, ''[]''::text) WITH &&) WHERE (active)','0'),
