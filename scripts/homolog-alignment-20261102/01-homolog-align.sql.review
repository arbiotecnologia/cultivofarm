  ('visitas_campo','idx_visitas_campo_cliente_id','CREATE INDEX idx_visitas_campo_cliente_id ON public.visitas_campo USING btree (cliente_id)')) m(t, n, d) LOOP
    IF to_regclass('public.'||r.n) IS NOT NULL AND pg_get_indexdef(to_regclass('public.'||r.n)) <> r.d THEN v_fail := v_fail || ('index_drift:'||r.n); END IF;
  END LOOP;
