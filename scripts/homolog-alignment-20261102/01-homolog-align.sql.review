CREATE TABLE platform_private.tenant_smtp_dispatch_jobs (
  "outbox_id" uuid NOT NULL,
  "organization_id" uuid NOT NULL,
  "contract" text NOT NULL,
  "source_id" uuid NOT NULL,
  "cliente_id" uuid NOT NULL,
  "recipient_user_id" uuid NOT NULL,
  "version" bigint NOT NULL,
  "activated_by" uuid,
  "state" text NOT NULL,
  "fence" uuid,
  "worker" text,
  "lease_expires_at" timestamp with time zone,
  "recipient_hash" text,
  "result_code" text,
  "created_at" timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
  "started_at" timestamp with time zone,
  "authorized_at" timestamp with time zone,
  "finished_at" timestamp with time zone
);
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_pkey" PRIMARY KEY (outbox_id);
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_contract_source_id_recipient_user_key" UNIQUE (contract, source_id, recipient_user_id);
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_outbox_id_fkey" FOREIGN KEY (outbox_id) REFERENCES public.comunicacao_outbox(id);
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_organization_id_fkey" FOREIGN KEY (organization_id) REFERENCES public.organizations(id);
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_contract_check" CHECK ((contract = 'solicitacao_atribuida_consultor_v1'::text));
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_state_check" CHECK ((state = ANY (ARRAY['queued'::text, 'executing'::text, 'authorized'::text, 'sent'::text, 'failed'::text, 'ambiguous'::text, 'cancelled'::text, 'lease_expired'::text])));
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_worker_check" CHECK (((worker IS NULL) OR ((length(worker) >= 1) AND (length(worker) <= 80))));
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_recipient_hash_check" CHECK (((recipient_hash IS NULL) OR (recipient_hash ~ '^[0-9a-f]{64}$'::text)));
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ADD CONSTRAINT "tenant_smtp_dispatch_jobs_result_code_check" CHECK (((result_code IS NULL) OR (result_code ~ '^[a-z_]{1,60}$'::text)));
ALTER TABLE platform_private.tenant_smtp_dispatch_jobs ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON platform_private.tenant_smtp_dispatch_jobs FROM PUBLIC, anon, authenticated, service_role;
