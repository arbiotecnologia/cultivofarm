             LEFT JOIN pg_trigger g ON g.tgrelid = ('public.'||m.t)::regclass AND g.tgname = m.n AND NOT g.tgisinternal LOOP
    IF r.goid IS NOT NULL AND r.cur = r.d THEN CONTINUE; END IF;
    IF r.goid IS NOT NULL THEN EXECUTE format('DROP TRIGGER %I ON public.%I', r.n, r.t); v := v || jsonb_build_object('replaced', r.cur); END IF;
    EXECUTE r.d; v := v || jsonb_build_object('created', r.t||'.'||r.n);
  END LOOP;
  FOR r IN SELECT tgrelid::regclass::text rel, tgname, pg_get_triggerdef(oid) d FROM pg_trigger WHERE NOT tgisinternal
            AND tgrelid = ANY(ARRAY(SELECT to_regclass('public.'||x) FROM unnest(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) x))
