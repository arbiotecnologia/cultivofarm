CREATE TEMP TABLE hal_pol ON COMMIT DROP AS SELECT * FROM (VALUES ('catalogo_volumes','Admin gestor manage catalogo_volumes','ALL','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))'),
  ('catalogo_volumes','Cliente produtor read volumes aprovados','SELECT','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''cliente_produtor''::app_role) AND (ativo = true) AND (((produto_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM (produtos p
     JOIN product_technical_profiles ptp ON ((ptp.produto_id = p.id)))
