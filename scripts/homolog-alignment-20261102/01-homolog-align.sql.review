    IF NOT r.present THEN v := v || jsonb_build_object('created', r.t||'.'||r.n); END IF;
  END LOOP;
  FOR r IN SELECT p.*, to_jsonb(p) AS old FROM pg_policies p WHERE p.schemaname='public' AND p.tablename = ANY(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[])
            AND NOT EXISTS (SELECT 1 FROM hal_pol c WHERE c.t=p.tablename AND c.n=p.policyname) LOOP
    IF r.permissive = 'PERMISSIVE' THEN EXECUTE format('DROP POLICY %I ON public.%I', r.policyname, r.tablename); v := v || jsonb_build_object('dropped_uncaptured_permissive', r.old);
    ELSE v := v || jsonb_build_object('kept_uncaptured_restrictive', r.old); END IF;
  END LOOP;
  INSERT INTO platform_private.homolog_alignment_ledger(step, detail) VALUES ('policies', v);
END $pol$;
