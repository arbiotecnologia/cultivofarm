  ('visitas_campo','idx_visitas_campo_cliente_id','CREATE INDEX idx_visitas_campo_cliente_id ON public.visitas_campo USING btree (cliente_id)')) m(t, n, d) LOOP
    IF to_regclass('public.'||r.n) IS NULL THEN EXECUTE r.d; v_i := v_i + 1; END IF;
  END LOOP;
  INSERT INTO platform_private.homolog_alignment_ledger(step, detail) VALUES ('constraints_indexes', jsonb_build_object('constraints_created', v_c, 'indexes_created', v_i));
END $con$;
SET LOCAL check_function_bodies = off;
CREATE OR REPLACE FUNCTION public._comunicacao_publish_system_event(_event_key text, _source_type text, _source_id uuid, _payload jsonb, _idempotency_key text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN RETURN jsonb_build_object('ok',false,'suppressed',true,'code','NOTIF3_GLOBAL_CONTRACT_UNAVAILABLE'); END $function$;
CREATE OR REPLACE FUNCTION public._notify_role(p_role app_role, p_tipo text, p_titulo text, p_mensagem text, p_link text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ BEGIN RETURN; END $function$;
CREATE OR REPLACE FUNCTION public.auto_advance_solicitacao_on_registro()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
 IF NEW.solicitacao_id IS NULL THEN RETURN NEW; END IF;
 IF TG_OP='UPDATE' AND OLD.hora_inicio IS NULL AND NEW.hora_inicio IS NOT NULL THEN
  UPDATE public.portal_solicitacoes SET status='em_visita',updated_at=now()
   WHERE id=NEW.solicitacao_id AND status NOT IN ('concluida','cancelada');
 END IF;
 -- Não concluir solicitação no encaminhamento; OS/comerciais têm ciclos próprios.
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION public.b2b_phase1_order_visible(p_order uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$ SELECT platform_private.b2b_phase1_order_visible(p_order); $function$;
CREATE OR REPLACE FUNCTION public.b2b_phase1_partner_visible(p_partner uuid, p_technical boolean DEFAULT false)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$ SELECT platform_private.b2b_phase1_partner_visible(p_partner,p_technical); $function$;
CREATE OR REPLACE FUNCTION public.b2b_phase1_simulation_visible(p_sim uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$ SELECT platform_private.b2b_phase1_simulation_visible(p_sim); $function$;
CREATE OR REPLACE FUNCTION public.b2b_save_technical_simulation(p_payload jsonb)
 RETURNS uuid
 LANGUAGE sql
 SET search_path TO ''
AS $function$ SELECT platform_private.b2b_save_technical_simulation(p_payload); $function$;
CREATE OR REPLACE FUNCTION public.can_manage_catalog_tecnico(_uid uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT public.fn_authz_uid_scope_ok(_uid)
     AND (public.has_role(_uid,'administrador')
      OR public.has_role(_uid,'gestor')
      OR public.has_role(_uid,'consultor_tecnico')
      OR public.has_role(_uid,'tecnico_agronomo'));
$function$;
CREATE OR REPLACE FUNCTION public.can_manage_technical_visit(p_user_id uuid, p_registro_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT public.technical_actor_ready(p_user_id) AND EXISTS (
 SELECT 1 FROM public.registros_consultor r
 WHERE r.id=p_registro_id AND public.technical_refs_in_actor_tenant(r.cliente_id,r.fazenda_id,r.talhao_id)
 AND (public.has_role(p_user_id,'administrador') OR public.has_role(p_user_id,'gestor')
 OR ((public.has_role(p_user_id,'consultor_tecnico') OR public.has_role(p_user_id,'tecnico_agronomo'))
 AND public.technical_client_link(p_user_id,r.cliente_id,ARRAY['execute','manage'])
 AND public.is_visit_responsible(p_user_id,r.id))));
$function$;
CREATE OR REPLACE FUNCTION public.can_user_access_aplicacao(_aplicacao_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT COALESCE(
    _aplicacao_id IS NOT NULL
    AND auth.uid() IS NOT NULL
    AND EXISTS (
      SELECT 1
      FROM public.aplicacoes a
      LEFT JOIN public.ordens_servico os ON os.id = a.ordem_servico_id
      LEFT JOIN public.clientes c ON c.id = os.cliente_id
      LEFT JOIN public.ordens_servico_onfarm oso ON oso.id = a.ordem_servico_onfarm_id
      LEFT JOIN public.clientes co ON co.id = oso.cliente_id
      WHERE a.id = _aplicacao_id
        AND a.organization_id = public.h15_actor_organization()
        -- Every present parent must exist and remain in the application's tenant.
        AND (a.ordem_servico_id IS NULL OR (
          os.id IS NOT NULL AND os.organization_id = a.organization_id
          AND c.id IS NOT NULL AND c.organization_id = a.organization_id
        ))
        -- On-farm has no organization_id: its persisted client is the tenant origin.
        AND (a.ordem_servico_onfarm_id IS NULL OR (
          oso.id IS NOT NULL AND co.id IS NOT NULL
          AND co.organization_id = a.organization_id
        ))
        AND (
          public.is_operational_staff(auth.uid())
          OR public.has_role(auth.uid(), 'financeiro'::app_role)
          OR os.cliente_id = ANY (public.get_cliente_ids_for_user(auth.uid()))
          OR oso.cliente_id = ANY (public.get_cliente_ids_for_user(auth.uid()))
        )
    ), false
  );
$function$;
CREATE OR REPLACE FUNCTION public.can_user_access_cliente(_user_id uuid, _cliente_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  IF _user_id IS NULL OR _cliente_id IS NULL THEN
    RETURN false;
  END IF;

  IF COALESCE(public.has_role(_user_id,'administrador'::app_role), false)
     OR COALESCE(public.has_role(_user_id,'gestor_comercial'::app_role), false)
     OR COALESCE(public.has_role(_user_id,'gestor'::app_role), false)
  THEN
    RETURN true;
  END IF;

  -- HARDENING: papéis técnicos exigem carteira ativa e vigente.
  IF COALESCE(public.has_role(_user_id,'tecnico_agronomo'::app_role), false)
     OR COALESCE(public.has_role(_user_id,'consultor_tecnico'::app_role), false)
  THEN
    RETURN COALESCE(
      public.has_active_user_cliente_access(
        _user_id, _cliente_id, ARRAY['read','execute','manage']
      ), false);
  END IF;

  IF COALESCE(public.has_role(_user_id,'parceiro_b2b'::app_role), false) THEN
    RETURN COALESCE((EXISTS (
      SELECT 1 FROM public.partner_clients pc
      JOIN public.partner_users pu ON pu.partner_id = pc.partner_id
      JOIN public.partner_accounts pa ON pa.id = pu.partner_id
      WHERE pu.user_id = _user_id AND pc.cliente_id = _cliente_id AND pc.active = true
        AND pu.revoked_at IS NULL
        AND pa.ativo = true AND pa.deleted_at IS NULL
        AND pa.commercial_owner_organization_id IS NOT NULL
        AND pu.tenant_id IS NOT NULL
        AND pu.tenant_id = pa.commercial_owner_organization_id
    )), false);
  END IF;

  IF COALESCE(public.has_role(_user_id,'parceiro_b2b_tecnico'::app_role), false) THEN
    RETURN COALESCE((EXISTS (
      SELECT 1 FROM public.partner_user_clients puc
      JOIN public.partner_users pu2 ON pu2.partner_id = puc.partner_id AND pu2.user_id = puc.user_id
      JOIN public.partner_accounts pa2 ON pa2.id = puc.partner_id
      WHERE puc.user_id = _user_id AND puc.cliente_id = _cliente_id AND puc.active = true
        AND pu2.revoked_at IS NULL
        AND pa2.ativo = true AND pa2.deleted_at IS NULL
        AND pa2.commercial_owner_organization_id IS NOT NULL
        AND pu2.tenant_id IS NOT NULL
        AND pu2.tenant_id = pa2.commercial_owner_organization_id
    ) OR EXISTS (
      SELECT 1 FROM public.partner_technician_clients ptc
      JOIN public.partner_users pu3 ON pu3.partner_id = ptc.partner_id AND pu3.user_id = ptc.technician_user_id
      JOIN public.partner_accounts pa3 ON pa3.id = ptc.partner_id
      WHERE ptc.technician_user_id = _user_id AND ptc.cliente_id = _cliente_id AND ptc.active = true
        AND pu3.revoked_at IS NULL
        AND pa3.ativo = true AND pa3.deleted_at IS NULL
        AND pa3.commercial_owner_organization_id IS NOT NULL
        AND pu3.tenant_id IS NOT NULL
        AND pu3.tenant_id = pa3.commercial_owner_organization_id
    )), false);
  END IF;

  RETURN COALESCE((EXISTS (
    SELECT 1 FROM public.user_clientes uc
    WHERE uc.user_id = _user_id
      AND uc.cliente_id = _cliente_id
      AND uc.is_active = true
      AND uc.revoked_at IS NULL
      AND (uc.valid_from IS NULL OR uc.valid_from <= now())
      AND (uc.valid_until IS NULL OR uc.valid_until >= now())
  )), false);
END;
$function$;
CREATE OR REPLACE FUNCTION public.can_user_create_aplicacao_for_cliente(_cliente_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
                                                                                                                              SELECT auth.uid() IS NOT NULL AND _cliente_id IS NOT NULL AND public.can_user_access_cliente(_cliente_id) AND (
                                                                                                                                  public.has_role(auth.uid(), 'administrador'::public.app_role)
                                                                                                                                      OR public.has_role(auth.uid(), 'gestor'::public.app_role)
                                                                                                                                          OR public.has_role(auth.uid(), 'administrativo'::public.app_role)
                                                                                                                                              OR public.has_role(auth.uid(), 'tecnico_agronomo'::public.app_role)
                                                                                                                                                  OR public.has_role(auth.uid(), 'consultor_tecnico'::public.app_role)
                                                                                                                                                      OR public.has_role(auth.uid(), 'aplicador'::public.app_role)
                                                                                                                                                          OR public.has_role(auth.uid(), 'operador_onfarm'::public.app_role)
                                                                                                                                                              OR public.has_role(auth.uid(), 'cliente_produtor'::public.app_role)
                                                                                                                                                                );
                                                                                                                                                                $function$;
CREATE OR REPLACE FUNCTION public.can_user_manage_aplicacao(_aplicacao_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT _aplicacao_id IS NOT NULL
     AND auth.uid() IS NOT NULL
     AND (
       public.has_role(auth.uid(), 'administrador'::app_role)
       OR public.has_role(auth.uid(), 'gestor'::app_role)
       OR public.has_role(auth.uid(), 'administrativo'::app_role)
       OR public.has_role(auth.uid(), 'consultor_tecnico'::app_role)
       OR public.has_role(auth.uid(), 'aplicador'::app_role)
     )
     AND EXISTS (SELECT 1 FROM public.aplicacoes a WHERE a.id = _aplicacao_id);
$function$;
CREATE OR REPLACE FUNCTION public.can_view_technical_visit(p_user_id uuid, p_registro_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT public.technical_actor_ready(p_user_id) AND EXISTS (
 SELECT 1 FROM public.registros_consultor r
 WHERE r.id=p_registro_id AND public.technical_refs_in_actor_tenant(r.cliente_id,r.fazenda_id,r.talhao_id)
 AND (public.has_role(p_user_id,'administrador') OR public.has_role(p_user_id,'gestor')
 OR ((public.has_role(p_user_id,'consultor_tecnico') OR public.has_role(p_user_id,'tecnico_agronomo'))
 AND public.technical_client_link(p_user_id,r.cliente_id,ARRAY['read','execute','manage'])
 AND (public.is_visit_responsible(p_user_id,r.id) OR public.is_active_visit_participant(p_user_id,r.id)))));
$function$;
CREATE OR REPLACE FUNCTION cf_user_guards_v1.acquire_gate()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF TG_LEVEL<>'STATEMENT' OR TG_RELID NOT IN ('public.profiles'::regclass,'public.user_roles'::regclass,'public.user_clientes'::regclass,'public.partner_users'::regclass,'auth.users'::regclass) THEN RAISE EXCEPTION 'invalid_user_guard_context' USING ERRCODE='42501'; END IF;
 IF current_setting('role',true) IN ('anon','authenticated') AND auth.uid() IS NULL THEN RAISE EXCEPTION 'user_edit_forbidden' USING ERRCODE='42501'; END IF;
 UPDATE cf_user_guards_v1.state SET revision=revision+1 WHERE singleton;
 IF NOT FOUND THEN RAISE EXCEPTION 'user_guard_unavailable' USING ERRCODE='PT503'; END IF;
 RETURN NULL;
END $function$;
CREATE OR REPLACE FUNCTION cf_user_guards_v1.advance_stamp()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
BEGIN NEW.updated_at:=greatest(clock_timestamp(),OLD.updated_at+interval '1 microsecond'); RETURN NEW; END $function$;
CREATE OR REPLACE FUNCTION cf_user_guards_v1.block_truncate()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
BEGIN RAISE EXCEPTION 'user_bulk_truncate_forbidden' USING ERRCODE='PT409'; END $function$;
CREATE OR REPLACE FUNCTION cf_user_guards_v1.require_admin()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF TG_LEVEL<>'STATEMENT' OR TG_RELID NOT IN ('public.profiles'::regclass,'public.user_roles'::regclass) THEN RAISE EXCEPTION 'invalid_user_guard_context' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.profiles p JOIN public.user_roles r USING(user_id) WHERE p.ativo IS TRUE AND r.role='administrador') THEN RAISE EXCEPTION 'user_last_active_admin' USING ERRCODE='PT409'; END IF;
 RETURN NULL;
END $function$;
CREATE OR REPLACE FUNCTION public.check_os_status_transition()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  status_order text[] := ARRAY['aberta', 'aprovada', 'programada', 'em_producao', 'em_cq', 'envase', 'aguardando_reserva', 'pronto_entrega', 'entregue', 'finalizada'];
  old_idx int;
  new_idx int;
  cq_count int;
  v_lote_id uuid;
BEGIN
  IF TG_TABLE_NAME='ordens_servico' AND OLD.status::text='programada' AND NEW.status::text='em_cq'
   AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=NEW.id)
   AND EXISTS(SELECT 1 FROM public.programacao_producao p JOIN public.lotes l ON l.programacao_id=p.id JOIN public.clientes c ON c.id=NEW.cliente_id
    WHERE p.ordem_servico_id=NEW.id AND p.ordem_servico_onfarm_id IS NULL AND p.organization_id=platform_private.h15_actor_organization()
    AND l.organization_id=p.organization_id AND NEW.organization_id=p.organization_id AND c.organization_id=p.organization_id AND l.status::text='em_producao')
  THEN RETURN NEW; END IF;
  -- Se o status não mudou, permite
  IF (OLD.status::text = NEW.status::text) THEN
    RETURN NEW;
  END IF;

  -- Se o novo status é 'cancelada', permite
  IF (NEW.status::text = 'cancelada') THEN
    RETURN NEW;
  END IF;

  -- Validação específica: Bloquear avanço para 'envase' se o CQ não estiver aprovado
  IF (NEW.status::text = 'envase') THEN
    -- Encontrar o lote associado a esta OS OnFarm
    -- A relação é OS -> Programação -> Lote
    SELECT l.id INTO v_lote_id
    FROM public.lotes l
    JOIN public.programacao_producao pp ON l.programacao_id = pp.id
    WHERE pp.ordem_servico_onfarm_id = NEW.id
    LIMIT 1;

    -- Se não encontrar por ordem_servico_onfarm_id, tenta pelo ordem_servico_id (caso seja OS padrão)
    IF v_lote_id IS NULL THEN
        SELECT l.id INTO v_lote_id
        FROM public.lotes l
        JOIN public.programacao_producao pp ON l.programacao_id = pp.id
        WHERE pp.ordem_servico_id = NEW.id
        LIMIT 1;
    END IF;

    IF v_lote_id IS NOT NULL THEN
        -- Verificar se existe controle de qualidade aprovado para este lote
        -- Assumindo que o enum de resultado do CQ possui 'aprovado'
        SELECT count(*) INTO cq_count
        FROM public.controle_qualidade
        WHERE lote_id = v_lote_id AND resultado::text = 'aprovado';

        IF cq_count = 0 THEN
            RAISE EXCEPTION 'Não é possível avançar para ENVASE: O lote vinculado a esta Ordem de Serviço ainda não possui um laudo de Controle de Qualidade APROVADO.'
            USING ERRCODE = 'check_violation';
        END IF;
    ELSE
        -- Se não há lote/programação, mas tentou ir para envase, pode ser inconsistência de dados
        -- Mas se o fluxo operacional permite envase sem lote em casos raros, poderíamos ignorar.
        -- Para garantir segurança, vamos exigir o lote se estiver na fase de produção.
        RAISE EXCEPTION 'Não é possível avançar para ENVASE: Nenhum lote de produção foi localizado para esta Ordem de Serviço.'
        USING ERRCODE = 'check_violation';
    END IF;
  END IF;

  -- Encontra os índices na esteira
  SELECT i INTO old_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = OLD.status::text;
  SELECT i INTO new_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = NEW.status::text;

  -- Validações:
  -- 1. Se o status antigo ou novo não estão na lista (e não é cancelamento), lança erro
  IF old_idx IS NULL OR new_idx IS NULL THEN
    RAISE EXCEPTION 'Status inválido ou transição não permitida para o fluxo operacional.';
  END IF;

  -- 2. Permite apenas avançar 1 posição por vez
  IF new_idx <> old_idx + 1
     AND NOT (new_idx = old_idx + 2 AND status_order[old_idx + 1] = 'aguardando_reserva') THEN
    RAISE EXCEPTION 'Transição de status inválida na esteira de produção: % -> %. A próxima etapa obrigatória é %.', 
      OLD.status::text, NEW.status::text, status_order[old_idx + 1];
  END IF;

  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.enforce_technical_content_editable()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_old uuid; v_new uuid; v_id uuid; v_status text;
BEGIN
 IF TG_OP <> 'INSERT' THEN v_old := (to_jsonb(OLD)->>TG_ARGV[0])::uuid; END IF;
 IF TG_OP <> 'DELETE' THEN v_new := (to_jsonb(NEW)->>TG_ARGV[0])::uuid; END IF;
 FOR v_id IN SELECT DISTINCT x FROM unnest(ARRAY[v_old,v_new]) x WHERE x IS NOT NULL ORDER BY x LOOP
  SELECT r.status::text INTO v_status FROM public.registros_consultor r WHERE r.id=v_id FOR SHARE;
  IF NOT FOUND OR v_status NOT IN ('rascunho','em_andamento') THEN
   RAISE EXCEPTION 'technical_content_locked: reabra a visita pelo fluxo autorizado antes de alterar seu conteúdo' USING ERRCODE='23514';
  END IF;
 END LOOP;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION public.enforce_visit_immutability()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  -- Technical content is frozen for every nature and actor after submission.
  -- Official RPCs may change status; version, timestamp and PDF processing are metadata.
  IF OLD.status::text NOT IN ('rascunho', 'em_andamento') AND
    (to_jsonb(NEW) - ARRAY['status','version','updated_at','pdf_status']::text[])
      IS DISTINCT FROM
    (to_jsonb(OLD) - ARRAY['status','version','updated_at','pdf_status']::text[])
  THEN
    RAISE EXCEPTION 'technical_record_content_locked'
      USING ERRCODE = '23514',
      HINT = 'Use the authorized adjustment workflow before editing technical content.';
  END IF;
  NEW.version := COALESCE(OLD.version, 1) + 1;
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_authz_uid_scope_ok(_uid uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  SELECT auth.uid() IS NULL
      OR (_uid IS NOT NULL AND _uid = auth.uid())
      OR public.has_role(auth.uid(), 'administrador'::app_role);
$function$;
CREATE OR REPLACE FUNCTION public.fn_b2b_credit_exposure(p_partner_id uuid, p_new_order_amount numeric DEFAULT 0, p_exclude_order_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_limit numeric(14,2); v_open numeric(14,2); v_overdue numeric(14,2);
  v_committed numeric(14,2); v_pending numeric(14,2);
  v_new numeric(14,2) := ROUND(COALESCE(p_new_order_amount,0),2);
  v_proj numeric(14,2); v_disp numeric(14,2); v_pct numeric;
  v_tolerance int; v_block boolean; v_action text; v_reason text;
BEGIN
  SELECT COALESCE(credit_limit,0), COALESCE(overdue_tolerance_days,0),
         COALESCE(block_if_overdue,false), COALESCE(credit_limit_action,'block')
    INTO v_limit, v_tolerance, v_block, v_action
  FROM public.partner_financial_settings WHERE partner_id = p_partner_id;
  v_limit := COALESCE(v_limit,0); v_tolerance := COALESCE(v_tolerance,0);
  v_block := COALESCE(v_block,false); v_action := COALESCE(v_action,'block');

  -- (a) recebiveis em aberto do parceiro
  SELECT COALESCE(SUM(ari.original_amount - ari.received_amount),0) INTO v_open
  FROM public.accounts_receivable ar
  JOIN public.accounts_receivable_installments ari ON ari.receivable_id = ar.id
  WHERE ar.partner_id = p_partner_id
    AND ar.status <> 'CANCELED'
    AND ari.status IN ('OPEN','PARTIAL','OVERDUE');

  SELECT COALESCE(SUM(ari.original_amount - ari.received_amount),0) INTO v_overdue
  FROM public.accounts_receivable ar
  JOIN public.accounts_receivable_installments ari ON ari.receivable_id = ar.id
  WHERE ar.partner_id = p_partner_id
    AND ar.status <> 'CANCELED'
    AND ari.status IN ('OPEN','PARTIAL','OVERDUE')
    AND ari.due_date < (current_date - v_tolerance);

  -- (b) pedidos com compromisso financeiro real e SEM recebivel gerado
  SELECT COALESCE(SUM(ROUND(COALESCE(po.final_amount_with_interest, po.total, 0),2)),0)
    INTO v_committed
  FROM public.partner_orders po
  WHERE po.partner_id = p_partner_id
    AND po.status IN ('aprovado','em_producao','produzido','aguardando_entrega',
                      'confirmado','em_separacao','enviado','entregue')
    AND COALESCE(po.receivable_generated,false) = false
    AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links pofl
                    WHERE pofl.partner_order_id = po.id)
    AND (p_exclude_order_id IS NULL OR po.id <> p_exclude_order_id);

  -- (c) H4-001: pedidos vivos ainda nao aprovados ja consomem limite.
  --     Sem isso, N pedidos em analise passavam individualmente no teste
  --     de credito e estouravam o limite ao serem aprovados.
  SELECT COALESCE(SUM(ROUND(COALESCE(po.final_amount_with_interest, po.total, 0),2)),0)
    INTO v_pending
  FROM public.partner_orders po
  WHERE po.partner_id = p_partner_id
    AND po.status IN ('pendente','solicitado','em_analise_comercial',
                      'aguardando_aprovacao_credito','aguardando_ajuste_comercial',
                      'aguardando_itens')
    AND COALESCE(po.receivable_generated,false) = false
    AND NOT EXISTS (SELECT 1 FROM public.partner_order_financial_links pofl
                    WHERE pofl.partner_order_id = po.id)
    AND (p_exclude_order_id IS NULL OR po.id <> p_exclude_order_id);

  v_proj := ROUND(v_open + v_committed + v_pending + v_new, 2);
  v_disp := GREATEST(v_limit - v_proj, 0);
  v_pct  := CASE WHEN v_limit > 0 THEN ROUND((v_proj / v_limit) * 100, 2) ELSE 0 END;

  v_reason := CASE
    WHEN v_block AND v_overdue > 0 THEN 'OVERDUE_BLOCK'
    WHEN v_limit <= 0 THEN 'NO_LIMIT_DEFINED'
    WHEN v_proj > v_limit AND v_action = 'approval_required' THEN 'LIMIT_EXCEEDED_APPROVAL'
    WHEN v_proj > v_limit THEN 'LIMIT_EXCEEDED_BLOCK'
    ELSE 'OK' END;

  RETURN jsonb_build_object(
    'partner_id', p_partner_id,
    'credit_limit', v_limit,
    'saldo_em_aberto', v_open,
    'saldo_vencido', v_overdue,
    'comprometido_nao_faturado', v_committed,
    'comprometido_pendente', v_pending,
    'novo_pedido', v_new,
    'exposicao_atual', ROUND(v_open + v_committed + v_pending, 2),
    'exposicao_projetada', v_proj,
    'credito_disponivel', v_disp,
    'percentual_utilizado', v_pct,
    'overdue_tolerance_days', v_tolerance,
    'block_if_overdue', v_block,
    'credit_limit_action', v_action,
    'tem_vencidos', v_overdue > 0,
    'reason_code', v_reason
  );
END $function$;
CREATE OR REPLACE FUNCTION public.fn_b2b_guard_order_items_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_order_id uuid := COALESCE(NEW.order_id, OLD.order_id);
  v_status public.partner_order_status;
BEGIN
  SELECT status INTO v_status FROM public.partner_orders WHERE id = v_order_id;
  IF v_status IS NOT NULL AND public.fn_b2b_status_is_approved_or_later(v_status) THEN
    RAISE EXCEPTION 'order_items_immutable_after_approval: pedido em status %', v_status
      USING ERRCODE = 'check_violation';
  END IF;
  RETURN COALESCE(NEW, OLD);
END $function$;
CREATE OR REPLACE FUNCTION public.fn_catalogo_litro_canonico(p_produto_id uuid, p_microrganismo_id uuid, OUT litro numeric, OUT tiers integer)
 RETURNS record
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT min(round(cv.preco_litro_brl,2)),
         COALESCE(count(DISTINCT round(cv.preco_litro_brl,2)),0)::int
  FROM public.catalogo_volumes cv
  WHERE cv.ativo = true
    AND cv.preco_litro_brl IS NOT NULL
    AND cv.produto_id IS NOT DISTINCT FROM p_produto_id
    AND cv.microrganismo_id IS NOT DISTINCT FROM p_microrganismo_id;
$function$;
CREATE OR REPLACE FUNCTION public.fn_catalogo_sync_mestre_preco(p_produto_id uuid, p_microrganismo_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_litro numeric;
  v_tiers integer;
BEGIN
  IF num_nonnulls(p_produto_id, p_microrganismo_id) <> 1 THEN RETURN; END IF;

  SELECT litro, tiers INTO v_litro, v_tiers
  FROM public.fn_catalogo_litro_canonico(p_produto_id, p_microrganismo_id);

  IF COALESCE(v_tiers,0) = 0 THEN
    RETURN; -- sem apresentacao ativa: preserva fallback legado
  END IF;

  PERFORM set_config('arbio.catalogo_sync', 'on', true);

  IF p_produto_id IS NOT NULL THEN
    IF v_tiers = 1 AND COALESCE(v_litro,0) > 0 THEN
      UPDATE public.produtos p
         SET valor_litro_brl = v_litro,
             valor_dose_brl  = round(v_litro / 10.0, 2),
             valor_ha_brl    = CASE WHEN COALESCE(p.dose_ml_ha,0) > 0
                                    THEN round(v_litro * (p.dose_ml_ha / 1000.0), 2) END
       WHERE p.id = p_produto_id
         AND (p.valor_litro_brl IS DISTINCT FROM v_litro
              OR p.valor_dose_brl IS DISTINCT FROM round(v_litro / 10.0, 2));
    ELSE
      UPDATE public.produtos p
         SET valor_litro_brl = NULL, valor_dose_brl = NULL, valor_ha_brl = NULL
       WHERE p.id = p_produto_id
         AND (p.valor_litro_brl IS NOT NULL OR p.valor_dose_brl IS NOT NULL OR p.valor_ha_brl IS NOT NULL);
    END IF;
  ELSE
    IF v_tiers = 1 AND COALESCE(v_litro,0) > 0 THEN
      UPDATE public.microrganismos m
         SET valor_litro_brl = v_litro,
             valor_dose_brl  = round(v_litro / 10.0, 2)
       WHERE m.id = p_microrganismo_id
         AND (m.valor_litro_brl IS DISTINCT FROM v_litro
              OR m.valor_dose_brl IS DISTINCT FROM round(v_litro / 10.0, 2));
    ELSE
      UPDATE public.microrganismos m
         SET valor_litro_brl = NULL, valor_dose_brl = NULL
       WHERE m.id = p_microrganismo_id
         AND (m.valor_litro_brl IS NOT NULL OR m.valor_dose_brl IS NOT NULL);
    END IF;
  END IF;

  PERFORM set_config('arbio.catalogo_sync', 'off', true);
END
$function$;
CREATE OR REPLACE FUNCTION public.fn_create_programacao_on_os_onfarm_insert()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
 IF NEW.status::text NOT IN ('aberta','aprovada','programada') THEN RETURN NEW; END IF;
 IF NEW.produto_id IS NULL AND NEW.microrganismo_id IS NULL THEN RETURN NEW; END IF;
 PERFORM platform_private.lab_assert_manufacturable(NEW.produto_id,NEW.microrganismo_id);
 IF EXISTS(SELECT 1 FROM public.programacao_producao WHERE ordem_servico_onfarm_id=NEW.id) THEN RETURN NEW; END IF;
 INSERT INTO public.programacao_producao(produto_id,microrganismo_id,volume_necessario,data_programada,status,ordem_servico_onfarm_id)
 VALUES(NEW.produto_id,NEW.microrganismo_id,NEW.volume_total_ml,coalesce(NEW.data_recomendada,CURRENT_DATE),'aguardando',NEW.id);
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION public.fn_entrega_assinatura_exigir_imagem_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog'
AS $function$
BEGIN
 IF NEW.assinatura_tipo='digital_tela' AND NEW.assinatura_digital_png_path IS NULL THEN
  RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='A assinatura digital exige uma imagem armazenada.';
 END IF;
 IF NEW.assinatura_digital_png_path IS NOT NULL AND NOT EXISTS (
  SELECT 1 FROM storage.objects o
  WHERE o.bucket_id='entrega-documentos' AND o.name=NEW.assinatura_digital_png_path
 ) THEN
  RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Imagem da assinatura não encontrada ou sem acesso no armazenamento.';
 END IF;
 RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_entrega_build_snapshot_v1(p_entrega_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'extensions'
AS $function$
DECLARE
  v jsonb;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'sessao_invalida' USING ERRCODE = '42501';
  END IF;
  IF NOT coalesce(public.is_delivery_staff(auth.uid()), false) THEN
    RAISE EXCEPTION 'sem_permissao' USING ERRCODE = '42501';
  END IF;
  SELECT jsonb_strip_nulls(jsonb_build_object(
    'template_versao', 'termo-entrega-v1',
    'gerado_em', now(),
    'entrega', to_jsonb(e),
    'cliente', (SELECT to_jsonb(c) FROM public.clientes c WHERE c.id = e.cliente_id),
    'ordem_servico', (SELECT to_jsonb(o) FROM public.ordens_servico o WHERE o.id = e.ordem_servico_id),
    'ordem_servico_onfarm', (SELECT to_jsonb(o) FROM public.ordens_servico_onfarm o WHERE o.id = e.ordem_servico_onfarm_id),
    'pedido_b2b', (SELECT to_jsonb(po) FROM public.partner_orders po WHERE po.id = e.partner_order_id),
    'comprovante', (SELECT to_jsonb(cp) FROM public.entrega_comprovantes cp WHERE cp.id = e.comprovante_id),
    'entregador', jsonb_build_object(
      'motorista', e.motorista, 'documento', e.motorista_documento,
      'telefone', e.motorista_telefone, 'veiculo', e.veiculo,
      'placa', e.veiculo_placa, 'tipo', e.veiculo_tipo),
    'destino', jsonb_build_object(
      'destinatario', e.destinatario_nome, 'telefone', e.destinatario_telefone,
      'logradouro', e.endereco_logradouro, 'numero', e.endereco_numero,
      'complemento', e.endereco_complemento, 'bairro', e.endereco_bairro,
      'cidade', e.endereco_cidade, 'uf', e.endereco_uf, 'cep', e.endereco_cep,
      'referencia', e.endereco_referencia, 'origem', e.endereco_origem),
    'recebedor', jsonb_build_object(
      'nome', e.recebedor_nome, 'documento', e.recebedor_documento,
      'cargo', e.recebedor_cargo, 'telefone', e.recebedor_telefone),
    'itens', coalesce((
      SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object(
        'etiqueta', to_jsonb(pe),
        'embalagem', (SELECT to_jsonb(eb) FROM public.estoque_embalagens eb WHERE eb.id = pe.embalagem_id),
        'lote', (SELECT to_jsonb(l) FROM public.lotes l WHERE l.id = pe.lote_id),
        'produto', (SELECT to_jsonb(pr) FROM public.produtos pr WHERE pr.id = pe.produto_id),
        'conferencia', (SELECT to_jsonb(ci) FROM public.entrega_conferencia_itens ci
                        WHERE ci.entrega_id = p_entrega_id AND ci.etiqueta_id = pe.id)
      )) ORDER BY pe.id)
      FROM public.entrega_etiquetas ee
      JOIN public.produto_etiquetas pe ON pe.id = ee.etiqueta_id
      WHERE ee.entrega_id = p_entrega_id AND ee.ativo
    ), '[]'::jsonb),
    'checklist', coalesce((SELECT jsonb_agg(to_jsonb(ck) ORDER BY ck.id)
                           FROM public.entrega_checklist ck WHERE ck.entrega_id = p_entrega_id), '[]'::jsonb),
    'ocorrencias', coalesce((SELECT jsonb_agg(to_jsonb(oc) ORDER BY oc.id)
                             FROM public.entrega_ocorrencias oc WHERE oc.entrega_id = p_entrega_id), '[]'::jsonb),
    'divergencias', coalesce((
      SELECT jsonb_agg(jsonb_build_object('etiqueta_id', ci.etiqueta_id, 'status', ci.status,
                                          'quantidade', ci.quantidade, 'motivo', ci.motivo) ORDER BY ci.id)
      FROM public.entrega_conferencia_itens ci
      WHERE ci.entrega_id = p_entrega_id AND ci.status <> 'aceito'), '[]'::jsonb)
  ))
  INTO v
  FROM public.entregas e
  WHERE e.id = p_entrega_id;

  IF v IS NULL THEN
    RAISE EXCEPTION 'entrega_nao_encontrada' USING ERRCODE = 'raise_exception';
  END IF;
  RETURN v;
END $function$;
CREATE OR REPLACE FUNCTION public.fn_entrega_comprovante_exigir_arquivo_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog'
AS $function$
BEGIN
  IF NEW.arquivo_path IS NULL THEN
    IF NEW.assinatura_tipo = 'fisica_anexada' THEN
      RAISE EXCEPTION USING ERRCODE = '23514',
        MESSAGE = 'O comprovante físico exige um arquivo anexado.';
    END IF;
    RETURN NEW;
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM storage.objects AS o
    WHERE o.bucket_id = 'entrega-documentos'
      AND o.name = NEW.arquivo_path
  ) THEN
    RAISE EXCEPTION USING ERRCODE = '23514',
      MESSAGE = 'Arquivo do comprovante não encontrado ou sem acesso no armazenamento.';
  END IF;
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_entrega_comprovante_preservar_encerrado_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog'
AS $function$
DECLARE
 v_operacionais text[]:=ARRAY['updated_at','metadata','qr_code_path','qr_code_generated_at','validation_public_enabled','validation_expires_at','validation_url'];
 v_campo text;
BEGIN
 IF TG_OP='DELETE' THEN
  IF OLD.status='confirmado' OR OLD.metadata ? 'comprovante_snapshot_v1' THEN
   RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Comprovante encerrado não pode ser excluído.';
  END IF;
  RETURN OLD;
 END IF;
 IF OLD.status='confirmado' AND
   (to_jsonb(NEW)-v_operacionais) IS DISTINCT FROM (to_jsonb(OLD)-v_operacionais) THEN
  RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Dados do comprovante confirmado não podem ser alterados.';
 END IF;
 IF OLD.metadata ? 'comprovante_snapshot_v1' THEN
  IF NEW.id IS DISTINCT FROM OLD.id OR NEW.entrega_id IS DISTINCT FROM OLD.entrega_id THEN
   RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Vínculo do comprovante congelado não pode ser alterado.';
  END IF;
  FOREACH v_campo IN ARRAY ARRAY['comprovante_snapshot_v1','comprovante_snapshot_hash','comprovante_numero'] LOOP
   IF NEW.metadata->v_campo IS DISTINCT FROM OLD.metadata->v_campo THEN
    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Conteúdo do comprovante congelado não pode ser alterado.';
   END IF;
  END LOOP;
 END IF;
 RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_entrega_marcar_cancelamento()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF NEW.status::text='cancelada' AND (TG_OP='INSERT' OR OLD.status::text IS DISTINCT FROM 'cancelada') THEN
  UPDATE platform_private.delivery_context_20261030 SET consumed=true
   WHERE txid=pg_catalog.txid_current() AND actor=auth.uid() AND organization_id=NEW.organization_id
    AND action='cancel' AND target=NEW.id AND consumed=false;
  IF NOT FOUND THEN RAISE EXCEPTION 'ENTREGA_CANCELAMENTO_EXIGE_RPC' USING ERRCODE='42501'; END IF;
  NEW.cancelada_em:=COALESCE(NEW.cancelada_em,pg_catalog.now()); NEW.cancelada_por:=auth.uid();
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION public.fn_envase_material_imutavel()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN

  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'ENVASE_IMUTAVEL: o envase % do lote % nao pode ser excluido. Registre um estorno/novo envase.', OLD.id, OLD.lote_id
      USING ERRCODE = 'check_violation';
  END IF;

  IF NEW.lote_id IS DISTINCT FROM OLD.lote_id
     OR NEW.quantidade IS DISTINCT FROM OLD.quantidade
     OR NEW.volume_por_unidade IS DISTINCT FROM OLD.volume_por_unidade THEN
    RAISE EXCEPTION 'ENVASE_IMUTAVEL: lote/quantidade/volume_por_unidade do envase % nao podem ser alterados apos o registro.', OLD.id
      USING ERRCODE = 'check_violation';
  END IF;

  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_fin_dashboard_kpis(_from date, _to date)
 RETURNS jsonb
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
DECLARE r jsonb;
BEGIN
  IF NOT public.is_financial_staff(auth.uid()) THEN RAISE EXCEPTION 'Acesso negado'; END IF;
  SELECT jsonb_build_object(
    'receitas_previstas', COALESCE((SELECT SUM(original_amount - COALESCE(received_amount,0) - COALESCE(discount_amount,0))
        FROM accounts_receivable_installments WHERE status IN ('OPEN','PARTIAL','OVERDUE') AND due_date BETWEEN _from AND _to),0),
    'receitas_realizadas', COALESCE((SELECT SUM(amount_received) FROM receivable_payments WHERE payment_date BETWEEN _from AND _to),0),
    'despesas_previstas', COALESCE((SELECT SUM(original_amount - COALESCE(paid_amount,0) - COALESCE(discount_amount,0))
        FROM accounts_payable_installments WHERE status IN ('OPEN','PARTIAL','OVERDUE') AND due_date BETWEEN _from AND _to),0),
    'despesas_realizadas', COALESCE((SELECT SUM(amount_paid) FROM payable_payments WHERE payment_date BETWEEN _from AND _to),0),
    'inadimplencia_total', COALESCE((SELECT SUM(original_amount - COALESCE(received_amount,0) - COALESCE(discount_amount,0))
        FROM accounts_receivable_installments WHERE status IN ('OPEN','PARTIAL','OVERDUE') AND due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date),0),
    'pagar_vencidas', COALESCE((SELECT SUM(original_amount - COALESCE(paid_amount,0) - COALESCE(discount_amount,0))
        FROM accounts_payable_installments WHERE status IN ('OPEN','PARTIAL','OVERDUE') AND due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date),0),
    'entregas_nao_faturadas_qtd', COALESCE((SELECT COUNT(*) FROM entregas WHERE financial_status='PENDING_BILLING' AND receivable_id IS NULL),0),
    'entregas_nao_faturadas_valor', COALESCE((SELECT SUM(e.quantidade_entregue * p.valor_litro_brl) FROM entregas e
        LEFT JOIN produtos p ON p.id = e.produto_id WHERE e.financial_status='PENDING_BILLING' AND e.receivable_id IS NULL),0),
    'nfe_pendente_qtd', COALESCE((SELECT COUNT(*) FROM accounts_receivable WHERE fiscal_invoice_required=true AND fiscal_invoice_status='PENDING'),0),
    'nfe_pendente_valor', COALESCE((SELECT SUM(total_amount) FROM accounts_receivable WHERE fiscal_invoice_required=true AND fiscal_invoice_status='PENDING'),0)
  ) INTO r;
  RETURN r;
END $function$;
CREATE OR REPLACE FUNCTION public.fn_fiscal_can_read_internal(_uid uuid DEFAULT auth.uid())
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  SELECT _uid IS NOT NULL AND public.fn_authz_uid_scope_ok(_uid) AND (
    public.has_role(_uid,'administrador'::app_role)
    OR public.has_role(_uid,'gestor'::app_role)
    OR public.has_role(_uid,'financeiro'::app_role));
$function$;
CREATE OR REPLACE FUNCTION public.fn_generate_receivable_installments()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  i int;
  v_context platform_private.financial_initial_installments;
  v_inst jsonb;
  v_qtd int := NEW.installment_count;
  v_base numeric(14,2) := ROUND(NEW.total_amount / v_qtd, 2);
  v_acc numeric(14,2) := 0;
  v_amt numeric(14,2);
BEGIN
  IF NEW.organization_id IS NULL THEN
    RAISE EXCEPTION 'FINANCIAL_TENANT_REQUIRED' USING ERRCODE = '23514';
  END IF;
  DELETE FROM platform_private.financial_initial_installments
    WHERE transaction_id=txid_current() AND title_id=NEW.id AND kind='receivable'
    RETURNING * INTO v_context;
  IF FOUND THEN
    IF v_context.actor_id IS DISTINCT FROM auth.uid() OR v_context.organization_id IS DISTINCT FROM NEW.organization_id
       OR NEW.created_by IS DISTINCT FROM v_context.actor_id OR NEW.origin_type <> 'MANUAL'
       OR platform_private.h15_actor_organization() IS DISTINCT FROM NEW.organization_id
       OR NOT public.is_financial_staff(auth.uid()) THEN
      RAISE EXCEPTION 'FIN_INITIAL_CONTEXT_DENIED' USING ERRCODE='42501';
    END IF;
    IF jsonb_array_length(v_context.installments) <> NEW.installment_count
       OR (SELECT sum((x->>'amount')::numeric) FROM jsonb_array_elements(v_context.installments) x) IS DISTINCT FROM NEW.total_amount THEN
      RAISE EXCEPTION 'FIN_TITLE_INVALID_SUM' USING ERRCODE='23514';
    END IF;
    FOR v_inst IN SELECT * FROM jsonb_array_elements(v_context.installments) LOOP
      INSERT INTO public.accounts_receivable_installments(organization_id,receivable_id,installment_number,due_date,original_amount,net_amount,status)
        VALUES(NEW.organization_id,NEW.id,(v_inst->>'installment_number')::int,(v_inst->>'due_date')::date,
          (v_inst->>'amount')::numeric,(v_inst->>'amount')::numeric,'OPEN');
    END LOOP;
    RETURN NEW;
  END IF;
  IF NEW.origin_type='B2B_ORDER' AND EXISTS(SELECT 1 FROM public.partner_orders o WHERE o.id=NEW.origin_id AND o.c2_external_origin_snapshot IS NOT NULL) THEN
    INSERT INTO public.accounts_receivable_installments(receivable_id,installment_number,due_date,original_amount,net_amount,status,organization_id,interest_amount)
    SELECT NEW.id,s.installment_number,s.due_date,s.amount,s.amount,'OPEN',NEW.organization_id,s.interest_amount
    FROM public.partner_order_payment_schedule s JOIN public.partner_orders o ON o.id=s.partner_order_id AND o.payment_terms_id=s.payment_terms_id
    WHERE o.id=NEW.origin_id ORDER BY s.installment_number;
    IF (SELECT count(*) FROM public.accounts_receivable_installments WHERE receivable_id=NEW.id)<>v_qtd THEN RAISE EXCEPTION 'B2B_INSTALLMENT_CARDINALITY_INVALID' USING ERRCODE='23514'; END IF;
    RETURN NEW;
  END IF;
  FOR i IN 1..v_qtd LOOP
    IF i < v_qtd THEN
      v_amt := v_base;
      v_acc := v_acc + v_amt;
    ELSE
      v_amt := NEW.total_amount - v_acc;
    END IF;
    INSERT INTO public.accounts_receivable_installments
      (receivable_id, installment_number, due_date, original_amount, net_amount, status, organization_id)
    VALUES
      (NEW.id, i, (NEW.first_due_date + ((i-1) || ' months')::interval)::date, v_amt, v_amt, 'OPEN', NEW.organization_id);
  END LOOP;
  RETURN NEW;
END
$function$;
CREATE OR REPLACE FUNCTION public.fn_microorganism_regulatory_facts(p_microorganism_id uuid)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  WITH g AS (
    SELECT (auth.uid() IS NULL
            OR public.fn_regulatory_can_read(auth.uid())
            OR public.fn_fiscal_can_read_internal(auth.uid())
            OR public.can_view_catalog_internal(auth.uid())) AS ok
  ), d AS (
    SELECT * FROM public.microorganism_regulatory_dossiers
     WHERE microorganism_id = p_microorganism_id AND deleted_at IS NULL
       AND (SELECT ok FROM g)
     ORDER BY (status='VALIDATED') DESC, version DESC
     LIMIT 1)
  SELECT CASE WHEN NOT (SELECT ok FROM g) THEN NULL
              WHEN NOT EXISTS (SELECT 1 FROM d) THEN NULL ELSE (
    SELECT jsonb_build_object(
      'dossier_id', d.id,
      'version', d.version,
      'status', d.status,
      'blocked_reason', d.blocked_reason,
      'regulatory_category', d.regulatory_category,
      'strain', coalesce(nullif(btrim(coalesce(d.strain_code,'')),''), nullif(btrim(coalesce(d.strain_name,'')),'')),
      'formulation', nullif(btrim(coalesce(d.formulation,'')),''),
      'label_guarantee', nullif(btrim(coalesce(d.label_guarantee,'')),''),
      'mapa_status', d.mapa_status,
      'mapa_registration_number', nullif(btrim(coalesce(d.mapa_registration_number,'')),''),
      'mapa_holder', nullif(btrim(coalesce(d.mapa_holder,'')),''),
      'mapa_valid_until', d.mapa_valid_until,
      'mapa_not_applicable_reason', nullif(btrim(coalesce(d.mapa_not_applicable_reason,'')),''),
      'published_ncm', d.published_ncm,
      'published_cest', d.published_cest,
      'effective_from', d.effective_from,
      'effective_to', d.effective_to,
      'review_technical', d.technical_review_status,
      'review_regulatory', d.regulatory_review_status,
      'review_fiscal', d.fiscal_review_status,
      'has_label_document', EXISTS (SELECT 1 FROM public.microorganism_regulatory_documents x
                                     WHERE x.dossier_id=d.id AND x.deleted_at IS NULL AND x.doc_type='ROTULO'),
      'has_report_document', EXISTS (SELECT 1 FROM public.microorganism_regulatory_documents x
                                     WHERE x.dossier_id=d.id AND x.deleted_at IS NULL AND x.doc_type IN ('LAUDO','CERTIFICADO_ANALISE')),
      'expired_documents', (SELECT count(*) FROM public.microorganism_regulatory_documents x
                             WHERE x.dossier_id=d.id AND x.deleted_at IS NULL
                               AND x.valid_until IS NOT NULL AND x.valid_until < current_date),
      'ncm_approved', EXISTS (SELECT 1 FROM public.microorganism_ncm_candidates c
                               WHERE c.dossier_id=d.id AND c.status='APPROVED'),
      'ncm_candidates', (SELECT count(*) FROM public.microorganism_ncm_candidates c WHERE c.dossier_id=d.id),
      'checklist_total', (SELECT count(*) FROM public.microorganism_regulatory_checklist c WHERE c.dossier_id=d.id),
      'checklist_pending', coalesce((SELECT jsonb_agg(c.item_key ORDER BY c.item_key)
                                      FROM public.microorganism_regulatory_checklist c
                                      WHERE c.dossier_id=d.id AND c.state='PENDING'),'[]'::jsonb),
      'checklist_not_applicable', coalesce((SELECT jsonb_agg(jsonb_build_object(
                                      'item_key',c.item_key,'justification',c.justification) ORDER BY c.item_key)
                                      FROM public.microorganism_regulatory_checklist c
                                      WHERE c.dossier_id=d.id AND c.state='NOT_APPLICABLE'),'[]'::jsonb),
      'checklist_confirmed', (SELECT count(*) FROM public.microorganism_regulatory_checklist c
                               WHERE c.dossier_id=d.id AND c.state='CONFIRMED'),
      'presentations_total', (SELECT count(*) FROM public.microorganism_regulatory_presentations p WHERE p.dossier_id=d.id),
      'presentations_units_unconfirmed', (SELECT count(*) FROM public.microorganism_regulatory_presentations p
                                           WHERE p.dossier_id=d.id AND NOT p.units_confirmed),
      'presentations_gtin_unconfirmed', (SELECT count(*) FROM public.microorganism_regulatory_presentations p
                                          WHERE p.dossier_id=d.id AND NOT p.gtin_confirmed))
    FROM d) END;
$function$;
CREATE OR REPLACE FUNCTION public.fn_notify_lab_on_programacao()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ DECLARE org uuid; prod text; cli text; BEGIN
 IF NEW.status::text<>'aguardando' THEN RETURN NEW; END IF;
 org:=platform_private.notification_source_org('programacao_producao',NEW.id);
 IF org IS NULL THEN RETURN NEW; END IF;
 SELECT nome INTO prod FROM public.produtos WHERE id=NEW.produto_id;
 SELECT c.nome INTO cli FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id AND c.organization_id=org WHERE o.id=NEW.ordem_servico_id;
 INSERT INTO public.notificacoes_operacionais(usuario_id,tipo,titulo,mensagem,link,source_type,source_id)
 SELECT DISTINCT ur.user_id,'nova_demanda_producao','Nova demanda de produção',coalesce(prod,'Bioinsumo')||coalesce(' · '||cli,'')||coalesce(' · '||round(NEW.volume_necessario/1000.0,1)::text||' L',''),'/pcp?coluna=aguardando','programacao_producao',NEW.id
 FROM public.user_roles ur WHERE ur.role IN ('producao','administrador','gestor') AND platform_private.notification_user_ok(ur.user_id,org);
 RETURN NEW; END $function$;
CREATE OR REPLACE FUNCTION public.fn_regulatory_can_prepare(_uid uuid DEFAULT auth.uid())
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  SELECT _uid IS NOT NULL AND public.fn_authz_uid_scope_ok(_uid) AND (
    public.has_role(_uid,'administrador'::app_role)
    OR public.has_role(_uid,'gestor'::app_role));
$function$;
CREATE OR REPLACE FUNCTION public.fn_regulatory_can_read(_uid uuid DEFAULT auth.uid())
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  SELECT _uid IS NOT NULL AND public.fn_authz_uid_scope_ok(_uid) AND (
    public.has_role(_uid,'administrador'::app_role)
    OR public.has_role(_uid,'gestor'::app_role)
    OR public.has_role(_uid,'financeiro'::app_role)
    OR public.has_role(_uid,'tecnico_agronomo'::app_role));
$function$;
CREATE OR REPLACE FUNCTION public.fn_validate_envase_volume()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_produzido numeric;
  v_envasado numeric;
  v_novo numeric;
  v_codigo text;
  v_saldo numeric;
BEGIN
  IF NEW.quantidade IS NULL OR NEW.quantidade <= 0 THEN
    RAISE EXCEPTION 'A quantidade do envase deve ser maior que zero.' USING ERRCODE = 'check_violation';
  END IF;
  IF NEW.volume_por_unidade IS NULL OR NEW.volume_por_unidade <= 0 OR NEW.volume_por_unidade::text IN ('NaN','Infinity','-Infinity') THEN
    RAISE EXCEPTION 'O volume por unidade deve ser maior que zero.' USING ERRCODE = 'check_violation';
  END IF;

  -- H5-B01/B02: serializa qualquer INSERT de envase (inclusive direto via RLS) pela linha do lote.
  -- Ordem de lock compatível com rpc_cockpit_registrar_envase_v1 (programacao -> lote).
  SELECT volume_produzido, codigo_lote INTO v_produzido, v_codigo
  FROM public.lotes WHERE id = NEW.lote_id FOR UPDATE;

  IF v_codigo IS NULL AND v_produzido IS NULL THEN
    RAISE EXCEPTION 'Lote % inexistente para envase.', NEW.lote_id USING ERRCODE = 'check_violation';
  END IF;

  IF v_produzido IS NULL OR v_produzido <= 0 OR v_produzido::text IN ('NaN','Infinity','-Infinity') THEN
    RAISE EXCEPTION 'O lote % não possui volume produzido informado. Registre a produção antes de envasar.', COALESCE(v_codigo,'(desconhecido)')
      USING ERRCODE = 'check_violation';
  END IF;

  v_envasado := public.lote_volume_envasado(NEW.lote_id);
  v_novo := COALESCE(NEW.volume_por_unidade,0) * COALESCE(NEW.quantidade,0);
  v_saldo := v_produzido - v_envasado;

  IF (v_envasado + v_novo) > v_produzido THEN
    RAISE EXCEPTION 'Envase excede o volume produzido do lote %. Produzido: % L, já envasado: % L, saldo disponível: % L, solicitado: % L.',
      COALESCE(v_codigo,'(desconhecido)'),
      ROUND(v_produzido/1000.0, 2),
      ROUND(v_envasado/1000.0, 2),
      ROUND(v_saldo/1000.0, 2),
      ROUND(v_novo/1000.0, 2)
      USING ERRCODE = 'check_violation';
  END IF;

  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.generate_b2b_receivable_secure(p_partner_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;

  IF auth.uid() IS NULL THEN
    IF pg_trigger_depth()=0 THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  ELSIF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (
    SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id
      AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN RAISE EXCEPTION 'b2b_phase1_scope_denied' USING ERRCODE='42501'; END IF;
  IF NOT (pg_trigger_depth() > 0 or public.has_role(auth.uid(), 'administrador'::public.app_role)
      or public.has_role(auth.uid(), 'gestor'::public.app_role)
      or public.has_role(auth.uid(), 'financeiro'::public.app_role)) THEN
    RAISE EXCEPTION 'permission_denied' USING ERRCODE = '42501';
  END IF;
 IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND internal_origin_snapshot IS NOT NULL) THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1') THEN RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501'; END IF;
  IF p_partner_order_id IS NULL THEN
    RAISE EXCEPTION 'partner_order_id_required' USING ERRCODE='P0001';
  END IF;

  -- Canonical row-before-receipt order, matching approval and its billing trigger.
  PERFORM 1 FROM public.partner_orders WHERE id=p_partner_order_id FOR UPDATE;

  -- Serializa concorrencia real (clique duplo / chamadas simultaneas).
  -- Chave unica bigint: assinatura pg_advisory_xact_lock(bigint).
  PERFORM pg_advisory_xact_lock(
    hashtextextended('b2b_receivable:' || p_partner_order_id::text, 0)
  );

  IF NOT public.fn_b2b_order_priceable(p_partner_order_id) THEN
    RAISE EXCEPTION 'order_not_priceable_quote_required' USING ERRCODE='P0001';
  END IF;

  RETURN public.generate_b2b_receivable_secure_impl(p_partner_order_id);
END $function$;
CREATE OR REPLACE FUNCTION public.generate_b2b_receivable_secure_impl(p_partner_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_order record;
  v_partner record;
  v_settings record;
  v_terms record;
  v_receivable_id uuid;
  v_category_id uuid;
  v_payment_method_id uuid;
  v_existing uuid;
  v_sch record;
  v_ari_id uuid;
  v_installments_json jsonb := '[]'::jsonb;
  v_system_call boolean := (v_uid IS NULL);
  v_gate jsonb;
  v_fiscal jsonb;
  v_uf text;
  v_org uuid;
  v_org_count integer; -- b2b_f1_financial_tenant
BEGIN
  IF NOT v_system_call THEN
    IF NOT (has_role(v_uid,'administrador') OR has_role(v_uid,'financeiro') OR has_role(v_uid,'gestor') OR has_role(v_uid,'gestor_comercial')) THEN
      INSERT INTO public.partner_order_audit_logs(order_id, usuario_id, acao, dados_novos)
        VALUES (p_partner_order_id, v_uid, 'financeiro_permissao_negada', jsonb_build_object('motivo','sem permissão'));
      RAISE EXCEPTION 'Sem permissão para gerar cobrança B2B';
    END IF;
  END IF;

  SELECT * INTO v_order FROM public.partner_orders WHERE id = p_partner_order_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Pedido não encontrado'; END IF;

  -- Deterministic partner ownership, never caller-supplied organization.
  SELECT count(*), min(o.id::text)::uuid INTO v_org_count,v_org
    FROM public.organizations o WHERE o.partner_account_id=v_order.partner_id;
  -- c2_ord_owner_tenant: cliente comercial sem tenant próprio fatura no tenant dono.
  IF v_org_count = 0 THEN
    SELECT count(*), min(o.id::text)::uuid INTO v_org_count, v_org
      FROM public.partner_accounts pa JOIN public.organizations o ON o.id = pa.commercial_owner_organization_id
     WHERE pa.id = v_order.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
       AND o.ativo IS TRUE AND o.status = 'ativa';
  END IF;
  IF v_org_count <> 1 OR v_org IS NULL THEN
    RAISE EXCEPTION 'B2B_FINANCIAL_TENANT_AMBIGUOUS' USING ERRCODE='42501';
  END IF;
  IF v_uid IS NOT NULL THEN
    -- c2_ord_internal_scope: emissor interno é limitado por h15 = tenant do título (abaixo);
    -- quem tem papel B2B externo continua passando pelo assert canônico.
    IF public.has_role(v_uid,'parceiro_b2b'::app_role) OR public.has_role(v_uid,'parceiro_b2b_tecnico'::app_role) THEN
      PERFORM platform_private.assert_b2b_partner_scope(v_uid,v_order.partner_id);
    END IF;
    IF NOT public.is_platform_superadmin(v_uid) AND public.h15_actor_organization() IS DISTINCT FROM v_org THEN
      RAISE EXCEPTION 'B2B_FINANCIAL_TENANT_MISMATCH' USING ERRCODE='42501';
    END IF;
  END IF;

  IF v_order.c2_external_origin_snapshot IS NOT NULL THEN
    PERFORM platform_private.c2_external_origin_assert(v_order.c2_external_origin_snapshot,v_order.partner_id,v_order.cliente_id);
    IF v_org::text IS DISTINCT FROM v_order.c2_external_origin_snapshot->>'creditor_organization_id' THEN RAISE EXCEPTION 'C2_EXTERNAL_CREDITOR_DRIFT' USING ERRCODE='42501'; END IF;
  END IF;

  -- GATE Fase C: elegibilidade server-side
  v_gate := public.fn_b2b_order_billing_eligibility(p_partner_order_id);
  IF NOT (v_gate->>'eligible')::boolean THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
      VALUES (p_partner_order_id, v_order.partner_id, v_uid, 'financeiro_bloqueado_gate', v_gate);
    RAISE EXCEPTION 'billing_not_eligible:%', v_gate->>'reason_code';
  END IF;

  -- H6C-001: condicao canonica vinculada ao pedido (nunca a mais recente).
  SELECT * INTO v_terms FROM public.partner_order_payment_terms
    WHERE id = NULLIF(v_gate->>'payment_terms_id','')::uuid
      AND partner_order_id = p_partner_order_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'payment_terms_not_canonical'; END IF;

  SELECT receivable_id INTO v_existing FROM public.partner_order_financial_links WHERE partner_order_id = p_partner_order_id;
  IF v_existing IS NOT NULL THEN
    INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
      VALUES (p_partner_order_id, v_order.partner_id, v_uid, 'financeiro_duplicidade_bloqueada', jsonb_build_object('receivable_id', v_existing));
    RETURN jsonb_build_object('receivable_id', v_existing, 'partner_order_id', p_partner_order_id, 'duplicado', true);
  END IF;

  SELECT * INTO v_partner FROM public.partner_accounts WHERE id = v_order.partner_id;
  SELECT * INTO v_settings FROM public.partner_financial_settings WHERE partner_id = v_order.partner_id;
  IF NOT FOUND THEN
    -- c2_ord_p1_no_provision: only the existing P1 CAS RPC creates settings.
    RAISE EXCEPTION 'B2B_FINANCIAL_SETTINGS_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;

  -- External manual billing must honor configured delivery prerequisite too.
  IF v_order.c2_external_origin_snapshot IS NOT NULL AND v_settings.billing_trigger='na_entrega' AND v_order.status IS DISTINCT FROM 'entregue' THEN
    RAISE EXCEPTION 'C2_EXTERNAL_DELIVERY_REQUIRED' USING ERRCODE='42501';
  END IF;

  v_uf := to_jsonb(v_partner) ->> 'uf';

  -- Derivação fiscal (fail-closed; nunca NOT_REQUIRED silencioso)
  v_fiscal := public.fn_fiscal_requirement_resolve(
    'b2b_partner', 'venda_mercadoria', v_uf, 'partner_order', p_partner_order_id, CURRENT_DATE);

  -- c2_ord_strict_refs: financial_categories/payment_methods são catálogos globais por desenho (sem organization_id, RLS is_financial_staff; sem DDL de tenant
  -- no schema canônico); resolução estrita, sem fallback de tipo/inativo, falha explícita.
  SELECT id INTO v_category_id FROM public.financial_categories
   WHERE upper(btrim(type)) = 'RECEITA' AND active IS TRUE
   ORDER BY created_at ASC, id ASC LIMIT 1;
  IF v_category_id IS NULL THEN
    RAISE EXCEPTION 'B2B_REVENUE_CATEGORY_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  IF NULLIF(btrim(COALESCE(v_settings.default_payment_method,'')),'') IS NULL THEN
    RAISE EXCEPTION 'B2B_PAYMENT_METHOD_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  IF (SELECT count(*) FROM public.payment_methods pm
       WHERE pm.active IS TRUE AND lower(btrim(pm.name)) = lower(btrim(v_settings.default_payment_method))) <> 1 THEN
    RAISE EXCEPTION 'B2B_PAYMENT_METHOD_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  SELECT pm.id INTO v_payment_method_id FROM public.payment_methods pm
   WHERE pm.active IS TRUE AND lower(btrim(pm.name)) = lower(btrim(v_settings.default_payment_method));
  IF v_partner.client_id IS NOT NULL AND NOT EXISTS (
       SELECT 1 FROM public.clientes cl WHERE cl.id = v_partner.client_id AND cl.organization_id = v_org) THEN
    RAISE EXCEPTION 'B2B_CUSTOMER_TENANT_MISMATCH' USING ERRCODE='42501';
  END IF;

  INSERT INTO public.accounts_receivable(
    organization_id, origin_type, origin_id, customer_id, partner_id, description,
    category_id, total_amount, issue_date, first_due_date, installment_count,
    status, fiscal_invoice_required, fiscal_invoice_status,
    fiscal_requirement_source, fiscal_policy_id, fiscal_exemption_id,
    payment_method_id, notes, created_by
  ) VALUES (
    v_org, 'B2B_ORDER', p_partner_order_id,
    NULLIF(v_partner.client_id, NULL), v_order.partner_id,
    format('Pedido B2B %s - %s', v_order.numero, COALESCE(v_partner.nome_fantasia, v_partner.razao_social)),
    v_category_id, v_terms.final_amount, CURRENT_DATE, v_terms.first_due_date, v_terms.installment_count,
    'OPEN',
    (v_fiscal->>'required')::boolean,
    v_fiscal->>'status',
    v_fiscal->>'source',
    NULLIF(v_fiscal->>'policy_id','')::uuid,
    NULLIF(v_fiscal->>'exemption_id','')::uuid,
    v_payment_method_id,
    format(E'Condição: %s (%s)\nDesconto: %s%%  Juros: %s%% a.m. x %s meses\nTabela: %s  Líquido: %s  Final: %s\nFiscal: %s (%s)',
           v_terms.plan_name_snapshot, v_terms.plan_code_snapshot,
           v_terms.discount_percent_snapshot, v_terms.monthly_interest_percent_snapshot, v_terms.months_count_snapshot,
           v_terms.table_amount, v_terms.net_amount_after_discount, v_terms.final_amount,
           v_fiscal->>'status', v_fiscal->>'source'),
    COALESCE(v_uid, v_order.created_by)
  ) RETURNING id INTO v_receivable_id;

  -- b2b_f1_fresh_title: no deletion; formal financial history protection preserved.

  FOR v_sch IN
    SELECT * FROM public.partner_order_payment_schedule
     WHERE partner_order_id = p_partner_order_id AND payment_terms_id = v_terms.id
     ORDER BY installment_number
  LOOP
    -- b2b_f1_reuse_installments: generic title trigger already created them.
    IF (SELECT count(*) FROM public.accounts_receivable_installments
         WHERE receivable_id=v_receivable_id AND installment_number=v_sch.installment_number
           AND organization_id=v_org) <> 1 THEN
      RAISE EXCEPTION 'B2B_INSTALLMENT_CARDINALITY_INVALID' USING ERRCODE='23514';
    END IF;
    UPDATE public.accounts_receivable_installments
       SET due_date=v_sch.due_date, original_amount=v_sch.amount,
           interest_amount=COALESCE(v_sch.interest_amount,0), net_amount=v_sch.amount
     WHERE receivable_id=v_receivable_id AND installment_number=v_sch.installment_number
       AND organization_id=v_org
     RETURNING id INTO v_ari_id;

    UPDATE public.partner_order_payment_schedule
       SET status = 'generated', receivable_installment_id = v_ari_id
     WHERE id = v_sch.id;

    v_installments_json := v_installments_json || jsonb_build_array(jsonb_build_object(
      'installment_number', v_sch.installment_number,
      'due_date', v_sch.due_date,
      'amount', v_sch.amount
    ));
  END LOOP;

  INSERT INTO public.partner_order_financial_links(
    partner_order_id, partner_id, receivable_id, financial_status, billing_trigger, created_by
  ) VALUES (
    p_partner_order_id, v_order.partner_id, v_receivable_id, 'gerado', v_settings.billing_trigger, v_uid
  );

  UPDATE public.partner_orders SET
    financial_status = 'gerado',
    receivable_generated = true,
    receivable_generated_at = now(),
    receivable_generated_by = v_uid,
    payment_due_date = v_terms.first_due_date,
    payment_method = COALESCE(v_settings.default_payment_method,'pix')
  WHERE id = p_partner_order_id;

  INSERT INTO public.partner_order_audit_logs(order_id, partner_id, usuario_id, acao, dados_novos)
  VALUES (p_partner_order_id, v_order.partner_id, v_uid, 'financeiro_gerado_com_plano',
    jsonb_build_object(
      'receivable_id', v_receivable_id,
      'plan_code', v_terms.plan_code_snapshot,
      'plan_name', v_terms.plan_name_snapshot,
      'table_amount', v_terms.table_amount,
      'discount_amount', v_terms.discount_amount,
      'net_amount', v_terms.net_amount_after_discount,
      'interest_amount', v_terms.financial_interest_amount,
      'final_amount', v_terms.final_amount,
      'first_due_date', v_terms.first_due_date,
      'installment_count', v_terms.installment_count,
      'fiscal', v_fiscal,
      'gate', v_gate,
      'installments', v_installments_json
    ));

  RETURN jsonb_build_object(
    'receivable_id', v_receivable_id,
    'partner_order_id', p_partner_order_id,
    'valor', v_terms.final_amount,
    'vencimento', v_terms.first_due_date,
    'installment_count', v_terms.installment_count,
    'fiscal_invoice_required', (v_fiscal->>'required')::boolean,
    'fiscal_invoice_status', v_fiscal->>'status',
    'fiscal_requirement_source', v_fiscal->>'source',
    'status', 'OPEN'
  );
END 
$function$;
CREATE OR REPLACE FUNCTION public.generate_production_orders_from_partner(p_partner_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_planning_id uuid;
  v_partner_id uuid;
  v_order_numero text;
  v_order_status text;
  v_ready boolean;
  v_partner_nome text;
  v_grp RECORD;
  v_item RECORD;
  v_os_id uuid;
  v_numero text;
  v_count int := 0;
  v_nonlab_count int := 0;
  v_uid uuid := auth.uid();
  v_ids uuid[] := ARRAY[]::uuid[];
  v_anchor_item_id uuid;
BEGIN
 IF NOT platform_private.lab_partner_order_authorized(p_partner_order_id) THEN
  RAISE EXCEPTION 'LAB_PARTNER_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_orders WHERE id=p_partner_order_id AND internal_origin_snapshot IS NOT NULL) THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF;

  -- H5-B01: serializa geração concorrente por pedido (idempotência de resultado)
  PERFORM pg_advisory_xact_lock(hashtext('generate_production_orders_from_partner:' || p_partner_order_id::text));

  SELECT po.partner_id, po.numero, po.status::text, po.ready_for_production
    INTO v_partner_id, v_order_numero, v_order_status, v_ready
  FROM public.partner_orders po
  WHERE po.id = p_partner_order_id;

  IF v_partner_id IS NULL THEN
    RAISE EXCEPTION 'Pedido B2B não encontrado';
  END IF;

  IF v_order_status IN ('cancelado','reprovado','faturado','entregue') THEN
    RAISE EXCEPTION 'Pedido B2B não pode gerar produção (status: %)', v_order_status;
  END IF;

  -- Fase 7: bloqueia produção enquanto aprovação financeira exigida está pendente/rejeitada
   IF EXISTS (
     SELECT 1 FROM public.partner_orders po2
     WHERE po2.id = p_partner_order_id
       AND po2.requires_financial_approval = true
       AND po2.financial_approval_status IN ('pending','rejected')
   ) THEN
     RAISE EXCEPTION 'financial_approval_required_before_production';
   END IF;

   IF v_order_status <> 'aprovado' OR v_ready IS NOT TRUE THEN
    RAISE EXCEPTION 'Pedido B2B ainda não está aprovado para produção.';
  END IF;

  SELECT id INTO v_planning_id FROM public.production_planning WHERE partner_order_id = p_partner_order_id;
  IF v_planning_id IS NULL THEN
    RAISE EXCEPTION 'Planejamento não encontrado para o pedido %', p_partner_order_id;
  END IF;

  SELECT COALESCE(nome_fantasia, razao_social) INTO v_partner_nome FROM public.partner_accounts WHERE id = v_partner_id;

  SELECT count(*) INTO v_nonlab_count FROM public.partner_order_items poi
   WHERE poi.order_id=p_partner_order_id
     AND NOT platform_private.lab_item_is_manufacturable(poi.product_id,poi.microrganismo_id);

  FOR v_grp IN
    WITH itens AS (
      SELECT poi.id,
             poi.product_id,
             poi.quantidade,
             COALESCE(poi.unidade_medida,'unidade') AS unidade_medida,
             poi.preco_tabela_snapshot,
             poi.preco_unitario,
             poi.produto_nome_snapshot,
             poi.produto_codigo_snapshot,
             poi.created_at,
             cv.volume_ml AS vasilhame_volume_ml
      FROM public.partner_order_items poi
      LEFT JOIN LATERAL (
        SELECT cv2.volume_ml
          FROM public.catalogo_volumes cv2
         WHERE cv2.item_tipo = 'produto'
           AND cv2.produto_id = poi.product_id
           AND cv2.ativo = true
         ORDER BY (cv2.preco_brl = COALESCE(poi.preco_tabela_snapshot, poi.preco_unitario)) DESC,
                  ABS(cv2.preco_brl - COALESCE(poi.preco_tabela_snapshot, poi.preco_unitario)) ASC
         LIMIT 1
      ) cv ON true
      WHERE poi.order_id = p_partner_order_id
        AND poi.product_id IS NOT NULL
        AND platform_private.lab_item_is_manufacturable(poi.product_id,poi.microrganismo_id)
        AND COALESCE(poi.unidade_medida,'unidade') <> 'hectare'
        AND NOT EXISTS (
          SELECT 1 FROM public.production_order_link l WHERE l.partner_order_item_id = poi.id
        )
    )
    SELECT product_id,
           MIN(produto_nome_snapshot) AS produto_nome,
           MIN(produto_codigo_snapshot) AS produto_codigo,
           SUM(
             CASE unidade_medida
               WHEN 'ml'    THEN quantidade
               WHEN 'litro' THEN quantidade * 1000
               WHEN 'unidade' THEN quantidade * vasilhame_volume_ml
               WHEN 'dose'    THEN quantidade * vasilhame_volume_ml
               ELSE NULL
             END
           ) AS volume_total_ml,
           bool_or(
             unidade_medida IN ('unidade','dose') AND vasilhame_volume_ml IS NULL
           ) AS faltou_vasilhame,
           array_agg(id ORDER BY created_at, id) AS item_ids,
           (array_agg(id ORDER BY created_at, id))[1] AS anchor_id
    FROM itens
    GROUP BY product_id
  LOOP
    IF v_grp.faltou_vasilhame THEN
      RAISE EXCEPTION 'Produto % (%) está em unidade/dose mas não tem vasilhame ativo no catálogo. Configure o vasilhame antes de gerar produção.',
        COALESCE(v_grp.produto_nome,'?'), COALESCE(v_grp.produto_codigo,'?');
    END IF;

    IF v_grp.volume_total_ml IS NULL OR v_grp.volume_total_ml <= 0 THEN
      RAISE EXCEPTION 'Não foi possível calcular o volume do produto % (%).',
        COALESCE(v_grp.produto_nome,'?'), COALESCE(v_grp.produto_codigo,'?');
    END IF;

    v_anchor_item_id := v_grp.anchor_id;
    v_numero := 'OS-B2B-' || to_char(now(),'YYYYMMDD') || '-' || substr(replace(gen_random_uuid()::text,'-',''),1,6);

    INSERT INTO public.ordens_servico (
      cliente_id, fazenda_id, talhao_id, produto_id, volume_total_ml, area_hectares,
      prioridade, status, tipo_item, numero_os,
      partner_order_id, partner_order_item_id, origem
    ) VALUES (
      NULL, NULL, NULL, v_grp.product_id, v_grp.volume_total_ml, NULL,
      'media','aberta','produto', v_numero,
      p_partner_order_id, v_anchor_item_id, 'b2b'
    ) RETURNING id INTO v_os_id;

    INSERT INTO public.production_order_link (
      partner_order_id, partner_order_item_id, planning_id, ordem_servico_id, created_by
    )
    SELECT p_partner_order_id, unnest(v_grp.item_ids), v_planning_id, v_os_id, v_uid;

    v_ids := array_append(v_ids, v_os_id);
    v_count := v_count + 1;
  END LOOP;

  FOR v_item IN
    SELECT poi.* FROM public.partner_order_items poi
    WHERE poi.order_id = p_partner_order_id
      AND platform_private.lab_item_is_manufacturable(poi.product_id,poi.microrganismo_id)
      AND NOT EXISTS (SELECT 1 FROM public.production_order_link l WHERE l.partner_order_item_id = poi.id)
      AND (
        poi.product_id IS NULL
        OR COALESCE(poi.unidade_medida,'unidade') = 'hectare'
      )
  LOOP
    v_numero := 'OS-B2B-' || to_char(now(),'YYYYMMDD') || '-' || substr(replace(gen_random_uuid()::text,'-',''),1,6);

    INSERT INTO public.ordens_servico (
      cliente_id, fazenda_id, talhao_id, produto_id, microrganismo_id, volume_total_ml, area_hectares,
      prioridade, status, tipo_item, numero_os,
      partner_order_id, partner_order_item_id, origem
    ) VALUES (
      NULL, NULL, NULL, v_item.product_id, v_item.microrganismo_id, NULL,
      CASE WHEN COALESCE(v_item.unidade_medida,'unidade') = 'hectare' THEN v_item.quantidade ELSE NULL END,
      'media','aberta',
      CASE WHEN v_item.product_id IS NULL THEN 'microrganismo' ELSE 'produto' END,
      v_numero,
      p_partner_order_id, v_item.id, 'b2b'
    ) RETURNING id INTO v_os_id;

    INSERT INTO public.production_order_link (
      partner_order_id, partner_order_item_id, planning_id, ordem_servico_id, created_by
    ) VALUES (p_partner_order_id, v_item.id, v_planning_id, v_os_id, v_uid);

    v_ids := array_append(v_ids, v_os_id);
    v_count := v_count + 1;
  END LOOP;

  IF v_count = 0 THEN
    RETURN jsonb_build_object('ok', true, 'os_created', 0, 'planning_id', v_planning_id,
                              'non_lab_items',v_nonlab_count, 'message', 'Nenhuma nova OS biológica gerada; itens não laboratoriais permanecem no pedido.');
  END IF;

  UPDATE public.production_planning
     SET status = 'planejado', updated_at = now()
   WHERE id = v_planning_id AND status = 'aguardando_planejamento';

  INSERT INTO public.production_timeline_events (partner_order_id, event_type, actor_id, meta)
  VALUES (p_partner_order_id, 'op_gerada', v_uid, jsonb_build_object('os_count', v_count, 'planning_id', v_planning_id));

  INSERT INTO public.partner_order_audit_logs (order_id, partner_id, usuario_id, acao, dados_novos)
  VALUES (
    p_partner_order_id, v_partner_id, v_uid, 'op_gerada',
    jsonb_build_object(
      'planning_id', v_planning_id,
      'os_count', v_count,
      'ordens_servico_ids', to_jsonb(v_ids),
      'created_at', now()
    )
  );

  RETURN jsonb_build_object('ok', true, 'os_created', v_count, 'planning_id', v_planning_id, 'ordens_servico_ids', to_jsonb(v_ids), 'non_lab_items',v_nonlab_count);
END
$function$;
CREATE OR REPLACE FUNCTION public.gerar_codigo_lote(_ano integer DEFAULT (EXTRACT(year FROM now()))::integer)
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_prefix text := 'LT-' || _ano::text || '-';
  v_next int;
BEGIN
  IF _ano IS NULL THEN
    RAISE EXCEPTION 'LOTE_ANO_INVALIDO';
  END IF;

  -- Serializa o cálculo sequencial por ano dentro da transação chamadora.
  PERFORM pg_advisory_xact_lock(hashtext('gerar_codigo_lote:' || _ano::text));

  SELECT COALESCE(MAX(NULLIF(regexp_replace(split_part(codigo_lote, '-', 3), '\D', '', 'g'), '')::int), 0) + 1
    INTO v_next
    FROM public.lotes
   WHERE codigo_lote LIKE v_prefix || '%';

  RETURN v_prefix || lpad(v_next::text, 4, '0');
END;
$function$;
CREATE OR REPLACE FUNCTION public.get_cliente_ids_for_user(_user_id uuid)
 RETURNS uuid[]
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT CASE WHEN public.fn_authz_uid_scope_ok(_user_id) THEN ARRAY(
    SELECT uc.cliente_id
      FROM public.user_clientes uc
     WHERE uc.user_id = _user_id
       AND uc.is_active = true
       AND uc.revoked_at IS NULL
       AND (uc.valid_from IS NULL OR uc.valid_from <= now())
       AND (uc.valid_until IS NULL OR uc.valid_until >= now())
    UNION
    SELECT pr.cliente_id
      FROM public.profiles pr
     WHERE pr.user_id = _user_id
       AND pr.cliente_id IS NOT NULL
       AND EXISTS (
         SELECT 1 FROM public.user_clientes uc2
          WHERE uc2.user_id = pr.user_id
            AND uc2.cliente_id = pr.cliente_id
            AND uc2.is_active = true
            AND uc2.revoked_at IS NULL
            AND (uc2.valid_from IS NULL OR uc2.valid_from <= now())
            AND (uc2.valid_until IS NULL OR uc2.valid_until >= now())
       )
  ) ELSE ARRAY[]::uuid[] END;
$function$;
CREATE OR REPLACE FUNCTION public.get_financial_alerts(p_reference_date date DEFAULT CURRENT_DATE)
 RETURNS TABLE(alert_type text, severity text, title text, description text, amount numeric, count integer, action_key text)
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
BEGIN
  IF NOT public.is_financial_staff(auth.uid()) THEN RAISE EXCEPTION 'Acesso negado'; END IF;

  -- 1 entregas sem faturamento
  RETURN QUERY
  SELECT 'DELIVERIES_PENDING_BILLING'::text, 'CRITICAL'::text,
         'Entregas confirmadas sem faturamento'::text,
         'Existem entregas concluídas que ainda não geraram conta a receber.'::text,
         COALESCE(SUM(e.quantidade_entregue * COALESCE(p.valor_litro_brl,0)),0)::numeric,
         COUNT(*)::int, 'entregas-nao-faturadas'::text
    FROM entregas e LEFT JOIN produtos p ON p.id = e.produto_id
   WHERE e.financial_status = 'PENDING_BILLING' AND e.receivable_id IS NULL
  HAVING COUNT(*) > 0;

  -- 2 recebimentos vencidos
  RETURN QUERY
  SELECT 'OVERDUE_RECEIVABLES'::text, 'CRITICAL'::text,
         'Recebimentos vencidos'::text,
         'Parcelas a receber em atraso.'::text,
         COALESCE(SUM(ari.original_amount - COALESCE(ari.received_amount,0) - COALESCE(ari.discount_amount,0)),0)::numeric,
         COUNT(*)::int, 'receber-vencidos'::text
    FROM accounts_receivable_installments ari
   WHERE ari.due_date < p_reference_date AND ari.status IN ('OPEN','PARTIAL','OVERDUE')
  HAVING COUNT(*) > 0;

  -- 3 pagamentos vencidos
  RETURN QUERY
  SELECT 'OVERDUE_PAYABLES'::text, 'CRITICAL'::text,
         'Pagamentos vencidos'::text,
         'Parcelas a pagar em atraso.'::text,
         COALESCE(SUM(api.original_amount - COALESCE(api.paid_amount,0) - COALESCE(api.discount_amount,0)),0)::numeric,
         COUNT(*)::int, 'pagar-vencidos'::text
    FROM accounts_payable_installments api
   WHERE api.due_date < p_reference_date AND api.status IN ('OPEN','PARTIAL','OVERDUE')
  HAVING COUNT(*) > 0;

  -- 4 NF-e pendente
  RETURN QUERY
  SELECT 'PENDING_FISCAL_INVOICE'::text, 'HIGH'::text,
         'NF-e pendente'::text,
         'Contas a receber aguardando emissão de NF-e.'::text,
         COALESCE(SUM(total_amount),0)::numeric, COUNT(*)::int, 'nfe-pendente'::text
    FROM accounts_receivable
   WHERE fiscal_invoice_required = true AND fiscal_invoice_status = 'PENDING'
  HAVING COUNT(*) > 0;

  -- 5 categorias sem DRE
  RETURN QUERY
  SELECT 'UNCLASSIFIED_DRE'::text, 'MEDIUM'::text,
         'Categorias sem classificação DRE'::text,
         'Algumas categorias usadas em títulos não têm grupo DRE definido.'::text,
         0::numeric, COUNT(*)::int, 'categorias-dre'::text
    FROM financial_categories fc
   WHERE fc.dre_group IS NULL
     AND (EXISTS (SELECT 1 FROM accounts_receivable ar WHERE ar.category_id = fc.id)
       OR EXISTS (SELECT 1 FROM accounts_payable ap WHERE ap.category_id = fc.id))
  HAVING COUNT(*) > 0;

  -- 6 recorrências com falha
  RETURN QUERY
  SELECT 'RECURRING_FAILED'::text, 'HIGH'::text,
         'Recorrências com falha'::text,
         'Erros recentes na geração automática de títulos recorrentes.'::text,
         0::numeric, COUNT(*)::int, 'recorrencias'::text
    FROM recurring_generation_log WHERE status = 'FAILED' AND generated_at >= (p_reference_date - INTERVAL '30 days')
  HAVING COUNT(*) > 0;

  -- 7 recorrências atrasadas
  RETURN QUERY
  SELECT 'RECURRING_DUE'::text, 'HIGH'::text,
         'Recorrências atrasadas para geração'::text,
         'Modelos recorrentes ativos com geração pendente.'::text,
         0::numeric, COUNT(*)::int, 'recorrencias'::text
    FROM recurring_financial_templates
   WHERE active = true AND auto_generate = true
     AND next_generation_date IS NOT NULL AND next_generation_date < p_reference_date
  HAVING COUNT(*) > 0;

  -- 8 contas sem centro de custo
  RETURN QUERY
  SELECT 'MISSING_COST_CENTER'::text, 'MEDIUM'::text,
         'Contas sem centro de custo'::text,
         'Títulos financeiros sem centro de custo associado.'::text,
         0::numeric,
         ((SELECT COUNT(*) FROM accounts_receivable WHERE cost_center_id IS NULL AND status <> 'CANCELED')
        + (SELECT COUNT(*) FROM accounts_payable WHERE cost_center_id IS NULL AND status <> 'CANCELED'))::int,
         'centros-custo'::text
   WHERE EXISTS (SELECT 1 FROM accounts_receivable WHERE cost_center_id IS NULL AND status <> 'CANCELED')
      OR EXISTS (SELECT 1 FROM accounts_payable WHERE cost_center_id IS NULL AND status <> 'CANCELED');
END $function$;
CREATE OR REPLACE FUNCTION public.get_financial_dashboard_summary(p_start_date date, p_end_date date, p_cost_center_id uuid DEFAULT NULL::uuid, p_category_id uuid DEFAULT NULL::uuid, p_customer_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
DECLARE
  r jsonb;
  v_rec_expected numeric := 0; v_rec_received numeric := 0;
  v_rec_open numeric := 0; v_rec_overdue numeric := 0; v_rec_partial numeric := 0;
  v_rec_overdue_count int := 0; v_rec_avg_days int := 0;
  v_pay_expected numeric := 0; v_pay_paid numeric := 0;
  v_pay_open numeric := 0; v_pay_overdue numeric := 0; v_pay_partial numeric := 0;
  v_pay_overdue_count int := 0;
  v_nfe_count int := 0; v_nfe_amount numeric := 0;
  v_deliv_count int := 0; v_deliv_amount numeric := 0;
  v_rec_recurring numeric := 0; v_pay_recurring numeric := 0;
  v_rec_errors int := 0;
BEGIN
  IF NOT public.is_financial_staff(auth.uid()) THEN RAISE EXCEPTION 'Acesso negado'; END IF;
  IF p_start_date IS NULL OR p_end_date IS NULL OR p_start_date > p_end_date THEN
    RAISE EXCEPTION 'Periodo invalido: informe datas inicial e final em ordem.' USING ERRCODE = '22023';
  END IF;

  -- A receber (previsto: pelo vencimento no período)
  SELECT COALESCE(SUM(ari.original_amount),0),
         COALESCE(SUM(ari.original_amount - COALESCE(ari.received_amount,0) - COALESCE(ari.discount_amount,0))
           FILTER (WHERE ari.status IN ('OPEN','PARTIAL','OVERDUE')),0),
         COALESCE(SUM(ari.original_amount - COALESCE(ari.received_amount,0) - COALESCE(ari.discount_amount,0))
           FILTER (WHERE ari.status IN ('OPEN','PARTIAL','OVERDUE') AND ari.due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date),0),
         COALESCE(SUM(ari.original_amount - COALESCE(ari.received_amount,0) - COALESCE(ari.discount_amount,0))
           FILTER (WHERE ari.status = 'PARTIAL'),0),
         COUNT(*) FILTER (WHERE ari.status IN ('OPEN','PARTIAL','OVERDUE') AND ari.due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date)::int,
         COALESCE(AVG((pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date - ari.due_date)
           FILTER (WHERE ari.status IN ('OPEN','PARTIAL','OVERDUE') AND ari.due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date),0)::int
    INTO v_rec_expected, v_rec_open, v_rec_overdue, v_rec_partial, v_rec_overdue_count, v_rec_avg_days
    FROM accounts_receivable_installments ari
    JOIN accounts_receivable ar ON ar.id = ari.receivable_id
   WHERE ari.due_date BETWEEN p_start_date AND p_end_date
     AND ari.status <> 'CANCELED'
     AND (p_customer_id IS NULL OR ar.customer_id = p_customer_id)
     AND (p_category_id IS NULL OR ar.category_id = p_category_id)
     AND (p_cost_center_id IS NULL OR ar.cost_center_id = p_cost_center_id);

  -- A receber (realizado: por payment_date)
  SELECT COALESCE(SUM(rp.amount_received),0)
    INTO v_rec_received
    FROM receivable_payments rp
    JOIN accounts_receivable_installments ari ON ari.id = rp.installment_id
    JOIN accounts_receivable ar ON ar.id = ari.receivable_id
   WHERE rp.payment_date BETWEEN p_start_date AND p_end_date
     AND (p_customer_id IS NULL OR ar.customer_id = p_customer_id)
     AND (p_category_id IS NULL OR ar.category_id = p_category_id)
     AND (p_cost_center_id IS NULL OR ar.cost_center_id = p_cost_center_id);

  -- A pagar (previsto)
  SELECT COALESCE(SUM(api.original_amount),0),
         COALESCE(SUM(api.original_amount - COALESCE(api.paid_amount,0) - COALESCE(api.discount_amount,0))
           FILTER (WHERE api.status IN ('OPEN','PARTIAL','OVERDUE')),0),
         COALESCE(SUM(api.original_amount - COALESCE(api.paid_amount,0) - COALESCE(api.discount_amount,0))
           FILTER (WHERE api.status IN ('OPEN','PARTIAL','OVERDUE') AND api.due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date),0),
         COALESCE(SUM(api.original_amount - COALESCE(api.paid_amount,0) - COALESCE(api.discount_amount,0))
           FILTER (WHERE api.status = 'PARTIAL'),0),
         COUNT(*) FILTER (WHERE api.status IN ('OPEN','PARTIAL','OVERDUE') AND api.due_date < (pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date)::int
    INTO v_pay_expected, v_pay_open, v_pay_overdue, v_pay_partial, v_pay_overdue_count
    FROM accounts_payable_installments api
    JOIN accounts_payable ap ON ap.id = api.payable_id
   WHERE api.due_date BETWEEN p_start_date AND p_end_date
     AND api.status <> 'CANCELED'
     AND (p_category_id IS NULL OR ap.category_id = p_category_id)
     AND (p_cost_center_id IS NULL OR ap.cost_center_id = p_cost_center_id);

  -- A pagar (realizado)
  SELECT COALESCE(SUM(pp.amount_paid),0)
    INTO v_pay_paid
    FROM payable_payments pp
    JOIN accounts_payable_installments api ON api.id = pp.installment_id
    JOIN accounts_payable ap ON ap.id = api.payable_id
   WHERE pp.payment_date BETWEEN p_start_date AND p_end_date
     AND (p_category_id IS NULL OR ap.category_id = p_category_id)
     AND (p_cost_center_id IS NULL OR ap.cost_center_id = p_cost_center_id);

  -- NF-e pendente
  SELECT COUNT(*)::int, COALESCE(SUM(total_amount),0)
    INTO v_nfe_count, v_nfe_amount
    FROM accounts_receivable
   WHERE fiscal_invoice_required = true
     AND fiscal_invoice_status = 'PENDING';

  -- Entregas pendentes faturamento
  SELECT COUNT(*)::int, COALESCE(SUM(e.quantidade_entregue * COALESCE(p.valor_litro_brl,0)),0)
    INTO v_deliv_count, v_deliv_amount
    FROM entregas e LEFT JOIN produtos p ON p.id = e.produto_id
   WHERE e.financial_status = 'PENDING_BILLING' AND e.receivable_id IS NULL;

  -- Recorrências ativas
  SELECT COALESCE(SUM(amount) FILTER (WHERE type='RECEIVABLE'),0),
         COALESCE(SUM(amount) FILTER (WHERE type='PAYABLE'),0)
    INTO v_rec_recurring, v_pay_recurring
    FROM recurring_financial_templates
   WHERE active = true;

  SELECT COUNT(*)::int INTO v_rec_errors
    FROM recurring_generation_log WHERE status = 'FAILED' AND generated_at >= ((pg_catalog.now() AT TIME ZONE 'America/Sao_Paulo')::date - INTERVAL '30 days');

  r := jsonb_build_object(
    'total_receivable_expected', v_rec_expected,
    'total_receivable_received', v_rec_received,
    'total_receivable_open', v_rec_open,
    'total_receivable_overdue', v_rec_overdue,
    'total_receivable_partial', v_rec_partial,
    'overdue_receivables_count', v_rec_overdue_count,
    'average_days_overdue', v_rec_avg_days,
    'total_payable_expected', v_pay_expected,
    'total_payable_paid', v_pay_paid,
    'total_payable_open', v_pay_open,
    'total_payable_overdue', v_pay_overdue,
    'total_payable_partial', v_pay_partial,
    'overdue_payables_count', v_pay_overdue_count,
    'projected_balance', v_rec_expected - v_pay_expected,
    'realized_balance', v_rec_received - v_pay_paid,
    'collection_rate', CASE WHEN v_rec_expected > 0 THEN ROUND((v_rec_received / v_rec_expected)::numeric, 4) ELSE 0 END,
    'payment_rate', CASE WHEN v_pay_expected > 0 THEN ROUND((v_pay_paid / v_pay_expected)::numeric, 4) ELSE 0 END,
    'pending_fiscal_invoice_count', v_nfe_count,
    'pending_fiscal_invoice_amount', v_nfe_amount,
    'pending_billing_deliveries_count', v_deliv_count,
    'pending_billing_deliveries_amount', v_deliv_amount,
    'active_recurring_receivables_amount', v_rec_recurring,
    'active_recurring_payables_amount', v_pay_recurring,
    'recurring_net_balance', v_rec_recurring - v_pay_recurring,
    'recurring_generation_errors_count', v_rec_errors
  );
  RETURN r;
END $function$;
CREATE OR REPLACE FUNCTION public.get_partner_catalog_secure(p_partner_id uuid)
 RETURNS TABLE(item_id uuid, item_tipo text, product_id uuid, produto_nome text, produto_codigo text, descricao_curta text, preco_tabela numeric, desconto_percentual numeric, preco_parceiro numeric, produto_ativo boolean, resumo_curto text, explicacao_b2b text, beneficios_principais text, ficha_status text, ficha_aprovada boolean, valor_dose_brl numeric, valor_litro_brl numeric, valor_ha_brl numeric, unidade_preco_principal text)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_visibility_scope uuid[];
  v_uid uuid := auth.uid();
  v_super boolean; s record; r record;
  v_pid uuid; v_mid uuid; j_ha jsonb; j_li jsonb; j_do jsonb;
  n_ha numeric; n_li numeric; n_do numeric; v_base numeric; v_unid text;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  IF p_partner_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.partner_accounts pa
       WHERE pa.id = p_partner_id AND pa.ativo = true AND pa.deleted_at IS NULL) THEN
    RAISE EXCEPTION 'partner_not_found' USING ERRCODE='42501';
  END IF;
  v_super := public.is_platform_superadmin(v_uid);
  IF NOT v_super THEN
    IF public.has_role(v_uid,'parceiro_b2b_tecnico'::app_role) THEN
      RAISE EXCEPTION 'forbidden_financial_terms' USING ERRCODE='42501';
    END IF;
    SELECT * INTO s FROM platform_private.b2b_actor_scope(v_uid);
    IF (NOT s.profile_ok OR s.org_partner IS DISTINCT FROM p_partner_id OR NOT s.partner_valid)
       AND NOT (platform_private.b2b_internal_commercial_actor()
                AND platform_private.c2_internal_order_target_reason(v_uid, p_partner_id) IS NULL) THEN
      RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
    END IF;
    IF public.has_role(v_uid,'parceiro_b2b'::app_role) THEN
      IF s.user_partner_count <> 1 OR s.user_partner IS DISTINCT FROM p_partner_id THEN
        RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
      END IF;
    ELSIF NOT (public.has_role(v_uid,'administrador'::app_role) OR public.has_role(v_uid,'gestor_comercial'::app_role)) THEN
      RAISE EXCEPTION 'forbidden_role' USING ERRCODE='42501';
    END IF;
    IF NOT s.has_catalog THEN RAISE EXCEPTION 'feature_not_entitled' USING ERRCODE='42501'; END IF;
  END IF;

  v_visibility_scope := platform_private.c1b_catalog_visibility_scope(p_partner_id);
  FOR r IN
    SELECT p.id, 'produto'::text AS tipo, p.nome, p.codigo, p.ativo,
           ptp.status_validacao, ptp.resumo_curto, ptp.explicacao_b2b, ptp.beneficio_combinado AS beneficios
      FROM public.produtos p LEFT JOIN public.product_technical_profiles ptp ON ptp.produto_id = p.id
     WHERE p.ativo = true AND p.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='produto' AND cv.hidden IS TRUE AND cv.produto_id=p.id)
    UNION ALL
    SELECT m.id, 'microrganismo'::text, m.nome, m.codigo, m.ativo,
           mtp.status_validacao, mtp.resumo_curto, mtp.explicacao_b2b, mtp.beneficios_agronomicos
      FROM public.microrganismos m LEFT JOIN public.microorganism_technical_profiles mtp ON mtp.microrganismo_id = m.id
     WHERE m.ativo = true AND m.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='microrganismo' AND cv.hidden IS TRUE AND cv.microrganismo_id=m.id)
  LOOP
    v_pid := CASE WHEN r.tipo='produto' THEN r.id END;
    v_mid := CASE WHEN r.tipo='microrganismo' THEN r.id END;
    j_ha := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'hectare', NULL, current_date);
    j_li := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'litro',   NULL, current_date);
    j_do := public.fn_b2b_resolve_base_unit_price(p_partner_id, v_pid, v_mid, 'dose',    NULL, current_date);
    n_ha := CASE WHEN COALESCE((j_ha->>'ok')::boolean,false) THEN NULLIF((j_ha->>'base_price')::numeric,0) END;
    n_li := CASE WHEN COALESCE((j_li->>'ok')::boolean,false) THEN NULLIF((j_li->>'base_price')::numeric,0) END;
    n_do := CASE WHEN COALESCE((j_do->>'ok')::boolean,false) THEN NULLIF((j_do->>'base_price')::numeric,0) END;
    v_unid := CASE WHEN n_ha IS NOT NULL THEN 'hectare' WHEN n_li IS NOT NULL THEN 'litro'
                   WHEN n_do IS NOT NULL THEN 'dose_100ml' ELSE 'sob_consulta' END;
    v_base := COALESCE(n_ha, n_li, n_do);
    item_id := r.id; item_tipo := r.tipo; product_id := v_pid;
    produto_nome := r.nome; produto_codigo := r.codigo;
    descricao_curta := CASE WHEN r.status_validacao='aprovado' THEN LEFT(COALESCE(r.resumo_curto,''),220) END;
    preco_tabela := ROUND(v_base,2);
    desconto_percentual := CASE WHEN v_base IS NOT NULL THEN 0::numeric END;
    preco_parceiro := ROUND(v_base,2);
    produto_ativo := r.ativo;
    resumo_curto := CASE WHEN r.status_validacao='aprovado' THEN r.resumo_curto END;
    explicacao_b2b := CASE WHEN r.status_validacao='aprovado' THEN r.explicacao_b2b END;
    beneficios_principais := CASE WHEN r.status_validacao='aprovado' THEN r.beneficios END;
    ficha_status := COALESCE(r.status_validacao,'sem_ficha');
    ficha_aprovada := (r.status_validacao = 'aprovado');
    valor_dose_brl := ROUND(n_do,2); valor_litro_brl := ROUND(n_li,2); valor_ha_brl := ROUND(n_ha,2);
    unidade_preco_principal := v_unid;
    RETURN NEXT;
  END LOOP;
END;
$function$;
CREATE OR REPLACE FUNCTION public.get_partner_catalog_secure(p_partner_id uuid, p_catalog_v2 boolean)
 RETURNS TABLE(item_id uuid, item_tipo text, product_id uuid, produto_nome text, produto_codigo text, descricao_curta text, preco_tabela numeric, desconto_percentual numeric, preco_parceiro numeric, produto_ativo boolean, resumo_curto text, explicacao_b2b text, beneficios_principais text, ficha_status text, ficha_aprovada boolean, valor_dose_brl numeric, valor_litro_brl numeric, valor_ha_brl numeric, unidade_preco_principal text, familia_catalogo text, catalog_contract text, ficha_conteudo jsonb)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF p_catalog_v2 IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'catalog_contract_required' USING ERRCODE='22023'; END IF;
 RETURN QUERY SELECT r.*, CASE WHEN r.item_tipo='microrganismo' THEN 'biologico'::text ELSE p.familia_catalogo END, 'C1B_DUAL_TENANT_V1'::text,
 CASE WHEN r.ficha_aprovada IS TRUE THEN jsonb_build_object(
  'subtitulo', CASE WHEN r.item_tipo='produto' THEN p.tipo::text ELSE m.nome_cientifico END,
  'funcao', CASE WHEN r.item_tipo='produto' THEN p.funcao_completa ELSE m.funcao_agronomica END,
  'dose_ml_ha', CASE WHEN r.item_tipo='produto' THEN p.dose_ml_ha ELSE m.dose_ml_ha END,
  'explicacao_produtor', COALESCE(pp.explicacao_produtor,mp.explicacao_produtor),
  'indicacoes_uso', COALESCE(pp.indicacoes_uso,mp.indicacoes_uso),
  'cuidados_aplicacao', COALESCE(pp.cuidados_aplicacao,mp.cuidados_aplicacao),
  'mecanismo_acao', mp.mecanismo_acao,
  'alvos_count', CASE WHEN r.item_tipo='produto' THEN
    (SELECT count(*) FROM public.product_target_recommendations t WHERE t.produto_id=r.item_id AND t.ativo IS TRUE)
    ELSE (SELECT count(*) FROM public.microorganism_targets t WHERE t.microrganismo_id=r.item_id AND t.ativo IS TRUE) END,
  'fontes_count', (SELECT count(*) FROM public.catalog_technical_sources cs WHERE cs.entidade_id=r.item_id
    AND cs.entidade_tipo IN (r.item_tipo, 'ficha_' || r.item_tipo))
 ) ELSE '{}'::jsonb END
 FROM public.get_partner_catalog_secure(p_partner_id) r
 LEFT JOIN public.produtos p ON r.item_tipo='produto' AND p.id=r.item_id
 LEFT JOIN public.microrganismos m ON r.item_tipo='microrganismo' AND m.id=r.item_id
 LEFT JOIN public.product_technical_profiles pp ON r.item_tipo='produto' AND pp.produto_id=r.item_id AND pp.status_validacao='aprovado'
 LEFT JOIN public.microorganism_technical_profiles mp ON r.item_tipo='microrganismo' AND mp.microrganismo_id=r.item_id AND mp.status_validacao='aprovado';
END $function$;
CREATE OR REPLACE FUNCTION public.get_partner_catalog_tecnico_secure()
 RETURNS TABLE(item_id uuid, item_tipo text, nome text, codigo text, descricao_curta text, tipo text, nome_cientifico text, funcao text, dose_ml_ha numeric, valor_dose_brl numeric, valor_litro_brl numeric, valor_ha_brl numeric, preco_tabela_dose numeric, preco_tabela_litro numeric, preco_tabela_ha numeric, unidade_preco_principal text, resumo_curto text, explicacao_b2b text, beneficios_principais text, ficha_status text, ficha_aprovada boolean)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_visibility_scope uuid[];
  v_uid uuid := auth.uid();
  v_super boolean; v_is_tec boolean; v_is_partner boolean; v_is_internal boolean;
  v_partner uuid; v_show_fin boolean := false; s record; r record;
  v_pid uuid; v_mid uuid; j_ha jsonb; j_li jsonb; j_do jsonb;
  n_ha numeric; n_li numeric; n_do numeric;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  v_super := public.is_platform_superadmin(v_uid);
  v_is_tec := public.has_role(v_uid,'parceiro_b2b_tecnico'::app_role);
  v_is_partner := public.has_role(v_uid,'parceiro_b2b'::app_role);
  v_is_internal := public.has_role(v_uid,'administrador'::app_role) OR public.has_role(v_uid,'gestor_comercial'::app_role);

  IF NOT v_super THEN
    IF NOT (v_is_tec OR v_is_partner OR v_is_internal) THEN
      RAISE EXCEPTION 'forbidden_role' USING ERRCODE='42501';
    END IF;
    SELECT * INTO s FROM platform_private.b2b_actor_scope(v_uid);
    IF NOT s.profile_ok THEN RAISE EXCEPTION 'inactive_scope' USING ERRCODE='42501'; END IF;
    IF v_is_tec OR v_is_partner THEN
      IF s.user_partner_count <> 1 OR s.org_partner IS NULL OR s.user_partner IS DISTINCT FROM s.org_partner
         OR NOT s.partner_valid THEN
        RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
      END IF;
      v_partner := s.org_partner;
      v_show_fin := v_is_partner AND NOT v_is_tec;
    END IF;
    IF NOT s.has_catalog THEN RAISE EXCEPTION 'feature_not_entitled' USING ERRCODE='42501'; END IF;
  END IF;

  v_visibility_scope := platform_private.c1b_catalog_visibility_scope(v_partner);
  FOR r IN
    SELECT p.id, 'produto'::text AS itipo, p.nome, p.codigo, p.tipo::text AS ptipo,
           NULL::text AS nome_cientifico, p.funcao_completa AS funcao, p.dose_ml_ha,
           ptp.status_validacao, ptp.resumo_curto, ptp.explicacao_b2b, ptp.beneficio_combinado AS beneficios, p.descricao
      FROM public.produtos p JOIN public.product_technical_profiles ptp ON ptp.produto_id = p.id
     WHERE p.ativo = true AND p.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='produto' AND cv.hidden IS TRUE AND cv.produto_id=p.id) AND ptp.status_validacao = 'aprovado'
    UNION ALL
    SELECT m.id, 'microrganismo'::text, m.nome, m.codigo, m.tipo::text,
           m.nome_cientifico, m.funcao_agronomica, m.dose_ml_ha,
           mtp.status_validacao, mtp.resumo_curto, mtp.explicacao_b2b, mtp.beneficios_agronomicos, m.descricao
      FROM public.microrganismos m JOIN public.microorganism_technical_profiles mtp ON mtp.microrganismo_id = m.id
     WHERE m.ativo = true AND m.b2b_enabled = true AND NOT EXISTS (SELECT 1 FROM public.catalog_tenant_visibility cv WHERE cv.organization_id=ANY(v_visibility_scope) AND cv.entity_type='microrganismo' AND cv.hidden IS TRUE AND cv.microrganismo_id=m.id) AND mtp.status_validacao = 'aprovado'
  LOOP
    n_ha := NULL; n_li := NULL; n_do := NULL;
    IF v_show_fin THEN
      v_pid := CASE WHEN r.itipo='produto' THEN r.id END;
      v_mid := CASE WHEN r.itipo='microrganismo' THEN r.id END;
      j_ha := public.fn_resolve_commercial_price('partner', v_partner, NULL, NULL, v_pid, v_mid, 'hectare', NULL, current_date);
      j_li := public.fn_resolve_commercial_price('partner', v_partner, NULL, NULL, v_pid, v_mid, 'litro',   NULL, current_date);
      j_do := public.fn_resolve_commercial_price('partner', v_partner, NULL, NULL, v_pid, v_mid, 'dose',    NULL, current_date);
      n_ha := CASE WHEN COALESCE((j_ha->>'ok')::boolean,false) AND NOT COALESCE((j_ha->>'quote_required')::boolean,false) THEN NULLIF((j_ha->>'final_unit_price')::numeric,0) END;
      n_li := CASE WHEN COALESCE((j_li->>'ok')::boolean,false) AND NOT COALESCE((j_li->>'quote_required')::boolean,false) THEN NULLIF((j_li->>'final_unit_price')::numeric,0) END;
      n_do := CASE WHEN COALESCE((j_do->>'ok')::boolean,false) AND NOT COALESCE((j_do->>'quote_required')::boolean,false) THEN NULLIF((j_do->>'final_unit_price')::numeric,0) END;
    END IF;
    item_id := r.id; item_tipo := r.itipo; nome := r.nome; codigo := r.codigo;
    descricao_curta := COALESCE(r.resumo_curto, r.descricao);
    tipo := r.ptipo; nome_cientifico := r.nome_cientifico; funcao := r.funcao; dose_ml_ha := r.dose_ml_ha;
    valor_dose_brl := ROUND(n_do,2); valor_litro_brl := ROUND(n_li,2); valor_ha_brl := ROUND(n_ha,2);
    preco_tabela_dose := ROUND(n_do,2); preco_tabela_litro := ROUND(n_li,2); preco_tabela_ha := ROUND(n_ha,2);
    unidade_preco_principal := CASE WHEN n_ha IS NOT NULL THEN 'hectare' WHEN n_li IS NOT NULL THEN 'litro'
                                    WHEN n_do IS NOT NULL THEN 'dose_100ml' ELSE 'sob_consulta' END;
    resumo_curto := r.resumo_curto; explicacao_b2b := r.explicacao_b2b; beneficios_principais := r.beneficios;
    ficha_status := r.status_validacao; ficha_aprovada := true;
    RETURN NEXT;
  END LOOP;
END;
$function$;
CREATE OR REPLACE FUNCTION public.get_partner_catalog_tecnico_secure(p_catalog_v2 boolean)
 RETURNS TABLE(item_id uuid, item_tipo text, nome text, codigo text, descricao_curta text, tipo text, nome_cientifico text, funcao text, dose_ml_ha numeric, valor_dose_brl numeric, valor_litro_brl numeric, valor_ha_brl numeric, preco_tabela_dose numeric, preco_tabela_litro numeric, preco_tabela_ha numeric, unidade_preco_principal text, resumo_curto text, explicacao_b2b text, beneficios_principais text, ficha_status text, ficha_aprovada boolean, familia_catalogo text, catalog_contract text, ficha_conteudo jsonb)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF p_catalog_v2 IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'catalog_contract_required' USING ERRCODE='22023'; END IF;
 RETURN QUERY SELECT r.*, CASE WHEN r.item_tipo='microrganismo' THEN 'biologico'::text ELSE p.familia_catalogo END, 'C1B_DUAL_TENANT_V1'::text,
 CASE WHEN r.ficha_aprovada IS TRUE THEN jsonb_build_object(
  'subtitulo', CASE WHEN r.item_tipo='produto' THEN p.tipo::text ELSE m.nome_cientifico END,
  'funcao', CASE WHEN r.item_tipo='produto' THEN p.funcao_completa ELSE m.funcao_agronomica END,
  'dose_ml_ha', CASE WHEN r.item_tipo='produto' THEN p.dose_ml_ha ELSE m.dose_ml_ha END,
  'explicacao_produtor', COALESCE(pp.explicacao_produtor,mp.explicacao_produtor),
  'indicacoes_uso', COALESCE(pp.indicacoes_uso,mp.indicacoes_uso),
  'cuidados_aplicacao', COALESCE(pp.cuidados_aplicacao,mp.cuidados_aplicacao),
  'mecanismo_acao', mp.mecanismo_acao,
  'alvos_count', CASE WHEN r.item_tipo='produto' THEN
    (SELECT count(*) FROM public.product_target_recommendations t WHERE t.produto_id=r.item_id AND t.ativo IS TRUE)
    ELSE (SELECT count(*) FROM public.microorganism_targets t WHERE t.microrganismo_id=r.item_id AND t.ativo IS TRUE) END,
  'fontes_count', (SELECT count(*) FROM public.catalog_technical_sources cs WHERE cs.entidade_id=r.item_id
    AND cs.entidade_tipo IN (r.item_tipo, 'ficha_' || r.item_tipo))
 ) ELSE '{}'::jsonb END
 FROM public.get_partner_catalog_tecnico_secure() r
 LEFT JOIN public.produtos p ON r.item_tipo='produto' AND p.id=r.item_id
 LEFT JOIN public.microrganismos m ON r.item_tipo='microrganismo' AND m.id=r.item_id
 LEFT JOIN public.product_technical_profiles pp ON r.item_tipo='produto' AND pp.produto_id=r.item_id AND pp.status_validacao='aprovado'
 LEFT JOIN public.microorganism_technical_profiles mp ON r.item_tipo='microrganismo' AND mp.microrganismo_id=r.item_id AND mp.status_validacao='aprovado';
END $function$;
CREATE OR REPLACE FUNCTION public.get_portal_cliente_b2b_order_detail_secure(p_order_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_order public.partner_orders%ROWTYPE;
  v_result jsonb;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'not_authenticated';
  END IF;

  SELECT x.* INTO v_order FROM public.partner_orders x
  JOIN public.partner_accounts pa ON pa.id=x.partner_id
  JOIN public.clientes c ON c.id=x.cliente_id AND c.organization_id=pa.commercial_owner_organization_id
  WHERE x.id=p_order_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
  AND platform_private.producer_commercial_client_scope(x.cliente_id);

  IF NOT FOUND THEN RAISE EXCEPTION 'forbidden_cliente_vinculo' USING ERRCODE='42501'; END IF;

  IF v_order.cliente_id IS NULL
     OR NOT platform_private.producer_commercial_client_scope(v_order.cliente_id) THEN
    RAISE EXCEPTION 'forbidden_cliente_vinculo';
  END IF;

  SELECT jsonb_build_object(
    'header', jsonb_build_object(
      'id', v_order.id,
      'numero', v_order.numero,
      'status', v_order.status,
      'created_at', v_order.created_at,
      'requested_delivery_date', v_order.requested_delivery_date,
      'estimated_delivery_date', v_order.estimated_delivery_date,
      'approved_at', v_order.approved_at,
      'partner_id', v_order.partner_id,
      'partner_nome', COALESCE(pa.nome_fantasia, pa.razao_social),
      'total', v_order.total,
      'origin_simulation_id', v_order.origin_simulation_id,
      'cultura', v_order.cultura,
      'area_total_ha', v_order.area_total_ha
    ),
    'items', COALESCE((
      SELECT jsonb_agg(jsonb_build_object(
        'id', it.id,
        'nome', COALESCE(it.produto_nome_snapshot, p.nome, m.nome),
        'codigo', COALESCE(it.produto_codigo_snapshot, p.codigo, m.codigo),
        'item_tipo', CASE WHEN it.microrganismo_id IS NOT NULL AND it.product_id IS NULL THEN 'microrganismo' ELSE 'produto' END,
        'quantidade', it.quantidade,
        'unidade_medida', it.unidade_medida,
        'volume_ml', it.volume_ml,
        'preco_unitario', it.preco_unitario,
        'subtotal', it.subtotal,
        'produtos', CASE WHEN p.id IS NOT NULL THEN jsonb_build_object(
          'nome', p.nome,
          'codigo', p.codigo,
          'funcao_completa', p.funcao_completa,
          'modo_acao', p.modo_acao,
          'modo_aplicacao', p.modo_aplicacao,
          'formulacoes', COALESCE((
            SELECT jsonb_agg(jsonb_build_object(
              'microrganismos', jsonb_build_object(
                'nome', mf.nome,
                'concentracao_label', mf.concentracao_label
              )
            ) ORDER BY f.created_at)
            FROM public.formulacoes f
            LEFT JOIN public.microrganismos mf ON mf.id = f.microrganismo_id
            WHERE f.produto_id = p.id AND mf.id IS NOT NULL
          ), '[]'::jsonb)
        ) END,
        'microrganismos', CASE WHEN m.id IS NOT NULL THEN jsonb_build_object(
          'nome', m.nome,
          'codigo', m.codigo,
          'concentracao_label', m.concentracao_label,
          'funcao_agronomica', m.funcao_agronomica
        ) END
      ) ORDER BY it.created_at)
      FROM public.partner_order_items it
      LEFT JOIN public.produtos p ON p.id = it.product_id
      LEFT JOIN public.microrganismos m ON m.id = it.microrganismo_id
      WHERE it.order_id = v_order.id
    ), '[]'::jsonb)
  ) INTO v_result
  FROM public.partner_accounts pa
  WHERE pa.id = v_order.partner_id;

  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION public.get_portal_cliente_b2b_simulation_detail_secure(p_simulation_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_sim public.partner_simulations%ROWTYPE;
  v_result jsonb;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'not_authenticated';
  END IF;

  SELECT x.* INTO v_sim FROM public.partner_simulations x
  JOIN public.partner_accounts pa ON pa.id=x.partner_id
  JOIN public.clientes c ON c.id=x.cliente_id AND c.organization_id=pa.commercial_owner_organization_id
  WHERE x.id=p_simulation_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
  AND platform_private.producer_commercial_client_scope(x.cliente_id);

  IF NOT FOUND THEN RAISE EXCEPTION 'forbidden_cliente_vinculo' USING ERRCODE='42501'; END IF;

  IF v_sim.cliente_id IS NULL
     OR NOT platform_private.producer_commercial_client_scope(v_sim.cliente_id) THEN
    RAISE EXCEPTION 'forbidden_cliente_vinculo';
  END IF;

  IF v_sim.status::text NOT IN ('enviada_gestor', 'convertida_pedido') THEN
    RAISE EXCEPTION 'simulation_not_visible';
  END IF;

  SELECT jsonb_build_object(
    'header', jsonb_build_object(
      'id', v_sim.id,
      'titulo', v_sim.titulo,
      'status', v_sim.status,
      'total_cheio', v_sim.total_cheio,
      'created_at', v_sim.created_at,
      'updated_at', v_sim.updated_at,
      'converted_order_id', v_sim.converted_order_id,
      'partner_id', v_sim.partner_id,
      'partner_nome', COALESCE(pa.nome_fantasia, pa.razao_social),
      'cultura', v_sim.cultura,
      'area_total_ha', v_sim.area_total_ha,
      'objetivo_tecnico', v_sim.objetivo_tecnico
    ),
    'items', COALESCE((
      SELECT jsonb_agg(jsonb_build_object(
        'id', si.id,
        'nome', COALESCE(si.produto_nome_snapshot, si.nome, p.nome, m.nome),
        'codigo', COALESCE(si.produto_codigo_snapshot, p.codigo, m.codigo),
        'item_tipo', si.item_tipo,
        'quantidade', si.quantidade,
        'unidade_medida', si.unidade_medida,
        'volume_ml', si.volume_ml,
        'valor_unitario_cheio', si.valor_unitario_cheio,
        'subtotal', si.subtotal,
        'produtos', CASE WHEN p.id IS NOT NULL THEN jsonb_build_object(
          'nome', p.nome,
          'codigo', p.codigo,
          'funcao_completa', p.funcao_completa,
          'modo_acao', p.modo_acao,
          'modo_aplicacao', p.modo_aplicacao,
          'formulacoes', COALESCE((
            SELECT jsonb_agg(jsonb_build_object(
              'microrganismos', jsonb_build_object(
                'nome', mf.nome,
                'concentracao_label', mf.concentracao_label
              )
            ) ORDER BY f.created_at)
            FROM public.formulacoes f
            LEFT JOIN public.microrganismos mf ON mf.id = f.microrganismo_id
            WHERE f.produto_id = p.id AND mf.id IS NOT NULL
          ), '[]'::jsonb)
        ) END,
        'microrganismos', CASE WHEN m.id IS NOT NULL THEN jsonb_build_object(
          'nome', m.nome,
          'codigo', m.codigo,
          'concentracao_label', m.concentracao_label,
          'funcao_agronomica', m.funcao_agronomica
        ) END
      ) ORDER BY si.created_at)
      FROM public.partner_simulation_items si
      LEFT JOIN public.produtos p ON p.id = si.product_id
      LEFT JOIN public.microrganismos m ON m.id = si.microrganismo_id
      WHERE si.simulation_id = v_sim.id
    ), '[]'::jsonb)
  ) INTO v_result
  FROM public.partner_accounts pa
  WHERE pa.id = v_sim.partner_id;

  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION public.get_user_partner_id()
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT CASE
           WHEN count(*) FILTER (WHERE pu.revoked_at IS NULL) <> 1 THEN NULL
           WHEN bool_or(pa.ativo IS TRUE AND pa.deleted_at IS NULL
                        AND pa.commercial_owner_organization_id IS NOT NULL
                        AND pu.tenant_id IS NOT NULL
                        AND pu.tenant_id = pa.commercial_owner_organization_id)
                FILTER (WHERE pu.revoked_at IS NULL)
           THEN (array_agg(pu.partner_id) FILTER (WHERE pu.revoked_at IS NULL))[1]
         END
  FROM public.partner_users pu
  LEFT JOIN public.partner_accounts pa ON pa.id = pu.partner_id
  WHERE pu.user_id = auth.uid();
$function$;
CREATE OR REPLACE FUNCTION public.guard_commercial_partner_registration()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_owner uuid;
BEGIN
 v_org := public.h15_actor_organization();
 IF auth.uid() IS NULL OR v_org IS NULL OR NOT (public.has_role(auth.uid(),'administrador'::public.app_role) OR public.has_role(auth.uid(),'gestor_comercial'::public.app_role)) THEN RAISE EXCEPTION 'cadastro_context_required' USING ERRCODE='42501'; END IF;
 IF TG_OP='INSERT' THEN
  IF NEW.commercial_owner_organization_id IS NOT NULL AND NEW.commercial_owner_organization_id IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'cadastro_owner_denied' USING ERRCODE='42501'; END IF;
  NEW.commercial_owner_organization_id:=v_org;
  NEW.created_by:=auth.uid(); NEW.codigo:='PARC-'||NEW.id::text;
 ELSE
  v_owner:=OLD.commercial_owner_organization_id;
  IF v_owner IS NULL THEN SELECT c.organization_id INTO v_owner FROM public.clientes c WHERE c.id=OLD.client_id; END IF;
  IF v_owner IS NULL OR v_owner IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'cadastro_owner_denied' USING ERRCODE='42501'; END IF;
  IF NEW.commercial_owner_organization_id IS DISTINCT FROM OLD.commercial_owner_organization_id OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.id IS DISTINCT FROM OLD.id OR NEW.codigo IS DISTINCT FROM OLD.codigo THEN RAISE EXCEPTION 'cadastro_identity_immutable' USING ERRCODE='42501'; END IF;
  -- Individual edit with proven OLD client ownership, never a bulk legacy backfill.
  NEW.commercial_owner_organization_id:=v_owner;
 END IF;
 IF NEW.client_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=NEW.client_id AND c.organization_id=v_org) THEN RAISE EXCEPTION 'cadastro_client_scope_required' USING ERRCODE='42501'; END IF;
 IF NEW.consultor_responsavel IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.profiles p WHERE p.id=NEW.consultor_responsavel AND p.ativo IS TRUE AND p.organization_id=v_org) THEN RAISE EXCEPTION 'cadastro_consultant_scope_denied' USING ERRCODE='42501'; END IF;
 IF length(trim(coalesce(NEW.razao_social,'')))<2 OR length(NEW.razao_social)>200 THEN RAISE EXCEPTION 'cadastro_invalid_name' USING ERRCODE='22023'; END IF;
 IF NEW.desconto_padrao IS NULL OR NEW.desconto_padrao::text IN ('NaN','Infinity','-Infinity') OR NEW.desconto_padrao<0 OR NEW.desconto_padrao>100
 OR (NEW.comissao_percentual IS NOT NULL AND (NEW.comissao_percentual::text IN ('NaN','Infinity','-Infinity') OR NEW.comissao_percentual<0 OR NEW.comissao_percentual>100))
 OR (NEW.limite_credito_brl IS NOT NULL AND (NEW.limite_credito_brl::text IN ('NaN','Infinity','-Infinity') OR NEW.limite_credito_brl<0))
 OR (NEW.meta_mensal_brl IS NOT NULL AND (NEW.meta_mensal_brl::text IN ('NaN','Infinity','-Infinity') OR NEW.meta_mensal_brl<0)) OR NEW.prazo_pagamento_padrao_dias<0 THEN RAISE EXCEPTION 'cadastro_invalid_commercial_values' USING ERRCODE='22023'; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION public.guard_profile_sensitive_fields()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$ BEGIN IF current_user IN ('postgres','service_role','supabase_auth_admin') THEN RETURN NEW; END IF; IF public.has_role(auth.uid(),'administrador'::public.app_role) THEN RETURN NEW; END IF; IF TG_OP='INSERT' THEN IF NEW.ativo IS DISTINCT FROM true OR NEW.cliente_id IS NOT NULL OR NEW.organization_id IS NOT NULL OR NEW.data_admissao IS NOT NULL OR NEW.observacoes_internas IS NOT NULL THEN RAISE EXCEPTION 'profile_sensitive_fields_forbidden' USING ERRCODE='42501'; END IF; ELSE IF OLD.ativo IS NOT TRUE OR ROW(NEW.id,NEW.user_id,NEW.email,NEW.ativo,NEW.cliente_id,NEW.organization_id,NEW.created_at,NEW.data_admissao,NEW.observacoes_internas) IS DISTINCT FROM ROW(OLD.id,OLD.user_id,OLD.email,OLD.ativo,OLD.cliente_id,OLD.organization_id,OLD.created_at,OLD.data_admissao,OLD.observacoes_internas) THEN RAISE EXCEPTION 'profile_sensitive_fields_forbidden' USING ERRCODE='42501'; END IF; END IF; RETURN NEW; END; $function$;
CREATE OR REPLACE FUNCTION public.h15_actor_organization()
 RETURNS uuid
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$ SELECT platform_private.h15_actor_organization(); $function$;
CREATE OR REPLACE FUNCTION public.has_active_user_cliente_access(_user_id uuid, _cliente_id uuid, _levels text[] DEFAULT ARRAY['read'::text, 'execute'::text, 'manage'::text])
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  IF _user_id IS NULL OR _cliente_id IS NULL THEN
    RETURN false;
  END IF;
  IF NOT public.fn_authz_uid_scope_ok(_user_id) THEN
    RETURN false;
  END IF;
  IF public.has_role(_user_id, 'administrador'::public.app_role) THEN
    RETURN true;
  END IF;
  RETURN EXISTS (
    SELECT 1
      FROM public.user_clientes uc
     WHERE uc.user_id = _user_id
       AND uc.cliente_id = _cliente_id
       AND uc.is_active = true
       AND uc.revoked_at IS NULL
       AND (uc.valid_from IS NULL OR uc.valid_from <= now())
       AND (uc.valid_until IS NULL OR uc.valid_until >= now())
       AND uc.access_level::text = ANY(_levels)
  );
END
$function$;
CREATE OR REPLACE FUNCTION public.has_role(_user_id uuid, _role app_role)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$ SELECT platform_private.has_role(_user_id,_role); $function$;
CREATE OR REPLACE FUNCTION public.is_active_visit_participant(p_user_id uuid, p_registro_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT public.technical_actor_ready(p_user_id) AND EXISTS (
 SELECT 1 FROM public.technical_visit_assignments a JOIN public.registros_consultor r ON r.id=a.registro_consultor_id
 WHERE r.id=p_registro_id AND a.user_id=p_user_id AND a.is_active IS TRUE AND a.removed_at IS NULL
 AND public.technical_refs_in_actor_tenant(r.cliente_id,r.fazenda_id,r.talhao_id)
 AND public.technical_client_link(p_user_id,r.cliente_id,ARRAY['read','execute','manage']));
$function$;
CREATE OR REPLACE FUNCTION public.is_delivery_staff(_uid uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT public.fn_authz_uid_scope_ok(_uid)
     AND (public.has_role(_uid,'administrador'::app_role)
      OR public.has_role(_uid,'gestor'::app_role)
      OR public.has_role(_uid,'administrativo'::app_role)
      OR public.has_role(_uid,'producao'::app_role)
      OR public.has_role(_uid,'operador_onfarm'::app_role)
      OR public.has_role(_uid,'aplicador'::app_role));
$function$;
CREATE OR REPLACE FUNCTION public.is_financial_staff(_uid uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
BEGIN
  IF NOT public.fn_authz_uid_scope_ok(_uid) THEN
    RETURN false;
  END IF;
  RETURN has_role(_uid, 'administrador'::app_role)
      OR has_role(_uid, 'gestor'::app_role)
      OR has_role(_uid, 'financeiro'::app_role);
END;
$function$;
CREATE OR REPLACE FUNCTION public.is_operational_staff(_uid uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT COALESCE(_uid IS NOT NULL AND (
       public.has_role(_uid, 'administrador'::app_role)
    OR public.has_role(_uid, 'gestor'::app_role)
    OR public.has_role(_uid, 'administrativo'::app_role)
    OR public.has_role(_uid, 'consultor_tecnico'::app_role)
    OR public.has_role(_uid, 'tecnico_agronomo'::app_role)
    OR public.has_role(_uid, 'aplicador'::app_role)
    OR public.has_role(_uid, 'producao'::app_role)
    OR public.has_role(_uid, 'operador_onfarm'::app_role)
  ), false);
$function$;
CREATE OR REPLACE FUNCTION public.is_valid_b2b_partner_user(p_user_id uuid, p_partner_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT platform_private.platform_actor_access_ready(p_user_id)
 AND EXISTS(SELECT 1 FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id
 JOIN public.partner_users pu ON pu.user_id=p.user_id
 JOIN public.partner_accounts pa ON pa.id=pu.partner_id
 JOIN public.organizations owner ON owner.id=pa.commercial_owner_organization_id
 WHERE p.user_id=p_user_id AND pa.id=p_partner_id AND p.ativo AND o.ativo AND o.status='ativa'
 AND owner.ativo AND owner.status='ativa' AND pa.ativo AND pa.deleted_at IS NULL
 AND p.organization_id=pu.tenant_id AND pu.tenant_id=owner.id
 AND (o.partner_account_id IS NULL OR o.partner_account_id=pa.id)
 AND pu.revoked_at IS NULL AND pu.valid_from<=now())
 AND (SELECT count(*) FROM public.partner_users WHERE user_id=p_user_id)=1
 AND EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=p_user_id AND role IN ('parceiro_b2b','parceiro_b2b_tecnico'))
 AND NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=p_user_id AND role NOT IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'));
$function$;
CREATE OR REPLACE FUNCTION public.is_visit_responsible(p_user_id uuid, p_registro_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT public.technical_actor_ready(p_user_id) AND EXISTS (
 SELECT 1 FROM public.registros_consultor r WHERE r.id=p_registro_id
 AND public.technical_refs_in_actor_tenant(r.cliente_id,r.fazenda_id,r.talhao_id)
 AND public.technical_client_link(p_user_id,r.cliente_id,ARRAY['read','execute','manage'])
 AND (r.consultor_responsavel=p_user_id OR r.created_by=p_user_id
 OR r.consultor_profile_id IN (SELECT p.id FROM public.profiles p WHERE p.user_id=p_user_id)));
$function$;
CREATE OR REPLACE FUNCTION public.log_estoque_movimentacao()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_ctx jsonb := public.fn_estoque_ctx_read();
  v_acao text;
  v_dir text;
  v_usuario uuid;
  v_old_status text;
  v_new_status text;
  v_qtd numeric;
  v_mudou boolean;
  v_key text := v_ctx->>'idempotency_key';
  v_meta jsonb := COALESCE(v_ctx->'metadata', '{}'::jsonb);
  v_seq int;
BEGIN
  -- Uma operação do motor pode tocar mais de uma linha (reserva parcial).
  -- O lançamento principal fica com a chave da operação; os complementares
  -- recebem chave derivada determinística e são marcados como desdobramento.
  IF v_key IS NOT NULL THEN
    SELECT count(*) INTO v_seq
      FROM public.estoque_movimentacoes
     WHERE idempotency_key = v_key OR left(idempotency_key,length(v_key)+1) = v_key || '#';
    IF v_seq > 0 THEN
      v_meta := v_meta || jsonb_build_object('desdobramento', true, 'operacao_key', v_key);
      v_key := v_key || '#' || v_seq::text;
    END IF;
  END IF;

  IF TG_OP = 'INSERT' THEN
    INSERT INTO public.estoque_movimentacoes
      (estoque_produto_id, acao, quantidade, status_novo, lote_id, usuario_id,
       saldo_anterior, saldo_posterior, reservado_anterior, reservado_posterior,
       volume_anterior, volume_posterior, unidade, direcao,
       origem, referencia_tipo, referencia_id, motivo, idempotency_key, request_fingerprint,
       movimentacao_origem_id, os_id, os_tipo, cliente_id, metadata)
    VALUES (
      NEW.id,
      COALESCE(v_ctx->>'acao', 'entrada'),
      NULLIF(NEW.quantidade, 0), NEW.status::text, NEW.lote_id,
      COALESCE(auth.uid(), (v_ctx->>'usuario_id')::uuid),
      0, COALESCE(NEW.quantidade, 0),
      0, COALESCE(NEW.quantidade_reservada, 0),
      0, COALESCE(NEW.volume_total, 0),
      COALESCE(v_ctx->>'unidade', 'un'), 'entrada',
      COALESCE(v_ctx->>'origem', 'trigger'),
      v_ctx->>'referencia_tipo', (v_ctx->>'referencia_id')::uuid,
      v_ctx->>'motivo', v_key, v_ctx->>'request_fingerprint',
      (v_ctx->>'movimentacao_origem_id')::uuid,
      NEW.reservado_para_os_id, NEW.reservado_para_os_tipo, NEW.reservado_para_cliente_id,
      v_meta
    );
    RETURN NEW;
  END IF;

  v_mudou := (OLD.status IS DISTINCT FROM NEW.status)
          OR (COALESCE(OLD.quantidade,0) IS DISTINCT FROM COALESCE(NEW.quantidade,0))
          OR (COALESCE(OLD.quantidade_reservada,0) IS DISTINCT FROM COALESCE(NEW.quantidade_reservada,0))
          OR (COALESCE(OLD.volume_total,0) IS DISTINCT FROM COALESCE(NEW.volume_total,0));
  IF NOT v_mudou THEN RETURN NEW; END IF;

  v_old_status := OLD.status::text;
  v_new_status := NEW.status::text;

  v_acao := COALESCE(v_ctx->>'acao', CASE
    WHEN v_new_status = 'reservado'  AND v_old_status = 'expedido'  THEN 'estorno_expedicao'
    WHEN v_new_status = 'reservado'  AND v_old_status <> 'reservado' THEN 'reserva'
    WHEN v_new_status = 'expedido'   AND v_old_status <> 'expedido'  THEN 'expedicao'
    WHEN v_new_status = 'estornado'                                  THEN 'estorno_expedicao'
    WHEN v_old_status = 'reservado'  AND v_new_status = 'disponivel' THEN 'cancelamento_reserva'
    WHEN v_old_status = v_new_status THEN 'ajuste'
    ELSE 'edicao'
  END);

  v_dir := COALESCE(v_ctx->>'direcao', CASE
    WHEN COALESCE(NEW.quantidade,0) > COALESCE(OLD.quantidade,0) THEN 'entrada'
    WHEN COALESCE(NEW.quantidade,0) < COALESCE(OLD.quantidade,0) THEN 'saida'
    WHEN v_acao IN ('expedicao','descarte','perda','consumo','entrega') THEN 'saida'
    WHEN v_acao IN ('estorno_expedicao','devolucao') THEN 'entrada'
    ELSE 'neutro'
  END);

  v_usuario := COALESCE(auth.uid(), (v_ctx->>'usuario_id')::uuid,
    CASE WHEN v_new_status = 'expedido' THEN NEW.expedido_por ELSE NEW.reservado_por END);

  v_qtd := NULLIF(ABS(COALESCE(NEW.quantidade,0) - COALESCE(OLD.quantidade,0)), 0);
  IF v_qtd IS NULL THEN
    v_qtd := NULLIF(ABS(COALESCE(NEW.quantidade_reservada,0) - COALESCE(OLD.quantidade_reservada,0)), 0);
  END IF;
  IF v_qtd IS NULL THEN
    v_qtd := NULLIF(COALESCE(NEW.quantidade_reservada, NEW.quantidade, 0), 0);
  END IF;

  INSERT INTO public.estoque_movimentacoes
    (estoque_produto_id, acao, quantidade, status_anterior, status_novo,
     os_id, os_tipo, cliente_id, lote_id, usuario_id, observacao,
     saldo_anterior, saldo_posterior, reservado_anterior, reservado_posterior,
     volume_anterior, volume_posterior, unidade, direcao,
     origem, referencia_tipo, referencia_id, motivo,
     idempotency_key, request_fingerprint, movimentacao_origem_id, metadata)
  VALUES (
    NEW.id, v_acao, v_qtd, v_old_status, v_new_status,
    NEW.reservado_para_os_id, NEW.reservado_para_os_tipo, NEW.reservado_para_cliente_id,
    NEW.lote_id, v_usuario, COALESCE(v_ctx->>'observacao', NEW.observacao_reserva),
    COALESCE(OLD.quantidade,0), COALESCE(NEW.quantidade,0),
    COALESCE(OLD.quantidade_reservada,0), COALESCE(NEW.quantidade_reservada,0),
    COALESCE(OLD.volume_total,0), COALESCE(NEW.volume_total,0),
    COALESCE(v_ctx->>'unidade','un'), v_dir,
    COALESCE(v_ctx->>'origem','trigger'),
    v_ctx->>'referencia_tipo', (v_ctx->>'referencia_id')::uuid, v_ctx->>'motivo',
    v_key, v_ctx->>'request_fingerprint',
    (v_ctx->>'movimentacao_origem_id')::uuid,
    v_meta
  );

  IF v_acao = 'reserva' THEN
    INSERT INTO public.notificacoes_operacionais (usuario_id, tipo, titulo, mensagem, link)
    SELECT ur.user_id, 'nova_reserva', 'Nova reserva de estoque',
           'Item reservado aguardando expedição.', '/estoque'
      FROM public.user_roles ur JOIN public.profiles pr ON pr.user_id=ur.user_id AND pr.ativo IS TRUE JOIN public.lotes l ON l.id=NEW.lote_id AND l.organization_id=pr.organization_id JOIN public.organizations o ON o.id=pr.organization_id AND o.ativo IS TRUE WHERE ur.role = 'administrativo'::app_role AND l.organization_id IS NOT NULL;
  END IF;

  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION public.partner_apply_default_discount(p_partner_id uuid)
 RETURNS integer
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_desc numeric(5,2);
  v_count integer := 0;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'auth_required'; END IF;
  IF NOT (has_role(v_uid, 'administrador') OR has_role(v_uid, 'gestor_comercial')) THEN
    RAISE EXCEPTION 'forbidden';
  END IF;

  SELECT desconto_padrao INTO v_desc FROM public.partner_accounts WHERE id = p_partner_id AND ativo IS TRUE AND deleted_at IS NULL FOR UPDATE;
  IF v_desc IS NULL THEN RAISE EXCEPTION 'partner_not_found' USING ERRCODE='42501'; END IF;

  INSERT INTO public.partner_product_prices(partner_id, product_id, preco_tabela, desconto_percentual, preco_final, ativo)
  SELECT p_partner_id, p.id,
         COALESCE(p.valor_ha_brl, 0),
         v_desc,
         ROUND(COALESCE(p.valor_ha_brl, 0) * (1 - v_desc/100.0), 2),
         true
  FROM public.produtos p
  WHERE p.ativo = true
  ON CONFLICT (partner_id, product_id) WHERE product_id IS NOT NULL DO UPDATE
    SET preco_tabela = EXCLUDED.preco_tabela,
        desconto_percentual = EXCLUDED.desconto_percentual,
        preco_final = EXCLUDED.preco_final,
        ativo = true;
  GET DIAGNOSTICS v_count = ROW_COUNT;
  RETURN v_count;
END;
$function$;
CREATE OR REPLACE FUNCTION public.platform_create_global_product(p_payload jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE sql
 SET search_path TO ''
AS $function$
  SELECT platform_private.create_global_product_core(p_payload,p_reason,p_idempotency_key);
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_actor_scope(_uid uuid)
 RETURNS TABLE(profile_ok boolean, org_partner uuid, user_partner uuid, user_partner_count integer, partner_valid boolean, has_catalog boolean)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
  WITH pr AS (
    SELECT o.partner_account_id
      FROM public.profiles p JOIN public.organizations o ON o.id = p.organization_id
     WHERE p.user_id = _uid AND p.ativo = true AND o.ativo = true AND o.status = 'ativa'
     LIMIT 1
  ), pu AS (
    SELECT count(*)::int c, min(partner_id::text)::uuid pid
      FROM public.partner_users
     WHERE user_id = _uid AND revoked_at IS NULL
  ), valid AS (
    -- Caminho fornecedor: vínculo só resolve o parceiro com a cadeia completa
    -- perfil→organização→tenant→proprietário comprovada no servidor.
    SELECT CASE WHEN (SELECT c FROM pu) = 1
                 AND public.is_valid_b2b_partner_user(_uid, (SELECT pid FROM pu))
                 AND EXISTS (
                   SELECT 1
                     FROM public.partner_users puv
                     JOIN public.partner_accounts pa ON pa.id = puv.partner_id
                     JOIN public.organizations owner ON owner.id = pa.commercial_owner_organization_id
                     JOIN public.profiles pf ON pf.user_id = puv.user_id
                     JOIN public.organizations porg ON porg.id = pf.organization_id
                    WHERE puv.user_id = _uid
                      AND puv.partner_id = (SELECT pid FROM pu)
                      AND puv.revoked_at IS NULL
                      AND (puv.valid_from IS NULL OR puv.valid_from <= now())
                      AND pf.ativo = true
                      AND porg.ativo = true AND porg.status = 'ativa'
                      AND pf.organization_id = puv.tenant_id
                      AND puv.tenant_id = pa.commercial_owner_organization_id
                      AND pa.ativo = true AND pa.deleted_at IS NULL
                      AND owner.ativo = true AND owner.status = 'ativa'
                 )
              THEN (SELECT pid FROM pu) END AS pid
  )
  SELECT EXISTS (SELECT 1 FROM pr),
         -- Organização com parceiro explícito prevalece; sem ela, o vínculo autorizado
         -- validado resolve o parceiro. Se ambos existirem e divergirem, org_partner
         -- permanece o da organização e os consumidores negam por mismatch.
         COALESCE((SELECT partner_account_id FROM pr), (SELECT pid FROM valid)),
         (SELECT pid FROM valid),
         (SELECT c FROM pu),
         CASE WHEN (SELECT partner_account_id FROM pr) IS NOT NULL
              THEN EXISTS (SELECT 1 FROM pr JOIN public.partner_accounts pa ON pa.id = pr.partner_account_id
                            WHERE pa.ativo = true AND pa.deleted_at IS NULL)
              ELSE (SELECT pid FROM valid) IS NOT NULL END,
         EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'catalogo_precos');
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_coherent_self_partner(p_partner uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT COALESCE((platform_private.b2b_commercial_context()->>'partner_id')::uuid=p_partner,false);
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_commercial_context()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE u uuid:=auth.uid(); org uuid; pid uuid; rs text[]; result jsonb; BEGIN
 org:=public.h15_actor_organization();
 SELECT partner_id INTO pid FROM public.partner_users WHERE user_id=u;
 IF NOT public.is_valid_b2b_partner_user(u,pid) THEN RETURN NULL; END IF;
 SELECT array_agg(role::text ORDER BY role::text) INTO rs FROM public.user_roles WHERE user_id=u;
 result:=jsonb_build_object('contract','C2_MULTIPROFILE_V1','actor_id',u,'tenant_id',org,
 'organization_id',org,'partner_id',pid,'commercial_owner_organization_id',org,'external_roles',rs,
 'role',CASE WHEN 'parceiro_b2b'=ANY(rs) THEN 'parceiro_b2b' ELSE 'parceiro_b2b_tecnico' END,
 'papel',CASE WHEN 'parceiro_b2b'=ANY(rs) THEN 'gestor' ELSE 'tecnico' END,'mode','commercial_owner',
 'manager', 'parceiro_b2b'=ANY(rs),'technician','parceiro_b2b_tecnico'=ANY(rs),
 'producer_links_valid',platform_private.c2_producer_links(u,org),
 'profile_stamp',(SELECT updated_at FROM public.profiles WHERE user_id=u),
 'link_version',(SELECT version FROM public.partner_users WHERE user_id=u));
 RETURN result;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_direct_partner_row_allowed()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT NOT EXISTS (
 SELECT 1 FROM public.user_roles r WHERE r.user_id=auth.uid()
 AND (r.role='parceiro_b2b_tecnico'::public.app_role OR
 (r.role='parceiro_b2b'::public.app_role AND EXISTS (
 SELECT 1 FROM public.profiles p
 JOIN public.partner_users pu ON pu.user_id=p.user_id
 JOIN public.partner_accounts pa ON pa.id=pu.partner_id
 WHERE p.user_id=r.user_id AND p.organization_id=pa.commercial_owner_organization_id
 ))));
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_internal_assert_origin(s jsonb, partner uuid, client uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE org uuid; uid uuid:=auth.uid();
BEGIN
 IF uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
 org:=public.h15_actor_organization();
 IF org IS NULL OR NOT public.fn_cc_can_prepare(uid) OR NOT public._saas_user_has_feature(uid,'pedidos_b2b') THEN RAISE EXCEPTION 'B2B_INTERNAL_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 IF NOT platform_private.b2b_internal_origin_valid(s) OR s->>'organization_id' IS DISTINCT FROM org::text OR s->>'partner_id' IS DISTINCT FROM partner::text THEN RAISE EXCEPTION 'B2B_INTERNAL_ORIGIN_DENIED' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.partner_accounts p WHERE p.id=partner AND p.commercial_owner_organization_id=org AND p.ativo IS TRUE AND p.deleted_at IS NULL
 AND (p.client_id IS NULL OR EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=p.client_id AND c.organization_id=org))) THEN RAISE EXCEPTION 'B2B_INTERNAL_PARTNER_DENIED' USING ERRCODE='42501'; END IF;
 IF client IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=client AND c.organization_id=org) THEN RAISE EXCEPTION 'B2B_INTERNAL_CLIENT_DENIED' USING ERRCODE='42501'; END IF;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_internal_child_snapshot_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE old_parent uuid; new_parent uuid; parent uuid; o public.partner_orders; before_value jsonb; after_value jsonb;
BEGIN
 IF TG_TABLE_NAME='partner_order_items' THEN
  IF TG_OP<>'INSERT' THEN old_parent:=OLD.order_id; END IF;
  IF TG_OP<>'DELETE' THEN new_parent:=NEW.order_id; END IF;
 ELSE
  IF TG_OP<>'INSERT' THEN old_parent:=OLD.partner_order_id; END IF;
  IF TG_OP<>'DELETE' THEN new_parent:=NEW.partner_order_id; END IF;
 END IF;
 FOR parent IN SELECT DISTINCT x FROM unnest(ARRAY[old_parent,new_parent]) x WHERE x IS NOT NULL ORDER BY x LOOP
  SELECT * INTO o FROM public.partner_orders WHERE id=parent FOR UPDATE;
  IF o.c2_external_origin_snapshot IS NOT NULL THEN PERFORM platform_private.c2_external_origin_assert(o.c2_external_origin_snapshot,o.partner_id,o.cliente_id); END IF;
  IF o.internal_origin_snapshot IS NOT NULL OR o.c2_external_origin_snapshot IS NOT NULL THEN
   IF o.internal_origin_snapshot IS NOT NULL THEN PERFORM platform_private.b2b_internal_assert_origin(o.internal_origin_snapshot,o.partner_id,o.cliente_id); END IF;
   IF o.status IN ('cancelado','reprovado') THEN RAISE EXCEPTION 'B2B_INTERNAL_TERMINAL_STATUS' USING ERRCODE='42501'; END IF;
   IF o.internal_economic_snapshot IS NOT NULL THEN
    IF TG_OP<>'UPDATE' THEN RAISE EXCEPTION 'B2B_INTERNAL_ECONOMICS_IMMUTABLE' USING ERRCODE='42501'; END IF;
    before_value:=to_jsonb(OLD); after_value:=to_jsonb(NEW);
    IF TG_TABLE_NAME='partner_order_payment_terms' THEN before_value:=before_value-ARRAY['updated_at','approval_status','approved_by','approved_at','approval_notes']; after_value:=after_value-ARRAY['updated_at','approval_status','approved_by','approved_at','approval_notes'];
    ELSIF TG_TABLE_NAME='partner_order_payment_schedule' THEN before_value:=before_value-ARRAY['status','receivable_installment_id']; after_value:=after_value-ARRAY['status','receivable_installment_id']; END IF;
    IF before_value IS DISTINCT FROM after_value THEN RAISE EXCEPTION 'B2B_INTERNAL_ECONOMICS_IMMUTABLE' USING ERRCODE='42501'; END IF;
   END IF;
  END IF;
 END LOOP;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_internal_commercial_actor()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$ SELECT auth.uid() IS NOT NULL AND public.h15_actor_organization() IS NOT NULL AND platform_private.platform_actor_access_ready(auth.uid()) AND (public.has_role(auth.uid(),'administrador'::public.app_role) OR public.has_role(auth.uid(),'gestor_comercial'::public.app_role)) AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=auth.uid() AND r.role IN ('parceiro_b2b','parceiro_b2b_tecnico')); $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_internal_order_snapshot_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE org uuid; uid uuid:=auth.uid(); cs public.company_fiscal_settings; candidate_count integer; economic jsonb; terms public.partner_order_payment_terms; items jsonb; schedule jsonb;
BEGIN

 -- Explicit external proof; NULL internal origin alone never authorizes a legacy order.
 IF TG_OP='INSERT' AND platform_private.has_ticket('c2_external_order_create',NEW.partner_id) THEN
  IF NEW.c2_external_origin_snapshot IS NOT NULL OR NEW.internal_origin_snapshot IS NOT NULL OR NEW.internal_economic_snapshot IS NOT NULL
  THEN RAISE EXCEPTION 'B2B_INTERNAL_SNAPSHOT_SERVER_ONLY' USING ERRCODE='42501'; END IF;
  IF NOT platform_private.c2_owner_order_create_allowed(uid,NEW.partner_id) OR NEW.created_by IS DISTINCT FROM uid
  THEN RAISE EXCEPTION 'C2_EXTERNAL_CREATE_DENIED' USING ERRCODE='42501'; END IF;
  SELECT p.commercial_owner_organization_id,p.client_id INTO org,NEW.cliente_id FROM public.partner_accounts p WHERE p.id=NEW.partner_id FOR SHARE;
  SELECT count(*) INTO candidate_count FROM public.company_fiscal_settings c WHERE c.organization_id=org AND c.is_active;
  IF candidate_count>1 THEN RAISE EXCEPTION 'B2B_INTERNAL_ISSUER_AMBIGUOUS' USING ERRCODE='42501'; END IF;
  IF candidate_count=1 THEN SELECT * INTO cs FROM public.company_fiscal_settings c WHERE c.organization_id=org AND c.is_active FOR SHARE; END IF;
  IF candidate_count=1 AND cs.configuration_status='VALIDATED' AND cs.accounting_validated_at IS NOT NULL AND nullif(btrim(cs.legal_name),'') IS NOT NULL AND nullif(btrim(cs.cnpj),'') IS NOT NULL THEN
    NEW.c2_external_origin_snapshot:=jsonb_build_object('contract','C2_EXTERNAL_ORDER_ORIGIN_V1','schema_version','1','organization_id',org,'creditor_organization_id',org,'issuer_organization_id',org,'company_settings_id',cs.id,'company_configuration_version',cs.configuration_version,'issuer_legal_name',cs.legal_name,'issuer_cnpj',cs.cnpj,'actor_user_id',uid,'partner_id',NEW.partner_id);
  ELSE
   -- C2_ACCOUNTING_PENDING_V1: honest non-fiscal request; no issuer identity/attestation is copied or invented.
   NEW.c2_external_origin_snapshot:=jsonb_build_object('contract','C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1','schema_version','1','organization_id',org,'creditor_organization_id',org,'actor_user_id',uid,'partner_id',NEW.partner_id,'issuer_state',CASE WHEN candidate_count=0 THEN 'NOT_CONFIGURED' ELSE coalesce(cs.configuration_status,'UNKNOWN') END,'company_settings_id',cs.id,'accounting_validated',false);
  END IF;
  PERFORM platform_private.c2_external_origin_assert(NEW.c2_external_origin_snapshot,NEW.partner_id,NEW.cliente_id);
  IF NEW.ready_for_production OR NEW.status NOT IN ('em_analise_comercial','aguardando_cotacao','aguardando_aprovacao_credito') THEN RAISE EXCEPTION 'C2_EXTERNAL_INITIAL_STATE_DENIED' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 IF TG_OP='INSERT' AND NEW.c2_external_origin_snapshot IS NOT NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_SNAPSHOT_SERVER_ONLY' USING ERRCODE='42501'; END IF;
 IF TG_OP='UPDATE' AND (OLD.c2_external_origin_snapshot IS NOT NULL OR NEW.c2_external_origin_snapshot IS NOT NULL) THEN
  IF (NEW.c2_external_origin_snapshot IS DISTINCT FROM OLD.c2_external_origin_snapshot AND NOT platform_private.c2_accounting_promotion_ok(OLD.c2_external_origin_snapshot,NEW.c2_external_origin_snapshot,NEW.id)) OR NEW.internal_origin_snapshot IS DISTINCT FROM OLD.internal_origin_snapshot OR NEW.internal_economic_snapshot IS DISTINCT FROM OLD.internal_economic_snapshot
  THEN RAISE EXCEPTION 'B2B_INTERNAL_SNAPSHOT_IMMUTABLE' USING ERRCODE='42501'; END IF;
  PERFORM platform_private.c2_external_origin_assert(OLD.c2_external_origin_snapshot,OLD.partner_id,OLD.cliente_id);
  PERFORM platform_private.c2_external_origin_assert(NEW.c2_external_origin_snapshot,NEW.partner_id,NEW.cliente_id);
  IF NEW.partner_id IS DISTINCT FROM OLD.partner_id OR NEW.cliente_id IS DISTINCT FROM OLD.cliente_id OR NEW.created_by IS DISTINCT FROM OLD.created_by THEN RAISE EXCEPTION 'B2B_INTERNAL_IDENTITY_IMMUTABLE' USING ERRCODE='42501'; END IF;
  IF NEW.ready_for_production OR public.fn_b2b_status_is_operational(NEW.status) THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF;
  IF NEW.status IS DISTINCT FROM OLD.status AND OLD.status IN ('cancelado','reprovado') THEN RAISE EXCEPTION 'B2B_INTERNAL_TERMINAL_STATUS' USING ERRCODE='42501'; END IF;
  IF OLD.internal_economic_snapshot IS NOT NULL AND (to_jsonb(NEW)-ARRAY['status','updated_at','approval_notes','estimated_delivery_date','financial_status','receivable_generated','receivable_generated_at','receivable_generated_by','future_financial_link','commercial_notes','payment_due_date','payment_method']) IS DISTINCT FROM (to_jsonb(OLD)-ARRAY['status','updated_at','approval_notes','estimated_delivery_date','financial_status','receivable_generated','receivable_generated_at','receivable_generated_by','future_financial_link','commercial_notes','payment_due_date','payment_method']) THEN RAISE EXCEPTION 'B2B_INTERNAL_ECONOMICS_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF NEW.status='aprovado' AND OLD.status IS DISTINCT FROM NEW.status THEN
  IF NOT (public.has_role(uid,'administrador'::public.app_role) OR public.has_role(uid,'gestor_comercial'::public.app_role)) OR OLD.status NOT IN ('em_analise_comercial','solicitado','rascunho') OR NEW.payment_condition_status IS DISTINCT FROM 'defined' THEN RAISE EXCEPTION 'B2B_INTERNAL_APPROVAL_DENIED' USING ERRCODE='42501'; END IF;
  SELECT * INTO terms FROM public.partner_order_payment_terms t WHERE t.id=NEW.payment_terms_id AND t.partner_order_id=NEW.id FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'B2B_INTERNAL_TERMS_REQUIRED' USING ERRCODE='42501'; END IF;
  IF NEW.total IS NULL OR NEW.total::text IN ('NaN','Infinity','-Infinity') OR NEW.total<0 OR terms.final_amount IS DISTINCT FROM NEW.total OR NEW.desconto_total<0 THEN RAISE EXCEPTION 'B2B_INTERNAL_TOTAL_INVALID' USING ERRCODE='22023'; END IF;
  IF NOT EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id) OR EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id AND (i.quantidade IS NULL OR i.quantidade<=0 OR i.quantidade::text IN ('NaN','Infinity','-Infinity') OR i.preco_unitario IS NULL OR i.preco_unitario<0 OR i.preco_unitario::text IN ('NaN','Infinity','-Infinity') OR i.desconto_percentual IS NULL OR i.desconto_percentual<0 OR i.desconto_percentual>100 OR i.desconto_percentual::text IN ('NaN','Infinity','-Infinity'))) THEN RAISE EXCEPTION 'B2B_INTERNAL_ITEM_INVALID' USING ERRCODE='22023'; END IF;
  SELECT jsonb_agg(to_jsonb(i)-ARRAY['created_at'] ORDER BY i.id) INTO items FROM public.partner_order_items i WHERE i.order_id=NEW.id;
  SELECT jsonb_agg(to_jsonb(s)-ARRAY['created_at','status','receivable_installment_id'] ORDER BY s.installment_number,s.id) INTO schedule FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id AND s.payment_terms_id=terms.id;
  IF schedule IS NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_SCHEDULE_REQUIRED' USING ERRCODE='22023'; END IF;
 IF NEW.subtotal IS NULL OR NEW.desconto_total IS NULL OR NEW.subtotal::text IN ('NaN','Infinity','-Infinity') OR NEW.desconto_total::text IN ('NaN','Infinity','-Infinity') OR NEW.subtotal<0 OR NEW.desconto_total<0 OR NEW.desconto_total>NEW.subtotal OR terms.discount_percent_snapshot IS NULL OR terms.discount_percent_snapshot::text IN ('NaN','Infinity','-Infinity') OR terms.discount_percent_snapshot<0 OR terms.discount_percent_snapshot>100 THEN RAISE EXCEPTION 'B2B_INTERNAL_TOTAL_INVALID' USING ERRCODE='22023'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id AND (i.subtotal IS NULL OR i.subtotal<0 OR i.subtotal::text IN ('NaN','Infinity','-Infinity'))) OR (SELECT round(sum(i.subtotal),2) FROM public.partner_order_items i WHERE i.order_id=NEW.id) IS DISTINCT FROM round(terms.net_amount_after_discount,2) THEN RAISE EXCEPTION 'B2B_INTERNAL_ITEM_INVALID' USING ERRCODE='22023'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id AND (s.payment_terms_id IS DISTINCT FROM terms.id OR s.installment_number<=0 OR s.due_date IS NULL OR s.amount IS NULL OR s.principal_amount IS NULL OR s.interest_amount IS NULL OR s.amount<0 OR s.principal_amount<0 OR s.interest_amount<0 OR s.amount::text IN ('NaN','Infinity','-Infinity') OR s.principal_amount::text IN ('NaN','Infinity','-Infinity') OR s.interest_amount::text IN ('NaN','Infinity','-Infinity'))) OR (SELECT count(*) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM terms.installment_count::bigint OR (SELECT count(DISTINCT s.installment_number) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM terms.installment_count::bigint OR (SELECT round(sum(s.amount),2) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM round(terms.final_amount,2) THEN RAISE EXCEPTION 'B2B_INTERNAL_SCHEDULE_INVALID' USING ERRCODE='22023'; END IF;
  economic:=jsonb_build_object('schema_version','1','origin',OLD.c2_external_origin_snapshot,'items',items,'terms',to_jsonb(terms)-ARRAY['updated_at','approval_status','approved_by','approved_at','approval_notes'],'schedule',schedule,'subtotal',NEW.subtotal,'discount',NEW.desconto_total,'total',NEW.total,'sealed_by',uid);
  NEW.internal_economic_snapshot:=economic;

 END IF;
 RETURN NEW;
 END IF;
 IF TG_OP='INSERT' THEN
  IF uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
  org:=public.h15_actor_organization();
  IF org IS NULL OR NOT public.fn_cc_can_prepare(uid) OR NOT public._saas_user_has_feature(uid,'pedidos_b2b') THEN RAISE EXCEPTION 'B2B_INTERNAL_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
  -- No client/CNPJ/organizations.partner_account_id inference. All caller snapshots rejected.
  IF NEW.internal_origin_snapshot IS NOT NULL OR NEW.internal_economic_snapshot IS NOT NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_SNAPSHOT_SERVER_ONLY' USING ERRCODE='42501'; END IF;
  SELECT count(*) INTO candidate_count FROM public.company_fiscal_settings c WHERE c.organization_id=org AND c.is_active IS TRUE;
  IF candidate_count<>1 THEN RAISE EXCEPTION 'B2B_INTERNAL_ISSUER_AMBIGUOUS' USING ERRCODE='42501'; END IF;
  SELECT * INTO cs FROM public.company_fiscal_settings c WHERE c.organization_id=org AND c.is_active IS TRUE FOR SHARE;
  IF cs.configuration_status IS DISTINCT FROM 'VALIDATED' OR cs.accounting_validated_at IS NULL OR nullif(btrim(cs.legal_name),'') IS NULL OR nullif(btrim(cs.cnpj),'') IS NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_ISSUER_NOT_VALIDATED' USING ERRCODE='42501'; END IF;
  NEW.internal_origin_snapshot:=jsonb_build_object('schema_version','1','organization_id',org,'creditor_organization_id',org,'issuer_organization_id',org,'company_settings_id',cs.id,'company_configuration_version',cs.configuration_version,'issuer_legal_name',cs.legal_name,'issuer_cnpj',cs.cnpj,'actor_user_id',uid,'partner_id',NEW.partner_id);
  PERFORM platform_private.b2b_internal_assert_origin(NEW.internal_origin_snapshot,NEW.partner_id,NEW.cliente_id);
  IF NEW.ready_for_production IS TRUE THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF; IF NEW.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue','faturado') THEN RAISE EXCEPTION 'B2B_INTERNAL_INITIAL_STATUS_DENIED' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 IF NEW.internal_origin_snapshot IS DISTINCT FROM OLD.internal_origin_snapshot OR NEW.internal_economic_snapshot IS DISTINCT FROM OLD.internal_economic_snapshot THEN RAISE EXCEPTION 'B2B_INTERNAL_SNAPSHOT_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF OLD.internal_origin_snapshot IS NULL THEN
  IF NEW.status IS DISTINCT FROM OLD.status AND NEW.status IN ('aprovado','em_producao','produzido','aguardando_entrega','confirmado','em_separacao','enviado','entregue','faturado') THEN RAISE EXCEPTION 'B2B_INTERNAL_LEGACY_ORIGIN_UNPROVEN' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 PERFORM platform_private.b2b_internal_assert_origin(OLD.internal_origin_snapshot,OLD.partner_id,OLD.cliente_id);
 IF NEW.partner_id IS DISTINCT FROM OLD.partner_id OR NEW.cliente_id IS DISTINCT FROM OLD.cliente_id OR NEW.created_by IS DISTINCT FROM OLD.created_by THEN RAISE EXCEPTION 'B2B_INTERNAL_IDENTITY_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF OLD.internal_economic_snapshot IS NOT NULL AND (to_jsonb(NEW)-ARRAY['status','updated_at','approval_notes','estimated_delivery_date','ready_for_production','financial_status','receivable_generated','receivable_generated_at','receivable_generated_by','future_financial_link','commercial_notes']) IS DISTINCT FROM (to_jsonb(OLD)-ARRAY['status','updated_at','approval_notes','estimated_delivery_date','ready_for_production','financial_status','receivable_generated','receivable_generated_at','receivable_generated_by','future_financial_link','commercial_notes']) THEN RAISE EXCEPTION 'B2B_INTERNAL_ECONOMICS_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF NEW.status IS DISTINCT FROM OLD.status AND OLD.status IN ('cancelado','reprovado') THEN RAISE EXCEPTION 'B2B_INTERNAL_TERMINAL_STATUS' USING ERRCODE='42501'; END IF;
 IF NEW.ready_for_production IS TRUE THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF; IF public.fn_b2b_status_is_operational(NEW.status) THEN RAISE EXCEPTION 'B2B_INTERNAL_DOWNSTREAM_UNVERIFIED' USING ERRCODE='42501'; END IF; IF NEW.ready_for_production IS TRUE AND NEW.status<>'aprovado' THEN RAISE EXCEPTION 'B2B_INTERNAL_UNSEALED_OPERATION' USING ERRCODE='42501'; END IF; IF NEW.status='aprovado' AND OLD.status IS DISTINCT FROM NEW.status THEN
  IF NOT (public.has_role(uid,'administrador'::public.app_role) OR public.has_role(uid,'gestor_comercial'::public.app_role)) OR OLD.status NOT IN ('em_analise_comercial','solicitado','rascunho') OR NEW.payment_condition_status IS DISTINCT FROM 'defined' THEN RAISE EXCEPTION 'B2B_INTERNAL_APPROVAL_DENIED' USING ERRCODE='42501'; END IF;
  SELECT * INTO terms FROM public.partner_order_payment_terms t WHERE t.id=NEW.payment_terms_id AND t.partner_order_id=NEW.id FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'B2B_INTERNAL_TERMS_REQUIRED' USING ERRCODE='42501'; END IF;
  IF NEW.total IS NULL OR NEW.total::text IN ('NaN','Infinity','-Infinity') OR NEW.total<0 OR terms.final_amount IS DISTINCT FROM NEW.total OR NEW.desconto_total<0 THEN RAISE EXCEPTION 'B2B_INTERNAL_TOTAL_INVALID' USING ERRCODE='22023'; END IF;
  IF NOT EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id) OR EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id AND (i.quantidade IS NULL OR i.quantidade<=0 OR i.quantidade::text IN ('NaN','Infinity','-Infinity') OR i.preco_unitario IS NULL OR i.preco_unitario<0 OR i.preco_unitario::text IN ('NaN','Infinity','-Infinity') OR i.desconto_percentual IS NULL OR i.desconto_percentual<0 OR i.desconto_percentual>100 OR i.desconto_percentual::text IN ('NaN','Infinity','-Infinity'))) THEN RAISE EXCEPTION 'B2B_INTERNAL_ITEM_INVALID' USING ERRCODE='22023'; END IF;
  SELECT jsonb_agg(to_jsonb(i)-ARRAY['created_at'] ORDER BY i.id) INTO items FROM public.partner_order_items i WHERE i.order_id=NEW.id;
  SELECT jsonb_agg(to_jsonb(s)-ARRAY['created_at','status','receivable_installment_id'] ORDER BY s.installment_number,s.id) INTO schedule FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id AND s.payment_terms_id=terms.id;
  IF schedule IS NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_SCHEDULE_REQUIRED' USING ERRCODE='22023'; END IF;
 IF NEW.subtotal IS NULL OR NEW.desconto_total IS NULL OR NEW.subtotal::text IN ('NaN','Infinity','-Infinity') OR NEW.desconto_total::text IN ('NaN','Infinity','-Infinity') OR NEW.subtotal<0 OR NEW.desconto_total<0 OR NEW.desconto_total>NEW.subtotal OR terms.discount_percent_snapshot IS NULL OR terms.discount_percent_snapshot::text IN ('NaN','Infinity','-Infinity') OR terms.discount_percent_snapshot<0 OR terms.discount_percent_snapshot>100 THEN RAISE EXCEPTION 'B2B_INTERNAL_TOTAL_INVALID' USING ERRCODE='22023'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_order_items i WHERE i.order_id=NEW.id AND (i.subtotal IS NULL OR i.subtotal<0 OR i.subtotal::text IN ('NaN','Infinity','-Infinity'))) OR (SELECT round(sum(i.subtotal),2) FROM public.partner_order_items i WHERE i.order_id=NEW.id) IS DISTINCT FROM round(terms.net_amount_after_discount,2) THEN RAISE EXCEPTION 'B2B_INTERNAL_ITEM_INVALID' USING ERRCODE='22023'; END IF;
 IF EXISTS(SELECT 1 FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id AND (s.payment_terms_id IS DISTINCT FROM terms.id OR s.installment_number<=0 OR s.due_date IS NULL OR s.amount IS NULL OR s.principal_amount IS NULL OR s.interest_amount IS NULL OR s.amount<0 OR s.principal_amount<0 OR s.interest_amount<0 OR s.amount::text IN ('NaN','Infinity','-Infinity') OR s.principal_amount::text IN ('NaN','Infinity','-Infinity') OR s.interest_amount::text IN ('NaN','Infinity','-Infinity'))) OR (SELECT count(*) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM terms.installment_count::bigint OR (SELECT count(DISTINCT s.installment_number) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM terms.installment_count::bigint OR (SELECT round(sum(s.amount),2) FROM public.partner_order_payment_schedule s WHERE s.partner_order_id=NEW.id) IS DISTINCT FROM round(terms.final_amount,2) THEN RAISE EXCEPTION 'B2B_INTERNAL_SCHEDULE_INVALID' USING ERRCODE='22023'; END IF;
  economic:=jsonb_build_object('schema_version','1','origin',OLD.internal_origin_snapshot,'items',items,'terms',to_jsonb(terms)-ARRAY['updated_at','approval_status','approved_by','approved_at','approval_notes'],'schedule',schedule,'subtotal',NEW.subtotal,'discount',NEW.desconto_total,'total',NEW.total,'sealed_by',uid);
  NEW.internal_economic_snapshot:=economic;
 ELSIF NEW.status IS DISTINCT FROM OLD.status AND public.fn_b2b_status_is_operational(NEW.status) AND OLD.internal_economic_snapshot IS NULL THEN RAISE EXCEPTION 'B2B_INTERNAL_UNSEALED_OPERATION' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_internal_origin_valid(s jsonb)
 RETURNS boolean
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
 SELECT coalesce(jsonb_typeof(s)='object' AND s->>'schema_version'='1'
 AND nullif(s->>'organization_id','') IS NOT NULL
 AND s->>'organization_id'=s->>'creditor_organization_id'
 AND s->>'organization_id'=s->>'issuer_organization_id'
 AND nullif(s->>'company_settings_id','') IS NOT NULL
 AND nullif(s->>'actor_user_id','') IS NOT NULL
 AND nullif(s->>'partner_id','') IS NOT NULL,false)
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_organization_full_row_allowed()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT auth.uid() IS NOT NULL
 AND NOT EXISTS(SELECT 1 FROM public.user_roles r WHERE r.user_id=auth.uid()
   AND r.role::text IN ('parceiro_b2b','parceiro_b2b_tecnico'));
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_owner_internal_order_readable(p_order uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT EXISTS (SELECT 1 FROM public.partner_orders o
                 WHERE o.id = p_order AND platform_private.b2b_owner_internal_partner_readable(o.partner_id))
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_owner_internal_partner_readable(p_partner uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  -- Read-only predicate. Internal staff (administrador/gestor_comercial/financeiro) of the active organization that
  -- commercially owns an active partner. External roles or active partner links deny. Reads no partner_orders (no recursion).
  SELECT auth.uid() IS NOT NULL AND p_partner IS NOT NULL
    AND NOT EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id = auth.uid()
                    AND r.role::text IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'))
    AND NOT EXISTS (SELECT 1 FROM public.partner_users pu WHERE pu.user_id = auth.uid() AND pu.revoked_at IS NULL)
    AND EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id = auth.uid()
                AND r.role::text IN ('administrador','gestor_comercial','financeiro'))
    AND EXISTS (SELECT 1 FROM public.partner_accounts pa
                JOIN public.organizations owner ON owner.id = pa.commercial_owner_organization_id
                     AND owner.ativo IS TRUE AND owner.status = 'ativa'
                WHERE pa.id = p_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
                  AND pa.commercial_owner_organization_id = platform_private.h15_actor_organization())
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_order_visible(p_order uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
 SELECT EXISTS(SELECT 1 FROM public.partner_orders o WHERE o.id=p_order AND public.b2b_phase1_partner_visible(o.partner_id,false));
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_partner_visible(p_partner uuid, p_technical boolean DEFAULT false)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE s record; u uuid:=auth.uid(); BEGIN
 IF u IS NULL OR p_partner IS NULL THEN RETURN false; END IF;
 IF public.is_platform_superadmin(u) THEN RETURN true; END IF;
 IF EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=u AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor')) THEN
  RETURN public.is_valid_b2b_partner_user(u,p_partner)
   AND (public.has_role(u,'parceiro_b2b') OR (p_technical AND public.has_role(u,'parceiro_b2b_tecnico')));
 END IF;
 SELECT * INTO s FROM platform_private.b2b_actor_scope(u);
 RETURN s.profile_ok AND s.partner_valid AND s.org_partner=p_partner;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_phase1_simulation_visible(p_sim uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
 SELECT EXISTS(SELECT 1 FROM public.partner_simulations s WHERE s.id=p_sim AND public.b2b_phase1_partner_visible(s.partner_id,true) AND (NOT public.has_role(auth.uid(),'parceiro_b2b_tecnico') OR s.created_by=auth.uid()));
$function$;
CREATE OR REPLACE FUNCTION platform_private.b2b_save_technical_simulation(p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE u uuid:=auth.uid(); p uuid; s uuid; i jsonb; iid uuid; kind text; qty numeric; nm text; cl uuid;
BEGIN
 IF u IS NULL OR NOT public.has_role(u,'parceiro_b2b_tecnico') THEN RAISE EXCEPTION 'forbidden' USING ERRCODE='42501'; END IF;
 p:=(p_payload->>'partner_id')::uuid;
 IF NOT platform_private.b2b_phase1_partner_visible(p,true) THEN RAISE EXCEPTION 'scope_denied' USING ERRCODE='42501'; END IF;
 IF NOT public._saas_user_has_feature(u,'simulacoes') THEN RAISE EXCEPTION 'feature_not_entitled' USING ERRCODE='42501'; END IF;
 IF coalesce(p_payload->>'status','rascunho') NOT IN ('rascunho','enviada_gestor') THEN RAISE EXCEPTION 'invalid_status'; END IF;
 IF jsonb_typeof(p_payload->'items') IS DISTINCT FROM 'array' OR jsonb_array_length(p_payload->'items')=0 THEN RAISE EXCEPTION 'empty_simulation'; END IF;
 cl:=nullif(p_payload->>'cliente_id','')::uuid;
 IF cl IS NOT NULL AND NOT (EXISTS (SELECT 1 FROM public.partner_user_clients puc WHERE puc.cliente_id=cl AND puc.user_id=u AND puc.partner_id=p AND puc.active=true) OR EXISTS (SELECT 1 FROM public.partner_technician_clients ptc WHERE ptc.cliente_id=cl AND ptc.technician_user_id=u AND ptc.partner_id=p AND ptc.active=true)) THEN RAISE EXCEPTION 'client_scope_denied' USING ERRCODE='42501'; END IF;
 INSERT INTO public.partner_simulations(partner_id,created_by,titulo,observacoes,cultura,area_total_ha,objetivo_tecnico,status,total_cheio,valid_until,cliente_id)
 VALUES(p,u,left(p_payload->>'titulo',200),left(p_payload->>'observacoes',4000),left(p_payload->>'cultura',200),(p_payload->>'area_total_ha')::numeric,left(p_payload->>'objetivo_tecnico',2000),'rascunho',0,(p_payload->>'valid_until')::date,cl) RETURNING id INTO s;
 FOR i IN SELECT * FROM jsonb_array_elements(p_payload->'items') LOOP
  iid:=(i->>'item_id')::uuid; kind:=i->>'item_tipo'; qty:=(i->>'quantidade')::numeric;
  IF qty IS NULL OR qty<=0 OR qty::text IN ('NaN','Infinity','-Infinity') THEN RAISE EXCEPTION 'invalid_qty'; END IF;
  IF kind='produto' THEN SELECT nome INTO nm FROM public.produtos WHERE id=iid AND ativo AND b2b_enabled;
  ELSIF kind='microrganismo' THEN SELECT nome INTO nm FROM public.microrganismos WHERE id=iid AND ativo AND b2b_enabled;
  ELSE RAISE EXCEPTION 'invalid_item'; END IF;
  IF nm IS NULL THEN RAISE EXCEPTION 'product_unavailable'; END IF;
  IF coalesce(i->>'unidade_medida','hectare') NOT IN ('hectare','litro','dose','unidade') THEN RAISE EXCEPTION 'invalid_unit'; END IF;
  IF i->>'unidade_medida'='unidade' AND coalesce((i->>'volume_ml')::numeric,0)<=0 THEN RAISE EXCEPTION 'invalid_volume'; END IF;
  INSERT INTO public.partner_simulation_items(simulation_id,item_tipo,item_id,nome,quantidade,valor_unitario_cheio,subtotal,unidade_medida,volume_ml,area_ha)
  VALUES(s,kind,iid,nm,qty,0,0,coalesce(i->>'unidade_medida','hectare'),(i->>'volume_ml')::numeric,(i->>'area_ha')::numeric);
 END LOOP;
 IF p_payload->>'status'='enviada_gestor' THEN PERFORM public.send_partner_simulation_to_manager_secure(s); END IF;
 RETURN s;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c1b_catalog_visibility_scope(p_partner uuid)
 RETURNS uuid[]
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_owner uuid;
BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
 v_actor := platform_private.h15_actor_organization();
 IF v_actor IS NULL AND NOT public.is_platform_superadmin(auth.uid()) THEN
  RAISE EXCEPTION 'catalog_actor_unavailable' USING ERRCODE='42501'; END IF;
 IF p_partner IS NULL THEN
  SELECT o.partner_account_id INTO p_partner FROM public.organizations o WHERE o.id=v_actor;
 END IF;
 IF p_partner IS NOT NULL THEN
  SELECT pa.commercial_owner_organization_id INTO v_owner FROM public.partner_accounts pa
   JOIN public.organizations o ON o.id=pa.commercial_owner_organization_id AND o.ativo IS TRUE AND o.status='ativa'
   WHERE pa.id=p_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL;
  IF v_owner IS NULL THEN RAISE EXCEPTION 'catalog_commercial_owner_unavailable' USING ERRCODE='42501'; END IF;
 END IF;
 IF v_actor IS NULL AND v_owner IS NULL THEN RAISE EXCEPTION 'catalog_scope_unavailable' USING ERRCODE='42501'; END IF;
 RETURN array_remove(ARRAY[v_actor,v_owner],NULL);
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_accounting_pending_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 -- While pending, only commercial review/quote, rejection or cancellation are possible: no approval,
 -- credit decision, economics seal, receivable, production, NF or delivery.
 -- INSERT: the canonical create may land in em_analise_comercial, aguardando_cotacao or (insufficient credit)
 -- aguardando_aprovacao_credito; nothing operational/financial may be set at creation.
 IF TG_OP='INSERT' THEN
  IF NEW.c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1' AND (
     NEW.status::text NOT IN ('em_analise_comercial','aguardando_cotacao','aguardando_aprovacao_credito')
     OR NEW.ready_for_production IS TRUE OR NEW.receivable_generated IS TRUE OR NEW.internal_economic_snapshot IS NOT NULL
     OR NEW.credit_approved_at IS NOT NULL OR NEW.approved_at IS NOT NULL) THEN
   RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501';
  END IF;
  RETURN NEW;
 END IF;
 IF OLD.c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1'
    AND NEW.c2_external_origin_snapshot->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1' THEN
  -- aguardando_aprovacao_credito may only stay as is (no hidden credit decision) or leave to cancel/reject.
  IF NOT (NEW.status::text IN ('em_analise_comercial','aguardando_cotacao','cancelado','reprovado')
          OR (NEW.status=OLD.status AND OLD.status::text='aguardando_aprovacao_credito'))
     OR (OLD.status::text='aguardando_aprovacao_credito' AND NEW.status::text IN ('em_analise_comercial','aguardando_cotacao'))
     OR NEW.ready_for_production IS TRUE OR NEW.receivable_generated IS TRUE OR NEW.internal_economic_snapshot IS NOT NULL
     OR NEW.credit_approved_at IS DISTINCT FROM OLD.credit_approved_at OR NEW.approved_at IS DISTINCT FROM OLD.approved_at
     -- review e1e9aa2f: no credit/financial decision field may advance by any privileged path while pending.
     OR NEW.credit_approved_by IS DISTINCT FROM OLD.credit_approved_by OR NEW.credit_approval_notes IS DISTINCT FROM OLD.credit_approval_notes
     OR NEW.approved_by IS DISTINCT FROM OLD.approved_by
     -- review 61b28: the canonical create (same txn, private create ticket) initializes not_required -> pending/not_required;
     -- any other change (e.g. -> approved) is a financial decision and stays denied while pending.
     OR (NEW.financial_approval_status IS DISTINCT FROM OLD.financial_approval_status
         AND NOT (platform_private.has_ticket('c2_external_order_create',NEW.partner_id)
                  AND OLD.financial_approval_status='not_required' AND NEW.financial_approval_status IN ('pending','not_required'))) THEN
   RAISE EXCEPTION 'C2_ACCOUNTING_PENDING' USING ERRCODE='42501';
  END IF;
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_accounting_promotion_ok(o jsonb, n jsonb, order_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT coalesce(o->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1'
  AND n->>'contract'='C2_EXTERNAL_ORDER_ORIGIN_V1' AND platform_private.b2b_internal_origin_valid(n)
  AND n->>'organization_id'=o->>'organization_id' AND n->>'partner_id'=o->>'partner_id' AND n->>'actor_user_id'=o->>'actor_user_id'
  AND n->>'promoted_from_contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1'
  AND platform_private.has_ticket('c2_accounting_promote',order_id),false)
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2_external_final_state_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF NEW.c2_external_origin_snapshot IS NOT NULL AND OLD.internal_economic_snapshot IS NULL AND NEW.internal_economic_snapshot IS NOT NULL AND NEW.status IS DISTINCT FROM 'aprovado' THEN
  RAISE EXCEPTION 'C2_EXTERNAL_UNFINALIZED_APPROVAL' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_external_origin_assert(s jsonb, partner uuid, client uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE uid uuid:=auth.uid(); org uuid; p public.partner_accounts;
BEGIN
 IF uid IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
 SELECT * INTO p FROM public.partner_accounts WHERE id=partner FOR SHARE;
 org:=p.commercial_owner_organization_id;
 IF NOT FOUND OR p.ativo IS NOT TRUE OR p.deleted_at IS NOT NULL OR org IS NULL
 OR NOT EXISTS(SELECT 1 FROM public.organizations o WHERE o.id=org AND o.ativo AND o.status='ativa')
 OR EXISTS(SELECT 1 FROM public.organizations o WHERE o.partner_account_id=partner)
 OR NOT platform_private.c2_external_origin_contract_valid(s)
 OR s->>'organization_id' IS DISTINCT FROM org::text OR s->>'partner_id' IS DISTINCT FROM partner::text
 THEN RAISE EXCEPTION 'C2_EXTERNAL_ORIGIN_DENIED' USING ERRCODE='42501'; END IF;
 IF client IS DISTINCT FROM p.client_id OR (client IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=client AND c.organization_id=org))
 THEN RAISE EXCEPTION 'C2_EXTERNAL_CLIENT_DENIED' USING ERRCODE='42501'; END IF;
 -- Initial writes are authorized only inside the existing canonical create transaction.
 -- Subsequent administration uses P1's active internal owner authority, never buyer roles.
 IF platform_private.has_ticket('c2_external_order_create',partner) THEN
  IF s->>'actor_user_id' IS DISTINCT FROM uid::text OR NOT platform_private.c2_owner_order_create_allowed(uid,partner)
  THEN RAISE EXCEPTION 'C2_EXTERNAL_CREATE_DENIED' USING ERRCODE='42501'; END IF;
  ELSE
  IF public.h15_actor_organization() IS DISTINCT FROM org OR NOT platform_private.c2p1_settings_allowed(partner,true)
  THEN RAISE EXCEPTION 'C2_EXTERNAL_OWNER_DENIED' USING ERRCODE='42501'; END IF;
 END IF;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_external_origin_contract_valid(s jsonb)
 RETURNS boolean
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
 SELECT coalesce(
  (s->>'contract'='C2_EXTERNAL_ORDER_ORIGIN_V1' AND platform_private.b2b_internal_origin_valid(s))
  OR (jsonb_typeof(s)='object' AND s->>'contract'='C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1' AND s->>'schema_version'='1'
      AND nullif(s->>'organization_id','') IS NOT NULL AND s->>'organization_id'=s->>'creditor_organization_id'
      AND nullif(s->>'actor_user_id','') IS NOT NULL AND nullif(s->>'partner_id','') IS NOT NULL
      AND s->'accounting_validated'='false'::jsonb
      AND NOT (s ? 'issuer_organization_id') AND NOT (s ? 'issuer_legal_name') AND NOT (s ? 'issuer_cnpj')
      AND s->>'issuer_state' IS NOT NULL),false)
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2_internal_order_target_reason(_uid uuid, _partner uuid)
 RETURNS text
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE s record; org uuid;
BEGIN
  -- Mirrors LIVE guards; NULL means allowed. Never authorizes by itself: callers must RAISE.
  IF _uid IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RETURN 'auth_required'; END IF;
  IF NOT platform_private.b2b_internal_commercial_actor() THEN RETURN 'actor_not_allowed'; END IF;
  SELECT * INTO s FROM platform_private.b2b_actor_scope(_uid);
  IF s.profile_ok IS NOT TRUE THEN RETURN 'inactive_scope'; END IF;
  IF NOT public._saas_user_has_feature(_uid,'pedidos_b2b') THEN RETURN 'feature_disabled'; END IF;
  org := public.h15_actor_organization();
  IF org IS NULL THEN RETURN 'actor_not_allowed'; END IF;
  IF _partner IS NULL THEN RETURN NULL; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_accounts p
       WHERE p.id=_partner AND p.ativo IS TRUE AND p.deleted_at IS NULL AND p.commercial_owner_organization_id=org
         AND (p.client_id IS NULL OR EXISTS (SELECT 1 FROM public.clientes c WHERE c.id=p.client_id AND c.organization_id=org))) THEN
    RETURN 'target_outside_portfolio';
  END IF;
  RETURN NULL;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_owner_order_create_allowed(_uid uuid, _partner uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE c jsonb;
BEGIN
  -- c2_ord_writer_v1: nunca confia em parâmetro de uid que não seja o JWT atual.
  IF _uid IS NULL OR _partner IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RETURN false; END IF;
  -- Gestor B2B vigente (user_roles canônico; revogação remove a linha). Técnico isolado nunca compra.
  IF NOT public.has_role(_uid,'parceiro_b2b'::public.app_role) THEN RETURN false; END IF;
  c := platform_private.b2b_commercial_context();
  IF c IS NULL OR c->>'contract' <> 'C2_MULTIPROFILE_V1' OR c->>'mode' <> 'commercial_owner'
     OR (c->>'partner_id')::uuid IS DISTINCT FROM _partner OR COALESCE((c->>'manager')::boolean,false) IS NOT TRUE THEN
    RETURN false;
  END IF;
  -- Cliente comercial = sem organização própria; tenant dono ativo e coerente com perfil/vínculo.
  IF EXISTS (SELECT 1 FROM public.organizations o WHERE o.partner_account_id = _partner) THEN RETURN false; END IF;
  IF NOT COALESCE(platform_private.b2b_phase1_partner_visible(_partner,true),false) THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_users pu
      JOIN public.partner_accounts pa ON pa.id = pu.partner_id
      JOIN public.profiles p ON p.user_id = pu.user_id
      JOIN public.organizations o ON o.id = pa.commercial_owner_organization_id
     WHERE pu.user_id = _uid AND pu.partner_id = _partner
       AND pu.revoked_at IS NULL AND (pu.valid_from IS NULL OR pu.valid_from <= now())
       AND pa.ativo AND pa.deleted_at IS NULL AND o.ativo AND o.status = 'ativa'
       AND (o.partner_account_id IS NULL OR o.partner_account_id = _partner)
       AND p.ativo AND p.organization_id = pu.tenant_id AND pu.tenant_id = o.id
       AND (c->>'tenant_id')::uuid = o.id
       AND public.is_valid_b2b_partner_user(_uid, pa.id)) THEN
    RETURN false;
  END IF;
  RETURN EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'pedidos_b2b')
     AND EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'catalogo_precos');
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_producer_links(p_user uuid, p_org uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT platform_private.platform_actor_access_ready(p_user)
 AND EXISTS(SELECT 1 FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id
 JOIN public.user_clientes uc ON uc.user_id=p.user_id JOIN public.clientes c ON c.id=uc.cliente_id
 JOIN public.fazendas f ON f.cliente_id=c.id
 WHERE p.user_id=p_user AND p.organization_id=p_org AND p.ativo AND o.ativo AND o.status='ativa'
 AND uc.is_active AND uc.revoked_at IS NULL AND uc.valid_from<=now()
 AND (uc.valid_until IS NULL OR uc.valid_until>=now())
 AND c.organization_id=p_org AND c.status_cliente='ativo' AND f.organization_id=p_org AND f.ativo);
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_assignment_allowed(p_scope text, p_partner uuid, p_customer uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT COALESCE(CASE
 WHEN p_scope='partner' AND p_partner IS NOT NULL AND p_customer IS NULL THEN EXISTS(
 SELECT 1 FROM public.partner_accounts pa JOIN public.organizations owner ON owner.id=pa.commercial_owner_organization_id
 WHERE pa.id=p_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL AND owner.ativo IS TRUE AND owner.status='ativa'
 AND owner.id=platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor_comercial']::public.app_role[]))
 WHEN p_scope='producer' AND p_partner IS NULL AND p_customer IS NOT NULL THEN EXISTS(
 SELECT 1 FROM public.clientes c JOIN public.organizations o ON o.id=c.organization_id
 WHERE c.id=p_customer AND c.status_cliente='ativo' AND o.ativo IS TRUE AND o.status='ativa'
 AND o.id=platform_private.c2p1_internal_actor(ARRAY['administrador','financeiro','gestor_comercial']::public.app_role[]))
 ELSE false END,false);
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_assignment_children_fence()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ BEGIN
 IF EXISTS(SELECT 1 FROM public.commercial_condition_item_prices i WHERE i.assignment_id=OLD.id
 AND (i.plan_id IS DISTINCT FROM NEW.plan_id OR i.buyer_scope IS DISTINCT FROM NEW.buyer_scope OR i.partner_id IS DISTINCT FROM NEW.partner_id OR i.customer_id IS DISTINCT FROM NEW.customer_id))
 THEN RAISE EXCEPTION 'C2P1_ASSIGNMENT_LINK_IMMUTABLE' USING ERRCODE='42501'; END IF; RETURN NEW; END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_assignment_fence()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'C2P1_ASSIGNMENT_DELETE_CLOSED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=auth.uid() FOR SHARE NOWAIT;
 PERFORM 1 FROM public.user_roles WHERE user_id=auth.uid() ORDER BY role FOR SHARE NOWAIT;
 PERFORM 1 FROM public.organizations WHERE id IN (public.h15_actor_organization(),
 (SELECT commercial_owner_organization_id FROM public.partner_accounts WHERE id=NEW.partner_id),
 (SELECT organization_id FROM public.clientes WHERE id=NEW.customer_id)) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.partner_accounts WHERE id IN (NEW.partner_id,CASE WHEN TG_OP='UPDATE' THEN OLD.partner_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.clientes WHERE id IN (NEW.customer_id,CASE WHEN TG_OP='UPDATE' THEN OLD.customer_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 IF TG_OP='UPDATE' AND NOT platform_private.c2p1_assignment_allowed(OLD.buyer_scope,OLD.partner_id,OLD.customer_id)
 THEN RAISE EXCEPTION 'C2P1_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NOT platform_private.c2p1_assignment_allowed(NEW.buyer_scope,NEW.partner_id,NEW.customer_id)
 THEN RAISE EXCEPTION 'C2P1_FORBIDDEN' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_internal_actor(p_roles app_role[])
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT public.h15_actor_organization() WHERE auth.uid() IS NOT NULL
 AND EXISTS(SELECT 1 FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id
 WHERE p.user_id=auth.uid() AND p.ativo IS TRUE AND o.ativo IS TRUE AND o.status='ativa'
 AND platform_private.platform_actor_access_ready(p.user_id))
 AND EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND role=ANY(p_roles))
 AND NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid()
 AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor'));
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_item_allowed(p_assignment uuid, p_plan uuid, p_scope text, p_partner uuid, p_customer uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT platform_private.c2p1_assignment_allowed(p_scope,p_partner,p_customer) AND
 (p_assignment IS NULL OR EXISTS(SELECT 1 FROM public.commercial_payment_plan_assignments a
 WHERE a.id=p_assignment AND a.plan_id=p_plan AND a.buyer_scope=p_scope
 AND a.partner_id IS NOT DISTINCT FROM p_partner AND a.customer_id IS NOT DISTINCT FROM p_customer
 AND platform_private.c2p1_assignment_allowed(a.buyer_scope,a.partner_id,a.customer_id)));
$function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_item_fence()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE r public.commercial_condition_item_prices;
BEGIN
 IF TG_OP='DELETE' THEN r=OLD; ELSE r=NEW; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=auth.uid() FOR SHARE NOWAIT;
 PERFORM 1 FROM public.user_roles WHERE user_id=auth.uid() ORDER BY role FOR SHARE NOWAIT;
 PERFORM 1 FROM public.organizations WHERE id IN (public.h15_actor_organization(),(SELECT commercial_owner_organization_id FROM public.partner_accounts WHERE id=r.partner_id),(SELECT organization_id FROM public.clientes WHERE id=r.customer_id)) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.partner_accounts WHERE id IN(r.partner_id,CASE WHEN TG_OP='UPDATE' THEN OLD.partner_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.clientes WHERE id IN(r.customer_id,CASE WHEN TG_OP='UPDATE' THEN OLD.customer_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.commercial_payment_plan_assignments WHERE id IN(r.assignment_id,CASE WHEN TG_OP='UPDATE' THEN OLD.assignment_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 IF NOT platform_private.c2p1_item_allowed(r.assignment_id,r.plan_id,r.buyer_scope,r.partner_id,r.customer_id)
 OR (TG_OP='UPDATE' AND NOT platform_private.c2p1_item_allowed(OLD.assignment_id,OLD.plan_id,OLD.buyer_scope,OLD.partner_id,OLD.customer_id)) THEN
 RAISE EXCEPTION 'C2P1_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF TG_OP='UPDATE' AND (NEW.id IS DISTINCT FROM OLD.id OR NEW.created_at IS DISTINCT FROM OLD.created_at) THEN RAISE EXCEPTION 'C2P1_IDENTITY_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF TG_OP<>'DELETE' AND r.published_rule_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.commercial_price_rules pr WHERE pr.id=r.published_rule_id AND pr.plan_id=r.plan_id AND pr.buyer_scope=r.buyer_scope
 AND pr.partner_id IS NOT DISTINCT FROM r.partner_id AND pr.customer_id IS NOT DISTINCT FROM r.customer_id
 AND pr.product_id IS NOT DISTINCT FROM r.product_id AND pr.microrganismo_id IS NOT DISTINCT FROM r.microrganismo_id
 AND pr.unit_type=r.unit_type AND pr.volume_ml IS NOT DISTINCT FROM r.volume_ml) THEN RAISE EXCEPTION 'C2P1_RULE_LINK_INVALID' USING ERRCODE='42501'; END IF;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_rule_fence()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE r public.commercial_price_rules;
BEGIN
 IF TG_OP='DELETE' THEN r=OLD; ELSE r=NEW; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=auth.uid() FOR SHARE NOWAIT;
 PERFORM 1 FROM public.user_roles WHERE user_id=auth.uid() ORDER BY role FOR SHARE NOWAIT;
 PERFORM 1 FROM public.organizations WHERE id IN (public.h15_actor_organization(),(SELECT commercial_owner_organization_id FROM public.partner_accounts WHERE id=r.partner_id),(SELECT organization_id FROM public.clientes WHERE id=r.customer_id)) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.partner_accounts WHERE id IN(r.partner_id,CASE WHEN TG_OP='UPDATE' THEN OLD.partner_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 PERFORM 1 FROM public.clientes WHERE id IN(r.customer_id,CASE WHEN TG_OP='UPDATE' THEN OLD.customer_id ELSE NULL END) ORDER BY id FOR SHARE NOWAIT;
 IF NOT platform_private.c2p1_assignment_allowed(r.buyer_scope,r.partner_id,r.customer_id)
 OR (TG_OP='UPDATE' AND NOT platform_private.c2p1_assignment_allowed(OLD.buyer_scope,OLD.partner_id,OLD.customer_id)) THEN RAISE EXCEPTION 'C2P1_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF TG_OP='UPDATE' AND EXISTS(SELECT 1 FROM public.commercial_condition_item_prices i WHERE i.published_rule_id=OLD.id AND (NEW.id IS DISTINCT FROM OLD.id OR i.plan_id IS DISTINCT FROM NEW.plan_id OR i.buyer_scope IS DISTINCT FROM NEW.buyer_scope OR i.partner_id IS DISTINCT FROM NEW.partner_id OR i.customer_id IS DISTINCT FROM NEW.customer_id OR i.product_id IS DISTINCT FROM NEW.product_id OR i.microrganismo_id IS DISTINCT FROM NEW.microrganismo_id OR i.unit_type IS DISTINCT FROM NEW.unit_type OR i.volume_ml IS DISTINCT FROM NEW.volume_ml)) THEN RAISE EXCEPTION 'C2P1_RULE_LINK_IMMUTABLE' USING ERRCODE='42501'; END IF;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.c2p1_settings_allowed(p_partner uuid, p_write boolean DEFAULT false)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT EXISTS(SELECT 1 FROM public.partner_accounts pa JOIN public.organizations o
 ON o.id=platform_private.c2p1_internal_actor(CASE WHEN p_write THEN
 ARRAY['administrador','financeiro','gestor','gestor_comercial']::public.app_role[] ELSE
 ARRAY['administrador','financeiro','gestor','gestor_comercial','administrativo']::public.app_role[] END)
 WHERE pa.id=p_partner AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
 AND o.ativo IS TRUE AND o.status='ativa' AND
 (o.partner_account_id=pa.id OR EXISTS(SELECT 1 FROM public.organizations owner
 WHERE owner.id=pa.commercial_owner_organization_id AND owner.id=o.id AND owner.ativo IS TRUE AND owner.status='ativa')));
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_composition_family_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF NEW.familia_catalogo IS DISTINCT FROM OLD.familia_catalogo AND EXISTS (
      SELECT 1 FROM public.produto_composicao_declaracoes d WHERE d.produto_id = NEW.id
        AND NOT platform_private.catalog_composition_type_allowed(NEW.familia_catalogo, d.tipo_componente)) THEN
    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='catalog_composition_family_conflict'; END IF;
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_composition_row_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
DECLARE v_fam text;
BEGIN
  SELECT p.familia_catalogo INTO v_fam FROM public.produtos p WHERE p.id = NEW.produto_id;
  IF NOT platform_private.catalog_composition_type_allowed(v_fam, NEW.tipo_componente) THEN
    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='catalog_composition_family_conflict'; END IF;
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_composition_touch()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
BEGIN NEW.updated_at := GREATEST(pg_catalog.clock_timestamp(), OLD.updated_at + interval '1 microsecond'); RETURN NEW; END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_composition_type_allowed(p_familia text, p_tipo text)
 RETURNS boolean
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
  SELECT COALESCE((p_familia='biologico' AND p_tipo IN ('microrganismo','outro'))
    OR (p_familia='quimico' AND p_tipo IN ('ingrediente_ativo','outro'))
    OR (p_familia='fertilizante_adubo' AND p_tipo IN ('nutriente','outro')), false)
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_culture_normalize(p jsonb, p_create boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE
 SET search_path TO ''
AS $function$
DECLARE k text; v_out jsonb:='{}'::jsonb;
BEGIN
  IF p IS NULL OR pg_catalog.jsonb_typeof(p) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  FOR k IN SELECT pg_catalog.jsonb_object_keys(p) LOOP
    IF k = 'nome' AND pg_catalog.jsonb_typeof(p->k)='string' AND pg_catalog.char_length(pg_catalog.btrim(p->>k)) BETWEEN 1 AND 120 THEN
      v_out:=v_out||pg_catalog.jsonb_build_object(k,pg_catalog.btrim(p->>k));
    ELSIF k = 'descricao' AND pg_catalog.jsonb_typeof(p->k)='null' THEN v_out:=v_out||pg_catalog.jsonb_build_object(k,NULL::text);
    ELSIF k = 'descricao' AND pg_catalog.jsonb_typeof(p->k)='string' AND pg_catalog.char_length(p->>k) <= 2000 THEN
      v_out:=v_out||pg_catalog.jsonb_build_object(k,NULLIF(pg_catalog.btrim(p->>k),''));
    ELSE RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid';
    END IF;
  END LOOP;
  IF (p_create AND NOT v_out ? 'nome') OR (NOT p_create AND v_out='{}'::jsonb) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  RETURN v_out;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_entity_audit(p_actor uuid, p_operation text, p_reason text, p_key uuid, p_request jsonb, p_receipt jsonb, p_before jsonb, p_after jsonb)
 RETURNS void
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
  INSERT INTO public.catalog_platform_admin_audit (id,operation,actor_id,reason,correlation_id,status,counts_before,counts_after,completed_at)
  VALUES ((p_receipt->>'audit_id')::uuid,p_operation,p_actor,pg_catalog.btrim(p_reason),p_key,'completed',COALESCE(p_before,'{}'::jsonb),
    pg_catalog.jsonb_build_object('request',p_request,'receipt',p_receipt,'after',p_after),pg_catalog.clock_timestamp());
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_entity_replay(p_actor uuid, p_operation text, p_request jsonb, p_reason text, p_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_existing public.catalog_platform_admin_audit%ROWTYPE;
BEGIN
  IF p_key IS NULL OR p_reason IS NULL OR pg_catalog.char_length(pg_catalog.btrim(p_reason)) NOT BETWEEN 10 AND 500 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('catalog-metadata:'||p_key::text,0));
  SELECT * INTO v_existing FROM public.catalog_platform_admin_audit WHERE correlation_id=p_key;
  IF NOT FOUND THEN RETURN NULL; END IF;
  IF v_existing.actor_id IS DISTINCT FROM p_actor OR v_existing.operation IS DISTINCT FROM p_operation
    OR v_existing.counts_after->'request' IS DISTINCT FROM p_request THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_conflict'; END IF;
  RETURN (v_existing.counts_after->'receipt')||pg_catalog.jsonb_build_object('idempotent',true);
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_family_label_check(p_familia text, p_rotulo text)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_ativo boolean;
BEGIN
  SELECT l.ativo INTO v_ativo
    FROM public.catalog_family_labels l
   WHERE l.familia = p_familia AND l.rotulo = p_rotulo
   FOR KEY SHARE;
  RETURN COALESCE(v_ativo, false);
END $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_family_label_validate()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF NEW.classe_catalogo IS NULL THEN RETURN NEW; END IF;
  IF TG_OP = 'UPDATE'
     AND NEW.classe_catalogo IS NOT DISTINCT FROM OLD.classe_catalogo
     AND NEW.familia_catalogo IS NOT DISTINCT FROM OLD.familia_catalogo THEN
    RETURN NEW;
  END IF;
  IF NEW.familia_catalogo IS NULL
     OR NOT platform_private.catalog_family_label_check(NEW.familia_catalogo, NEW.classe_catalogo) THEN
    RAISE EXCEPTION USING ERRCODE = '23514', MESSAGE = 'catalog_label_not_active';
  END IF;
  RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_metadata_require_actor()
 RETURNS uuid
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid:=auth.uid(); v_jwt jsonb:=auth.jwt();
BEGIN
  IF v_actor IS NULL OR pg_catalog.jsonb_typeof(v_jwt->'iat') IS DISTINCT FROM 'number'
    OR COALESCE(v_jwt->>'iat','') !~ '^[0-9]{1,12}$'
    OR pg_catalog.jsonb_typeof(v_jwt->'exp') IS DISTINCT FROM 'number'
    OR COALESCE(v_jwt->>'exp','') !~ '^[0-9]{1,12}$' THEN
    RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_metadata_forbidden';
  END IF;
  IF (v_jwt->>'iat')::bigint <= 0 OR (v_jwt->>'exp')::bigint <= EXTRACT(EPOCH FROM pg_catalog.statement_timestamp())
    OR (v_jwt->>'iat')::bigint > EXTRACT(EPOCH FROM pg_catalog.statement_timestamp())
    OR NOT COALESCE(public.has_role(v_actor,'superadmin'::public.app_role),false)
    OR NOT COALESCE(public.is_platform_superadmin(v_actor),false)
    OR NOT COALESCE(platform_private.platform_actor_access_ready(v_actor),false) THEN
    RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_metadata_forbidden';
  END IF;
  RETURN v_actor;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_micro_normalize(p jsonb, p_create boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE
 SET search_path TO ''
AS $function$
DECLARE k text; v_out jsonb:='{}'::jsonb; v_num numeric;
  v_text constant jsonb:='{"nome_cientifico":300,"concentracao_label":120,"fornecedor":200,"meio_cultivo":5000,"funcao_agronomica":5000,"observacoes":5000,"descricao":5000}';
BEGIN
  IF p IS NULL OR pg_catalog.jsonb_typeof(p) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  FOR k IN SELECT pg_catalog.jsonb_object_keys(p) LOOP
    IF k = 'nome' THEN
      IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string' OR pg_catalog.char_length(pg_catalog.btrim(p->>k)) NOT BETWEEN 1 AND 200 THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,pg_catalog.btrim(p->>k));
    ELSIF k = 'tipo' THEN
      -- tipo define prefixo do código gerado no servidor: somente na criação.
      IF NOT p_create OR pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string'
        OR NOT ((p->>k) = ANY(pg_catalog.enum_range(NULL::public.tipo_microrganismo)::text[])) THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,p->>k);
    ELSIF k = 'producao_on_farm' THEN
      IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'boolean' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,p->k);
    ELSIF k = 'concentracao_ufc_ml' THEN
      IF pg_catalog.jsonb_typeof(p->k)='null' THEN v_out:=v_out||pg_catalog.jsonb_build_object(k,NULL::numeric);
      ELSE
        IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'number' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
        v_num:=(p->>k)::numeric;
        -- Limite alinhado ao front: <= 9007199254740991 (Number.MAX_SAFE_INTEGER) e até 2 casas, sem notação exponencial.
        IF v_num <= 0 OR v_num > 9007199254740991 OR pg_catalog.scale(v_num) > 2 OR (p->>k) ~* 'e' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
        v_out:=v_out||pg_catalog.jsonb_build_object(k,v_num);
      END IF;
    ELSIF v_text ? k THEN
      IF pg_catalog.jsonb_typeof(p->k)='null' THEN v_out:=v_out||pg_catalog.jsonb_build_object(k,NULL::text);
      ELSIF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string' OR pg_catalog.char_length(p->>k) > (v_text->>k)::int THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid';
      ELSE v_out:=v_out||pg_catalog.jsonb_build_object(k,NULLIF(pg_catalog.btrim(p->>k),''));
      END IF;
    ELSE RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid';
    END IF;
  END LOOP;
  IF p_create AND NOT (v_out ? 'nome' AND v_out ? 'tipo' AND v_out ? 'producao_on_farm') THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  IF NOT p_create AND v_out = '{}'::jsonb THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  RETURN v_out;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_actor(p_mode text)
 RETURNS uuid
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_claims jsonb := NULLIF(current_setting('request.jwt.claims', true), '')::jsonb;
  v_org uuid;
BEGIN
  IF v_uid IS NULL OR v_claims IS NULL OR v_claims->>'role' IS DISTINCT FROM 'authenticated'
     OR (v_claims->>'sub') IS DISTINCT FROM v_uid::text
     OR NULLIF(v_claims->>'exp','') IS NULL OR (v_claims->>'exp') !~ '^[0-9]{1,12}$'
     OR to_timestamp((v_claims->>'exp')::bigint) <= now()
     OR (NULLIF(v_claims->>'iat','') IS NOT NULL AND ((v_claims->>'iat') !~ '^[0-9]{1,12}$'
         OR to_timestamp((v_claims->>'iat')::bigint) > now() + interval '60 seconds')) THEN
    RAISE EXCEPTION 'catalog_visibility_auth_required' USING ERRCODE='42501';
  END IF;
  IF public.is_platform_superadmin(v_uid) THEN
    RAISE EXCEPTION 'catalog_visibility_platform_actor_denied' USING ERRCODE='42501';
  END IF;
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL OR NOT EXISTS (SELECT 1 FROM public.organizations o WHERE o.id=v_org AND o.ativo IS TRUE AND o.status='ativa') THEN
    RAISE EXCEPTION 'catalog_visibility_tenant_unavailable' USING ERRCODE='42501';
  END IF;
  IF p_mode IN ('mutate','read_catalog','read_management') AND NOT public._saas_user_has_feature(v_uid, 'catalogo_precos') THEN
    RAISE EXCEPTION 'catalog_visibility_feature_unavailable' USING ERRCODE='42501';
  END IF;
  IF p_mode='mutate' THEN
    IF NOT (platform_private.has_role(v_uid,'administrador'::public.app_role) OR platform_private.has_role(v_uid,'gestor'::public.app_role)) THEN
      RAISE EXCEPTION 'catalog_visibility_role_denied' USING ERRCODE='42501'; END IF;
  ELSIF p_mode='read_catalog' THEN
    IF NOT public.can_view_catalog_internal(v_uid) THEN
      RAISE EXCEPTION 'catalog_visibility_role_denied' USING ERRCODE='42501'; END IF;
  ELSIF p_mode NOT IN ('read_management','read_selection_cultura','read_prefs') OR p_mode IS NULL THEN
    RAISE EXCEPTION 'catalog_visibility_mode_invalid' USING ERRCODE='22023';
  END IF;
  RETURN v_org;
END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_hidden_ids_core(p_entity_type text)
 RETURNS TABLE(entity_id uuid)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid;
BEGIN
  IF p_entity_type IS NULL OR p_entity_type NOT IN ('produto','microrganismo','cultura') THEN
    RAISE EXCEPTION 'catalog_visibility_invalid_payload' USING ERRCODE='22023'; END IF;
  v_org := platform_private.catalog_tenant_actor('read_prefs');
  RETURN QUERY SELECT COALESCE(v.produto_id,v.microrganismo_id,v.cultura_id) FROM public.catalog_tenant_visibility v
   WHERE v.organization_id=v_org AND v.entity_type=p_entity_type AND v.hidden
   ORDER BY 1 LIMIT 301; -- cliente rejeita >300 de forma explícita
END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_read_visibility_core(p_entity_type text, p_ids uuid[])
 RETURNS TABLE(entity_id uuid, hidden boolean, version integer, updated_at timestamp with time zone)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid;
BEGIN
  IF p_entity_type IS NULL OR p_entity_type NOT IN ('produto','microrganismo','cultura') THEN
    RAISE EXCEPTION 'catalog_visibility_invalid_payload' USING ERRCODE='22023'; END IF;
  v_org := platform_private.catalog_tenant_actor(CASE WHEN p_entity_type='cultura' THEN 'read_management' ELSE 'read_catalog' END);
  IF p_ids IS NULL OR cardinality(p_ids) > 500 OR array_position(p_ids, NULL) IS NOT NULL THEN
    RAISE EXCEPTION 'catalog_visibility_invalid_payload' USING ERRCODE='22023'; END IF;
  RETURN QUERY SELECT COALESCE(v.produto_id,v.microrganismo_id,v.cultura_id), v.hidden, v.version, v.updated_at
    FROM public.catalog_tenant_visibility v
   WHERE v.organization_id=v_org AND v.entity_type=p_entity_type
     AND COALESCE(v.produto_id,v.microrganismo_id,v.cultura_id) = ANY(p_ids);
END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_selection_core(p_entity_type text, p_search text, p_limit integer, p_offset integer, p_include_ids uuid[])
 RETURNS TABLE(id uuid, nome text, ativo boolean, hidden boolean, selectable boolean, in_page boolean, total bigint)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_q text := NULLIF(btrim(COALESCE(p_search,'')),'');
BEGIN
  IF p_entity_type IS NULL OR p_entity_type NOT IN ('produto','microrganismo','cultura')
     OR p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 100 OR p_offset IS NULL OR p_offset NOT BETWEEN 0 AND 100000
     OR (v_q IS NOT NULL AND char_length(v_q) > 80)
     OR (p_include_ids IS NOT NULL AND (cardinality(p_include_ids) > 50 OR array_position(p_include_ids, NULL) IS NOT NULL)) THEN
    RAISE EXCEPTION 'catalog_visibility_invalid_payload' USING ERRCODE='22023'; END IF;
  v_org := platform_private.catalog_tenant_actor(CASE WHEN p_entity_type='cultura' THEN 'read_selection_cultura' ELSE 'read_catalog' END);
  RETURN QUERY
  WITH base AS (
    SELECT p.id, p.nome::text AS nome, p.ativo FROM public.produtos p WHERE p_entity_type='produto'
    UNION ALL SELECT m.id, m.nome::text, m.ativo FROM public.microrganismos m WHERE p_entity_type='microrganismo'
    UNION ALL SELECT c.id, c.nome::text, c.ativo FROM public.culturas c WHERE p_entity_type='cultura'
  ), marked AS (
    SELECT b.*, COALESCE(v.hidden,false) AS hidden FROM base b
      LEFT JOIN public.catalog_tenant_visibility v ON v.organization_id=v_org AND v.entity_type=p_entity_type
       AND COALESCE(v.produto_id,v.microrganismo_id,v.cultura_id)=b.id
  ), page AS (
    SELECT m.*, count(*) OVER () AS total FROM marked m
     WHERE m.ativo IS TRUE AND m.hidden IS FALSE
       AND (v_q IS NULL OR m.nome ILIKE '%' || replace(replace(replace(v_q,'\','\\'),'%','\%'),'_','\_') || '%')
     ORDER BY m.nome, m.id LIMIT p_limit OFFSET p_offset
  )
  SELECT pg.id, pg.nome, pg.ativo, pg.hidden, true, true, pg.total FROM page pg
  UNION ALL
  SELECT m.id, m.nome, m.ativo, m.hidden, (m.ativo IS TRUE AND m.hidden IS FALSE), false, NULL::bigint FROM marked m
   WHERE p_include_ids IS NOT NULL AND m.id = ANY(p_include_ids) AND m.id NOT IN (SELECT pg2.id FROM page pg2);
END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_set_visibility_core(p_entity_type text, p_entity_id uuid, p_hidden boolean, p_expected_version integer, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_org uuid;
  v_reason text := btrim(COALESCE(p_reason,''));
  v_hash text;
  v_prev public.catalog_tenant_visibility%ROWTYPE;
  v_ledger public.catalog_tenant_visibility_ledger%ROWTYPE;
  v_ativo boolean;
  v_new_version integer;
  v_result jsonb;
BEGIN
  v_org := platform_private.catalog_tenant_actor('mutate');
  IF p_entity_type IS NULL OR p_entity_type NOT IN ('produto','microrganismo','cultura') OR p_entity_id IS NULL
     OR p_hidden IS NULL OR p_idempotency_key IS NULL OR p_expected_version IS NULL OR p_expected_version < 0 THEN
    RAISE EXCEPTION 'catalog_visibility_invalid_payload' USING ERRCODE='22023'; END IF;
  IF char_length(v_reason) NOT BETWEEN 5 AND 500 THEN
    RAISE EXCEPTION 'catalog_visibility_reason_required' USING ERRCODE='22023'; END IF;
  v_hash := md5(concat_ws('|', p_entity_type, p_entity_id::text, p_hidden::text, p_expected_version::text, v_reason));

  -- Ordem fixa de locks: (1) ator+empresa+chave — serializa replay/conflito da MESMA chave mesmo em itens
  -- distintos; (2) empresa+item — serializa primeira gravação/CAS. Sempre nesta ordem (sem deadlock cruzado).
  PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','ctvk',v_uid::text,v_org::text,p_idempotency_key::text),0));
  PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','ctv',v_org::text,p_entity_type,p_entity_id::text),0));

  SELECT * INTO v_ledger FROM public.catalog_tenant_visibility_ledger
   WHERE actor_id=v_uid AND organization_id=v_org AND idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF v_ledger.payload_hash <> v_hash THEN
      RAISE EXCEPTION 'catalog_visibility_idempotency_conflict' USING ERRCODE='22023'; END IF;
    RETURN v_ledger.result || jsonb_build_object('replayed', true);
  END IF;

  -- Item global existente; inativo não pode ser exibido (preferência não reativa).
  IF p_entity_type='produto' THEN SELECT ativo INTO v_ativo FROM public.produtos WHERE id=p_entity_id;
  ELSIF p_entity_type='microrganismo' THEN SELECT ativo INTO v_ativo FROM public.microrganismos WHERE id=p_entity_id;
  ELSE SELECT ativo INTO v_ativo FROM public.culturas WHERE id=p_entity_id; END IF;
  IF NOT FOUND THEN RAISE EXCEPTION 'catalog_visibility_item_not_found' USING ERRCODE='P0002'; END IF;
  IF v_ativo IS NOT TRUE AND p_hidden IS FALSE THEN
    RAISE EXCEPTION 'catalog_visibility_item_inactive' USING ERRCODE='22023'; END IF;

  SELECT * INTO v_prev FROM public.catalog_tenant_visibility
   WHERE organization_id=v_org AND entity_type=p_entity_type
     AND COALESCE(produto_id,microrganismo_id,cultura_id)=p_entity_id FOR UPDATE;
  IF COALESCE(v_prev.version,0) <> p_expected_version THEN
    RAISE EXCEPTION 'catalog_visibility_version_conflict' USING ERRCODE='PT409'; END IF;
  IF v_prev.id IS NOT NULL AND v_prev.hidden = p_hidden THEN
    RAISE EXCEPTION 'catalog_visibility_no_change' USING ERRCODE='22023'; END IF;
  IF v_prev.id IS NULL AND p_hidden IS FALSE THEN
    RAISE EXCEPTION 'catalog_visibility_no_change' USING ERRCODE='22023'; END IF;

  v_new_version := p_expected_version + 1;
  IF v_prev.id IS NULL THEN
    INSERT INTO public.catalog_tenant_visibility(organization_id,entity_type,produto_id,microrganismo_id,cultura_id,hidden,version,reason,updated_by)
    VALUES (v_org,p_entity_type,
      CASE WHEN p_entity_type='produto' THEN p_entity_id END,
      CASE WHEN p_entity_type='microrganismo' THEN p_entity_id END,
      CASE WHEN p_entity_type='cultura' THEN p_entity_id END,
      p_hidden,v_new_version,v_reason,v_uid);
  ELSE
    UPDATE public.catalog_tenant_visibility SET hidden=p_hidden, version=v_new_version, reason=v_reason,
      updated_by=v_uid, updated_at=now()
     WHERE id=v_prev.id AND version=p_expected_version;
    IF NOT FOUND THEN RAISE EXCEPTION 'catalog_visibility_version_conflict' USING ERRCODE='PT409'; END IF;
  END IF;

  v_result := jsonb_build_object('entity_type',p_entity_type,'entity_id',p_entity_id,'hidden',p_hidden,
    'version',v_new_version,'replayed',false);
  INSERT INTO public.catalog_tenant_visibility_ledger(organization_id,actor_id,idempotency_key,payload_hash,entity_type,entity_id,
    before_state,after_state,reason,result)
  VALUES (v_org,v_uid,p_idempotency_key,v_hash,p_entity_type,p_entity_id,
    CASE WHEN v_prev.id IS NULL THEN NULL ELSE jsonb_build_object('hidden',v_prev.hidden,'version',v_prev.version) END,
    jsonb_build_object('hidden',p_hidden,'version',v_new_version),v_reason,v_result);
  RETURN v_result;
END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_tenant_visibility_ledger_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
BEGIN RAISE EXCEPTION 'catalog_visibility_ledger_immutable' USING ERRCODE='42501'; END; $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_touch_version()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
BEGIN
  NEW.updated_at := GREATEST(pg_catalog.clock_timestamp(), OLD.updated_at + interval '1 microsecond');
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_visit_reference_guard_current12()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_id uuid; v_col text; v_ok boolean;
BEGIN
 v_org:=platform_private.catalog_tenant_actor('read_prefs');
 IF NOT COALESCE(public.can_view_technical_visit(auth.uid(),NEW.registro_consultor_id),false) THEN
  RAISE EXCEPTION 'sem_permissao' USING ERRCODE='42501'; END IF;
 IF TG_OP='UPDATE' AND OLD.registro_consultor_id IS DISTINCT FROM NEW.registro_consultor_id
  AND NOT COALESCE(public.can_view_technical_visit(auth.uid(),OLD.registro_consultor_id),false) THEN
  RAISE EXCEPTION 'sem_permissao' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.registros_consultor WHERE id=NEW.registro_consultor_id FOR UPDATE;
 IF NOT COALESCE(public.can_view_technical_visit(auth.uid(),NEW.registro_consultor_id),false) THEN
  RAISE EXCEPTION 'sem_permissao' USING ERRCODE='42501'; END IF;
 PERFORM public._assert_visita_editavel(NEW.registro_consultor_id);
 FOR v_col IN SELECT unnest(ARRAY['produto_biologico_sugerido_id','microrganismo_id']) LOOP
  IF TG_OP='UPDATE' AND NEW.registro_consultor_id=OLD.registro_consultor_id
   AND to_jsonb(NEW)->>v_col IS NOT DISTINCT FROM to_jsonb(OLD)->>v_col THEN CONTINUE; END IF;
  v_id:=NULLIF(to_jsonb(NEW)->>v_col,'')::uuid;
  IF v_id IS NULL THEN CONTINUE; END IF;
  IF v_col='microrganismo_id' THEN
   SELECT EXISTS(SELECT 1 FROM public.microrganismos m WHERE m.id=v_id AND m.ativo AND to_jsonb(m)->>'owner_organization_id' IS NULL) INTO v_ok;
  ELSE
   SELECT EXISTS(SELECT 1 FROM public.produtos p WHERE p.id=v_id AND p.ativo AND to_jsonb(p)->>'owner_organization_id' IS NULL) INTO v_ok;
  END IF;
  IF NOT v_ok OR EXISTS(SELECT 1 FROM public.catalog_tenant_visibility v WHERE v.organization_id=v_org
   AND v.entity_type=CASE WHEN v_col='microrganismo_id' THEN 'microrganismo' ELSE 'produto' END
   AND COALESCE(v.produto_id,v.microrganismo_id)=v_id AND v.hidden) THEN
   RAISE EXCEPTION 'catalog_visit_item_unavailable' USING ERRCODE='42501'; END IF;
 END LOOP;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_assert_row(p_id uuid, p_tipo text, p_item uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE r public.catalogo_volumes%ROWTYPE;
BEGIN
  SELECT * INTO r FROM public.catalogo_volumes WHERE id=p_id;
  IF NOT FOUND OR r.item_tipo IS DISTINCT FROM p_tipo OR COALESCE(r.produto_id,r.microrganismo_id) IS DISTINCT FROM p_item
    OR r.moeda IS DISTINCT FROM 'BRL'
    OR r.preco_litro_brl IS DISTINCT FROM pg_catalog.round(r.preco_brl/(r.volume_ml/1000.0),2)
    OR r.valor_dose_100ml_brl IS DISTINCT FROM pg_catalog.round(r.preco_litro_brl/10.0,2)
    OR r.doses_por_volume IS DISTINCT FROM pg_catalog.round(r.volume_ml/100.0,4) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_confirmation_failed'; END IF;
  -- Duplicidade: no máximo uma apresentação ATIVA por pai e volume.
  IF r.ativo AND EXISTS (SELECT 1 FROM public.catalogo_volumes o WHERE o.id<>r.id AND o.ativo AND o.volume_ml=r.volume_ml
      AND o.item_tipo=r.item_tipo AND o.produto_id IS NOT DISTINCT FROM r.produto_id AND o.microrganismo_id IS NOT DISTINCT FROM r.microrganismo_id) THEN
    RAISE EXCEPTION USING ERRCODE='23505', MESSAGE='catalog_volume_duplicate'; END IF;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_dec(p jsonb)
 RETURNS jsonb
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
  SELECT CASE WHEN p IS NULL OR pg_catalog.jsonb_typeof(p)='null' THEN 'null'::jsonb
    WHEN pg_catalog.jsonb_typeof(p)='number' THEN pg_catalog.to_jsonb(p#>>'{}')
    ELSE NULL END;  -- tipo inesperado => NULL SQL => objeto inválido detectado pelo chamador
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_normalize(p jsonb, p_create boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 IMMUTABLE
 SET search_path TO ''
AS $function$
DECLARE k text; v_out jsonb:='{}'::jsonb; v_num numeric; v_int numeric;
BEGIN
  IF p IS NULL OR pg_catalog.jsonb_typeof(p) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  FOR k IN SELECT pg_catalog.jsonb_object_keys(p) LOOP
    IF k = 'volume_ml' THEN
      IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string' OR (p->>k) !~ '^[0-9]{1,7}(\.[0-9]{1,3})?$' THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_num:=(p->>k)::numeric;
      IF v_num <= 0 OR v_num > 1000000 THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,v_num);
    ELSIF k = 'preco_brl' THEN
      IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string' OR (p->>k) !~ '^[0-9]{1,9}(\.[0-9]{1,2})?$' THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_num:=(p->>k)::numeric;
      -- > 0: preço zero ativo faria o sync anular o pai; preço desconhecido não é cadastrado.
      IF v_num <= 0 THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,v_num);
    ELSIF k = 'rotulo' THEN
      IF pg_catalog.jsonb_typeof(p->k)='null' THEN v_out:=v_out||pg_catalog.jsonb_build_object(k,NULL::text);
      ELSIF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'string' OR pg_catalog.char_length(pg_catalog.btrim(p->>k)) > 60 THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid';
      ELSE v_out:=v_out||pg_catalog.jsonb_build_object(k,NULLIF(pg_catalog.btrim(p->>k),''));
      END IF;
    ELSIF k = 'ordem' THEN
      IF pg_catalog.jsonb_typeof(p->k) IS DISTINCT FROM 'number' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_int:=(p->>k)::numeric;
      IF v_int <> pg_catalog.trunc(v_int) OR v_int < 0 OR v_int > 9999 THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
      v_out:=v_out||pg_catalog.jsonb_build_object(k,v_int::int);
    ELSE RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid';
    END IF;
  END LOOP;
  IF p_create AND NOT (v_out ? 'volume_ml' AND v_out ? 'preco_brl') THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  IF NOT p_create AND v_out = '{}'::jsonb THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  RETURN v_out;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_parent(p_tipo text, p_id uuid, p_lock boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v jsonb;
BEGIN
  IF p_id IS NULL OR p_tipo IS NULL OR p_tipo NOT IN ('produto','microrganismo') THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  IF p_tipo='produto' THEN
    IF p_lock THEN SELECT pg_catalog.to_jsonb(x) INTO v FROM public.produtos x WHERE x.id=p_id FOR UPDATE;
    ELSE SELECT pg_catalog.to_jsonb(x) INTO v FROM public.produtos x WHERE x.id=p_id; END IF;
  ELSE
    IF p_lock THEN SELECT pg_catalog.to_jsonb(x) INTO v FROM public.microrganismos x WHERE x.id=p_id FOR UPDATE;
    ELSE SELECT pg_catalog.to_jsonb(x) INTO v FROM public.microrganismos x WHERE x.id=p_id; END IF;
  END IF;
  IF v IS NULL THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_volume_unavailable'; END IF;
  RETURN v;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_preview_token(p_actor uuid, p_operation text, p_id uuid, p_change jsonb, p_reason text, p_row_version timestamp with time zone, p_tipo text, p_item uuid, p_parent jsonb)
 RETURNS text
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(pg_catalog.jsonb_build_object(
    'v',1,'actor',p_actor,'operation',p_operation,'id',p_id,'change',p_change,'reason',pg_catalog.btrim(p_reason),
    'row_version',p_row_version,'parent',p_parent,
    'siblings',(SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_array(o.id,o.updated_at,o.ativo,o.volume_ml::text,o.preco_brl::text)
        ORDER BY o.id),'[]'::jsonb)
      FROM public.catalogo_volumes o WHERE o.item_tipo=p_tipo AND COALESCE(o.produto_id,o.microrganismo_id)=p_item AND o.id<>p_id)
  )::text,'UTF8')),'hex');
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_pricing(p_parent jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 IMMUTABLE
 SET search_path TO ''
AS $function$
DECLARE l jsonb:=platform_private.catalog_volume_dec(p_parent->'valor_litro_brl');
  d jsonb:=platform_private.catalog_volume_dec(p_parent->'valor_dose_brl');
  h jsonb:=platform_private.catalog_volume_dec(p_parent->'valor_ha_brl');
BEGIN
  IF l IS NULL OR d IS NULL OR h IS NULL THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_pricing_unexpected'; END IF;
  RETURN pg_catalog.jsonb_build_object('valor_litro_brl',l,'valor_dose_brl',d,'valor_ha_brl',h,'updated_at',p_parent->'updated_at');
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_row(p_id uuid)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT pg_catalog.jsonb_build_object('id',v.id,'item_tipo',v.item_tipo,'item_id',COALESCE(v.produto_id,v.microrganismo_id),
    'volume_ml',v.volume_ml::text,'rotulo',v.rotulo,'preco_brl',v.preco_brl::text,'moeda',v.moeda,'ativo',v.ativo,'ordem',v.ordem,
    'preco_litro_brl',v.preco_litro_brl::text,'valor_dose_100ml_brl',v.valor_dose_100ml_brl::text,'doses_por_volume',v.doses_por_volume::text,
    'updated_at',v.updated_at)
  FROM public.catalogo_volumes v WHERE v.id=p_id;
$function$;
CREATE OR REPLACE FUNCTION platform_private.catalog_volume_settle(p_tipo text, p_item uuid, p_before jsonb, p_touches_active boolean, p_confirmed boolean, p_allow_reprice boolean, p_token text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_after jsonb; v_strip text[]:=ARRAY['valor_litro_brl','valor_dose_brl','valor_ha_brl','updated_at'];
  v_pb jsonb; v_pa jsonb; v_repriced boolean;
BEGIN
  v_after:=platform_private.catalog_volume_parent(p_tipo,p_item,false);
  IF (v_after - v_strip) IS DISTINCT FROM (p_before - v_strip) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_parent_protected_changed'; END IF;
  v_pb:=platform_private.catalog_volume_pricing(p_before); v_pa:=platform_private.catalog_volume_pricing(v_after);
  v_repriced:=(v_pb - 'updated_at') IS DISTINCT FROM (v_pa - 'updated_at');
  IF v_repriced AND NOT p_allow_reprice THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_unexpected_repricing'; END IF;
  IF (p_touches_active OR v_repriced) AND NOT COALESCE(p_confirmed,false) THEN
    IF p_token IS NULL THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_confirmation_failed'; END IF;
    RAISE EXCEPTION USING ERRCODE='55000', MESSAGE='catalog_volume_confirmation_required',
      DETAIL=pg_catalog.jsonb_build_object('token',p_token,'repriced',v_repriced,
        'parent_before',v_pb - 'updated_at','parent_after',v_pa - 'updated_at')::text;
  END IF;
  RETURN pg_catalog.jsonb_build_object('repriced',v_repriced,'parent_before',v_pb,'parent_after',v_pa);
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.change_global_volume(p_operation text, p_id uuid, p_expected_updated_at timestamp with time zone, p_patch jsonb, p_ativo boolean, p_confirm_token text, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v jsonb; v_req jsonb; v_replay jsonb; v_tipo text; v_item uuid; v_parent jsonb; v_token text;
  v_old public.catalogo_volumes%ROWTYPE; v_before jsonb; v_settle jsonb; v_row jsonb; v_receipt jsonb; v_n int;
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
    OR (p_confirm_token IS NOT NULL AND p_confirm_token !~ '^[0-9a-f]{64}$')
    OR (p_operation='set_global_volume_status' AND p_ativo IS NULL) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  IF p_operation='update_global_volume' THEN v:=platform_private.catalog_volume_normalize(p_patch,false);
  ELSIF p_operation='set_global_volume_status' THEN v:=pg_catalog.jsonb_build_object('ativo',p_ativo);
  ELSE RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  v_req:=pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,'change',v,'confirm_token',p_confirm_token,
    'reason',pg_catalog.btrim(p_reason));
  -- Replay idempotente (mesma chave + mesmo pedido, incluindo token) devolve o recibo original, mesmo que o estado tenha mudado.
  v_replay:=platform_private.catalog_entity_replay(v_actor,p_operation,v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;
  SELECT item_tipo, COALESCE(produto_id,microrganismo_id) INTO v_tipo, v_item FROM public.catalogo_volumes WHERE id=p_id;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_volume_unavailable'; END IF;
  v_parent:=platform_private.catalog_volume_parent(v_tipo,v_item,true);   -- lock do pai antes da linha (serializa irmãs)
  SELECT * INTO v_old FROM public.catalogo_volumes WHERE id=p_id FOR UPDATE;
  IF NOT FOUND OR v_old.item_tipo IS DISTINCT FROM v_tipo OR COALESCE(v_old.produto_id,v_old.microrganismo_id) IS DISTINCT FROM v_item THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_conflict'; END IF;
  IF v_old.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_conflict'; END IF;
  IF p_operation='set_global_volume_status' AND v_old.ativo = p_ativo THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_conflict'; END IF;
  -- Token recalculado sob lock do pai, ANTES da mutação. Token enviado e divergente => prévia desatualizada.
  v_token:=platform_private.catalog_volume_preview_token(v_actor,p_operation,p_id,v,p_reason,v_old.updated_at,v_tipo,v_item,v_parent);
  IF p_confirm_token IS NOT NULL AND p_confirm_token IS DISTINCT FROM v_token THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_preview_stale'; END IF;
  v_before:=platform_private.catalog_volume_row(p_id);
  -- Overflow em derivados ou na coluna de preço do pai (limite depende do tipo do pai e da dose/ha reais) =>
  -- 22003 de domínio; a transação inteira é revertida (linha, pai e ledger intactos). 55000/40001 passam inalterados.
  BEGIN
  UPDATE public.catalogo_volumes SET
    volume_ml=CASE WHEN v ? 'volume_ml' THEN (v->>'volume_ml')::numeric ELSE volume_ml END,
    preco_brl=CASE WHEN v ? 'preco_brl' THEN (v->>'preco_brl')::numeric ELSE preco_brl END,
    rotulo=CASE WHEN v ? 'rotulo' THEN v->>'rotulo' ELSE rotulo END,
    ordem=CASE WHEN v ? 'ordem' THEN (v->>'ordem')::int ELSE ordem END,
    ativo=CASE WHEN v ? 'ativo' THEN (v->>'ativo')::boolean ELSE ativo END
  WHERE id=p_id AND updated_at=p_expected_updated_at;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  IF v_n <> 1 THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_conflict'; END IF;
  PERFORM platform_private.catalog_volume_assert_row(p_id,v_tipo,v_item);
  v_row:=platform_private.catalog_volume_row(p_id);
  IF (v_row->>'updated_at')::timestamptz <= v_old.updated_at THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_volume_confirmation_failed'; END IF;
  -- Toca linha ativa (antes ou depois) ou reprecifica o pai => sem token: 55000 com prévia (rollback integral);
  -- com token válido (já conferido acima): segue.
  v_settle:=platform_private.catalog_volume_settle(v_tipo,v_item,v_parent,v_old.ativo OR (v_row->>'ativo')::boolean,
    p_confirm_token IS NOT NULL,true,v_token);
  EXCEPTION WHEN numeric_value_out_of_range THEN
    RAISE EXCEPTION USING ERRCODE='22003', MESSAGE='catalog_volume_price_out_of_range';
  END;
  v_receipt:=pg_catalog.jsonb_build_object('id',p_id,'item_tipo',v_tipo,'item_id',v_item,'ativo',(v_row->>'ativo')::boolean,
    'updated_at',v_row->'updated_at','repriced',v_settle->'repriced','idempotency_key',p_idempotency_key,'audit_id',gen_random_uuid(),'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,p_operation,p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('volume',v_before,'parent',v_settle->'parent_before'),
    pg_catalog.jsonb_build_object('volume',v_row,'parent',v_settle->'parent_after'));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.create_global_microorganism_core(p_payload jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v jsonb; v_req jsonb; v_replay jsonb; v_new public.microrganismos%ROWTYPE; v_receipt jsonb; v_after jsonb;
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  v:=platform_private.catalog_micro_normalize(p_payload,true);
  v_req:=pg_catalog.jsonb_build_object('payload',v,'reason',pg_catalog.btrim(p_reason));
  v_replay:=platform_private.catalog_entity_replay(v_actor,'create_global_microorganism',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;
  -- Novo item INATIVO, fora do B2B, sem preço/dose/safra/produto; código pelo trigger do servidor.
  BEGIN
    INSERT INTO public.microrganismos (nome,tipo,nome_cientifico,concentracao_ufc_ml,concentracao_label,fornecedor,producao_on_farm,
      meio_cultivo,funcao_agronomica,observacoes,descricao,ativo,b2b_enabled,codigo,dose_ml_ha,valor_dose_brl,valor_litro_brl,preco_tabela,
      safra_referencia,product_id)
    VALUES (v->>'nome',(v->>'tipo')::public.tipo_microrganismo,v->>'nome_cientifico',(v->>'concentracao_ufc_ml')::numeric,v->>'concentracao_label',
      v->>'fornecedor',(v->>'producao_on_farm')::boolean,v->>'meio_cultivo',v->>'funcao_agronomica',v->>'observacoes',v->>'descricao',
      false,false,NULL,NULL,NULL,NULL,NULL,NULL,NULL)
    RETURNING * INTO v_new;
  EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION USING ERRCODE='23505', MESSAGE='catalog_entity_duplicate';
  END;
  IF v_new.id IS NULL OR v_new.codigo IS NULL OR v_new.ativo OR v_new.b2b_enabled OR v_new.valor_dose_brl IS NOT NULL
    OR v_new.dose_ml_ha IS NOT NULL OR v_new.safra_referencia IS NOT NULL
    OR v_new.valor_litro_brl IS NOT NULL OR v_new.preco_tabela IS NOT NULL OR v_new.product_id IS NOT NULL THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_confirmation_failed'; END IF;
  v_after:=platform_private.read_global_microorganism_detail_core(v_new.id);
  v_receipt:=pg_catalog.jsonb_build_object('id',v_new.id,'codigo',v_new.codigo,'ativo',false,'updated_at',v_new.updated_at,
    'idempotency_key',p_idempotency_key,'audit_id',gen_random_uuid(),'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'create_global_microorganism',p_reason,p_idempotency_key,v_req,v_receipt,'{}'::jsonb,v_after);
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.create_global_product_core(p_payload jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_actor uuid; v_existing public.catalog_platform_admin_audit%ROWTYPE;
  v_new public.produtos%ROWTYPE; v_request jsonb; v_receipt jsonb; v_audit uuid:=gen_random_uuid();
  v_key text; v_item jsonb; v_comp jsonb:='[]'::jsonb; v_ids uuid[]:='{}';
  v_snapshot jsonb; v_dose numeric; v_vol numeric; v_prop numeric; v_micro uuid; v_count int;
  v_allowed constant text[]:=ARRAY['nome','tipo','descricao','modo_acao','funcao_completa','modo_aplicacao','dose_ml_ha','composicao'];
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_idempotency_key IS NULL OR p_reason IS NULL
    OR pg_catalog.char_length(pg_catalog.btrim(p_reason)) NOT BETWEEN 10 AND 500
    OR p_payload IS NULL OR pg_catalog.jsonb_typeof(p_payload) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
  END IF;
  -- Só depois de provar 'object' chamamos jsonb_object_keys (arrays/escalares abortariam com erro genérico).
  FOR v_key IN SELECT pg_catalog.jsonb_object_keys(p_payload) LOOP
    IF NOT (v_key=ANY(v_allowed)) THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid'; END IF;
  END LOOP;
  IF pg_catalog.jsonb_typeof(p_payload->'nome') IS DISTINCT FROM 'string'
    OR pg_catalog.char_length(pg_catalog.btrim(p_payload->>'nome')) NOT BETWEEN 1 AND 500
    OR pg_catalog.jsonb_typeof(p_payload->'tipo') IS DISTINCT FROM 'string'
    OR NOT ((p_payload->>'tipo') = ANY(pg_catalog.enum_range(NULL::public.tipo_produto)::text[])) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
  END IF;
  FOREACH v_key IN ARRAY ARRAY['descricao','modo_acao','funcao_completa','modo_aplicacao'] LOOP
    IF p_payload ? v_key AND (pg_catalog.jsonb_typeof(p_payload->v_key) IS DISTINCT FROM 'string'
      AND pg_catalog.jsonb_typeof(p_payload->v_key) IS DISTINCT FROM 'null'
      OR pg_catalog.char_length(p_payload->>v_key) > 10000) THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
    END IF;
  END LOOP;
  -- Dose: número JSON finito (JSON não representa NaN/Infinity), 0 < d <= 1e6, até 6 casas.
  IF p_payload ? 'dose_ml_ha' AND pg_catalog.jsonb_typeof(p_payload->'dose_ml_ha') IS DISTINCT FROM 'null' THEN
    IF pg_catalog.jsonb_typeof(p_payload->'dose_ml_ha') IS DISTINCT FROM 'number' THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid'; END IF;
    v_dose:=(p_payload->>'dose_ml_ha')::numeric;
    IF v_dose <= 0 OR v_dose > 1000000 OR pg_catalog.scale(v_dose) > 6 THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
    END IF;
  END IF;
  IF p_payload ? 'composicao' THEN
    IF pg_catalog.jsonb_typeof(p_payload->'composicao') IS DISTINCT FROM 'array' THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
    END IF;
    IF pg_catalog.jsonb_array_length(p_payload->'composicao') > 50 THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
    END IF;
    FOR v_item IN SELECT * FROM pg_catalog.jsonb_array_elements(p_payload->'composicao') LOOP
      -- Objeto primeiro (curto-circuito explícito), depois chaves e tipos com IS DISTINCT FROM (NULL/ausente = inválido).
      IF pg_catalog.jsonb_typeof(v_item) IS DISTINCT FROM 'object' THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
      END IF;
      IF EXISTS (SELECT 1 FROM pg_catalog.jsonb_object_keys(v_item) k WHERE k NOT IN ('microrganismo_id','volume_ml','proporcao'))
        OR pg_catalog.jsonb_typeof(v_item->'microrganismo_id') IS DISTINCT FROM 'string'
        OR (v_item->>'microrganismo_id') IS NULL
        OR (v_item->>'microrganismo_id') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        OR pg_catalog.jsonb_typeof(v_item->'volume_ml') IS DISTINCT FROM 'number'
        OR (v_item ? 'proporcao' AND pg_catalog.jsonb_typeof(v_item->'proporcao') IS DISTINCT FROM 'number'
            AND pg_catalog.jsonb_typeof(v_item->'proporcao') IS DISTINCT FROM 'null') THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
      END IF;
      v_micro:=(v_item->>'microrganismo_id')::uuid; v_vol:=(v_item->>'volume_ml')::numeric;
      v_prop:=CASE WHEN pg_catalog.jsonb_typeof(v_item->'proporcao')='number' THEN (v_item->>'proporcao')::numeric END;
      IF v_vol IS NULL OR v_micro=ANY(v_ids) OR v_vol <= 0 OR v_vol > 1000000 OR pg_catalog.scale(v_vol) > 6
        OR (v_prop IS NOT NULL AND (v_prop <= 0 OR v_prop > 100 OR pg_catalog.scale(v_prop) > 6)) THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid';
      END IF;
      v_ids:=v_ids||v_micro;
      v_comp:=v_comp||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object('microrganismo_id',v_micro,'volume_ml',v_vol,'proporcao',v_prop));
    END LOOP;
  END IF;
  v_request:=pg_catalog.jsonb_build_object('payload',(p_payload-'composicao')||pg_catalog.jsonb_build_object(
    'nome',pg_catalog.btrim(p_payload->>'nome'),'composicao',v_comp),'reason',pg_catalog.btrim(p_reason));

  PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('catalog-metadata:'||p_idempotency_key::text,0));
  SELECT * INTO v_existing FROM public.catalog_platform_admin_audit WHERE correlation_id=p_idempotency_key;
  IF FOUND THEN
    IF v_existing.operation<>'create_global_product' OR v_existing.actor_id<>v_actor
      OR v_existing.counts_after->'request' IS DISTINCT FROM v_request THEN
      RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_create_conflict';
    END IF;
    RETURN (v_existing.counts_after->'receipt')||pg_catalog.jsonb_build_object('idempotent',true);
  END IF;
  -- Microrganismos referenciados devem existir; lock compartilhado evita remoção concorrente.
  -- FOR SHARE bloqueia UPDATE concorrente (inclusive de ativo) até o fim da transação;
  -- só microrganismos ATIVOS entram em novas composições. Históricas não são tocadas.
  SELECT count(*) INTO v_count FROM (SELECT 1 FROM public.microrganismos WHERE id=ANY(v_ids) AND ativo IS TRUE FOR SHARE) s;
  IF v_count <> pg_catalog.cardinality(v_ids) THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_create_invalid'; END IF;

  -- Novo item nasce INATIVO e fora do B2B; preços NULL (motor canônico decide depois);
  -- código NULL → trigger set_codigo_produto/proximo_codigo (upsert serializado).
  INSERT INTO public.produtos (nome,tipo,descricao,modo_acao,funcao_completa,modo_aplicacao,dose_ml_ha,
    ativo,b2b_enabled,codigo,valor_dose_brl,valor_litro_brl,valor_ha_brl)
  VALUES (pg_catalog.btrim(p_payload->>'nome'),(p_payload->>'tipo')::public.tipo_produto,
    p_payload->>'descricao',p_payload->>'modo_acao',p_payload->>'funcao_completa',p_payload->>'modo_aplicacao',
    v_dose,false,false,NULL,NULL,NULL,NULL)
  RETURNING * INTO v_new;
  IF v_new.id IS NULL OR v_new.codigo IS NULL OR v_new.ativo IS DISTINCT FROM false OR v_new.b2b_enabled
    OR v_new.valor_dose_brl IS NOT NULL OR v_new.valor_litro_brl IS NOT NULL OR v_new.valor_ha_brl IS NOT NULL THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_create_confirmation_failed';
  END IF;
  INSERT INTO public.formulacoes (produto_id,microrganismo_id,volume_ml,proporcao,e_volume_fixo,unidade)
  SELECT v_new.id,(c->>'microrganismo_id')::uuid,(c->>'volume_ml')::numeric,
    CASE WHEN c->>'proporcao' IS NULL THEN NULL ELSE (c->>'proporcao')::numeric END,true,'mL'
  FROM pg_catalog.jsonb_array_elements(v_comp) c;
  GET DIAGNOSTICS v_count = ROW_COUNT;
  IF v_count <> pg_catalog.jsonb_array_length(v_comp) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_create_confirmation_failed';
  END IF;
  -- Snapshot canônico relido do banco na mesma transação (produto + formulações com IDs).
  SELECT pg_catalog.jsonb_build_object('produto',pg_catalog.to_jsonb(p) - ARRAY['created_at'],
    'formulacoes',COALESCE((SELECT pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('id',f.id,'microrganismo_id',f.microrganismo_id,
      'volume_ml',f.volume_ml,'proporcao',f.proporcao,'e_volume_fixo',f.e_volume_fixo,'unidade',f.unidade) ORDER BY f.id)
      FROM public.formulacoes f WHERE f.produto_id=p.id),'[]'::jsonb))
  INTO v_snapshot FROM public.produtos p WHERE p.id=v_new.id;
  IF v_snapshot IS NULL OR pg_catalog.jsonb_array_length(v_snapshot->'formulacoes') <> v_count
    OR (v_snapshot->'produto'->>'ativo')::boolean IS DISTINCT FROM false
    OR (v_snapshot->'produto'->>'b2b_enabled')::boolean IS DISTINCT FROM false THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_create_confirmation_failed';
  END IF;
  v_receipt:=pg_catalog.jsonb_build_object('id',v_new.id,'codigo',v_new.codigo,'updated_at',v_new.updated_at,
    'composicao_count',v_count,'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  INSERT INTO public.catalog_platform_admin_audit (id,operation,actor_id,reason,correlation_id,status,counts_before,counts_after,completed_at)
  VALUES (v_audit,'create_global_product',v_actor,pg_catalog.btrim(p_reason),p_idempotency_key,'completed','{}'::jsonb,
    pg_catalog.jsonb_build_object('request',v_request,'receipt',v_receipt,'after',v_snapshot),pg_catalog.clock_timestamp());
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.create_global_volume_core(p_item_tipo text, p_item_id uuid, p_payload jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v jsonb; v_req jsonb; v_replay jsonb; v_before jsonb; v_settle jsonb; v_id uuid; v_row jsonb; v_receipt jsonb;
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  v:=platform_private.catalog_volume_normalize(p_payload,true);
  v_req:=pg_catalog.jsonb_build_object('item_tipo',p_item_tipo,'item_id',p_item_id,'payload',v,'reason',pg_catalog.btrim(p_reason));
  v_replay:=platform_private.catalog_entity_replay(v_actor,'create_global_volume',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;
  v_before:=platform_private.catalog_volume_parent(p_item_tipo,p_item_id,true);
  -- Overflow de derivados/preços do pai (p.ex. numeric(10,2) histórico) = rejeição de domínio atômica (sem ampliar tipos).
  BEGIN
  INSERT INTO public.catalogo_volumes (item_tipo,produto_id,microrganismo_id,volume_ml,rotulo,preco_brl,moeda,ativo,ordem)
  VALUES (p_item_tipo, CASE WHEN p_item_tipo='produto' THEN p_item_id END, CASE WHEN p_item_tipo='microrganismo' THEN p_item_id END,
    (v->>'volume_ml')::numeric, v->>'rotulo', (v->>'preco_brl')::numeric, 'BRL', false, COALESCE((v->>'ordem')::int,0))
  RETURNING id INTO v_id;
  PERFORM platform_private.catalog_volume_assert_row(v_id,p_item_tipo,p_item_id);
  -- Nasce inativa: qualquer alteração no pai é falha (não apaga preço legado silenciosamente).
  v_settle:=platform_private.catalog_volume_settle(p_item_tipo,p_item_id,v_before,false,false,false,NULL);
  EXCEPTION WHEN numeric_value_out_of_range THEN
    RAISE EXCEPTION USING ERRCODE='22003', MESSAGE='catalog_volume_price_out_of_range';
  END;
  v_row:=platform_private.catalog_volume_row(v_id);
  v_receipt:=pg_catalog.jsonb_build_object('id',v_id,'item_tipo',p_item_tipo,'item_id',p_item_id,'ativo',false,'updated_at',v_row->'updated_at',
    'repriced',false,'idempotency_key',p_idempotency_key,'audit_id',gen_random_uuid(),'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'create_global_volume',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('volume','{}'::jsonb,'parent',v_settle->'parent_before'),
    pg_catalog.jsonb_build_object('volume',v_row,'parent',v_settle->'parent_after'));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.delivery_actor_20261030(p_action text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'DELIVERY_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor','consultor_tecnico','aplicador','operador_onfarm','superadmin'))
 OR EXISTS(SELECT 1 FROM public.partner_users WHERE user_id=auth.uid() AND revoked_at IS NULL AND (valid_from IS NULL OR valid_from<=pg_catalog.now()))
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=auth.uid() AND (role IN ('administrador','gestor') OR (p_action='group' AND role='producao') OR (p_action='cancel' AND role='administrativo')))
 THEN RAISE EXCEPTION 'DELIVERY_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 IF NOT public.saas_has_feature('estoque_embalagens') THEN RAISE EXCEPTION 'DELIVERY_FEATURE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.delivery_mutation_guard_20261030()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE c platform_private.delivery_context_20261030%ROWTYPE; v_org uuid;
 v_proof text[]:=ARRAY['comprovante_status','assinatura_tipo','recebedor_nome','recebedor_documento','recebedor_cargo','recebedor_telefone','comprovante_anexado_em','comprovante_anexado_por','assinatura_digital_capturada_em','assinatura_digital_capturada_por','comprovante_id','formulario_gerado_em','formulario_gerado_por','validation_token','validation_hash','updated_at'];
BEGIN
 IF TG_OP='DELETE' THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 SELECT * INTO c FROM platform_private.delivery_context_20261030
 WHERE txid=pg_catalog.txid_current() AND actor=auth.uid();
 IF NOT FOUND THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='proof' THEN
  v_org:=platform_private.delivery_proof_actor_20261030();
  IF TG_OP='UPDATE' AND c.mutation='proof' AND c.organization_id=v_org AND NEW.id=c.target AND OLD.id=c.target
  AND OLD.organization_id=v_org AND NEW.organization_id=v_org
  AND OLD.partner_order_id IS NULL AND NEW.partner_order_id IS NULL
  AND OLD.ordem_servico_onfarm_id IS NULL AND NEW.ordem_servico_onfarm_id IS NULL
  AND NEW.status=OLD.status AND NEW.receivable_id IS NOT DISTINCT FROM OLD.receivable_id
  AND (pg_catalog.to_jsonb(NEW)-v_proof) IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-v_proof) THEN
   UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
   RETURN NEW;
  END IF;
  RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501';
 END IF;
 v_org:=platform_private.delivery_actor_20261030(c.action);
 IF c.organization_id IS DISTINCT FROM v_org OR NEW.organization_id IS DISTINCT FROM v_org
 OR NEW.partner_order_id IS NOT NULL OR NEW.receivable_id IS NOT NULL OR NEW.ordem_servico_onfarm_id IS NOT NULL
 THEN RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 IF c.action='group' AND TG_OP='INSERT' AND c.mutation='create' AND c.delivery IS NULL
 AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item AND NEW.status::text='separado' THEN
  UPDATE platform_private.delivery_context_20261030 SET delivery=NEW.id,mutation='decorate' WHERE txid=c.txid;
 ELSIF c.action='group' AND TG_OP='UPDATE' AND c.mutation='decorate' AND NEW.id=c.delivery
 AND OLD.id=c.delivery AND NEW.ordem_servico_id=c.target AND NEW.estoque_produto_id=c.item
 AND NEW.organization_id=OLD.organization_id AND NEW.status=OLD.status THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSIF c.action='cancel' AND TG_OP='UPDATE' AND c.mutation='cancel' AND NEW.id=c.target AND OLD.id=c.target
 AND OLD.organization_id=v_org AND NEW.status::text='cancelada' AND NEW.financial_status='CANCELED'
 AND (pg_catalog.to_jsonb(NEW)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status'])
 IS NOT DISTINCT FROM (pg_catalog.to_jsonb(OLD)-ARRAY['status','motivo_cancelamento','updated_at','cancelada_em','cancelada_por','financial_status']) THEN
  UPDATE platform_private.delivery_context_20261030 SET mutation='done' WHERE txid=c.txid;
 ELSE RAISE EXCEPTION 'DELIVERY_MUTATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.delivery_no_downstream_20261030()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current()) THEN
  RAISE EXCEPTION 'DELIVERY_DOWNSTREAM_FORBIDDEN: %.%',TG_TABLE_SCHEMA,TG_TABLE_NAME USING ERRCODE='42501';
 END IF;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.delivery_order_transition_guard_20261030()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF NEW.status IS DISTINCT FROM OLD.status AND EXISTS(SELECT 1 FROM platform_private.delivery_context_20261030 WHERE txid=pg_catalog.txid_current()) THEN
  RAISE EXCEPTION 'DELIVERY_B2B_TRANSITION_CLOSED' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.delivery_proof_actor_20261030()
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_uid uuid:=auth.uid(); BEGIN
 IF v_uid IS NULL THEN RAISE EXCEPTION 'DELIVERY_PROOF_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL
 OR EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=v_uid AND role IN ('parceiro_b2b','parceiro_b2b_tecnico','cliente_produtor','consultor_tecnico','superadmin'))
 OR EXISTS(SELECT 1 FROM public.partner_users WHERE user_id=v_uid AND revoked_at IS NULL AND (valid_from IS NULL OR valid_from<=pg_catalog.now()))
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=v_uid AND role IN ('administrador','gestor','administrativo','producao','operador_onfarm','aplicador'))
 THEN RAISE EXCEPTION 'DELIVERY_PROOF_ACTOR_DENIED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.envase_insert_final_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE p platform_private.envase_insert_permits_v1%ROWTYPE;
BEGIN
 DELETE FROM platform_private.envase_insert_permits_v1 WHERE txid=txid_current() AND actor=auth.uid() AND action=TG_TABLE_NAME AND target=NEW.id AND admitted RETURNING * INTO p;
 IF FOUND THEN
  IF p.organization_id IS DISTINCT FROM platform_private.stock_envase_scope_v1(p.lote,p.prog,p.os,'manual')
   OR (to_jsonb(NEW)-'created_at'-'updated_at') IS DISTINCT FROM p.payload THEN RAISE EXCEPTION 'ENVASE_FINAL_PERMIT_MISMATCH' USING ERRCODE='42501'; END IF;
 ELSIF TG_TABLE_NAME='envase' THEN RAISE EXCEPTION 'ENVASE_FINAL_PERMIT_MISSING' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.envase_insert_guard_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE p platform_private.envase_insert_permits_v1%ROWTYPE; c record; parent public.estoque_produto%ROWTYPE; a jsonb; org uuid;
BEGIN
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed' THEN RAISE EXCEPTION 'ENVASE_ISOLATION_UNSUPPORTED' USING ERRCODE='0A000'; END IF;
 UPDATE platform_private.envase_insert_permits_v1 SET admitted=true WHERE txid=txid_current() AND actor=auth.uid() AND action=TG_TABLE_NAME AND target=NEW.id AND admitted=false RETURNING * INTO p;
 IF FOUND THEN
  IF p.organization_id IS DISTINCT FROM platform_private.stock_envase_scope_v1(p.lote,p.prog,p.os,'manual')
   OR NEW.lote_id IS DISTINCT FROM p.lote OR (to_jsonb(NEW)-'created_at'-'updated_at') IS DISTINCT FROM p.payload THEN RAISE EXCEPTION 'ENVASE_INSERT_PERMIT_MISMATCH' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END IF;
 -- Preserve ONLY the installed canonical partial reservation semantics under
 -- its private txid/actor/parent context, not an invented envase permit.
 IF TG_TABLE_NAME='estoque_produto' THEN
  SELECT * INTO c FROM platform_private.stock_motor_context WHERE txid=txid_current() AND actor=auth.uid();
  IF FOUND AND c.ctx->>'acao'='reserva' AND c.item IS NOT NULL AND NEW.id<>c.item THEN
   SELECT * INTO parent FROM public.estoque_produto WHERE id=c.item;
   a:=c.ctx->'reserve_args'; org:=platform_private.stock_motor_actor('reserva');
   IF parent.status::text='disponivel' AND NEW.status::text='reservado' AND NEW.quantidade>0 AND NEW.quantidade<parent.quantidade
    AND NEW.quantidade_reservada=NEW.quantidade AND NEW.lote_id=parent.lote_id
    AND NEW.envase_id IS NOT DISTINCT FROM parent.envase_id AND NEW.produto_id IS NOT DISTINCT FROM parent.produto_id AND NEW.microrganismo_id IS NOT DISTINCT FROM parent.microrganismo_id
    AND NEW.validade IS NOT DISTINCT FROM parent.validade AND NEW.volume_total=NEW.quantidade*parent.volume_total/parent.quantidade
    AND NEW.reservado_para_os_id::text IS NOT DISTINCT FROM a->>'os_id' AND NEW.reservado_para_os_tipo IS NOT DISTINCT FROM a->>'os_tipo'
    AND NEW.reservado_para_cliente_id::text IS NOT DISTINCT FROM a->>'cliente_id'
    AND NEW.reservado_para_partner_id::text IS NOT DISTINCT FROM a->>'partner_id' AND NEW.reservado_para_partner_order_id::text IS NOT DISTINCT FROM a->>'partner_order_id'
    AND NEW.observacao_reserva IS NOT DISTINCT FROM a->>'observacao'
    AND EXISTS(SELECT 1 FROM public.lotes WHERE id=parent.lote_id AND organization_id=org) THEN RETURN NEW; END IF;
  END IF;
 END IF;
 RAISE EXCEPTION 'ENVASE_INSERT_CLOSED' USING ERRCODE='42501';
END $function$;
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_before_write()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF NOT platform_private.global_product_fiscal_write_ready() THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF TG_OP='UPDATE' THEN
  IF OLD.is_active IS NOT TRUE THEN RAISE EXCEPTION 'FISCAL_HISTORY_IMMUTABLE' USING ERRCODE='42501'; END IF;
  IF NEW.product_id IS DISTINCT FROM OLD.product_id OR NEW.id IS DISTINCT FROM OLD.id THEN RAISE EXCEPTION 'FISCAL_IDENTITY_IMMUTABLE'; END IF;
  -- Server-owned CAS token for ALL direct editor and IBS/CBS updates.
  -- Strictly newer even inside one transaction; caller timestamps are ignored.
  -- The existing AFTER fiscal audit observes this token in the same transaction.
  NEW.updated_at:=greatest(clock_timestamp(),OLD.updated_at+interval '1 microsecond');
 ELSE NEW.updated_at:=clock_timestamp(); END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_ibs_save(p_product_id uuid, payload jsonb, expected_revision text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE current_row public.product_fiscal_profiles; result public.product_fiscal_profiles; BEGIN
 IF NOT platform_private.global_product_fiscal_write_ready() THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 -- Lock the same existing gate BEFORE the row; role revokers use this gate too.
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_GATE_UNAVAILABLE'; END IF;
 IF NOT platform_private.global_product_fiscal_write_ready() THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 PERFORM public._fiscal_rtc_assert_payload(payload,'item');
 SELECT * INTO current_row FROM public.product_fiscal_profiles WHERE product_id=p_product_id AND is_active IS TRUE FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_ITEM_NOT_FOUND' USING ERRCODE='P0002'; END IF;
 IF expected_revision IS NULL OR expected_revision<>current_row.updated_at::text THEN RAISE EXCEPTION 'FISCAL_CONFLICT' USING ERRCODE='40001'; END IF;
 UPDATE public.product_fiscal_profiles SET ibs_cbs_configuration=payload WHERE id=current_row.id AND product_id=p_product_id AND is_active IS TRUE AND updated_at=current_row.updated_at RETURNING * INTO result;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_CONFLICT' USING ERRCODE='40001'; END IF;
 RETURN jsonb_build_object('configuration',result.ibs_cbs_configuration,'revision',result.updated_at::text);
END $function$;
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_read_ready()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT auth.uid() IS NOT NULL AND platform_private.platform_actor_access_ready(auth.uid()) AND
 (public.is_platform_superadmin(auth.uid()) OR platform_private.has_role(auth.uid(),'administrador') OR platform_private.has_role(auth.uid(),'gestor') OR platform_private.has_role(auth.uid(),'financeiro'));
$function$;
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_statement_gate()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF TG_WHEN<>'BEFORE' OR TG_LEVEL<>'STATEMENT' OR TG_OP NOT IN ('INSERT','UPDATE') OR TG_RELID<>'public.product_fiscal_profiles'::regclass THEN RAISE EXCEPTION 'invalid_fiscal_guard_context' USING ERRCODE='42501'; END IF;
 IF current_setting('role',true) IN ('anon','authenticated') AND auth.uid() IS NULL THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FISCAL_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 RETURN NULL;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_write_ready()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT auth.uid() IS NOT NULL AND platform_private.platform_actor_access_ready(auth.uid()) AND public.is_platform_superadmin(auth.uid());
$function$;
CREATE OR REPLACE FUNCTION platform_private.guard_manual_cq_parent_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE ticket text; org uuid; linked boolean;
BEGIN
 IF TG_TABLE_NAME='ordens_servico' THEN
  linked:=EXISTS(SELECT 1 FROM public.programacao_producao p JOIN public.lotes l ON l.programacao_id=p.id WHERE p.ordem_servico_id=OLD.id AND l.organization_id IS NOT NULL);
  IF linked AND OLD.status::text='em_cq' AND NEW.status::text='envase'
   AND (to_jsonb(NEW)-'status'-'updated_at') IS NOT DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
   AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_envase_transition_v1' AND target=OLD.id)
   AND EXISTS(SELECT 1 FROM public.programacao_producao p JOIN public.lotes l ON l.programacao_id=p.id
    WHERE p.ordem_servico_id=OLD.id AND l.status::text='aprovado' AND l.organization_id=OLD.organization_id)
  THEN RETURN NEW; END IF;
  IF linked AND OLD.status::text='em_cq' AND
   (to_jsonb(NEW)-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'updated_at') THEN
   RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501';
  END IF;
  IF linked AND (OLD.status::text='em_cq' OR NEW.status::text='em_cq') AND NEW.status IS DISTINCT FROM OLD.status THEN
   IF OLD.status::text IS DISTINCT FROM 'programada' OR NEW.status::text IS DISTINCT FROM 'em_cq'
    OR (to_jsonb(NEW)-'status'-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=OLD.id)
   THEN RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
  END IF;
 ELSE
  linked:=OLD.ordem_servico_id IS NOT NULL AND EXISTS(SELECT 1 FROM public.lotes l WHERE l.programacao_id=OLD.id AND l.organization_id IS NOT NULL);
  IF linked AND (NEW.id IS DISTINCT FROM OLD.id OR NEW.ordem_servico_id IS DISTINCT FROM OLD.ordem_servico_id
   OR NEW.ordem_servico_onfarm_id IS DISTINCT FROM OLD.ordem_servico_onfarm_id
   OR NEW.organization_id IS DISTINCT FROM OLD.organization_id
   OR NEW.produto_id IS DISTINCT FROM OLD.produto_id OR NEW.microrganismo_id IS DISTINCT FROM OLD.microrganismo_id) THEN
   RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501';
  END IF;
  IF linked AND (OLD.status::text IN ('aguardando_cq','aprovado') OR NEW.status::text IN ('aguardando_cq','aprovado')) AND NEW IS DISTINCT FROM OLD THEN
   ticket:=CASE WHEN OLD.status::text='aguardando' AND NEW.status::text='aguardando_cq' THEN 'manual_cq_send_v1'
     WHEN OLD.status::text='aguardando_cq' AND NEW.status::text='aprovado' THEN 'manual_cq_aprovado_v1' END;
   IF ticket IS NULL OR (to_jsonb(NEW)-'status'-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope=ticket AND target=OLD.id)
   THEN RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
  END IF;
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.guard_manual_lot_delete_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF EXISTS(SELECT 1 FROM public.programacao_producao p WHERE p.id=OLD.programacao_id AND p.ordem_servico_id IS NOT NULL)
 OR EXISTS(SELECT 1 FROM public.laboratorio_esteira_eventos e WHERE e.lote_id=OLD.id AND e.origem_os='manual')
 THEN RAISE EXCEPTION 'MANUAL_LOT_DELETE_FORBIDDEN' USING ERRCODE='42501'; END IF;
 RETURN OLD;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.guard_manual_lot_write_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
 p public.programacao_producao%ROWTYPE;
 old_manual boolean:=false;
 old_programacao uuid;
 org uuid;
BEGIN
 -- Lock old/new parents in deterministic order. An UPDATE cannot escape the
 -- manual fence by changing programacao_id to onfarm or NULL.
 IF TG_OP='UPDATE' THEN old_programacao:=OLD.programacao_id; END IF;
 PERFORM 1 FROM public.programacao_producao
 WHERE id=NEW.programacao_id OR id=old_programacao
 ORDER BY id FOR SHARE;
 IF TG_OP='UPDATE' THEN
  SELECT EXISTS(SELECT 1 FROM public.programacao_producao
    WHERE id=OLD.programacao_id AND ordem_servico_id IS NOT NULL) INTO old_manual;
 END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=NEW.programacao_id;
 IF old_manual OR p.ordem_servico_id IS NOT NULL OR p.id IS NULL THEN
  IF TG_OP='UPDATE' AND old_manual THEN
   org:=platform_private.h15_actor_organization();
   IF auth.uid() IS NOT NULL AND org IS NOT NULL AND public.technical_actor_ready(auth.uid()) IS TRUE
    AND (public.has_role(auth.uid(),'administrador') OR public.has_role(auth.uid(),'gestor') OR public.has_role(auth.uid(),'producao')) IS TRUE
    AND p.id IS NOT NULL AND p.ordem_servico_onfarm_id IS NULL AND p.organization_id=org AND NEW.organization_id=org AND OLD.organization_id=org
    AND (to_jsonb(NEW)-'status'-'updated_at') IS NOT DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    AND EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org AND o.status::text='em_cq'
     AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL AND o.origem IS DISTINCT FROM 'b2b')
    AND ((OLD.status::text='em_producao' AND NEW.status::text='aguardando_cq' AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=NEW.id))
     OR (OLD.status::text='aguardando_cq' AND NEW.status::text IN ('aprovado','reprovado') AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_'||NEW.status::text||'_v1' AND target=NEW.id)
     AND EXISTS(SELECT 1 FROM public.controle_qualidade c WHERE c.lote_id=NEW.id AND c.organization_id=org AND c.resultado::text=NEW.status::text
      AND c.responsavel='DADOS FICTICIOS SEM VALOR COMERCIAL' AND c.ph IS NOT NULL AND c.concentracao IS NOT NULL)))
   THEN RETURN NEW; END IF;
  END IF;

  -- No JWT/GUC/current_user/service-role escape: only the reviewed insert RPC
  -- can issue this private, target-specific ticket; it removes it after INSERT.
  org:=platform_private.h15_actor_organization();
  IF TG_OP<>'INSERT' OR org IS NULL OR auth.uid() IS NULL
   OR public.technical_actor_ready(auth.uid()) IS NOT TRUE
   OR p.id IS NULL OR p.ordem_servico_id IS NULL OR p.ordem_servico_onfarm_id IS NOT NULL
   OR p.organization_id IS DISTINCT FROM org OR NEW.organization_id IS DISTINCT FROM org
   OR p.produto_id IS DISTINCT FROM NEW.produto_id OR p.microrganismo_id IS DISTINCT FROM NEW.microrganismo_id
   OR p.status::text IS DISTINCT FROM 'aguardando' OR NEW.status::text IS DISTINCT FROM 'em_producao'
   OR NOT EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org
     AND o.status::text='programada' AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL
     AND o.origem IS DISTINCT FROM 'b2b')
   OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets
     WHERE txid=pg_catalog.txid_current() AND scope='manual_lot_insert_v1' AND target=NEW.id)
  THEN RAISE EXCEPTION 'MANUAL_LOT_WRITE_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.guard_manual_program_binding_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
 IF OLD.ordem_servico_id IS NOT NULL
 AND ROW(NEW.id,NEW.ordem_servico_id,NEW.ordem_servico_onfarm_id,NEW.organization_id,NEW.produto_id,NEW.microrganismo_id)
 IS DISTINCT FROM ROW(OLD.id,OLD.ordem_servico_id,OLD.ordem_servico_onfarm_id,OLD.organization_id,OLD.produto_id,OLD.microrganismo_id)
 AND EXISTS(SELECT 1 FROM public.lotes l WHERE l.programacao_id=OLD.id)
 THEN RAISE EXCEPTION 'MANUAL_PROGRAM_BINDING_IMMUTABLE' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.guard_visit_plan_preservation()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  old_block text;
  new_block text;
  authorized boolean;
BEGIN
  old_block := substring(coalesce(OLD.observacoes_tecnicas,'') from '\[PLANO DE MONITORAMENTO\].*?\[FIM DO PLANO\]');
  new_block := substring(coalesce(NEW.observacoes_tecnicas,'') from '\[PLANO DE MONITORAMENTO\].*?\[FIM DO PLANO\]');
  IF (coalesce(NEW.observacoes_tecnicas,'') LIKE '%[PLANO DE MONITORAMENTO]%' OR coalesce(NEW.observacoes_tecnicas,'') LIKE '%[FIM DO PLANO]%') AND
    (new_block IS NULL OR length(coalesce(NEW.observacoes_tecnicas,''))-length(replace(coalesce(NEW.observacoes_tecnicas,''),'[PLANO DE MONITORAMENTO]',''))<>length('[PLANO DE MONITORAMENTO]') OR
      length(coalesce(NEW.observacoes_tecnicas,''))-length(replace(coalesce(NEW.observacoes_tecnicas,''),'[FIM DO PLANO]',''))<>length('[FIM DO PLANO]')) THEN
    RAISE EXCEPTION 'ambiguous_plan_text' USING ERRCODE='PT409';
  END IF;
  IF old_block IS NOT DISTINCT FROM new_block AND (old_block IS NULL OR OLD.data_proxima_visita IS NOT DISTINCT FROM NEW.data_proxima_visita) THEN
    RETURN NEW;
  END IF;
  SELECT EXISTS(SELECT 1 FROM platform_private.visit_plan_write_tickets t
    WHERE t.transaction_id=txid_current() AND t.registro_id=OLD.id
      AND t.block IS NOT DISTINCT FROM new_block AND t.next_date IS NOT DISTINCT FROM NEW.data_proxima_visita)
    INTO authorized;
  IF NOT authorized THEN
    RAISE EXCEPTION 'monitoring_plan_requires_canonical_save' USING ERRCODE='PT409';
  END IF;
  RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.h15_actor_organization()
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT p.organization_id FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id AND o.ativo IS TRUE WHERE p.user_id=auth.uid() AND p.ativo IS TRUE AND platform_private.platform_actor_access_ready(p.user_id);
$function$;
CREATE OR REPLACE FUNCTION platform_private.has_role(_user_id uuid, _role app_role)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT EXISTS(SELECT 1 FROM public.user_roles r JOIN public.profiles p ON p.user_id=r.user_id WHERE r.user_id=_user_id AND r.role=_role AND p.ativo IS TRUE AND platform_private.platform_actor_access_ready(p.user_id));
$function$;
CREATE OR REPLACE FUNCTION platform_private.lab_assert_manufacturable(p_product_id uuid, p_microorganism_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF NOT platform_private.lab_item_is_manufacturable(p_product_id,p_microorganism_id) THEN
    RAISE EXCEPTION 'LAB_ITEM_NOT_MANUFACTURABLE' USING ERRCODE='23514',
      HINT='Somente produtos biológicos e microrganismos podem gerar fabricação laboratorial.';
  END IF;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.lab_item_is_manufacturable(p_product_id uuid, p_microorganism_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT CASE
    -- Duas referências na mesma linha são ambíguas e falham fechadas. Isso impede que
    -- um microrganismo válido transforme produto químico/fertilizante em fabricável.
    WHEN p_product_id IS NOT NULL AND p_microorganism_id IS NOT NULL THEN false
    WHEN p_product_id IS NOT NULL THEN EXISTS(SELECT 1 FROM public.produtos p WHERE p.id=p_product_id AND p.familia_catalogo='biologico')
    WHEN p_microorganism_id IS NOT NULL THEN EXISTS(SELECT 1 FROM public.microrganismos m WHERE m.id=p_microorganism_id)
    ELSE false END
$function$;
CREATE OR REPLACE FUNCTION platform_private.lab_partner_order_authorized(p_order_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_uid uuid:=auth.uid(); v_org uuid;
BEGIN
 IF v_uid IS NULL OR NOT (public.has_role(v_uid,'administrador') OR public.has_role(v_uid,'producao') OR public.has_role(v_uid,'gestor')) THEN RETURN false; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL THEN RETURN false; END IF;
 RETURN EXISTS(SELECT 1 FROM public.partner_orders o JOIN public.partner_accounts p ON p.id=o.partner_id
 WHERE o.id=p_order_id AND p.commercial_owner_organization_id=v_org AND p.ativo IS TRUE AND p.deleted_at IS NULL
 AND (p.client_id IS NULL OR EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=p.client_id AND c.organization_id=v_org)));
END $function$;
CREATE OR REPLACE FUNCTION platform_private.lab_visit_recommendation_lock()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_id uuid; v_status text;
BEGIN
 FOR v_id IN SELECT DISTINCT id FROM unnest(ARRAY[
   CASE WHEN TG_OP<>'INSERT' THEN OLD.registro_consultor_id END,
   CASE WHEN TG_OP<>'DELETE' THEN NEW.registro_consultor_id END]) id WHERE id IS NOT NULL ORDER BY id LOOP
   SELECT status::text INTO v_status FROM public.registros_consultor WHERE id=v_id FOR UPDATE;
   IF v_status='convertido_os' THEN RAISE EXCEPTION 'VISIT07_REVIEW_REQUIRED' USING ERRCODE='23514',HINT='Visita já encaminhada; preserve a seleção e revise pelo fluxo técnico autorizado.'; END IF;
 END LOOP;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.manual_cq_v1(p_os_id uuid, p_programacao_id uuid, p_cq jsonb DEFAULT NULL::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
 uid uuid:=auth.uid(); org uuid; os public.ordens_servico%ROWTYPE; pp public.programacao_producao%ROWTYPE;
 lot public.lotes%ROWTYPE; cq public.controle_qualidade%ROWTYPE; ref public.cq_parametros_referencia%ROWTYPE;
 key text; phase text; outcome text; v_ph numeric; concentration numeric; refid uuid;
 payload jsonb; receipt public.cockpit_operacao_idempotencia%ROWTYPE; receipt_key text; digest text;
 result jsonb; cqid uuid; profileid uuid;
BEGIN
 PERFORM pg_catalog.set_config('lock_timeout','3s',true);
 org:=platform_private.h15_actor_organization();
 IF uid IS NULL OR org IS NULL OR public.technical_actor_ready(uid) IS NOT TRUE
 OR public._saas_user_has_feature(uid,'ordens_producao') IS NOT TRUE
 OR public._saas_user_has_feature(uid,'lotes_qualidade') IS NOT TRUE
 OR (public.has_role(uid,'administrador') OR public.has_role(uid,'gestor') OR public.has_role(uid,'producao')) IS NOT TRUE
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_os_id IS NULL OR p_programacao_id IS NULL OR current_setting('transaction_isolation')<>'read committed' THEN
 RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 phase:=CASE WHEN p_cq IS NULL THEN 'enviar_cq' ELSE 'registrar_cq' END;
 IF p_cq IS NOT NULL THEN
  IF jsonb_typeof(p_cq) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  FOR key IN SELECT jsonb_object_keys(p_cq) LOOP
   IF key NOT IN ('lote_id','resultado','ph','concentracao','aparencia','odor','contaminacao','referencia_id','dados_sinteticos') THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  END LOOP;
  IF p_cq->'dados_sinteticos' IS DISTINCT FROM 'true'::jsonb OR p_cq->>'resultado' NOT IN ('aprovado','reprovado')
   OR jsonb_typeof(p_cq->'ph') IS DISTINCT FROM 'number' OR jsonb_typeof(p_cq->'concentracao') IS DISTINCT FROM 'number'
   OR jsonb_typeof(p_cq->'lote_id') IS DISTINCT FROM 'string' THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  outcome:=p_cq->>'resultado'; v_ph:=(p_cq->>'ph')::numeric; concentration:=(p_cq->>'concentracao')::numeric;
  IF outcome IS NULL OR v_ph::text IN ('NaN','Infinity','-Infinity') OR v_ph<0 OR v_ph>14
   OR concentration::text IN ('NaN','Infinity','-Infinity') OR concentration<0 OR concentration>1e30 THEN RAISE EXCEPTION 'CQ_VALUES_INVALID'; END IF;
  FOREACH key IN ARRAY ARRAY['aparencia','odor','contaminacao'] LOOP
   IF jsonb_typeof(p_cq->key) IS DISTINCT FROM 'string' OR length(btrim(p_cq->>key)) NOT BETWEEN 1 AND 200 THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  END LOOP;
  IF p_cq ? 'referencia_id' AND jsonb_typeof(p_cq->'referencia_id') NOT IN ('null','string') THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
  BEGIN refid:=nullif(p_cq->>'referencia_id','')::uuid; EXCEPTION WHEN invalid_text_representation THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END;
  payload:=p_cq||jsonb_build_object('aparencia',btrim(p_cq->>'aparencia'),'odor',btrim(p_cq->>'odor'),'contaminacao',btrim(p_cq->>'contaminacao'),'referencia_id',refid);
 ELSE payload:='{}'::jsonb; END IF;
 -- Same lock order / phantom fences as reviewed lot generation. No legacy assert-only delegation.
 LOCK TABLE public.platform_org_admin_invites,public.ordens_servico_onfarm IN SHARE MODE;
 LOCK TABLE public.saas_plan_versions,public.saas_plan_version_features,public.saas_features,public.saas_modules IN SHARE MODE;
 PERFORM pg_advisory_xact_lock(hashtext('cockpit_lote:'||p_programacao_id::text));
 SELECT * INTO os FROM public.ordens_servico WHERE id=p_os_id FOR UPDATE;
 IF os.id IS NULL OR os.organization_id IS DISTINCT FROM org THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=uid ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.user_roles WHERE user_id=uid ORDER BY role::text FOR SHARE;
 PERFORM 1 FROM public.organizations WHERE id=org FOR UPDATE;
 PERFORM 1 FROM public.organization_subscriptions WHERE organization_id=org ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.organization_feature_overrides WHERE organization_id=org ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.clientes WHERE id=os.cliente_id FOR SHARE;
 PERFORM 1 FROM public.fazendas WHERE id=os.fazenda_id FOR SHARE;
 PERFORM 1 FROM public.talhoes WHERE id=os.talhao_id FOR SHARE;
 PERFORM 1 FROM public.produtos WHERE id=os.produto_id FOR SHARE;
 PERFORM 1 FROM public.microrganismos WHERE id=os.microrganismo_id FOR SHARE;
 PERFORM 1 FROM public.programacao_producao WHERE id=p_programacao_id OR ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id ORDER BY id FOR UPDATE;
 PERFORM 1 FROM public.lotes WHERE programacao_id=p_programacao_id ORDER BY id FOR UPDATE;
 IF public.technical_actor_ready(uid) IS NOT TRUE OR platform_private.h15_actor_organization() IS DISTINCT FROM org
 OR public._saas_user_has_feature(uid,'ordens_producao') IS NOT TRUE OR public._saas_user_has_feature(uid,'lotes_qualidade') IS NOT TRUE
 OR (public.has_role(uid,'administrador') OR public.has_role(uid,'gestor') OR public.has_role(uid,'producao')) IS NOT TRUE
 OR NOT EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=os.cliente_id AND c.organization_id=org)
 OR EXISTS(SELECT 1 FROM public.ordens_servico_onfarm WHERE id=p_os_id)
 OR (os.fazenda_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.fazendas f WHERE f.id=os.fazenda_id AND f.organization_id=org AND f.cliente_id=os.cliente_id AND f.ativo))
 OR (os.talhao_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.talhoes t WHERE t.id=os.talhao_id AND t.organization_id=org AND t.fazenda_id=os.fazenda_id AND t.ativo))
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF os.origem='b2b' OR os.partner_order_id IS NOT NULL OR os.partner_order_item_id IS NOT NULL
 OR EXISTS(SELECT 1 FROM public.production_order_link WHERE ordem_servico_id=p_os_id)
 OR EXISTS(SELECT 1 FROM public.entregas WHERE ordem_servico_id=p_os_id)
 OR EXISTS(SELECT 1 FROM public.aplicacoes WHERE ordem_servico_id=p_os_id)
 OR (SELECT count(*) FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id)<>1
 OR (SELECT count(*) FROM public.lotes WHERE programacao_id=p_programacao_id)<>1
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO pp FROM public.programacao_producao WHERE id=p_programacao_id;
 SELECT * INTO lot FROM public.lotes WHERE programacao_id=p_programacao_id;
 IF pp.id IS NULL OR pp.organization_id IS DISTINCT FROM org OR pp.ordem_servico_id IS DISTINCT FROM p_os_id OR pp.ordem_servico_onfarm_id IS NOT NULL
 OR lot.organization_id IS DISTINCT FROM org OR lot.produto_id IS DISTINCT FROM pp.produto_id OR lot.microrganismo_id IS DISTINCT FROM pp.microrganismo_id
 OR pp.produto_id IS DISTINCT FROM os.produto_id OR pp.microrganismo_id IS DISTINCT FROM os.microrganismo_id
 OR pp.data_programada IS NULL OR pp.volume_necessario IS DISTINCT FROM os.volume_total_ml
 OR lot.volume_produzido IS NULL OR lot.volume_produzido<=0 OR lot.volume_produzido::text IN ('NaN','Infinity','-Infinity')
 OR pp.responsavel_id IS NOT NULL OR nullif(btrim(pp.responsavel),'') IS NOT NULL
 OR platform_private.lab_item_is_manufacturable(pp.produto_id,pp.microrganismo_id) IS NOT TRUE
 OR EXISTS(SELECT 1 FROM public.envase WHERE lote_id=lot.id) OR EXISTS(SELECT 1 FROM public.estoque_produto WHERE lote_id=lot.id)
 OR NOT EXISTS(SELECT 1 FROM public.laboratorio_esteira_eventos e WHERE e.lote_id=lot.id AND e.os_id=os.id AND e.programacao_id=pp.id AND e.origem_os='manual' AND e.acao='gerar_lote')
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_cq IS NOT NULL AND (p_cq->>'lote_id') IS DISTINCT FROM lot.id::text THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_advisory_xact_lock(hashtext('cq_lote:'||lot.id::text));
 PERFORM 1 FROM public.controle_qualidade WHERE lote_id=lot.id ORDER BY seq FOR UPDATE;
 -- Resolve the canonical item, never infer/create a product->microorganism link.
 IF p_cq IS NOT NULL THEN
  LOCK TABLE public.cq_parametros_referencia IN SHARE MODE;
  IF (SELECT count(*) FROM public.cq_parametros_referencia r WHERE r.ativo IS TRUE AND
   ((pp.produto_id IS NOT NULL AND r.produto_id=pp.produto_id) OR
    (pp.produto_id IS NULL AND pp.microrganismo_id IS NOT NULL AND r.produto_id IS NULL AND r.microrganismo_id=pp.microrganismo_id)))>1
   THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
  SELECT r.* INTO ref FROM public.cq_parametros_referencia r WHERE r.ativo IS TRUE AND
   ((pp.produto_id IS NOT NULL AND r.produto_id=pp.produto_id) OR
    (pp.produto_id IS NULL AND pp.microrganismo_id IS NOT NULL AND r.produto_id IS NULL AND r.microrganismo_id=pp.microrganismo_id));
 END IF;
 IF p_cq IS NOT NULL AND refid IS DISTINCT FROM ref.id THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
 IF p_cq IS NOT NULL AND outcome='aprovado' AND ref.id IS NULL THEN RAISE EXCEPTION 'CQ_REFERENCE_REQUIRED'; END IF;
 IF ref.id IS NOT NULL AND (ref.ph_min IS NULL OR ref.ph_max IS NULL OR ref.concentracao_min_ufc_ml IS NULL
 OR ref.ph_min::text IN ('NaN','Infinity','-Infinity') OR ref.ph_max::text IN ('NaN','Infinity','-Infinity') OR ref.concentracao_min_ufc_ml::text IN ('NaN','Infinity','-Infinity')
 OR ref.ph_min<0 OR ref.ph_max>14 OR ref.ph_min>ref.ph_max OR ref.concentracao_min_ufc_ml<0
 OR nullif(btrim(ref.aparencia_esperada),'') IS NULL OR nullif(btrim(ref.odor_esperado),'') IS NULL OR nullif(btrim(ref.contaminacao_esperada),'') IS NULL)
 THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
 IF p_cq IS NOT NULL AND outcome='aprovado' AND ref.id IS NOT NULL AND
 ((ref.ph_min IS NOT NULL AND v_ph<ref.ph_min) OR (ref.ph_max IS NOT NULL AND v_ph>ref.ph_max)
 OR (ref.concentracao_min_ufc_ml IS NOT NULL AND concentration<ref.concentracao_min_ufc_ml)
 OR (nullif(btrim(ref.aparencia_esperada),'') IS NOT NULL AND btrim(p_cq->>'aparencia')<>btrim(ref.aparencia_esperada))
 OR (nullif(btrim(ref.odor_esperado),'') IS NOT NULL AND btrim(p_cq->>'odor')<>btrim(ref.odor_esperado))
 OR (nullif(btrim(ref.contaminacao_esperada),'') IS NOT NULL AND btrim(p_cq->>'contaminacao')<>btrim(ref.contaminacao_esperada))) THEN RAISE EXCEPTION 'CQ_REFERENCE_FAILED'; END IF;
 receipt_key:='manual_cq_v1:'||phase||':'||lot.id::text;
 payload:=payload||jsonb_build_object('os_id',os.id,'programacao_id',pp.id,'lote_id',lot.id,'referencia_snapshot',CASE WHEN p_cq IS NULL OR ref.id IS NULL THEN NULL ELSE to_jsonb(ref) END);
 digest:=md5(payload::text);
 SELECT * INTO receipt FROM public.cockpit_operacao_idempotencia WHERE idempotency_key=receipt_key FOR UPDATE;
 IF receipt.idempotency_key IS NOT NULL THEN
  IF receipt.usuario_id IS DISTINCT FROM uid OR receipt.payload_hash IS DISTINCT FROM digest OR receipt.alvo_id IS DISTINCT FROM lot.id OR receipt.status<>'completed'
   OR os.status::text<>'em_cq' OR lot.status::text NOT IN ('aguardando_cq','aprovado','reprovado')
   OR (p_cq IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.controle_qualidade c WHERE c.id=(receipt.resultado->>'cq_id')::uuid AND c.lote_id=lot.id AND c.organization_id=org AND c.resultado::text=outcome AND c.ph=v_ph AND c.concentracao=concentration AND c.aparencia=payload->>'aparencia' AND c.odor=payload->>'odor' AND c.contaminacao=payload->>'contaminacao'))
  THEN RAISE EXCEPTION 'CQ_REPLAY_DIVERGENT'; END IF;
  RETURN receipt.resultado||jsonb_build_object('replay',true);
 END IF;
 SELECT id INTO profileid FROM public.profiles WHERE user_id=uid AND ativo AND organization_id=org;
 IF p_cq IS NULL THEN
  IF os.status::text<>'programada' OR pp.status::text<>'aguardando' OR lot.status::text<>'em_producao'
   OR EXISTS(SELECT 1 FROM public.controle_qualidade WHERE lote_id=lot.id) THEN RAISE EXCEPTION 'CQ_STATE_INVALID'; END IF;
  INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(txid_current(),'manual_cq_send_v1',lot.id),(txid_current(),'manual_cq_send_v1',os.id),(txid_current(),'manual_cq_send_v1',pp.id);
  -- Ticket-specific transition reflects a pre-existing lot; never simulates production intermediate steps.
  UPDATE public.ordens_servico SET status='em_cq' WHERE id=os.id;
 ELSE
  IF os.status::text<>'em_cq' OR pp.status::text<>'aguardando_cq' OR lot.status::text<>'aguardando_cq'
   OR EXISTS(SELECT 1 FROM public.controle_qualidade WHERE lote_id=lot.id)
   OR NOT EXISTS(SELECT 1 FROM public.cockpit_operacao_idempotencia WHERE idempotency_key='manual_cq_v1:enviar_cq:'||lot.id::text AND status='completed') THEN RAISE EXCEPTION 'CQ_STATE_INVALID'; END IF;
  cqid:=gen_random_uuid();
  INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(txid_current(),'manual_cq_'||outcome||'_v1',lot.id),(txid_current(),'manual_cq_'||outcome||'_v1',pp.id),(txid_current(),'manual_cq_insert_v1',cqid);
  INSERT INTO public.controle_qualidade(id,lote_id,ph,concentracao,aparencia,odor,contaminacao,responsavel,responsavel_id,resultado,organization_id)
  VALUES(cqid,lot.id,v_ph,concentration,payload->>'aparencia',payload->>'odor',payload->>'contaminacao','DADOS FICTICIOS SEM VALOR COMERCIAL',profileid,outcome::public.resultado_cq,org);
  UPDATE public.lotes SET status=outcome::public.status_lote WHERE id=lot.id;
  IF outcome='aprovado' THEN UPDATE public.programacao_producao SET status='aprovado' WHERE id=pp.id; END IF;
 END IF;
 IF (SELECT status::text FROM public.ordens_servico WHERE id=os.id)<>'em_cq'
 OR (SELECT status::text FROM public.lotes WHERE id=lot.id)<>(CASE WHEN p_cq IS NULL THEN 'aguardando_cq' ELSE outcome END)
 OR (SELECT status::text FROM public.programacao_producao WHERE id=pp.id)<>(CASE WHEN outcome='aprovado' THEN 'aprovado' ELSE 'aguardando_cq' END)
 OR public.technical_actor_ready(uid) IS NOT TRUE OR platform_private.h15_actor_organization() IS DISTINCT FROM org THEN RAISE EXCEPTION 'CQ_POSTCONDITION_FAILED'; END IF;
 INSERT INTO public.laboratorio_esteira_eventos(os_id,origem_os,programacao_id,lote_id,etapa_anterior,etapa_nova,acao,usuario_id,observacao)
 VALUES(os.id,'manual',pp.id,lot.id,os.status::text,CASE WHEN p_cq IS NULL THEN 'aguardando_cq' ELSE outcome END,phase,uid,'DADOS FICTICIOS SEM VALOR COMERCIAL; sem producao fisica/venda/uso agricola. '||payload::text);
 result:=jsonb_build_object('success',true,'replay',false,'lote_id',lot.id,'cq_id',cqid,'status','em_cq','resultado',outcome);
 INSERT INTO public.cockpit_operacao_idempotencia(idempotency_key,operacao,usuario_id,resultado,payload_hash,alvo_id,status)
 VALUES(receipt_key,phase,uid,result,digest,lot.id,'completed');
 DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope IN ('manual_cq_send_v1','manual_cq_aprovado_v1','manual_cq_reprovado_v1','manual_cq_insert_v1');
 RETURN result;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.notification_source_org(st text, sid uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$ DECLARE v uuid; BEGIN
 IF sid IS NULL THEN RETURN NULL; END IF;
 CASE st
 WHEN 'registros_consultor','registro_consultor','monitoramento_vencido' THEN SELECT c.organization_id INTO v FROM public.registros_consultor r JOIN public.clientes c ON c.id=r.cliente_id WHERE r.id=sid;
 WHEN 'ordem_servico','ordens_servico' THEN SELECT o.organization_id INTO v FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id AND c.organization_id=o.organization_id WHERE o.id=sid;
 WHEN 'portal_solicitacoes' THEN SELECT c.organization_id INTO v FROM public.portal_solicitacoes s JOIN public.clientes c ON c.id=s.cliente_id WHERE s.id=sid;
 WHEN 'programacao_producao' THEN SELECT p.organization_id INTO v FROM public.programacao_producao p WHERE p.id=sid AND ((p.ordem_servico_id IS NOT NULL AND p.ordem_servico_onfarm_id IS NULL AND EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id AND c.organization_id=o.organization_id WHERE o.id=p.ordem_servico_id AND o.organization_id=p.organization_id)) OR (p.ordem_servico_onfarm_id IS NOT NULL AND p.ordem_servico_id IS NULL AND EXISTS(SELECT 1 FROM public.ordens_servico_onfarm o JOIN public.clientes c ON c.id=o.cliente_id WHERE o.id=p.ordem_servico_onfarm_id AND c.organization_id=p.organization_id)));
 WHEN 'estoque_produto' THEN RETURN NULL;
 WHEN 'aplicacao','aplicacoes' THEN SELECT a.organization_id INTO v FROM public.aplicacoes a JOIN public.ordens_servico o ON o.id=a.ordem_servico_id AND o.organization_id=a.organization_id JOIN public.clientes c ON c.id=o.cliente_id AND c.organization_id=o.organization_id WHERE a.id=sid AND a.ordem_servico_onfarm_id IS NULL;
 WHEN 'partner_orders' THEN SELECT c.organization_id INTO v FROM public.partner_orders o JOIN public.partner_accounts p ON p.id=o.partner_id AND p.ativo IS TRUE AND p.deleted_at IS NULL JOIN public.clientes c ON c.id=p.client_id WHERE o.id=sid;
 WHEN 'partner_simulations' THEN SELECT c.organization_id INTO v FROM public.partner_simulations s JOIN public.partner_accounts p ON p.id=s.partner_id AND p.ativo IS TRUE AND p.deleted_at IS NULL JOIN public.clientes c ON c.id=p.client_id WHERE s.id=sid;
 ELSE RETURN NULL; END CASE;
 IF NOT EXISTS(SELECT 1 FROM public.organizations o WHERE o.id=v AND o.ativo IS TRUE) THEN RETURN NULL; END IF;
 RETURN v; END $function$;
CREATE OR REPLACE FUNCTION platform_private.notification_user_ok(uid uuid, org uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$ SELECT org IS NOT NULL AND public.h15_user_organization(uid)=org AND platform_private.platform_actor_access_ready(uid); $function$;
CREATE OR REPLACE FUNCTION platform_private.platform_actor_access_ready(p_user uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT EXISTS(SELECT 1 FROM public.profiles p WHERE p.user_id=p_user AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE)
 AND NOT EXISTS(SELECT 1 FROM public.platform_org_admin_invites i WHERE i.user_id=p_user AND (i.access_operation_status='processing' OR (i.access_valid_after IS NOT NULL AND auth.uid()=p_user AND to_timestamp(COALESCE((auth.jwt()->>'iat')::bigint,0))<=i.access_valid_after)));
$function$;
CREATE OR REPLACE FUNCTION platform_private.platform_read_global_product_catalog_core(p_search text, p_limit integer, p_offset integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_actor uuid := auth.uid();
  v_search text;
  v_result jsonb;
BEGIN
  IF v_actor IS NULL THEN
    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'platform_catalog_forbidden';
  END IF;
  -- Signed session iat only; no user_metadata/app_metadata authorization or GUC ticket.
  IF pg_catalog.jsonb_typeof(auth.jwt()->'iat') IS DISTINCT FROM 'number'
     OR COALESCE(auth.jwt()->>'iat', '') !~ '^[0-9]{1,12}$' THEN
    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'platform_catalog_forbidden';
  END IF;
  IF (auth.jwt()->>'iat')::bigint <= 0
     OR NOT COALESCE(platform_private.platform_actor_access_ready(v_actor), false)
     OR NOT COALESCE(public.has_role(v_actor, 'superadmin'::public.app_role), false)
     OR NOT COALESCE(public.is_platform_superadmin(v_actor), false) THEN
    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'platform_catalog_forbidden';
  END IF;
  IF p_limit IS NULL OR p_limit < 1 OR p_limit > 50
     OR p_offset IS NULL OR p_offset < 0 OR p_offset > 1000000
     OR p_search IS NULL OR pg_catalog.char_length(p_search) > 120 THEN
    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'platform_catalog_invalid_query';
  END IF;
  v_search := pg_catalog.lower(pg_catalog.btrim(p_search));
  -- Literal substring: %, _, quotes are data, not wildcard/filter syntax.
  -- One snapshot, deterministic tie-breaker; only an extra sentinel is read.
  WITH bounded AS MATERIALIZED (
    SELECT p.id, p.codigo, p.nome, p.tipo, p.ativo, p.b2b_enabled, p.updated_at
    FROM public.produtos p
    WHERE v_search = ''
       OR pg_catalog.strpos(pg_catalog.lower(p.nome), v_search) > 0
       OR pg_catalog.strpos(pg_catalog.lower(COALESCE(p.codigo, '')), v_search) > 0
    ORDER BY pg_catalog.lower(p.nome) COLLATE "C", p.id
    LIMIT (p_limit + 1) OFFSET p_offset
  ), page AS (
    SELECT b.id, b.codigo, b.nome, b.tipo, b.ativo, b.b2b_enabled, b.updated_at
    FROM bounded b
    ORDER BY pg_catalog.lower(b.nome) COLLATE "C", b.id LIMIT p_limit
  )
  SELECT pg_catalog.jsonb_build_object(
    'items', COALESCE((SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(r)
      ORDER BY pg_catalog.lower(r.nome) COLLATE "C", r.id) FROM page r), '[]'::jsonb),
    'has_more', (SELECT pg_catalog.count(*) > p_limit FROM bounded)
  ) INTO v_result;
  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.producer_commercial_client_scope(p_client uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT auth.uid() IS NOT NULL AND p_client IS NOT NULL
 AND platform_private.platform_actor_access_ready(auth.uid()) IS TRUE
 AND EXISTS(SELECT 1 FROM public.profiles p JOIN public.organizations o ON o.id=p.organization_id
 JOIN public.clientes c ON c.id=p_client AND c.organization_id=p.organization_id
 WHERE p.user_id=auth.uid() AND p.ativo IS TRUE AND p.senha_provisoria IS FALSE
 AND o.ativo IS TRUE AND c.status_cliente='ativo'
 AND (public.has_role(auth.uid(),'administrador'::public.app_role)
 OR public.has_role(auth.uid(),'gestor'::public.app_role)
 OR public.has_role(auth.uid(),'cliente_produtor'::public.app_role))
 AND p_client=ANY(public.get_cliente_ids_for_user(auth.uid())));
$function$;
CREATE OR REPLACE FUNCTION platform_private.produto_etiqueta_root_org_v1(p_lote uuid, p_produto uuid, p_envase uuid, p_envase_item uuid, p_estoque_item uuid, p_embalagem uuid, p_entrega uuid, p_entrega_item uuid, p_cliente uuid, p_fazenda uuid, p_substitui uuid, p_substituida_por uuid)
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog'
AS $function$
 SELECT l.organization_id FROM public.lotes l
  WHERE l.id = p_lote AND l.organization_id IS NOT NULL
    -- envase_item_id / entrega_item_id have no referenced table (opaque): any non-null value cannot be proven => deny.
    AND p_envase_item IS NULL AND p_entrega_item IS NULL
    -- global catalogue product: no tenant; only must match the lot's product when both are set.
    AND (p_produto IS NULL OR l.produto_id IS NULL OR l.produto_id = p_produto)
    AND (p_envase IS NULL OR EXISTS (SELECT 1 FROM public.envase v WHERE v.id = p_envase AND v.lote_id = l.id AND v.organization_id = l.organization_id))
    AND (p_estoque_item IS NULL OR EXISTS (SELECT 1 FROM public.estoque_produto s WHERE s.id = p_estoque_item AND s.lote_id = l.id
          AND (p_envase IS NULL OR s.envase_id IS NULL OR s.envase_id = p_envase)))
    AND (p_embalagem IS NULL OR EXISTS (SELECT 1 FROM public.estoque_embalagens m WHERE m.id = p_embalagem AND m.lote_id = l.id
          AND (p_envase IS NULL OR m.envase_id IS NULL OR m.envase_id = p_envase)
          AND (m.cliente_id IS NULL OR EXISTS (SELECT 1 FROM public.clientes mc WHERE mc.id = m.cliente_id AND mc.organization_id = l.organization_id))))
    AND (p_entrega IS NULL OR EXISTS (SELECT 1 FROM public.entregas e WHERE e.id = p_entrega AND e.organization_id = l.organization_id))
    AND (p_cliente IS NULL OR EXISTS (SELECT 1 FROM public.clientes c WHERE c.id = p_cliente AND c.organization_id = l.organization_id))
    AND (p_fazenda IS NULL OR EXISTS (SELECT 1 FROM public.fazendas f WHERE f.id = p_fazenda AND f.organization_id = l.organization_id
          AND (p_cliente IS NULL OR f.cliente_id = p_cliente)))
    -- substitutions: referenced label's own immutable lot must be of the same organization (one level, direct table
    -- read inside this DEFINER helper; no policy or helper recursion).
    AND (p_substitui IS NULL OR EXISTS (SELECT 1 FROM public.produto_etiquetas r JOIN public.lotes rl ON rl.id = r.lote_id
          WHERE r.id = p_substitui AND rl.organization_id = l.organization_id))
    AND (p_substituida_por IS NULL OR EXISTS (SELECT 1 FROM public.produto_etiquetas r JOIN public.lotes rl ON rl.id = r.lote_id
          WHERE r.id = p_substituida_por AND rl.organization_id = l.organization_id))
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_b2b_state_core(p_item_tipo text, p_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_out jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_item_tipo IS NULL OR p_item_tipo NOT IN ('produto','microrganismo') THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_b2b_invalid'; END IF;
  IF p_item_tipo='produto' THEN
    SELECT pg_catalog.jsonb_build_object('item_tipo','produto','id',p.id,'nome',p.nome,'codigo',p.codigo,
      'ativo',COALESCE(p.ativo,false),'b2b_enabled',p.b2b_enabled,'updated_at',p.updated_at)
      INTO v_out FROM public.produtos p WHERE p.id=p_id;
  ELSE
    SELECT pg_catalog.jsonb_build_object('item_tipo','microrganismo','id',m.id,'nome',m.nome,'codigo',m.codigo,
      'ativo',m.ativo,'b2b_enabled',m.b2b_enabled,'updated_at',m.updated_at)
      INTO v_out FROM public.microrganismos m WHERE m.id=p_id;
  END IF;
  IF v_out IS NULL THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_b2b_unavailable'; END IF;
  RETURN v_out;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_item_volumes_core(p_item_tipo text, p_item_id uuid, p_limit integer, p_offset integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_parent jsonb; v_items jsonb; v_more boolean;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 50 OR p_offset IS NULL OR p_offset NOT BETWEEN 0 AND 10000 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_volume_invalid'; END IF;
  v_parent:=platform_private.catalog_volume_parent(p_item_tipo,p_item_id,false);
  WITH page AS (
    SELECT v.id, row_number() OVER (ORDER BY v.ordem, v.volume_ml, v.id) rn FROM public.catalogo_volumes v
     WHERE v.item_tipo=p_item_tipo AND COALESCE(v.produto_id,v.microrganismo_id)=p_item_id
     ORDER BY v.ordem, v.volume_ml, v.id LIMIT p_limit+1 OFFSET p_offset)
  SELECT COALESCE(pg_catalog.jsonb_agg(platform_private.catalog_volume_row(id) ORDER BY rn) FILTER (WHERE rn<=p_offset+p_limit),'[]'::jsonb),
         count(*)>p_limit
    INTO v_items, v_more FROM page;
  RETURN pg_catalog.jsonb_build_object('item',pg_catalog.jsonb_build_object('tipo',p_item_tipo,'id',p_item_id,'nome',v_parent->'nome',
      'codigo',v_parent->'codigo','ativo',v_parent->'ativo','pricing',platform_private.catalog_volume_pricing(v_parent) - 'updated_at'),
    'items',v_items,'has_more',v_more);
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_microorganism_detail_core(p_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  -- Projeção sem preços, dose, B2B ou vínculo de produto.
  SELECT pg_catalog.jsonb_build_object('id',m.id,'codigo',m.codigo,'nome',m.nome,'tipo',m.tipo,'nome_cientifico',m.nome_cientifico,
    'concentracao_ufc_ml',m.concentracao_ufc_ml,'concentracao_label',m.concentracao_label,'fornecedor',m.fornecedor,
    'producao_on_farm',m.producao_on_farm,'meio_cultivo',m.meio_cultivo,'funcao_agronomica',m.funcao_agronomica,
    'observacoes',m.observacoes,'descricao',m.descricao,'ativo',m.ativo,'updated_at',m.updated_at)
  INTO v FROM public.microrganismos m WHERE m.id=p_id;
  IF v IS NULL THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_entity_unavailable'; END IF;
  RETURN v;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_microorganisms_core(p_search text, p_limit integer, p_offset integer, p_only_active boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_search text; v_items jsonb; v_count int;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 50 OR p_offset IS NULL OR p_offset NOT BETWEEN 0 AND 1000000
    OR p_only_active IS NULL OR pg_catalog.char_length(COALESCE(p_search,'')) > 120 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_micro_invalid';
  END IF;
  v_search:=pg_catalog.btrim(COALESCE(p_search,''));
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('id',m.id,'codigo',m.codigo,'nome',m.nome,'ativo',m.ativo)
    ORDER BY m.nome, m.id),'[]'::jsonb), count(*)
  INTO v_items, v_count FROM (
    SELECT id,codigo,nome,ativo FROM public.microrganismos
    WHERE (NOT p_only_active OR ativo IS TRUE)
      AND (v_search='' OR pg_catalog.strpos(pg_catalog.lower(nome),pg_catalog.lower(v_search))>0
        OR pg_catalog.strpos(pg_catalog.lower(COALESCE(codigo,'')),pg_catalog.lower(v_search))>0)
    ORDER BY nome, id LIMIT p_limit+1 OFFSET p_offset) m;
  -- has_more por sentinela (limit+1), itens cortados ao limite.
  RETURN pg_catalog.jsonb_build_object('items',
    CASE WHEN v_count>p_limit THEN v_items - p_limit ELSE v_items END,'has_more',v_count>p_limit);
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_product_catalog_by_family_core(p_familia text, p_revisao text, p_search text, p_limit integer, p_offset integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_search text; v_result jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_revisao IS NULL OR p_revisao NOT IN ('familia','todos','pendentes')
     OR (p_revisao = 'familia' AND (p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo')))
     OR (p_revisao <> 'familia' AND p_familia IS NOT NULL)
     OR p_limit IS NULL OR p_limit < 1 OR p_limit > 50
     OR p_offset IS NULL OR p_offset < 0 OR p_offset > 1000000
     OR p_search IS NULL OR pg_catalog.char_length(p_search) > 120 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='platform_catalog_invalid_query';
  END IF;
  v_search := pg_catalog.lower(pg_catalog.btrim(p_search));
  WITH bounded AS MATERIALIZED (
    SELECT p.id, p.codigo, p.nome, p.tipo, COALESCE(p.ativo,false) AS ativo, p.b2b_enabled, p.updated_at,
           p.familia_catalogo, p.classe_catalogo
    FROM public.produtos p
    WHERE ((p_revisao = 'familia' AND p.familia_catalogo IS NOT NULL AND p.familia_catalogo = p_familia)
        OR p_revisao = 'todos'
        OR (p_revisao = 'pendentes' AND p.familia_catalogo IS NULL))
      AND (v_search = ''
       OR pg_catalog.strpos(pg_catalog.lower(p.nome), v_search) > 0
       OR pg_catalog.strpos(pg_catalog.lower(COALESCE(p.codigo, '')), v_search) > 0)
    ORDER BY (p.familia_catalogo IS NULL) DESC, pg_catalog.lower(p.nome) COLLATE "C", p.id
    LIMIT (p_limit + 1) OFFSET p_offset
  ), page AS (
    SELECT * FROM bounded b ORDER BY (b.familia_catalogo IS NULL) DESC, pg_catalog.lower(b.nome) COLLATE "C", b.id LIMIT p_limit
  )
  SELECT pg_catalog.jsonb_build_object(
    'items', COALESCE((SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(r)
      ORDER BY (r.familia_catalogo IS NULL) DESC, pg_catalog.lower(r.nome) COLLATE "C", r.id) FROM page r), '[]'::jsonb),
    'has_more', (SELECT pg_catalog.count(*) > p_limit FROM bounded)
  ) INTO v_result;
  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_product_composition_core(p_produto_id uuid, p_limit integer, p_receita_offset integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_p public.produtos%ROWTYPE; v_result jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  IF p_produto_id IS NULL OR p_limit IS NULL OR p_limit < 1 OR p_limit > 50 OR p_receita_offset IS NULL OR p_receita_offset < 0 OR p_receita_offset > 10000 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_invalid_query'; END IF;
  SELECT * INTO v_p FROM public.produtos WHERE id = p_produto_id;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_composition_unavailable'; END IF;
  WITH rec AS MATERIALIZED (
    SELECT f.id AS formulacao_id, f.microrganismo_id, m.nome AS micro_nome, m.ativo AS micro_ativo, f.component_insumo_id,
           ip.nome AS insumo_nome, f.volume_ml, f.proporcao, f.concentracao, f.unidade, f.e_volume_fixo
    FROM public.formulacoes f JOIN public.microrganismos m ON m.id = f.microrganismo_id
    LEFT JOIN public.produtos ip ON ip.id = f.component_insumo_id
    WHERE f.produto_id = p_produto_id ORDER BY f.created_at, f.id LIMIT p_limit + 1 OFFSET p_receita_offset
  ), dec AS MATERIALIZED (
    SELECT d.id, d.ordem::int AS ordem, d.tipo_componente, d.microrganismo_id, m.nome AS micro_nome, m.ativo AS micro_ativo,
           d.componente_nome, d.quantidade, d.unidade, d.base, d.natureza
    FROM public.produto_composicao_declaracoes d LEFT JOIN public.microrganismos m ON m.id = d.microrganismo_id
    WHERE d.produto_id = p_produto_id ORDER BY d.ordem LIMIT 51
  )
  SELECT pg_catalog.jsonb_build_object(
    'produto', pg_catalog.jsonb_build_object('id',v_p.id,'nome',v_p.nome,'familia_catalogo',v_p.familia_catalogo,'updated_at',v_p.updated_at),
    'conjunto', (SELECT pg_catalog.jsonb_build_object('status',c.status,'updated_at',c.updated_at)
                 FROM public.produto_composicao_conjuntos c WHERE c.produto_id = p_produto_id),
    'receita', COALESCE((SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(r)) FROM (SELECT * FROM rec LIMIT p_limit) r), '[]'::jsonb),
    'receita_offset', p_receita_offset,
    'declaracoes', COALESCE((SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(x) ORDER BY x.ordem) FROM (SELECT * FROM dec LIMIT 50) x), '[]'::jsonb),
    'receita_has_more', (SELECT pg_catalog.count(*) > p_limit FROM rec),
    'declaracoes_has_more', (SELECT pg_catalog.count(*) > 50 FROM dec)) INTO v_result;
  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.read_global_product_metadata_core(p_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_result jsonb;
BEGIN
  PERFORM platform_private.catalog_metadata_require_actor();
  SELECT pg_catalog.jsonb_build_object('id',p.id,'updated_at',p.updated_at,'nome',p.nome,
    'descricao',p.descricao,'modo_acao',p.modo_acao,'funcao_completa',p.funcao_completa,'modo_aplicacao',p.modo_aplicacao)
  INTO v_result FROM public.produtos p WHERE p.id=p_id;
  IF v_result IS NULL THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_metadata_unavailable'; END IF;
  RETURN v_result;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.set_global_b2b_enabled_core(p_item_tipo text, p_id uuid, p_expected_updated_at timestamp with time zone, p_b2b_enabled boolean, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid:=gen_random_uuid();
  v_op public.produtos%ROWTYPE; v_np public.produtos%ROWTYPE;
  v_om public.microrganismos%ROWTYPE; v_nm public.microrganismos%ROWTYPE;
  v_old jsonb; v_new jsonb; v_old_ativo boolean; v_old_b2b boolean; v_old_ver timestamptz; v_new_ver timestamptz;
  v_vols_before jsonb; v_vols_after jsonb;
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_item_tipo IS NULL OR p_item_tipo NOT IN ('produto','microrganismo') OR p_id IS NULL OR p_b2b_enabled IS NULL
    OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_b2b_invalid'; END IF;
  v_req:=pg_catalog.jsonb_build_object('item_tipo',p_item_tipo,'id',p_id,'expected_updated_at',p_expected_updated_at,
    'b2b_enabled',p_b2b_enabled,'reason',pg_catalog.btrim(COALESCE(p_reason,'')));
  -- Motivo/chave validados e replay autorizado ANTES de qualquer efeito (lock por chave).
  v_replay:=platform_private.catalog_entity_replay(v_actor,'set_global_b2b_enabled',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  -- Serialização por item (mesmo lock de linha usado pelos writers de status/apresentações).
  IF p_item_tipo='produto' THEN
    SELECT * INTO v_op FROM public.produtos WHERE id=p_id FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_b2b_unavailable'; END IF;
    v_old:=pg_catalog.to_jsonb(v_op); v_old_ativo:=COALESCE(v_op.ativo,false); v_old_b2b:=v_op.b2b_enabled; v_old_ver:=v_op.updated_at;
  ELSE
    SELECT * INTO v_om FROM public.microrganismos WHERE id=p_id FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_b2b_unavailable'; END IF;
    v_old:=pg_catalog.to_jsonb(v_om); v_old_ativo:=v_om.ativo; v_old_b2b:=v_om.b2b_enabled; v_old_ver:=v_om.updated_at;
  END IF;
  IF v_old_ver IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_b2b_conflict'; END IF;
  IF v_old_b2b = p_b2b_enabled THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_b2b_no_change'; END IF;
  IF p_b2b_enabled AND NOT v_old_ativo THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_b2b_requires_active'; END IF;

  -- Apresentações do item: provamos que não mudam (sem sync de preço disparado aqui).
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_before
    FROM public.catalogo_volumes cv
   WHERE (p_item_tipo='produto' AND cv.produto_id=p_id) OR (p_item_tipo='microrganismo' AND cv.microrganismo_id=p_id);

  IF p_item_tipo='produto' THEN
    UPDATE public.produtos SET b2b_enabled=p_b2b_enabled WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_np;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_b2b_confirmation_failed'; END IF;
    v_new:=pg_catalog.to_jsonb(v_np); v_new_ver:=v_np.updated_at;
  ELSE
    UPDATE public.microrganismos SET b2b_enabled=p_b2b_enabled WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_nm;
    IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_b2b_confirmation_failed'; END IF;
    v_new:=pg_catalog.to_jsonb(v_nm); v_new_ver:=v_nm.updated_at;
  END IF;
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_after
    FROM public.catalogo_volumes cv
   WHERE (p_item_tipo='produto' AND cv.produto_id=p_id) OR (p_item_tipo='microrganismo' AND cv.microrganismo_id=p_id);

  -- Confirmação: somente b2b_enabled/updated_at mudaram; versão estritamente crescente.
  -- (produtos usa update_updated_at_column = now(); se a versão não cresce, falha fechada.)
  IF (v_new->>'b2b_enabled')::boolean IS DISTINCT FROM p_b2b_enabled
    OR v_new_ver IS NULL OR v_new_ver <= v_old_ver
    OR (v_old - ARRAY['b2b_enabled','updated_at']) IS DISTINCT FROM (v_new - ARRAY['b2b_enabled','updated_at'])
    OR v_vols_before IS DISTINCT FROM v_vols_after THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_b2b_confirmation_failed'; END IF;

  v_receipt:=pg_catalog.jsonb_build_object('item_tipo',p_item_tipo,'id',p_id,'ativo',v_old_ativo,'b2b_enabled',p_b2b_enabled,
    'updated_at',v_new_ver,'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'set_global_b2b_enabled',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('item_tipo',p_item_tipo,'id',p_id,'ativo',v_old_ativo,'b2b_enabled',v_old_b2b,'updated_at',v_old_ver),
    pg_catalog.jsonb_build_object('item_tipo',p_item_tipo,'id',p_id,'ativo',v_old_ativo,'b2b_enabled',p_b2b_enabled,'updated_at',v_new_ver));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.set_global_microorganism_status_core(p_id uuid, p_expected_updated_at timestamp with time zone, p_ativo boolean, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_old public.microrganismos%ROWTYPE; v_new public.microrganismos%ROWTYPE; v_receipt jsonb;
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_ativo IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  v_req:=pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,'ativo',p_ativo,'reason',pg_catalog.btrim(COALESCE(p_reason,'')));
  v_replay:=platform_private.catalog_entity_replay(v_actor,'set_global_microorganism_status',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;
  SELECT * INTO v_old FROM public.microrganismos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_entity_unavailable'; END IF;
  IF v_old.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_conflict'; END IF;
  IF v_old.ativo = p_ativo THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_no_change'; END IF;
  -- Arquivar = ativo false; nunca exclui. b2b_enabled/preços não são tocados.
  UPDATE public.microrganismos SET ativo=p_ativo WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_new;
  IF NOT FOUND OR v_new.ativo IS DISTINCT FROM p_ativo OR v_new.updated_at <= v_old.updated_at
    OR (pg_catalog.to_jsonb(v_old) - ARRAY['ativo','updated_at'])
       IS DISTINCT FROM (pg_catalog.to_jsonb(v_new) - ARRAY['ativo','updated_at']) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_confirmation_failed'; END IF;
  v_receipt:=pg_catalog.jsonb_build_object('id',p_id,'ativo',v_new.ativo,'updated_at',v_new.updated_at,
    'idempotency_key',p_idempotency_key,'audit_id',gen_random_uuid(),'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'set_global_microorganism_status',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('ativo',v_old.ativo,'updated_at',v_old.updated_at),
    pg_catalog.jsonb_build_object('ativo',v_new.ativo,'updated_at',v_new.updated_at));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.set_global_product_composition_core(p_produto_id uuid, p_expected_updated_at timestamp with time zone, p_status text, p_itens jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.produtos%ROWTYPE; v_np public.produtos%ROWTYPE; v_e jsonb; v_i int := 0; v_n int;
  v_before jsonb; v_after jsonb; v_form_before text; v_form_after text; v_vol_before text; v_vol_after text;
  v_old_status text; v_keys text[] := ARRAY['base','componente_nome','microrganismo_id','natureza','ordem','quantidade','tipo_componente','unidade'];
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_produto_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) OR p_idempotency_key IS NULL
     OR p_status IS NULL OR p_status NOT IN ('rascunho','completo')
     OR p_itens IS NULL OR pg_catalog.jsonb_typeof(p_itens) <> 'array' OR pg_catalog.jsonb_array_length(p_itens) > 50
     OR (p_status = 'completo' AND pg_catalog.jsonb_array_length(p_itens) = 0) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_invalid'; END IF;
  -- Formato estrito de cada item (chaves exatas, tipos JSON, ordem 1..n sequencial). Valores finais validados pelos CHECKs.
  FOR v_e IN SELECT e FROM pg_catalog.jsonb_array_elements(p_itens) e LOOP
    v_i := v_i + 1;
    IF pg_catalog.jsonb_typeof(v_e) <> 'object'
       OR (SELECT pg_catalog.array_agg(k ORDER BY k) FROM pg_catalog.jsonb_object_keys(v_e) k) IS DISTINCT FROM v_keys
       OR pg_catalog.jsonb_typeof(v_e->'ordem') <> 'number' OR (v_e->>'ordem') <> v_i::text
       OR pg_catalog.jsonb_typeof(v_e->'quantidade') NOT IN ('number','null')
       OR pg_catalog.jsonb_typeof(v_e->'tipo_componente') <> 'string' OR pg_catalog.jsonb_typeof(v_e->'natureza') <> 'string'
       OR pg_catalog.jsonb_typeof(v_e->'microrganismo_id') NOT IN ('string','null')
       OR pg_catalog.jsonb_typeof(v_e->'componente_nome') NOT IN ('string','null')
       OR pg_catalog.jsonb_typeof(v_e->'unidade') NOT IN ('string','null') OR pg_catalog.jsonb_typeof(v_e->'base') NOT IN ('string','null')
       OR (v_e->>'microrganismo_id') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' AND v_e->>'microrganismo_id' IS NOT NULL
       OR (p_status = 'completo' AND v_e->>'quantidade' IS NULL) THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_invalid'; END IF;
    -- No máximo 6 casas decimais (numeric(24,6) arredondaria silenciosamente).
    IF v_e->>'quantidade' IS NOT NULL AND pg_catalog.scale((v_e->>'quantidade')::numeric) > 6 THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_invalid'; END IF;
  END LOOP;
  v_req := pg_catalog.jsonb_build_object('produto_id',p_produto_id,'expected_updated_at',p_expected_updated_at,'status',p_status,
    'itens',p_itens,'reason',pg_catalog.btrim(COALESCE(p_reason,'')));
  v_replay := platform_private.catalog_entity_replay(v_actor,'set_global_product_composition',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  SELECT * INTO v_op FROM public.produtos WHERE id = p_produto_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_composition_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_composition_conflict'; END IF;
  IF v_op.familia_catalogo IS NULL THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_requires_family'; END IF;

  -- Família transacional (após lock) e regras cruzadas com a receita.
  FOR v_e IN SELECT e FROM pg_catalog.jsonb_array_elements(p_itens) e LOOP
    IF NOT platform_private.catalog_composition_type_allowed(v_op.familia_catalogo, v_e->>'tipo_componente') THEN
      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='catalog_composition_family_conflict'; END IF;
    IF v_e->>'tipo_componente' = 'microrganismo' THEN
      -- Nova associação exige micro ativo; micro já declarado (mesmo arquivado depois) pode ser mantido.
      IF NOT EXISTS (SELECT 1 FROM public.microrganismos m WHERE m.id = (v_e->>'microrganismo_id')::uuid
          AND (m.ativo OR EXISTS (SELECT 1 FROM public.produto_composicao_declaracoes d
                 WHERE d.produto_id = p_produto_id AND d.microrganismo_id = m.id))) THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_micro_unavailable'; END IF;
      IF EXISTS (SELECT 1 FROM public.formulacoes f WHERE f.produto_id = p_produto_id
          AND f.microrganismo_id = (v_e->>'microrganismo_id')::uuid AND f.concentracao IS NOT NULL) THEN
        RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='catalog_composition_duplicate_measure'; END IF;
    END IF;
  END LOOP;

  SELECT c.status INTO v_old_status FROM public.produto_composicao_conjuntos c WHERE c.produto_id = p_produto_id FOR UPDATE;
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('ordem',d.ordem,'tipo_componente',d.tipo_componente,
      'microrganismo_id',d.microrganismo_id,'componente_nome',d.componente_nome,'quantidade',d.quantidade,'unidade',d.unidade,
      'base',d.base,'natureza',d.natureza) ORDER BY d.ordem), '[]'::jsonb) INTO v_before
    FROM public.produto_composicao_declaracoes d WHERE d.produto_id = p_produto_id;
  SELECT md5(COALESCE(string_agg(pg_catalog.to_jsonb(f)::text, ',' ORDER BY f.id), '')) INTO v_form_before FROM public.formulacoes f WHERE f.produto_id = p_produto_id;
  SELECT md5(COALESCE(string_agg(pg_catalog.to_jsonb(v)::text, ',' ORDER BY v.id), '')) INTO v_vol_before FROM public.catalogo_volumes v WHERE v.produto_id = p_produto_id;

  INSERT INTO public.produto_composicao_conjuntos (produto_id, status, updated_by) VALUES (p_produto_id, p_status, v_actor)
  ON CONFLICT (produto_id) DO UPDATE SET status = EXCLUDED.status, updated_by = EXCLUDED.updated_by;
  DELETE FROM public.produto_composicao_declaracoes d WHERE d.produto_id = p_produto_id;
  INSERT INTO public.produto_composicao_declaracoes (produto_id, ordem, tipo_componente, microrganismo_id, componente_nome, quantidade, unidade, base, natureza)
  SELECT p_produto_id, (e->>'ordem')::smallint, e->>'tipo_componente', (e->>'microrganismo_id')::uuid, e->>'componente_nome',
         (e->>'quantidade')::numeric, e->>'unidade', e->>'base', e->>'natureza'
  FROM pg_catalog.jsonb_array_elements(p_itens) e;
  GET DIAGNOSTICS v_n = ROW_COUNT;

  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('ordem',d.ordem,'tipo_componente',d.tipo_componente,
      'microrganismo_id',d.microrganismo_id,'componente_nome',d.componente_nome,'quantidade',d.quantidade,'unidade',d.unidade,
      'base',d.base,'natureza',d.natureza) ORDER BY d.ordem), '[]'::jsonb) INTO v_after
    FROM public.produto_composicao_declaracoes d WHERE d.produto_id = p_produto_id;
  IF v_after = v_before AND v_old_status IS NOT DISTINCT FROM p_status THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_composition_no_change'; END IF;

  -- Versão monotônica do produto; demais colunas, receita e apresentações intactas.
  UPDATE public.produtos SET updated_at = updated_at WHERE id = p_produto_id AND updated_at = p_expected_updated_at RETURNING * INTO v_np;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_composition_confirmation_failed'; END IF;
  SELECT md5(COALESCE(string_agg(pg_catalog.to_jsonb(f)::text, ',' ORDER BY f.id), '')) INTO v_form_after FROM public.formulacoes f WHERE f.produto_id = p_produto_id;
  SELECT md5(COALESCE(string_agg(pg_catalog.to_jsonb(v)::text, ',' ORDER BY v.id), '')) INTO v_vol_after FROM public.catalogo_volumes v WHERE v.produto_id = p_produto_id;
  IF v_n <> pg_catalog.jsonb_array_length(p_itens) OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR (pg_catalog.to_jsonb(v_op) - 'updated_at') IS DISTINCT FROM (pg_catalog.to_jsonb(v_np) - 'updated_at')
     OR v_form_before IS DISTINCT FROM v_form_after OR v_vol_before IS DISTINCT FROM v_vol_after THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_composition_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('produto_id',p_produto_id,'status',p_status,'itens',v_n,'updated_at',v_np.updated_at,
    'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'set_global_product_composition',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('produto_id',p_produto_id,'status',v_old_status,'itens',v_before,'updated_at',v_op.updated_at),
    pg_catalog.jsonb_build_object('produto_id',p_produto_id,'status',p_status,'itens',v_after,'updated_at',v_np.updated_at));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.set_global_product_family_core(p_id uuid, p_expected_updated_at timestamp with time zone, p_familia text, p_classe text, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_req jsonb; v_replay jsonb; v_receipt jsonb; v_audit uuid := gen_random_uuid();
  v_op public.produtos%ROWTYPE; v_np public.produtos%ROWTYPE; v_old jsonb; v_new jsonb;
  v_vols_before jsonb; v_vols_after jsonb; v_classe text := NULLIF(pg_catalog.btrim(COALESCE(p_classe,'')), '');
BEGIN
  v_actor := platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) OR p_idempotency_key IS NULL
     OR p_familia IS NULL OR p_familia NOT IN ('biologico','quimico','fertilizante_adubo') THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_invalid';
  END IF;
  v_req := pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,
    'familia_catalogo',p_familia,'classe_catalogo',v_classe,'reason',pg_catalog.btrim(COALESCE(p_reason,'')));
  v_replay := platform_private.catalog_entity_replay(v_actor,'set_global_product_family',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;

  -- Revalidação mutante APÓS o replay: só nova execução exige rótulo ativo (com lock).
  IF NOT (v_classe IS NULL OR platform_private.catalog_family_label_check(p_familia, v_classe)) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_invalid';
  END IF;

  SELECT * INTO v_op FROM public.produtos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_family_unavailable'; END IF;
  IF v_op.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_conflict'; END IF;
  IF v_op.familia_catalogo IS NOT DISTINCT FROM p_familia AND v_op.classe_catalogo IS NOT DISTINCT FROM v_classe THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_family_no_change'; END IF;
  v_old := pg_catalog.to_jsonb(v_op);
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_before
    FROM public.catalogo_volumes cv WHERE cv.produto_id=p_id;

  UPDATE public.produtos SET familia_catalogo=p_familia, classe_catalogo=v_classe
   WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_np;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_confirmation_failed'; END IF;
  v_new := pg_catalog.to_jsonb(v_np);
  SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(cv) ORDER BY cv.id),'[]'::jsonb) INTO v_vols_after
    FROM public.catalogo_volumes cv WHERE cv.produto_id=p_id;
  -- Somente família/classe/versão mudam (ativo, B2B, preços, dose, tipo, código, owner intactos).
  IF v_np.familia_catalogo IS DISTINCT FROM p_familia OR v_np.classe_catalogo IS DISTINCT FROM v_classe
     OR v_np.updated_at IS NULL OR v_np.updated_at <= v_op.updated_at
     OR (v_old - ARRAY['familia_catalogo','classe_catalogo','updated_at']) IS DISTINCT FROM (v_new - ARRAY['familia_catalogo','classe_catalogo','updated_at'])
     OR v_vols_before IS DISTINCT FROM v_vols_after THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_family_confirmation_failed'; END IF;

  v_receipt := pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',p_familia,'classe_catalogo',v_classe,
    'updated_at',v_np.updated_at,'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'set_global_product_family',p_reason,p_idempotency_key,v_req,v_receipt,
    pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',v_op.familia_catalogo,'classe_catalogo',v_op.classe_catalogo,'updated_at',v_op.updated_at),
    pg_catalog.jsonb_build_object('id',p_id,'familia_catalogo',p_familia,'classe_catalogo',v_classe,'updated_at',v_np.updated_at));
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.set_global_product_status_core(p_id uuid, p_expected_updated_at timestamp with time zone, p_ativo boolean, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v_old public.produtos%ROWTYPE; v_new public.produtos%ROWTYPE;
  v_existing public.catalog_platform_admin_audit%ROWTYPE; v_request jsonb; v_receipt jsonb; v_audit uuid:=gen_random_uuid();
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_ativo IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
    OR p_idempotency_key IS NULL OR p_reason IS NULL OR pg_catalog.char_length(pg_catalog.btrim(p_reason)) NOT BETWEEN 10 AND 500 THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_status_invalid';
  END IF;
  v_request:=pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,'ativo',p_ativo,'reason',pg_catalog.btrim(p_reason));
  PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('catalog-metadata:'||p_idempotency_key::text,0));
  SELECT * INTO v_old FROM public.produtos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_status_unavailable'; END IF;
  SELECT * INTO v_existing FROM public.catalog_platform_admin_audit WHERE correlation_id=p_idempotency_key;
  IF FOUND THEN
    IF v_existing.operation<>'set_global_product_status' OR v_existing.actor_id<>v_actor
      OR v_existing.counts_after->'request' IS DISTINCT FROM v_request THEN
      RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_status_conflict';
    END IF;
    RETURN (v_existing.counts_after->'receipt')||pg_catalog.jsonb_build_object('idempotent',true);
  END IF;
  IF v_old.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_status_conflict'; END IF;
  IF COALESCE(v_old.ativo,false)=p_ativo THEN RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_status_no_change'; END IF;
  -- Arquivar = ativo false. Nunca exclui; históricos (pedidos/estoque/fiscal) preservados.
  -- b2b_enabled e preços não são tocados aqui.
  UPDATE public.produtos SET ativo=p_ativo, updated_at=pg_catalog.clock_timestamp()
  WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_new;
  IF NOT FOUND OR v_new.id IS DISTINCT FROM p_id OR v_new.ativo IS DISTINCT FROM p_ativo
    OR v_new.updated_at IS NOT DISTINCT FROM v_old.updated_at OR v_new.updated_at <= v_old.updated_at
    OR (pg_catalog.to_jsonb(v_old)-ARRAY['ativo','updated_at']) IS DISTINCT FROM (pg_catalog.to_jsonb(v_new)-ARRAY['ativo','updated_at']) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_status_confirmation_failed';
  END IF;
  v_receipt:=pg_catalog.jsonb_build_object('id',p_id,'ativo',v_new.ativo,'updated_at',v_new.updated_at,
    'idempotency_key',p_idempotency_key,'audit_id',v_audit,'idempotent',false);
  INSERT INTO public.catalog_platform_admin_audit (id,operation,actor_id,reason,correlation_id,status,counts_before,counts_after,completed_at)
  VALUES (v_audit,'set_global_product_status',v_actor,pg_catalog.btrim(p_reason),p_idempotency_key,'completed',
    pg_catalog.jsonb_build_object('ativo',v_old.ativo),
    pg_catalog.jsonb_build_object('request',v_request,'receipt',v_receipt,'after',pg_catalog.jsonb_build_object('ativo',v_new.ativo)),
    pg_catalog.clock_timestamp());
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.stock_envase_complete_v1(p_os uuid, p_prog uuid, p_lote uuid, p_estado text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
DECLARE org uuid; o public.ordens_servico%ROWTYPE; p public.programacao_producao%ROWTYPE; l public.lotes%ROWTYPE; last_cq text; reserved numeric; prev text;
BEGIN
 org:=platform_private.stock_envase_scope_v1(p_lote,p_prog,p_os,'manual');
 IF p_estado NOT IN ('completed','completed_override') THEN RAISE EXCEPTION 'ENVASE_TRANSITION_STATE' USING ERRCODE='PT409'; END IF;
 IF p_estado='completed_override' AND public.fn_cockpit_is_gestor() IS NOT TRUE THEN RAISE EXCEPTION 'ENVASE_TRANSITION_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO o FROM public.ordens_servico WHERE id=p_os AND organization_id=org FOR UPDATE;
 IF NOT FOUND OR o.origem IS DISTINCT FROM 'agronomica' OR o.partner_order_id IS NOT NULL OR o.partner_order_item_id IS NOT NULL
 OR EXISTS(SELECT 1 FROM public.production_order_link WHERE ordem_servico_id=p_os) THEN RAISE EXCEPTION 'ENVASE_TRANSITION_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF org IS DISTINCT FROM platform_private.stock_envase_scope_v1(p_lote,p_prog,p_os,'manual') THEN RAISE EXCEPTION 'ENVASE_TRANSITION_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 prev:=o.status::text;
 IF prev='pronto_entrega' THEN RETURN jsonb_build_object('success',true,'replay',true,'status','pronto_entrega'); END IF;
 IF prev NOT IN ('em_cq','envase') THEN RAISE EXCEPTION 'ENVASE_TRANSITION_STATE' USING ERRCODE='PT409'; END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=p_prog AND organization_id=org AND ordem_servico_id=p_os AND ordem_servico_onfarm_id IS NULL FOR SHARE;
 SELECT * INTO l FROM public.lotes WHERE id=p_lote AND organization_id=org AND programacao_id=p_prog FOR SHARE;
 IF p.id IS NULL OR l.id IS NULL
 OR (SELECT count(*) FROM public.programacao_producao WHERE ordem_servico_id=p_os OR ordem_servico_onfarm_id=p_os)<>1
 OR (SELECT count(*) FROM public.lotes WHERE programacao_id=p_prog)<>1 THEN RAISE EXCEPTION 'ENVASE_TRANSITION_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Existing CQ criteria, unchanged: lot approved by the reviewed CQ core and latest result aprovado.
 SELECT resultado::text INTO last_cq FROM public.controle_qualidade WHERE lote_id=p_lote ORDER BY created_at DESC, seq DESC LIMIT 1;
 IF l.status::text IS DISTINCT FROM 'aprovado' OR last_cq IS DISTINCT FROM 'aprovado' THEN RAISE EXCEPTION 'ENVASE_TRANSITION_CQ_REQUIRED' USING ERRCODE='PT409'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.envase WHERE lote_id=p_lote AND organization_id=org) THEN RAISE EXCEPTION 'ENVASE_TRANSITION_NO_ENVASE' USING ERRCODE='PT409'; END IF;
 SELECT coalesce(sum(volume_total),0)*1000 INTO reserved FROM public.estoque_produto
  WHERE reservado_para_os_id=p_os AND reservado_para_os_tipo='manual' AND status::text<>'estornado';
 IF p_estado='completed' AND reserved < coalesce(p.volume_necessario,0) THEN RAISE EXCEPTION 'ENVASE_TRANSITION_COVERAGE' USING ERRCODE='PT409'; END IF;
 -- Re-authorize after the programacao/lote/CQ waits and immediately before the first mutation.
 IF org IS DISTINCT FROM platform_private.stock_envase_scope_v1(p_lote,p_prog,p_os,'manual') THEN RAISE EXCEPTION 'ENVASE_TRANSITION_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(pg_catalog.txid_current(),'manual_envase_transition_v1',p_os);
 IF prev='em_cq' THEN UPDATE public.ordens_servico SET status='envase' WHERE id=p_os; END IF;
 UPDATE public.ordens_servico SET status='pronto_entrega' WHERE id=p_os;
 DELETE FROM platform_private.authz_tickets WHERE txid=pg_catalog.txid_current() AND scope='manual_envase_transition_v1' AND target=p_os;
 INSERT INTO public.laboratorio_esteira_eventos(os_id,origem_os,programacao_id,lote_id,etapa_anterior,etapa_nova,acao,usuario_id,observacao)
 VALUES(p_os,'manual',p_prog,p_lote,prev,'pronto_entrega','concluir_envase_v2',auth.uid(),jsonb_build_object('estado',p_estado,'reservado_ml',reserved,'cq','aprovado')::text);
 RETURN jsonb_build_object('success',true,'replay',false,'status','pronto_entrega','status_anterior',prev);
END $function$;
CREATE OR REPLACE FUNCTION platform_private.stock_envase_mutation_gate_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
 SET lock_timeout TO '3s'
AS $function$
BEGIN
 IF TG_LEVEL<>'STATEMENT' OR TG_WHEN<>'BEFORE' OR TG_OP NOT IN ('INSERT','UPDATE','DELETE','TRUNCATE')
 OR TG_RELID NOT IN ('public.organizations'::regclass,'public.organization_subscriptions'::regclass,'public.saas_plan_versions'::regclass,'public.saas_plan_version_features'::regclass,'public.saas_features'::regclass,'public.saas_modules'::regclass,'public.organization_feature_overrides'::regclass,'public.clientes'::regclass,'public.programacao_producao'::regclass,'public.ordens_servico'::regclass,'public.lotes'::regclass,'public.controle_qualidade'::regclass,'public.estoque_produto'::regclass) THEN RAISE EXCEPTION 'ENVASE_GATE_CONTEXT_DENIED' USING ERRCODE='42501'; END IF;
 -- Existing upstream RPCs can prelock business rows before their first DML.
 -- Never wait here while owning those rows: reject contention atomically instead
 -- of closing the singleton/business-row deadlock cycle.
 PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE NOWAIT;
 IF NOT FOUND THEN RAISE EXCEPTION 'STOCK_GATE_UNAVAILABLE' USING ERRCODE='PT503'; END IF;
 RETURN NULL;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.stock_envase_reservation_root_v1()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE p public.programacao_producao%ROWTYPE; l public.lotes%ROWTYPE; o public.ordens_servico%ROWTYPE;
BEGIN
 IF NEW.status::text<>'reservado' OR NEW.reservado_para_os_tipo IS DISTINCT FROM 'manual' THEN RETURN NEW; END IF;
 IF TG_OP='UPDATE' AND NEW.status IS NOT DISTINCT FROM OLD.status AND NEW.lote_id IS NOT DISTINCT FROM OLD.lote_id AND NEW.reservado_para_os_id IS NOT DISTINCT FROM OLD.reservado_para_os_id THEN RETURN NEW; END IF;
 SELECT * INTO o FROM public.ordens_servico WHERE id=NEW.reservado_para_os_id;
 SELECT * INTO p FROM public.programacao_producao WHERE ordem_servico_id=o.id;
 IF NOT FOUND THEN RETURN NEW; END IF;
 SELECT * INTO l FROM public.lotes WHERE id=NEW.lote_id;
 IF o.status::text NOT IN ('em_cq','envase','pronto_entrega') OR l.programacao_id IS DISTINCT FROM p.id OR l.organization_id IS DISTINCT FROM o.organization_id OR p.organization_id IS DISTINCT FROM o.organization_id
 OR NEW.produto_id IS DISTINCT FROM p.produto_id OR NEW.microrganismo_id IS DISTINCT FROM p.microrganismo_id OR NEW.reservado_para_cliente_id IS DISTINCT FROM o.cliente_id
 OR (SELECT count(*) FROM public.programacao_producao WHERE ordem_servico_id=o.id)<>1 THEN RAISE EXCEPTION 'ENVASE_RESERVATION_LINEAGE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.stock_envase_scope_v1(p_lote uuid, p_prog uuid, p_os uuid, p_origem text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE org uuid; p public.programacao_producao%ROWTYPE; o public.ordens_servico%ROWTYPE; l public.lotes%ROWTYPE;
BEGIN
 org:=platform_private.stock_motor_actor('reserva');
 IF public.technical_actor_ready(auth.uid()) IS NOT TRUE OR public._saas_user_has_feature(auth.uid(),'envase') IS NOT TRUE
 OR public._saas_user_has_feature(auth.uid(),'ordens_producao') IS NOT TRUE THEN RAISE EXCEPTION 'ENVASE_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF public.fn_cockpit_norm_origem(p_origem) IS DISTINCT FROM 'manual' THEN RAISE EXCEPTION 'ENVASE_ORIGIN_COMPOSITION_PENDING' USING ERRCODE='42501'; END IF;
 IF (public.has_role(auth.uid(),'administrador') OR public.has_role(auth.uid(),'gestor') OR public.has_role(auth.uid(),'producao')) IS NOT TRUE THEN RAISE EXCEPTION 'ENVASE_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=p_prog AND organization_id=org;
 IF NOT FOUND OR p.ordem_servico_id IS DISTINCT FROM p_os OR p.ordem_servico_onfarm_id IS NOT NULL THEN RAISE EXCEPTION 'ENVASE_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO o FROM public.ordens_servico WHERE id=p_os AND organization_id=org;
 IF NOT FOUND OR o.partner_order_id IS NOT NULL OR o.partner_order_item_id IS NOT NULL OR o.origem IS DISTINCT FROM 'agronomica'
 OR NOT EXISTS(SELECT 1 FROM public.clientes WHERE id=o.cliente_id AND organization_id=org) THEN RAISE EXCEPTION 'ENVASE_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO l FROM public.lotes WHERE id=p_lote AND organization_id=org;
 IF NOT FOUND OR l.programacao_id IS DISTINCT FROM p_prog OR l.produto_id IS DISTINCT FROM p.produto_id
 OR l.microrganismo_id IS DISTINCT FROM p.microrganismo_id THEN RAISE EXCEPTION 'ENVASE_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN org;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.stock_motor_actor(p_acao text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$ DECLARE v_org uuid; BEGIN
 IF auth.uid() IS NULL THEN RAISE EXCEPTION 'ESTQ_NAO_AUTENTICADO' USING ERRCODE='42501'; END IF;
 v_org:=public.h15_actor_organization();
 IF v_org IS NULL THEN RAISE EXCEPTION 'ESTQ_IDENTIDADE_INATIVA' USING ERRCODE='42501'; END IF;
 IF NOT coalesce(public.fn_estoque_pode_operar(auth.uid(),p_acao),false) THEN RAISE EXCEPTION 'ESTQ_SEM_PERMISSAO' USING ERRCODE='42501'; END IF;
 IF NOT coalesce(public.saas_has_feature('estoque_embalagens'),false) THEN RAISE EXCEPTION 'ESTQ_FEATURE_REQUIRED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.stock_p1_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
 v_org uuid := public.h15_actor_organization();
 v_ref uuid;
 v_lote public.lotes%ROWTYPE;
BEGIN
 IF auth.uid() IS NULL OR v_org IS NULL THEN
  RAISE EXCEPTION 'ESTQ_TENANT_FORBIDDEN' USING ERRCODE='42501';
 END IF;
 IF TG_OP IN ('UPDATE','DELETE') AND NOT platform_private.stock_p1_lote_owned(OLD.lote_id) THEN
  RAISE EXCEPTION 'ESTQ_TENANT_FORBIDDEN' USING ERRCODE='42501';
 END IF;
 IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;
 IF NOT platform_private.stock_p1_lote_owned(NEW.lote_id) THEN
  RAISE EXCEPTION 'ESTQ_TENANT_FORBIDDEN' USING ERRCODE='42501';
 END IF;
 SELECT * INTO v_lote FROM public.lotes WHERE id=NEW.lote_id;
 -- Explicit lote ownership is required; parent references never assign ownership.
 IF v_lote.programacao_id IS NOT NULL AND NOT EXISTS (
  SELECT 1 FROM public.programacao_producao p
   WHERE p.id=v_lote.programacao_id AND p.organization_id=v_org
 ) THEN RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NEW.envase_id IS NOT NULL AND NOT EXISTS (
  SELECT 1 FROM public.envase e WHERE e.id=NEW.envase_id
   AND e.lote_id=NEW.lote_id AND e.organization_id=v_org
 ) THEN RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NEW.reservado_para_cliente_id IS NOT NULL AND NOT EXISTS (
  SELECT 1 FROM public.clientes c WHERE c.id=NEW.reservado_para_cliente_id AND c.organization_id=v_org
 ) THEN RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NEW.reservado_para_partner_id IS NOT NULL AND NOT coalesce(public.b2b_phase1_partner_visible(NEW.reservado_para_partner_id,false),false) THEN
  RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501';
 END IF;
 IF NEW.reservado_para_partner_order_id IS NOT NULL AND NOT EXISTS (
  SELECT 1 FROM public.partner_orders o WHERE o.id=NEW.reservado_para_partner_order_id
    AND o.partner_id=NEW.reservado_para_partner_id
    AND public.b2b_phase1_order_visible(o.id)
 ) THEN RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501'; END IF;
 IF NEW.reservado_para_os_id IS NOT NULL THEN
  IF NEW.reservado_para_os_tipo IN ('onfarm','on_farm') THEN
   SELECT c.organization_id INTO v_ref FROM public.ordens_servico_onfarm o
    JOIN public.clientes c ON c.id=o.cliente_id WHERE o.id=NEW.reservado_para_os_id;
  ELSIF NEW.reservado_para_os_tipo IN ('manual','b2b') THEN
   SELECT o.organization_id INTO v_ref FROM public.ordens_servico o WHERE o.id=NEW.reservado_para_os_id;
  ELSE
   RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501';
  END IF;
  IF v_ref IS DISTINCT FROM v_org THEN
   RAISE EXCEPTION 'ESTQ_REFERENCE_FORBIDDEN' USING ERRCODE='42501';
  END IF;
 END IF;
 RETURN NEW;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.stock_p1_lote_owned(p_lote uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 SELECT auth.uid() IS NOT NULL AND EXISTS (
   SELECT 1 FROM public.lotes l
   WHERE l.id = p_lote AND l.organization_id IS NOT NULL
     AND l.organization_id = public.h15_actor_organization()
 );
$function$;
CREATE OR REPLACE FUNCTION platform_private.storage1_application_allowed(p_name text, p_action text)
 RETURNS boolean
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE org uuid; r platform_private.application_save_preparations%ROWTYPE; a public.aplicacoes%ROWTYPE;
 client uuid; os_org uuid; product uuid; staff boolean; u uuid:=auth.uid(); responsible uuid; own_role boolean; os_status text; lot uuid;
BEGIN
 IF auth.uid() IS NULL OR public.storage1_path_strict(p_name) IS DISTINCT FROM true OR p_action IS NULL
 OR p_action NOT IN ('select','insert','update','delete') OR p_name !~ '^[0-9a-f-]{36}/[0-9a-f-]{36}/[A-Za-z0-9_.-]+$' THEN RETURN false; END IF;
 org:=public.h15_actor_organization(); IF org IS NULL THEN RETURN false; END IF;
 SELECT * INTO r FROM platform_private.application_save_preparations WHERE application_id=split_part(p_name,'/',2)::uuid;
 IF p_action='insert' AND r.application_id IS NOT NULL THEN
 IF r.actor_id IS DISTINCT FROM auth.uid() OR r.organization_id IS DISTINCT FROM org OR r.committed_at IS NOT NULL
 OR r.expires_at<=clock_timestamp() OR r.client_id::text IS DISTINCT FROM split_part(p_name,'/',1)
 OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(r.manifest) ev WHERE ev->>'storage_path'=p_name)
 OR public.can_user_create_aplicacao_for_cliente(r.client_id) IS DISTINCT FROM true THEN RETURN false; END IF;
 -- Exact current RPC membership branch: a broad operator/applicator role must
 -- not rescue a revoked consultant/technical/producer portfolio.
 IF (public.has_role(u,'cliente_produtor') OR public.has_role(u,'consultor_tecnico') OR public.has_role(u,'tecnico_agronomo'))
 AND NOT (public.has_role(u,'administrador') OR public.has_role(u,'gestor') OR public.has_role(u,'administrativo'))
 AND NOT r.client_id=ANY(public.get_cliente_ids_for_user(u)) THEN RETURN false; END IF;
 responsible:=nullif(r.payload->>'responsavel_id','')::uuid;
 IF NOT EXISTS(SELECT 1 FROM public.profiles WHERE user_id=responsible AND organization_id=org AND ativo IS TRUE AND senha_provisoria IS FALSE)
 OR NOT EXISTS(SELECT 1 FROM public.user_roles WHERE user_id=responsible AND role::text IN
 ('administrador','gestor','administrativo','consultor_tecnico','tecnico_agronomo','aplicador','operador_onfarm','cliente_produtor'))
 OR platform_private.platform_actor_access_ready(responsible) IS DISTINCT FROM true THEN RETURN false; END IF;
 own_role:=public.has_role(u,'administrador') OR public.has_role(u,'gestor') OR public.has_role(u,'administrativo') OR public.has_role(u,'consultor_tecnico');
 IF NOT own_role AND responsible IS DISTINCT FROM u THEN RETURN false; END IF;
 lot:=nullif(r.payload->>'lote_usado_id','')::uuid;
 IF r.payload->>'ordem_servico_id' IS NOT NULL THEN
 SELECT cliente_id,organization_id,produto_id,status::text INTO client,os_org,product,os_status FROM public.ordens_servico WHERE id=(r.payload->>'ordem_servico_id')::uuid;
 ELSE SELECT os.cliente_id,c.organization_id,os.produto_id,os.status::text INTO client,os_org,product,os_status FROM public.ordens_servico_onfarm os JOIN public.clientes c ON c.id=os.cliente_id WHERE os.id=(r.payload->>'ordem_servico_onfarm_id')::uuid; END IF;
 RETURN client=r.client_id AND os_org=org AND product::text=r.payload->>'produto_usado_id'
 AND (os_status IN ('entregue','pronto_entrega','envase') OR (r.rectify_id IS NOT NULL AND os_status='finalizada'))
 AND (lot IS NULL OR EXISTS(SELECT 1 FROM public.lotes WHERE id=lot AND produto_id=product AND organization_id=org AND status='aprovado'))
 AND EXISTS(SELECT 1 FROM public.clientes WHERE id=client AND organization_id=org)
 AND EXISTS(SELECT 1 FROM public.produtos WHERE id=product AND ativo IS TRUE)
 AND (r.rectify_id IS NULL OR EXISTS(SELECT 1 FROM public.aplicacoes WHERE id=r.rectify_id AND organization_id=org AND is_latest IS TRUE)
 AND public.can_user_manage_aplicacao(r.rectify_id) AND public.can_user_access_aplicacao(r.rectify_id))
 AND public.h15_actor_organization()=org;
 END IF;
 SELECT * INTO a FROM public.aplicacoes WHERE id=split_part(p_name,'/',2)::uuid;
 IF NOT FOUND OR a.organization_id IS DISTINCT FROM org OR (a.ordem_servico_id IS NULL)=(a.ordem_servico_onfarm_id IS NULL) THEN RETURN false; END IF;
 IF a.ordem_servico_id IS NOT NULL THEN SELECT cliente_id,organization_id INTO client,os_org FROM public.ordens_servico WHERE id=a.ordem_servico_id;
 ELSE SELECT os.cliente_id,c.organization_id INTO client,os_org FROM public.ordens_servico_onfarm os JOIN public.clientes c ON c.id=os.cliente_id WHERE os.id=a.ordem_servico_onfarm_id; END IF;
 IF client::text IS DISTINCT FROM split_part(p_name,'/',1) OR os_org IS DISTINCT FROM org
 OR NOT EXISTS(SELECT 1 FROM public.clientes WHERE id=client AND organization_id=org) THEN RETURN false; END IF;
 staff:=NOT public.has_role(auth.uid(),'aplicador') OR public.has_role(auth.uid(),'administrador') OR public.has_role(auth.uid(),'gestor')
 OR public.has_role(auth.uid(),'administrativo') OR public.has_role(auth.uid(),'consultor_tecnico') OR a.responsavel_id=auth.uid()
 OR client=ANY(public.get_cliente_ids_for_user(auth.uid()));
 IF p_action='select' THEN RETURN staff AND public.can_user_access_aplicacao(a.id); END IF;
 -- Finalized objects are immutable. Deletion remains denied when metadata references bytes.
 IF p_action IN ('insert','update') THEN RETURN false; END IF;
 RETURN staff AND a.is_latest IS TRUE AND public.can_user_manage_aplicacao(a.id)
 AND NOT EXISTS(SELECT 1 FROM public.aplicacao_evidencias WHERE storage_path=p_name);
EXCEPTION WHEN invalid_text_representation THEN RETURN false;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.trg_lab_lot_biological_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP='UPDATE' AND NEW.produto_id IS NOT DISTINCT FROM OLD.produto_id
                    AND NEW.microrganismo_id IS NOT DISTINCT FROM OLD.microrganismo_id THEN RETURN NEW; END IF;
  PERFORM platform_private.lab_assert_manufacturable(NEW.produto_id,NEW.microrganismo_id);
  RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.trg_lab_os_biological_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP='UPDATE' AND NEW.produto_id IS NOT DISTINCT FROM OLD.produto_id
    AND NEW.microrganismo_id IS NOT DISTINCT FROM OLD.microrganismo_id THEN RETURN NEW; END IF;
  PERFORM platform_private.lab_assert_manufacturable(NEW.produto_id,NEW.microrganismo_id);
  RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.trg_lab_programming_biological_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP='UPDATE' AND NEW.produto_id IS NOT DISTINCT FROM OLD.produto_id
                    AND NEW.microrganismo_id IS NOT DISTINCT FROM OLD.microrganismo_id THEN RETURN NEW; END IF;
  PERFORM platform_private.lab_assert_manufacturable(NEW.produto_id,NEW.microrganismo_id);
  RETURN NEW;
END $function$;
CREATE OR REPLACE FUNCTION platform_private.update_global_microorganism_core(p_id uuid, p_expected_updated_at timestamp with time zone, p_patch jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_actor uuid; v jsonb; v_req jsonb; v_replay jsonb; v_old public.microrganismos%ROWTYPE; v_new public.microrganismos%ROWTYPE;
  v_before jsonb; v_after jsonb; v_receipt jsonb; v_keys text[];
BEGIN
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at) THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_entity_invalid'; END IF;
  v:=platform_private.catalog_micro_normalize(p_patch,false);
  v_req:=pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,'patch',v,'reason',pg_catalog.btrim(p_reason));
  v_replay:=platform_private.catalog_entity_replay(v_actor,'update_global_microorganism',v_req,p_reason,p_idempotency_key);
  IF v_replay IS NOT NULL THEN RETURN v_replay; END IF;
  SELECT * INTO v_old FROM public.microrganismos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_entity_unavailable'; END IF;
  IF v_old.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_conflict'; END IF;
  v_before:=platform_private.read_global_microorganism_detail_core(p_id);
  SELECT pg_catalog.array_agg(k) INTO v_keys FROM pg_catalog.jsonb_object_keys(v) k;
  BEGIN
    UPDATE public.microrganismos SET
      nome=CASE WHEN v ? 'nome' THEN v->>'nome' ELSE nome END,
      nome_cientifico=CASE WHEN v ? 'nome_cientifico' THEN v->>'nome_cientifico' ELSE nome_cientifico END,
      concentracao_ufc_ml=CASE WHEN v ? 'concentracao_ufc_ml' THEN (v->>'concentracao_ufc_ml')::numeric ELSE concentracao_ufc_ml END,
      concentracao_label=CASE WHEN v ? 'concentracao_label' THEN v->>'concentracao_label' ELSE concentracao_label END,
      fornecedor=CASE WHEN v ? 'fornecedor' THEN v->>'fornecedor' ELSE fornecedor END,
      producao_on_farm=CASE WHEN v ? 'producao_on_farm' THEN (v->>'producao_on_farm')::boolean ELSE producao_on_farm END,
      meio_cultivo=CASE WHEN v ? 'meio_cultivo' THEN v->>'meio_cultivo' ELSE meio_cultivo END,
      funcao_agronomica=CASE WHEN v ? 'funcao_agronomica' THEN v->>'funcao_agronomica' ELSE funcao_agronomica END,
      observacoes=CASE WHEN v ? 'observacoes' THEN v->>'observacoes' ELSE observacoes END,
      descricao=CASE WHEN v ? 'descricao' THEN v->>'descricao' ELSE descricao END
    WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_new;
  EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION USING ERRCODE='23505', MESSAGE='catalog_entity_duplicate';
  END;
  -- Confirma linha/ID/versão e que NENHUMA coluna fora da whitelist mudou — inclusive preços (valor_dose_brl,
  -- valor_litro_brl, preco_tabela), dose, B2B, código, produto e ativo. Se algum trigger (ex.: guard de preço
  -- canônico) recalcular campo protegido, a edição descritiva aborta integralmente (rollback da transação).
  IF NOT FOUND OR v_new.id IS DISTINCT FROM p_id OR v_new.updated_at <= v_old.updated_at
    OR (pg_catalog.to_jsonb(v_old) - v_keys - 'updated_at')
       IS DISTINCT FROM (pg_catalog.to_jsonb(v_new) - v_keys - 'updated_at') THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_entity_confirmation_failed'; END IF;
  v_after:=platform_private.read_global_microorganism_detail_core(p_id);
  v_receipt:=pg_catalog.jsonb_build_object('id',p_id,'ativo',v_new.ativo,'updated_at',v_new.updated_at,
    'idempotency_key',p_idempotency_key,'audit_id',gen_random_uuid(),'idempotent',false);
  PERFORM platform_private.catalog_entity_audit(v_actor,'update_global_microorganism',p_reason,p_idempotency_key,v_req,v_receipt,v_before,v_after);
  RETURN v_receipt;
END;
$function$;
CREATE OR REPLACE FUNCTION platform_private.update_global_product_metadata_core(p_id uuid, p_expected_updated_at timestamp with time zone, p_patch jsonb, p_reason text, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_actor uuid; v_old public.produtos%ROWTYPE; v_new public.produtos%ROWTYPE;
  v_existing public.catalog_platform_admin_audit%ROWTYPE;
  v_patch jsonb:='{}'::jsonb; v_before jsonb:='{}'::jsonb; v_after jsonb:='{}'::jsonb;
  v_request jsonb; v_receipt jsonb; v_audit uuid; v_field text; v_text text;
  v_fields constant text[]:=ARRAY['nome','descricao','modo_acao','funcao_completa','modo_aplicacao'];
BEGIN
  -- Direct core calls have EXACTLY the wrapper's authorization/validation; no
  -- caller/GUC ticket can bypass these checks. service_role without actor denied.
  v_actor:=platform_private.catalog_metadata_require_actor();
  IF p_id IS NULL OR p_expected_updated_at IS NULL OR NOT pg_catalog.isfinite(p_expected_updated_at)
    OR p_idempotency_key IS NULL OR p_reason IS NULL OR pg_catalog.char_length(pg_catalog.btrim(p_reason)) NOT BETWEEN 10 AND 500
    OR pg_catalog.jsonb_typeof(p_patch) IS DISTINCT FROM 'object' OR p_patch='{}'::jsonb THEN
    RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_metadata_invalid';
  END IF;
  FOR v_field IN SELECT pg_catalog.jsonb_object_keys(p_patch) LOOP
    IF NOT (v_field=ANY(v_fields)) OR pg_catalog.jsonb_typeof(p_patch->v_field) NOT IN ('string','null') THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_metadata_invalid';
    END IF;
    v_text:=p_patch->>v_field;
    IF v_field='nome' THEN
      IF v_text IS NULL OR pg_catalog.char_length(pg_catalog.btrim(v_text)) NOT BETWEEN 1 AND 500 THEN
        RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_metadata_invalid';
      END IF;
      v_text:=pg_catalog.btrim(v_text);
    ELSIF pg_catalog.char_length(v_text)>10000 THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_metadata_invalid';
    END IF;
    v_patch:=v_patch || pg_catalog.jsonb_build_object(v_field,v_text);
  END LOOP;
  -- Serialize globally unique correlation BEFORE product lock. Same key on
  -- different actor/target cannot expose a replay; comparison happens after auth.
  PERFORM pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('catalog-metadata:'||p_idempotency_key::text,0));
  SELECT * INTO v_old FROM public.produtos WHERE id=p_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION USING ERRCODE='42501', MESSAGE='catalog_metadata_unavailable'; END IF;
  v_request:=pg_catalog.jsonb_build_object('id',p_id,'expected_updated_at',p_expected_updated_at,
    'patch',v_patch,'reason',pg_catalog.btrim(p_reason));
  SELECT * INTO v_existing FROM public.catalog_platform_admin_audit WHERE correlation_id=p_idempotency_key;
  IF FOUND THEN
    IF v_existing.operation<>'update_global_product_metadata' OR v_existing.actor_id<>v_actor
      OR v_existing.counts_after->'request' IS DISTINCT FROM v_request THEN
      RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_metadata_conflict';
    END IF;
    RETURN (v_existing.counts_after->'receipt') || pg_catalog.jsonb_build_object('idempotent',true);
  END IF;
  IF v_old.updated_at IS DISTINCT FROM p_expected_updated_at THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_metadata_conflict';
  END IF;
  FOR v_field IN SELECT pg_catalog.jsonb_object_keys(v_patch) LOOP
    IF pg_catalog.to_jsonb(v_old)->v_field IS NOT DISTINCT FROM v_patch->v_field THEN
      RAISE EXCEPTION USING ERRCODE='22023', MESSAGE='catalog_metadata_no_change';
    END IF;
    v_before:=v_before || pg_catalog.jsonb_build_object(v_field,pg_catalog.to_jsonb(v_old)->v_field);
  END LOOP;
  UPDATE public.produtos SET
    nome=CASE WHEN v_patch?'nome' THEN v_patch->>'nome' ELSE nome END,
    descricao=CASE WHEN v_patch?'descricao' THEN v_patch->>'descricao' ELSE descricao END,
    modo_acao=CASE WHEN v_patch?'modo_acao' THEN v_patch->>'modo_acao' ELSE modo_acao END,
    funcao_completa=CASE WHEN v_patch?'funcao_completa' THEN v_patch->>'funcao_completa' ELSE funcao_completa END,
    modo_aplicacao=CASE WHEN v_patch?'modo_aplicacao' THEN v_patch->>'modo_aplicacao' ELSE modo_aplicacao END,
    updated_at=pg_catalog.clock_timestamp()
  WHERE id=p_id AND updated_at=p_expected_updated_at RETURNING * INTO v_new;
  IF NOT FOUND OR v_new.id IS DISTINCT FROM p_id OR v_new.updated_at IS NOT DISTINCT FROM v_old.updated_at
    OR (pg_catalog.to_jsonb(v_old)-(v_fields||ARRAY['updated_at'])) IS DISTINCT FROM
       (pg_catalog.to_jsonb(v_new)-(v_fields||ARRAY['updated_at'])) THEN
    RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_metadata_confirmation_failed';
  END IF;
  FOR v_field IN SELECT pg_catalog.jsonb_object_keys(v_patch) LOOP
    IF pg_catalog.to_jsonb(v_new)->v_field IS DISTINCT FROM v_patch->v_field THEN
      RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_metadata_confirmation_failed';
    END IF;
    v_after:=v_after || pg_catalog.jsonb_build_object(v_field,pg_catalog.to_jsonb(v_new)->v_field);
  END LOOP;
  FOREACH v_field IN ARRAY v_fields LOOP
    IF NOT (v_patch?v_field) AND pg_catalog.to_jsonb(v_old)->v_field IS DISTINCT FROM pg_catalog.to_jsonb(v_new)->v_field THEN
      RAISE EXCEPTION USING ERRCODE='40001', MESSAGE='catalog_metadata_confirmation_failed';
    END IF;
  END LOOP;
  v_audit:=pg_catalog.gen_random_uuid();
  v_receipt:=pg_catalog.jsonb_build_object('id',p_id,'updated_at',v_new.updated_at,
    'idempotency_key',p_idempotency_key,'idempotent',false,'audit_id',v_audit);
  INSERT INTO public.catalog_platform_admin_audit(id,operation,actor_id,reason,correlation_id,status,counts_before,counts_after,completed_at)
  VALUES(v_audit,'update_global_product_metadata',v_actor,pg_catalog.btrim(p_reason),p_idempotency_key,'completed',
    pg_catalog.jsonb_build_object('values',v_before),pg_catalog.jsonb_build_object('values',v_after,'request',v_request,'receipt',v_receipt),pg_catalog.clock_timestamp());
  RETURN v_receipt;
END;
$function$;
