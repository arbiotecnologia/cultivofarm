  ('registros_consultor_recomendacoes','rc_recomendacoes_select_hardened','SELECT','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR can_view_technical_visit(( SELECT auth.uid() AS uid), registro_consultor_id) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = registros_consultor_recomendacoes.registro_consultor_id) AND ((r.consultor_responsavel = ( SELECT auth.uid() AS uid)) OR (r.created_by = ( SELECT auth.uid() AS uid)) OR has_active_user_cliente_access(( SELECT auth.uid() AS uid), r.cliente_id, ARRAY[''read''::text, ''execute''::text, ''manage''::text]) OR (platform_private.has_role(( SELECT auth.uid() AS uid), ''cliente_produtor''::app_role) AND can_user_access_cliente(r.cliente_id) AND (r.status = ANY (ARRAY[''aprovado''::status_registro_consultor, ''finalizado''::status_registro_consultor, ''convertido_os''::status_registro_consultor]))))))))',NULL),
  ('registros_consultor_recomendacoes','rc_recomendacoes_update_hardened','UPDATE','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR can_manage_technical_visit(( SELECT auth.uid() AS uid), registro_consultor_id) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = registros_consultor_recomendacoes.registro_consultor_id) AND ((r.consultor_responsavel = ( SELECT auth.uid() AS uid)) OR (r.created_by = ( SELECT auth.uid() AS uid))) AND has_active_user_cliente_access(( SELECT auth.uid() AS uid), r.cliente_id, ARRAY[''execute''::text, ''manage''::text])))))','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR can_manage_technical_visit(( SELECT auth.uid() AS uid), registro_consultor_id) OR (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = registros_consultor_recomendacoes.registro_consultor_id) AND ((r.consultor_responsavel = ( SELECT auth.uid() AS uid)) OR (r.created_by = ( SELECT auth.uid() AS uid))) AND has_active_user_cliente_access(( SELECT auth.uid() AS uid), r.cliente_id, ARRAY[''execute''::text, ''manage''::text])))))'),
  ('registros_consultor_recomendacoes','technical_child_tenant_scope','ALL','RESTRICTIVE','authenticated','technical_child_read_scope(registro_consultor_id)','(can_manage_technical_visit(auth.uid(), registro_consultor_id) OR (can_view_technical_visit(auth.uid(), registro_consultor_id) AND is_active_visit_participant(auth.uid(), registro_consultor_id) AND (EXISTS ( SELECT 1
   FROM registros_consultor r
  WHERE ((r.id = registros_consultor_recomendacoes.registro_consultor_id) AND technical_client_link(auth.uid(), r.cliente_id, ARRAY[''execute''::text, ''manage''::text]))))))'),
  ('talhao_safras','Admins can delete talhao_safras','DELETE','PERMISSIVE','authenticated','platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role)',NULL),
  ('talhao_safras','Authenticated users can read talhao_safras','SELECT','PERMISSIVE','authenticated','(EXISTS ( SELECT 1
   FROM talhoes t
  WHERE ((t.id = talhao_safras.talhao_id) AND can_user_access_fazenda(t.fazenda_id))))',NULL),
  ('talhao_safras','Staff manage talhao safras','ALL','PERMISSIVE','authenticated','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))','(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role))'),
  ('visitas_campo','technical_child_tenant_scope','ALL','RESTRICTIVE','authenticated','technical_child_read_scope(registro_consultor_id)','(can_manage_technical_visit(auth.uid(), registro_consultor_id) OR (can_view_technical_visit(auth.uid(), registro_consultor_id) AND is_active_visit_participant(auth.uid(), registro_consultor_id) AND (EXISTS ( SELECT 1
