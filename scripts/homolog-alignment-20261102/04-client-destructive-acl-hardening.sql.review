-- 04 RESTRIÇÃO OPERACIONAL ACL CLIENTE (homolog ou produção; pode preceder alinhamento/migração do catálogo).
-- Só REVOKE de TRUNCATE/TRIGGER/REFERENCES de PUBLIC/anon/authenticated nas 59 tabelas do escopo.
-- Não toca SELECT/INSERT/UPDATE/DELETE (CRUD via API/RLS/RPC preservado), service_role, owner, funções nem dados. Idempotente.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $h$ DECLARE r record; v_crud_before bigint; v_crud_after bigint; v_fail text[] := ARRAY[]::text[];
  v_crud text := 'SELECT count(*) FROM unnest($1) t, unnest(ARRAY[''anon'',''authenticated'',''service_role'']) rl, unnest(ARRAY[''SELECT'',''INSERT'',''UPDATE'',''DELETE'']) pv WHERE to_regclass(''public.''||t) IS NOT NULL AND has_table_privilege(rl, ''public.''||t, pv)';
BEGIN
  EXECUTE v_crud INTO v_crud_before USING ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[];
  FOR r IN SELECT t FROM unnest(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t WHERE to_regclass('public.'||t) IS NOT NULL LOOP
    EXECUTE format('REVOKE TRUNCATE, TRIGGER, REFERENCES ON public.%I FROM PUBLIC, anon, authenticated', r.t);
  END LOOP;
  EXECUTE v_crud INTO v_crud_after USING ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[];
  IF v_crud_before <> v_crud_after THEN v_fail := v_fail || ('crud_changed:'||v_crud_before||'->'||v_crud_after); END IF;
  FOR r IN SELECT t, rl, pv FROM unnest(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t, unnest(ARRAY['public','anon','authenticated']) rl, unnest(ARRAY['TRUNCATE','TRIGGER','REFERENCES']) pv
           WHERE to_regclass('public.'||t) IS NOT NULL AND has_table_privilege(rl, 'public.'||t, pv) LOOP
    v_fail := v_fail || (r.t||':'||r.rl||':'||r.pv);  -- ex.: herdado de role-membro; abortar em vez de mascarar
  END LOOP;
  IF cardinality(v_fail) > 0 THEN RAISE EXCEPTION 'post:client_destructive_acl' USING DETAIL = array_to_string(v_fail, ', '); END IF;
  RAISE NOTICE 'client_destructive_acl_closed tables=% crud_grants_preserved=%', 59, v_crud_after;
END $h$;
COMMIT;
