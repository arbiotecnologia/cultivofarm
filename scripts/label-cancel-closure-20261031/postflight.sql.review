DO $g$ BEGIN IF (SELECT jsonb_build_object('fn',(SELECT jsonb_build_object('body',pg_get_functiondef(oid),'md5',md5(pg_get_functiondef(oid)),'owner',pg_get_userbyid(proowner),'acl',proacl::text,'definer',prosecdef,'config',proconfig) FROM pg_proc WHERE oid='public.rpc_cancelar_etiqueta_produto(uuid,text)'::regprocedure),
'rel',(SELECT jsonb_object_agg(c.relname,jsonb_build_array(pg_get_userbyid(c.relowner),c.relacl::text,c.relrowsecurity,c.relforcerowsecurity)) FROM pg_class c WHERE c.oid IN ('public.produto_etiquetas'::regclass,'public.produto_etiqueta_eventos'::regclass,'public.financial_audit_log'::regclass)),
'policies',(SELECT jsonb_agg(jsonb_build_array(tablename,policyname,permissive,roles::text,cmd,qual,with_check) ORDER BY tablename COLLATE "C",policyname COLLATE "C") FROM pg_policies WHERE schemaname='public' AND tablename IN ('produto_etiquetas','produto_etiqueta_eventos','financial_audit_log')),
'triggers',(SELECT jsonb_agg(jsonb_build_array(tgrelid::regclass::text,tgname,tgenabled,pg_get_triggerdef(oid)) ORDER BY tgrelid::regclass::text COLLATE "C",tgname COLLATE "C",tgenabled::text COLLATE "C") FROM pg_trigger WHERE NOT tgisinternal AND tgrelid IN ('public.produto_etiquetas'::regclass,'public.produto_etiqueta_eventos'::regclass,'public.financial_audit_log'::regclass)))) IS DISTINCT FROM '{"fn": {"acl": "{postgres=X/postgres,service_role=X/postgres}", "md5": "c640896710b8eb8a00eb230bbf9e1cbe", "body": "CREATE OR REPLACE FUNCTION public.rpc_cancelar_etiqueta_produto(p_etiqueta_id uuid, p_motivo text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''public''\nAS $function$\nDECLARE\n  v_uid uuid := auth.uid();\nBEGIN\n  IF v_uid IS NULL THEN RAISE EXCEPTION ''N\u00e3o autenticado''; END IF;\n  IF p_motivo IS NULL OR length(trim(p_motivo)) < 3 THEN\n    RAISE EXCEPTION ''Motivo obrigat\u00f3rio'';\n  END IF;\n  IF NOT (\n    public.has_role(v_uid,''administrador''::app_role)\n    OR public.has_role(v_uid,''gestor''::app_role)\n    OR public.has_role(v_uid,''producao''::app_role)\n  ) THEN\n    RAISE EXCEPTION ''Sem permiss\u00e3o para cancelar etiqueta'';\n  END IF;\n\n  UPDATE public.produto_etiquetas\n    SET status=''cancelada'',\n        metadata = metadata || jsonb_build_object(''cancelada_em'', now(), ''cancelada_por'', v_uid, ''motivo'', p_motivo)\n    WHERE id = p_etiqueta_id AND status <> ''cancelada'';\n  IF NOT FOUND THEN RAISE EXCEPTION ''Etiqueta n\u00e3o encontrada ou j\u00e1 cancelada''; END IF;\n\n  INSERT INTO public.produto_etiqueta_eventos(etiqueta_id, evento, descricao, user_id, metadata)\n    VALUES (p_etiqueta_id, ''etiqueta_cancelada'', p_motivo, v_uid, jsonb_build_object(''motivo'', p_motivo));\n\n  INSERT INTO public.financial_audit_log(entity_type, entity_id, action, performed_by, reason)\n    VALUES (''produto_etiqueta'', p_etiqueta_id, ''LABEL_CANCELLED'', v_uid, p_motivo);\n\n  RETURN jsonb_build_object(''success'', true);\nEND;\n$function$\n", "owner": "postgres", "config": ["search_path=public"], "definer": true}, "rel": {"produto_etiquetas": ["postgres", "{postgres=arwdDxtm/postgres,anon=arwdxtm/postgres,authenticated=arwdxtm/postgres,service_role=arwdDxtm/postgres}", true, false], "financial_audit_log": ["postgres", "{postgres=arwdDxtm/postgres,anon=arwdDxtm/postgres,authenticated=arwdDxtm/postgres,service_role=arwdDxtm/postgres}", true, false], "produto_etiqueta_eventos": ["postgres", "{postgres=arwdDxtm/postgres,anon=arwdDxtm/postgres,authenticated=arwdDxtm/postgres,service_role=arwdDxtm/postgres}", true, false]}, "policies": [["financial_audit_log", "Financial staff read audit", "PERMISSIVE", "{authenticated}", "SELECT", "is_financial_staff(( SELECT auth.uid() AS uid))", null], ["financial_audit_log", "financial_audit_source_tenant_scope", "RESTRICTIVE", "{authenticated}", "SELECT", "((( SELECT h15_actor_organization() AS h15_actor_organization) IS NOT NULL) AND\nCASE\n    WHEN ((action = ''FINANCIAL_INSTALLMENTS_CUSTOMIZED''::text) AND (entity_type = ''accounts_receivable_installments''::text)) THEN (EXISTS ( SELECT 1\n       FROM accounts_receivable source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN ((action = ''FINANCIAL_INSTALLMENTS_CUSTOMIZED''::text) AND (entity_type = ''accounts_payable_installments''::text)) THEN (EXISTS ( SELECT 1\n       FROM accounts_payable source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''accounts_receivable''::text) THEN (EXISTS ( SELECT 1\n       FROM accounts_receivable source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''accounts_payable''::text) THEN (EXISTS ( SELECT 1\n       FROM accounts_payable source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''accounts_receivable_installments''::text) THEN (EXISTS ( SELECT 1\n       FROM accounts_receivable_installments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''accounts_payable_installments''::text) THEN (EXISTS ( SELECT 1\n       FROM accounts_payable_installments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''receivable_payments''::text) THEN (EXISTS ( SELECT 1\n       FROM receivable_payments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''payable_payments''::text) THEN (EXISTS ( SELECT 1\n       FROM payable_payments source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_documents''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_documents source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_receipts''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_receipts source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''financial_report_exports''::text) THEN (EXISTS ( SELECT 1\n       FROM financial_report_exports source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ''fiscal_invoices''::text) THEN (EXISTS ( SELECT 1\n       FROM fiscal_invoices source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ANY (ARRAY[''recurring_financial_templates''::text, ''RECURRING_TEMPLATE''::text])) THEN (EXISTS ( SELECT 1\n       FROM recurring_financial_templates source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    WHEN (entity_type = ANY (ARRAY[''entrega''::text, ''entregas''::text])) THEN (EXISTS ( SELECT 1\n       FROM entregas source\n      WHERE ((source.id = financial_audit_log.entity_id) AND (source.organization_id = ( SELECT h15_actor_organization() AS h15_actor_organization)))))\n    ELSE false\nEND)", null], ["produto_etiqueta_eventos", "Internal manage etiqueta_eventos", "PERMISSIVE", "{authenticated}", "ALL", "(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''operador_onfarm''::app_role))", "(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''operador_onfarm''::app_role))"], ["produto_etiqueta_eventos", "Read etiqueta_eventos via access fn", "PERMISSIVE", "{authenticated}", "SELECT", "can_user_access_produto_etiqueta(etiqueta_id)", null], ["produto_etiquetas", "Internal manage produto_etiquetas", "PERMISSIVE", "{authenticated}", "ALL", "(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''operador_onfarm''::app_role))", "(platform_private.has_role(( SELECT auth.uid() AS uid), ''administrador''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''producao''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''operador_onfarm''::app_role))"], ["produto_etiquetas", "Read produto_etiquetas via access fn", "PERMISSIVE", "{authenticated}", "SELECT", "can_user_access_produto_etiqueta(id)", null], ["produto_etiquetas", "produto_etiquetas_tenant_root_r", "RESTRICTIVE", "{authenticated}", "ALL", "(platform_private.produto_etiqueta_root_org_v1(lote_id, produto_id, envase_id, envase_item_id, estoque_item_id, embalagem_id, entrega_id, entrega_item_id, cliente_id, fazenda_id, substitui_etiqueta_id, substituida_por_id) = platform_private.h15_actor_organization())", "(platform_private.produto_etiqueta_root_org_v1(lote_id, produto_id, envase_id, envase_item_id, estoque_item_id, embalagem_id, entrega_id, entrega_item_id, cliente_id, fazenda_id, substitui_etiqueta_id, substituida_por_id) = platform_private.h15_actor_organization())"]], "triggers": [["produto_etiquetas", "trg_produto_etiquetas_snapshot_immutable", "O", "CREATE TRIGGER trg_produto_etiquetas_snapshot_immutable BEFORE UPDATE ON public.produto_etiquetas FOR EACH ROW EXECUTE FUNCTION tg_produto_etiquetas_snapshot_immutable()"], ["produto_etiquetas", "trg_produto_etiquetas_updated_at", "O", "CREATE TRIGGER trg_produto_etiquetas_updated_at BEFORE UPDATE ON public.produto_etiquetas FOR EACH ROW EXECUTE FUNCTION fn_produto_etiquetas_updated_at()"]]}'::jsonb THEN RAISE EXCEPTION 'LABEL_CANCEL_POST_DRIFT'; END IF; END $g$;

