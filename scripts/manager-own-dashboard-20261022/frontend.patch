diff --git a/src/lib/comercial/ownOrderIndicators.ts b/src/lib/comercial/ownOrderIndicators.ts
new file mode 100644
index 00000000..f474842b
--- /dev/null
+++ b/src/lib/comercial/ownOrderIndicators.ts
@@ -0,0 +1,9 @@
+export function ownOrderIndicators(rows: readonly { status: string }[]) {
+  const counts = new Map<string, number>();
+  for (const row of rows) counts.set(row.status, (counts.get(row.status) ?? 0) + 1);
+  return {
+    observed: rows.length,
+    atLimit: rows.length === 100,
+    byStatus: [...counts].map(([status, count]) => ({ status, count })),
+  };
+}
