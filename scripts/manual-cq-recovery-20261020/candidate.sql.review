IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.programacao_producao'::regclass AND conname='programacao_producao_ordem_servico_id_fkey' AND convalidated AND NOT condeferrable AND pg_get_constraintdef(oid)='FOREIGN KEY (ordem_servico_id) REFERENCES ordens_servico(id) ON DELETE CASCADE') THEN RAISE EXCEPTION 'PHANTOM_FK_DRIFT';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.production_order_link'::regclass AND conname='production_order_link_ordem_servico_id_fkey' AND convalidated AND NOT condeferrable AND pg_get_constraintdef(oid)='FOREIGN KEY (ordem_servico_id) REFERENCES ordens_servico(id) ON DELETE CASCADE') THEN RAISE EXCEPTION 'PHANTOM_FK_DRIFT';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.entregas'::regclass AND conname='entregas_ordem_servico_id_fkey' AND convalidated AND NOT condeferrable AND pg_get_constraintdef(oid)='FOREIGN KEY (ordem_servico_id) REFERENCES ordens_servico(id)') THEN RAISE EXCEPTION 'PHANTOM_FK_DRIFT';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.aplicacoes'::regclass AND conname='aplicacoes_ordem_servico_id_fkey' AND convalidated AND NOT condeferrable AND pg_get_constraintdef(oid)='FOREIGN KEY (ordem_servico_id) REFERENCES ordens_servico(id)') THEN RAISE EXCEPTION 'PHANTOM_FK_DRIFT';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_class WHERE oid='platform_private.authz_tickets'::regclass AND relowner='postgres'::regrole AND relrowsecurity AND relacl::text='{postgres=arwdDxtm/postgres}') OR EXISTS(SELECT 1 FROM pg_policy WHERE polrelid='platform_private.authz_tickets'::regclass) THEN RAISE EXCEPTION 'PRIVATE_TICKET_DRIFT';END IF;
END $guard$;
-- OFFLINE REVIEW ONLY. Canonical existing table; no data writes, grants or editor opening.
DO $pre$
BEGIN
 IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.cq_parametros_referencia'::regclass AND conname='cq_parametros_referencia_microrganismo_id_fkey' AND convalidated AND pg_get_constraintdef(oid)='FOREIGN KEY (microrganismo_id) REFERENCES microrganismos(id) ON DELETE CASCADE')
 OR NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.cq_parametros_referencia'::regclass AND conname='cq_parametros_referencia_produto_id_fkey' AND convalidated AND pg_get_constraintdef(oid)='FOREIGN KEY (produto_id) REFERENCES produtos(id) ON DELETE CASCADE') THEN RAISE EXCEPTION 'CQ_REFERENCE_BASELINE_DRIFT'; END IF;
END $pre$;
LOCK TABLE public.cq_parametros_referencia IN ACCESS EXCLUSIVE MODE;
DO $constraint$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.cq_parametros_referencia'::regclass AND conname='cq_reference_item_required_v1') THEN
  ALTER TABLE public.cq_parametros_referencia ADD CONSTRAINT cq_reference_item_required_v1 CHECK (microrganismo_id IS NOT NULL OR produto_id IS NOT NULL);
 ELSIF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='public.cq_parametros_referencia'::regclass AND conname='cq_reference_item_required_v1' AND contype='c' AND convalidated AND pg_get_constraintdef(oid)='CHECK (((microrganismo_id IS NOT NULL) OR (produto_id IS NOT NULL)))') THEN
  RAISE EXCEPTION 'CQ_REFERENCE_CONSTRAINT_DRIFT';
 END IF;
 IF EXISTS(SELECT 1 FROM public.cq_parametros_referencia WHERE microrganismo_id IS NULL AND produto_id IS NOT NULL AND ativo IS TRUE GROUP BY produto_id HAVING count(*)>1) THEN RAISE EXCEPTION 'CQ_REFERENCE_ACTIVE_DUPLICATE'; END IF;
END $constraint$;
-- New uniqueness affects ONLY active product-only rows; legacy dual/micro rows and history stay untouched.
CREATE UNIQUE INDEX IF NOT EXISTS cq_reference_product_only_active_uidx ON public.cq_parametros_referencia USING btree (produto_id) WHERE (microrganismo_id IS NULL AND produto_id IS NOT NULL AND ativo IS TRUE);
DO $index$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_index WHERE indexrelid='public.cq_reference_product_only_active_uidx'::regclass AND indrelid='public.cq_parametros_referencia'::regclass AND indisunique AND indisvalid AND indisready AND pg_get_indexdef(indexrelid)='CREATE UNIQUE INDEX cq_reference_product_only_active_uidx ON public.cq_parametros_referencia USING btree (produto_id) WHERE ((microrganismo_id IS NULL) AND (produto_id IS NOT NULL) AND (ativo IS TRUE))') THEN RAISE EXCEPTION 'CQ_REFERENCE_INDEX_DRIFT'; END IF;
END $index$;
ALTER TABLE public.cq_parametros_referencia ALTER COLUMN microrganismo_id DROP NOT NULL;
-- Both FKs/legacy indexes remain. Dual+product-only ambiguity still fails closed in existing core/hook.

-- REVIEW ONLY: no exposed helper endpoint; existing private ticket table only.
CREATE OR REPLACE FUNCTION platform_private.guard_manual_lot_write_v1()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $guard$
DECLARE
 p public.programacao_producao%ROWTYPE;
 old_manual boolean:=false;
 old_programacao uuid;
 org uuid;
BEGIN
 -- Lock old/new parents in deterministic order. An UPDATE cannot escape the
 -- manual fence by changing programacao_id to onfarm or NULL.
 IF TG_OP='UPDATE' THEN old_programacao:=OLD.programacao_id; END IF;
 PERFORM 1 FROM public.programacao_producao
 WHERE id=NEW.programacao_id OR id=old_programacao
 ORDER BY id FOR SHARE;
 IF TG_OP='UPDATE' THEN
  SELECT EXISTS(SELECT 1 FROM public.programacao_producao
    WHERE id=OLD.programacao_id AND ordem_servico_id IS NOT NULL) INTO old_manual;
 END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=NEW.programacao_id;
 IF old_manual OR p.ordem_servico_id IS NOT NULL OR p.id IS NULL THEN
  IF TG_OP='UPDATE' AND old_manual THEN
   org:=platform_private.h15_actor_organization();
   IF auth.uid() IS NOT NULL AND org IS NOT NULL AND public.technical_actor_ready(auth.uid()) IS TRUE
    AND (public.has_role(auth.uid(),'administrador') OR public.has_role(auth.uid(),'gestor') OR public.has_role(auth.uid(),'producao')) IS TRUE
    AND p.id IS NOT NULL AND p.ordem_servico_onfarm_id IS NULL AND p.organization_id=org AND NEW.organization_id=org AND OLD.organization_id=org
    AND (to_jsonb(NEW)-'status'-'updated_at') IS NOT DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    AND EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org AND o.status::text='em_cq'
     AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL AND o.origem IS DISTINCT FROM 'b2b')
    AND ((OLD.status::text='em_producao' AND NEW.status::text='aguardando_cq' AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=NEW.id))
     OR (OLD.status::text='aguardando_cq' AND NEW.status::text IN ('aprovado','reprovado') AND p.status::text='aguardando_cq'
     AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_'||NEW.status::text||'_v1' AND target=NEW.id)
     AND EXISTS(SELECT 1 FROM public.controle_qualidade c WHERE c.lote_id=NEW.id AND c.organization_id=org AND c.resultado::text=NEW.status::text
      AND c.responsavel='DADOS FICTICIOS SEM VALOR COMERCIAL' AND c.ph IS NOT NULL AND c.concentracao IS NOT NULL)))
   THEN RETURN NEW; END IF;
  END IF;

  -- No JWT/GUC/current_user/service-role escape: only the reviewed insert RPC
  -- can issue this private, target-specific ticket; it removes it after INSERT.
  org:=platform_private.h15_actor_organization();
  IF TG_OP<>'INSERT' OR org IS NULL OR auth.uid() IS NULL
   OR public.technical_actor_ready(auth.uid()) IS NOT TRUE
   OR p.id IS NULL OR p.ordem_servico_id IS NULL OR p.ordem_servico_onfarm_id IS NOT NULL
   OR p.organization_id IS DISTINCT FROM org OR NEW.organization_id IS DISTINCT FROM org
   OR p.produto_id IS DISTINCT FROM NEW.produto_id OR p.microrganismo_id IS DISTINCT FROM NEW.microrganismo_id
   OR p.status::text IS DISTINCT FROM 'aguardando' OR NEW.status::text IS DISTINCT FROM 'em_producao'
   OR NOT EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org
     AND o.status::text='programada' AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL
     AND o.origem IS DISTINCT FROM 'b2b')
   OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets
     WHERE txid=pg_catalog.txid_current() AND scope='manual_lot_insert_v1' AND target=NEW.id)
  THEN RAISE EXCEPTION 'MANUAL_LOT_WRITE_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN NEW;
END $guard$;
REVOKE ALL ON FUNCTION platform_private.guard_manual_lot_write_v1() FROM PUBLIC,anon,authenticated,service_role;

-- Only reviewed target/transition tickets; never role/service/GUC exceptions.
CREATE FUNCTION platform_private.guard_manual_cq_write_v1()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE cid uuid; lid uuid; p public.programacao_producao%ROWTYPE; org uuid;
BEGIN
 lid:=CASE WHEN TG_OP='DELETE' THEN OLD.lote_id ELSE NEW.lote_id END;
 SELECT pp.* INTO p FROM public.programacao_producao pp JOIN public.lotes l ON l.programacao_id=pp.id WHERE l.id=lid;
 IF p.ordem_servico_id IS NOT NULL OR p.id IS NULL OR (TG_OP='UPDATE' AND EXISTS(SELECT 1 FROM public.lotes l JOIN public.programacao_producao pp ON pp.id=l.programacao_id WHERE l.id=OLD.lote_id AND pp.ordem_servico_id IS NOT NULL)) THEN
  org:=platform_private.h15_actor_organization();
  IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'CQ_MANUAL_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
  IF auth.uid() IS NULL OR org IS NULL OR public.technical_actor_ready(auth.uid()) IS NOT TRUE
   OR p.organization_id IS DISTINCT FROM org OR NEW.organization_id IS DISTINCT FROM org
   OR p.ordem_servico_onfarm_id IS NOT NULL OR NEW.resultado IS NULL
   OR NEW.responsavel IS DISTINCT FROM 'DADOS FICTICIOS SEM VALOR COMERCIAL'
   OR NEW.responsavel_id IS DISTINCT FROM (SELECT id FROM public.profiles WHERE user_id=auth.uid() AND ativo AND organization_id=org)
   OR NOT EXISTS(SELECT 1 FROM public.lotes l JOIN public.ordens_servico o ON o.id=p.ordem_servico_id JOIN public.clientes c ON c.id=o.cliente_id
     WHERE l.id=lid AND l.organization_id=org AND o.organization_id=org AND c.organization_id=org AND o.status::text='em_cq' AND l.status::text='aguardando_cq')
   OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_insert_v1' AND target=NEW.id)
   THEN RAISE EXCEPTION 'CQ_MANUAL_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN CASE WHEN TG_OP='DELETE' THEN OLD ELSE NEW END;
END $function$;
REVOKE ALL ON FUNCTION platform_private.guard_manual_cq_write_v1() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER aa_manual_cq_write_fence_v1 BEFORE INSERT OR UPDATE OR DELETE ON public.controle_qualidade FOR EACH ROW EXECUTE FUNCTION platform_private.guard_manual_cq_write_v1();

CREATE FUNCTION platform_private.guard_manual_cq_parent_v1()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE ticket text; org uuid; linked boolean;
BEGIN
 IF TG_TABLE_NAME='ordens_servico' THEN
  linked:=EXISTS(SELECT 1 FROM public.programacao_producao p JOIN public.lotes l ON l.programacao_id=p.id WHERE p.ordem_servico_id=OLD.id AND l.organization_id IS NOT NULL);
  IF linked AND OLD.status::text='em_cq' AND
   (to_jsonb(NEW)-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'updated_at') THEN
   RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501';
  END IF;
  IF linked AND (OLD.status::text='em_cq' OR NEW.status::text='em_cq') AND NEW.status IS DISTINCT FROM OLD.status THEN
   IF OLD.status::text IS DISTINCT FROM 'programada' OR NEW.status::text IS DISTINCT FROM 'em_cq'
    OR (to_jsonb(NEW)-'status'-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=OLD.id)
   THEN RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
  END IF;
 ELSE
  linked:=OLD.ordem_servico_id IS NOT NULL AND EXISTS(SELECT 1 FROM public.lotes l WHERE l.programacao_id=OLD.id AND l.organization_id IS NOT NULL);
  IF linked AND (NEW.id IS DISTINCT FROM OLD.id OR NEW.ordem_servico_id IS DISTINCT FROM OLD.ordem_servico_id
   OR NEW.ordem_servico_onfarm_id IS DISTINCT FROM OLD.ordem_servico_onfarm_id
   OR NEW.organization_id IS DISTINCT FROM OLD.organization_id
   OR NEW.produto_id IS DISTINCT FROM OLD.produto_id OR NEW.microrganismo_id IS DISTINCT FROM OLD.microrganismo_id) THEN
   RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501';
  END IF;
  IF linked AND (OLD.status::text IN ('aguardando_cq','aprovado') OR NEW.status::text IN ('aguardando_cq','aprovado')) AND NEW IS DISTINCT FROM OLD THEN
   ticket:=CASE WHEN OLD.status::text='aguardando' AND NEW.status::text='aguardando_cq' THEN 'manual_cq_send_v1'
     WHEN OLD.status::text='aguardando_cq' AND NEW.status::text='aprovado' THEN 'manual_cq_aprovado_v1' END;
   IF ticket IS NULL OR (to_jsonb(NEW)-'status'-'updated_at') IS DISTINCT FROM (to_jsonb(OLD)-'status'-'updated_at')
    OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope=ticket AND target=OLD.id)
   THEN RAISE EXCEPTION 'CQ_MANUAL_PARENT_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
  END IF;
 END IF;
 RETURN NEW;
END $function$;
REVOKE ALL ON FUNCTION platform_private.guard_manual_cq_parent_v1() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER aa_manual_cq_parent_v1 BEFORE UPDATE ON public.ordens_servico FOR EACH ROW EXECUTE FUNCTION platform_private.guard_manual_cq_parent_v1();
CREATE TRIGGER aa_manual_cq_parent_v1 BEFORE UPDATE ON public.programacao_producao FOR EACH ROW EXECUTE FUNCTION platform_private.guard_manual_cq_parent_v1();
CREATE OR REPLACE FUNCTION public.fn_cq_aprovado_avanca_os()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $function$
DECLARE
  v_prog_id uuid;
  v_os_onfarm_id uuid;
  v_os_id uuid;
BEGIN
  IF EXISTS(SELECT 1 FROM public.lotes l JOIN public.programacao_producao p ON p.id=l.programacao_id WHERE l.id=NEW.lote_id AND p.ordem_servico_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF NEW.resultado::text <> 'aprovado' THEN
    RETURN NEW;
  END IF;

  SELECT programacao_id INTO v_prog_id FROM public.lotes WHERE id = NEW.lote_id;
  IF v_prog_id IS NULL THEN
    RETURN NEW;
  END IF;

  SELECT ordem_servico_onfarm_id, ordem_servico_id
    INTO v_os_onfarm_id, v_os_id
    FROM public.programacao_producao
    WHERE id = v_prog_id;

  -- Mirror status on programacao and lote
  UPDATE public.programacao_producao SET status = 'aprovado' WHERE id = v_prog_id;
  UPDATE public.lotes SET status = 'aprovado' WHERE id = NEW.lote_id;

  -- Advance OS On-Farm if it is at em_producao or em_cq
  IF v_os_onfarm_id IS NOT NULL THEN
    UPDATE public.ordens_servico_onfarm
      SET status = 'envase'
      WHERE id = v_os_onfarm_id
        AND status::text IN ('em_producao','em_cq');
  END IF;

  -- Advance legacy OS if it is at em_producao or em_cq
  IF v_os_id IS NOT NULL THEN
    UPDATE public.ordens_servico
      SET status = 'envase'
      WHERE id = v_os_id
        AND status::text IN ('em_producao','em_cq');
  END IF;

  RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.check_os_status_transition()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  status_order text[] := ARRAY['aberta', 'aprovada', 'programada', 'em_producao', 'em_cq', 'envase', 'aguardando_reserva', 'pronto_entrega', 'entregue', 'finalizada'];
  old_idx int;
  new_idx int;
  cq_count int;
  v_lote_id uuid;
BEGIN
  IF TG_TABLE_NAME='ordens_servico' AND OLD.status::text='programada' AND NEW.status::text='em_cq'
   AND EXISTS(SELECT 1 FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope='manual_cq_send_v1' AND target=NEW.id)
   AND EXISTS(SELECT 1 FROM public.programacao_producao p JOIN public.lotes l ON l.programacao_id=p.id JOIN public.clientes c ON c.id=NEW.cliente_id
    WHERE p.ordem_servico_id=NEW.id AND p.ordem_servico_onfarm_id IS NULL AND p.organization_id=platform_private.h15_actor_organization()
    AND l.organization_id=p.organization_id AND NEW.organization_id=p.organization_id AND c.organization_id=p.organization_id AND l.status::text='em_producao')
  THEN RETURN NEW; END IF;
  -- Se o status não mudou, permite
  IF (OLD.status::text = NEW.status::text) THEN
    RETURN NEW;
  END IF;

  -- Se o novo status é 'cancelada', permite
  IF (NEW.status::text = 'cancelada') THEN
    RETURN NEW;
  END IF;

  -- Validação específica: Bloquear avanço para 'envase' se o CQ não estiver aprovado
  IF (NEW.status::text = 'envase') THEN
    -- Encontrar o lote associado a esta OS OnFarm
    -- A relação é OS -> Programação -> Lote
    SELECT l.id INTO v_lote_id
    FROM public.lotes l
    JOIN public.programacao_producao pp ON l.programacao_id = pp.id
    WHERE pp.ordem_servico_onfarm_id = NEW.id
    LIMIT 1;

    -- Se não encontrar por ordem_servico_onfarm_id, tenta pelo ordem_servico_id (caso seja OS padrão)
    IF v_lote_id IS NULL THEN
        SELECT l.id INTO v_lote_id
        FROM public.lotes l
        JOIN public.programacao_producao pp ON l.programacao_id = pp.id
        WHERE pp.ordem_servico_id = NEW.id
        LIMIT 1;
    END IF;

    IF v_lote_id IS NOT NULL THEN
        -- Verificar se existe controle de qualidade aprovado para este lote
        -- Assumindo que o enum de resultado do CQ possui 'aprovado'
        SELECT count(*) INTO cq_count
        FROM public.controle_qualidade
        WHERE lote_id = v_lote_id AND resultado::text = 'aprovado';

        IF cq_count = 0 THEN
            RAISE EXCEPTION 'Não é possível avançar para ENVASE: O lote vinculado a esta Ordem de Serviço ainda não possui um laudo de Controle de Qualidade APROVADO.'
            USING ERRCODE = 'check_violation';
        END IF;
    ELSE
        -- Se não há lote/programação, mas tentou ir para envase, pode ser inconsistência de dados
        -- Mas se o fluxo operacional permite envase sem lote em casos raros, poderíamos ignorar.
        -- Para garantir segurança, vamos exigir o lote se estiver na fase de produção.
        RAISE EXCEPTION 'Não é possível avançar para ENVASE: Nenhum lote de produção foi localizado para esta Ordem de Serviço.'
        USING ERRCODE = 'check_violation';
    END IF;
  END IF;

  -- Encontra os índices na esteira
  SELECT i INTO old_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = OLD.status::text;
  SELECT i INTO new_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = NEW.status::text;

  -- Validações:
  -- 1. Se o status antigo ou novo não estão na lista (e não é cancelamento), lança erro
  IF old_idx IS NULL OR new_idx IS NULL THEN
    RAISE EXCEPTION 'Status inválido ou transição não permitida para o fluxo operacional.';
  END IF;

  -- 2. Permite apenas avançar 1 posição por vez
  IF new_idx <> old_idx + 1
     AND NOT (new_idx = old_idx + 2 AND status_order[old_idx + 1] = 'aguardando_reserva') THEN
    RAISE EXCEPTION 'Transição de status inválida na esteira de produção: % -> %. A próxima etapa obrigatória é %.', 
      OLD.status::text, NEW.status::text, status_order[old_idx + 1];
  END IF;

  RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION private.h7n_esteira_laboratorio()
 RETURNS SETOF mv_esteira_laboratorio
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
 WITH actor AS MATERIALIZED (
 SELECT auth.uid() uid, platform_private.h15_actor_organization() org
 WHERE public.technical_actor_ready(auth.uid()) IS TRUE
 AND public._saas_user_has_feature(auth.uid(),'ordens_producao') IS TRUE
 -- Intersection of the existing backend and route matrix; no new role, no SA bypass.
 AND (public.has_role(auth.uid(),'administrador'::public.app_role)
 OR public.has_role(auth.uid(),'gestor'::public.app_role)
 OR public.has_role(auth.uid(),'administrativo'::public.app_role)
 OR public.has_role(auth.uid(),'producao'::public.app_role))
 ), os AS (
 SELECT o.id, 'manual'::text origin,o.cliente_id,o.fazenda_id,o.talhao_id,o.produto_id,o.microrganismo_id,
 o.partner_order_id,o.partner_order_item_id,NULL::uuid visit_id,o.organization_id org
 FROM public.ordens_servico o
 UNION ALL
 SELECT o.id,'onfarm',o.cliente_id,o.fazenda_id,o.talhao_id,o.produto_id,o.microrganismo_id,
 NULL::uuid,NULL::uuid,o.registro_consultor_id,NULL::uuid FROM public.ordens_servico_onfarm o
 ), safe_os AS (
 SELECT o.*, a.org tenant FROM os o JOIN actor a ON a.org IS NOT NULL
 JOIN public.clientes c ON c.id=o.cliente_id AND c.organization_id=a.org
 WHERE ((o.produto_id IS NOT NULL)::int+(o.microrganismo_id IS NOT NULL)::int)=1
 AND (SELECT count(*) FROM os x WHERE x.id=o.id)=1
 AND (o.origin='onfarm' OR o.org=a.org)
 AND (o.fazenda_id IS NULL OR EXISTS(SELECT 1 FROM public.fazendas f WHERE f.id=o.fazenda_id AND f.organization_id=a.org AND f.cliente_id=o.cliente_id AND f.ativo IS TRUE))
 AND (o.talhao_id IS NULL OR EXISTS(SELECT 1 FROM public.talhoes t WHERE t.id=o.talhao_id AND t.organization_id=a.org AND t.fazenda_id=o.fazenda_id AND t.ativo IS TRUE))
 AND (o.produto_id IS NULL OR EXISTS(SELECT 1 FROM public.produtos p WHERE p.id=o.produto_id AND to_jsonb(p)->>'owner_organization_id' IS NULL))
 AND (o.microrganismo_id IS NULL OR EXISTS(SELECT 1 FROM public.microrganismos m WHERE m.id=o.microrganismo_id AND to_jsonb(m)->>'owner_organization_id' IS NULL))
 AND (o.visit_id IS NULL OR EXISTS(SELECT 1 FROM public.registros_consultor v WHERE v.id=o.visit_id AND v.cliente_id=o.cliente_id AND v.fazenda_id IS NOT DISTINCT FROM o.fazenda_id AND v.talhao_id IS NOT DISTINCT FROM o.talhao_id))
 AND ((o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL) OR EXISTS(
 SELECT 1 FROM public.partner_orders po JOIN public.partner_accounts pa ON pa.id=po.partner_id
 JOIN public.clientes pc ON pc.id=pa.client_id AND pc.organization_id=a.org
 JOIN public.partner_order_items pi ON pi.order_id=po.id AND pi.id=o.partner_order_item_id
 WHERE po.id=o.partner_order_id AND po.cliente_id=o.cliente_id
 AND pa.commercial_owner_organization_id=a.org AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
 AND pi.product_id IS NOT DISTINCT FROM o.produto_id AND pi.microrganismo_id IS NOT DISTINCT FROM o.microrganismo_id))
 ), validated AS (
 SELECT o.* FROM safe_os o
 WHERE NOT EXISTS (
 SELECT 1 FROM public.programacao_producao pp
 WHERE (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id)
 AND NOT ((pp.organization_id=o.tenant
 AND ((o.origin='manual' AND pp.ordem_servico_id=o.id AND pp.ordem_servico_onfarm_id IS NULL)
 OR (o.origin='onfarm' AND pp.ordem_servico_onfarm_id=o.id AND pp.ordem_servico_id IS NULL))
 AND pp.produto_id IS NOT DISTINCT FROM o.produto_id AND pp.microrganismo_id IS NOT DISTINCT FROM o.microrganismo_id
 AND ((pp.responsavel_id IS NULL AND nullif(btrim(pp.responsavel),'') IS NULL)
 OR EXISTS(SELECT 1 FROM public.profiles pr WHERE pr.user_id=pp.responsavel_id AND pr.organization_id=o.tenant AND pr.ativo IS TRUE))
 ) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.programacao_producao pp JOIN public.lotes l ON l.programacao_id=pp.id WHERE (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id) AND NOT ((l.organization_id=o.tenant AND l.produto_id IS NOT DISTINCT FROM o.produto_id AND l.microrganismo_id IS NOT DISTINCT FROM o.microrganismo_id) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.programacao_producao pp JOIN public.lotes l ON l.programacao_id=pp.id JOIN public.controle_qualidade cq ON cq.lote_id=l.id WHERE (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id) AND NOT ((cq.organization_id=o.tenant AND (cq.responsavel_id IS NULL OR EXISTS(SELECT 1 FROM public.profiles pr WHERE pr.id=cq.responsavel_id AND pr.organization_id=o.tenant AND pr.ativo IS TRUE))) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.programacao_producao pp JOIN public.lotes l ON l.programacao_id=pp.id JOIN public.envase ev ON ev.lote_id=l.id WHERE (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id) AND NOT ((ev.organization_id=o.tenant) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.programacao_producao pp JOIN public.lotes l ON l.programacao_id=pp.id JOIN public.estoque_produto ep ON ep.lote_id=l.id WHERE (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id) AND NOT ((ep.produto_id IS NOT DISTINCT FROM o.produto_id AND ep.microrganismo_id IS NOT DISTINCT FROM o.microrganismo_id AND (ep.envase_id IS NULL OR EXISTS(SELECT 1 FROM public.envase ev WHERE ev.id=ep.envase_id AND ev.lote_id=l.id AND ev.organization_id=o.tenant)) AND (ep.reservado_para_os_id IS NULL OR (ep.reservado_para_os_id=o.id AND ep.reservado_para_os_tipo=o.origin AND ep.reservado_para_cliente_id=o.cliente_id)) AND (ep.reservado_para_cliente_id IS NULL OR ep.reservado_para_cliente_id=o.cliente_id) AND (ep.reservado_para_partner_order_id IS NULL OR ep.reservado_para_partner_order_id=o.partner_order_id) AND (ep.reservado_para_partner_id IS NULL OR EXISTS(SELECT 1 FROM public.partner_orders po WHERE po.id=o.partner_order_id AND po.partner_id=ep.reservado_para_partner_id))) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.entregas e WHERE (e.ordem_servico_id=o.id OR e.ordem_servico_onfarm_id=o.id) AND NOT ((e.organization_id=o.tenant AND e.cliente_id=o.cliente_id AND ((o.origin='manual' AND e.ordem_servico_id=o.id AND e.ordem_servico_onfarm_id IS NULL) OR (o.origin='onfarm' AND e.ordem_servico_onfarm_id=o.id AND e.ordem_servico_id IS NULL)) AND (e.produto_id IS NULL OR e.produto_id=o.produto_id) AND (e.partner_order_id IS NULL OR e.partner_order_id=o.partner_order_id) AND (e.lote_id IS NULL OR EXISTS(SELECT 1 FROM public.lotes l JOIN public.programacao_producao pp ON pp.id=l.programacao_id WHERE l.id=e.lote_id AND l.organization_id=o.tenant AND (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id))) AND (e.estoque_produto_id IS NULL OR EXISTS(SELECT 1 FROM public.estoque_produto ep JOIN public.lotes l ON l.id=ep.lote_id JOIN public.programacao_producao pp ON pp.id=l.programacao_id WHERE ep.id=e.estoque_produto_id AND l.id=e.lote_id AND l.organization_id=o.tenant AND (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id)))) IS TRUE))
 AND NOT EXISTS(SELECT 1 FROM public.aplicacoes ap WHERE (ap.ordem_servico_id=o.id OR ap.ordem_servico_onfarm_id=o.id) AND NOT ((ap.organization_id=o.tenant AND ((o.origin='manual' AND ap.ordem_servico_id=o.id AND ap.ordem_servico_onfarm_id IS NULL) OR (o.origin='onfarm' AND ap.ordem_servico_onfarm_id=o.id AND ap.ordem_servico_id IS NULL)) AND (ap.produto_usado_id IS NULL OR ap.produto_usado_id=o.produto_id) AND (ap.lote_usado_id IS NULL OR EXISTS(SELECT 1 FROM public.lotes l JOIN public.programacao_producao pp ON pp.id=l.programacao_id WHERE l.id=ap.lote_usado_id AND l.organization_id=o.tenant AND (pp.ordem_servico_id=o.id OR pp.ordem_servico_onfarm_id=o.id))) AND (ap.responsavel_id IS NULL OR EXISTS(SELECT 1 FROM public.profiles pr WHERE pr.user_id=ap.responsavel_id AND pr.organization_id=o.tenant AND pr.ativo IS TRUE)) AND (ap.parent_id IS NULL OR EXISTS(SELECT 1 FROM public.aplicacoes parent WHERE parent.id=ap.parent_id AND parent.organization_id=o.tenant AND parent.ordem_servico_id IS NOT DISTINCT FROM ap.ordem_servico_id AND parent.ordem_servico_onfarm_id IS NOT DISTINCT FROM ap.ordem_servico_onfarm_id))) IS TRUE))
 )
 SELECT (jsonb_populate_record(NULL::public.mv_esteira_laboratorio,to_jsonb(s))).*
 FROM public._src_vw_esteira_laboratorio s JOIN validated o ON o.id=s.os_id AND o.origin=s.origem_os
 AND s.cliente_id=o.cliente_id AND s.fazenda_id IS NOT DISTINCT FROM o.fazenda_id
 AND s.talhao_id IS NOT DISTINCT FROM o.talhao_id AND s.produto_id IS NOT DISTINCT FROM o.produto_id
 AND s.microrganismo_id IS NOT DISTINCT FROM o.microrganismo_id;
$function$
;

-- REVIEW ONLY. One transactional core for both existing stage/form entrypoints.
CREATE FUNCTION platform_private.manual_cq_v1(p_os_id uuid,p_programacao_id uuid,p_cq jsonb DEFAULT NULL)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE
 uid uuid:=auth.uid(); org uuid; os public.ordens_servico%ROWTYPE; pp public.programacao_producao%ROWTYPE;
 lot public.lotes%ROWTYPE; cq public.controle_qualidade%ROWTYPE; ref public.cq_parametros_referencia%ROWTYPE;
 key text; phase text; outcome text; v_ph numeric; concentration numeric; refid uuid;
 payload jsonb; receipt public.cockpit_operacao_idempotencia%ROWTYPE; receipt_key text; digest text;
 result jsonb; cqid uuid; profileid uuid;
BEGIN
 PERFORM pg_catalog.set_config('lock_timeout','3s',true);
 org:=platform_private.h15_actor_organization();
 IF uid IS NULL OR org IS NULL OR public.technical_actor_ready(uid) IS NOT TRUE
 OR public._saas_user_has_feature(uid,'ordens_producao') IS NOT TRUE
 OR public._saas_user_has_feature(uid,'lotes_qualidade') IS NOT TRUE
 OR (public.has_role(uid,'administrador') OR public.has_role(uid,'gestor') OR public.has_role(uid,'producao')) IS NOT TRUE
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_os_id IS NULL OR p_programacao_id IS NULL OR current_setting('transaction_isolation')<>'read committed' THEN
 RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 phase:=CASE WHEN p_cq IS NULL THEN 'enviar_cq' ELSE 'registrar_cq' END;
 IF p_cq IS NOT NULL THEN
  IF jsonb_typeof(p_cq) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  FOR key IN SELECT jsonb_object_keys(p_cq) LOOP
   IF key NOT IN ('lote_id','resultado','ph','concentracao','aparencia','odor','contaminacao','referencia_id','dados_sinteticos') THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  END LOOP;
  IF p_cq->'dados_sinteticos' IS DISTINCT FROM 'true'::jsonb OR p_cq->>'resultado' NOT IN ('aprovado','reprovado')
   OR jsonb_typeof(p_cq->'ph') IS DISTINCT FROM 'number' OR jsonb_typeof(p_cq->'concentracao') IS DISTINCT FROM 'number'
   OR jsonb_typeof(p_cq->'lote_id') IS DISTINCT FROM 'string' THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  outcome:=p_cq->>'resultado'; v_ph:=(p_cq->>'ph')::numeric; concentration:=(p_cq->>'concentracao')::numeric;
  IF outcome IS NULL OR v_ph::text IN ('NaN','Infinity','-Infinity') OR v_ph<0 OR v_ph>14
   OR concentration::text IN ('NaN','Infinity','-Infinity') OR concentration<0 OR concentration>1e30 THEN RAISE EXCEPTION 'CQ_VALUES_INVALID'; END IF;
  FOREACH key IN ARRAY ARRAY['aparencia','odor','contaminacao'] LOOP
   IF jsonb_typeof(p_cq->key) IS DISTINCT FROM 'string' OR length(btrim(p_cq->>key)) NOT BETWEEN 1 AND 200 THEN RAISE EXCEPTION 'CQ_PAYLOAD_INVALID'; END IF;
  END LOOP;
  IF p_cq ? 'referencia_id' AND jsonb_typeof(p_cq->'referencia_id') NOT IN ('null','string') THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
  BEGIN refid:=nullif(p_cq->>'referencia_id','')::uuid; EXCEPTION WHEN invalid_text_representation THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END;
  payload:=p_cq||jsonb_build_object('aparencia',btrim(p_cq->>'aparencia'),'odor',btrim(p_cq->>'odor'),'contaminacao',btrim(p_cq->>'contaminacao'),'referencia_id',refid);
 ELSE payload:='{}'::jsonb; END IF;
 -- Same lock order / phantom fences as reviewed lot generation. No legacy assert-only delegation.
 LOCK TABLE public.platform_org_admin_invites,public.ordens_servico_onfarm IN SHARE MODE;
 LOCK TABLE public.saas_plan_versions,public.saas_plan_version_features,public.saas_features,public.saas_modules IN SHARE MODE;
 PERFORM pg_advisory_xact_lock(hashtext('cockpit_lote:'||p_programacao_id::text));
 SELECT * INTO os FROM public.ordens_servico WHERE id=p_os_id FOR UPDATE;
 IF os.id IS NULL OR os.organization_id IS DISTINCT FROM org THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=uid ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.user_roles WHERE user_id=uid ORDER BY role::text FOR SHARE;
 PERFORM 1 FROM public.organizations WHERE id=org FOR UPDATE;
 PERFORM 1 FROM public.organization_subscriptions WHERE organization_id=org ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.organization_feature_overrides WHERE organization_id=org ORDER BY id FOR SHARE;
 PERFORM 1 FROM public.clientes WHERE id=os.cliente_id FOR SHARE;
 PERFORM 1 FROM public.fazendas WHERE id=os.fazenda_id FOR SHARE;
 PERFORM 1 FROM public.talhoes WHERE id=os.talhao_id FOR SHARE;
 PERFORM 1 FROM public.produtos WHERE id=os.produto_id FOR SHARE;
 PERFORM 1 FROM public.microrganismos WHERE id=os.microrganismo_id FOR SHARE;
 PERFORM 1 FROM public.programacao_producao WHERE id=p_programacao_id OR ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id ORDER BY id FOR UPDATE;
 PERFORM 1 FROM public.lotes WHERE programacao_id=p_programacao_id ORDER BY id FOR UPDATE;
 IF public.technical_actor_ready(uid) IS NOT TRUE OR platform_private.h15_actor_organization() IS DISTINCT FROM org
 OR public._saas_user_has_feature(uid,'ordens_producao') IS NOT TRUE OR public._saas_user_has_feature(uid,'lotes_qualidade') IS NOT TRUE
 OR (public.has_role(uid,'administrador') OR public.has_role(uid,'gestor') OR public.has_role(uid,'producao')) IS NOT TRUE
 OR NOT EXISTS(SELECT 1 FROM public.clientes c WHERE c.id=os.cliente_id AND c.organization_id=org)
 OR EXISTS(SELECT 1 FROM public.ordens_servico_onfarm WHERE id=p_os_id)
 OR (os.fazenda_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.fazendas f WHERE f.id=os.fazenda_id AND f.organization_id=org AND f.cliente_id=os.cliente_id AND f.ativo))
 OR (os.talhao_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.talhoes t WHERE t.id=os.talhao_id AND t.organization_id=org AND t.fazenda_id=os.fazenda_id AND t.ativo))
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF os.origem='b2b' OR os.partner_order_id IS NOT NULL OR os.partner_order_item_id IS NOT NULL
 OR EXISTS(SELECT 1 FROM public.production_order_link WHERE ordem_servico_id=p_os_id)
 OR EXISTS(SELECT 1 FROM public.entregas WHERE ordem_servico_id=p_os_id)
 OR EXISTS(SELECT 1 FROM public.aplicacoes WHERE ordem_servico_id=p_os_id)
 OR (SELECT count(*) FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id)<>1
 OR (SELECT count(*) FROM public.lotes WHERE programacao_id=p_programacao_id)<>1
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO pp FROM public.programacao_producao WHERE id=p_programacao_id;
 SELECT * INTO lot FROM public.lotes WHERE programacao_id=p_programacao_id;
 IF pp.id IS NULL OR pp.organization_id IS DISTINCT FROM org OR pp.ordem_servico_id IS DISTINCT FROM p_os_id OR pp.ordem_servico_onfarm_id IS NOT NULL
 OR lot.organization_id IS DISTINCT FROM org OR lot.produto_id IS DISTINCT FROM pp.produto_id OR lot.microrganismo_id IS DISTINCT FROM pp.microrganismo_id
 OR pp.produto_id IS DISTINCT FROM os.produto_id OR pp.microrganismo_id IS DISTINCT FROM os.microrganismo_id
 OR pp.data_programada IS NULL OR pp.volume_necessario IS DISTINCT FROM os.volume_total_ml
 OR lot.volume_produzido IS NULL OR lot.volume_produzido<=0 OR lot.volume_produzido::text IN ('NaN','Infinity','-Infinity')
 OR pp.responsavel_id IS NOT NULL OR nullif(btrim(pp.responsavel),'') IS NOT NULL
 OR platform_private.lab_item_is_manufacturable(pp.produto_id,pp.microrganismo_id) IS NOT TRUE
 OR EXISTS(SELECT 1 FROM public.envase WHERE lote_id=lot.id) OR EXISTS(SELECT 1 FROM public.estoque_produto WHERE lote_id=lot.id)
 OR NOT EXISTS(SELECT 1 FROM public.laboratorio_esteira_eventos e WHERE e.lote_id=lot.id AND e.os_id=os.id AND e.programacao_id=pp.id AND e.origem_os='manual' AND e.acao='gerar_lote')
 THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF p_cq IS NOT NULL AND (p_cq->>'lote_id') IS DISTINCT FROM lot.id::text THEN RAISE EXCEPTION 'CQ_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM pg_advisory_xact_lock(hashtext('cq_lote:'||lot.id::text));
 PERFORM 1 FROM public.controle_qualidade WHERE lote_id=lot.id ORDER BY seq FOR UPDATE;
 -- Resolve the canonical item, never infer/create a product->microorganism link.
 IF p_cq IS NOT NULL THEN
  LOCK TABLE public.cq_parametros_referencia IN SHARE MODE;
  IF (SELECT count(*) FROM public.cq_parametros_referencia r WHERE r.ativo IS TRUE AND
   ((pp.produto_id IS NOT NULL AND r.produto_id=pp.produto_id) OR
    (pp.produto_id IS NULL AND pp.microrganismo_id IS NOT NULL AND r.produto_id IS NULL AND r.microrganismo_id=pp.microrganismo_id)))>1
   THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
  SELECT r.* INTO ref FROM public.cq_parametros_referencia r WHERE r.ativo IS TRUE AND
   ((pp.produto_id IS NOT NULL AND r.produto_id=pp.produto_id) OR
    (pp.produto_id IS NULL AND pp.microrganismo_id IS NOT NULL AND r.produto_id IS NULL AND r.microrganismo_id=pp.microrganismo_id));
 END IF;
 IF p_cq IS NOT NULL AND refid IS DISTINCT FROM ref.id THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
 IF p_cq IS NOT NULL AND outcome='aprovado' AND ref.id IS NULL THEN RAISE EXCEPTION 'CQ_REFERENCE_REQUIRED'; END IF;
 IF ref.id IS NOT NULL AND (ref.ph_min IS NULL OR ref.ph_max IS NULL OR ref.concentracao_min_ufc_ml IS NULL
 OR ref.ph_min::text IN ('NaN','Infinity','-Infinity') OR ref.ph_max::text IN ('NaN','Infinity','-Infinity') OR ref.concentracao_min_ufc_ml::text IN ('NaN','Infinity','-Infinity')
 OR ref.ph_min<0 OR ref.ph_max>14 OR ref.ph_min>ref.ph_max OR ref.concentracao_min_ufc_ml<0
 OR nullif(btrim(ref.aparencia_esperada),'') IS NULL OR nullif(btrim(ref.odor_esperado),'') IS NULL OR nullif(btrim(ref.contaminacao_esperada),'') IS NULL)
 THEN RAISE EXCEPTION 'CQ_REFERENCE_INVALID'; END IF;
 IF p_cq IS NOT NULL AND outcome='aprovado' AND ref.id IS NOT NULL AND
 ((ref.ph_min IS NOT NULL AND v_ph<ref.ph_min) OR (ref.ph_max IS NOT NULL AND v_ph>ref.ph_max)
 OR (ref.concentracao_min_ufc_ml IS NOT NULL AND concentration<ref.concentracao_min_ufc_ml)
 OR (nullif(btrim(ref.aparencia_esperada),'') IS NOT NULL AND btrim(p_cq->>'aparencia')<>btrim(ref.aparencia_esperada))
 OR (nullif(btrim(ref.odor_esperado),'') IS NOT NULL AND btrim(p_cq->>'odor')<>btrim(ref.odor_esperado))
 OR (nullif(btrim(ref.contaminacao_esperada),'') IS NOT NULL AND btrim(p_cq->>'contaminacao')<>btrim(ref.contaminacao_esperada))) THEN RAISE EXCEPTION 'CQ_REFERENCE_FAILED'; END IF;
 receipt_key:='manual_cq_v1:'||phase||':'||lot.id::text;
 payload:=payload||jsonb_build_object('os_id',os.id,'programacao_id',pp.id,'lote_id',lot.id,'referencia_snapshot',CASE WHEN p_cq IS NULL OR ref.id IS NULL THEN NULL ELSE to_jsonb(ref) END);
 digest:=md5(payload::text);
 SELECT * INTO receipt FROM public.cockpit_operacao_idempotencia WHERE idempotency_key=receipt_key FOR UPDATE;
 IF receipt.idempotency_key IS NOT NULL THEN
  IF receipt.usuario_id IS DISTINCT FROM uid OR receipt.payload_hash IS DISTINCT FROM digest OR receipt.alvo_id IS DISTINCT FROM lot.id OR receipt.status<>'completed'
   OR os.status::text<>'em_cq' OR lot.status::text NOT IN ('aguardando_cq','aprovado','reprovado')
   OR (p_cq IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.controle_qualidade c WHERE c.id=(receipt.resultado->>'cq_id')::uuid AND c.lote_id=lot.id AND c.organization_id=org AND c.resultado::text=outcome AND c.ph=v_ph AND c.concentracao=concentration AND c.aparencia=payload->>'aparencia' AND c.odor=payload->>'odor' AND c.contaminacao=payload->>'contaminacao'))
  THEN RAISE EXCEPTION 'CQ_REPLAY_DIVERGENT'; END IF;
  RETURN receipt.resultado||jsonb_build_object('replay',true);
 END IF;
 SELECT id INTO profileid FROM public.profiles WHERE user_id=uid AND ativo AND organization_id=org;
 IF p_cq IS NULL THEN
  IF os.status::text<>'programada' OR pp.status::text<>'aguardando' OR lot.status::text<>'em_producao'
   OR EXISTS(SELECT 1 FROM public.controle_qualidade WHERE lote_id=lot.id) THEN RAISE EXCEPTION 'CQ_STATE_INVALID'; END IF;
  INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(txid_current(),'manual_cq_send_v1',lot.id),(txid_current(),'manual_cq_send_v1',os.id),(txid_current(),'manual_cq_send_v1',pp.id);
  -- Ticket-specific transition reflects a pre-existing lot; never simulates production intermediate steps.
  UPDATE public.ordens_servico SET status='em_cq' WHERE id=os.id;
 ELSE
  IF os.status::text<>'em_cq' OR pp.status::text<>'aguardando_cq' OR lot.status::text<>'aguardando_cq'
   OR EXISTS(SELECT 1 FROM public.controle_qualidade WHERE lote_id=lot.id)
   OR NOT EXISTS(SELECT 1 FROM public.cockpit_operacao_idempotencia WHERE idempotency_key='manual_cq_v1:enviar_cq:'||lot.id::text AND status='completed') THEN RAISE EXCEPTION 'CQ_STATE_INVALID'; END IF;
  cqid:=gen_random_uuid();
  INSERT INTO platform_private.authz_tickets(txid,scope,target) VALUES(txid_current(),'manual_cq_'||outcome||'_v1',lot.id),(txid_current(),'manual_cq_'||outcome||'_v1',pp.id),(txid_current(),'manual_cq_insert_v1',cqid);
  INSERT INTO public.controle_qualidade(id,lote_id,ph,concentracao,aparencia,odor,contaminacao,responsavel,responsavel_id,resultado,organization_id)
  VALUES(cqid,lot.id,v_ph,concentration,payload->>'aparencia',payload->>'odor',payload->>'contaminacao','DADOS FICTICIOS SEM VALOR COMERCIAL',profileid,outcome::public.resultado_cq,org);
  UPDATE public.lotes SET status=outcome::public.status_lote WHERE id=lot.id;
  IF outcome='aprovado' THEN UPDATE public.programacao_producao SET status='aprovado' WHERE id=pp.id; END IF;
 END IF;
 IF (SELECT status::text FROM public.ordens_servico WHERE id=os.id)<>'em_cq'
 OR (SELECT status::text FROM public.lotes WHERE id=lot.id)<>(CASE WHEN p_cq IS NULL THEN 'aguardando_cq' ELSE outcome END)
 OR (SELECT status::text FROM public.programacao_producao WHERE id=pp.id)<>(CASE WHEN outcome='aprovado' THEN 'aprovado' ELSE 'aguardando_cq' END)
 OR public.technical_actor_ready(uid) IS NOT TRUE OR platform_private.h15_actor_organization() IS DISTINCT FROM org THEN RAISE EXCEPTION 'CQ_POSTCONDITION_FAILED'; END IF;
 INSERT INTO public.laboratorio_esteira_eventos(os_id,origem_os,programacao_id,lote_id,etapa_anterior,etapa_nova,acao,usuario_id,observacao)
 VALUES(os.id,'manual',pp.id,lot.id,os.status::text,CASE WHEN p_cq IS NULL THEN 'aguardando_cq' ELSE outcome END,phase,uid,'DADOS FICTICIOS SEM VALOR COMERCIAL; sem producao fisica/venda/uso agricola. '||payload::text);
 result:=jsonb_build_object('success',true,'replay',false,'lote_id',lot.id,'cq_id',cqid,'status','em_cq','resultado',outcome);
 INSERT INTO public.cockpit_operacao_idempotencia(idempotency_key,operacao,usuario_id,resultado,payload_hash,alvo_id,status)
 VALUES(receipt_key,phase,uid,result,digest,lot.id,'completed');
 DELETE FROM platform_private.authz_tickets WHERE txid=txid_current() AND scope IN ('manual_cq_send_v1','manual_cq_aprovado_v1','manual_cq_reprovado_v1','manual_cq_insert_v1');
 RETURN result;
END $function$;
REVOKE ALL ON FUNCTION platform_private.manual_cq_v1(uuid,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;

CREATE OR REPLACE FUNCTION public.rpc_avancar_esteira_laboratorio(p_os_id uuid,p_origem text,p_etapa_destino text,p_programacao_id uuid DEFAULT NULL)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
 IF p_origem IS DISTINCT FROM 'manual' OR p_etapa_destino IS DISTINCT FROM 'enviar_cq' THEN RAISE EXCEPTION 'CQ_OPERATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN platform_private.manual_cq_v1(p_os_id,p_programacao_id,NULL);
END $function$;
-- The only public writer overload uses the same reviewed core, never legacy approve/reprove status handlers.
CREATE FUNCTION public.rpc_avancar_esteira_laboratorio(p_os_id uuid,p_origem text,p_etapa_destino text,p_programacao_id uuid,p_cq jsonb)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
 IF p_origem IS DISTINCT FROM 'manual' OR p_etapa_destino IS DISTINCT FROM 'registrar_cq' OR p_cq IS NULL THEN RAISE EXCEPTION 'CQ_OPERATION_CLOSED' USING ERRCODE='42501'; END IF;
 RETURN platform_private.manual_cq_v1(p_os_id,p_programacao_id,p_cq);
END $function$;

REVOKE ALL ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid) FROM PUBLIC,anon,authenticated,service_role;GRANT EXECUTE ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid) TO authenticated;
REVOKE ALL ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;GRANT EXECUTE ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid,jsonb) TO authenticated;
DO $guard$ BEGIN
IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT';END IF;
