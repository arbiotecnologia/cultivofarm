CREATE OR REPLACE FUNCTION public.rpc_avancar_esteira_laboratorio(
  p_os_id uuid,
  p_origem text,
  p_etapa_destino text,
  p_programacao_id uuid DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
    v_user_id uuid;
    v_profile_id uuid;
    v_role text;
    v_status_os text;
    v_etapa_anterior text;
    v_result jsonb;
BEGIN
    v_user_id := auth.uid();
    IF v_user_id IS NULL THEN
        RETURN jsonb_build_object('success', false, 'message', 'Não autenticado');
    END IF;

    -- Canonical authorization shared by batch, filling and stage operations.
    BEGIN
      PERFORM public.fn_cockpit_assert_operador_origem(p_origem);
    EXCEPTION WHEN raise_exception THEN
      IF SQLERRM IN ('COCKPIT_FORBIDDEN','COCKPIT_FORBIDDEN_ORIGEM','COCKPIT_UNAUTHENTICATED') THEN
        RETURN jsonb_build_object('success', false, 'message', 'Seu perfil não possui permissão para esta origem da esteira laboratorial.');
      END IF;
      RAISE;
    END;

    SELECT id INTO v_profile_id FROM public.profiles WHERE user_id = v_user_id LIMIT 1;

    IF p_origem IN ('manual','b2b') THEN
        SELECT status::text INTO v_status_os FROM public.ordens_servico WHERE id = p_os_id FOR UPDATE;
        IF NOT FOUND OR v_status_os IS NULL THEN RETURN jsonb_build_object('success', false, 'message', 'Ordem de serviço não encontrada.'); END IF;
    ELSIF p_origem = 'onfarm' THEN
        SELECT status::text INTO v_status_os FROM public.ordens_servico_onfarm WHERE id = p_os_id FOR UPDATE;
        IF NOT FOUND OR v_status_os IS NULL THEN RETURN jsonb_build_object('success', false, 'message', 'Ordem de serviço On-Farm não encontrada.'); END IF;
    ELSE
        RETURN jsonb_build_object('success', false, 'message', 'Origem de OS inválida: ' || p_origem);
    END IF;


    -- COCKPIT_PROGRAMACAO_VINCULO_V1: lock and validate before any state changes.
    IF p_programacao_id IS NOT NULL THEN
      PERFORM 1 FROM public.programacao_producao p
      WHERE p.id = p_programacao_id
        AND (
          (p_origem IN ('manual','b2b') AND p.ordem_servico_id = p_os_id
            AND p.ordem_servico_onfarm_id IS NULL)
          OR (p_origem = 'onfarm' AND p.ordem_servico_onfarm_id = p_os_id
            AND p.ordem_servico_id IS NULL)
        )
      FOR UPDATE;
      IF NOT FOUND THEN
        RETURN jsonb_build_object('success', false,
          'message', 'Programação não pertence à ordem de serviço informada.');
      END IF;
    END IF;
    v_etapa_anterior := v_status_os;


    -- Replay idempotente do encerramento (duplo clique): nao gera evento novo.
    IF p_etapa_destino = 'finalizar_os' AND v_status_os = 'finalizada' THEN
        RETURN jsonb_build_object('success', true, 'replay', true,
                                  'message', 'OS já finalizada anteriormente.');
    END IF;

    IF v_status_os IN ('finalizada', 'cancelada') THEN
        RETURN jsonb_build_object('success', false, 'message', 'Operação não permitida: OS já está ' || v_status_os);
    END IF;

    CASE p_etapa_destino
        WHEN 'assumir_producao' THEN
            IF p_programacao_id IS NULL THEN
                RETURN jsonb_build_object('success', false, 'message', 'ID da programação é obrigatório para assumir produção.');
            END IF;
            IF v_profile_id IS NULL THEN
                RETURN jsonb_build_object('success', false, 'message', 'Perfil do usuário não encontrado.');
            END IF;

            -- Auto-avanco fail-safe: sobe a escada 'aberta' -> 'aprovada' -> 'programada'
            -- respeitando o trigger de +1 passo. Demais status seguem bloqueados.
            IF v_status_os = 'aberta' THEN
                IF p_origem = 'onfarm' THEN
                    UPDATE public.ordens_servico_onfarm SET status = 'aprovada' WHERE id = p_os_id;
                ELSE
                    UPDATE public.ordens_servico SET status = 'aprovada' WHERE id = p_os_id;
                END IF;
                v_status_os := 'aprovada';
            END IF;

            IF v_status_os = 'aprovada' THEN
                IF p_origem = 'onfarm' THEN
                    UPDATE public.ordens_servico_onfarm SET status = 'programada' WHERE id = p_os_id;
                ELSE
                    UPDATE public.ordens_servico SET status = 'programada' WHERE id = p_os_id;
                END IF;
                v_status_os := 'programada';
            END IF;

            IF v_status_os <> 'programada' THEN
                RETURN jsonb_build_object('success', false, 'message', 'OS precisa estar em status "programada" para assumir produção. Status atual: ' || v_status_os);
            END IF;

            UPDATE public.programacao_producao
            SET status = 'em_producao', responsavel_id = v_profile_id
            WHERE id = p_programacao_id;

            IF p_origem = 'onfarm' THEN
                UPDATE public.ordens_servico_onfarm SET status = 'em_producao' WHERE id = p_os_id;
            ELSE
                UPDATE public.ordens_servico SET status = 'em_producao' WHERE id = p_os_id;
            END IF;

            INSERT INTO public.laboratorio_esteira_eventos (os_id, origem_os, programacao_id, etapa_anterior, etapa_nova, acao, usuario_id)
            VALUES (p_os_id, p_origem, p_programacao_id, v_etapa_anterior, p_etapa_destino, p_etapa_destino, v_user_id);

            PERFORM public.refresh_esteira_laboratorio();
            RETURN jsonb_build_object('success', true, 'message', 'Produção assumida com sucesso');
        ELSE
            v_result := public._rpc_avancar_esteira_laboratorio_internal(p_os_id, p_origem, p_etapa_destino, p_programacao_id);
            IF COALESCE((v_result->>'success')::boolean, false) THEN
              PERFORM public.refresh_esteira_laboratorio();
            END IF;
            RETURN v_result;
    END CASE;
END;
$function$;
REVOKE ALL ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid) FROM PUBLIC,anon,authenticated,service_role;GRANT EXECUTE ON FUNCTION public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid) TO service_role;
-- REVIEW ONLY: no exposed helper endpoint; existing private ticket table only.
CREATE OR REPLACE FUNCTION platform_private.guard_manual_lot_write_v1()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $guard$
DECLARE
 p public.programacao_producao%ROWTYPE;
 old_manual boolean:=false;
 old_programacao uuid;
 org uuid;
BEGIN
 -- Lock old/new parents in deterministic order. An UPDATE cannot escape the
 -- manual fence by changing programacao_id to onfarm or NULL.
 IF TG_OP='UPDATE' THEN old_programacao:=OLD.programacao_id; END IF;
 PERFORM 1 FROM public.programacao_producao
 WHERE id=NEW.programacao_id OR id=old_programacao
 ORDER BY id FOR SHARE;
 IF TG_OP='UPDATE' THEN
  SELECT EXISTS(SELECT 1 FROM public.programacao_producao
    WHERE id=OLD.programacao_id AND ordem_servico_id IS NOT NULL) INTO old_manual;
 END IF;
 SELECT * INTO p FROM public.programacao_producao WHERE id=NEW.programacao_id;
 IF old_manual OR p.ordem_servico_id IS NOT NULL OR p.id IS NULL THEN
  -- No JWT/GUC/current_user/service-role escape: only the reviewed insert RPC
  -- can issue this private, target-specific ticket; it removes it after INSERT.
  org:=platform_private.h15_actor_organization();
  IF TG_OP<>'INSERT' OR org IS NULL OR auth.uid() IS NULL
   OR public.technical_actor_ready(auth.uid()) IS NOT TRUE
   OR p.id IS NULL OR p.ordem_servico_id IS NULL OR p.ordem_servico_onfarm_id IS NOT NULL
   OR p.organization_id IS DISTINCT FROM org OR NEW.organization_id IS DISTINCT FROM org
   OR p.produto_id IS DISTINCT FROM NEW.produto_id OR p.microrganismo_id IS DISTINCT FROM NEW.microrganismo_id
   OR p.status::text IS DISTINCT FROM 'aguardando' OR NEW.status::text IS DISTINCT FROM 'em_producao'
   OR NOT EXISTS(SELECT 1 FROM public.ordens_servico o JOIN public.clientes c ON c.id=o.cliente_id
     WHERE o.id=p.ordem_servico_id AND o.organization_id=org AND c.organization_id=org
     AND o.status::text='programada' AND o.partner_order_id IS NULL AND o.partner_order_item_id IS NULL
     AND o.origem IS DISTINCT FROM 'b2b')
   OR NOT EXISTS(SELECT 1 FROM platform_private.authz_tickets
     WHERE txid=pg_catalog.txid_current() AND scope='manual_lot_insert_v1' AND target=NEW.id)
  THEN RAISE EXCEPTION 'MANUAL_LOT_WRITE_REQUIRES_REVIEWED_RPC' USING ERRCODE='42501'; END IF;
 END IF;
 RETURN NEW;
END $guard$;
REVOKE ALL ON FUNCTION platform_private.guard_manual_lot_write_v1() FROM PUBLIC,anon,authenticated,service_role;
CREATE OR REPLACE FUNCTION public.check_os_status_transition()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  status_order text[] := ARRAY['aberta', 'aprovada', 'programada', 'em_producao', 'em_cq', 'envase', 'aguardando_reserva', 'pronto_entrega', 'entregue', 'finalizada'];
  old_idx int;
  new_idx int;
  cq_count int;
  v_lote_id uuid;
BEGIN
  -- Se o status não mudou, permite
  IF (OLD.status::text = NEW.status::text) THEN
    RETURN NEW;
  END IF;

  -- Se o novo status é 'cancelada', permite
  IF (NEW.status::text = 'cancelada') THEN
    RETURN NEW;
  END IF;

  -- Validação específica: Bloquear avanço para 'envase' se o CQ não estiver aprovado
  IF (NEW.status::text = 'envase') THEN
    -- Encontrar o lote associado a esta OS OnFarm
    -- A relação é OS -> Programação -> Lote
    SELECT l.id INTO v_lote_id
    FROM public.lotes l
    JOIN public.programacao_producao pp ON l.programacao_id = pp.id
    WHERE pp.ordem_servico_onfarm_id = NEW.id
    LIMIT 1;

    -- Se não encontrar por ordem_servico_onfarm_id, tenta pelo ordem_servico_id (caso seja OS padrão)
    IF v_lote_id IS NULL THEN
        SELECT l.id INTO v_lote_id
        FROM public.lotes l
        JOIN public.programacao_producao pp ON l.programacao_id = pp.id
        WHERE pp.ordem_servico_id = NEW.id
        LIMIT 1;
    END IF;

    IF v_lote_id IS NOT NULL THEN
        -- Verificar se existe controle de qualidade aprovado para este lote
        -- Assumindo que o enum de resultado do CQ possui 'aprovado'
        SELECT count(*) INTO cq_count
        FROM public.controle_qualidade
        WHERE lote_id = v_lote_id AND resultado::text = 'aprovado';

        IF cq_count = 0 THEN
            RAISE EXCEPTION 'Não é possível avançar para ENVASE: O lote vinculado a esta Ordem de Serviço ainda não possui um laudo de Controle de Qualidade APROVADO.'
            USING ERRCODE = 'check_violation';
        END IF;
    ELSE
        -- Se não há lote/programação, mas tentou ir para envase, pode ser inconsistência de dados
        -- Mas se o fluxo operacional permite envase sem lote em casos raros, poderíamos ignorar.
        -- Para garantir segurança, vamos exigir o lote se estiver na fase de produção.
        RAISE EXCEPTION 'Não é possível avançar para ENVASE: Nenhum lote de produção foi localizado para esta Ordem de Serviço.'
        USING ERRCODE = 'check_violation';
    END IF;
  END IF;

  -- Encontra os índices na esteira
  SELECT i INTO old_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = OLD.status::text;
  SELECT i INTO new_idx FROM unnest(status_order) WITH ORDINALITY AS t(val, i) WHERE val = NEW.status::text;

  -- Validações:
  -- 1. Se o status antigo ou novo não estão na lista (e não é cancelamento), lança erro
  IF old_idx IS NULL OR new_idx IS NULL THEN
    RAISE EXCEPTION 'Status inválido ou transição não permitida para o fluxo operacional.';
  END IF;

  -- 2. Permite apenas avançar 1 posição por vez
  IF new_idx <> old_idx + 1
     AND NOT (new_idx = old_idx + 2 AND status_order[old_idx + 1] = 'aguardando_reserva') THEN
    RAISE EXCEPTION 'Transição de status inválida na esteira de produção: % -> %. A próxima etapa obrigatória é %.', 
      OLD.status::text, NEW.status::text, status_order[old_idx + 1];
  END IF;

  RETURN NEW;
END;
$function$
;
DO $guard$ BEGIN
IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid)') AND md5(pg_get_functiondef(oid))='c159638f8e2b7bcb4c8c04fd457592cb' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.rpc_avancar_esteira_laboratorio(uuid,text,text,uuid)';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.guard_manual_lot_write_v1()') AND md5(pg_get_functiondef(oid))='8db8d23862936928529e073117bb9e15' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','platform_private.guard_manual_lot_write_v1()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.check_os_status_transition()') AND md5(pg_get_functiondef(oid))='496a214d87fc831a53b2f16d3524ddea' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.check_os_status_transition()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.fn_cq_aprovado_avanca_os()') AND md5(pg_get_functiondef(oid))='5b1905b8fc743e1181904db931b165f9' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.fn_cq_aprovado_avanca_os()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('private.h7n_esteira_laboratorio()') AND md5(pg_get_functiondef(oid))='503f30a55dbd7e29b41c489391ce41cd' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','private.h7n_esteira_laboratorio()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.fn_cq_autoria_servidor()') AND md5(pg_get_functiondef(oid))='329913a20fa9284bd794a034ca4cdfd0' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.fn_cq_autoria_servidor()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.fn_cq_resultado_imutavel()') AND md5(pg_get_functiondef(oid))='1ffd8093e77aa56a8814ed6e292ef299' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.fn_cq_resultado_imutavel()';END IF;
IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.fn_sync_os_classica_downstream()') AND md5(pg_get_functiondef(oid))='06e64b76968f91e19f03b24363ac610a' AND proowner='postgres'::regrole AND proacl::text='{postgres=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %','public.fn_sync_os_classica_downstream()';END IF;
