+
+  it.each(["tenant", "roles", "epoch", "logout", "unmount"])("in-flight request aborts and late bytes are discarded on %s", async (change) => {
+    const late = deferredBlob(); m.download.mockReturnValue(late.promise);
+    const ui = mount(kind);
