+      setTimeoutFn: () => 1, clearTimeoutFn: () => {}, isVisible: () => true, isOnline: () => true, onEpochChange: () => {}, onExpire: () => {} });
+    monitor.start(); await act(async () => { await Promise.resolve(); });
