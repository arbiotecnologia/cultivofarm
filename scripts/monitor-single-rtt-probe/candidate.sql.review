-- REVIEW ONLY, NOT APPLIED BY THE AGENT. Apply ONLY to Supabase swzpzcwiasxmjutrmvkm after independent review. No data writes.
-- Order: apply THIS first, run postflight, only then publish the frontend.
BEGIN;
SET LOCAL lock_timeout = '3s';
DO $pre$ BEGIN
 IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT'; END IF;
 IF current_setting('server_version_num')::int / 10000 <> 17 THEN RAISE EXCEPTION 'PG_MAJOR_DRIFT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.h15_actor_organization()') AND md5(pg_get_functiondef(oid))='55edafec08bcc84a00f1526c14334a2c' AND proowner='postgres'::regrole AND prosecdef IS FALSE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'public.h15_actor_organization()'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.has_role(uuid,public.app_role)') AND md5(pg_get_functiondef(oid))='4d90e93d521a4819d9085f28d742030f' AND proowner='postgres'::regrole AND prosecdef IS FALSE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'public.has_role(uuid,public.app_role)'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.h15_actor_organization()') AND md5(pg_get_functiondef(oid))='64e10608403238a41a9baf92857ca881' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.h15_actor_organization()'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.has_role(uuid,public.app_role)') AND md5(pg_get_functiondef(oid))='c5af5b55de6d79da9b73a33948746ae2' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.has_role(uuid,public.app_role)'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.platform_actor_access_ready(uuid)') AND md5(pg_get_functiondef(oid))='048249c0c2106c3761e26eacb8d0de84' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.platform_actor_access_ready(uuid)'; END IF;
 IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.profiles'::regclass) THEN RAISE EXCEPTION 'RLS_DRIFT: %', 'profiles'; END IF;
 IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.user_roles'::regclass) THEN RAISE EXCEPTION 'RLS_DRIFT: %', 'user_roles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_policies WHERE schemaname='public' AND tablename='profiles' AND policyname='Users can view own profile' AND cmd='SELECT' AND permissive='PERMISSIVE' AND md5(coalesce(qual,'')||'|'||coalesce(with_check,''))='a1fc7aa105a1b503f03297d4c928519f') THEN RAISE EXCEPTION 'POLICY_DRIFT: %', 'profiles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_policies WHERE schemaname='public' AND tablename='user_roles' AND policyname='Users can view own roles' AND cmd='SELECT' AND permissive='PERMISSIVE' AND md5(coalesce(qual,'')||'|'||coalesce(with_check,''))='a1fc7aa105a1b503f03297d4c928519f') THEN RAISE EXCEPTION 'POLICY_DRIFT: %', 'user_roles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_indexes WHERE schemaname='public' AND tablename='profiles' AND indexname='profiles_user_id_key') OR NOT EXISTS(SELECT 1 FROM pg_indexes WHERE schemaname='public' AND tablename='user_roles' AND indexname='user_roles_user_id_role_key') THEN RAISE EXCEPTION 'UNIQUE_DRIFT'; END IF;
 IF NOT has_schema_privilege('authenticated','platform_private','USAGE') THEN RAISE EXCEPTION 'SCHEMA_USAGE_DRIFT'; END IF;
 IF EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND p.proname='internal_actor_context_v1') THEN RAISE EXCEPTION 'TARGET_ALREADY_PRESENT'; END IF;
END $pre$;
CREATE FUNCTION public.internal_actor_context_v1()
 RETURNS jsonb
 LANGUAGE sql
 STABLE
 SET search_path TO ''
AS $function$
 SELECT CASE WHEN auth.uid() IS NULL THEN NULL::jsonb ELSE jsonb_build_object(
   'v', 1,
   'user_id', auth.uid(),
   'organization_id', public.h15_actor_organization(),
   'profile', (SELECT jsonb_build_object('user_id', p.user_id, 'organization_id', p.organization_id, 'ativo', p.ativo, 'senha_provisoria', p.senha_provisoria)
     FROM public.profiles p WHERE p.user_id = auth.uid()),
   'roles', COALESCE((SELECT jsonb_agg(r.role::text ORDER BY r.role::text) FROM public.user_roles r WHERE r.user_id = auth.uid()), '[]'::jsonb),
   'roles_confirmed', COALESCE((SELECT bool_and(public.has_role(auth.uid(), r.role)) FROM public.user_roles r WHERE r.user_id = auth.uid()), false)
 ) END;
$function$;
REVOKE ALL ON FUNCTION public.internal_actor_context_v1() FROM PUBLIC;
REVOKE ALL ON FUNCTION public.internal_actor_context_v1() FROM anon;
REVOKE ALL ON FUNCTION public.internal_actor_context_v1() FROM service_role;
GRANT EXECUTE ON FUNCTION public.internal_actor_context_v1() TO authenticated;
COMMENT ON FUNCTION public.internal_actor_context_v1() IS 'monitor-single-rtt-probe v1: read-only observation of the caller''s own auth.uid() (h15 org, own profile, own roles + has_role) in one statement. Grants nothing.';
DO $post$ BEGIN
 IF (SELECT project_ref FROM public.fiscal_environment_marker LIMIT 1) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'WRONG_PROJECT'; END IF;
 IF current_setting('server_version_num')::int / 10000 <> 17 THEN RAISE EXCEPTION 'PG_MAJOR_DRIFT'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.h15_actor_organization()') AND md5(pg_get_functiondef(oid))='55edafec08bcc84a00f1526c14334a2c' AND proowner='postgres'::regrole AND prosecdef IS FALSE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'public.h15_actor_organization()'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.has_role(uuid,public.app_role)') AND md5(pg_get_functiondef(oid))='4d90e93d521a4819d9085f28d742030f' AND proowner='postgres'::regrole AND prosecdef IS FALSE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'public.has_role(uuid,public.app_role)'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.h15_actor_organization()') AND md5(pg_get_functiondef(oid))='64e10608403238a41a9baf92857ca881' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.h15_actor_organization()'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.has_role(uuid,public.app_role)') AND md5(pg_get_functiondef(oid))='c5af5b55de6d79da9b73a33948746ae2' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.has_role(uuid,public.app_role)'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('platform_private.platform_actor_access_ready(uuid)') AND md5(pg_get_functiondef(oid))='048249c0c2106c3761e26eacb8d0de84' AND proowner='postgres'::regrole AND prosecdef IS TRUE AND provolatile='s' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}') THEN RAISE EXCEPTION 'FUNCTION_DRIFT: %', 'platform_private.platform_actor_access_ready(uuid)'; END IF;
 IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.profiles'::regclass) THEN RAISE EXCEPTION 'RLS_DRIFT: %', 'profiles'; END IF;
 IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.user_roles'::regclass) THEN RAISE EXCEPTION 'RLS_DRIFT: %', 'user_roles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_policies WHERE schemaname='public' AND tablename='profiles' AND policyname='Users can view own profile' AND cmd='SELECT' AND permissive='PERMISSIVE' AND md5(coalesce(qual,'')||'|'||coalesce(with_check,''))='a1fc7aa105a1b503f03297d4c928519f') THEN RAISE EXCEPTION 'POLICY_DRIFT: %', 'profiles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_policies WHERE schemaname='public' AND tablename='user_roles' AND policyname='Users can view own roles' AND cmd='SELECT' AND permissive='PERMISSIVE' AND md5(coalesce(qual,'')||'|'||coalesce(with_check,''))='a1fc7aa105a1b503f03297d4c928519f') THEN RAISE EXCEPTION 'POLICY_DRIFT: %', 'user_roles'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_indexes WHERE schemaname='public' AND tablename='profiles' AND indexname='profiles_user_id_key') OR NOT EXISTS(SELECT 1 FROM pg_indexes WHERE schemaname='public' AND tablename='user_roles' AND indexname='user_roles_user_id_role_key') THEN RAISE EXCEPTION 'UNIQUE_DRIFT'; END IF;
 IF NOT has_schema_privilege('authenticated','platform_private','USAGE') THEN RAISE EXCEPTION 'SCHEMA_USAGE_DRIFT'; END IF;
 IF (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND p.proname='internal_actor_context_v1') <> 1 THEN RAISE EXCEPTION 'TARGET_OVERLOAD'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.internal_actor_context_v1()') AND md5(pg_get_functiondef(oid))='67634de6777851179dc6e5c632e2ad01' AND proowner='postgres'::regrole AND prosecdef IS FALSE AND provolatile='s' AND proretset IS FALSE AND prorettype='jsonb'::regtype AND proconfig::text='{"search_path=\"\""}' AND proacl::text='{postgres=X/postgres,authenticated=X/postgres}') THEN RAISE EXCEPTION 'TARGET_POST_DRIFT'; END IF;
 IF has_function_privilege('anon','public.internal_actor_context_v1()','EXECUTE') OR has_function_privilege('public','public.internal_actor_context_v1()','EXECUTE') OR NOT has_function_privilege('authenticated','public.internal_actor_context_v1()','EXECUTE') THEN RAISE EXCEPTION 'TARGET_ACL_DRIFT'; END IF;
END $post$;
COMMIT;
