('public.fn_avancar_etapa_esteira(text,uuid,uuid,text,uuid)','7ed490f667efcd6e50eb7a2a061899b6','v',true,'search_path=public',ARRAY['postgres','service_role']::text[]),
('public._avancar_os_status(text,uuid,text)','3da8242d67462c916a2d971f5ea7bb97','v',true,'search_path=public, pg_temp',ARRAY['postgres','service_role']::text[]),
('public.fn_create_programacao_on_os_classica_insert()','27b31332cebda532e2d99d9547f9b67c','v',true,'search_path=public',ARRAY['postgres','service_role']::text[]),
('public.guard_tenant_organization_id()','d01a740c1e3e02407131d2b9228bf658','v',false,'search_path=""',ARRAY['postgres','service_role']::text[]),
('public.can_user_access_aplicacao(uuid)','04067ba43cea3eed845a1fd3735061e0','s',true,'search_path=public',ARRAY['authenticated','postgres','service_role']::text[])
 ) x(sig,hash,vol,sec,config,acl) LOOP
 SELECT *,pg_get_functiondef(oid) definition INTO p FROM pg_proc WHERE oid=to_regprocedure(c.sig);
 IF p.oid IS NULL OR md5(p.definition) IS DISTINCT FROM c.hash OR p.provolatile::text IS DISTINCT FROM c.vol OR p.prosecdef IS DISTINCT FROM c.sec OR p.proconfig IS DISTINCT FROM ARRAY[c.config] OR (SELECT rolname FROM pg_roles WHERE oid=p.proowner) IS DISTINCT FROM 'postgres' THEN RAISE EXCEPTION 'OS_APPROVAL_BODY_DRIFT:%',c.sig; END IF;
 SELECT array_agg(CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE r.rolname END ORDER BY CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE r.rolname END) INTO v_executor_roles FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a LEFT JOIN pg_roles r ON r.oid=a.grantee WHERE a.privilege_type='EXECUTE';
 IF v_executor_roles IS DISTINCT FROM c.acl OR EXISTS(SELECT 1 FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE a.grantor<>p.proowner OR a.is_grantable) THEN RAISE EXCEPTION 'OS_APPROVAL_ACL_DRIFT:%',c.sig; END IF;
 END LOOP;
IF (SELECT md5(string_agg(table_name||':'||column_name||':'||udt_name||':'||is_nullable||':'||coalesce(column_default,''),E'\n' ORDER BY table_name,ordinal_position)) FROM information_schema.columns WHERE table_schema='public' AND table_name IN ('ordens_servico','ordens_servico_onfarm','programacao_producao','laboratorio_esteira_eventos','profiles','user_roles','organizations','clientes','fazendas','talhoes','lotes','produtos','microrganismos','production_order_link')) IS DISTINCT FROM '437b65caa297b4b7bb89500d9898d76f' THEN RAISE EXCEPTION 'OS_APPROVAL_schema_DRIFT'; END IF;
IF (SELECT md5(string_agg(t.tgrelid::regclass::text||':'||t.tgname||':'||t.tgenabled::text||':'||pg_get_triggerdef(t.oid)||':'||md5(pg_get_functiondef(t.tgfoid)),E'\n' ORDER BY t.tgrelid::regclass::text,t.tgname)) FROM pg_trigger t WHERE NOT t.tgisinternal AND t.tgrelid IN ('public.ordens_servico'::regclass,'public.ordens_servico_onfarm'::regclass,'public.programacao_producao'::regclass)) IS DISTINCT FROM '393b62456231e126a9cf166a75ac8292' THEN RAISE EXCEPTION 'OS_APPROVAL_triggers_DRIFT'; END IF;
IF (SELECT md5(string_agg(tablename||':'||policyname||':'||permissive||':'||roles::text||':'||cmd||':'||coalesce(qual,'')||':'||coalesce(with_check,''),E'\n' ORDER BY tablename,policyname)) FROM pg_policies WHERE schemaname='public' AND tablename IN ('ordens_servico','ordens_servico_onfarm','programacao_producao','laboratorio_esteira_eventos')) IS DISTINCT FROM '46dd55536a5e91359cdcd6a9baa11647' THEN RAISE EXCEPTION 'OS_APPROVAL_policies_DRIFT'; END IF;
IF (SELECT md5(string_agg(tablename||':'||indexname||':'||indexdef,E'\n' ORDER BY tablename,indexname)) FROM pg_indexes WHERE schemaname='public' AND tablename IN ('ordens_servico','ordens_servico_onfarm','programacao_producao','profiles','user_roles')) IS DISTINCT FROM '1f6dc84fe58153f1cc210d9b47b6ebb8' THEN RAISE EXCEPTION 'OS_APPROVAL_indexes_DRIFT'; END IF;
IF (SELECT md5(string_agg(c.relname||':'||c.relrowsecurity||':'||c.relforcerowsecurity||':'||coalesce(c.relacl::text,'')||':'||r.rolname,E'\n' ORDER BY c.relname)) FROM pg_class c JOIN pg_roles r ON r.oid=c.relowner WHERE c.relnamespace='public'::regnamespace AND c.relname IN ('ordens_servico','ordens_servico_onfarm','programacao_producao','laboratorio_esteira_eventos','profiles','user_roles','organizations','clientes','fazendas','talhoes','lotes')) IS DISTINCT FROM '5a50a214ad6ffb8d758a239c175e951d' THEN RAISE EXCEPTION 'OS_APPROVAL_table_acl_rls_DRIFT'; END IF;
END $guard$;
CREATE OR REPLACE FUNCTION private.assert_os_approval_scope(p_os_id uuid,p_origin text)
RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE
 v_uid uuid:=auth.uid(); v_org uuid; v_os record; v_pp public.programacao_producao%ROWTYPE;
BEGIN
 v_org:=platform_private.h15_actor_organization();
 -- Alçada antes de lookup/status/replay. NULL não é permissão.
 IF v_uid IS NULL OR v_org IS NULL OR public.technical_actor_ready(v_uid) IS NOT TRUE
 OR public._saas_user_has_feature(v_uid,'ordens_producao') IS NOT TRUE
 OR (public.has_role(v_uid,'administrador') OR public.has_role(v_uid,'gestor')) IS NOT TRUE
 OR p_os_id IS NULL OR p_origin NOT IN ('manual','onfarm') OR p_origin IS NULL THEN
 RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM private.h7n_esteira_laboratorio() s WHERE s.os_id=p_os_id AND s.origem_os=p_origin) THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Mesmo ordenamento do caminho direto: lock da OS antes dos filhos, sem advisory invertido.
 IF p_origin='manual' THEN
 SELECT o.organization_id,o.id,o.cliente_id,o.fazenda_id,o.talhao_id,o.produto_id,o.microrganismo_id,o.origem,o.partner_order_id,o.partner_order_item_id INTO v_os FROM public.ordens_servico o WHERE id=p_os_id FOR UPDATE;
 ELSE
 SELECT NULL::uuid organization_id,o.id,o.cliente_id,o.fazenda_id,o.talhao_id,o.produto_id,o.microrganismo_id,'onfarm'::text origem,NULL::uuid partner_order_id,NULL::uuid partner_order_item_id INTO v_os FROM public.ordens_servico_onfarm o WHERE id=p_os_id FOR UPDATE;
 END IF;
 IF v_os.id IS NULL OR (p_origin='manual' AND v_os.organization_id IS DISTINCT FROM v_org) THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 PERFORM 1 FROM public.profiles WHERE user_id=v_uid FOR SHARE;
 PERFORM 1 FROM public.organizations WHERE id=v_org FOR SHARE;
 -- Lock existing role rows; canonical has_role remains authority, never client claims.
 PERFORM 1 FROM public.user_roles WHERE user_id=v_uid ORDER BY role::text FOR SHARE;
 PERFORM 1 FROM public.clientes WHERE id=v_os.cliente_id FOR SHARE;
 PERFORM 1 FROM public.fazendas WHERE id=v_os.fazenda_id FOR SHARE;
 PERFORM 1 FROM public.talhoes WHERE id=v_os.talhao_id FOR SHARE;
 PERFORM 1 FROM public.produtos WHERE id=v_os.produto_id FOR SHARE;
 PERFORM 1 FROM public.microrganismos WHERE id=v_os.microrganismo_id FOR SHARE;
 PERFORM 1 FROM public.profiles WHERE id IN (SELECT responsavel_id FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id) ORDER BY user_id FOR SHARE;
 PERFORM 1 FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id ORDER BY id FOR UPDATE;
 IF platform_private.h15_actor_organization() IS DISTINCT FROM v_org OR public.technical_actor_ready(v_uid) IS NOT TRUE
 OR public._saas_user_has_feature(v_uid,'ordens_producao') IS NOT TRUE
 OR (public.has_role(v_uid,'administrador') OR public.has_role(v_uid,'gestor')) IS NOT TRUE
 OR NOT EXISTS(SELECT 1 FROM private.h7n_esteira_laboratorio() s WHERE s.os_id=p_os_id AND s.origem_os=p_origin) THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Efeitos comerciais/planejamento ainda não homologados: não autorizar por alias.
 IF v_os.origem='b2b' OR v_os.partner_order_id IS NOT NULL OR v_os.partner_order_item_id IS NOT NULL
 OR EXISTS(SELECT 1 FROM public.production_order_link WHERE ordem_servico_id=p_os_id)
 OR platform_private.lab_item_is_manufacturable(v_os.produto_id,v_os.microrganismo_id) IS NOT TRUE THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 -- Aprovação não cria programação nem inventa data. Ausência exige revisão do fluxo atual.
 IF (SELECT count(*) FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id)<>1 THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 SELECT * INTO v_pp FROM public.programacao_producao WHERE ordem_servico_id=p_os_id OR ordem_servico_onfarm_id=p_os_id;
 IF v_pp.organization_id IS DISTINCT FROM v_org OR v_pp.status::text IS DISTINCT FROM 'aguardando'
 OR v_pp.produto_id IS DISTINCT FROM v_os.produto_id OR v_pp.microrganismo_id IS DISTINCT FROM v_os.microrganismo_id
 OR NOT (((p_origin='manual' AND v_pp.ordem_servico_id=p_os_id AND v_pp.ordem_servico_onfarm_id IS NULL)
 OR (p_origin='onfarm' AND v_pp.ordem_servico_onfarm_id=p_os_id AND v_pp.ordem_servico_id IS NULL)) IS TRUE)
 OR (v_pp.responsavel_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.profiles pr WHERE pr.id=v_pp.responsavel_id AND pr.organization_id=v_org AND pr.ativo IS TRUE))
 OR EXISTS(SELECT 1 FROM public.lotes WHERE programacao_id=v_pp.id) THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 RETURN v_org;
END $function$;
CREATE OR REPLACE FUNCTION public.rpc_aprovar_os_v1(p_os_id uuid,p_origem text)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_origin text; v_status text; v_org uuid;
BEGIN
 -- Normalização não consulta dados. Alias inválido/inexistente negado igualmente.
 BEGIN v_origin:=public.fn_cockpit_norm_origem(p_origem); EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END;
 IF v_origin='b2b' THEN RAISE EXCEPTION 'OS_APPROVAL_SCOPE_DENIED' USING ERRCODE='42501'; END IF;
 v_org:=private.assert_os_approval_scope(p_os_id,v_origin);
 IF v_origin='manual' THEN SELECT status::text INTO v_status FROM public.ordens_servico WHERE id=p_os_id;
 ELSE SELECT status::text INTO v_status FROM public.ordens_servico_onfarm WHERE id=p_os_id; END IF;
 IF v_status='aprovada' THEN RETURN jsonb_build_object('success',true,'replay',true,'status','aprovada'); END IF;
 IF v_status IS DISTINCT FROM 'aberta' THEN RETURN jsonb_build_object('success',false,'message','Somente OS aberta pode ser aprovada separadamente.'); END IF;
 IF v_origin='manual' THEN UPDATE public.ordens_servico SET status='aprovada' WHERE id=p_os_id;
 ELSE UPDATE public.ordens_servico_onfarm SET status='aprovada' WHERE id=p_os_id; END IF;
 PERFORM private.assert_os_approval_scope(p_os_id,v_origin);
 RETURN jsonb_build_object('success',true,'replay',false,'status','aprovada','message','OS aprovada; programação e fabricação não iniciadas.');
END $function$;
REVOKE ALL ON FUNCTION public.rpc_aprovar_os_v1(uuid,text) FROM PUBLIC,anon,service_role;
