      "acl": "{postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "sig": "b2b_phase1_order_visible(uuid)",
      "sql": "CREATE OR REPLACE FUNCTION public.b2b_phase1_order_visible(p_order uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ SELECT platform_private.b2b_phase1_order_visible(p_order); $function$\n",
