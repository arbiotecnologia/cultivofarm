-- REVIEW ONLY (C2-ORD v3, rebased sobre 20261023192728 instalado: G e E NÃO são reaplicados) — NÃO APLICAR sem revisão independente e preflight.sql PASS.
-- Baseline exato capturado READ ONLY em 2026-10-23 (ver baseline/*.sql + SHA em README).
-- Mudanças (todas hash-guarded, substituição textual única, CREATE OR REPLACE preserva proacl):
--  (A) platform_private.c2_owner_order_create_allowed / c2_owner_plan_assigned / c2_owner_order_guard
--      — autoridade server-side única do writer do cliente comercial (sem ACL para clientes).
--  (B) c2_order_actor_scope: wrapper só de create/simulate; assert_b2b_partner_scope e callers legados intactos.
--  (C) create/simulate: trocam a chamada do assert pelo wrapper + guard.
--  (D) generate_b2b_receivable_secure_impl: tenant dono, escopo interno por h15, categoria RECEITA ativa
--      estrita, forma de pagamento ativa e única, cliente no mesmo tenant; falha explícita.
--  (E) JÁ INSTALADO em 20261023192728 (somente conferido por hash).
--  (F) projeção: order_capabilities derivada de (A).
--  (G) JÁ INSTALADO em 20261023192728 (somente conferido por hash).
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '60s';

CREATE FUNCTION pg_temp.c2_swap(d text, o text, n text, tag text) RETURNS text LANGUAGE plpgsql AS $s$
BEGIN
  IF o IS NULL OR length(o) = 0 OR (length(d) - length(replace(d, o, ''))) / length(o) <> 1 THEN
    RAISE EXCEPTION 'fragment_not_unique:%', tag;
  END IF;
  RETURN replace(d, o, n);
END $s$;

DO $$
DECLARE d text;
BEGIN
  IF current_setting('request.jwt.claim.role', true) IS NOT NULL
     OR current_setting('request.jwt.claims', true) IS NOT NULL AND current_setting('request.jwt.claims', true) <> '' THEN
    RAISE EXCEPTION 'run_as_owner_only';
  END IF;
  IF to_regprocedure('platform_private.c2_owner_order_create_allowed(uuid,uuid)') IS NOT NULL
     OR to_regprocedure('platform_private.c2_owner_order_guard(uuid,uuid,uuid)') IS NOT NULL
     OR to_regprocedure('platform_private.c2_owner_plan_assigned(uuid,uuid)') IS NOT NULL
     OR to_regprocedure('platform_private.c2_order_actor_scope(uuid,uuid)') IS NOT NULL THEN
    RAISE EXCEPTION 'already_installed_or_drift';
  END IF;
  IF md5(pg_get_functiondef('platform_private.c2p1_settings_allowed(uuid,boolean)'::regprocedure)) IS DISTINCT FROM '57baa5fd657952d9383ad0c422c1d028'
  OR md5(pg_get_functiondef('platform_private.c2p1_settings_fence()'::regprocedure)) IS DISTINCT FROM 'f87cc2894dc551d242c2586f17e2cdd4'
  OR md5(pg_get_functiondef('platform_private.c2p1_update_settings(uuid,jsonb,jsonb)'::regprocedure)) IS DISTINCT FROM '1d64475b433bd8557fd399be3b491a38'
  OR md5(pg_get_functiondef('public.generate_b2b_receivable_secure(uuid)'::regprocedure)) IS DISTINCT FROM 'c08432be20b610b424c45b73ec9610ae' THEN RAISE EXCEPTION 'P1_dependency_drift'; END IF;
  -- Hash guard de TODOS os corpos alterados antes de qualquer escrita.
  IF md5(pg_get_functiondef('platform_private.assert_b2b_partner_scope(uuid,uuid)'::regprocedure)) <> 'f86f43f9d9ad3ed97b840fcc02c79476'
  OR md5(pg_get_functiondef('platform_private.b2b_actor_scope(uuid)'::regprocedure)) <> 'c3f2997746f24bc2efd15db5c0ccc862'
  OR md5(pg_get_functiondef('public.is_valid_b2b_partner_user(uuid,uuid)'::regprocedure)) <> '0bb0dea04be8ca84c66db7ca6329876c'
  OR md5(pg_get_functiondef('platform_private.b2b_commercial_context()'::regprocedure)) <> '2f1063f00281c4ca78dcebaab81a9446'
  OR md5(pg_get_functiondef('platform_private.b2b_commercial_partner_projection()'::regprocedure)) <> '136b4d59f794d5ff379a7c2ca19455e2'
  OR md5(pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure)) <> '624f6e3d45e5af7d039d5da8f784d787'
  OR md5(pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure)) <> 'f9882718027ac4a09810e6e0bf133c61'
  OR md5(pg_get_functiondef('public.generate_b2b_receivable_secure_impl(uuid)'::regprocedure)) <> '60be0fb336ca1537c063a001a213f7af'
  -- Recorte já instalado (20261023192728) deve estar presente e intacto; não é reaplicado.
  OR md5(pg_get_functiondef('public.tg_auto_b2b_receivable()'::regprocedure)) <> '0f679538fe394924b140e54938a3bb9e'
  OR md5(pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure)) <> '09eb9e7442cc59c7c72b4d39f3567a53'
  OR md5(pg_get_functiondef('platform_private.c2_order_internal_recipients(uuid)'::regprocedure)) <> 'd4936c87a3ab62d26816a11a032dfe0f'
  OR md5(pg_get_functiondef('platform_private.c2_order_partner_recipients(uuid)'::regprocedure)) <> '70b381094ae1f3ac87d0fa8e28274dac' THEN
    RAISE EXCEPTION 'drift: baseline hash mismatch';
  END IF;
END $$;

-- (A) Autoridade única do writer do cliente comercial.
CREATE FUNCTION platform_private.c2_owner_order_create_allowed(_uid uuid, _partner uuid)
RETURNS boolean LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE c jsonb;
BEGIN
  -- c2_ord_writer_v1: nunca confia em parâmetro de uid que não seja o JWT atual.
  IF _uid IS NULL OR _partner IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RETURN false; END IF;
  -- Gestor B2B vigente (user_roles canônico; revogação remove a linha). Técnico isolado nunca compra.
  IF NOT public.has_role(_uid,'parceiro_b2b'::public.app_role) THEN RETURN false; END IF;
  c := platform_private.b2b_commercial_context();
  IF c IS NULL OR c->>'contract' <> 'C2_MULTIPROFILE_V1' OR c->>'mode' <> 'commercial_owner'
     OR (c->>'partner_id')::uuid IS DISTINCT FROM _partner OR COALESCE((c->>'manager')::boolean,false) IS NOT TRUE THEN
    RETURN false;
  END IF;
  -- Cliente comercial = sem organização própria; tenant dono ativo e coerente com perfil/vínculo.
  IF EXISTS (SELECT 1 FROM public.organizations o WHERE o.partner_account_id = _partner) THEN RETURN false; END IF;
  IF NOT COALESCE(platform_private.b2b_phase1_partner_visible(_partner,true),false) THEN RETURN false; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.partner_users pu
      JOIN public.partner_accounts pa ON pa.id = pu.partner_id
      JOIN public.profiles p ON p.user_id = pu.user_id
      JOIN public.organizations o ON o.id = pa.commercial_owner_organization_id
     WHERE pu.user_id = _uid AND pu.partner_id = _partner
       AND pu.revoked_at IS NULL AND (pu.valid_from IS NULL OR pu.valid_from <= now())
       AND pa.ativo AND pa.deleted_at IS NULL AND o.ativo AND o.status = 'ativa'
       AND (o.partner_account_id IS NULL OR o.partner_account_id = _partner)
       AND p.ativo AND p.organization_id = pu.tenant_id AND pu.tenant_id = o.id
       AND (c->>'tenant_id')::uuid = o.id
       AND public.is_valid_b2b_partner_user(_uid, pa.id)) THEN
    RETURN false;
  END IF;
  RETURN EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'pedidos_b2b')
     AND EXISTS (SELECT 1 FROM platform_private.entitlements_for_user(_uid) e WHERE e.feature_key = 'catalogo_precos');
END $function$;

CREATE FUNCTION platform_private.c2_owner_plan_assigned(_partner uuid, _plan uuid)
RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
  SELECT public.fn_b2b_plan_selectable(_plan) AND EXISTS (
    SELECT 1 FROM public.commercial_payment_plan_assignments a
     WHERE a.plan_id = _plan AND a.partner_id = _partner
       AND a.buyer_scope = 'partner' AND a.status = 'published'
       AND a.valid_from <= CURRENT_DATE AND (a.valid_until IS NULL OR a.valid_until >= CURRENT_DATE));
$function$;

CREATE FUNCTION platform_private.c2_owner_order_guard(_uid uuid, _partner uuid, _plan uuid)
RETURNS void LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
BEGIN
  -- Internos e superadmin seguem as regras existentes da função chamadora.
  IF public.is_platform_superadmin(_uid)
     OR public.has_role(_uid,'administrador'::public.app_role) OR public.has_role(_uid,'financeiro'::public.app_role)
     OR public.has_role(_uid,'gestor_comercial'::public.app_role) THEN
    RETURN;
  END IF;
  -- Parceiro com organização própria (fornecedor legado): comportamento inalterado.
  IF EXISTS (SELECT 1 FROM public.organizations o WHERE o.partner_account_id = _partner) THEN RETURN; END IF;
  IF NOT platform_private.c2_owner_order_create_allowed(_uid,_partner) THEN
    RAISE EXCEPTION 'C2_OWNER_ORDER_CLOSED' USING ERRCODE='42501';
  END IF;
  IF _plan IS NULL OR NOT platform_private.c2_owner_plan_assigned(_partner,_plan) THEN
    RAISE EXCEPTION 'plan_not_assigned' USING ERRCODE='42501';
  END IF;
END $function$;

REVOKE ALL ON FUNCTION platform_private.c2_owner_order_create_allowed(uuid,uuid) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.c2_owner_plan_assigned(uuid,uuid) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION platform_private.c2_owner_order_guard(uuid,uuid,uuid) FROM PUBLIC, anon, authenticated;

-- (B) Escopo do comprador: assert_b2b_partner_scope NÃO é alterado (callers legados intactos).
-- Só create/simulate usam este wrapper; o cumulativo passa apenas com a autoridade C2 completa.
CREATE FUNCTION platform_private.c2_order_actor_scope(_uid uuid, _partner uuid)
RETURNS void LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE s record;
BEGIN
  IF public.has_role(_uid,'parceiro_b2b_tecnico'::public.app_role) AND public.has_role(_uid,'parceiro_b2b'::public.app_role)
     AND NOT public.is_platform_superadmin(_uid) THEN
    IF _uid IS NULL OR auth.uid() IS DISTINCT FROM _uid THEN RAISE EXCEPTION 'auth_required' USING ERRCODE='42501'; END IF;
    IF NOT platform_private.c2_owner_order_create_allowed(_uid,_partner) THEN
      RAISE EXCEPTION 'forbidden_financial_terms' USING ERRCODE='42501';
    END IF;
    SELECT * INTO s FROM platform_private.b2b_actor_scope(_uid);
    IF NOT s.profile_ok THEN RAISE EXCEPTION 'inactive_scope' USING ERRCODE='42501'; END IF;
    IF s.org_partner IS DISTINCT FROM _partner OR NOT s.partner_valid
       OR s.user_partner_count <> 1 OR s.user_partner IS DISTINCT FROM _partner THEN
      RAISE EXCEPTION 'forbidden_partner' USING ERRCODE='42501';
    END IF;
    RETURN;
  END IF;
  PERFORM platform_private.assert_b2b_partner_scope(_uid,_partner);
END $function$;
REVOKE ALL ON FUNCTION platform_private.c2_order_actor_scope(uuid,uuid) FROM PUBLIC, anon, authenticated;

DO $$
DECLARE d text;
BEGIN
  -- (C) guard do writer em criação e simulação (convert_* reutiliza create).
  d := pg_get_functiondef('public.create_partner_order_secure(uuid,text,jsonb,date,uuid,date,integer,text,text)'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$  PERFORM platform_private.assert_b2b_partner_scope(v_uid, p_partner_id);$o$,
$n$  PERFORM platform_private.c2_order_actor_scope(v_uid, p_partner_id); -- c2_ord_scope
  PERFORM platform_private.c2_owner_order_guard(v_uid, p_partner_id, p_payment_plan_id); -- c2_ord_guard$n$, 'create');
  EXECUTE d;
  d := pg_get_functiondef('public.simulate_b2b_payment_plan_secure(uuid,uuid,jsonb,date)'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$  PERFORM platform_private.assert_b2b_partner_scope(v_uid, p_partner_id);$o$,
$n$  PERFORM platform_private.c2_order_actor_scope(v_uid, p_partner_id); -- c2_ord_scope
  PERFORM platform_private.c2_owner_order_guard(v_uid, p_partner_id, p_payment_plan_id); -- c2_ord_guard$n$, 'simulate');
  EXECUTE d;

  -- (D) geração do título.
  d := pg_get_functiondef('public.generate_b2b_receivable_secure_impl(uuid)'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$    INSERT INTO public.partner_financial_settings(partner_id) VALUES (v_order.partner_id) RETURNING * INTO v_settings;$o$,
$n$    -- c2_ord_p1_no_provision: only the existing P1 CAS RPC creates settings.
    RAISE EXCEPTION 'B2B_FINANCIAL_SETTINGS_NOT_CONFIGURED' USING ERRCODE='P0001';$n$, 'impl_no_settings_insert');
  d := pg_temp.c2_swap(d,
$o$  SELECT count(*), min(o.id::text)::uuid INTO v_org_count,v_org
    FROM public.organizations o WHERE o.partner_account_id=v_order.partner_id;$o$,
$n$  SELECT count(*), min(o.id::text)::uuid INTO v_org_count,v_org
    FROM public.organizations o WHERE o.partner_account_id=v_order.partner_id;
  -- c2_ord_owner_tenant: cliente comercial sem tenant próprio fatura no tenant dono.
  IF v_org_count = 0 THEN
    SELECT count(*), min(o.id::text)::uuid INTO v_org_count, v_org
      FROM public.partner_accounts pa JOIN public.organizations o ON o.id = pa.commercial_owner_organization_id
     WHERE pa.id = v_order.partner_id AND pa.ativo IS TRUE AND pa.deleted_at IS NULL
       AND o.ativo IS TRUE AND o.status = 'ativa';
  END IF;$n$, 'impl_tenant');
  d := pg_temp.c2_swap(d,
$o$  IF v_uid IS NOT NULL THEN
    PERFORM platform_private.assert_b2b_partner_scope(v_uid,v_order.partner_id);$o$,
$n$  IF v_uid IS NOT NULL THEN
    -- c2_ord_internal_scope: emissor interno é limitado por h15 = tenant do título (abaixo);
    -- quem tem papel B2B externo continua passando pelo assert canônico.
    IF public.has_role(v_uid,'parceiro_b2b'::app_role) OR public.has_role(v_uid,'parceiro_b2b_tecnico'::app_role) THEN
      PERFORM platform_private.assert_b2b_partner_scope(v_uid,v_order.partner_id);
    END IF;$n$, 'impl_scope');
  d := pg_temp.c2_swap(d,
$o$  SELECT id INTO v_category_id FROM public.financial_categories
   WHERE upper(COALESCE(type::text,'')) IN ('RECEITA','INCOME') AND COALESCE(active,true) = true
   ORDER BY created_at ASC LIMIT 1;
  IF v_category_id IS NULL THEN
    SELECT id INTO v_category_id FROM public.financial_categories ORDER BY created_at ASC LIMIT 1;
  END IF;
  IF v_category_id IS NULL THEN
    RAISE EXCEPTION 'Nenhuma categoria financeira cadastrada — cadastre uma categoria de receita antes de gerar cobranças B2B';
  END IF;

  SELECT id INTO v_payment_method_id FROM public.payment_methods
   WHERE lower(name) = lower(COALESCE(v_settings.default_payment_method,'pix')) LIMIT 1;$o$,
$n$  -- c2_ord_strict_refs: financial_categories/payment_methods são catálogos globais por desenho (sem organization_id, RLS is_financial_staff; sem DDL de tenant
  -- no schema canônico); resolução estrita, sem fallback de tipo/inativo, falha explícita.
  SELECT id INTO v_category_id FROM public.financial_categories
   WHERE upper(btrim(type)) = 'RECEITA' AND active IS TRUE
   ORDER BY created_at ASC, id ASC LIMIT 1;
  IF v_category_id IS NULL THEN
    RAISE EXCEPTION 'B2B_REVENUE_CATEGORY_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  IF NULLIF(btrim(COALESCE(v_settings.default_payment_method,'')),'') IS NULL THEN
    RAISE EXCEPTION 'B2B_PAYMENT_METHOD_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  IF (SELECT count(*) FROM public.payment_methods pm
       WHERE pm.active IS TRUE AND lower(btrim(pm.name)) = lower(btrim(v_settings.default_payment_method))) <> 1 THEN
    RAISE EXCEPTION 'B2B_PAYMENT_METHOD_NOT_CONFIGURED' USING ERRCODE='P0001';
  END IF;
  SELECT pm.id INTO v_payment_method_id FROM public.payment_methods pm
   WHERE pm.active IS TRUE AND lower(btrim(pm.name)) = lower(btrim(v_settings.default_payment_method));
  IF v_partner.client_id IS NOT NULL AND NOT EXISTS (
       SELECT 1 FROM public.clientes cl WHERE cl.id = v_partner.client_id AND cl.organization_id = v_org) THEN
    RAISE EXCEPTION 'B2B_CUSTOMER_TENANT_MISMATCH' USING ERRCODE='42501';
  END IF;$n$, 'impl_refs');
  EXECUTE d;

  -- P1 internal owner/ownorg authority is required for owner-side approval/billing.
  -- The phase1 helper intentionally remains unchanged for every sibling caller.
  d := pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$IF NOT public.b2b_phase1_order_visible(p_order_id) THEN$o$,
$n$IF NOT (public.b2b_phase1_order_visible(p_order_id) OR EXISTS (
    SELECT 1 FROM public.partner_orders po WHERE po.id=p_order_id
      AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN$n$, 'approve_p1_owner');
  EXECUTE d;
  d := pg_get_functiondef('public.generate_b2b_receivable_secure(uuid)'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$ELSIF NOT public.b2b_phase1_order_visible(p_partner_order_id) THEN$o$,
$n$ELSIF NOT (public.b2b_phase1_order_visible(p_partner_order_id) OR EXISTS (
    SELECT 1 FROM public.partner_orders po WHERE po.id=p_partner_order_id
      AND platform_private.c2p1_settings_allowed(po.partner_id,true))) THEN$n$, 'billing_p1_owner');
  EXECUTE d;

  -- (F) projeção: capacidade do writer = mesma função do servidor.
  d := pg_get_functiondef('platform_private.b2b_commercial_partner_projection()'::regprocedure);
  d := pg_temp.c2_swap(d,
$o$jsonb_build_object('capabilities',jsonb_build_object('contract','C2_CAT_V1',
   'catalog_read',catalog,'sheets_read',sheets));$o$,
$n$jsonb_build_object('capabilities',jsonb_build_object('contract','C2_CAT_V1',
   'catalog_read',catalog,'sheets_read',sheets))||jsonb_build_object('order_capabilities',jsonb_build_object(
   'contract','C2_OWNER_ORDER_V1','order_create', permitted AND catalog
     AND platform_private.c2_owner_order_create_allowed(u,(result->>'id')::uuid))); -- c2_ord_projection$n$, 'projection');
  EXECUTE d;
END $$;
COMMIT;
