-- C2_COMMERCIAL_OWNER_ORDERS_V1 — leitura administrativa somente leitura da carteira
-- do commercial owner. INATIVO: aplicar somente com autorização explícita do proprietário.
-- v3 (revisão SQL 5db): além do assert de ausência do alvo, os PINOS de dependências
-- (has_role corpo+ACL, unicidade exata de profiles.user_id) e das policies de
-- partner_orders foram incorporados NESTA transação, antes do DDL — qualquer
-- divergência aborta tudo, sem estado parcial. search_path vazio, nomes qualificados,
-- CREATE sem OR REPLACE.

BEGIN;

-- 1) Assert de ausência do alvo na MESMA transação do DDL.
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
             WHERE n.nspname = 'public' AND p.proname = 'c2_commercial_owner_orders_projection')
     OR EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
                WHERE n.nspname = 'platform_private' AND p.proname = 'c2_commercial_owner_orders_core') THEN
    RAISE EXCEPTION 'target_already_exists: abortando para não sobrescrever função existente';
  END IF;
END;
$$;

-- 2) Dependência pinada: platform_private.has_role (corpo + ACL) na MESMA transação.
DO $$
DECLARE v_md5 text; v_acl text;
BEGIN
  SELECT md5(p.prosrc), p.proacl::text INTO v_md5, v_acl
    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'platform_private' AND p.proname = 'has_role';
  IF v_md5 IS DISTINCT FROM '05f82a3d57ca71ca6d966fd6c7cf1a1b'
     OR v_acl IS DISTINCT FROM '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' THEN
    RAISE EXCEPTION 'candidate_failed: dependência platform_private.has_role divergente (md5=% acl=%)', v_md5, v_acl;
  END IF;
END;
$$;

-- 3) Unicidade EXATA de profiles.user_id na MESMA transação: coluna real identificada
-- por attname (não pela posição física), índice válido/pronto, NÃO parcial
-- (indpred NULL), chave de exatamente uma coluna (sem INCLUDE, sem expressão).
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1
      FROM pg_index i
      JOIN pg_class c ON c.oid = i.indrelid
      JOIN pg_namespace n ON n.oid = c.relnamespace
     WHERE n.nspname = 'public' AND c.relname = 'profiles'
       AND i.indisunique AND i.indisvalid AND i.indisready
       AND i.indpred IS NULL
       AND i.indnkeyatts = 1 AND i.indnatts = 1
       AND i.indkey[0] <> 0
       AND (SELECT a.attname FROM pg_attribute a
             WHERE a.attrelid = i.indrelid AND a.attnum = i.indkey[0]) = 'user_id'
  ) THEN
    RAISE EXCEPTION 'candidate_failed: profiles.user_id sem índice único exato, válido e não parcial';
  END IF;
END;
$$;

-- 4) Policies de partner_orders pinadas na MESMA transação (nomes, permissividade,
-- hashes qual/with_check) — este pacote não altera policies; divergência aborta.
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM (
      SELECT pol.polname, pol.polpermissive,
             md5(coalesce(pg_get_expr(pol.polqual, pol.polrelid), '')) AS qm,
             md5(coalesce(pg_get_expr(pol.polwithcheck, pol.polrelid), '')) AS cm
        FROM pg_policy pol
        JOIN pg_class c ON c.oid = pol.polrelid
        JOIN pg_namespace n ON n.oid = c.relnamespace
       WHERE n.nspname = 'public' AND c.relname = 'partner_orders'
    ) p
    GROUP BY ()
    HAVING count(*) = 5
       AND bool_and((polname, polpermissive, qm, cm) IN (
         ('Financeiro read partner_orders', true,  '2385c066775325c700f3e91bfe87b56c', 'd41d8cd98f00b204e9800998ecf8427e'),
         ('b2b_phase1_tenant_guard',        false, '8a5bbe26384a3d58c5383afc7babf9bc', '8a5bbe26384a3d58c5383afc7babf9bc'),
         ('partner_orders_insert',          true,  'd41d8cd98f00b204e9800998ecf8427e', 'ee2eb83861da3e7933f95335e6c6dde0'),
         ('partner_orders_select',          true,  '214c9f49dc14046e5ef64a96e8244e05', 'd41d8cd98f00b204e9800998ecf8427e'),
         ('partner_orders_update',          true,  'ee2eb83861da3e7933f95335e6c6dde0', 'ee2eb83861da3e7933f95335e6c6dde0')
       ))
  ) THEN
    RAISE EXCEPTION 'candidate_failed: policies de partner_orders divergem do baseline pinado';
  END IF;
END;
$$;

CREATE FUNCTION platform_private.c2_commercial_owner_orders_core(
  p_status text DEFAULT NULL,
  p_partner_id uuid DEFAULT NULL,
  p_start timestamptz DEFAULT NULL,
  p_end timestamptz DEFAULT NULL
) RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_uid uuid := auth.uid();
  v_org uuid;
  v_orders jsonb;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'auth_required' USING ERRCODE = '42501';
  END IF;

  -- Organização canônica do ator derivada no servidor: perfil ativo + org ativa.
  -- profiles.user_id tem índice único exato (pin acima, nesta transação), logo a
  -- resolução é determinística; o LIMIT 1 é defensivo. Nunca vem de parâmetro.
  SELECT p.organization_id INTO v_org
    FROM public.profiles p
    JOIN public.organizations o ON o.id = p.organization_id
   WHERE p.user_id = v_uid
     AND p.ativo = true
     AND o.ativo = true
     AND o.status = 'ativa'
   LIMIT 1;

  IF v_org IS NULL THEN
    RAISE EXCEPTION 'actor_scope_unavailable' USING ERRCODE = '42501';
  END IF;

  -- Somente administração interna da empresa dona da carteira. Papéis externos
  -- (parceiro_b2b etc.) não autorizam; superadmin sem papel interno também é
  -- negado aqui — o canal do fornecedor é a lista administrativa existente.
  -- Papel misto (administrador + papel externo) resolve pela org do perfil ativo.
  IF NOT (platform_private.has_role(v_uid, 'administrador'::public.app_role)
       OR platform_private.has_role(v_uid, 'gestor_comercial'::public.app_role)) THEN
    RAISE EXCEPTION 'actor_not_allowed' USING ERRCODE = '42501';
  END IF;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
           'id', q.id,
           'numero', q.numero,
           'status', q.status,
           'total', q.total,
           'created_at', q.created_at,
           'requested_delivery_date', q.requested_delivery_date,
           'estimated_delivery_date', q.estimated_delivery_date,
           'partner_id', q.partner_id,
           'partner_razao_social', q.razao_social,
           'c2_external_origin_snapshot', q.c2_external_origin_snapshot
         ) ORDER BY q.created_at DESC, q.id), '[]'::jsonb)
    INTO v_orders
    FROM (
      SELECT o.id, o.numero, o.status::text AS status, o.total, o.created_at,
             o.requested_delivery_date, o.estimated_delivery_date,
             o.partner_id, o.c2_external_origin_snapshot,
             pa.razao_social
        FROM public.partner_orders o
        JOIN public.partner_accounts pa ON pa.id = o.partner_id
       WHERE pa.commercial_owner_organization_id = v_org
         AND pa.ativo IS TRUE
         AND pa.deleted_at IS NULL
         AND (p_status IS NULL OR o.status::text = p_status)
         AND (p_partner_id IS NULL OR o.partner_id = p_partner_id)
         AND (p_start IS NULL OR o.created_at >= p_start)
         AND (p_end IS NULL OR o.created_at <= p_end)
       ORDER BY o.created_at DESC, o.id
       LIMIT 200
    ) q;

  RETURN jsonb_build_object(
    'contract', 'C2_COMMERCIAL_OWNER_ORDERS_V1',
    'organization_id', v_org,
    'orders', v_orders
  );
END;
$$;

-- ACL no padrão canônico dos leitores comerciais (ex.: b2b_commercial_own_orders):
-- authenticated + service_role executam; a autorização é validada dentro do core.
REVOKE ALL ON FUNCTION platform_private.c2_commercial_owner_orders_core(text, uuid, timestamptz, timestamptz) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION platform_private.c2_commercial_owner_orders_core(text, uuid, timestamptz, timestamptz) TO authenticated, service_role;

CREATE FUNCTION public.c2_commercial_owner_orders_projection(
  p_status text DEFAULT NULL,
  p_partner_id uuid DEFAULT NULL,
  p_start timestamptz DEFAULT NULL,
  p_end timestamptz DEFAULT NULL
) RETURNS jsonb
LANGUAGE sql
SECURITY INVOKER
SET search_path = ''
AS $$
  SELECT platform_private.c2_commercial_owner_orders_core(p_status, p_partner_id, p_start, p_end);
$$;

REVOKE ALL ON FUNCTION public.c2_commercial_owner_orders_projection(text, uuid, timestamptz, timestamptz) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.c2_commercial_owner_orders_projection(text, uuid, timestamptz, timestamptz) TO authenticated, service_role;

COMMIT;
