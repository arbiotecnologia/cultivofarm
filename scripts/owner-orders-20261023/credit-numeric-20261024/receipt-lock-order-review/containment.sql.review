DO $guard$ BEGIN IF (SELECT coalesce(jsonb_agg(to_jsonb(p) ORDER BY tablename,policyname),'[]') FROM pg_policies p WHERE schemaname='public' AND tablename IN ('accounts_receivable','accounts_receivable_installments','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_price_rules','partner_financial_settings','partner_order_financial_links','partner_order_items','partner_order_payment_schedule','partner_order_payment_terms','partner_orders')) IS DISTINCT FROM '[{"cmd": "INSERT", "qual": null, "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "accounts_receivable_insert_financial", "schemaname": "public", "with_check": "is_financial_staff(( SELECT auth.uid() AS uid))"}, {"cmd": "SELECT", "qual": "is_financial_staff(( SELECT auth.uid() AS uid))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "accounts_receivable_select_financial", "schemaname": "public", "with_check": null}, {"cmd": "UPDATE", "qual": "is_financial_staff(( SELECT auth.uid() AS uid))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "accounts_receivable_update_financial", "schemaname": "public", "with_check": "is_financial_staff(( SELECT auth.uid() AS uid))"}, {"cmd": "SELECT", "qual": "((origin_type = ''B2B_ORDER''::text) AND (platform_private.has_role(( SELECT auth.uid() AS uid), ''gestor_comercial''::app_role) OR platform_private.has_role(( SELECT auth.uid() AS uid), ''administrativo''::app_role)))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "ar_b2b_readers", "schemaname": "public", "with_check": null}, {"cmd": "SELECT", "qual": "((origin_type = ''B2B_ORDER''::text) AND platform_private.has_role(( SELECT auth.uid() AS uid), ''parceiro_b2b''::app_role) AND (partner_id = ( SELECT ((platform_private.b2b_commercial_context() ->> ''partner_id''::text))::uuid AS uuid)))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "ar_partner_select_own_b2b", "schemaname": "public", "with_check": null}, {"cmd": "SELECT", "qual": "(platform_private.has_role(( SELECT auth.uid() AS uid), ''cliente_produtor''::app_role) AND (customer_id = ANY (get_cliente_ids_for_user(( SELECT auth.uid() AS uid)))) AND (partner_id IS NULL) AND (origin_type IS DISTINCT FROM ''B2B_ORDER''::text))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "PERMISSIVE", "policyname": "ar_producer_read", "schemaname": "public", "with_check": null}, {"cmd": "DELETE", "qual": "false", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "RESTRICTIVE", "policyname": "financial_rpc_only_delete", "schemaname": "public", "with_check": null}, {"cmd": "INSERT", "qual": null, "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "RESTRICTIVE", "policyname": "financial_rpc_only_insert", "schemaname": "public", "with_check": "false"}, {"cmd": "UPDATE", "qual": "false", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "RESTRICTIVE", "policyname": "financial_rpc_only_update", "schemaname": "public", "with_check": "false"}, {"cmd": "ALL", "qual": "((organization_id IS NOT NULL) AND (organization_id = platform_private.h15_actor_organization()))", "roles": ["authenticated"], "tablename": "accounts_receivable", "permissive": "RESTRICTIVE", "policyname": "tenant_isolation_d51_5", "schemaname": "public", "with_check": "((organization_id IS NOT NULL) AND (organization_id = platform_private.h15_actor_organization()))"}, {"cmd": "INSERT", "qual": null, "roles": ["authenticated"], "tablename": "accounts_receivable_installments", "permissive": "PERMISSIVE", "policyname": "accounts_receivable_installments_insert_financial", "schemaname": "public", "with_check": "is_financial_staff(( SELECT auth.uid() AS uid))"