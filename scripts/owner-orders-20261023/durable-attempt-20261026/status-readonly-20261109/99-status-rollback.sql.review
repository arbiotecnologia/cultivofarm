-- Rollback: removes only the status RPC. Journal, closures, receipts and recover stay untouched.
-- Clients fall back to the pre-install path only on exact PGRST202 naming partner_order_attempt_status_v1.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $g$ BEGIN
 IF md5((SELECT prosrc FROM pg_proc WHERE oid = to_regprocedure('platform_private.c2_order_attempt_status_core(uuid)'))) IS DISTINCT FROM '__MD5_CORE__'
  OR md5((SELECT prosrc FROM pg_proc WHERE oid = to_regprocedure('public.partner_order_attempt_status_v1(uuid)'))) IS DISTINCT FROM '__MD5_WRAP__'
 THEN RAISE EXCEPTION 'C2AS_ROLLBACK_PIN_DRIFT'; END IF;
END $g$;
DROP FUNCTION public.partner_order_attempt_status_v1(uuid);
DROP FUNCTION platform_private.c2_order_attempt_status_core(uuid);
COMMIT;
