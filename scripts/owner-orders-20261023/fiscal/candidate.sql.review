-- REVIEW ONLY. No function body, policy, fiscal rule or data changes.
-- Direct authenticated UUID probing has no legitimate reader in the captured call graph.
-- Existing generate_b2b_receivable_secure_impl is DEFINER owned by postgres;
-- it retains execution through postgres. Service jobs retain service_role.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $$
DECLARE p record;
BEGIN
  SELECT oid, proacl::text acl, pg_get_userbyid(proowner) owner,
         md5(pg_get_functiondef(oid)) h INTO STRICT p
    FROM pg_proc WHERE oid='public.fn_fiscal_requirement_resolve(text,text,text,text,uuid,date)'::regprocedure;
  IF p.h <> '8bb99a3c335b5f9876d99d988dcf94b0'
     OR p.owner <> 'postgres'
     OR p.acl <> '{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}' THEN
    RAISE EXCEPTION 'fiscal_resolver_drift';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_proc
     WHERE oid='public.generate_b2b_receivable_secure_impl(uuid)'::regprocedure
       AND prosecdef AND pg_get_userbyid(proowner)='postgres') THEN
    RAISE EXCEPTION 'fiscal_caller_drift';
  END IF;
END $$;
REVOKE EXECUTE ON FUNCTION public.fn_fiscal_requirement_resolve(text,text,text,text,uuid,date) FROM PUBLIC, anon, authenticated;
COMMIT;