-- READ ONLY: plano e atribuição JÁ EXISTEM. Não duplicar nem arquivar.
-- Alvo humano solicitado: somente default_payment_method deste parceiro para
-- 'AUDIT-AR-20260922 - Sem transferencia'; billing_trigger deve permanecer na_entrega.
-- A UI atual NÃO oferece o método e só abre configurações a partir de pedido existente.
-- Portanto não há caminho funcional completo hoje; não criar pedido para alcançar o formulário.
SELECT id, plan_id, partner_id, status, valid_from, valid_until
FROM public.commercial_payment_plan_assignments
WHERE id='48dcac7d-d4a0-4058-bdf4-5461fee89f45'
 AND plan_id='62147f24-299e-40dd-a6a0-05718b21c55f'
 AND partner_id='7e52de9a-4bed-4d1e-8200-3255a805465c';
SELECT id, name, active FROM public.payment_methods
WHERE name='AUDIT-AR-20260922 - Sem transferencia' AND active;
SELECT partner_id, default_payment_method, billing_trigger
FROM public.partner_financial_settings
WHERE partner_id='7e52de9a-4bed-4d1e-8200-3255a805465c';
