-- REVIEW ONLY. Contenção do recorte JÁ INSTALADO 20261023192728 (não é rollback de restauração).
-- Silencia notificações de pedido/aprovação sem reabrir o vazamento cross-tenant; preserva ACL postgres-only,
-- create/approve atuais (que só chamam os helpers) e a aprovação atômica do gatilho. Não apaga dados.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $$
BEGIN
  IF md5(pg_get_functiondef('platform_private.c2_order_internal_recipients(uuid)'::regprocedure)) <> 'd4936c87a3ab62d26816a11a032dfe0f'
  OR md5(pg_get_functiondef('platform_private.c2_order_partner_recipients(uuid)'::regprocedure)) <> '70b381094ae1f3ac87d0fa8e28274dac' THEN
    RAISE EXCEPTION 'helpers_drift';
  END IF;
END $$;
CREATE OR REPLACE FUNCTION platform_private.c2_order_internal_recipients(_partner uuid)
RETURNS SETOF uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $function$ SELECT NULL::uuid WHERE false; $function$;
CREATE OR REPLACE FUNCTION platform_private.c2_order_partner_recipients(_partner uuid)
RETURNS SETOF uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $function$ SELECT NULL::uuid WHERE false; $function$;
DO $$
BEGIN
  IF has_function_privilege('authenticated','platform_private.c2_order_internal_recipients(uuid)','EXECUTE')
  OR has_function_privilege('anon','platform_private.c2_order_internal_recipients(uuid)','EXECUTE')
  OR has_function_privilege('authenticated','platform_private.c2_order_partner_recipients(uuid)','EXECUTE')
  OR has_function_privilege('anon','platform_private.c2_order_partner_recipients(uuid)','EXECUTE') THEN
    RAISE EXCEPTION 'helper_acl_exposed';
  END IF;
  IF md5(pg_get_functiondef('public.tg_auto_b2b_receivable()'::regprocedure)) <> '0f679538fe394924b140e54938a3bb9e' THEN
    RAISE EXCEPTION 'atomic_approval_drift';
  END IF;
END $$;
COMMIT;
