-- REVIEW ONLY (C2-ORD v3 rollback do candidato restante). Fecha o writer SERVER-SIDE.
-- assert_b2b_partner_scope nunca foi alterado pelo v3 (nada a restaurar). Mantém: aprovação atômica,
-- destinatários restritos (20261023192728), resolução estrita e escopo do título. Não apaga pedidos/títulos.
-- P1 CAS/fence, owner checks in approval/billing and no automatic settings INSERT remain installed.
BEGIN;
SET LOCAL lock_timeout = '5s';
-- READ ONLY block; embed in PRE/candidate/POST/rollback. No ACL mutation.
-- Canonical Supabase ref swzpzcwiasxmjutrmvkm must be checked by the operator.
DO $$
DECLARE target regprocedure := 'public.fn_b2b_order_billing_eligibility(uuid)'::regprocedure;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE oid=target AND prosecdef
    AND pg_get_userbyid(proowner)='postgres'
    AND md5(pg_get_functiondef(oid))='db977875e15ea49ce10fb3e5388d7dfb'
    AND proacl::text='{postgres=X/postgres,service_role=X/postgres}')
    OR has_function_privilege('authenticated',target,'EXECUTE')
    OR has_function_privilege('anon',target,'EXECUTE')
    OR NOT has_function_privilege('service_role',target,'EXECUTE') THEN
    RAISE EXCEPTION 'billing_eligibility_internal_acl_or_body_drift';
  END IF;
  -- Exact direct textual SQL call graph currently captured from all schemas.
  IF (SELECT array_agg(n.nspname||'.'||p.proname||'('||pg_get_function_identity_arguments(p.oid)||')'
    ORDER BY n.nspname,p.proname,p.oid)
    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
    WHERE p.prokind='f' AND p.prosrc ILIKE '%fn_b2b_order_billing_eligibility%')
    IS DISTINCT FROM ARRAY['public.generate_b2b_receivable_secure_impl(p_partner_order_id uuid)']::text[] THEN
    RAISE EXCEPTION 'billing_eligibility_call_graph_drift';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_proc
    WHERE oid='public.generate_b2b_receivable_secure_impl(uuid)'::regprocedure
      AND prosecdef AND pg_get_userbyid(proowner)='postgres') THEN
    RAISE EXCEPTION 'billing_eligibility_internal_caller_owner_drift';
  END IF;
END $$;
DO $$
BEGIN
  IF to_regprocedure('platform_private.c2_owner_order_create_allowed(uuid,uuid)') IS NULL
     OR to_regprocedure('platform_private.c2_order_actor_scope(uuid,uuid)') IS NULL THEN
    RAISE EXCEPTION 'not_installed';
  END IF;
  IF md5(pg_get_functiondef('platform_private.assert_b2b_partner_scope(uuid,uuid)'::regprocedure)) <> 'f86f43f9d9ad3ed97b840fcc02c79476' THEN
    RAISE EXCEPTION 'assert_drift';
  END IF;
  IF md5(pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure)) IS DISTINCT FROM '31bbe8f7d3c940eb9862bf7c7b7fad20'
  OR md5(pg_get_functiondef('public.generate_b2b_receivable_secure(uuid)'::regprocedure)) IS DISTINCT FROM '9c8c8a736bcd1d77ee2f237a8a59b4ce'
  OR md5(pg_get_functiondef('public.generate_b2b_receivable_secure_impl(uuid)'::regprocedure)) IS DISTINCT FROM '3b7b046290cb10ba0af08e88cabd26ce' THEN
    RAISE EXCEPTION 'installed_financial_containment_drift';
  END IF;
END $$;
-- Writer fechado: guard nega todo cliente comercial externo; wrapper nega o cumulativo; projeção false.
CREATE OR REPLACE FUNCTION platform_private.c2_owner_order_create_allowed(_uid uuid, _partner uuid)
RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $f$ SELECT false; $f$;
REVOKE ALL ON FUNCTION platform_private.c2_owner_order_create_allowed(uuid,uuid) FROM PUBLIC, anon, authenticated;
COMMIT;
