+import { z } from "zod";
+const amount = z.number().finite().nonnegative();
+const installment = z.object({ id:z.string().uuid(), numero:z.number().int(), vencimento:z.string().nullable(), valor:amount, recebido:amount, status:z.string() }).strict();
+const title = z.object({ id:z.string().uuid(),order_id:z.string().uuid(),numero:z.string(),created_at:z.string().datetime({offset:true}),total:amount,status:z.string(),installments:z.array(installment) }).strict();
+const schema = z.object({ contract:z.literal("C2_OWN_OBLIGATIONS_V1"),partner_id:z.string().uuid(),rows:z.array(title).max(50),limit:z.literal(50),documents_enabled:z.literal(false) }).strict();
+export function parseOwnFinance(data:unknown, partnerId:string) {
+  const parsed=schema.safeParse(data);
+  if(!parsed.success || parsed.data.partner_id!==partnerId) throw new Error("own_finance_unavailable");
+  return parsed.data;
+}--- a/src/hooks/useOwnFinance.ts
+++ b/src/hooks/useOwnFinance.ts
@@ -0,0 +1,22 @@
+import { useScopedPortalQuery } from "@/hooks/useScopedPortalQuery";
+import { useAuth } from "@/hooks/useAuth";
+import { supabase } from "@/integrations/supabase/client";
+import { parseOwnFinance } from "@/lib/comercial/financeContract";
+import { ownFinanceActorAllowed } from "@/lib/comercial/financeAccess";
+export function useOwnFinance(partnerId:string, cursor?:{at:string;id:string}, capability = false) {
+  const {roles}=useAuth();
+  const allowed = ownFinanceActorAllowed(roles, capability);
+  const query=useScopedPortalQuery({
+    queryKey:["portal-own-obligations","C2_OWN_OBLIGATIONS_V1",partnerId,cursor ?? null],
+    enabled:allowed && !!partnerId,
+    queryFn:async signal=>{
+      const rpc: (name:string,args:Record<string,unknown>)=>{abortSignal(signal:AbortSignal):PromiseLike<{data:unknown;error:unknown}>}=supabase.rpc.bind(supabase);
+      const {data,error}=await rpc("rpc_portal_partner_financial",{
+        p_partner_id:partnerId,p_own_finance_v1:true,p_before:cursor?.at ?? null,p_before_id:cursor?.id ?? null,
+      }).abortSignal(signal);
+      if(error) throw new Error("own_finance_unavailable");
+      return parseOwnFinance(data,partnerId);
+    },
+  });
+  return {...query,data:allowed && query.ready && !query.isError ? query.data : undefined};
+}--- a/src/components/comercial/OwnerFinance.tsx
+++ b/src/components/comercial/OwnerFinance.tsx
@@ -0,0 +1,21 @@
+import { useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Table,TableHeader,TableHead,TableRow,TableBody,TableCell } from "@/components/ui/table";
+import { brl,fmtDate } from "@/lib/financial/format";
+import { useOwnFinance } from "@/hooks/useOwnFinance";
+export function OwnerFinance({partnerId, capability = false}:{partnerId:string; capability?:boolean}) {
+  const [cursor,setCursor]=useState<{at:string;id:string}>();
+  const query=useOwnFinance(partnerId,cursor,capability);
+  const rows=query.data?.rows ?? [];
+  const last=rows.at(-1);
+  return <section className="space-y-4"><h1 className="text-xl font-semibold">Minhas obrigações com o fornecedor</h1>
+    {!query.ready ? <p role="status">Acesso indisponível.</p> : query.isError ? <div role="alert">Financeiro indisponível.<Button variant="outline" onClick={()=>{void query.refetch();}}>Tentar novamente</Button></div>
+    : query.isLoading ? <p role="status">Carregando títulos...</p> : <>
+      <Table><TableHeader><TableRow><TableHead>Pedido</TableHead><TableHead>Valor do título</TableHead><TableHead>Status</TableHead><TableHead>Parcelas</TableHead></TableRow></TableHeader>
+        <TableBody>{rows.map(row=><TableRow key={row.id}><TableCell>{row.numero}</TableCell><TableCell>{brl(row.total)}</TableCell><TableCell>{row.status}</TableCell><TableCell><ul>{row.installments?.map(i=><li key={i.id}>{i.numero} · {fmtDate(i.vencimento)} · {brl(i.valor)} · Pagamento registrado: {brl(i.recebido)} · {i.status}</li>)}</ul></TableCell></TableRow>)}</TableBody>
+      </Table>
+      {!rows.length && <p>Nenhum título autorizado nesta página.</p>}
+      <div className="flex gap-2"><Button variant="outline" disabled={!cursor} onClick={()=>setCursor(undefined)}>Mais recentes</Button><Button variant="outline" disabled={query.isFetching || rows.length!==50 || !last} onClick={()=>{if(typeof last?.created_at==='string' && typeof last.id==='string')setCursor({at:last.created_at,id:last.id});}}>Mais antigos</Button></div>
+    </>}
+  </section>;
+}
