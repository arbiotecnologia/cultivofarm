CREATE TABLE platform_private.product_evidence_gate_v1(singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false);
INSERT INTO platform_private.product_evidence_gate_v1 VALUES(true,false);
CREATE TABLE platform_private.product_evidence_history_v1(sequence bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,product_id uuid NOT NULL REFERENCES public.produtos(id),profile_id uuid NOT NULL REFERENCES public.product_technical_profiles(id),profile_revision timestamptz NOT NULL,actor_id uuid NOT NULL,evidence jsonb NOT NULL,created_at timestamptz NOT NULL DEFAULT clock_timestamp());
REVOKE ALL ON platform_private.product_evidence_gate_v1,platform_private.product_evidence_history_v1 FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.product_source_https_v1(p_url text) RETURNS boolean LANGUAGE sql IMMUTABLE SET search_path='' AS $f$
 SELECT p_url IS NOT NULL AND length(p_url)<=2048 AND p_url ~ '^https://[A-Za-z0-9.-]+(:443)?([/?#]|$)' AND p_url !~ '[[:space:][:cntrl:]\\]' AND p_url !~* '%(0[0-9a-f]|1[0-9a-f]|7f)' AND p_url !~ '^https://[^/?#]*@' AND p_url !~* '^https://(localhost|[^/?#]*\.local)(:443)?([/?#]|$)'
$f$;
REVOKE ALL ON FUNCTION platform_private.product_source_https_v1(text) FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION public.tenant_product_documentary_read_v1(p_product_id uuid) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $f$
DECLARE org uuid; result jsonb; current_profile uuid; current_revision timestamptz;
BEGIN
 org:=platform_private.catalog_tenant_actor('read_catalog');
 IF NOT EXISTS(SELECT 1 FROM public.produtos WHERE id=p_product_id AND owner_organization_id=org) THEN RAISE EXCEPTION 'product_evidence_denied' USING ERRCODE='42501'; END IF;
 SELECT id,updated_at INTO current_profile,current_revision FROM public.product_technical_profiles WHERE produto_id=p_product_id;
 SELECT evidence INTO result FROM platform_private.product_evidence_history_v1 WHERE product_id=p_product_id AND profile_id=current_profile AND profile_revision=current_revision ORDER BY sequence DESC LIMIT 1;
 RETURN jsonb_build_object('product_id',p_product_id,'profile_id',current_profile,'profile_revision',current_revision,'evidence',coalesce(result,'[]'::jsonb));
END $f$;
REVOKE ALL ON FUNCTION public.tenant_product_documentary_read_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.tenant_product_documentary_read_v1(uuid) TO authenticated;
CREATE OR REPLACE FUNCTION public.tenant_catalog_root_save(p_root text, p_id uuid, p_payload jsonb, p_expected_updated_at timestamp with time zone, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_cfg platform_private.tenant_catalog_root_cfg%ROWTYPE;
  v_evidence jsonb; v_product uuid; v_source jsonb; v_item jsonb; v_value text; v_enabled boolean;
  k text; v_hash text; v_rep jsonb; v_cols text[] := '{}'; v_row jsonb; v_prev jsonb; v_parent uuid; v_ref uuid; v_ts timestamptz;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');
  v_evidence := p_payload->'documentary_evidence';
   IF v_evidence IS NOT NULL THEN
     IF p_root <> 'product_technical_profiles' THEN RAISE EXCEPTION 'product_evidence_root_denied' USING ERRCODE='22023'; END IF;
     SELECT enabled INTO v_enabled FROM platform_private.product_evidence_gate_v1 WHERE singleton FOR SHARE;
     IF v_enabled IS DISTINCT FROM true THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
     IF jsonb_typeof(v_evidence) IS DISTINCT FROM 'array' OR jsonb_array_length(v_evidence)>40 OR octet_length(v_evidence::text)>300000 THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
     FOR v_item IN SELECT value FROM jsonb_array_elements(v_evidence) LOOP
       IF jsonb_typeof(v_item) IS DISTINCT FROM 'object' OR (v_item-ARRAY['field','value','identity','sources','candidate_key'])<>'{}' OR jsonb_typeof(v_item->'candidate_key') IS DISTINCT FROM 'string' OR length(v_item->>'candidate_key') NOT BETWEEN 1 AND 200 OR NOT coalesce(v_item->>'field','')=ANY(ARRAY['resumo_curto','explicacao_tecnica','explicacao_produtor','explicacao_b2b','indicacoes_uso','janela_aplicacao','cuidados_aplicacao','compatibilidade','beneficio_combinado']) OR jsonb_typeof(v_item->'value') IS DISTINCT FROM 'string' OR length(v_item->>'value') NOT BETWEEN 1 AND 12000 OR jsonb_typeof(v_item->'identity') IS DISTINCT FROM 'object' OR jsonb_typeof(v_item->'sources') IS DISTINCT FROM 'array' THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
       IF v_item->'identity'->>'entity' IS DISTINCT FROM 'produto' OR coalesce(v_item->'identity'->>'name','')='' OR jsonb_array_length(v_item->'sources') NOT BETWEEN 1 AND 20 THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       IF p_payload->>(v_item->>'field') IS DISTINCT FROM v_item->>'value' THEN RAISE EXCEPTION 'product_evidence_value_mismatch' USING ERRCODE='22023'; END IF;
       FOR v_source IN SELECT value FROM jsonb_array_elements(v_item->'sources') LOOP
         IF jsonb_typeof(v_source) IS DISTINCT FROM 'object' OR (v_source-ARRAY['url','title','excerpt'])<>'{}' OR NOT platform_private.product_source_https_v1(v_source->>'url') OR jsonb_typeof(v_source->'url') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'title') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'excerpt') IS DISTINCT FROM 'string' OR coalesce(v_source->>'title','')='' OR coalesce(v_source->>'excerpt','')='' OR octet_length(v_source::text)>20000 THEN RAISE EXCEPTION 'product_source_invalid' USING ERRCODE='22023'; END IF;
       END LOOP;
     END LOOP;
     p_payload := p_payload-'documentary_evidence';
   END IF;
   SELECT * INTO v_cfg FROM platform_private.tenant_catalog_root_cfg WHERE root = p_root;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object' THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(p_payload) LOOP
    IF NOT k = ANY (v_cfg.allowed) THEN RAISE EXCEPTION 'tenant_catalog_field_forbidden:%', k USING ERRCODE='22023'; END IF;
    v_cols := v_cols || k;
  END LOOP;
  IF p_id IS NOT NULL AND p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', p_root, coalesce(p_id::text,'new'), p_payload::text, coalesce(p_expected_updated_at::text,'')));
  IF v_evidence IS NOT NULL THEN v_hash := md5(v_hash || v_evidence::text); END IF;
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF platform_private.catalog_tenant_actor('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  -- referências no payload: mesma empresa (FOR SHARE no pai)
  FOR k IN SELECT jsonb_object_keys(v_cfg.refs) LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) <> 'null' THEN
      v_ref := platform_private.tenant_catalog_ref_owner(v_cfg.refs->>k, (p_payload->>k)::uuid);
      IF v_ref IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_ref_foreign:%', k USING ERRCODE='42501'; END IF;
    END IF;
  END LOOP;
  IF p_id IS NULL THEN
    IF v_cfg.kind = 'profile' AND NOT p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_required' USING ERRCODE='22023'; END IF;
    FOR k IN SELECT jsonb_object_keys(v_cfg.safe_defaults) LOOP
      IF NOT p_payload ? k THEN p_payload := p_payload || jsonb_build_object(k, v_cfg.safe_defaults->k); v_cols := v_cols || k; END IF;
    END LOOP;
    IF v_cfg.kind = 'root' THEN p_payload := p_payload || jsonb_build_object('owner_organization_id', v_org); v_cols := v_cols || 'owner_organization_id'::text; END IF;
    EXECUTE format('INSERT INTO public.%I (%s) SELECT %s FROM jsonb_populate_record(NULL::public.%I, $1) r RETURNING to_jsonb(%I.*)',
      p_root, (SELECT string_agg(quote_ident(c), ',') FROM unnest(v_cols) c),
      (SELECT string_agg('r.' || quote_ident(c), ',') FROM unnest(v_cols) c), p_root, p_root) INTO v_row USING p_payload;
  ELSE
    IF v_cfg.kind = 'profile' AND p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_immutable' USING ERRCODE='22023'; END IF;
    EXECUTE format('SELECT to_jsonb(x.*) FROM public.%I x WHERE x.id = $1 FOR UPDATE', p_root) INTO v_prev USING p_id;
    IF v_prev IS NULL THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    -- reautorização após a espera do lock (troca de empresa/revogação durante a espera nega)
    v_org2 := platform_private.catalog_tenant_actor('mutate');
    IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
    v_parent := CASE WHEN v_cfg.kind = 'root' THEN (v_prev->>'owner_organization_id')::uuid
                     ELSE platform_private.tenant_catalog_ref_owner(v_cfg.parent_tbl, (v_prev->>v_cfg.parent_col)::uuid) END;
    IF v_parent IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    IF (v_prev->>'updated_at')::timestamptz IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
    v_ts := greatest(clock_timestamp(), (v_prev->>'updated_at')::timestamptz + interval '1 microsecond');
    EXECUTE format('UPDATE public.%I x SET %s updated_at = $3 FROM jsonb_populate_record(NULL::public.%I, $1) r WHERE x.id = $2 RETURNING to_jsonb(x.*)',
      p_root, coalesce((SELECT string_agg(quote_ident(c) || ' = r.' || quote_ident(c), ', ') || ',' FROM unnest(v_cols) c), ''), p_root)
      INTO v_row USING p_payload, p_id, v_ts;
  END IF;
  IF v_evidence IS NOT NULL THEN
     v_product := (v_row->>'produto_id')::uuid;
     IF platform_private.tenant_catalog_ref_owner('produtos',v_product) IS DISTINCT FROM v_org OR platform_private.catalog_tenant_actor('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_evidence_denied' USING ERRCODE='42501'; END IF;
     FOR v_item IN SELECT value FROM jsonb_array_elements(v_evidence) LOOP
       IF v_item->'identity'->>'id' IS DISTINCT FROM v_product::text THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
     END LOOP;
     INSERT INTO platform_private.product_evidence_history_v1(product_id,profile_id,profile_revision,actor_id,evidence) VALUES(v_product,(v_row->>'id')::uuid,(v_row->>'updated_at')::timestamptz,v_uid,v_evidence);
   END IF;
   v_row := jsonb_build_object('ok', true, 'root', p_root, 'id', v_row->>'id', 'updated_at', v_row->>'updated_at',
                              'organization_id', v_org, 'replayed', false);
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  RETURN v_row;
EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION 'tenant_catalog_duplicate' USING ERRCODE='PT409';
END $function$;
