CREATE TABLE platform_private.product_evidence_gate_v1(singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),enabled boolean NOT NULL DEFAULT false);
INSERT INTO platform_private.product_evidence_gate_v1 VALUES(true,false);
CREATE TABLE platform_private.product_evidence_history_v1(sequence bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,product_id uuid NOT NULL REFERENCES public.produtos(id),profile_id uuid NOT NULL REFERENCES public.product_technical_profiles(id),profile_revision timestamptz NOT NULL,actor_id uuid NOT NULL,evidence jsonb NOT NULL,created_at timestamptz NOT NULL DEFAULT clock_timestamp());
ALTER TABLE platform_private.product_evidence_gate_v1 ENABLE ROW LEVEL SECURITY;
ALTER TABLE platform_private.product_evidence_history_v1 ENABLE ROW LEVEL SECURITY;
CREATE INDEX product_evidence_history_v1_latest ON platform_private.product_evidence_history_v1(product_id,sequence DESC);
REVOKE ALL ON platform_private.product_evidence_gate_v1,platform_private.product_evidence_history_v1 FROM PUBLIC,anon,authenticated,service_role;
REVOKE ALL ON SEQUENCE platform_private.product_evidence_history_v1_sequence_seq FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION platform_private.product_source_https_v1(p_url text) RETURNS boolean LANGUAGE sql IMMUTABLE SET search_path='' AS $f$
 SELECT p_url IS NOT NULL AND length(p_url)<=2048 AND p_url ~ '^https://[A-Za-z0-9.-]+(:443)?([/?#]|$)' AND p_url !~ '[[:space:][:cntrl:]\\]' AND p_url !~* '%(0[0-9a-f]|1[0-9a-f]|7f)' AND p_url !~ '^https://[^/?#]*@' AND p_url !~* '^https://(localhost|[^/?#]*\.local)(:443)?([/?#]|$)'
$f$;
REVOKE ALL ON FUNCTION platform_private.product_source_https_v1(text) FROM PUBLIC,anon,authenticated,service_role;
-- Called only by the canonical root motor, in the same transaction and receipt.
CREATE FUNCTION platform_private.product_relations_apply_v1(p_product uuid,p_org uuid,p_children jsonb) RETURNS void
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $f$
DECLARE child jsonb; kind text; tbl text; allowed text[]; old_row jsonb; values_json jsonb; cols text; select_cols text; k text; culture_name text;
BEGIN
 IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org OR platform_private.tenant_catalog_ref_owner('produtos',p_product) IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_relations_denied' USING ERRCODE='42501'; END IF;
 IF jsonb_typeof(p_children) IS DISTINCT FROM 'array' OR jsonb_array_length(p_children)>60 OR octet_length(p_children::text)>120000 THEN RAISE EXCEPTION 'product_relations_shape' USING ERRCODE='22023'; END IF;
 FOR child IN SELECT value FROM jsonb_array_elements(p_children) ORDER BY value->>'kind',value->>'id' LOOP
  IF jsonb_typeof(child) IS DISTINCT FROM 'object' OR (child-ARRAY['kind','id','expected','fields'])<>'{}' OR jsonb_typeof(child->'fields') IS DISTINCT FROM 'object' THEN RAISE EXCEPTION 'product_child_shape' USING ERRCODE='22023'; END IF;
  kind:=child->>'kind'; values_json:=child->'fields';
  IF kind='crop' THEN tbl:='product_crop_recommendations'; allowed:=ARRAY['cultura_id','cultura_nome','fase_recomendada','objetivo_uso','dose_recomendada','observacao','ativo'];
  ELSIF kind='target' THEN tbl:='product_target_recommendations'; allowed:=ARRAY['catalogo_alvo_id','alvo_nome','alvo_tipo','descricao','prioridade','ativo'];
  ELSIF kind='source' THEN tbl:='catalog_technical_sources'; allowed:=ARRAY['fonte_titulo','fonte_url','fonte_tipo','idioma_original','pais_origem','resumo_evidencia','nivel_confianca','data_consulta','observacoes'];
  ELSE RAISE EXCEPTION 'product_child_kind' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(values_json) LOOP
   IF NOT k=ANY(allowed) THEN RAISE EXCEPTION 'product_child_field_forbidden' USING ERRCODE='22023'; END IF;
  END LOOP;
  IF kind='source' AND values_json ? 'fonte_url' AND jsonb_typeof(values_json->'fonte_url')<>'null' AND NOT platform_private.product_source_https_v1(values_json->>'fonte_url') THEN RAISE EXCEPTION 'product_source_invalid' USING ERRCODE='22023'; END IF;
  IF kind='source' AND ((values_json ? 'fonte_tipo' AND NOT coalesce(values_json->>'fonte_tipo','')=ANY(ARRAY['artigo_cientifico','revisao_cientifica','orgao_oficial','embrapa','universidade','fabricante','patente','boletim_tecnico','outro'])) OR (values_json ? 'nivel_confianca' AND NOT coalesce(values_json->>'nivel_confianca','')=ANY(ARRAY['alto','medio','baixo']))) THEN RAISE EXCEPTION 'product_source_options' USING ERRCODE='22023'; END IF;
  IF kind='target' AND ((values_json ? 'alvo_tipo' AND NOT coalesce(values_json->>'alvo_tipo','')=ANY(ARRAY['praga','doenca','nematoide','nutricao','solo','estresse','crescimento'])) OR (values_json ? 'prioridade' AND (jsonb_typeof(values_json->'prioridade') IS DISTINCT FROM 'number' OR (values_json->>'prioridade')::numeric NOT BETWEEN 1 AND 10 OR (values_json->>'prioridade')::numeric<>trunc((values_json->>'prioridade')::numeric)))) THEN RAISE EXCEPTION 'product_target_options' USING ERRCODE='22023'; END IF;
  IF kind='crop' AND values_json ? 'cultura_id' AND jsonb_typeof(values_json->'cultura_id')<>'null' THEN
   SELECT nome INTO culture_name FROM public.culturas WHERE id=(values_json->>'cultura_id')::uuid AND ativo AND (owner_organization_id IS NULL OR owner_organization_id=p_org) FOR SHARE;
   IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   IF culture_name IS NULL THEN RAISE EXCEPTION 'product_crop_foreign' USING ERRCODE='42501'; END IF;
   values_json:=values_json||jsonb_build_object('cultura_nome',culture_name);
  END IF;
  IF kind='target' AND values_json ? 'catalogo_alvo_id' AND jsonb_typeof(values_json->'catalogo_alvo_id')<>'null' THEN
   PERFORM 1 FROM public.catalogo_alvos WHERE id=(values_json->>'catalogo_alvo_id')::uuid AND ativo FOR SHARE;
   IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   IF NOT FOUND THEN RAISE EXCEPTION 'product_target_reference_invalid' USING ERRCODE='22023'; END IF;
  END IF;
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
  IF child->>'id' IS NOT NULL THEN
   EXECUTE format('SELECT to_jsonb(x) FROM public.%I x WHERE id=$1 FOR UPDATE',tbl) INTO old_row USING (child->>'id')::uuid;
   IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   IF old_row IS NULL OR (kind='source' AND (old_row->>'entidade_tipo' IS DISTINCT FROM 'produto' OR old_row->>'entidade_id' IS DISTINCT FROM p_product::text)) OR (kind<>'source' AND old_row->>'produto_id' IS DISTINCT FROM p_product::text) THEN RAISE EXCEPTION 'product_child_foreign' USING ERRCODE='42501'; END IF;
   -- No invented updated_at on recommendations: compare the full captured row after lock.
   IF jsonb_typeof(child->'expected') IS DISTINCT FROM 'object' OR old_row IS DISTINCT FROM child->'expected' THEN RAISE EXCEPTION 'product_child_stale' USING ERRCODE='PT409'; END IF;
   SELECT string_agg(format('%I=r.%I',key,key),',') INTO cols FROM jsonb_object_keys(values_json) key;
   IF cols IS NULL THEN RAISE EXCEPTION 'product_child_empty' USING ERRCODE='22023'; END IF;
   EXECUTE format('UPDATE public.%I x SET %s FROM jsonb_populate_record(NULL::public.%I,$1) r WHERE x.id=$2',tbl,cols,tbl) USING values_json,(child->>'id')::uuid;
  ELSE
   IF child->'expected' IS DISTINCT FROM 'null'::jsonb THEN RAISE EXCEPTION 'product_child_new_expected' USING ERRCODE='22023'; END IF;
   IF kind='source' THEN values_json:=values_json||jsonb_build_object('entidade_tipo','produto','entidade_id',p_product);
   ELSE values_json:=values_json||jsonb_build_object('produto_id',p_product); END IF;
   SELECT string_agg(format('%I',key),','),string_agg(format('r.%I',key),',') INTO cols,select_cols FROM jsonb_object_keys(values_json) key;
   EXECUTE format('INSERT INTO public.%I (%s) SELECT %s FROM jsonb_populate_record(NULL::public.%I,$1) r',tbl,cols,select_cols,tbl) USING values_json;
  END IF;
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM p_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
 END LOOP;
END $f$;
REVOKE ALL ON FUNCTION platform_private.product_relations_apply_v1(uuid,uuid,jsonb) FROM PUBLIC,anon,authenticated,service_role;
CREATE FUNCTION public.tenant_product_documentary_read_v1(p_product_id uuid) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $f$
DECLARE org uuid; result jsonb; current_profile uuid; current_revision timestamptz; previous_evidence jsonb; previous_revision timestamptz;
BEGIN
 org:=platform_private.recorte_a_actor_fresh('read_catalog');
 PERFORM 1 FROM platform_private.product_evidence_gate_v1 WHERE singleton AND enabled FOR SHARE;
 IF NOT FOUND THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
 IF platform_private.recorte_a_actor_fresh('read_catalog') IS DISTINCT FROM org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.produtos WHERE id=p_product_id AND owner_organization_id=org) THEN RAISE EXCEPTION 'product_evidence_denied' USING ERRCODE='42501'; END IF;
 -- One statement snapshot for profile plus latest accepted evidence. Do not search
 -- older snapshots per field: an explicit empty evidence snapshot must not resurrect sources.
 SELECT p.id,p.updated_at,h.profile_revision,h.evidence,
   coalesce((SELECT jsonb_agg(item ORDER BY ordinal) FROM jsonb_array_elements(coalesce(h.evidence,'[]'::jsonb)) WITH ORDINALITY e(item,ordinal)
     WHERE item->'identity'->>'id'=p_product_id::text AND item->'identity'->>'name'=product.nome
       AND jsonb_typeof(to_jsonb(p)->(item->>'field'))='string'
       AND to_jsonb(p)->>(item->>'field')=item->>'value'),'[]'::jsonb)
 INTO current_profile,current_revision,previous_revision,previous_evidence,result
 FROM public.product_technical_profiles p JOIN public.produtos product ON product.id=p.produto_id AND product.owner_organization_id=org
 LEFT JOIN LATERAL (SELECT profile_revision,evidence FROM platform_private.product_evidence_history_v1
   WHERE product_id=p_product_id AND profile_id=p.id AND profile_revision<=p.updated_at ORDER BY sequence DESC LIMIT 1) h ON true
 WHERE p.produto_id=p_product_id;
 IF platform_private.recorte_a_actor_fresh('read_catalog') IS DISTINCT FROM org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
 RETURN jsonb_build_object('product_id',p_product_id,'profile_id',current_profile,'profile_revision',current_revision,'evidence',coalesce(result,'[]'::jsonb),'history',CASE WHEN previous_revision IS NOT NULL AND (previous_revision<current_revision OR previous_evidence IS DISTINCT FROM result) THEN jsonb_build_object('profile_id',current_profile,'profile_revision',previous_revision,'evidence',previous_evidence) ELSE NULL END);
END $f$;
REVOKE ALL ON FUNCTION public.tenant_product_documentary_read_v1(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.tenant_product_documentary_read_v1(uuid) TO authenticated;
CREATE OR REPLACE FUNCTION public.tenant_catalog_root_save(p_root text, p_id uuid, p_payload jsonb, p_expected_updated_at timestamp with time zone, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_cfg platform_private.tenant_catalog_root_cfg%ROWTYPE;
  v_children jsonb; v_evidence jsonb; v_product uuid; v_source jsonb; v_item jsonb; v_value text; v_enabled boolean; v_seen text[] := ARRAY[]::text[]; v_product_name text;
  k text; v_hash text; v_rep jsonb; v_cols text[] := '{}'; v_row jsonb; v_prev jsonb; v_parent uuid; v_ref uuid; v_ts timestamptz;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  IF p_root = 'product_technical_profiles' THEN v_org := platform_private.recorte_a_actor_fresh('mutate'); ELSE v_org := platform_private.catalog_tenant_actor('mutate'); END IF;
  v_children := p_payload->'product_relations';
   v_evidence := p_payload->'documentary_evidence';
   IF v_children IS NOT NULL OR v_evidence IS NOT NULL THEN
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   END IF;
   IF v_children IS NOT NULL THEN
     IF p_root <> 'product_technical_profiles' THEN RAISE EXCEPTION 'product_relations_root_denied' USING ERRCODE='22023'; END IF;
     SELECT enabled INTO v_enabled FROM platform_private.product_evidence_gate_v1 WHERE singleton FOR SHARE;
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
     IF v_enabled IS DISTINCT FROM true THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
     p_payload := p_payload-'product_relations';
   END IF;
   IF v_evidence IS NOT NULL THEN
     IF p_root <> 'product_technical_profiles' THEN RAISE EXCEPTION 'product_evidence_root_denied' USING ERRCODE='22023'; END IF;
     SELECT enabled INTO v_enabled FROM platform_private.product_evidence_gate_v1 WHERE singleton FOR SHARE;
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
     IF v_enabled IS DISTINCT FROM true THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
     IF jsonb_typeof(v_evidence) IS DISTINCT FROM 'array' OR jsonb_array_length(v_evidence)>40 OR octet_length(v_evidence::text)>300000 THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
     FOR v_item IN SELECT value FROM jsonb_array_elements(v_evidence) LOOP
       IF jsonb_typeof(v_item) IS DISTINCT FROM 'object' OR (v_item-ARRAY['field','value','identity','sources','candidate_key'])<>'{}' OR jsonb_typeof(v_item->'candidate_key') IS DISTINCT FROM 'string' OR length(v_item->>'candidate_key') NOT BETWEEN 1 AND 200 OR NOT coalesce(v_item->>'field','')=ANY(ARRAY['resumo_curto','explicacao_tecnica','explicacao_produtor','explicacao_b2b','indicacoes_uso','janela_aplicacao','cuidados_aplicacao','compatibilidade','beneficio_combinado']) OR jsonb_typeof(v_item->'value') IS DISTINCT FROM 'string' OR length(v_item->>'value') NOT BETWEEN 1 AND 12000 OR jsonb_typeof(v_item->'identity') IS DISTINCT FROM 'object' OR jsonb_typeof(v_item->'sources') IS DISTINCT FROM 'array' THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
       IF ((v_item->'identity')-ARRAY['entity','id','name','manufacturer','registration','scientificName','strain','purpose','synonyms','concentration','presentation','researchScope'])<>'{}'
         OR v_item->'identity'->>'entity' IS DISTINCT FROM 'produto'
         OR jsonb_typeof(v_item->'identity'->'id') IS DISTINCT FROM 'string'
         OR (v_item->'identity'->>'id') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
         OR jsonb_typeof(v_item->'identity'->'name') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'name') NOT BETWEEN 1 AND 1000
         OR jsonb_typeof(v_item->'identity'->'manufacturer') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'manufacturer')>1000
         OR jsonb_typeof(v_item->'identity'->'registration') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'registration')>1000
         OR jsonb_array_length(v_item->'sources') NOT BETWEEN 1 AND 20 THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       FOR k IN SELECT jsonb_object_keys(v_item->'identity') LOOP
         IF k=ANY(ARRAY['scientificName','strain','purpose','synonyms','concentration','presentation']) AND (jsonb_typeof(v_item->'identity'->k) IS DISTINCT FROM 'string' OR length(v_item->'identity'->>k)>2000) THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       END LOOP;
       IF v_item->'identity' ? 'researchScope' AND (jsonb_typeof(v_item->'identity'->'researchScope') IS DISTINCT FROM 'string' OR NOT (v_item->'identity'->>'researchScope')=ANY(ARRAY['species','product_strain'])) THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       IF (v_item->>'field')=ANY(v_seen) THEN RAISE EXCEPTION 'product_evidence_duplicate_field' USING ERRCODE='22023'; END IF;
       v_seen := array_append(v_seen,v_item->>'field');
       IF p_payload->>(v_item->>'field') IS DISTINCT FROM v_item->>'value' THEN RAISE EXCEPTION 'product_evidence_value_mismatch' USING ERRCODE='22023'; END IF;
       FOR v_source IN SELECT value FROM jsonb_array_elements(v_item->'sources') LOOP
         IF jsonb_typeof(v_source) IS DISTINCT FROM 'object' OR (v_source-ARRAY['url','title','excerpt'])<>'{}' OR NOT platform_private.product_source_https_v1(v_source->>'url') OR jsonb_typeof(v_source->'url') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'title') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'excerpt') IS DISTINCT FROM 'string' OR coalesce(v_source->>'title','')='' OR coalesce(v_source->>'excerpt','')='' OR octet_length(v_source::text)>20000 THEN RAISE EXCEPTION 'product_source_invalid' USING ERRCODE='22023'; END IF;
       END LOOP;
     END LOOP;
     p_payload := p_payload-'documentary_evidence';
   END IF;
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   SELECT * INTO v_cfg FROM platform_private.tenant_catalog_root_cfg WHERE root = p_root;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object' THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(p_payload) LOOP
    IF NOT k = ANY (v_cfg.allowed) THEN RAISE EXCEPTION 'tenant_catalog_field_forbidden:%', k USING ERRCODE='22023'; END IF;
    v_cols := v_cols || k;
  END LOOP;
  IF p_id IS NOT NULL AND p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', p_root, coalesce(p_id::text,'new'), p_payload::text, coalesce(p_expected_updated_at::text,'')));
  IF v_evidence IS NOT NULL THEN v_hash := md5(v_hash || v_evidence::text); END IF;
  IF v_children IS NOT NULL THEN v_hash := md5(v_hash || v_children::text); END IF;
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  -- referências no payload: mesma empresa (FOR SHARE no pai)
  FOR k IN SELECT jsonb_object_keys(v_cfg.refs) LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) <> 'null' THEN
      v_ref := platform_private.tenant_catalog_ref_owner(v_cfg.refs->>k, (p_payload->>k)::uuid);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
      IF v_ref IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_ref_foreign:%', k USING ERRCODE='42501'; END IF;
    END IF;
  END LOOP;
  IF p_id IS NULL THEN
    IF v_cfg.kind = 'profile' AND NOT p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_required' USING ERRCODE='22023'; END IF;
    FOR k IN SELECT jsonb_object_keys(v_cfg.safe_defaults) LOOP
      IF NOT p_payload ? k THEN p_payload := p_payload || jsonb_build_object(k, v_cfg.safe_defaults->k); v_cols := v_cols || k; END IF;
    END LOOP;
    IF v_cfg.kind = 'root' THEN p_payload := p_payload || jsonb_build_object('owner_organization_id', v_org); v_cols := v_cols || 'owner_organization_id'::text; END IF;
    EXECUTE format('INSERT INTO public.%I (%s) SELECT %s FROM jsonb_populate_record(NULL::public.%I, $1) r RETURNING to_jsonb(%I.*)',
      p_root, (SELECT string_agg(quote_ident(c), ',') FROM unnest(v_cols) c),
      (SELECT string_agg('r.' || quote_ident(c), ',') FROM unnest(v_cols) c), p_root, p_root) INTO v_row USING p_payload;
  ELSE
    IF v_cfg.kind = 'profile' AND p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_immutable' USING ERRCODE='22023'; END IF;
    EXECUTE format('SELECT to_jsonb(x.*) FROM public.%I x WHERE x.id = $1 FOR UPDATE', p_root) INTO v_prev USING p_id;
    IF v_prev IS NULL THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    -- reautorização após a espera do lock (troca de empresa/revogação durante a espera nega)
    IF p_root = 'product_technical_profiles' THEN v_org2 := platform_private.recorte_a_actor_fresh('mutate'); ELSE v_org2 := platform_private.catalog_tenant_actor('mutate'); END IF;
    IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
    v_parent := CASE WHEN v_cfg.kind = 'root' THEN (v_prev->>'owner_organization_id')::uuid
                     ELSE platform_private.tenant_catalog_ref_owner(v_cfg.parent_tbl, (v_prev->>v_cfg.parent_col)::uuid) END;
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
    IF v_parent IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    IF (v_prev->>'updated_at')::timestamptz IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
    v_ts := greatest(clock_timestamp(), (v_prev->>'updated_at')::timestamptz + interval '1 microsecond');
    EXECUTE format('UPDATE public.%I x SET %s updated_at = $3 FROM jsonb_populate_record(NULL::public.%I, $1) r WHERE x.id = $2 RETURNING to_jsonb(x.*)',
      p_root, coalesce((SELECT string_agg(quote_ident(c) || ' = r.' || quote_ident(c), ', ') || ',' FROM unnest(v_cols) c), ''), p_root)
      INTO v_row USING p_payload, p_id, v_ts;
  END IF;
  IF v_children IS NOT NULL THEN
     PERFORM platform_private.product_relations_apply_v1((v_row->>'produto_id')::uuid,v_org,v_children);
   END IF;
   IF v_evidence IS NOT NULL THEN
     v_product := (v_row->>'produto_id')::uuid;
     IF platform_private.tenant_catalog_ref_owner('produtos',v_product) IS DISTINCT FROM v_org OR platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_evidence_denied' USING ERRCODE='42501'; END IF;
     SELECT nome INTO v_product_name FROM public.produtos WHERE id=v_product AND owner_organization_id=v_org FOR SHARE;
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
     FOR v_item IN SELECT value FROM jsonb_array_elements(v_evidence) LOOP
       IF v_item->'identity'->>'name' IS DISTINCT FROM v_product_name OR v_item->'identity'->>'id' IS DISTINCT FROM v_product::text THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
     END LOOP;
     INSERT INTO platform_private.product_evidence_history_v1(product_id,profile_id,profile_revision,actor_id,evidence) VALUES(v_product,(v_row->>'id')::uuid,(v_row->>'updated_at')::timestamptz,v_uid,v_evidence);
   END IF;
   IF (v_children IS NOT NULL OR v_evidence IS NOT NULL) AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   v_row := jsonb_build_object('ok', true, 'root', p_root, 'id', v_row->>'id', 'updated_at', v_row->>'updated_at',
                              'organization_id', v_org, 'replayed', false);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
  RETURN v_row;
EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION 'tenant_catalog_duplicate' USING ERRCODE='PT409';
END $function$;
