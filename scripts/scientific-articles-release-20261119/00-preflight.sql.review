 IF to_regprocedure('platform_private.has_role(uuid,public.app_role)') IS NULL OR md5(pg_get_functiondef('platform_private.has_role(uuid,public.app_role)'::regprocedure)) <> 'c5af5b55de6d79da9b73a33948746ae2' THEN RAISE EXCEPTION 'Dependency drift: platform_private.has_role(uuid,public.app_role)'; END IF;
 IF to_regprocedure('public.can_view_catalog_internal(uuid)') IS NULL OR md5(pg_get_functiondef('public.can_view_catalog_internal(uuid)'::regprocedure)) <> 'b04164dd8464d16f52cb69e7bcf83de7' THEN RAISE EXCEPTION 'Dependency drift: public.can_view_catalog_internal(uuid)'; END IF;
 IF to_regclass('platform_private.catalog_articles_v1') IS NOT NULL OR to_regclass('platform_private.catalog_article_gate_v1') IS NOT NULL OR EXISTS(SELECT 1 FROM storage.buckets WHERE id='catalog-scientific-articles') THEN RAISE EXCEPTION 'Library already exists; stop and reconcile'; END IF;
