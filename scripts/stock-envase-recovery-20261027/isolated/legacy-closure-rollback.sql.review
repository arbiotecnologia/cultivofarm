BEGIN;
REVOKE EXECUTE ON FUNCTION public.rpc_confirmar_recebimento_entrega(uuid,jsonb) FROM PUBLIC,anon,authenticated;
REVOKE EXECUTE ON FUNCTION public.rpc_desvincular_etiqueta_entrega(uuid,uuid,text) FROM PUBLIC,anon,authenticated;
REVOKE EXECUTE ON FUNCTION public.rpc_vincular_etiqueta_embalagem(uuid,uuid) FROM PUBLIC,anon,authenticated;
DO $acl$ BEGIN IF has_function_privilege('authenticated','public.rpc_confirmar_recebimento_entrega(uuid,jsonb)','EXECUTE') OR has_function_privilege('anon','public.rpc_confirmar_recebimento_entrega(uuid,jsonb)','EXECUTE') THEN RAISE EXCEPTION 'LEGACY_CLIENT_EXECUTE_REMAINS'; END IF;IF has_function_privilege('authenticated','public.rpc_desvincular_etiqueta_entrega(uuid,uuid,text)','EXECUTE') OR has_function_privilege('anon','public.rpc_desvincular_etiqueta_entrega(uuid,uuid,text)','EXECUTE') THEN RAISE EXCEPTION 'LEGACY_CLIENT_EXECUTE_REMAINS'; END IF;IF has_function_privilege('authenticated','public.rpc_vincular_etiqueta_embalagem(uuid,uuid)','EXECUTE') OR has_function_privilege('anon','public.rpc_vincular_etiqueta_embalagem(uuid,uuid)','EXECUTE') THEN RAISE EXCEPTION 'LEGACY_CLIENT_EXECUTE_REMAINS'; END IF; END $acl$;
COMMIT;
