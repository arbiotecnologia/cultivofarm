DO $pre$ BEGIN
 IF to_regclass('platform_private.delivery_context_20261030') IS NULL OR (SELECT count(*) FROM pg_trigger WHERE tgname='zz_delivery_mutation_closed')<>1 THEN RAISE EXCEPTION 'STOCK_V2_PRE_RELEASE_COMBINED_MISSING'; END IF;
 IF to_regprocedure('platform_private.stock_envase_scope_v1(uuid,uuid,uuid,text)') IS NOT NULL OR to_regprocedure('platform_private.stock_envase_complete_v1(uuid,uuid,uuid,text)') IS NOT NULL THEN RAISE EXCEPTION 'STOCK_V2_ALREADY_INSTALLED'; END IF;
 IF md5(pg_get_functiondef('public.rpc_estoque_operar_v1(text,uuid,numeric,text,jsonb)'::regprocedure))<>'44b150bf16eaa81e69395fc3b040ce5c' OR md5(pg_get_functiondef('public.rpc_estoque_reservar_v1(uuid,text,jsonb,text,jsonb)'::regprocedure))<>'ce2e7cd4080ff2f8fc15cce9294046d9' OR md5(pg_get_functiondef('public.rpc_cockpit_registrar_envase_v1(uuid,uuid,text,uuid,jsonb,date,text,text,boolean,text)'::regprocedure))<>'867c445736fbd2de9416ae4ad6a9d253' OR md5(pg_get_functiondef('public.fn_envase_material_imutavel()'::regprocedure))<>'a1b1200dfba57684958a8ea94e7afe66' OR md5(pg_get_functiondef('public.fn_validate_envase_volume()'::regprocedure))<>'9d2f0ba3df89e211bee4bb7b85f0804b' OR md5(pg_get_functiondef('platform_private.guard_manual_cq_parent_v1()'::regprocedure))<>'fbe67571995aa8e4c942ca29215c15b5' OR md5(pg_get_functiondef('public.rpc_cockpit_criar_entrega_v1(uuid,text,jsonb,text,jsonb,timestamptz)'::regprocedure))<>'32783b253f59bf42998a585f74b8a37e' THEN RAISE EXCEPTION 'STOCK_V2_PRE_DRIFT'; END IF;
END $pre$;
