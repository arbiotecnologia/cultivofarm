-- TENANT_DISPLAY_NAME_V1 — nome de exibição do tenant ativo + nome do vendedor na projeção B2B já autorizada.
-- REVISÃO: não aplicar sem 01-pre aprovado no ref swzpzcwiasxmjutrmvkm. Gerado por generate.py; não editar.
-- Não altera org_onboarding_state, RLS, tabelas, guards nem ACL existentes.
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $pre$
BEGIN
  IF md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure)) <> '64e10608403238a41a9baf92857ca881'
  OR md5(pg_get_functiondef('platform_private.platform_actor_access_ready(uuid)'::regprocedure)) <> '048249c0c2106c3761e26eacb8d0de84'
  OR md5(pg_get_functiondef('platform_private.b2b_commercial_partner_projection()'::regprocedure)) <> 'ebd6bf6f252676ba21445427a7057588'
  OR md5(pg_get_functiondef('public.get_my_commercial_partner_projection()'::regprocedure)) <> '730a17482e07d1bc350edfaea907cd1f'
  THEN RAISE EXCEPTION 'PRE_DRIFT: corpo divergente da captura 06/11'; END IF;
  IF (SELECT coalesce(array_to_string(proacl, ','), '') FROM pg_proc WHERE oid = 'platform_private.b2b_commercial_partner_projection()'::regprocedure) <> 'postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres'
  THEN RAISE EXCEPTION 'PRE_DRIFT: ACL da projeção divergente'; END IF;
  IF to_regprocedure('public.tenant_display_name_v1()') IS NOT NULL THEN RAISE EXCEPTION 'PRE_DRIFT: tenant_display_name_v1 já existe'; END IF;
END $pre$;

CREATE FUNCTION public.tenant_display_name_v1()
RETURNS jsonb
LANGUAGE plpgsql
STABLE SECURITY DEFINER
SET search_path TO ''
AS $function$
DECLARE v_org uuid; v_name text;
BEGIN
  IF auth.uid() IS NULL THEN RAISE EXCEPTION 'auth_required' USING ERRCODE = '42501'; END IF;
  -- Guard canônico de sessão ativa: perfil ativo, sem senha provisória/convite em processamento, organização ativa.
  v_org := platform_private.h15_actor_organization();
  IF v_org IS NULL THEN RAISE EXCEPTION 'tenant_display_forbidden' USING ERRCODE = '42501'; END IF;
  -- Somente nome de exibição: sem CNPJ, e-mail, status, plano ou dados de onboarding.
  SELECT COALESCE(NULLIF(btrim(o.nome_fantasia), ''), NULLIF(btrim(o.nome), ''), NULLIF(btrim(o.razao_social), ''))
    INTO v_name FROM public.organizations o WHERE o.id = v_org AND o.ativo IS TRUE;
  RETURN jsonb_build_object('contract', 'TENANT_DISPLAY_NAME_V1', 'organization_id', v_org, 'name', v_name);
END $function$;

REVOKE ALL ON FUNCTION public.tenant_display_name_v1() FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.tenant_display_name_v1() TO authenticated;

-- Projeção B2B: um único acréscimo 'seller' (nome do commercial_owner) somente quando a cadeia B2B já permitiu.
DO $delta$
DECLARE v text := pg_get_functiondef('platform_private.b2b_commercial_partner_projection()'::regprocedure);
BEGIN
  IF (length(v) - length(replace(v, $cap$ RETURN result||jsonb_build_object('finance_capabilities',$cap$, ''))) / length($cap$ RETURN result||jsonb_build_object('finance_capabilities',$cap$) <> 1 THEN RAISE EXCEPTION 'DELTA_ANCHOR'; END IF;
  EXECUTE replace(v, $cap$ RETURN result||jsonb_build_object('finance_capabilities',$cap$, $cap$ RETURN result||jsonb_build_object('seller',(SELECT jsonb_build_object('organization_id',o.id,'name',COALESCE(NULLIF(btrim(o.nome_fantasia),''),NULLIF(btrim(o.nome),''),NULLIF(btrim(o.razao_social),''))) FROM public.organizations o WHERE permitted AND o.ativo IS TRUE AND o.id=(c->>'commercial_owner_organization_id')::uuid))||jsonb_build_object('finance_capabilities',$cap$);
END $delta$;

DO $post$
BEGIN
  IF md5(pg_get_functiondef('platform_private.b2b_commercial_partner_projection()'::regprocedure)) <> '350c34b62f113c11e24614b740dbbe95' THEN RAISE EXCEPTION 'POST_DRIFT: projeção'; END IF;
  IF (SELECT coalesce(array_to_string(proacl, ','), '') FROM pg_proc WHERE oid = 'platform_private.b2b_commercial_partner_projection()'::regprocedure) <> 'postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres' THEN RAISE EXCEPTION 'POST_DRIFT: ACL'; END IF;
END $post$;
COMMIT;
