      UNION ALL SELECT 'ordens_servico.microrganismo_id' k, count(*) n FROM public.ordens_servico x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid])
      UNION ALL SELECT 'programacao_producao.produto_id' k, count(*) n FROM public.programacao_producao x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid])
      UNION ALL SELECT 'programacao_producao.microrganismo_id' k, count(*) n FROM public.programacao_producao x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid])
      UNION ALL SELECT 'estoque_produto.produto_id' k, count(*) n FROM public.estoque_produto x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id)
      UNION ALL SELECT 'estoque_produto.microrganismo_id' k, count(*) n FROM public.estoque_produto x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id)
      UNION ALL SELECT 'estoque_embalagens.produto_id' k, count(*) n FROM public.estoque_embalagens x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id)
      UNION ALL SELECT 'produto_etiquetas.produto_id' k, count(*) n FROM public.produto_etiquetas x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id))::uuid, ((SELECT l.organization_id FROM public.estoque_embalagens eb JOIN public.lotes l ON l.id = eb.lote_id WHERE eb.id = x.embalagem_id))::uuid])
      UNION ALL SELECT 'os_faturamento_base.produto_id' k, count(*) n FROM public.os_faturamento_base x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid])
      UNION ALL SELECT 'ordens_servico_onfarm.produto_id' k, count(*) n FROM public.ordens_servico_onfarm x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid])
      UNION ALL SELECT 'ordens_servico_onfarm.microrganismo_id' k, count(*) n FROM public.ordens_servico_onfarm x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid])
