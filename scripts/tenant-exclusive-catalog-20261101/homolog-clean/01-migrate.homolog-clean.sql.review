b76cd062d6a8b96'),('platform_set_global_culture_status(uuid,timestamp with time zone,boolean,text,uuid)','c186bd8a8f0f4500505841bf33144bfe'),('platform_set_global_microorganism_status(uuid,timestamp with time zone,boolean,text,uuid)','1138754d01035ba8e2dfafa740f488e6'),('platform_set_global_volume_status(uuid,timestamp with time zone,boolean,text,text,uuid)','b4271d590c41d645ee8b0411b0646bbb'),('platform_update_global_culture(uuid,timestamp with time zone,jsonb,text,uuid)','bce75cf79297f0f864e1ce9bf3fc8296'),('platform_update_global_microorganism(uuid,timestamp with time zone,jsonb,text,uuid)','d678d4ff7332f90a235430ef3014d664'),('platform_update_global_volume(uuid,timestamp with time zone,jsonb,text,text,uuid)','85806c9d67d0896b07e834b7082c4364')) m(sig, h) LOOP
    IF to_regprocedure(r.sig) IS NULL THEN IF r.sig = ANY(ARRAY['platform_private.create_global_culture_core(jsonb,text,uuid)','platform_private.read_global_culture_detail_core(uuid)','platform_private.read_global_cultures_core(text,integer,integer)','platform_private.read_global_volume_detail_core(uuid)','platform_private.set_global_culture_status_core(uuid,timestamp with time zone,boolean,text,uuid)','platform_private.set_global_volume_status_core(uuid,timestamp with time zone,boolean,text,text,uuid)','platform_private.update_global_culture_core(uuid,timestamp with time zone,jsonb,text,uuid)','platform_private.update_global_volume_core(uuid,timestamp with time zone,jsonb,text,text,uuid)','platform_create_global_culture(jsonb,text,uuid)','platform_create_global_microorganism(jsonb,text,uuid)','platform_create_global_volume(text,uuid,jsonb,text,uuid)','platform_read_global_b2b_state(text,uuid)','platform_read_global_culture_detail(uuid)','platform_read_global_cultures(text,integer,integer)','platform_read_global_item_volumes(text,uuid,integer,integer)','platform_read_global_microorganism_detail(uuid)','platform_read_global_microorganisms(text,integer,integer,boolean)','platform_read_global_volume_detail(uuid)','platform_set_global_b2b_enabled(text,uuid,timestamp with time zone,boolean,text,uuid)','platform_set_global_culture_status(uuid,timestamp with time zone,boolean,text,uuid)','platform_set_global_microorganism_status(uuid,timestamp with time zone,boolean,text,uuid)','platform_set_global_volume_status(uuid,timestamp with time zone,boolean,text,text,uuid)','platform_update_global_culture(uuid,timestamp with time zone,jsonb,text,uuid)','platform_update_global_microorganism(uuid,timestamp with time zone,jsonb,text,uuid)','platform_update_global_volume(uuid,timestamp with time zone,jsonb,text,text,uuid)']::text[]) THEN CONTINUE; END IF; v_fail := v_fail || ('fn_missing:'||r.sig);
    ELSIF md5(pg_get_functiondef(to_regprocedure(r.sig))) <> r.h THEN v_fail := v_fail || ('fn_drift:'||r.sig); END IF;
  END LOOP;
  IF cardinality(v_fail) > 0 THEN
    RAISE EXCEPTION 'tenant_catalog_pre_failed' USING DETAIL = array_to_string(v_fail, ' | ');
  END IF;
END $pre$;
LOCK TABLE public.catalog_tenant_visibility, public.catalogo_volumes, public.commercial_campaign_products, public.commercial_condition_item_prices, public.commercial_price_rules, public.cq_parametros_referencia, public.culturas, public.entregas, public.estoque_embalagens, public.estoque_produto, public.fiscal_invoice_items, public.formulacoes, public.lotes, public.microorganism_crop_recommendations, public.microorganism_fiscal_profiles, public.microorganism_ncm_candidates, public.microorganism_regulatory_dossiers, public.microorganism_regulatory_presentations, public.microorganism_regulatory_publication_snapshots, public.microorganism_targets, public.microorganism_technical_profiles, public.microrganismos, public.objetivos_visita_sugestoes, public.ordens_servico, public.ordens_servico_onfarm, public.os_faturamento_base, public.partner_order_items, public.partner_product_prices, public.partner_simulation_items, public.product_crop_recommendations, public.product_fiscal_profiles, public.product_target_recommendations, public.product_technical_profiles, public.produto_anexos, public.produto_composicao_conjuntos, public.produto_composicao_declaracoes, public.produto_conformidade_perfis, public.produto_etiquetas, public.produtos, public.programacao_producao, public.registros_consultor, public.registros_consultor_recomendacoes, public.talhao_safras, public.talhoes, public.visitas_campo IN ACCESS EXCLUSIVE MODE;
CREATE TEMP TABLE tc_guard_pre ON COMMIT DROP AS SELECT
  (SELECT count(*) FROM public.accounts_receivable) AS receivables,
  (SELECT count(*) FROM public.partner_orders WHERE receivable_generated IS TRUE) AS orders_receivable_generated,
  (SELECT count(*) FROM public.fiscal_invoices) AS fiscal_invoices,
  (SELECT count(*) FROM public.company_fiscal_settings WHERE nfe_enabled OR nfse_enabled OR production_enabled) AS fiscal_on,
  (SELECT count(*) FROM public.partner_financial_settings WHERE auto_generate_receivable IS TRUE) AS auto_receivable_settings,
  (SELECT md5(coalesce(string_agg(id::text||':'||coalesce(internal_origin_snapshot::text,'~')||':'||coalesce(c2_external_origin_snapshot::text,'~'), '|' ORDER BY id),''))
     FROM public.partner_orders) AS origin_snapshots_md5,
  (SELECT count(*) FROM pg_proc WHERE proname LIKE 'generate_b2b_receivable_secure%'
     AND prosrc LIKE '%internal_origin_snapshot%' AND prosrc LIKE '%C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1%') AS guard_bodies;
DO $cacl$ DECLARE r record; BEGIN
  FOR r IN SELECT t FROM unnest(ARRAY['catalog_tenant_visibility','catalogo_volumes','commercial_campaign_products','commercial_condition_item_prices','commercial_price_rules','cq_parametros_referencia','culturas','entregas','estoque_embalagens','estoque_produto','fiscal_invoice_items','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','os_faturamento_base','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_anexos','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t WHERE to_regclass('public.'||t) IS NOT NULL LOOP
    EXECUTE format('REVOKE TRUNCATE, TRIGGER, REFERENCES ON public.%I FROM PUBLIC, anon, authenticated', r.t);
  END LOOP;
  RAISE NOTICE 'client_destructive_acl_closed %', 46;  -- prova no POST (ledger ainda não existe aqui)
END $cacl$;
CREATE TABLE platform_private.tenant_catalog_map(
  root text NOT NULL, old_id uuid NOT NULL, organization_id uuid NOT NULL REFERENCES public.organizations(id),
  new_id uuid NOT NULL UNIQUE DEFAULT gen_random_uuid(), reason text NOT NULL, PRIMARY KEY (root, old_id, organization_id));
CREATE TABLE platform_private.tenant_catalog_row_map(
  tbl text NOT NULL, old_id uuid NOT NULL, organization_id uuid NOT NULL, new_id uuid NOT NULL UNIQUE,
  PRIMARY KEY (tbl, old_id, organization_id));
CREATE TABLE platform_private.tenant_catalog_migration_ledger(id bigserial PRIMARY KEY, step text NOT NULL, detail jsonb NOT NULL, at timestamptz NOT NULL DEFAULT clock_timestamp());
REVOKE ALL ON platform_private.tenant_catalog_map, platform_private.tenant_catalog_row_map, platform_private.tenant_catalog_migration_ledger FROM PUBLIC, anon, authenticated;
CREATE FUNCTION platform_private.tc_agree(p uuid[]) RETURNS uuid LANGUAGE plpgsql IMMUTABLE SET search_path = '' AS $f$
DECLARE v uuid[] := ARRAY(SELECT DISTINCT x FROM unnest(p) x WHERE x IS NOT NULL);
BEGIN
  IF cardinality(v) > 1 THEN RAISE EXCEPTION 'tenant_catalog_chain_divergence' USING DETAIL = array_to_string(v, ','); END IF;
  RETURN v[1];
END $f$;
REVOKE ALL ON FUNCTION platform_private.tc_agree(uuid[]) FROM PUBLIC;
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) SELECT 'homolog_only_snapshot', jsonb_build_object('table','produto_anexos','count',count(*),
  'rows', coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.id),'[]')) FROM public.produto_anexos x;
CREATE TEMP TABLE tc_triggers ON COMMIT DROP AS
  SELECT tgrelid::regclass::text AS rel, tgname, tgenabled FROM pg_trigger
   WHERE NOT tgisinternal AND tgenabled <> 'D' AND tgrelid::regclass::text IN ('public.catalog_tenant_visibility', 'public.catalogo_volumes', 'public.commercial_campaign_products', 'public.commercial_condition_item_prices', 'public.commercial_price_rules', 'public.cq_parametros_referencia', 'public.culturas', 'public.entregas', 'public.estoque_embalagens', 'public.estoque_produto', 'public.fiscal_invoice_items', 'public.formulacoes', 'public.lotes', 'public.microorganism_crop_recommendations', 'public.microorganism_fiscal_profiles', 'public.microorganism_ncm_candidates', 'public.microorganism_regulatory_dossiers', 'public.microorganism_regulatory_presentations', 'public.microorganism_regulatory_publication_snapshots', 'public.microorganism_targets', 'public.microorganism_technical_profiles', 'public.microrganismos', 'public.objetivos_visita_sugestoes', 'public.ordens_servico', 'public.ordens_servico_onfarm', 'public.os_faturamento_base', 'public.partner_order_items', 'public.partner_product_prices', 'public.partner_simulation_items', 'public.product_crop_recommendations', 'public.product_fiscal_profiles', 'public.product_target_recommendations', 'public.product_technical_profiles', 'public.produto_anexos', 'public.produto_composicao_conjuntos', 'public.produto_composicao_declaracoes', 'public.produto_conformidade_perfis', 'public.produto_etiquetas', 'public.produtos', 'public.programacao_producao', 'public.registros_consultor', 'public.registros_consultor_recomendacoes', 'public.talhao_safras', 'public.talhoes', 'public.visitas_campo', 'catalog_tenant_visibility', 'catalogo_volumes', 'commercial_campaign_products', 'commercial_condition_item_prices', 'commercial_price_rules', 'cq_parametros_referencia', 'culturas', 'entregas', 'estoque_embalagens', 'estoque_produto', 'fiscal_invoice_items', 'formulacoes', 'lotes', 'microorganism_crop_recommendations', 'microorganism_fiscal_profiles', 'microorganism_ncm_candidates', 'microorganism_regulatory_dossiers', 'microorganism_regulatory_presentations', 'microorganism_regulatory_publication_snapshots', 'microorganism_targets', 'microorganism_technical_profiles', 'microrganismos', 'objetivos_visita_sugestoes', 'ordens_servico', 'ordens_servico_onfarm', 'os_faturamento_base', 'partner_order_items', 'partner_product_prices', 'partner_simulation_items', 'product_crop_recommendations', 'product_fiscal_profiles', 'product_target_recommendations', 'product_technical_profiles', 'produto_anexos', 'produto_composicao_conjuntos', 'produto_composicao_declaracoes', 'produto_conformidade_perfis', 'produto_etiquetas', 'produtos', 'programacao_producao', 'registros_consultor', 'registros_consultor_recomendacoes', 'talhao_safras', 'talhoes', 'visitas_campo');
DO $t$ DECLARE r record; BEGIN
  FOR r IN SELECT * FROM tc_triggers LOOP EXECUTE format('ALTER TABLE %s DISABLE TRIGGER %I', r.rel, r.tgname); END LOOP;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) SELECT 'triggers_disabled',
    coalesce(jsonb_agg(jsonb_build_object('rel',rel,'trigger',tgname,'state',tgenabled)),'[]') FROM tc_triggers;
END $t$;
CREATE TEMP TABLE tc_rows ON COMMIT DROP AS SELECT NULL::text tbl, NULL::text col, NULL::text root, NULL::uuid old_id, NULL::uuid org, NULL::uuid rid LIMIT 0;
INSERT INTO tc_rows SELECT 'catalog_tenant_visibility', 'produto_id', 'produtos', x.produto_id, x.organization_id, x.id FROM public.catalog_tenant_visibility x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'catalog_tenant_visibility', 'microrganismo_id', 'microrganismos', x.microrganismo_id, x.organization_id, x.id FROM public.catalog_tenant_visibility x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'catalog_tenant_visibility', 'cultura_id', 'culturas', x.cultura_id, x.organization_id, x.id FROM public.catalog_tenant_visibility x WHERE x.cultura_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'commercial_condition_item_prices', 'product_id', 'produtos', x.product_id, platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid]), x.id FROM public.commercial_condition_item_prices x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'commercial_condition_item_prices', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid]), x.id FROM public.commercial_condition_item_prices x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'commercial_price_rules', 'product_id', 'produtos', x.product_id, platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid]), x.id FROM public.commercial_price_rules x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'commercial_price_rules', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid]), x.id FROM public.commercial_price_rules x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_product_prices', 'product_id', 'produtos', x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id), x.id FROM public.partner_product_prices x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_product_prices', 'microrganismo_id', 'microrganismos', x.microrganismo_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id), x.id FROM public.partner_product_prices x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_simulation_items', 'product_id', 'produtos', x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT ps.partner_id FROM public.partner_simulations ps WHERE ps.id = x.simulation_id)), x.id FROM public.partner_simulation_items x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_simulation_items', 'microrganismo_id', 'microrganismos', x.microrganismo_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT ps.partner_id FROM public.partner_simulations ps WHERE ps.id = x.simulation_id)), x.id FROM public.partner_simulation_items x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'commercial_campaign_products', 'product_id', 'produtos', x.product_id, NULL::uuid, NULL::uuid FROM public.commercial_campaign_products x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_order_items', 'product_id', 'produtos', x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.order_id)), x.id FROM public.partner_order_items x WHERE x.product_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'partner_order_items', 'microrganismo_id', 'microrganismos', x.microrganismo_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.order_id)), x.id FROM public.partner_order_items x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'entregas', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid, ((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid]), x.id FROM public.entregas x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'lotes', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT pp.organization_id FROM public.programacao_producao pp WHERE pp.id = x.programacao_id))::uuid]), x.id FROM public.lotes x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'lotes', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT pp.organization_id FROM public.programacao_producao pp WHERE pp.id = x.programacao_id))::uuid]), x.id FROM public.lotes x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'ordens_servico', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.ordens_servico x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'ordens_servico', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.ordens_servico x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'programacao_producao', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid]), x.id FROM public.programacao_producao x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'programacao_producao', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid]), x.id FROM public.programacao_producao x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'estoque_produto', 'produto_id', 'produtos', x.produto_id, (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), x.id FROM public.estoque_produto x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'estoque_produto', 'microrganismo_id', 'microrganismos', x.microrganismo_id, (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), x.id FROM public.estoque_produto x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'estoque_embalagens', 'produto_id', 'produtos', x.produto_id, (SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), x.id FROM public.estoque_embalagens x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'produto_etiquetas', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id))::uuid, ((SELECT l.organization_id FROM public.estoque_embalagens eb JOIN public.lotes l ON l.id = eb.lote_id WHERE eb.id = x.embalagem_id))::uuid]), x.id FROM public.produto_etiquetas x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'os_faturamento_base', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid]), x.id FROM public.os_faturamento_base x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'ordens_servico_onfarm', 'produto_id', 'produtos', x.produto_id, platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.ordens_servico_onfarm x WHERE x.produto_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'ordens_servico_onfarm', 'microrganismo_id', 'microrganismos', x.microrganismo_id, platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.ordens_servico_onfarm x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'ordens_servico_onfarm', 'cultura_id', 'culturas', x.cultura_id, platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.ordens_servico_onfarm x WHERE x.cultura_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'registros_consultor', 'cultura_id', 'culturas', x.cultura_id, platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.registros_consultor x WHERE x.cultura_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'registros_consultor_recomendacoes', 'produto_biologico_sugerido_id', 'produtos', x.produto_biologico_sugerido_id, (SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id), x.id FROM public.registros_consultor_recomendacoes x WHERE x.produto_biologico_sugerido_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'registros_consultor_recomendacoes', 'microrganismo_id', 'microrganismos', x.microrganismo_id, (SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id), x.id FROM public.registros_consultor_recomendacoes x WHERE x.microrganismo_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'talhao_safras', 'cultura_id', 'culturas', x.cultura_id, (SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id), x.id FROM public.talhao_safras x WHERE x.cultura_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'talhoes', 'cultura_id', 'culturas', x.cultura_id, platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = x.fazenda_id))::uuid]), x.id FROM public.talhoes x WHERE x.cultura_id IS NOT NULL;
INSERT INTO tc_rows SELECT 'fiscal_invoice_items', 'source_item_id', 'produtos', x.source_item_id, (SELECT fi.organization_id FROM public.fiscal_invoices fi WHERE fi.id = x.fiscal_invoice_id), x.id FROM public.fiscal_invoice_items x WHERE x.source_item_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.fiscal_invoices fi WHERE fi.id = x.fiscal_invoice_id AND fi.invoice_type = 'NFE') AND x.source_item_id IN (SELECT id FROM public.produtos);
INSERT INTO tc_rows SELECT 'visitas_campo', 'cultura_id', 'culturas', x.cultura_id, platform_private.tc_agree(ARRAY[((SELECT t.organization_id FROM public.talhoes t WHERE t.id = x.talhao_id))::uuid, ((SELECT platform_private.tc_agree(ARRAY[(SELECT t.organization_id FROM public.talhoes t WHERE t.id = rc.talhao_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = rc.cliente_id), (SELECT fz.organization_id FROM public.fazendas fz WHERE fz.id = rc.fazenda_id)]) FROM public.registros_consultor rc WHERE rc.id = x.registro_consultor_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid]), x.id FROM public.visitas_campo x WHERE x.cultura_id IS NOT NULL;
INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT DISTINCT root, old_id, org, 'usage' FROM tc_rows WHERE org IS NOT NULL;
DO $c$ DECLARE v_n bigint; v_k bigint; v_iter int := 0; BEGIN
  LOOP
    v_n := 0; v_iter := v_iter + 1;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.product_id, u.organization_id, 'closure:microrganismos.product_id' FROM public.microrganismos s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.id WHERE s.product_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'culturas', s.cultura_id, u.organization_id, 'closure:product_crop_recommendations.cultura_id' FROM public.product_crop_recommendations s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.cultura_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'microrganismos', s.microrganismo_id, u.organization_id, 'closure:produto_composicao_declaracoes.microrganismo_id' FROM public.produto_composicao_declaracoes s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.microrganismo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'microrganismos', s.microrganismo_id, u.organization_id, 'closure:cq_parametros_referencia.microrganismo_id' FROM public.cq_parametros_referencia s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.microrganismo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.produto_id, u.organization_id, 'closure:cq_parametros_referencia.produto_id' FROM public.cq_parametros_referencia s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.microrganismo_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND s.produto_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'microrganismos', s.microrganismo_id, u.organization_id, 'closure:catalogo_volumes.microrganismo_id' FROM public.catalogo_volumes s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.microrganismo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.produto_id, u.organization_id, 'closure:catalogo_volumes.produto_id' FROM public.catalogo_volumes s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.microrganismo_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND s.produto_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'microrganismos', s.microrganismo_id, u.organization_id, 'closure:formulacoes.microrganismo_id' FROM public.formulacoes s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.microrganismo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.component_insumo_id, u.organization_id, 'closure:formulacoes.component_insumo_id' FROM public.formulacoes s JOIN platform_private.tenant_catalog_map u ON u.root='produtos' AND u.old_id=s.produto_id WHERE s.produto_id IS NOT NULL AND s.component_insumo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.produto_id, u.organization_id, 'closure:formulacoes.produto_id' FROM public.formulacoes s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.microrganismo_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND s.produto_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'produtos', s.component_insumo_id, u.organization_id, 'closure:formulacoes.component_insumo_id' FROM public.formulacoes s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.microrganismo_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND s.component_insumo_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    INSERT INTO platform_private.tenant_catalog_map(root, old_id, organization_id, reason) SELECT 'culturas', s.cultura_id, u.organization_id, 'closure:microorganism_crop_recommendations.cultura_id' FROM public.microorganism_crop_recommendations s JOIN platform_private.tenant_catalog_map u ON u.root='microrganismos' AND u.old_id=s.microrganismo_id WHERE s.microrganismo_id IS NOT NULL AND s.cultura_id IS NOT NULL ON CONFLICT DO NOTHING; GET DIAGNOSTICS v_k = ROW_COUNT; v_n := v_n + v_k;
    EXIT WHEN v_n = 0;
    IF v_iter > 50 THEN RAISE EXCEPTION 'tenant_catalog_closure_no_fixpoint'; END IF;
  END LOOP;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('closure', jsonb_build_object('iterations', v_iter,
    'by_root', (SELECT jsonb_object_agg(root, n) FROM (SELECT root, count(*) n FROM platform_private.tenant_catalog_map GROUP BY root) z)));
END $c$;
ALTER TABLE public.produtos ADD COLUMN owner_organization_id uuid REFERENCES public.organizations(id);
DO $ix$ DECLARE r record; v_def text; BEGIN
  FOR r IN SELECT i.indexrelid, i.indexrelid::regclass::text AS ix, c.conname, pg_get_indexdef(i.indexrelid) AS def
             FROM pg_index i LEFT JOIN pg_constraint c ON c.conindid = i.indexrelid AND c.conrelid = i.indrelid
            WHERE i.indrelid='public.produtos'::regclass AND i.indisunique AND NOT i.indisprimary LOOP
    -- preserva colunas/expressões/predicado; só antepõe o dono (único por empresa)
    v_def := regexp_replace(r.def, '^CREATE UNIQUE INDEX (\S+) ON (\S+) USING (\w+) \(', 'CREATE UNIQUE INDEX \1_tenant ON \2 USING \3 (owner_organization_id, ');
    IF v_def = r.def THEN RAISE EXCEPTION 'tenant_catalog_unique_rescope_unparsed:%', r.ix; END IF;
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('unique_rescoped', jsonb_build_object('table','produtos','index', r.ix, 'def', r.def, 'new', v_def));
    IF r.conname IS NOT NULL THEN EXECUTE format('ALTER TABLE public.produtos DROP CONSTRAINT %I', r.conname);
    ELSE EXECUTE format('DROP INDEX %s', r.ix); END IF;
    EXECUTE v_def;
  END LOOP;
END $ix$;
