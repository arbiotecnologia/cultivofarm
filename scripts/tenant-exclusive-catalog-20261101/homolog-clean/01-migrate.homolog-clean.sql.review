CREATE FUNCTION platform_private.produto_etiquetas_catalog_tenant_guard() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_t uuid;
BEGIN
  IF NOT (NEW.produto_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF true THEN
