      UNION ALL SELECT 'lotes.microrganismo_id' k, count(*) n FROM public.lotes x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT pp.organization_id FROM public.programacao_producao pp WHERE pp.id = x.programacao_id))::uuid])
