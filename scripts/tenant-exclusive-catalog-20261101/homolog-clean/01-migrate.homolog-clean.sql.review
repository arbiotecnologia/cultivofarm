DO $rl$ DECLARE v_had boolean; BEGIN
  SELECT relrowsecurity INTO v_had FROM pg_class WHERE oid='public.microrganismos'::regclass;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('root_rls_before', jsonb_build_object('table','microrganismos','rls', v_had,
    'policies', (SELECT coalesce(jsonb_agg(policyname),'[]') FROM pg_policies WHERE schemaname='public' AND tablename='microrganismos')));
  ALTER TABLE public.microrganismos ENABLE ROW LEVEL SECURITY;
  ALTER TABLE public.microrganismos ALTER COLUMN owner_organization_id SET DEFAULT platform_private.tenant_catalog_mutate_org();
  REVOKE ALL ON public.microrganismos FROM anon;
  REVOKE TRUNCATE, TRIGGER, REFERENCES ON public.microrganismos FROM authenticated;
  CREATE POLICY tenant_catalog_owner_restrictive ON public.microrganismos AS RESTRICTIVE FOR SELECT TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_read_org());
  CREATE POLICY tenant_catalog_owner_restrictive_ins ON public.microrganismos AS RESTRICTIVE FOR INSERT TO authenticated
    WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_restrictive_upd ON public.microrganismos AS RESTRICTIVE FOR UPDATE TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_mutate_org())
    WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_restrictive_del ON public.microrganismos AS RESTRICTIVE FOR DELETE TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_read ON public.microrganismos FOR SELECT TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_read_org());
  -- escrita permissiva SEMPRE criada (antes só quando RLS estava desligado): sem ela o CRUD por tenant ficava fechado
  IF true THEN
    CREATE POLICY tenant_catalog_owner_write_prev_open_ins ON public.microrganismos FOR INSERT TO authenticated
      WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
    CREATE POLICY tenant_catalog_owner_write_prev_open_upd ON public.microrganismos FOR UPDATE TO authenticated
      USING (owner_organization_id = platform_private.tenant_catalog_mutate_org())
      WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
    CREATE POLICY tenant_catalog_owner_write_prev_open_del ON public.microrganismos FOR DELETE TO authenticated
      USING (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  END IF;
END $rl$;
DO $rl$ DECLARE v_had boolean; BEGIN
  SELECT relrowsecurity INTO v_had FROM pg_class WHERE oid='public.culturas'::regclass;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('root_rls_before', jsonb_build_object('table','culturas','rls', v_had,
    'policies', (SELECT coalesce(jsonb_agg(policyname),'[]') FROM pg_policies WHERE schemaname='public' AND tablename='culturas')));
  ALTER TABLE public.culturas ENABLE ROW LEVEL SECURITY;
  ALTER TABLE public.culturas ALTER COLUMN owner_organization_id SET DEFAULT platform_private.tenant_catalog_mutate_org();
  REVOKE ALL ON public.culturas FROM anon;
  REVOKE TRUNCATE, TRIGGER, REFERENCES ON public.culturas FROM authenticated;
  CREATE POLICY tenant_catalog_owner_restrictive ON public.culturas AS RESTRICTIVE FOR SELECT TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_read_org());
  CREATE POLICY tenant_catalog_owner_restrictive_ins ON public.culturas AS RESTRICTIVE FOR INSERT TO authenticated
    WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_restrictive_upd ON public.culturas AS RESTRICTIVE FOR UPDATE TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_mutate_org())
    WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_restrictive_del ON public.culturas AS RESTRICTIVE FOR DELETE TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_mutate_org());
  CREATE POLICY tenant_catalog_owner_read ON public.culturas FOR SELECT TO authenticated
    USING (owner_organization_id = platform_private.tenant_catalog_read_org());
  -- escrita permissiva SEMPRE criada (antes só quando RLS estava desligado): sem ela o CRUD por tenant ficava fechado
  IF true THEN
    CREATE POLICY tenant_catalog_owner_write_prev_open_ins ON public.culturas FOR INSERT TO authenticated
      WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
    CREATE POLICY tenant_catalog_owner_write_prev_open_upd ON public.culturas FOR UPDATE TO authenticated
      USING (owner_organization_id = platform_private.tenant_catalog_mutate_org())
      WITH CHECK (owner_organization_id = platform_private.tenant_catalog_mutate_org());
    CREATE POLICY tenant_catalog_owner_write_prev_open_del ON public.culturas FOR DELETE TO authenticated
