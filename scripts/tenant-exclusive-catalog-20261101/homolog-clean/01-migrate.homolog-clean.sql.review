DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.product_fiscal_profiles'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  CREATE TEMP TABLE tc_src ON COMMIT DROP AS
    SELECT to_jsonb(s) AS j, s.*, am.organization_id AS org, am.new_id AS fx_new, gen_random_uuid() AS nid
      FROM public.product_fiscal_profiles s JOIN platform_private.tenant_catalog_map am ON am.root='produtos' AND am.old_id=s.product_id WHERE s.product_id IS NOT NULL;
  INSERT INTO public.product_fiscal_profiles
    SELECT (jsonb_populate_record(NULL::public.product_fiscal_profiles, src.j || jsonb_build_object('product_id', src.fx_new)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', src.nid) ELSE '{}'::jsonb END)).*
      FROM tc_src src;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  IF v_has_id THEN INSERT INTO platform_private.tenant_catalog_row_map SELECT 'product_fiscal_profiles', (src.j->>'id')::uuid, src.org, src.nid FROM tc_src src; END IF;
  DROP TABLE tc_src;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','product_fiscal_profiles','variant','s.product_id IS NOT NULL','rows',v_n));
END $d$;
