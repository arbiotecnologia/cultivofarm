      UNION ALL SELECT 'product_crop_recommendations.cultura_id' k, count(*) n FROM public.product_crop_recommendations s JOIN public.produtos a ON a.id = s.produto_id JOIN public.culturas b ON b.id = s.cultura_id WHERE s.produto_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'produto_composicao_declaracoes.microrganismo_id' k, count(*) n FROM public.produto_composicao_declaracoes s JOIN public.produtos a ON a.id = s.produto_id JOIN public.microrganismos b ON b.id = s.microrganismo_id WHERE s.produto_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
