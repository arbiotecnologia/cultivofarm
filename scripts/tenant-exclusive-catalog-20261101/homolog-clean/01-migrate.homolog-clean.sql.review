      UNION ALL SELECT 'formulacoes.component_insumo_id' k, count(*) n FROM public.formulacoes s JOIN public.produtos a ON a.id = s.produto_id JOIN public.produtos b ON b.id = s.component_insumo_id WHERE s.produto_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'formulacoes.produto_id' k, count(*) n FROM public.formulacoes s JOIN public.microrganismos a ON a.id = s.microrganismo_id JOIN public.produtos b ON b.id = s.produto_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'formulacoes.component_insumo_id' k, count(*) n FROM public.formulacoes s JOIN public.microrganismos a ON a.id = s.microrganismo_id JOIN public.produtos b ON b.id = s.component_insumo_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'microorganism_crop_recommendations.cultura_id' k, count(*) n FROM public.microorganism_crop_recommendations s JOIN public.microrganismos a ON a.id = s.microrganismo_id JOIN public.culturas b ON b.id = s.cultura_id WHERE s.microrganismo_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'microrganismos.product_id' k, count(*) n FROM public.microrganismos a JOIN public.produtos b ON b.id = a.product_id WHERE a.owner_organization_id <> b.owner_organization_id) q WHERE n > 0;
  IF v IS NOT NULL THEN RAISE EXCEPTION 'post:cross_tenant_reference' USING DETAIL = v; END IF;
  IF has_table_privilege('anon','public.produtos','SELECT') OR has_table_privilege('authenticated','public.produtos','INSERT')
     OR has_table_privilege('authenticated','public.produtos','UPDATE') OR has_table_privilege('authenticated','public.produtos','DELETE')
     OR has_table_privilege('authenticated','public.produtos','TRUNCATE') THEN RAISE EXCEPTION 'post:produtos_acl_open'; END IF;
  FOR r IN SELECT t, rl, pv FROM unnest(ARRAY['catalog_tenant_visibility','catalogo_volumes','commercial_campaign_products','commercial_condition_item_prices','commercial_price_rules','cq_parametros_referencia','culturas','entregas','estoque_embalagens','estoque_produto','fiscal_invoice_items','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','os_faturamento_base','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_anexos','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t,
             unnest(ARRAY['public','anon','authenticated']) rl, unnest(ARRAY['TRUNCATE','TRIGGER','REFERENCES']) pv
           WHERE to_regclass('public.'||t) IS NOT NULL AND has_table_privilege(rl, 'public.'||t, pv) LOOP
    RAISE EXCEPTION 'post:client_destructive_acl' USING DETAIL = r.t||':'||r.rl||':'||r.pv;
  END LOOP;
  FOR r IN SELECT p.oid::regprocedure AS sig FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
            WHERE n.nspname IN ('public','platform_private') AND p.proname IN ('change_global_volume', 'create_global_culture_core', 'create_global_microorganism_core', 'create_global_product_core', 'create_global_volume_core', 'global_product_fiscal_before_write', 'global_product_fiscal_ibs_save', 'global_product_fiscal_read_ready', 'global_product_fiscal_statement_gate', 'global_product_fiscal_write_ready', 'platform_create_global_culture', 'platform_create_global_microorganism', 'platform_create_global_product', 'platform_create_global_volume', 'platform_read_global_b2b_state', 'platform_read_global_culture_detail', 'platform_read_global_cultures', 'platform_read_global_item_volumes', 'platform_read_global_microorganism_detail', 'platform_read_global_microorganisms', 'platform_read_global_product_catalog', 'platform_read_global_product_catalog_by_family', 'platform_read_global_product_catalog_core', 'platform_read_global_product_composition', 'platform_read_global_product_metadata', 'platform_read_global_volume_detail', 'platform_set_global_b2b_enabled', 'platform_set_global_culture_status', 'platform_set_global_microorganism_status', 'platform_set_global_product_composition', 'platform_set_global_product_family', 'platform_set_global_product_status', 'platform_set_global_volume_status', 'platform_update_global_culture', 'platform_update_global_microorganism', 'platform_update_global_product_metadata', 'platform_update_global_volume', 'platform_wipe_global_product_catalog', 'read_global_b2b_state_core', 'read_global_culture_detail_core', 'read_global_cultures_core', 'read_global_item_volumes_core', 'read_global_microorganism_detail_core', 'read_global_microorganisms_core', 'read_global_product_catalog_by_family_core', 'read_global_product_composition_core', 'read_global_product_metadata_core', 'read_global_volume_detail_core', 'set_global_b2b_enabled_core', 'set_global_culture_status_core', 'set_global_microorganism_status_core', 'set_global_product_composition_core', 'set_global_product_family_core', 'set_global_product_status_core', 'set_global_volume_status_core', 'update_global_culture_core', 'update_global_microorganism_core', 'update_global_product_metadata_core', 'update_global_volume_core') LOOP
    IF has_function_privilege('authenticated', r.sig, 'EXECUTE') OR has_function_privilege('anon', r.sig, 'EXECUTE') THEN
      RAISE EXCEPTION 'post:global_function_open:%', r.sig; END IF;
  END LOOP;
  IF EXISTS (SELECT 1 FROM tc_triggers t JOIN pg_trigger g ON g.tgname=t.tgname AND g.tgrelid=t.rel::regclass WHERE g.tgenabled <> t.tgenabled)
    THEN RAISE EXCEPTION 'post:trigger_state_not_restored'; END IF;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('post_ok', jsonb_build_object(
    'produtos', (SELECT count(*) FROM public.produtos), 'microrganismos', (SELECT count(*) FROM public.microrganismos),
    'culturas', (SELECT count(*) FROM public.culturas), 'guard', (SELECT row_to_json(g) FROM tc_guard_post g)));
END $post$;
DROP FUNCTION platform_private.tc_agree(uuid[]);  -- auxiliar transitório, sem artefato persistente
COMMIT;
