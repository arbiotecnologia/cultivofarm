BEGIN
  -- corpos LIVE byte-idênticos salvo o trecho; validação do corpo pelo plpgsql adiada (mesma regra da carga dos corpos)
  PERFORM set_config('check_function_bodies', 'off', true);
  FOR r IN SELECT * FROM (VALUES ('platform_private.b2b_save_technical_simulation(jsonb)', 'daad3c1554f370bb0456b4ea3afdeea7', ARRAY[ROW('FROM public.produtos WHERE id=iid AND ativo AND b2b_enabled;', 'FROM public.produtos WHERE id=iid AND ativo AND b2b_enabled AND owner_organization_id=(SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = p);', 1)::platform_private.tc_delta, ROW('FROM public.microrganismos WHERE id=iid AND ativo AND b2b_enabled;', 'FROM public.microrganismos WHERE id=iid AND ativo AND b2b_enabled AND owner_organization_id=(SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = p);', 1)::platform_private.tc_delta]), ('platform_private.catalog_tenant_selection_core(text,text,integer,integer,uuid[])', '4bde839029b5c38d8cacadef823f7d4f', ARRAY[ROW('FROM public.produtos p WHERE p_entity_type=''produto''', 'FROM public.produtos p WHERE p_entity_type=''produto'' AND p.owner_organization_id=v_org', 1)::platform_private.tc_delta, ROW('FROM public.microrganismos m WHERE p_entity_type=''microrganismo''', 'FROM public.microrganismos m WHERE p_entity_type=''microrganismo'' AND m.owner_organization_id=v_org', 1)::platform_private.tc_delta, ROW('FROM public.culturas c WHERE p_entity_type=''cultura''', 'FROM public.culturas c WHERE p_entity_type=''cultura'' AND c.owner_organization_id=v_org', 1)::platform_private.tc_delta]), ('platform_private.catalog_tenant_set_visibility_core(text,uuid,boolean,integer,text,uuid)', 'c890b49cf23d7cbfedf4cb12c1cd6d89', ARRAY[ROW('FROM public.produtos WHERE id=p_entity_id;', 'FROM public.produtos WHERE id=p_entity_id AND owner_organization_id=v_org;', 1)::platform_private.tc_delta, ROW('FROM public.microrganismos WHERE id=p_entity_id;', 'FROM public.microrganismos WHERE id=p_entity_id AND owner_organization_id=v_org;', 1)::platform_private.tc_delta, ROW('FROM public.culturas WHERE id=p_entity_id;', 'FROM public.culturas WHERE id=p_entity_id AND owner_organization_id=v_org;', 1)::platform_private.tc_delta]), ('public.get_partner_catalog_secure(uuid)', 'b5684d350603d1db77ab9f1db0f4b253', ARRAY[ROW('WHERE p.ativo = true AND p.b2b_enabled = true AND', 'WHERE p.ativo = true AND p.b2b_enabled = true AND p.owner_organization_id = platform_private.catalog_tenant_seller(p_partner_id) AND', 1)::platform_private.tc_delta, ROW('WHERE m.ativo = true AND m.b2b_enabled = true AND', 'WHERE m.ativo = true AND m.b2b_enabled = true AND m.owner_organization_id = platform_private.catalog_tenant_seller(p_partner_id) AND', 1)::platform_private.tc_delta]), ('public.get_partner_catalog_tecnico_secure()', 'ab84d6835dac4d19ee71c842bd2416a9', ARRAY[ROW('WHERE p.ativo = true AND p.b2b_enabled = true AND', 'WHERE p.ativo = true AND p.b2b_enabled = true AND p.owner_organization_id = platform_private.catalog_tenant_seller(v_partner) AND', 1)::platform_private.tc_delta, ROW('WHERE m.ativo = true AND m.b2b_enabled = true AND', 'WHERE m.ativo = true AND m.b2b_enabled = true AND m.owner_organization_id = platform_private.catalog_tenant_seller(v_partner) AND', 1)::platform_private.tc_delta]), ('public.tenant_catalog_visit_selection_page(uuid,text,text,integer,integer,uuid[])', '13a76147ec7fc9be058ba3cda551cf08', ARRAY[ROW('to_jsonb(p)->>''owner_organization_id'' IS NULL', 'p.owner_organization_id=v_org', 1)::platform_private.tc_delta, ROW('to_jsonb(m)->>''owner_organization_id'' IS NULL', 'm.owner_organization_id=v_org', 1)::platform_private.tc_delta]), ('public.rpc_converter_visita_em_os(uuid,text)', 'b112888e28d8a5727df713e0ae7bcd1b', ARRAY[ROW('(to_jsonb(p)->>''owner_organization_id'') IS NULL', 'p.owner_organization_id=(SELECT cl.organization_id FROM public.registros_consultor rc JOIN public.clientes cl ON cl.id = rc.cliente_id WHERE rc.id = p_registro_id)', 1)::platform_private.tc_delta, ROW('(to_jsonb(m)->>''owner_organization_id'') IS NULL', 'm.owner_organization_id=(SELECT cl.organization_id FROM public.registros_consultor rc JOIN public.clientes cl ON cl.id = rc.cliente_id WHERE rc.id = p_registro_id)', 1)::platform_private.tc_delta]), ('platform_private.catalog_visit_reference_guard_current12()', 'b1db3fdcbd99a7b778a888ef0207170c', ARRAY[ROW('to_jsonb(m)->>''owner_organization_id'' IS NULL', 'm.owner_organization_id=v_org', 1)::platform_private.tc_delta, ROW('to_jsonb(p)->>''owner_organization_id'' IS NULL', 'p.owner_organization_id=v_org', 1)::platform_private.tc_delta]), ('public.rpc_criar_embalagens_pos_envase(jsonb)', '9d2769dbadaf3aa85afefba595e20b91', ARRAY[ROW('SELECT 1 FROM public.produtos WHERE id = v_produto)', 'SELECT 1 FROM public.produtos WHERE id = v_produto AND owner_organization_id = (SELECT l.organization_id FROM public.lotes l WHERE l.id = v_lote))', 1)::platform_private.tc_delta]), ('public.rpc_gerar_etiqueta_produto(jsonb)', '814be9eb7435c3fced7ffad44b9fc3fe', ARRAY[ROW('FROM public.produtos p WHERE p.id = v_produto_id;', 'FROM public.produtos p WHERE p.id = v_produto_id AND p.owner_organization_id = (SELECT l.organization_id FROM public.lotes l WHERE l.id = v_lote_id);
    IF NOT FOUND THEN RAISE EXCEPTION ''etiqueta_produto_tenant_denied'' USING ERRCODE = ''42501''; END IF;', 1)::platform_private.tc_delta]), ('public.rpc_microorganism_regulatory_overview()', 'a5763623af22befd1a60df8b04636e5d', ARRAY[ROW('    WHERE m.ativo
  ) s;', '    WHERE m.ativo AND m.owner_organization_id = public.h15_actor_organization()
  ) s;', 1)::platform_private.tc_delta]), ('public.rpc_fiscal_draft_save(uuid,jsonb,jsonb,integer)', '224ab7944abd13190fe8ea1044216218', ARRAY[ROW('WHERE pr.id = v_source_id)', 'WHERE pr.id = v_source_id AND pr.owner_organization_id = public.h15_actor_organization())', 1)::platform_private.tc_delta]), ('public.rpc_salvar_aplicacao_v1(uuid,jsonb,uuid,jsonb,uuid[])', '0c102f7735a44ccba6ce1364b1f30c32', ARRAY[ROW('FROM public.produtos WHERE id=product AND ativo IS TRUE FOR SHARE', 'FROM public.produtos WHERE id=product AND ativo IS TRUE AND owner_organization_id=org FOR SHARE', 1)::platform_private.tc_delta]), ('platform_private.storage1_application_allowed(text,text)', 'daefb183522e2ee7f730e0db243f4823', ARRAY[ROW('EXISTS(SELECT 1 FROM public.produtos WHERE id=product AND ativo IS TRUE)', 'EXISTS(SELECT 1 FROM public.produtos WHERE id=product AND ativo IS TRUE AND owner_organization_id=org)', 1)::platform_private.tc_delta])) t(sig, pin, reps) LOOP
    IF to_regprocedure(r.sig) IS NULL THEN RAISE EXCEPTION 'ae_delta_target_missing:%', r.sig; END IF;
    v_def := pg_get_functiondef(r.sig::regprocedure);
    IF md5(v_def) <> r.pin THEN RAISE EXCEPTION 'ae_delta_pin_drift:%', r.sig USING DETAIL = md5(v_def); END IF;
    FOREACH d IN ARRAY r.reps LOOP
      v_cnt := (length(v_def) - length(replace(v_def, d.old, ''))) / length(d.old);
      IF v_cnt <> d.n THEN RAISE EXCEPTION 'ae_delta_occurrence_mismatch:%:%', r.sig, v_cnt USING DETAIL = d.old; END IF;
      v_def := replace(v_def, d.old, d.new);
    END LOOP;
    BEGIN
      EXECUTE v_def;   -- CREATE OR REPLACE: mesma assinatura, dono e ACL
    EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'ae_delta_exec_failed:%:%', r.sig, SQLERRM;
    END;
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('ae_owner_delta', jsonb_build_object('function', r.sig, 'pin', r.pin,
      'new_md5', md5(pg_get_functiondef(r.sig::regprocedure)), 'replacements', cardinality(r.reps)));
  END LOOP;
  PERFORM set_config('check_function_bodies', 'on', true);
END $ae$;
DROP TYPE platform_private.tc_delta;
DO $closed$ DECLARE r record;
BEGIN
  FOR r IN SELECT * FROM (VALUES ('public.rpc_b2b_executive_dashboard()', 'b008fac79ad80669c8ad2de19f17892a'), ('public.rpc_b2b_carteira_kpis(date,date)', '4bf332fe6af936cb1afd0e566bb186a0'), ('public.rpc_b2b_revenue_forecast(uuid)', 'd1ec2f714516e3c45d8b608405405939')) t(sig, pin) LOOP
    IF to_regprocedure(r.sig) IS NULL THEN RAISE EXCEPTION 'tenantless_target_missing:%', r.sig; END IF;
    IF md5(pg_get_functiondef(r.sig::regprocedure)) <> r.pin THEN RAISE EXCEPTION 'tenantless_pin_drift:%', r.sig; END IF;
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC, anon, authenticated', r.sig::regprocedure);
    IF has_function_privilege('authenticated', r.sig, 'EXECUTE') OR has_function_privilege('anon', r.sig, 'EXECUTE') THEN
      RAISE EXCEPTION 'tenantless_aggregator_open:%', r.sig; END IF;
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('tenantless_aggregator_closed', jsonb_build_object('function', r.sig, 'pin', r.pin));
  END LOOP;
END $closed$;
DO $cp$ DECLARE r record; BEGIN
  FOR r IN SELECT * FROM (VALUES ('public.proximo_codigo(text,text)','e061a6487d6d3d30436d9bd3ca0e2be1'),('public.set_codigo_produto()','e5ef4aa8489889e7d20e03dc62b455ae'),('public.set_codigo_microrganismo()','22f33bb511f309ada40f710d017fcdb5')) v(sig, md5) LOOP
    IF to_regprocedure(r.sig) IS NULL OR md5(pg_get_functiondef(to_regprocedure(r.sig))) <> r.md5 THEN
      RAISE EXCEPTION 'fn_drift:%', r.sig;
    END IF;
  END LOOP;
END $cp$;
CREATE TABLE platform_private.tenant_codigo_sequencias(
  owner_organization_id uuid NOT NULL REFERENCES public.organizations(id),
  tabela text NOT NULL CHECK (tabela IN ('produtos','microrganismos')),
  prefixo text NOT NULL CHECK (prefixo ~ '^[A-Z]{2,5}$'),
  proximo_numero integer NOT NULL CHECK (proximo_numero >= 1),
  updated_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (owner_organization_id, tabela, prefixo));
REVOKE ALL ON platform_private.tenant_codigo_sequencias FROM PUBLIC, anon, authenticated, service_role;
INSERT INTO platform_private.tenant_codigo_sequencias(owner_organization_id, tabela, prefixo, proximo_numero)
  SELECT owner_organization_id, 'produtos', m[1], max(m[2]::int) + 1
    FROM (SELECT owner_organization_id, regexp_match(codigo, '^([A-Z]{2,5})-(\d+)$') m FROM public.produtos) z
   WHERE m IS NOT NULL GROUP BY 1, 3
  UNION ALL
  SELECT owner_organization_id, 'microrganismos', m[1], max(m[2]::int) + 1
    FROM (SELECT owner_organization_id, regexp_match(codigo, '^([A-Z]{2,5})-(\d+)$') m FROM public.microrganismos) z
   WHERE m IS NOT NULL GROUP BY 1, 3;
CREATE FUNCTION platform_private.tenant_proximo_codigo(p_owner uuid, p_prefixo text, p_tabela text)
 RETURNS text LANGUAGE plpgsql SECURITY DEFINER SET search_path TO ''
AS $f$
DECLARE v_seed int; v_max int; v_next int;
BEGIN
  IF p_owner IS NULL THEN RAISE EXCEPTION 'tenant_codigo_owner_required' USING ERRCODE = '42501'; END IF;
  IF p_tabela IS NULL OR p_tabela NOT IN ('produtos','microrganismos') THEN RAISE EXCEPTION 'tenant_codigo_tabela' USING ERRCODE = '22023'; END IF;
  IF p_prefixo IS NULL OR p_prefixo !~ '^[A-Z]{2,5}$' THEN RAISE EXCEPTION 'tenant_codigo_prefixo' USING ERRCODE = '22023'; END IF;
  INSERT INTO platform_private.tenant_codigo_sequencias(owner_organization_id, tabela, prefixo, proximo_numero) VALUES (p_owner, p_tabela, p_prefixo, 1)
    ON CONFLICT DO NOTHING;
  SELECT s.proximo_numero INTO v_seed FROM platform_private.tenant_codigo_sequencias s
   WHERE s.owner_organization_id = p_owner AND s.tabela = p_tabela AND s.prefixo = p_prefixo FOR UPDATE;
  -- alinhamento SOMENTE com os códigos do próprio dono (nunca lê outra empresa)
  IF p_tabela = 'produtos' THEN
    SELECT COALESCE(MAX((regexp_match(x.codigo, '^' || p_prefixo || '-(\d+)$'))[1]::int), 0) + 1 INTO v_max
      FROM public.produtos x WHERE x.owner_organization_id = p_owner;
  ELSE
    SELECT COALESCE(MAX((regexp_match(x.codigo, '^' || p_prefixo || '-(\d+)$'))[1]::int), 0) + 1 INTO v_max
      FROM public.microrganismos x WHERE x.owner_organization_id = p_owner;
  END IF;
  v_next := GREATEST(v_seed, v_max);
  UPDATE platform_private.tenant_codigo_sequencias s SET proximo_numero = v_next + 1, updated_at = now()
   WHERE s.owner_organization_id = p_owner AND s.tabela = p_tabela AND s.prefixo = p_prefixo;
  RETURN p_prefixo || '-' || v_next;
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_proximo_codigo(uuid,text,text) FROM PUBLIC, anon, authenticated, service_role;
CREATE OR REPLACE FUNCTION public.set_codigo_produto()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO ''
AS $function$
DECLARE
  v_prefixo text;
BEGIN
  IF NEW.owner_organization_id IS NULL THEN
    RETURN NEW;  -- sem dono não há sequência; RLS (WITH CHECK) / NOT NULL rejeitam a linha — o gerador não autoriza
  END IF;
  IF NEW.codigo IS NULL OR btrim(NEW.codigo) = '' THEN
    v_prefixo := public.prefixo_para_produto(NEW.tipo::text);
    IF v_prefixo IS NULL THEN
      RAISE EXCEPTION 'Tipo de produto sem prefixo definido: %', NEW.tipo;
    END IF;
    NEW.codigo := platform_private.tenant_proximo_codigo(NEW.owner_organization_id, v_prefixo, 'produtos');
  ELSE
    NEW.codigo := btrim(NEW.codigo);
  END IF;
  RETURN NEW;
END;
$function$;
REVOKE ALL ON FUNCTION public.set_codigo_produto() FROM PUBLIC, anon, authenticated;
CREATE OR REPLACE FUNCTION public.set_codigo_microrganismo()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO ''
AS $function$
DECLARE
  v_prefixo text;
BEGIN
  IF NEW.owner_organization_id IS NULL THEN
    RETURN NEW;  -- sem dono não há sequência; RLS (WITH CHECK) / NOT NULL rejeitam a linha — o gerador não autoriza
  END IF;
  IF NEW.codigo IS NULL OR btrim(NEW.codigo) = '' THEN
    v_prefixo := public.prefixo_para_microrganismo(NEW.tipo::text);
    IF v_prefixo IS NULL THEN
      RAISE EXCEPTION 'Tipo de microrganismo sem prefixo definido: %', NEW.tipo;
    END IF;
    NEW.codigo := platform_private.tenant_proximo_codigo(NEW.owner_organization_id, v_prefixo, 'microrganismos');
  ELSE
    NEW.codigo := btrim(NEW.codigo);
  END IF;
  RETURN NEW;
END;
$function$;
REVOKE ALL ON FUNCTION public.set_codigo_microrganismo() FROM PUBLIC, anon, authenticated;
CREATE OR REPLACE FUNCTION public.proximo_codigo(_prefixo text, _tabela text)
 RETURNS text LANGUAGE plpgsql SECURITY DEFINER SET search_path TO ''
AS $function$
BEGIN
  RAISE EXCEPTION 'tenant_codigo_global_generator_closed' USING ERRCODE = '42501';
END;
$function$;
REVOKE ALL ON FUNCTION public.proximo_codigo(text,text) FROM PUBLIC, anon, authenticated;
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('tenant_codigo', jsonb_build_object(
  'sequences', (SELECT count(*) FROM platform_private.tenant_codigo_sequencias), 'global_generator', 'closed', 'pins', '3'::int));
CREATE TABLE platform_private.tenant_catalog_root_cfg(
  root text PRIMARY KEY, kind text NOT NULL CHECK (kind IN ('root','profile')), allowed text[] NOT NULL,
  parent_col text NOT NULL, parent_tbl text NOT NULL, refs jsonb NOT NULL, safe_defaults jsonb NOT NULL);
INSERT INTO platform_private.tenant_catalog_root_cfg VALUES ('microrganismos','root',ARRAY['nome','tipo','nome_cientifico','concentracao_ufc_ml','concentracao_label','dose_ml_ha','valor_dose_brl','fornecedor','safra_referencia','producao_on_farm','meio_cultivo','funcao_agronomica','observacoes','ativo','b2b_enabled','codigo','descricao','preco_tabela','valor_litro_brl','product_id']::text[],'','','{"product_id": "produtos"}'::jsonb,'{"b2b_enabled": "false"}'::jsonb),('culturas','root',ARRAY['nome','descricao','ativo']::text[],'','','{}'::jsonb,'{}'::jsonb),('catalogo_volumes','root',ARRAY['item_tipo','produto_id','microrganismo_id','volume_ml','rotulo','preco_brl','moeda','ativo','ordem','preco_litro_brl','valor_dose_100ml_brl','doses_por_volume']::text[],'','','{"produto_id": "produtos", "microrganismo_id": "microrganismos"}'::jsonb,'{}'::jsonb),('product_technical_profiles','profile',ARRAY['produto_id','resumo_curto','beneficio_combinado','explicacao_tecnica','explicacao_produtor','explicacao_b2b','indicacoes_uso','janela_aplicacao','cuidados_aplicacao','compatibilidade','observacoes_regulatorias']::text[],'produto_id','produtos','{"produto_id": "produtos"}'::jsonb,'{}'::jsonb),('microorganism_technical_profiles','profile',ARRAY['microrganismo_id','resumo_curto','mecanismo_acao','beneficios_agronomicos','explicacao_tecnica','explicacao_produtor','explicacao_b2b','indicacoes_uso','cuidados_aplicacao','compatibilidade','armazenamento','observacoes_regulatorias']::text[],'microrganismo_id','microrganismos','{"microrganismo_id": "microrganismos"}'::jsonb,'{}'::jsonb);
REVOKE ALL ON platform_private.tenant_catalog_root_cfg FROM PUBLIC, anon, authenticated, service_role;
CREATE TABLE platform_private.tenant_catalog_root_receipts(
  actor_id uuid NOT NULL, organization_id uuid NOT NULL, idempotency_key uuid NOT NULL, payload_hash text NOT NULL,
  result jsonb NOT NULL, created_at timestamptz NOT NULL DEFAULT now(), PRIMARY KEY (actor_id, organization_id, idempotency_key));
REVOKE ALL ON platform_private.tenant_catalog_root_receipts FROM PUBLIC, anon, authenticated, service_role;

CREATE FUNCTION platform_private.tenant_catalog_ref_owner(p_tbl text, p_id uuid) RETURNS uuid
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v uuid;
BEGIN
  IF p_tbl NOT IN ('produtos','microrganismos','culturas') THEN RAISE EXCEPTION 'tenant_catalog_ref_table' USING ERRCODE='22023'; END IF;
  EXECUTE format('SELECT owner_organization_id FROM public.%I WHERE id = $1 FOR SHARE', p_tbl) INTO v USING p_id;
  RETURN v;
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_catalog_ref_owner(text,uuid) FROM PUBLIC, anon, authenticated, service_role;

CREATE FUNCTION platform_private.tenant_catalog_receipt(p_org uuid, p_key uuid, p_hash text) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v platform_private.tenant_catalog_root_receipts%ROWTYPE;
BEGIN
  IF p_key IS NULL THEN RAISE EXCEPTION 'tenant_catalog_key_required' USING ERRCODE='22023'; END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','tcr',auth.uid(),p_org,p_key),0));
  SELECT * INTO v FROM platform_private.tenant_catalog_root_receipts WHERE actor_id=auth.uid() AND organization_id=p_org AND idempotency_key=p_key;
  IF NOT FOUND THEN RETURN NULL; END IF;
  IF v.payload_hash <> p_hash THEN RAISE EXCEPTION 'tenant_catalog_idempotency_conflict' USING ERRCODE='PT409'; END IF;
  RETURN v.result || jsonb_build_object('replayed', true);
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_catalog_receipt(uuid,uuid,text) FROM PUBLIC, anon, authenticated, service_role;

CREATE FUNCTION public.tenant_catalog_root_save(p_root text, p_id uuid, p_payload jsonb, p_expected_updated_at timestamptz, p_idempotency_key uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_cfg platform_private.tenant_catalog_root_cfg%ROWTYPE;
  k text; v_hash text; v_rep jsonb; v_cols text[] := '{}'; v_row jsonb; v_prev jsonb; v_parent uuid; v_ref uuid; v_ts timestamptz;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');
  SELECT * INTO v_cfg FROM platform_private.tenant_catalog_root_cfg WHERE root = p_root;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object' THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(p_payload) LOOP
    IF NOT k = ANY (v_cfg.allowed) THEN RAISE EXCEPTION 'tenant_catalog_field_forbidden:%', k USING ERRCODE='22023'; END IF;
    v_cols := v_cols || k;
  END LOOP;
  IF p_id IS NOT NULL AND p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', p_root, coalesce(p_id::text,'new'), p_payload::text, coalesce(p_expected_updated_at::text,'')));
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  -- referências no payload: mesma empresa (FOR SHARE no pai)
  FOR k IN SELECT jsonb_object_keys(v_cfg.refs) LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) <> 'null' THEN
      v_ref := platform_private.tenant_catalog_ref_owner(v_cfg.refs->>k, (p_payload->>k)::uuid);
      IF v_ref IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_ref_foreign:%', k USING ERRCODE='42501'; END IF;
    END IF;
  END LOOP;
  IF p_id IS NULL THEN
    IF v_cfg.kind = 'profile' AND NOT p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_required' USING ERRCODE='22023'; END IF;
    FOR k IN SELECT jsonb_object_keys(v_cfg.safe_defaults) LOOP
      IF NOT p_payload ? k THEN p_payload := p_payload || jsonb_build_object(k, v_cfg.safe_defaults->k); v_cols := v_cols || k; END IF;
    END LOOP;
    IF v_cfg.kind = 'root' THEN p_payload := p_payload || jsonb_build_object('owner_organization_id', v_org); v_cols := v_cols || 'owner_organization_id'::text; END IF;
    EXECUTE format('INSERT INTO public.%I (%s) SELECT %s FROM jsonb_populate_record(NULL::public.%I, $1) r RETURNING to_jsonb(%I.*)',
      p_root, (SELECT string_agg(quote_ident(c), ',') FROM unnest(v_cols) c),
      (SELECT string_agg('r.' || quote_ident(c), ',') FROM unnest(v_cols) c), p_root, p_root) INTO v_row USING p_payload;
  ELSE
    IF v_cfg.kind = 'profile' AND p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_immutable' USING ERRCODE='22023'; END IF;
    EXECUTE format('SELECT to_jsonb(x.*) FROM public.%I x WHERE x.id = $1 FOR UPDATE', p_root) INTO v_prev USING p_id;
    IF v_prev IS NULL THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    -- reautorização após a espera do lock (troca de empresa/revogação durante a espera nega)
    v_org2 := platform_private.catalog_tenant_actor('mutate');
    IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
    v_parent := CASE WHEN v_cfg.kind = 'root' THEN (v_prev->>'owner_organization_id')::uuid
                     ELSE platform_private.tenant_catalog_ref_owner(v_cfg.parent_tbl, (v_prev->>v_cfg.parent_col)::uuid) END;
    IF v_parent IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
    IF (v_prev->>'updated_at')::timestamptz IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
    v_ts := greatest(clock_timestamp(), (v_prev->>'updated_at')::timestamptz + interval '1 microsecond');
    EXECUTE format('UPDATE public.%I x SET %s updated_at = $3 FROM jsonb_populate_record(NULL::public.%I, $1) r WHERE x.id = $2 RETURNING to_jsonb(x.*)',
      p_root, coalesce((SELECT string_agg(quote_ident(c) || ' = r.' || quote_ident(c), ', ') || ',' FROM unnest(v_cols) c), ''), p_root)
      INTO v_row USING p_payload, p_id, v_ts;
  END IF;
  v_row := jsonb_build_object('ok', true, 'root', p_root, 'id', v_row->>'id', 'updated_at', v_row->>'updated_at',
                              'organization_id', v_org, 'replayed', false);
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  RETURN v_row;
EXCEPTION WHEN unique_violation THEN RAISE EXCEPTION 'tenant_catalog_duplicate' USING ERRCODE='PT409';
END $f$;

CREATE FUNCTION public.tenant_catalog_root_delete(p_root text, p_id uuid, p_expected_updated_at timestamptz, p_idempotency_key uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_hash text; v_rep jsonb; v_prev jsonb; v_row jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');
  IF p_root NOT IN ('microrganismos','culturas','catalogo_volumes') THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_id IS NULL OR p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', 'delete', p_root, p_id::text, p_expected_updated_at::text));
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  EXECUTE format('SELECT to_jsonb(x.*) FROM public.%I x WHERE x.id = $1 FOR UPDATE', p_root) INTO v_prev USING p_id;
  IF v_prev IS NULL OR (v_prev->>'owner_organization_id')::uuid IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
  IF platform_private.catalog_tenant_actor('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF (v_prev->>'updated_at')::timestamptz IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
  BEGIN
    EXECUTE format('DELETE FROM public.%I WHERE id = $1', p_root) USING p_id;
  EXCEPTION WHEN foreign_key_violation THEN RAISE EXCEPTION 'tenant_catalog_in_use' USING ERRCODE='PT409';
  END;
  v_row := jsonb_build_object('ok', true, 'root', p_root, 'id', p_id, 'deleted', true, 'organization_id', v_org, 'replayed', false);
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  RETURN v_row;
END $f$;

CREATE FUNCTION public.tenant_catalog_formulacoes_replace(p_produto_id uuid, p_items jsonb, p_expected_produto_updated_at timestamptz, p_idempotency_key uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_hash text; v_rep jsonb; v_prev public.produtos%ROWTYPE; it jsonb; k text; v_n int := 0; v_ts timestamptz; v_row jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');
  IF p_produto_id IS NULL OR p_expected_produto_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  IF p_items IS NULL OR jsonb_typeof(p_items) <> 'array' OR jsonb_array_length(p_items) > 50 THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
  v_hash := md5(concat_ws('|', 'formulacoes', p_produto_id::text, p_items::text, p_expected_produto_updated_at::text));
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  SELECT * INTO v_prev FROM public.produtos WHERE id = p_produto_id FOR UPDATE;
  IF NOT FOUND OR v_prev.owner_organization_id IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
  IF platform_private.catalog_tenant_actor('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF v_prev.updated_at IS DISTINCT FROM p_expected_produto_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
  FOR it IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    IF jsonb_typeof(it) <> 'object' THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
    FOR k IN SELECT jsonb_object_keys(it) LOOP
      IF NOT k = ANY (ARRAY['microrganismo_id','component_insumo_id','concentracao','unidade','volume_ml','proporcao','e_volume_fixo']) THEN RAISE EXCEPTION 'tenant_catalog_field_forbidden:%', k USING ERRCODE='22023'; END IF;
    END LOOP;
    IF it ? 'microrganismo_id' AND jsonb_typeof(it->'microrganismo_id') <> 'null'
       AND platform_private.tenant_catalog_ref_owner('microrganismos', (it->>'microrganismo_id')::uuid) IS DISTINCT FROM v_org THEN
      RAISE EXCEPTION 'tenant_catalog_ref_foreign:microrganismo_id' USING ERRCODE='42501'; END IF;
    IF it ? 'component_insumo_id' AND jsonb_typeof(it->'component_insumo_id') <> 'null'
       AND platform_private.tenant_catalog_ref_owner('produtos', (it->>'component_insumo_id')::uuid) IS DISTINCT FROM v_org THEN
      RAISE EXCEPTION 'tenant_catalog_ref_foreign:component_insumo_id' USING ERRCODE='42501'; END IF;
  END LOOP;
  DELETE FROM public.formulacoes WHERE produto_id = p_produto_id;
  INSERT INTO public.formulacoes(produto_id, owner_organization_id, microrganismo_id, component_insumo_id, concentracao, unidade, volume_ml, proporcao, e_volume_fixo)
    SELECT p_produto_id, v_org, r.microrganismo_id, r.component_insumo_id, r.concentracao, r.unidade, r.volume_ml, r.proporcao, r.e_volume_fixo
      FROM jsonb_array_elements(p_items) e, jsonb_populate_record(NULL::public.formulacoes, e.value) r;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  v_ts := greatest(clock_timestamp(), v_prev.updated_at + interval '1 microsecond');
  UPDATE public.produtos SET updated_at = v_ts WHERE id = p_produto_id;
  v_row := jsonb_build_object('ok', true, 'produto_id', p_produto_id, 'items', v_n, 'updated_at', v_ts, 'organization_id', v_org, 'replayed', false);
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  RETURN v_row;
END $f$;
REVOKE ALL ON FUNCTION public.tenant_catalog_root_save(text,uuid,jsonb,timestamptz,uuid), public.tenant_catalog_root_delete(text,uuid,timestamptz,uuid),
  public.tenant_catalog_formulacoes_replace(uuid,jsonb,timestamptz,uuid) FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.tenant_catalog_root_save(text,uuid,jsonb,timestamptz,uuid), public.tenant_catalog_root_delete(text,uuid,timestamptz,uuid),
  public.tenant_catalog_formulacoes_replace(uuid,jsonb,timestamptz,uuid) TO authenticated;
-- escrita direta de cliente fechada (leitura por RLS preservada)
REVOKE INSERT, UPDATE, DELETE, TRUNCATE ON public.microrganismos, public.culturas, public.catalogo_volumes, public.formulacoes,
  public.product_technical_profiles, public.microorganism_technical_profiles FROM PUBLIC, anon, authenticated;
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('tenant_catalog_crud', jsonb_build_object('roots', 'microrganismos,culturas,catalogo_volumes,product_technical_profiles,microorganism_technical_profiles', 'formulacoes', 'replace_set'));
CREATE TEMP TABLE tc_guard_post ON COMMIT DROP AS SELECT
  (SELECT count(*) FROM public.accounts_receivable) AS receivables,
  (SELECT count(*) FROM public.partner_orders WHERE receivable_generated IS TRUE) AS orders_receivable_generated,
  (SELECT count(*) FROM public.fiscal_invoices) AS fiscal_invoices,
  (SELECT count(*) FROM public.company_fiscal_settings WHERE nfe_enabled OR nfse_enabled OR production_enabled) AS fiscal_on,
  (SELECT count(*) FROM public.partner_financial_settings WHERE auto_generate_receivable IS TRUE) AS auto_receivable_settings,
  (SELECT md5(coalesce(string_agg(id::text||':'||coalesce(internal_origin_snapshot::text,'~')||':'||coalesce(c2_external_origin_snapshot::text,'~'), '|' ORDER BY id),''))
     FROM public.partner_orders) AS origin_snapshots_md5,
  (SELECT count(*) FROM pg_proc WHERE proname LIKE 'generate_b2b_receivable_secure%'
     AND prosrc LIKE '%internal_origin_snapshot%' AND prosrc LIKE '%C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1%') AS guard_bodies;
DO $post$ DECLARE v text; r record; BEGIN
  FOR r IN SELECT * FROM (VALUES ('entregas','20d66f88-b3dd-4a6f-93ac-6ecf03c7468d'),('estoque_produto','000cd77c-506c-4cdf-b2bd-7233aff8efeb'),('envase','bca8a46a-77a8-435c-ae67-b0ece207d91a'),('lotes','cd49ce12-9d06-459c-b874-3c8d3a275423'),('programacao_producao','8896d700-5697-4346-9970-c76373cfb232'),('ordens_servico','4a5af44d-ea5a-4810-8b99-ea601fad8547')) m(t, id) LOOP
    EXECUTE format('SELECT count(*) FROM public.%I WHERE id = $1', r.t) INTO v USING r.id::uuid;
    IF v <> '0' THEN RAISE EXCEPTION 'post:chain_still_present:%', r.t; END IF;
  END LOOP;
  IF EXISTS (SELECT 1 FROM (SELECT * FROM tc_guard_pre EXCEPT SELECT * FROM tc_guard_post) d) OR (SELECT fiscal_on FROM tc_guard_post) > 0
     OR (SELECT guard_bodies FROM tc_guard_post) = 0 THEN
    RAISE EXCEPTION 'post:receivable_or_fiscal_guard_changed' USING DETAIL =
      (SELECT row_to_json(a)::text FROM tc_guard_pre a)||' -> '||(SELECT row_to_json(b)::text FROM tc_guard_post b);
  END IF;
  SELECT string_agg(k||'='||n, ', ') INTO v FROM (
      SELECT 'catalog_tenant_visibility.produto_id' k, count(*) n FROM public.catalog_tenant_visibility x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM x.organization_id
      UNION ALL SELECT 'catalog_tenant_visibility.microrganismo_id' k, count(*) n FROM public.catalog_tenant_visibility x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM x.organization_id
      UNION ALL SELECT 'catalog_tenant_visibility.cultura_id' k, count(*) n FROM public.catalog_tenant_visibility x JOIN public.culturas z ON z.id = x.cultura_id WHERE z.owner_organization_id IS DISTINCT FROM x.organization_id
      UNION ALL SELECT 'commercial_condition_item_prices.product_id' k, count(*) n FROM public.commercial_condition_item_prices x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid])
      UNION ALL SELECT 'commercial_condition_item_prices.microrganismo_id' k, count(*) n FROM public.commercial_condition_item_prices x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid])
      UNION ALL SELECT 'commercial_price_rules.product_id' k, count(*) n FROM public.commercial_price_rules x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid])
      UNION ALL SELECT 'commercial_price_rules.microrganismo_id' k, count(*) n FROM public.commercial_price_rules x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.customer_id))::uuid])
      UNION ALL SELECT 'partner_product_prices.product_id' k, count(*) n FROM public.partner_product_prices x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id)
      UNION ALL SELECT 'partner_product_prices.microrganismo_id' k, count(*) n FROM public.partner_product_prices x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id)
      UNION ALL SELECT 'partner_simulation_items.product_id' k, count(*) n FROM public.partner_simulation_items x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT ps.partner_id FROM public.partner_simulations ps WHERE ps.id = x.simulation_id))
      UNION ALL SELECT 'partner_simulation_items.microrganismo_id' k, count(*) n FROM public.partner_simulation_items x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT ps.partner_id FROM public.partner_simulations ps WHERE ps.id = x.simulation_id))
      UNION ALL SELECT 'commercial_campaign_products.product_id' k, count(*) n FROM public.commercial_campaign_products x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM NULL::uuid
      UNION ALL SELECT 'partner_order_items.product_id' k, count(*) n FROM public.partner_order_items x JOIN public.produtos z ON z.id = x.product_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.order_id))
      UNION ALL SELECT 'partner_order_items.microrganismo_id' k, count(*) n FROM public.partner_order_items x JOIN public.microrganismos z ON z.id = x.microrganismo_id WHERE z.owner_organization_id IS DISTINCT FROM (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.order_id))
      UNION ALL SELECT 'entregas.produto_id' k, count(*) n FROM public.entregas x JOIN public.produtos z ON z.id = x.produto_id WHERE z.owner_organization_id IS DISTINCT FROM platform_private.tc_agree(ARRAY[(x.organization_id)::uuid, ((SELECT o.organization_id FROM public.ordens_servico o WHERE o.id = x.ordem_servico_id))::uuid, ((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id))::uuid, ((SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.partner_order_id)))::uuid, ((SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id))::uuid])
