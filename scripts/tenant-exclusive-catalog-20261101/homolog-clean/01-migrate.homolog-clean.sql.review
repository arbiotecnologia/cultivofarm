-- 01 MIGRAÇÃO TRANSACIONAL v2 [VARIANTE HOMOLOG LIMPA] — catálogo EXCLUSIVO por tenant. NO_GO: NÃO APLICAR sem revisão e ordem explícita.
-- Dados de teste autorizados (01/11/2026). Raízes: produtos, microrganismos, culturas. Tenant pelos pais reais.
-- Irreversível como dado: rollback = restaurar backup anterior; mapa/ledger ficam em platform_private.
BEGIN;
SET LOCAL lock_timeout = '10s';
SET LOCAL statement_timeout = '15min';
DO $pre$
DECLARE v_fail text[] := ARRAY[]::text[]; r record; v_n bigint;
BEGIN
  -- 0. ACL cliente ENDURECIDA EXATA (pós-04): estado pré-04 ou reaberto aborta
  FOR r IN SELECT t, rl, pv FROM unnest(ARRAY['accounts_receivable','aprovacoes_tecnicas','catalog_tenant_visibility','catalogo_alvos','catalogo_volumes','clientes','commercial_campaign_products','commercial_campaigns','commercial_condition_item_prices','commercial_payment_plan_assignments','commercial_payment_plans','commercial_price_rules','cq_parametros_referencia','culturas','entrega_comprovantes','entregas','envase','estoque_embalagens','estoque_produto','fazendas','formulacoes','lotes','microorganism_crop_recommendations','microorganism_fiscal_profiles','microorganism_ncm_candidates','microorganism_regulatory_dossiers','microorganism_regulatory_presentations','microorganism_regulatory_publication_snapshots','microorganism_targets','microorganism_technical_profiles','microrganismos','objetivos_visita_sugestoes','ordens_servico','ordens_servico_onfarm','organizations','os_faturamento_base','partner_accounts','partner_order_items','partner_orders','partner_product_prices','partner_simulation_items','partner_simulations','portal_solicitacoes','product_crop_recommendations','product_fiscal_profiles','product_target_recommendations','product_technical_profiles','produto_composicao_conjuntos','produto_composicao_declaracoes','produto_conformidade_perfis','produto_etiquetas','produtos','profiles','programacao_producao','registros_consultor','registros_consultor_recomendacoes','talhao_safras','talhoes','visitas_campo']::text[]) t, unnest(ARRAY['public','anon','authenticated']) rl, unnest(ARRAY['TRUNCATE','TRIGGER','REFERENCES']) pv
           WHERE to_regclass('public.'||t) IS NOT NULL AND has_table_privilege(rl, 'public.'||t, pv) LOOP
    v_fail := v_fail || ('client_destructive_acl_not_hardened:'||r.t||':'||r.rl||':'||r.pv);
  END LOOP;
  -- homolog-only produto_anexos: estrutura EXATA capturada (colunas, constraints, zero policies/triggers de usuário); drift aborta
  IF to_regclass('public.produto_anexos') IS NULL THEN v_fail := v_fail || 'homolog_only_missing:produto_anexos'::text;
  ELSE
    IF EXISTS (SELECT format_type(a.atttypid,a.atttypmod), a.attname, pg_get_expr(d.adbin,d.adrelid), a.attnotnull
                 FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
                WHERE a.attrelid='public.produto_anexos'::regclass AND a.attnum>0 AND NOT a.attisdropped
               EXCEPT SELECT ty, n, df, nn FROM (VALUES ('id','uuid','gen_random_uuid()',true),('produto_id','uuid',NULL,false),('titulo','text',NULL,false),('url','text',NULL,false),('created_at','timestamp with time zone','now()',false)) v(n,ty,df,nn))
       OR (SELECT count(*) FROM pg_attribute WHERE attrelid='public.produto_anexos'::regclass AND attnum>0 AND NOT attisdropped) <> 5
    THEN v_fail := v_fail || 'homolog_only_column_drift:produto_anexos'::text; END IF;
    IF EXISTS (SELECT conname, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid='public.produto_anexos'::regclass
               EXCEPT SELECT n, d FROM (VALUES ('produto_anexos_pkey','PRIMARY KEY (id)'),('produto_anexos_produto_id_fkey','FOREIGN KEY (produto_id) REFERENCES produtos(id)')) v(n,d))
       OR (SELECT count(*) FROM pg_constraint WHERE conrelid='public.produto_anexos'::regclass) <> 2
    THEN v_fail := v_fail || 'homolog_only_constraint_drift:produto_anexos'::text; END IF;
    IF EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='public' AND tablename='produto_anexos')
       OR EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid='public.produto_anexos'::regclass AND NOT tgisinternal)
    THEN v_fail := v_fail || 'homolog_only_policy_trigger_drift:produto_anexos'::text; END IF;
  END IF;
  -- 1. FKs reais para as raízes == inventário (nada a mais, nada a menos)
  FOR r IN SELECT c.conrelid::regclass::text AS rel, a.attname AS col, c.confrelid::regclass::text AS tgt
             FROM pg_constraint c JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum = ANY(c.conkey)
            WHERE c.contype='f' AND c.confrelid::regclass::text IN ('public.produtos','public.culturas','public.microrganismos', 'produtos','culturas','microrganismos') LOOP
    IF NOT EXISTS (SELECT 1 FROM (VALUES ('catalog_tenant_visibility','cultura_id','culturas'),('catalog_tenant_visibility','microrganismo_id','microrganismos'),('catalog_tenant_visibility','produto_id','produtos'),('catalogo_volumes','microrganismo_id','microrganismos'),('catalogo_volumes','produto_id','produtos'),('commercial_campaign_products','product_id','produtos'),('commercial_condition_item_prices','microrganismo_id','microrganismos'),('commercial_condition_item_prices','product_id','produtos'),('commercial_price_rules','microrganismo_id','microrganismos'),('commercial_price_rules','product_id','produtos'),('cq_parametros_referencia','microrganismo_id','microrganismos'),('cq_parametros_referencia','produto_id','produtos'),('entregas','produto_id','produtos'),('estoque_embalagens','produto_id','produtos'),('estoque_produto','microrganismo_id','microrganismos'),('estoque_produto','produto_id','produtos'),('formulacoes','component_insumo_id','produtos'),('formulacoes','microrganismo_id','microrganismos'),('formulacoes','produto_id','produtos'),('lotes','microrganismo_id','microrganismos'),('lotes','produto_id','produtos'),('microorganism_crop_recommendations','cultura_id','culturas'),('microorganism_crop_recommendations','microrganismo_id','microrganismos'),('microorganism_fiscal_profiles','microorganism_id','microrganismos'),('microorganism_regulatory_dossiers','microorganism_id','microrganismos'),('microorganism_regulatory_publication_snapshots','microorganism_id','microrganismos'),('microorganism_targets','microrganismo_id','microrganismos'),('microorganism_technical_profiles','microrganismo_id','microrganismos'),('microrganismos','product_id','produtos'),('objetivos_visita_sugestoes','cultura_id','culturas'),('ordens_servico','microrganismo_id','microrganismos'),('ordens_servico','produto_id','produtos'),('ordens_servico_onfarm','cultura_id','culturas'),('ordens_servico_onfarm','microrganismo_id','microrganismos'),('ordens_servico_onfarm','produto_id','produtos'),('os_faturamento_base','produto_id','produtos'),('partner_order_items','microrganismo_id','microrganismos'),('partner_order_items','product_id','produtos'),('partner_product_prices','microrganismo_id','microrganismos'),('partner_product_prices','product_id','produtos'),('partner_simulation_items','microrganismo_id','microrganismos'),('partner_simulation_items','product_id','produtos'),('product_crop_recommendations','cultura_id','culturas'),('product_crop_recommendations','produto_id','produtos'),('product_fiscal_profiles','product_id','produtos'),('product_target_recommendations','produto_id','produtos'),('product_technical_profiles','produto_id','produtos'),('produto_anexos','produto_id','produtos'),('produto_composicao_conjuntos','produto_id','produtos'),('produto_composicao_declaracoes','microrganismo_id','microrganismos'),('produto_conformidade_perfis','produto_id','produtos'),('produto_etiquetas','produto_id','produtos'),('programacao_producao','microrganismo_id','microrganismos'),('programacao_producao','produto_id','produtos'),('registros_consultor','cultura_id','culturas'),('registros_consultor_recomendacoes','microrganismo_id','microrganismos'),('registros_consultor_recomendacoes','produto_biologico_sugerido_id','produtos'),('talhao_safras','cultura_id','culturas'),('talhoes','cultura_id','culturas'),('visitas_campo','cultura_id','culturas')) m(t,c,g)
                   WHERE m.t = replace(r.rel,'public.','') AND m.c = r.col AND m.g = replace(r.tgt,'public.','')) THEN
      v_fail := v_fail || ('fk_unmapped:'||r.rel||'.'||r.col||'->'||r.tgt);
    END IF;
  END LOOP;
  FOR r IN SELECT * FROM (VALUES ('catalog_tenant_visibility','cultura_id','culturas'),('catalog_tenant_visibility','microrganismo_id','microrganismos'),('catalog_tenant_visibility','produto_id','produtos'),('catalogo_volumes','microrganismo_id','microrganismos'),('catalogo_volumes','produto_id','produtos'),('commercial_campaign_products','product_id','produtos'),('commercial_condition_item_prices','microrganismo_id','microrganismos'),('commercial_condition_item_prices','product_id','produtos'),('commercial_price_rules','microrganismo_id','microrganismos'),('commercial_price_rules','product_id','produtos'),('cq_parametros_referencia','microrganismo_id','microrganismos'),('cq_parametros_referencia','produto_id','produtos'),('entregas','produto_id','produtos'),('estoque_embalagens','produto_id','produtos'),('estoque_produto','microrganismo_id','microrganismos'),('estoque_produto','produto_id','produtos'),('formulacoes','component_insumo_id','produtos'),('formulacoes','microrganismo_id','microrganismos'),('formulacoes','produto_id','produtos'),('lotes','microrganismo_id','microrganismos'),('lotes','produto_id','produtos'),('microorganism_crop_recommendations','cultura_id','culturas'),('microorganism_crop_recommendations','microrganismo_id','microrganismos'),('microorganism_fiscal_profiles','microorganism_id','microrganismos'),('microorganism_regulatory_dossiers','microorganism_id','microrganismos'),('microorganism_regulatory_publication_snapshots','microorganism_id','microrganismos'),('microorganism_targets','microrganismo_id','microrganismos'),('microorganism_technical_profiles','microrganismo_id','microrganismos'),('microrganismos','product_id','produtos'),('objetivos_visita_sugestoes','cultura_id','culturas'),('ordens_servico','microrganismo_id','microrganismos'),('ordens_servico','produto_id','produtos'),('ordens_servico_onfarm','cultura_id','culturas'),('ordens_servico_onfarm','microrganismo_id','microrganismos'),('ordens_servico_onfarm','produto_id','produtos'),('os_faturamento_base','produto_id','produtos'),('partner_order_items','microrganismo_id','microrganismos'),('partner_order_items','product_id','produtos'),('partner_product_prices','microrganismo_id','microrganismos'),('partner_product_prices','product_id','produtos'),('partner_simulation_items','microrganismo_id','microrganismos'),('partner_simulation_items','product_id','produtos'),('product_crop_recommendations','cultura_id','culturas'),('product_crop_recommendations','produto_id','produtos'),('product_fiscal_profiles','product_id','produtos'),('product_target_recommendations','produto_id','produtos'),('product_technical_profiles','produto_id','produtos'),('produto_anexos','produto_id','produtos'),('produto_composicao_conjuntos','produto_id','produtos'),('produto_composicao_declaracoes','microrganismo_id','microrganismos'),('produto_conformidade_perfis','produto_id','produtos'),('produto_etiquetas','produto_id','produtos'),('programacao_producao','microrganismo_id','microrganismos'),('programacao_producao','produto_id','produtos'),('registros_consultor','cultura_id','culturas'),('registros_consultor_recomendacoes','microrganismo_id','microrganismos'),('registros_consultor_recomendacoes','produto_biologico_sugerido_id','produtos'),('talhao_safras','cultura_id','culturas'),('talhoes','cultura_id','culturas'),('visitas_campo','cultura_id','culturas'), ('microorganism_regulatory_presentations','catalog_volume_id','catalogo_volumes'),('microorganism_regulatory_presentations','dossier_id','microorganism_regulatory_dossiers'),('microorganism_regulatory_publication_snapshots','dossier_id','microorganism_regulatory_dossiers'),('produto_composicao_declaracoes','produto_id','produto_composicao_conjuntos')) m(t,c,g) LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_constraint k JOIN pg_attribute a ON a.attrelid=k.conrelid AND a.attnum = ANY(k.conkey)
                    WHERE k.contype='f' AND k.conrelid = to_regclass('public.'||r.t) AND a.attname = r.c
                      AND k.confrelid = to_regclass('public.'||r.g)) THEN
      v_fail := v_fail || ('fk_missing:'||r.t||'.'||r.c||'->'||r.g);
    END IF;
  END LOOP;
  -- 2. colunas de pais usadas na derivação do tenant
  FOR r IN SELECT * FROM (VALUES ('microorganism_ncm_candidates','dossier_id'),('microorganism_regulatory_dossiers','published_ncm_candidate_id'),('partner_accounts','commercial_owner_organization_id'),('partner_orders','partner_id'),('partner_simulations','partner_id'),('clientes','organization_id'),('fazendas','organization_id'),('talhoes','organization_id'),('lotes','organization_id'),('entregas','organization_id'),('ordens_servico','organization_id'),('programacao_producao','organization_id'),('registros_consultor','talhao_id'),('registros_consultor','cliente_id'),('registros_consultor','fazenda_id'),('os_faturamento_base','ordem_servico_id'),('estoque_embalagens','lote_id'),('fiscal_invoice_items','source_item_id'),('fiscal_invoice_items','fiscal_invoice_id'),('fiscal_invoices','invoice_type'),('fiscal_invoices','organization_id'),('partner_orders','internal_origin_snapshot'),('partner_orders','c2_external_origin_snapshot'),('partner_orders','receivable_generated'),('partner_financial_settings','auto_generate_receivable'),('company_fiscal_settings','nfe_enabled'),('company_fiscal_settings','nfse_enabled'),('company_fiscal_settings','production_enabled')) m(t,c) LOOP
    IF to_regclass('public.'||r.t) IS NULL OR NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid=('public.'||r.t)::regclass
         AND attname=r.c AND NOT attisdropped) THEN v_fail := v_fail || ('dep_column_missing:'||r.t||'.'||r.c); END IF;
  END LOOP;
  -- 3. estado anterior: nada instalado parcialmente
  FOR r IN SELECT unnest(ARRAY['public.produtos','public.culturas','public.microrganismos']) AS rel LOOP
    IF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid=r.rel::regclass AND attname='owner_organization_id' AND NOT attisdropped)
      THEN v_fail := v_fail || ('partial:'||r.rel||'.owner_organization_id'); END IF;
    -- unicidades não-PK: conjunto EXATO pinado da captura real (inclui expressão/parcial revisadas); drift aborta
    FOR r IN SELECT i.indexrelid::regclass::text AS ix, pg_get_indexdef(i.indexrelid) AS def FROM pg_index i
              WHERE i.indrelid=r.rel::regclass AND i.indisunique AND NOT i.indisprimary LOOP
      IF NOT (r.def = ANY(ARRAY['CREATE UNIQUE INDEX culturas_nome_ci_uidx ON public.culturas USING btree (lower(btrim(nome)))','CREATE UNIQUE INDEX microrganismos_codigo_key ON public.microrganismos USING btree (codigo)','CREATE UNIQUE INDEX microrganismos_codigo_uniq ON public.microrganismos USING btree (codigo) WHERE (codigo IS NOT NULL)','CREATE UNIQUE INDEX microrganismos_nome_unique ON public.microrganismos USING btree (nome)','CREATE UNIQUE INDEX produtos_codigo_key ON public.produtos USING btree (codigo)']::text[])) THEN v_fail := v_fail || ('unique_index_drift:unexpected:'||r.ix); END IF;
    END LOOP;
  END LOOP;
  FOR r IN SELECT d FROM unnest(ARRAY['CREATE UNIQUE INDEX culturas_nome_ci_uidx ON public.culturas USING btree (lower(btrim(nome)))','CREATE UNIQUE INDEX microrganismos_codigo_key ON public.microrganismos USING btree (codigo)','CREATE UNIQUE INDEX microrganismos_codigo_uniq ON public.microrganismos USING btree (codigo) WHERE (codigo IS NOT NULL)','CREATE UNIQUE INDEX microrganismos_nome_unique ON public.microrganismos USING btree (nome)','CREATE UNIQUE INDEX produtos_codigo_key ON public.produtos USING btree (codigo)']::text[]) d LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_index i WHERE pg_get_indexdef(i.indexrelid)=r.d) THEN v_fail := v_fail || ('unique_index_drift:missing:'||r.d); END IF;
  END LOOP;
  IF to_regclass('platform_private.tenant_catalog_map') IS NOT NULL OR to_regclass('platform_private.tenant_catalog_row_map') IS NOT NULL THEN v_fail := v_fail || 'partial:map_present'::text; END IF;
  IF to_regprocedure('public.tenant_product_save(uuid,jsonb,timestamptz,uuid)') IS NOT NULL THEN v_fail := v_fail || 'partial:rpc_present'::text; END IF;
  -- 4. dependências canônicas
  IF to_regprocedure('platform_private.catalog_tenant_actor(text)') IS NULL THEN v_fail := v_fail || 'dep:catalog_tenant_actor'::text; END IF;
  IF to_regclass('public.organizations') IS NULL THEN v_fail := v_fail || 'dep:organizations'::text; END IF;
  -- 6. geração de recebível continua bloqueada e fiscal desligado (provado antes; reprovado no POST)
  IF EXISTS (SELECT 1 FROM public.company_fiscal_settings WHERE nfe_enabled OR nfse_enabled OR production_enabled) THEN
    v_fail := v_fail || 'fiscal_enabled'::text; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname LIKE 'generate_b2b_receivable_secure%'
                  AND prosrc LIKE '%internal_origin_snapshot%' AND prosrc LIKE '%C2_EXTERNAL_ORDER_REQUEST_PENDING_ACCOUNTING_V1%') THEN
    v_fail := v_fail || 'receivable_origin_guard_missing'::text; END IF;
  -- 7. cadeia de teste sem empresa: descartada ANTES pela manutenção 02-chain-purge-maintenance (pré-requisito)
  FOR r IN SELECT * FROM (VALUES ('entregas','20d66f88-b3dd-4a6f-93ac-6ecf03c7468d'),('estoque_produto','000cd77c-506c-4cdf-b2bd-7233aff8efeb'),('envase','bca8a46a-77a8-435c-ae67-b0ece207d91a'),('lotes','cd49ce12-9d06-459c-b874-3c8d3a275423'),('programacao_producao','8896d700-5697-4346-9970-c76373cfb232'),('ordens_servico','4a5af44d-ea5a-4810-8b99-ea601fad8547')) m(t, id) LOOP
    EXECUTE format('SELECT count(*) FROM public.%I WHERE id = $1', r.t) INTO v_n USING r.id::uuid;
    IF v_n <> 0 THEN v_fail := v_fail || ('chain_not_purged_run_maintenance_02:'||r.t); END IF;
  END LOOP;
  -- 5. as 104 funções consumidoras capturadas devem estar byte-idênticas (md5 de pg_get_functiondef)
  FOR r IN SELECT * FROM (VALUES ('platform_private.b2b_save_technical_simulation(jsonb)','daad3c1554f370bb0456b4ea3afdeea7'),('platform_private.catalog_composition_row_guard()','3e9492073fafdb012ce2b2636e6bb066'),('platform_private.catalog_tenant_actor(text)','5e0ce9cc9122f1c21d76e29a13de8b59'),('platform_private.catalog_tenant_hidden_ids_core(text)','9e4b4e53faee7b610b382d982b749d65'),('platform_private.catalog_tenant_read_visibility_core(text,uuid[])','8dab707c49a804e9c69f25c7f1625b77'),('platform_private.catalog_tenant_selection_core(text,text,integer,integer,uuid[])','4bde839029b5c38d8cacadef823f7d4f'),('platform_private.catalog_tenant_set_visibility_core(text,uuid,boolean,integer,text,uuid)','c890b49cf23d7cbfedf4cb12c1cd6d89'),('platform_private.catalog_tenant_visibility_ledger_immutable()','abdad8e4542a94aa532496d05a74dd97'),('platform_private.catalog_visit_reference_guard_current12()','b1db3fdcbd99a7b778a888ef0207170c'),('platform_private.catalog_volume_assert_row(uuid,text,uuid)','ad3752e8f8ac664eefadd409b67ef90a'),('platform_private.catalog_volume_parent(text,uuid,boolean)','08f9568dd0b9527fcb661188eded1dde'),('platform_private.catalog_volume_preview_token(uuid,text,uuid,jsonb,text,timestamp with time zone,text,uuid,jsonb)','2eaad379952d685d3b02eab8c3d4dc15'),('platform_private.catalog_volume_row(uuid)','892e124ebaac8203728ce8573ac0279b'),('platform_private.change_global_volume(text,uuid,timestamp with time zone,jsonb,boolean,text,text,uuid)','36d8ee1abbfb64d95d64bd84ff0b864c'),('platform_private.create_global_microorganism_core(jsonb,text,uuid)','69b01d045a358bd8405dd3111248381c'),('platform_private.create_global_product_core(jsonb,text,uuid)','e09129b948fdc2a8974d62df1ca9c7f2'),('platform_private.create_global_volume_core(text,uuid,jsonb,text,uuid)','cffda97cc2ef6f12459acd34b22216fd'),('platform_private.global_product_fiscal_before_write()','db436eb02fc46a11bd407be80599f5c1'),('platform_private.global_product_fiscal_ibs_save(uuid,jsonb,text)','366d6bb9e6