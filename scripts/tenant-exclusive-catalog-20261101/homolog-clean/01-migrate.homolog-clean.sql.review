INSERT INTO public.produtos
  SELECT (jsonb_populate_record(NULL::public.produtos, to_jsonb(p)
          || jsonb_build_object('id', m.new_id, 'owner_organization_id', m.organization_id))).*
    FROM public.produtos p JOIN platform_private.tenant_catalog_map m ON m.root='produtos' AND m.old_id = p.id;
INSERT INTO public.culturas
  SELECT (jsonb_populate_record(NULL::public.culturas, to_jsonb(p)
          || jsonb_build_object('id', m.new_id, 'owner_organization_id', m.organization_id))).*
    FROM public.culturas p JOIN platform_private.tenant_catalog_map m ON m.root='culturas' AND m.old_id = p.id;
INSERT INTO public.microrganismos
  SELECT (jsonb_populate_record(NULL::public.microrganismos, to_jsonb(p)
          || jsonb_build_object('id', m.new_id, 'owner_organization_id', m.organization_id) || jsonb_build_object('product_id', (SELECT mm.new_id FROM platform_private.tenant_catalog_map mm WHERE mm.root='produtos' AND mm.old_id=p.product_id AND mm.organization_id=m.organization_id)))).*
    FROM public.microrganismos p JOIN platform_private.tenant_catalog_map m ON m.root='microrganismos' AND m.old_id = p.id;
