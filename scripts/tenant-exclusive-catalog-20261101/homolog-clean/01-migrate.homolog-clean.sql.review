DO $od$ BEGIN
  IF EXISTS (SELECT 1 FROM public.catalogo_volumes WHERE owner_organization_id IS NULL) THEN RAISE EXCEPTION 'tenant_catalog_owned_child_without_owner' USING DETAIL='catalogo_volumes'; END IF;
END $od$;
ALTER TABLE public.catalogo_volumes ALTER COLUMN owner_organization_id SET NOT NULL;
CREATE INDEX catalogo_volumes_owner_idx ON public.catalogo_volumes (owner_organization_id);
CREATE FUNCTION platform_private.catalogo_volumes_owner_consistent() RETURNS trigger LANGUAGE plpgsql SET search_path = '' AS $f$
BEGIN
  IF TG_OP = 'UPDATE' AND NEW.owner_organization_id IS DISTINCT FROM OLD.owner_organization_id THEN
    RAISE EXCEPTION 'tenant_catalog_owner_immutable' USING ERRCODE = '42501'; END IF;
  IF NEW.produto_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.produtos p WHERE p.id = NEW.produto_id AND p.owner_organization_id = NEW.owner_organization_id)
     OR NEW.microrganismo_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.microrganismos m WHERE m.id = NEW.microrganismo_id AND m.owner_organization_id = NEW.owner_organization_id)
  THEN RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'catalogo_volumes'; END IF;
  RETURN NEW;
END $f$;
CREATE TRIGGER a00_catalogo_volumes_owner_consistent BEFORE INSERT OR UPDATE ON public.catalogo_volumes FOR EACH ROW EXECUTE FUNCTION platform_private.catalogo_volumes_owner_consistent();
DO $od$ BEGIN
  IF EXISTS (SELECT 1 FROM public.formulacoes WHERE owner_organization_id IS NULL) THEN RAISE EXCEPTION 'tenant_catalog_owned_child_without_owner' USING DETAIL='formulacoes'; END IF;
END $od$;
ALTER TABLE public.formulacoes ALTER COLUMN owner_organization_id SET NOT NULL;
CREATE INDEX formulacoes_owner_idx ON public.formulacoes (owner_organization_id);
CREATE FUNCTION platform_private.formulacoes_owner_consistent() RETURNS trigger LANGUAGE plpgsql SET search_path = '' AS $f$
BEGIN
  IF TG_OP = 'UPDATE' AND NEW.owner_organization_id IS DISTINCT FROM OLD.owner_organization_id THEN
    RAISE EXCEPTION 'tenant_catalog_owner_immutable' USING ERRCODE = '42501'; END IF;
  IF NEW.produto_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.produtos p WHERE p.id = NEW.produto_id AND p.owner_organization_id = NEW.owner_organization_id)
     OR NEW.microrganismo_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.microrganismos m WHERE m.id = NEW.microrganismo_id AND m.owner_organization_id = NEW.owner_organization_id)
     OR NEW.component_insumo_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.produtos p WHERE p.id = NEW.component_insumo_id AND p.owner_organization_id = NEW.owner_organization_id)
  THEN RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'formulacoes'; END IF;
  RETURN NEW;
END $f$;
CREATE TRIGGER a00_formulacoes_owner_consistent BEFORE INSERT OR UPDATE ON public.formulacoes FOR EACH ROW EXECUTE FUNCTION platform_private.formulacoes_owner_consistent();
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail)
  SELECT 'global_removed', jsonb_build_object('table','microrganismos','count', count(*), 'unused', count(*) FILTER (WHERE NOT EXISTS
     (SELECT 1 FROM platform_private.tenant_catalog_map m WHERE m.root='microrganismos' AND m.old_id = p.id)), 'snapshot', coalesce(jsonb_agg(to_jsonb(p)), '[]'))
    FROM public.microrganismos p WHERE p.owner_organization_id IS NULL;
DELETE FROM public.microrganismos WHERE owner_organization_id IS NULL;
ALTER TABLE public.microrganismos ALTER COLUMN owner_organization_id SET NOT NULL;
CREATE INDEX IF NOT EXISTS microrganismos_owner_idx ON public.microrganismos (owner_organization_id);
