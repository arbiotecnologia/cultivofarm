CREATE POLICY tenant_catalog_owner_restrictive_ins ON public.produto_anexos AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK (((produto_anexos.produto_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = produto_anexos.produto_id))) AND platform_private.tenant_catalog_mutate_org() IS NOT NULL AND platform_private.tenant_catalog_mutate_org() = platform_private.tenant_catalog_read_org());
CREATE POLICY tenant_catalog_owner_restrictive_upd ON public.produto_anexos AS RESTRICTIVE FOR UPDATE TO authenticated USING (((produto_anexos.produto_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = produto_anexos.produto_id))) AND platform_private.tenant_catalog_mutate_org() IS NOT NULL AND platform_private.tenant_catalog_mutate_org() = platform_private.tenant_catalog_read_org()) WITH CHECK (((produto_anexos.produto_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = produto_anexos.produto_id))) AND platform_private.tenant_catalog_mutate_org() IS NOT NULL AND platform_private.tenant_catalog_mutate_org() = platform_private.tenant_catalog_read_org());
CREATE POLICY tenant_catalog_owner_restrictive_del ON public.produto_anexos AS RESTRICTIVE FOR DELETE TO authenticated USING (((produto_anexos.produto_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = produto_anexos.produto_id))) AND platform_private.tenant_catalog_mutate_org() IS NOT NULL AND platform_private.tenant_catalog_mutate_org() = platform_private.tenant_catalog_read_org());
CREATE POLICY tenant_catalog_owner_read ON public.produto_anexos FOR SELECT TO authenticated USING ((produto_anexos.produto_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = produto_anexos.produto_id)));
CREATE TABLE public.tenant_product_receipts(
  actor_id uuid NOT NULL, organization_id uuid NOT NULL, idempotency_key uuid NOT NULL, payload_hash text NOT NULL,
  product_id uuid NOT NULL, result jsonb NOT NULL, created_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (actor_id, organization_id, idempotency_key));
CREATE TABLE public.tenant_product_audit(
  id bigserial PRIMARY KEY, organization_id uuid NOT NULL, product_id uuid NOT NULL, actor_id uuid NOT NULL,
  action text NOT NULL, before_state jsonb, after_state jsonb NOT NULL, at timestamptz NOT NULL DEFAULT now());
REVOKE ALL ON public.tenant_product_receipts, public.tenant_product_audit FROM PUBLIC, anon, authenticated;
GRANT ALL ON public.tenant_product_receipts, public.tenant_product_audit TO service_role;
GRANT SELECT ON public.tenant_product_audit TO authenticated;
ALTER TABLE public.tenant_product_receipts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.tenant_product_audit ENABLE ROW LEVEL SECURITY;
CREATE POLICY tenant_product_audit_select ON public.tenant_product_audit FOR SELECT TO authenticated
  USING (organization_id = platform_private.tenant_catalog_read_org());
CREATE FUNCTION platform_private.tenant_product_audit_immutable() RETURNS trigger LANGUAGE plpgsql SET search_path = '' AS $f$
BEGIN RAISE EXCEPTION 'tenant_product_audit_immutable' USING ERRCODE = '42501'; END $f$;
CREATE TRIGGER a00_tenant_product_audit_immutable BEFORE UPDATE OR DELETE ON public.tenant_product_audit
  FOR EACH ROW EXECUTE FUNCTION platform_private.tenant_product_audit_immutable();

CREATE FUNCTION platform_private.tenant_product_validate(p_payload jsonb, p_create boolean) RETURNS void
LANGUAGE plpgsql IMMUTABLE SET search_path = '' AS $f$
DECLARE k text; v_num numeric;
BEGIN
  IF p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object' THEN RAISE EXCEPTION 'tenant_product_payload_invalid' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(p_payload) LOOP
    IF NOT k = ANY (ARRAY['nome', 'codigo', 'descricao', 'tipo', 'classe_catalogo', 'familia_catalogo', 'modo_acao', 'modo_aplicacao', 'funcao_completa', 'e_insumo', 'b2b_enabled', 'dose_ml_ha', 'estoque_minimo', 'valor_dose_brl', 'valor_ha_brl', 'valor_litro_brl']) THEN RAISE EXCEPTION 'tenant_product_field_forbidden:%', k USING ERRCODE='22023'; END IF;
  END LOOP;
  IF p_create AND NOT p_payload ? 'nome' THEN RAISE EXCEPTION 'tenant_product_nome_required' USING ERRCODE='22023'; END IF;
  IF p_create AND (NOT p_payload ? 'tipo' OR jsonb_typeof(p_payload->'tipo') <> 'string') THEN RAISE EXCEPTION 'tenant_product_tipo_required' USING ERRCODE='22023'; END IF;
  IF p_payload ? 'tipo' AND jsonb_typeof(p_payload->'tipo') <> 'string' THEN RAISE EXCEPTION 'tenant_product_tipo_invalid' USING ERRCODE='22023'; END IF;
  IF p_payload ? 'b2b_enabled' AND jsonb_typeof(p_payload->'b2b_enabled') <> 'boolean' THEN RAISE EXCEPTION 'tenant_product_boolean_invalid:b2b_enabled' USING ERRCODE='22023'; END IF;
  IF p_payload ? 'nome' AND (jsonb_typeof(p_payload->'nome') <> 'string' OR char_length(btrim(p_payload->>'nome')) NOT BETWEEN 2 AND 200) THEN
    RAISE EXCEPTION 'tenant_product_nome_invalid' USING ERRCODE='22023'; END IF;
  FOREACH k IN ARRAY ARRAY['dose_ml_ha','estoque_minimo','valor_dose_brl','valor_ha_brl','valor_litro_brl'] LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) <> 'null' THEN
      IF jsonb_typeof(p_payload->k) <> 'number' THEN RAISE EXCEPTION 'tenant_product_number_invalid:%', k USING ERRCODE='22023'; END IF;
      v_num := (p_payload->>k)::numeric;
      IF v_num < 0 OR v_num > 1e12 THEN RAISE EXCEPTION 'tenant_product_number_out_of_range:%', k USING ERRCODE='22023'; END IF;
    END IF;
  END LOOP;
  FOREACH k IN ARRAY ARRAY['e_insumo','b2b_enabled'] LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) NOT IN ('boolean','null') THEN RAISE EXCEPTION 'tenant_product_boolean_invalid:%', k USING ERRCODE='22023'; END IF;
  END LOOP;
END $f$;

CREATE FUNCTION public.tenant_product_save(p_product_id uuid, p_payload jsonb, p_expected_updated_at timestamptz, p_idempotency_key uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_hash text; v_rc public.tenant_product_receipts%ROWTYPE;
  v_prev public.produtos%ROWTYPE; v_new public.produtos%ROWTYPE; v_in public.produtos%ROWTYPE; v_res jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');          -- tenant derivado do servidor
  IF p_idempotency_key IS NULL THEN RAISE EXCEPTION 'tenant_product_key_required' USING ERRCODE='22023'; END IF;
  PERFORM platform_private.tenant_product_validate(p_payload, p_product_id IS NULL);
  v_in := jsonb_populate_record(NULL::public.produtos, p_payload);   -- enum inválido => 22P02
  v_hash := md5(concat_ws('|', coalesce(p_product_id::text,'new'), p_payload::text, coalesce(p_expected_updated_at::text,'')));
  PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','tpk',v_uid,v_org,p_idempotency_key),0));
  SELECT * INTO v_rc FROM public.tenant_product_receipts WHERE actor_id=v_uid AND organization_id=v_org AND idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF v_rc.payload_hash <> v_hash THEN RAISE EXCEPTION 'tenant_product_idempotency_conflict' USING ERRCODE='22023'; END IF;
    RETURN v_rc.result || jsonb_build_object('replayed', true);
  END IF;
  IF p_product_id IS NULL THEN
    PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','tpn',v_org,lower(btrim(p_payload->>'nome'))),0));
    v_org2 := platform_private.catalog_tenant_actor('mutate');         -- reautoriza após espera
    IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_product_scope_changed' USING ERRCODE='42501'; END IF;
    IF EXISTS (SELECT 1 FROM public.produtos WHERE owner_organization_id=v_org AND lower(btrim(nome))=lower(btrim(p_payload->>'nome'))) THEN
      RAISE EXCEPTION 'tenant_product_duplicate_name' USING ERRCODE='PT409'; END IF;
    INSERT INTO public.produtos(id, owner_organization_id, ativo, nome, codigo, descricao, tipo, classe_catalogo, familia_catalogo, modo_acao, modo_aplicacao, funcao_completa, e_insumo, b2b_enabled, dose_ml_ha, estoque_minimo, valor_dose_brl, valor_ha_brl, valor_litro_brl)
      VALUES (gen_random_uuid(), v_org, true, CASE WHEN p_payload ? 'nome' THEN v_in.nome ELSE NULL END, CASE WHEN p_payload ? 'codigo' THEN v_in.codigo ELSE NULL END, CASE WHEN p_payload ? 'descricao' THEN v_in.descricao ELSE NULL END, CASE WHEN p_payload ? 'tipo' THEN v_in.tipo ELSE NULL END, CASE WHEN p_payload ? 'classe_catalogo' THEN v_in.classe_catalogo ELSE NULL END, CASE WHEN p_payload ? 'familia_catalogo' THEN v_in.familia_catalogo ELSE NULL END, CASE WHEN p_payload ? 'modo_acao' THEN v_in.modo_acao ELSE NULL END, CASE WHEN p_payload ? 'modo_aplicacao' THEN v_in.modo_aplicacao ELSE NULL END, CASE WHEN p_payload ? 'funcao_completa' THEN v_in.funcao_completa ELSE NULL END, CASE WHEN p_payload ? 'e_insumo' THEN v_in.e_insumo ELSE false END, CASE WHEN p_payload ? 'b2b_enabled' THEN v_in.b2b_enabled ELSE false END, CASE WHEN p_payload ? 'dose_ml_ha' THEN v_in.dose_ml_ha ELSE NULL END, CASE WHEN p_payload ? 'estoque_minimo' THEN v_in.estoque_minimo ELSE 0 END, CASE WHEN p_payload ? 'valor_dose_brl' THEN v_in.valor_dose_brl ELSE NULL END, CASE WHEN p_payload ? 'valor_ha_brl' THEN v_in.valor_ha_brl ELSE NULL END, CASE WHEN p_payload ? 'valor_litro_brl' THEN v_in.valor_litro_brl ELSE NULL END) RETURNING * INTO v_new;
    INSERT INTO public.tenant_product_audit(organization_id, product_id, actor_id, action, before_state, after_state)
      VALUES (v_org, v_new.id, v_uid, 'create', NULL, to_jsonb(v_new));
  ELSE
    IF p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_product_cas_required' USING ERRCODE='PT409'; END IF;
    SELECT * INTO v_prev FROM public.produtos WHERE id=p_product_id AND owner_organization_id=v_org FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'tenant_product_not_found' USING ERRCODE='P0002'; END IF;
    v_org2 := platform_private.catalog_tenant_actor('mutate');           -- reautoriza após lock
    IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_product_scope_changed' USING ERRCODE='42501'; END IF;
    IF v_prev.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_product_version_conflict' USING ERRCODE='PT409'; END IF;
    IF p_payload ? 'nome' AND EXISTS (SELECT 1 FROM public.produtos WHERE owner_organization_id=v_org AND id<>p_product_id
         AND lower(btrim(nome))=lower(btrim(p_payload->>'nome'))) THEN
      RAISE EXCEPTION 'tenant_product_duplicate_name' USING ERRCODE='PT409'; END IF;
    UPDATE public.produtos SET
      nome = CASE WHEN p_payload ? 'nome' THEN v_in.nome ELSE nome END,
      codigo = CASE WHEN p_payload ? 'codigo' THEN v_in.codigo ELSE codigo END,
      descricao = CASE WHEN p_payload ? 'descricao' THEN v_in.descricao ELSE descricao END,
      tipo = CASE WHEN p_payload ? 'tipo' THEN v_in.tipo ELSE tipo END,
      classe_catalogo = CASE WHEN p_payload ? 'classe_catalogo' THEN v_in.classe_catalogo ELSE classe_catalogo END,
      familia_catalogo = CASE WHEN p_payload ? 'familia_catalogo' THEN v_in.familia_catalogo ELSE familia_catalogo END,
      modo_acao = CASE WHEN p_payload ? 'modo_acao' THEN v_in.modo_acao ELSE modo_acao END,
      modo_aplicacao = CASE WHEN p_payload ? 'modo_aplicacao' THEN v_in.modo_aplicacao ELSE modo_aplicacao END,
      funcao_completa = CASE WHEN p_payload ? 'funcao_completa' THEN v_in.funcao_completa ELSE funcao_completa END,
      e_insumo = CASE WHEN p_payload ? 'e_insumo' THEN v_in.e_insumo ELSE e_insumo END,
      b2b_enabled = CASE WHEN p_payload ? 'b2b_enabled' THEN v_in.b2b_enabled ELSE b2b_enabled END,
      dose_ml_ha = CASE WHEN p_payload ? 'dose_ml_ha' THEN v_in.dose_ml_ha ELSE dose_ml_ha END,
      estoque_minimo = CASE WHEN p_payload ? 'estoque_minimo' THEN v_in.estoque_minimo ELSE estoque_minimo END,
      valor_dose_brl = CASE WHEN p_payload ? 'valor_dose_brl' THEN v_in.valor_dose_brl ELSE valor_dose_brl END,
      valor_ha_brl = CASE WHEN p_payload ? 'valor_ha_brl' THEN v_in.valor_ha_brl ELSE valor_ha_brl END,
      valor_litro_brl = CASE WHEN p_payload ? 'valor_litro_brl' THEN v_in.valor_litro_brl ELSE valor_litro_brl END,
      updated_at = clock_timestamp()
     WHERE id=p_product_id AND owner_organization_id=v_org AND updated_at = p_expected_updated_at
     RETURNING * INTO v_new;
    IF NOT FOUND THEN RAISE EXCEPTION 'tenant_product_version_conflict' USING ERRCODE='PT409'; END IF;
    INSERT INTO public.tenant_product_audit(organization_id, product_id, actor_id, action, before_state, after_state)
      VALUES (v_org, v_new.id, v_uid, 'update', to_jsonb(v_prev), to_jsonb(v_new));
  END IF;
  v_res := jsonb_build_object('product_id', v_new.id, 'organization_id', v_org, 'updated_at', v_new.updated_at, 'replayed', false);
  INSERT INTO public.tenant_product_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_new.id, v_res, now());
  RETURN v_res;
END $f$;

CREATE FUNCTION public.tenant_product_set_archived(p_product_id uuid, p_archived boolean, p_expected_updated_at timestamptz, p_idempotency_key uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_hash text; v_rc public.tenant_product_receipts%ROWTYPE;
  v_prev public.produtos%ROWTYPE; v_new public.produtos%ROWTYPE; v_res jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('mutate');
  IF p_product_id IS NULL OR p_archived IS NULL OR p_idempotency_key IS NULL OR p_expected_updated_at IS NULL THEN
    RAISE EXCEPTION 'tenant_product_payload_invalid' USING ERRCODE='22023'; END IF;
  v_hash := md5(concat_ws('|','archive',p_product_id,p_archived,p_expected_updated_at));
  PERFORM pg_advisory_xact_lock(hashtextextended(concat_ws(':','tpk',v_uid,v_org,p_idempotency_key),0));
  SELECT * INTO v_rc FROM public.tenant_product_receipts WHERE actor_id=v_uid AND organization_id=v_org AND idempotency_key=p_idempotency_key;
  IF FOUND THEN
    IF v_rc.payload_hash <> v_hash THEN RAISE EXCEPTION 'tenant_product_idempotency_conflict' USING ERRCODE='22023'; END IF;
    RETURN v_rc.result || jsonb_build_object('replayed', true);
  END IF;
  SELECT * INTO v_prev FROM public.produtos WHERE id=p_product_id AND owner_organization_id=v_org FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_product_not_found' USING ERRCODE='P0002'; END IF;
  v_org2 := platform_private.catalog_tenant_actor('mutate');
  IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_product_scope_changed' USING ERRCODE='42501'; END IF;
  IF v_prev.updated_at IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_product_version_conflict' USING ERRCODE='PT409'; END IF;
  IF (v_prev.ativo IS NOT TRUE) = p_archived THEN RAISE EXCEPTION 'tenant_product_no_change' USING ERRCODE='22023'; END IF;
  UPDATE public.produtos SET ativo = NOT p_archived, updated_at = clock_timestamp()
   WHERE id=p_product_id AND owner_organization_id=v_org AND updated_at=p_expected_updated_at RETURNING * INTO v_new;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_product_version_conflict' USING ERRCODE='PT409'; END IF;
  INSERT INTO public.tenant_product_audit(organization_id, product_id, actor_id, action, before_state, after_state)
    VALUES (v_org, v_new.id, v_uid, CASE WHEN p_archived THEN 'archive' ELSE 'unarchive' END, to_jsonb(v_prev), to_jsonb(v_new));
  v_res := jsonb_build_object('product_id', v_new.id, 'ativo', v_new.ativo, 'updated_at', v_new.updated_at, 'replayed', false);
  INSERT INTO public.tenant_product_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_new.id, v_res, now());
  RETURN v_res;
END $f$;

CREATE FUNCTION public.tenant_product_list(p_include_archived boolean DEFAULT false)
RETURNS SETOF public.produtos LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_org uuid;
BEGIN
  IF auth.uid() IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.catalog_tenant_actor('read_catalog');
  RETURN QUERY SELECT * FROM public.produtos WHERE owner_organization_id = v_org AND (p_include_archived OR ativo IS TRUE) ORDER BY nome;
END $f$;
DO $acl$ DECLARE f text; BEGIN
  FOREACH f IN ARRAY ARRAY['public.tenant_product_save(uuid,jsonb,timestamptz,uuid)','public.tenant_product_set_archived(uuid,boolean,timestamptz,uuid)',
                           'public.tenant_product_list(boolean)'] LOOP
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC, anon, authenticated, service_role', f);
    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO authenticated', f);
  END LOOP;
  FOREACH f IN ARRAY ARRAY['platform_private.tenant_product_validate(jsonb,boolean)','platform_private.catalog_owner_immutable()',
                           'platform_private.tenant_product_audit_immutable()'] LOOP
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC, anon, authenticated, service_role', f);
  END LOOP;
END $acl$;
DO $g$ DECLARE r record; BEGIN
  FOR r IN SELECT p.oid::regprocedure AS sig FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
            WHERE n.nspname IN ('public','platform_private') AND p.proname IN ('change_global_volume', 'create_global_culture_core', 'create_global_microorganism_core', 'create_global_product_core', 'create_global_volume_core', 'global_product_fiscal_before_write', 'global_product_fiscal_ibs_save', 'global_product_fiscal_read_ready', 'global_product_fiscal_statement_gate', 'global_product_fiscal_write_ready', 'platform_create_global_culture', 'platform_create_global_microorganism', 'platform_create_global_product', 'platform_create_global_volume', 'platform_read_global_b2b_state', 'platform_read_global_culture_detail', 'platform_read_global_cultures', 'platform_read_global_item_volumes', 'platform_read_global_microorganism_detail', 'platform_read_global_microorganisms', 'platform_read_global_product_catalog', 'platform_read_global_product_catalog_by_family', 'platform_read_global_product_catalog_core', 'platform_read_global_product_composition', 'platform_read_global_product_metadata', 'platform_read_global_volume_detail', 'platform_set_global_b2b_enabled', 'platform_set_global_culture_status', 'platform_set_global_microorganism_status', 'platform_set_global_product_composition', 'platform_set_global_product_family', 'platform_set_global_product_status', 'platform_set_global_volume_status', 'platform_update_global_culture', 'platform_update_global_microorganism', 'platform_update_global_product_metadata', 'platform_update_global_volume', 'platform_wipe_global_product_catalog', 'read_global_b2b_state_core', 'read_global_culture_detail_core', 'read_global_cultures_core', 'read_global_item_volumes_core', 'read_global_microorganism_detail_core', 'read_global_microorganisms_core', 'read_global_product_catalog_by_family_core', 'read_global_product_composition_core', 'read_global_product_metadata_core', 'read_global_volume_detail_core', 'set_global_b2b_enabled_core', 'set_global_culture_status_core', 'set_global_microorganism_status_core', 'set_global_product_composition_core', 'set_global_product_family_core', 'set_global_product_status_core', 'set_global_volume_status_core', 'update_global_culture_core', 'update_global_microorganism_core', 'update_global_product_metadata_core', 'update_global_volume_core') LOOP
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC, anon, authenticated, service_role', r.sig);
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('global_function_closed', jsonb_build_object('sig', r.sig::text));
  END LOOP;
END $g$;
CREATE FUNCTION platform_private.catalog_fiscal_association_actor() RETURNS uuid
 LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path TO '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid;
BEGIN
  v_org := platform_private.catalog_tenant_actor('read_management');         -- JWT/SA/empresa ativa/feature canônicos
  IF NOT (platform_private.has_role(v_uid,'administrador'::public.app_role)
          OR platform_private.has_role(v_uid,'gestor'::public.app_role)
          OR platform_private.has_role(v_uid,'financeiro'::public.app_role)) THEN
    RAISE EXCEPTION 'catalog_fiscal_association_role_denied' USING ERRCODE='42501';
  END IF;
  RETURN v_org;
END $f$;
REVOKE ALL ON FUNCTION platform_private.catalog_fiscal_association_actor() FROM PUBLIC, anon, authenticated, service_role;

CREATE OR REPLACE FUNCTION public.rpc_associate_microorganism_fiscal_product(p_microorganism_id uuid, p_product_id uuid DEFAULT NULL::uuid)
 RETURNS TABLE(id uuid, product_id uuid) LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $f$
DECLARE v_org uuid; v_org2 uuid; v_m uuid; v_p uuid;
BEGIN
  v_org := platform_private.catalog_fiscal_association_actor();             -- autorização específica desta operação
  IF p_microorganism_id IS NULL THEN RAISE EXCEPTION 'not_found' USING ERRCODE = 'P0002'; END IF;
  SELECT m.owner_organization_id INTO v_m FROM public.microrganismos m WHERE m.id = p_microorganism_id FOR UPDATE;
  IF NOT FOUND OR v_m IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'not_found' USING ERRCODE = 'P0002'; END IF;
  IF p_product_id IS NOT NULL THEN
    SELECT p.owner_organization_id INTO v_p FROM public.produtos p WHERE p.id = p_product_id FOR SHARE;
    IF NOT FOUND OR v_p IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_not_found' USING ERRCODE = 'P0002'; END IF;
  END IF;
  v_org2 := platform_private.catalog_fiscal_association_actor();            -- reautoriza após as esperas (READ COMMITTED)
  IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'catalog_actor_changed' USING ERRCODE = '40001'; END IF;
  RETURN QUERY UPDATE public.microrganismos m SET product_id = p_product_id
                WHERE m.id = p_microorganism_id AND m.owner_organization_id = v_org RETURNING m.id, m.product_id;
END $f$;
REVOKE ALL ON FUNCTION public.rpc_associate_microorganism_fiscal_product(uuid, uuid) FROM PUBLIC, anon, service_role;
GRANT EXECUTE ON FUNCTION public.rpc_associate_microorganism_fiscal_product(uuid, uuid) TO authenticated;

CREATE OR REPLACE FUNCTION public.fn_catalogo_sync_mestre_preco(p_produto_id uuid, p_microrganismo_id uuid)
 RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $function$
DECLARE
  v_litro numeric;
  v_tiers integer;
  v_owner uuid;
BEGIN
  IF num_nonnulls(p_produto_id, p_microrganismo_id) <> 1 THEN RETURN; END IF;
  IF p_produto_id IS NOT NULL THEN
    SELECT p.owner_organization_id INTO v_owner FROM public.produtos p WHERE p.id = p_produto_id;
  ELSE
    SELECT m.owner_organization_id INTO v_owner FROM public.microrganismos m WHERE m.id = p_microrganismo_id;
  END IF;
  IF v_owner IS NULL THEN RETURN; END IF;
  IF EXISTS (SELECT 1 FROM public.catalogo_volumes v
              WHERE (v.produto_id = p_produto_id OR v.microrganismo_id = p_microrganismo_id)
                AND v.owner_organization_id IS DISTINCT FROM v_owner) THEN
    RAISE EXCEPTION 'tenant_chain_divergence:catalogo_volumes' USING ERRCODE = '23514';
  END IF;

  SELECT litro, tiers INTO v_litro, v_tiers
  FROM public.fn_catalogo_litro_canonico(p_produto_id, p_microrganismo_id);

  IF COALESCE(v_tiers,0) = 0 THEN
    RETURN; -- sem apresentacao ativa: preserva fallback legado
  END IF;

  PERFORM set_config('arbio.catalogo_sync', 'on', true);

  IF p_produto_id IS NOT NULL THEN
    IF v_tiers = 1 AND COALESCE(v_litro,0) > 0 THEN
      UPDATE public.produtos p
         SET valor_litro_brl = v_litro,
             valor_dose_brl  = round(v_litro / 10.0, 2),
             valor_ha_brl    = CASE WHEN COALESCE(p.dose_ml_ha,0) > 0
                                    THEN round(v_litro * (p.dose_ml_ha / 1000.0), 2) END
       WHERE p.id = p_produto_id AND p.owner_organization_id = v_owner
         AND (p.valor_litro_brl IS DISTINCT FROM v_litro
              OR p.valor_dose_brl IS DISTINCT FROM round(v_litro / 10.0, 2));
    ELSE
      UPDATE public.produtos p
         SET valor_litro_brl = NULL, valor_dose_brl = NULL, valor_ha_brl = NULL
       WHERE p.id = p_produto_id AND p.owner_organization_id = v_owner
         AND (p.valor_litro_brl IS NOT NULL OR p.valor_dose_brl IS NOT NULL OR p.valor_ha_brl IS NOT NULL);
    END IF;
  ELSE
    IF v_tiers = 1 AND COALESCE(v_litro,0) > 0 THEN
      UPDATE public.microrganismos m
         SET valor_litro_brl = v_litro,
             valor_dose_brl  = round(v_litro / 10.0, 2)
       WHERE m.id = p_microrganismo_id AND m.owner_organization_id = v_owner
         AND (m.valor_litro_brl IS DISTINCT FROM v_litro
              OR m.valor_dose_brl IS DISTINCT FROM round(v_litro / 10.0, 2));
    ELSE
      UPDATE public.microrganismos m
         SET valor_litro_brl = NULL, valor_dose_brl = NULL
       WHERE m.id = p_microrganismo_id AND m.owner_organization_id = v_owner
         AND (m.valor_litro_brl IS NOT NULL OR m.valor_dose_brl IS NOT NULL);
    END IF;
  END IF;

  PERFORM set_config('arbio.catalogo_sync', 'off', true);
END
$function$;
-- 11b.1 perfis fiscais: policies globais (Superadmin) substituídas por tenant; registro no ledger
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail)
  SELECT 'fiscal_policies_replaced', coalesce(jsonb_agg(jsonb_build_object('name', policyname, 'cmd', cmd, 'qual', qual, 'check', with_check)), '[]')
    FROM pg_policies WHERE schemaname='public' AND tablename='product_fiscal_profiles'
     AND policyname IN ('product_fiscal_profiles_read','product_fiscal_profiles_insert','product_fiscal_profiles_update');
DROP POLICY IF EXISTS product_fiscal_profiles_read ON public.product_fiscal_profiles;
DROP POLICY IF EXISTS product_fiscal_profiles_insert ON public.product_fiscal_profiles;
DROP POLICY IF EXISTS product_fiscal_profiles_update ON public.product_fiscal_profiles;
CREATE FUNCTION platform_private.tenant_fiscal_reader_org() RETURNS uuid LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid;
BEGIN
  IF v_uid IS NULL THEN RETURN NULL; END IF;
  v_org := platform_private.catalog_tenant_actor('read_catalog');
  IF v_org IS NULL THEN RETURN NULL; END IF;
  IF NOT (platform_private.has_role(v_uid,'administrador') OR platform_private.has_role(v_uid,'gestor')
          OR platform_private.has_role(v_uid,'financeiro')) THEN RETURN NULL; END IF;
  RETURN v_org;   -- sem ramo Superadmin: catálogo exclusivo não tem leitor global
EXCEPTION WHEN invalid_text_representation OR invalid_parameter_value THEN RETURN NULL;
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_fiscal_reader_org() FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION platform_private.tenant_fiscal_reader_org() TO authenticated;
CREATE POLICY tenant_fiscal_role_read ON public.product_fiscal_profiles AS RESTRICTIVE FOR SELECT TO authenticated
  USING (EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = product_fiscal_profiles.product_id
                 AND z.owner_organization_id = platform_private.tenant_fiscal_reader_org()));
CREATE POLICY tenant_fiscal_no_direct_insert ON public.product_fiscal_profiles AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK (false);
CREATE POLICY tenant_fiscal_no_direct_update ON public.product_fiscal_profiles AS RESTRICTIVE FOR UPDATE TO authenticated USING (false) WITH CHECK (false);
REVOKE INSERT, UPDATE, DELETE, TRUNCATE ON public.product_fiscal_profiles FROM anon, authenticated;
CREATE FUNCTION platform_private.tenant_fiscal_mutate_org() RETURNS uuid LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $f$
BEGIN
  RETURN platform_private.catalog_tenant_actor('mutate');
EXCEPTION WHEN raise_exception OR insufficient_privilege OR invalid_parameter_value THEN
  RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501';
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_fiscal_mutate_org() FROM PUBLIC, anon, authenticated, service_role;
-- 11b.2 gatilho reescrito (mesmo nome, mesmo gatilho a10): dono do produto, sem Superadmin, sem aprovação fabricada
CREATE OR REPLACE FUNCTION platform_private.global_product_fiscal_before_write()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO '' AS $function$
DECLARE v_owner uuid; v_org uuid;
BEGIN
  SELECT p.owner_organization_id INTO v_owner FROM public.produtos p WHERE p.id = NEW.product_id;
  v_org := platform_private.tenant_fiscal_mutate_org();
  IF v_owner IS NULL OR v_org IS NULL OR v_org <> v_owner THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF NEW.profile_status IS DISTINCT FROM 'DRAFT' AND NEW.profile_status IS DISTINCT FROM 'BLOCKED' THEN
    RAISE EXCEPTION 'FISCAL_VALIDATION_NOT_ALLOWED' USING ERRCODE='42501'; END IF;
  IF TG_OP='UPDATE' THEN
    IF OLD.is_active IS NOT TRUE THEN RAISE EXCEPTION 'FISCAL_HISTORY_IMMUTABLE' USING ERRCODE='42501'; END IF;
    IF NEW.product_id IS DISTINCT FROM OLD.product_id OR NEW.id IS DISTINCT FROM OLD.id THEN RAISE EXCEPTION 'FISCAL_IDENTITY_IMMUTABLE'; END IF;
    IF NEW.accounting_validated_at IS DISTINCT FROM OLD.accounting_validated_at OR NEW.accounting_validated_by IS DISTINCT FROM OLD.accounting_validated_by
       OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
      RAISE EXCEPTION 'FISCAL_VALIDATION_NOT_ALLOWED' USING ERRCODE='42501'; END IF;
    NEW.updated_at := greatest(clock_timestamp(), OLD.updated_at + interval '1 microsecond');   -- token CAS do servidor
  ELSE
    IF NEW.accounting_validated_at IS NOT NULL OR NEW.accounting_validated_by IS NOT NULL THEN
      RAISE EXCEPTION 'FISCAL_VALIDATION_NOT_ALLOWED' USING ERRCODE='42501'; END IF;
    NEW.updated_at := clock_timestamp();
  END IF;
  RETURN NEW;
END $function$;
-- 11b.3 recibos idempotentes (privados)
CREATE TABLE platform_private.tenant_product_fiscal_receipts(
  idempotency_key uuid PRIMARY KEY, actor_id uuid NOT NULL, organization_id uuid NOT NULL REFERENCES public.organizations(id),
  product_id uuid NOT NULL, request_md5 text NOT NULL, profile_id uuid NOT NULL, profile_status text NOT NULL,
  updated_at timestamptz NOT NULL, created_at timestamptz NOT NULL DEFAULT clock_timestamp());
REVOKE ALL ON platform_private.tenant_product_fiscal_receipts FROM PUBLIC, anon, authenticated, service_role;
-- 11b.4 writer canônico (contrato do consumidor ownedProductFiscal.ts)
CREATE FUNCTION public.tenant_owned_product_fiscal_save(p_product_id uuid, p_expected_updated_at timestamptz, p_values jsonb,
  p_reason text, p_idempotency_key uuid) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_owner uuid; v_md5 text; v_vals jsonb := '{}'::jsonb; k text; v jsonb;
        v_rc platform_private.tenant_product_fiscal_receipts%ROWTYPE; p public.product_fiscal_profiles%ROWTYPE; n public.product_fiscal_profiles%ROWTYPE;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF p_product_id IS NULL OR p_idempotency_key IS NULL OR p_values IS NULL OR jsonb_typeof(p_values) <> 'object' THEN
    RAISE EXCEPTION 'FISCAL_INVALID_INPUT' USING ERRCODE='22023'; END IF;
  IF p_reason IS NULL OR length(btrim(p_reason)) NOT BETWEEN 10 AND 500 THEN RAISE EXCEPTION 'FISCAL_INVALID_REASON' USING ERRCODE='22023'; END IF;
  FOR k, v IN SELECT * FROM jsonb_each(p_values) LOOP
    IF NOT (k = ANY(ARRAY['ncm','cest','cfop_in_state','cfop_interstate','origin_code','icms_cst','icms_csosn','ipi_cst','pis_cst','cofins_cst','commercial_unit','taxable_unit','gtin','taxable_gtin','tax_benefit_code','fiscal_description','accounting_notes'])) THEN RAISE EXCEPTION 'FISCAL_FIELD_NOT_ALLOWED:%', k USING ERRCODE='22023'; END IF;
    IF jsonb_typeof(v) NOT IN ('string','null') THEN RAISE EXCEPTION 'FISCAL_INVALID_VALUE:%', k USING ERRCODE='22023'; END IF;
    IF jsonb_typeof(v) = 'string' AND length(v #>> '{}') > 2000 THEN RAISE EXCEPTION 'FISCAL_INVALID_VALUE:%', k USING ERRCODE='22023'; END IF;
    v_vals := v_vals || jsonb_build_object(k, nullif(btrim(v #>> '{}'), ''));
  END LOOP;
    IF v_vals ? 'ncm' AND v_vals->>'ncm' IS NOT NULL AND v_vals->>'ncm' !~ '^[0-9]{8}$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:ncm' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'cest' AND v_vals->>'cest' IS NOT NULL AND v_vals->>'cest' !~ '^[0-9]{7}$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:cest' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'cfop_in_state' AND v_vals->>'cfop_in_state' IS NOT NULL AND v_vals->>'cfop_in_state' !~ '^[1-7][0-9]{3}$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:cfop_in_state' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'cfop_interstate' AND v_vals->>'cfop_interstate' IS NOT NULL AND v_vals->>'cfop_interstate' !~ '^[1-7][0-9]{3}$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:cfop_interstate' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'origin_code' AND v_vals->>'origin_code' IS NOT NULL AND v_vals->>'origin_code' !~ '^[0-8]$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:origin_code' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'gtin' AND v_vals->>'gtin' IS NOT NULL AND v_vals->>'gtin' !~ '^([0-9]{8}|[0-9]{12,14}|SEM GTIN)$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:gtin' USING ERRCODE='22023'; END IF;
    IF v_vals ? 'taxable_gtin' AND v_vals->>'taxable_gtin' IS NOT NULL AND v_vals->>'taxable_gtin' !~ '^([0-9]{8}|[0-9]{12,14}|SEM GTIN)$' THEN RAISE EXCEPTION 'FISCAL_INVALID_FORMAT:taxable_gtin' USING ERRCODE='22023'; END IF;
  v_org := platform_private.tenant_fiscal_mutate_org();
  IF v_org IS NULL THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
  v_md5 := md5(jsonb_build_object('p', p_product_id, 'e', p_expected_updated_at, 'v', v_vals, 'r', btrim(p_reason))::text);
  SELECT z.owner_organization_id INTO v_owner FROM public.produtos z WHERE z.id = p_product_id FOR UPDATE;
  IF NOT FOUND OR v_owner IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;  -- sem oráculo de existência
  v_org2 := platform_private.tenant_fiscal_mutate_org();                                                           -- reautoriza após lock
  IF v_org2 IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'FISCAL_FORBIDDEN' USING ERRCODE='42501'; END IF;
  SELECT * INTO v_rc FROM platform_private.tenant_product_fiscal_receipts WHERE idempotency_key = p_idempotency_key FOR UPDATE;
  IF FOUND THEN
    IF v_rc.actor_id <> v_uid OR v_rc.organization_id <> v_org OR v_rc.product_id <> p_product_id OR v_rc.request_md5 <> v_md5 THEN
      RAISE EXCEPTION 'FISCAL_IDEMPOTENCY_CONFLICT' USING ERRCODE='PT409'; END IF;
    RETURN jsonb_build_object('success', true, 'product_id', v_rc.product_id, 'profile_id', v_rc.profile_id, 'organization_id', v_rc.organization_id,
      'profile_status', v_rc.profile_status, 'updated_at', v_rc.updated_at::text, 'idempotency_key', p_idempotency_key, 'idempotent', true);
  END IF;
  SELECT * INTO p FROM public.product_fiscal_profiles x WHERE x.product_id = p_product_id AND x.is_active FOR UPDATE;
  IF FOUND THEN
    IF p_expected_updated_at IS NULL OR p.updated_at <> p_expected_updated_at THEN RAISE EXCEPTION 'FISCAL_CAS_CONFLICT' USING ERRCODE='PT409'; END IF;
    UPDATE public.product_fiscal_profiles AS x SET ncm = CASE WHEN v_vals ? 'ncm' THEN v_vals->>'ncm' ELSE x.ncm END, cest = CASE WHEN v_vals ? 'cest' THEN v_vals->>'cest' ELSE x.cest END, cfop_in_state = CASE WHEN v_vals ? 'cfop_in_state' THEN v_vals->>'cfop_in_state' ELSE x.cfop_in_state END, cfop_interstate = CASE WHEN v_vals ? 'cfop_interstate' THEN v_vals->>'cfop_interstate' ELSE x.cfop_interstate END, origin_code = CASE WHEN v_vals ? 'origin_code' THEN v_vals->>'origin_code' ELSE x.origin_code END, icms_cst = CASE WHEN v_vals ? 'icms_cst' THEN v_vals->>'icms_cst' ELSE x.icms_cst END, icms_csosn = CASE WHEN v_vals ? 'icms_csosn' THEN v_vals->>'icms_csosn' ELSE x.icms_csosn END, ipi_cst = CASE WHEN v_vals ? 'ipi_cst' THEN v_vals->>'ipi_cst' ELSE x.ipi_cst END, pis_cst = CASE WHEN v_vals ? 'pis_cst' THEN v_vals->>'pis_cst' ELSE x.pis_cst END, cofins_cst = CASE WHEN v_vals ? 'cofins_cst' THEN v_vals->>'cofins_cst' ELSE x.cofins_cst END, commercial_unit = CASE WHEN v_vals ? 'commercial_unit' THEN v_vals->>'commercial_unit' ELSE x.commercial_unit END, taxable_unit = CASE WHEN v_vals ? 'taxable_unit' THEN v_vals->>'taxable_unit' ELSE x.taxable_unit END, gtin = CASE WHEN v_vals ? 'gtin' THEN v_vals->>'gtin' ELSE x.gtin END, taxable_gtin = CASE WHEN v_vals ? 'taxable_gtin' THEN v_vals->>'taxable_gtin' ELSE x.taxable_gtin END, tax_benefit_code = CASE WHEN v_vals ? 'tax_benefit_code' THEN v_vals->>'tax_benefit_code' ELSE x.tax_benefit_code END, fiscal_description = CASE WHEN v_vals ? 'fiscal_description' THEN v_vals->>'fiscal_description' ELSE x.fiscal_description END, accounting_notes = CASE WHEN v_vals ? 'accounting_notes' THEN v_vals->>'accounting_notes' ELSE x.accounting_notes END, profile_status = 'DRAFT', updated_by = v_uid
     WHERE x.id = p.id RETURNING x.* INTO n;
  ELSE
    IF p_expected_updated_at IS NOT NULL THEN RAISE EXCEPTION 'FISCAL_CAS_CONFLICT' USING ERRCODE='PT409'; END IF;
    INSERT INTO public.product_fiscal_profiles(product_id, is_active, profile_status, created_by, updated_by, ncm, cest, cfop_in_state, cfop_interstate, origin_code, icms_cst, icms_csosn, ipi_cst, pis_cst, cofins_cst, commercial_unit, taxable_unit, gtin, taxable_gtin, tax_benefit_code, fiscal_description, accounting_notes)
      VALUES (p_product_id, true, 'DRAFT', v_uid, v_uid, v_vals->>'ncm', v_vals->>'cest', v_vals->>'cfop_in_state', v_vals->>'cfop_interstate', v_vals->>'origin_code', v_vals->>'icms_cst', v_vals->>'icms_csosn', v_vals->>'ipi_cst', v_vals->>'pis_cst', v_vals->>'cofins_cst', v_vals->>'commercial_unit', v_vals->>'taxable_unit', v_vals->>'gtin', v_vals->>'taxable_gtin', v_vals->>'tax_benefit_code', v_vals->>'fiscal_description', v_vals->>'accounting_notes') RETURNING * INTO n;
  END IF;
  INSERT INTO platform_private.tenant_product_fiscal_receipts(idempotency_key, actor_id, organization_id, product_id, request_md5, profile_id, profile_status, updated_at)
    VALUES (p_idempotency_key, v_uid, v_org, p_product_id, v_md5, n.id, n.profile_status, n.updated_at);
  RETURN jsonb_build_object('success', true, 'product_id', p_product_id, 'profile_id', n.id, 'organization_id', v_org,
    'profile_status', n.profile_status, 'updated_at', n.updated_at::text, 'idempotency_key', p_idempotency_key, 'idempotent', false);
END $f$;
REVOKE ALL ON FUNCTION public.tenant_owned_product_fiscal_save(uuid,timestamptz,jsonb,text,uuid) FROM PUBLIC, anon, authenticated, service_role;
GRANT EXECUTE ON FUNCTION public.tenant_owned_product_fiscal_save(uuid,timestamptz,jsonb,text,uuid) TO authenticated;
-- v2.11: único consumidor de escrita (useSaveProductFiscalProfile) migrado para o RPC canônico; escrita direta de cliente fechada
REVOKE INSERT, UPDATE, DELETE ON public.product_fiscal_profiles FROM PUBLIC, anon, authenticated;
CREATE FUNCTION platform_private.tenant_catalog_fence(p_mode text, p_orgs uuid[]) RETURNS void
  LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_actor uuid;
BEGIN
  IF p_mode NOT IN ('mutate','read_catalog') THEN RAISE EXCEPTION 'tenant_catalog_fence_mode' USING ERRCODE='22023'; END IF;
  IF auth.uid() IS NULL THEN
    IF session_user::text IN ('anon','authenticated') OR current_setting('role', true) IN ('anon','authenticated') THEN
      RAISE EXCEPTION 'tenant_catalog_fence_denied' USING ERRCODE='42501'; END IF;
    RETURN;   -- contexto servidor sem ator (gatilho/serviço); clientes sempre têm auth.uid()
  END IF;
  BEGIN
    v_actor := platform_private.catalog_tenant_actor(p_mode);
  EXCEPTION WHEN raise_exception OR insufficient_privilege OR invalid_parameter_value THEN
    RAISE EXCEPTION 'tenant_catalog_fence_denied' USING ERRCODE='42501';
  END;
  IF v_actor IS NULL OR EXISTS (SELECT 1 FROM unnest(p_orgs) o WHERE o IS DISTINCT FROM v_actor) THEN
    RAISE EXCEPTION 'tenant_catalog_fence_denied' USING ERRCODE='42501'; END IF;
END $f$;
REVOKE ALL ON FUNCTION platform_private.tenant_catalog_fence(text,uuid[]) FROM PUBLIC, anon, authenticated, service_role;
DO $fw$ DECLARE r record; v_oid oid; v_schema text; v_name text; v_args text; v_res text; v_call text; v_body text; v_core text;
BEGIN
  FOR r IN SELECT * FROM (VALUES ('platform_private.lab_assert_manufacturable(uuid,uuid)', 'read_catalog', 'CASE WHEN p_product_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.produtos z WHERE z.id = p_product_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_microorganism_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microrganismos z WHERE z.id = p_microorganism_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('platform_private.lab_item_is_manufacturable(uuid,uuid)', 'read_catalog', 'CASE WHEN p_product_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.produtos z WHERE z.id = p_product_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_microorganism_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microrganismos z WHERE z.id = p_microorganism_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.fn_catalogo_preco_canonico(uuid,uuid,text,numeric)', 'read_catalog', 'CASE WHEN p_product_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.produtos z WHERE z.id = p_product_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_microrganismo_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microrganismos z WHERE z.id = p_microrganismo_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.fn_b2b_resolve_base_unit_price(uuid,uuid,uuid,text,numeric,date)', 'read_catalog', 'CASE WHEN p_partner_id IS NULL THEN NULL ELSE coalesce((SELECT x.commercial_owner_organization_id FROM public.partner_accounts x WHERE x.id = p_partner_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_product_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.produtos z WHERE z.id = p_product_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_microrganismo_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microrganismos z WHERE z.id = p_microrganismo_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.rpc_commercial_simulator(uuid,uuid,numeric,numeric)', 'read_catalog', 'CASE WHEN p_partner_id IS NULL THEN NULL ELSE coalesce((SELECT x.commercial_owner_organization_id FROM public.partner_accounts x WHERE x.id = p_partner_id), ''00000000-0000-0000-0000-000000000000''::uuid) END, CASE WHEN p_product_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.produtos z WHERE z.id = p_product_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.approve_product_profile_with_audit(uuid,jsonb,boolean)', 'mutate', 'CASE WHEN p_profile_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.product_technical_profiles t JOIN public.produtos z ON z.id = t.produto_id WHERE t.id = p_profile_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.approve_microorganism_profile_with_audit(uuid,jsonb,boolean)', 'mutate', 'CASE WHEN p_profile_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microorganism_technical_profiles t JOIN public.microrganismos z ON z.id = t.microrganismo_id WHERE t.id = p_profile_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.update_product_b2b_description(uuid,text)', 'mutate', 'CASE WHEN p_profile_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.product_technical_profiles t JOIN public.produtos z ON z.id = t.produto_id WHERE t.id = p_profile_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.update_microorganism_b2b_description(uuid,text)', 'mutate', 'CASE WHEN p_profile_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microorganism_technical_profiles t JOIN public.microrganismos z ON z.id = t.microrganismo_id WHERE t.id = p_profile_id), ''00000000-0000-0000-0000-000000000000''::uuid) END'), ('public.rpc_regulatory_dossier_ensure_draft(uuid)', 'mutate', 'CASE WHEN p_microorganism_id IS NULL THEN NULL ELSE coalesce((SELECT z.owner_organization_id FROM public.microrganismos z WHERE z.id = p_microorganism_id), ''00000000-0000-0000-0000-000000000000''::uuid) END')) t(sig, mode, checks) LOOP
    v_oid := to_regprocedure(r.sig);
    IF v_oid IS NULL THEN RAISE EXCEPTION 'tenant_catalog_fence_target_missing:%', r.sig; END IF;
    SELECT n.nspname, p.proname, pg_get_function_arguments(p.oid), pg_get_function_result(p.oid),
           (SELECT string_agg(quote_ident(a), ', ' ORDER BY i) FROM unnest(p.proargnames) WITH ORDINALITY u(a, i))
      INTO v_schema, v_name, v_args, v_res, v_call
      FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.oid = v_oid;
    IF v_res LIKE 'SETOF%' OR v_res LIKE 'TABLE%' THEN RAISE EXCEPTION 'tenant_catalog_fence_unsupported_result:%', r.sig; END IF;
    v_core := v_name || '__tenant_core';
    EXECUTE format('ALTER FUNCTION %s RENAME TO %I', v_oid::regprocedure, v_core);
    IF v_schema <> 'platform_private' THEN EXECUTE format('ALTER FUNCTION %I.%I(%s) SET SCHEMA platform_private', v_schema, v_core, pg_get_function_identity_arguments(v_oid)); END IF;
    EXECUTE format('REVOKE ALL ON FUNCTION platform_private.%I(%s) FROM PUBLIC, anon, authenticated, service_role', v_core, pg_get_function_identity_arguments(v_oid));
    v_body := 'BEGIN PERFORM platform_private.tenant_catalog_fence(' || quote_literal(r.mode) || ', array_remove(ARRAY[' || r.checks || ']::uuid[], NULL)); '
      || CASE WHEN v_res = 'void' THEN 'PERFORM platform_private.' || quote_ident(v_core) || '(' || coalesce(v_call,'') || '); RETURN; '
              ELSE 'RETURN platform_private.' || quote_ident(v_core) || '(' || coalesce(v_call,'') || '); ' END || 'END';
    EXECUTE format('CREATE FUNCTION %I.%I(%s) RETURNS %s LANGUAGE plpgsql SECURITY DEFINER SET search_path = %L AS %L',
                   v_schema, v_name, v_args, v_res, '', v_body);
    EXECUTE format('REVOKE ALL ON FUNCTION %I.%I(%s) FROM PUBLIC, anon', v_schema, v_name, pg_get_function_identity_arguments(v_oid));
    EXECUTE format('GRANT EXECUTE ON FUNCTION %I.%I(%s) TO authenticated, service_role', v_schema, v_name, pg_get_function_identity_arguments(v_oid));
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('definer_tenant_fenced', jsonb_build_object('function', r.sig, 'mode', r.mode, 'core', 'platform_private.' || v_core));
  END LOOP;
END $fw$;
REVOKE ALL ON FUNCTION public.platform_set_catalog_label_active(uuid,timestamp with time zone,boolean,text,uuid) FROM PUBLIC, anon, authenticated;
INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('platform_writer_closed', jsonb_build_object('function', 'public.platform_set_catalog_label_active(uuid,timestamp with time zone,boolean,text,uuid)'));
CREATE FUNCTION platform_private.catalog_tenant_agree(p uuid[]) RETURNS uuid LANGUAGE plpgsql IMMUTABLE SET search_path = '' AS $f$
DECLARE v uuid[] := ARRAY(SELECT DISTINCT x FROM unnest(p) x WHERE x IS NOT NULL);
BEGIN
  IF cardinality(v) > 1 THEN RAISE EXCEPTION 'tenant_catalog_chain_divergence' USING ERRCODE = '42501', DETAIL = array_to_string(v, ','); END IF;
  RETURN v[1];
END $f$;
REVOKE ALL ON FUNCTION platform_private.catalog_tenant_agree(uuid[]) FROM PUBLIC, anon, authenticated, service_role;
-- vendedor do catálogo B2B: dono comercial do parceiro; sem parceiro = tenant canônico do ator interno; Superadmin = nenhum
CREATE FUNCTION platform_private.catalog_tenant_seller(p_partner uuid) RETURNS uuid LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = '' AS $f$
BEGIN
  IF auth.uid() IS NOT NULL AND public.is_platform_superadmin(auth.uid()) THEN RETURN NULL; END IF;
  IF p_partner IS NOT NULL THEN
    RETURN (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = p_partner);
  END IF;
  IF auth.uid() IS NULL THEN RETURN NULL; END IF;
  BEGIN
    RETURN platform_private.catalog_tenant_actor('read_catalog');
  EXCEPTION WHEN raise_exception OR insufficient_privilege OR invalid_parameter_value THEN RETURN NULL;
  END;
END $f$;
REVOKE ALL ON FUNCTION platform_private.catalog_tenant_seller(uuid) FROM PUBLIC, anon, authenticated, service_role;
CREATE FUNCTION platform_private.catalog_tenant_visibility_catalog_tenant_guard() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $f$
DECLARE v_t uuid;
BEGIN
  IF NOT (NEW.produto_id IS NOT NULL OR NEW.microrganismo_id IS NOT NULL OR NEW.cultura_id IS NOT NULL) THEN RETURN NEW; END IF;
  IF true THEN
    v_t := NEW.organization_id;
    IF NEW.produto_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.produtos z WHERE z.id = NEW.produto_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'catalog_tenant_visibility.produto_id'; END IF;
    IF NEW.microrganismo_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.microrganismos z WHERE z.id = NEW.microrganismo_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'catalog_tenant_visibility.microrganismo_id'; END IF;
    IF NEW.cultura_id IS NOT NULL AND (v_t IS NULL OR NOT EXISTS (SELECT 1 FROM public.culturas z WHERE z.id = NEW.cultura_id AND z.owner_organization_id = v_t)) THEN
      RAISE EXCEPTION 'tenant_catalog_cross_tenant_reference' USING ERRCODE = '42501', DETAIL = 'catalog_tenant_visibility.cultura_id'; END IF;
  END IF;
  RETURN NEW;
END $f$;
REVOKE ALL ON FUNCTION platform_private.catalog_tenant_visibility_catalog_tenant_guard() FROM PUBLIC, anon, authenticated, service_role;
CREATE TRIGGER a000_catalog_tenant_visibility_catalog_tenant_guard BEFORE INSERT OR UPDATE ON public.catalog_tenant_visibility FOR EACH ROW EXECUTE FUNCTION platform_private.catalog_tenant_visibility_catalog_tenant_guard();
