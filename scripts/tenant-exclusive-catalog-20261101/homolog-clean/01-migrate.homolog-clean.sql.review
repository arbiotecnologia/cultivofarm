DO $ncm$ BEGIN
  UPDATE public.microorganism_regulatory_dossiers d SET published_ncm_candidate_id = rm.new_id
    FROM platform_private.tenant_catalog_row_map dm, platform_private.tenant_catalog_row_map rm
   WHERE dm.tbl='microorganism_regulatory_dossiers' AND dm.new_id=d.id AND rm.tbl='microorganism_ncm_candidates'
     AND rm.old_id=d.published_ncm_candidate_id AND rm.organization_id=dm.organization_id;
  IF EXISTS (SELECT 1 FROM public.microorganism_regulatory_dossiers d JOIN platform_private.tenant_catalog_row_map dm ON dm.tbl='microorganism_regulatory_dossiers' AND dm.new_id=d.id
              WHERE d.published_ncm_candidate_id IS NOT NULL
                AND d.published_ncm_candidate_id NOT IN (SELECT new_id FROM platform_private.tenant_catalog_row_map WHERE tbl='microorganism_ncm_candidates' AND organization_id=dm.organization_id)) THEN
    RAISE EXCEPTION 'tenant_catalog_ncm_publication_unmapped'; END IF;
  UPDATE public.microorganism_regulatory_dossiers d SET published_ncm_candidate_id = NULL
   WHERE d.published_ncm_candidate_id IS NOT NULL AND d.id NOT IN (SELECT new_id FROM platform_private.tenant_catalog_row_map WHERE tbl='microorganism_regulatory_dossiers');
END $ncm$;
DO $u$ BEGIN
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) SELECT 'unresolved_discarded', jsonb_build_object('table','catalog_tenant_visibility','rows', coalesce(jsonb_agg(to_jsonb(x)),'[]'))
    FROM public.catalog_tenant_visibility x WHERE x.id IN (SELECT rid FROM tc_rows WHERE tbl='catalog_tenant_visibility' AND org IS NULL);
  DELETE FROM public.catalog_tenant_visibility x WHERE x.id IN (SELECT rid FROM tc_rows WHERE tbl='catalog_tenant_visibility' AND org IS NULL);
END $u$;
DO $r$ DECLARE v_n bigint; v_left bigint; BEGIN
  UPDATE public.catalog_tenant_visibility x SET produto_id = m.new_id FROM tc_rows tr JOIN platform_private.tenant_catalog_map m ON m.root='produtos' AND m.old_id=tr.old_id AND m.organization_id=tr.org
   WHERE tr.tbl='catalog_tenant_visibility' AND tr.col='produto_id' AND tr.rid = x.id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  SELECT count(*) INTO v_left FROM public.catalog_tenant_visibility x WHERE x.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  IF v_left > 0 THEN RAISE EXCEPTION 'tenant_catalog_reference_unresolved' USING DETAIL = 'catalog_tenant_visibility.produto_id='||v_left; END IF;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('reference_repointed', jsonb_build_object('table','catalog_tenant_visibility','column','produto_id','rows',v_n));
END $r$;
DO $r$ DECLARE v_n bigint; v_left bigint; BEGIN
  UPDATE public.catalog_tenant_visibility x SET microrganismo_id = m.new_id FROM tc_rows tr JOIN platform_private.tenant_catalog_map m ON m.root='microrganismos' AND m.old_id=tr.old_id AND m.organization_id=tr.org
   WHERE tr.tbl='catalog_tenant_visibility' AND tr.col='microrganismo_id' AND tr.rid = x.id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  SELECT count(*) INTO v_left FROM public.catalog_tenant_visibility x WHERE x.microrganismo_id IN (SELECT id FROM public.microrganismos WHERE owner_organization_id IS NULL);
  IF v_left > 0 THEN RAISE EXCEPTION 'tenant_catalog_reference_unresolved' USING DETAIL = 'catalog_tenant_visibility.microrganismo_id='||v_left; END IF;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('reference_repointed', jsonb_build_object('table','catalog_tenant_visibility','column','microrganismo_id','rows',v_n));
END $r$;
DO $r$ DECLARE v_n bigint; v_left bigint; BEGIN
  UPDATE public.catalog_tenant_visibility x SET cultura_id = m.new_id FROM tc_rows tr JOIN platform_private.tenant_catalog_map m ON m.root='culturas' AND m.old_id=tr.old_id AND m.organization_id=tr.org
