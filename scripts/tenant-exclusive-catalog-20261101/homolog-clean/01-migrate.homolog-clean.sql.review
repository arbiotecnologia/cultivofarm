      UNION ALL SELECT 'cq_parametros_referencia.produto_id' k, count(*) n FROM public.cq_parametros_referencia s JOIN public.microrganismos a ON a.id = s.microrganismo_id JOIN public.produtos b ON b.id = s.produto_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'catalogo_volumes.microrganismo_id' k, count(*) n FROM public.catalogo_volumes s JOIN public.produtos a ON a.id = s.produto_id JOIN public.microrganismos b ON b.id = s.microrganismo_id WHERE s.produto_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
      UNION ALL SELECT 'catalogo_volumes.produto_id' k, count(*) n FROM public.catalogo_volumes s JOIN public.microrganismos a ON a.id = s.microrganismo_id JOIN public.produtos b ON b.id = s.produto_id WHERE s.produto_id IS NULL AND s.microrganismo_id IS NOT NULL AND a.owner_organization_id <> b.owner_organization_id
