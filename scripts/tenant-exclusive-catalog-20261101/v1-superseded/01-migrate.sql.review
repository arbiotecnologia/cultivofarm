DO $r$ DECLARE v_n bigint; v_left bigint; BEGIN
  UPDATE public.entregas x SET produto_id = (SELECT m.new_product_id FROM platform_private.tenant_catalog_product_map m
                                  WHERE m.old_product_id = x.produto_id AND m.organization_id = x.organization_id)
   WHERE x.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  GET DIAGNOSTICS v_n = ROW_COUNT;
