-- 01 MIGRAÇÃO TRANSACIONAL — catálogo EXCLUSIVO por tenant. NO_GO: NÃO APLICAR sem revisão e ordem explícita.
-- Dados de teste autorizados (01/11/2026): referências repontadas para a cópia do tenant do registro.
-- Irreversível como dado: rollback = restaurar backup anterior; o mapa fica em platform_private para auditoria.
BEGIN;
SET LOCAL lock_timeout = '10s';
SET LOCAL statement_timeout = '15min';
DO $pre$
DECLARE v_fail text[] := ARRAY[]::text[]; r record; v_n bigint;
BEGIN
  -- 1. FKs reais para produtos devem estar todas mapeadas (e vice-versa)
  FOR r IN
    SELECT c.conrelid::regclass::text AS rel, a.attname AS col
      FROM pg_constraint c JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum = ANY(c.conkey)
     WHERE c.contype='f' AND c.confrelid='public.produtos'::regclass
  LOOP
    IF NOT EXISTS (SELECT 1 FROM (VALUES ('entregas','produto_id','reference'),('lotes','produto_id','reference'),('ordens_servico','produto_id','reference'),('programacao_producao','produto_id','reference'),('catalog_tenant_visibility','produto_id','reference'),('commercial_condition_item_prices','product_id','reference'),('commercial_price_rules','product_id','reference'),('partner_product_prices','product_id','reference'),('partner_order_items','product_id','reference'),('partner_simulation_items','product_id','reference'),('estoque_produto','produto_id','reference'),('estoque_embalagens','produto_id','reference'),('produto_etiquetas','produto_id','reference'),('os_faturamento_base','produto_id','reference'),('ordens_servico_onfarm','produto_id','reference'),('registros_consultor_recomendacoes','produto_biologico_sugerido_id','reference'),('commercial_campaign_products','product_id','reference'),('product_fiscal_profiles','product_id','descendant'),('product_technical_profiles','produto_id','descendant'),('produto_composicao_conjuntos','produto_id','descendant'),('produto_conformidade_perfis','produto_id','descendant'),('product_crop_recommendations','produto_id','descendant'),('product_target_recommendations','produto_id','descendant'),('cq_parametros_referencia','produto_id','descendant'),('catalogo_volumes','produto_id','descendant'),('formulacoes','produto_id','descendant'),('formulacoes','component_insumo_id','reference'),('microrganismos','product_id','nullify')) m(t,c,k)
                   WHERE ('public.'||m.t = r.rel OR m.t = r.rel) AND m.c = r.col) THEN
      v_fail := v_fail || ('fk_unmapped:'||r.rel||'.'||r.col);
    END IF;
  END LOOP;
  FOR r IN SELECT * FROM (VALUES ('entregas','produto_id','reference'),('lotes','produto_id','reference'),('ordens_servico','produto_id','reference'),('programacao_producao','produto_id','reference'),('catalog_tenant_visibility','produto_id','reference'),('commercial_condition_item_prices','product_id','reference'),('commercial_price_rules','product_id','reference'),('partner_product_prices','product_id','reference'),('partner_order_items','product_id','reference'),('partner_simulation_items','product_id','reference'),('estoque_produto','produto_id','reference'),('estoque_embalagens','produto_id','reference'),('produto_etiquetas','produto_id','reference'),('os_faturamento_base','produto_id','reference'),('ordens_servico_onfarm','produto_id','reference'),('registros_consultor_recomendacoes','produto_biologico_sugerido_id','reference'),('commercial_campaign_products','product_id','reference'),('product_fiscal_profiles','product_id','descendant'),('product_technical_profiles','produto_id','descendant'),('produto_composicao_conjuntos','produto_id','descendant'),('produto_conformidade_perfis','produto_id','descendant'),('product_crop_recommendations','produto_id','descendant'),('product_target_recommendations','produto_id','descendant'),('cq_parametros_referencia','produto_id','descendant'),('catalogo_volumes','produto_id','descendant'),('formulacoes','produto_id','descendant'),('formulacoes','component_insumo_id','reference'),('microrganismos','product_id','nullify')) m(t,c,k) LOOP
    IF to_regclass('public.'||r.t) IS NULL THEN v_fail := v_fail || ('table_missing:'||r.t); CONTINUE; END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid=('public.'||r.t)::regclass AND attname=r.c AND NOT attisdropped)
      THEN v_fail := v_fail || ('column_missing:'||r.t||'.'||r.c); END IF;
  END LOOP;
  -- 2. estado anterior: catálogo exclusivo ainda não instalado e fundação opcional antiga ausente
  IF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.produtos'::regclass AND attname='owner_organization_id' AND NOT attisdropped)
    THEN v_fail := v_fail || 'partial:produtos.owner_organization_id'::text; END IF;
  IF to_regclass('platform_private.tenant_catalog_product_map') IS NOT NULL THEN v_fail := v_fail || 'partial:map_present'::text; END IF;
  IF to_regprocedure('public.tenant_product_save(uuid,jsonb,timestamptz,uuid)') IS NOT NULL THEN v_fail := v_fail || 'partial:rpc_present'::text; END IF;
  -- 3. dependências canônicas
  IF to_regprocedure('platform_private.catalog_tenant_actor(text)') IS NULL THEN v_fail := v_fail || 'dep:catalog_tenant_actor'::text; END IF;
  IF to_regclass('public.organizations') IS NULL OR to_regclass('public.partner_accounts') IS NULL THEN v_fail := v_fail || 'dep:organizations/partner_accounts'::text; END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.partner_accounts'::regclass AND attname='commercial_owner_organization_id')
    THEN v_fail := v_fail || 'dep:partner_accounts.commercial_owner_organization_id'::text; END IF;
  -- 4. índices únicos de produtos por expressão/parciais não são reescritos automaticamente
  FOR r IN SELECT i.indexrelid::regclass::text AS ix FROM pg_index i
            WHERE i.indrelid='public.produtos'::regclass AND i.indisunique AND NOT i.indisprimary
              AND (i.indexprs IS NOT NULL OR i.indpred IS NOT NULL) LOOP
    v_fail := v_fail || ('unique_expr_or_partial:'||r.ix);
  END LOOP;
  -- 5. microrganismos.product_id precisa aceitar NULL para anulação registrada
  IF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.microrganismos'::regclass AND attname='product_id' AND attnotnull)
    THEN v_fail := v_fail || 'nullify_not_nullable:microrganismos.product_id'::text; END IF;
  IF cardinality(v_fail) > 0 THEN
    RAISE EXCEPTION 'tenant_catalog_pre_failed' USING DETAIL = array_to_string(v_fail, ' | ');
  END IF;
END $pre$;
LOCK TABLE public.catalog_tenant_visibility, public.catalogo_volumes, public.commercial_campaign_products, public.commercial_condition_item_prices, public.commercial_price_rules, public.cq_parametros_referencia, public.entregas, public.estoque_embalagens, public.estoque_produto, public.formulacoes, public.lotes, public.microrganismos, public.ordens_servico, public.ordens_servico_onfarm, public.os_faturamento_base, public.partner_order_items, public.partner_product_prices, public.partner_simulation_items, public.product_crop_recommendations, public.product_fiscal_profiles, public.product_target_recommendations, public.product_technical_profiles, public.produto_composicao_conjuntos, public.produto_conformidade_perfis, public.produto_etiquetas, public.produtos, public.programacao_producao, public.registros_consultor_recomendacoes IN ACCESS EXCLUSIVE MODE;

CREATE TABLE platform_private.tenant_catalog_usage(
  old_product_id uuid NOT NULL, organization_id uuid, source_table text NOT NULL, source_column text NOT NULL, rows_count bigint NOT NULL);
CREATE TABLE platform_private.tenant_catalog_product_map(
  old_product_id uuid NOT NULL, organization_id uuid NOT NULL REFERENCES public.organizations(id),
  new_product_id uuid NOT NULL UNIQUE, created_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (old_product_id, organization_id));
CREATE TABLE platform_private.tenant_catalog_migration_ledger(
  id bigserial PRIMARY KEY, step text NOT NULL, detail jsonb NOT NULL, at timestamptz NOT NULL DEFAULT clock_timestamp());
REVOKE ALL ON platform_private.tenant_catalog_usage, platform_private.tenant_catalog_product_map,
  platform_private.tenant_catalog_migration_ledger FROM PUBLIC, anon, authenticated;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, x.organization_id, 'entregas', 'produto_id', count(*) FROM public.entregas x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, x.organization_id, 'lotes', 'produto_id', count(*) FROM public.lotes x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, x.organization_id, 'ordens_servico', 'produto_id', count(*) FROM public.ordens_servico x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, x.organization_id, 'programacao_producao', 'produto_id', count(*) FROM public.programacao_producao x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, x.organization_id, 'catalog_tenant_visibility', 'produto_id', count(*) FROM public.catalog_tenant_visibility x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id), 'commercial_condition_item_prices', 'product_id', count(*) FROM public.commercial_condition_item_prices x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id), 'commercial_price_rules', 'product_id', count(*) FROM public.commercial_price_rules x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.partner_id), 'partner_product_prices', 'product_id', count(*) FROM public.partner_product_prices x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT po.partner_id FROM public.partner_orders po WHERE po.id = x.order_id)), 'partner_order_items', 'product_id', count(*) FROM public.partner_order_items x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = (SELECT ps.partner_id FROM public.partner_simulations ps WHERE ps.id = x.simulation_id)), 'partner_simulation_items', 'product_id', count(*) FROM public.partner_simulation_items x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, COALESCE((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), (SELECT pa.commercial_owner_organization_id FROM public.partner_accounts pa WHERE pa.id = x.reservado_para_partner_id)), 'estoque_produto', 'produto_id', count(*) FROM public.estoque_produto x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, COALESCE((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), (SELECT e.organization_id FROM public.entregas e WHERE e.id = x.entrega_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id)), 'estoque_embalagens', 'produto_id', count(*) FROM public.estoque_embalagens x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, COALESCE((SELECT l.organization_id FROM public.lotes l WHERE l.id = x.lote_id), (SELECT e.organization_id FROM public.entregas e WHERE e.id = x.entrega_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id)), 'produto_etiquetas', 'produto_id', count(*) FROM public.produto_etiquetas x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, COALESCE((SELECT os.organization_id FROM public.ordens_servico os WHERE os.id = x.ordem_servico_id), (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id)), 'os_faturamento_base', 'produto_id', count(*) FROM public.os_faturamento_base x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_id, (SELECT cl.organization_id FROM public.clientes cl WHERE cl.id = x.cliente_id), 'ordens_servico_onfarm', 'produto_id', count(*) FROM public.ordens_servico_onfarm x WHERE x.produto_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.produto_biologico_sugerido_id, (SELECT cl.organization_id FROM public.registros_consultor rc JOIN public.clientes cl ON cl.id = rc.cliente_id WHERE rc.id = x.registro_consultor_id), 'registros_consultor_recomendacoes', 'produto_biologico_sugerido_id', count(*) FROM public.registros_consultor_recomendacoes x WHERE x.produto_biologico_sugerido_id IS NOT NULL GROUP BY 1, 2;
INSERT INTO platform_private.tenant_catalog_usage SELECT x.product_id, NULL::uuid, 'commercial_campaign_products', 'product_id', count(*) FROM public.commercial_campaign_products x WHERE x.product_id IS NOT NULL GROUP BY 1, 2;
DO $u$ DECLARE v text; BEGIN
  SELECT string_agg(source_table||'.'||source_column||'='||rows_count, ', ') INTO v FROM platform_private.tenant_catalog_usage WHERE organization_id IS NULL;
  IF v IS NOT NULL THEN RAISE EXCEPTION 'tenant_catalog_unresolved_tenant' USING DETAIL = v; END IF;
END $u$;
INSERT INTO platform_private.tenant_catalog_product_map(old_product_id, organization_id, new_product_id) SELECT s.old_product_id, s.organization_id, gen_random_uuid() FROM (SELECT DISTINCT old_product_id, organization_id FROM platform_private.tenant_catalog_usage) s;
INSERT INTO platform_private.tenant_catalog_product_map(old_product_id, organization_id, new_product_id) SELECT s.c, s.o, gen_random_uuid() FROM (SELECT DISTINCT f.component_insumo_id c, m.organization_id o FROM public.formulacoes f JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = f.produto_id WHERE f.component_insumo_id IS NOT NULL) s ON CONFLICT (old_product_id, organization_id) DO NOTHING;
CREATE TEMP TABLE tc_triggers ON COMMIT DROP AS
  SELECT tgrelid::regclass::text AS rel, tgname, tgenabled FROM pg_trigger
   WHERE NOT tgisinternal AND tgenabled <> 'D' AND tgrelid::regclass::text IN ('catalog_tenant_visibility', 'catalogo_volumes', 'commercial_campaign_products', 'commercial_condition_item_prices', 'commercial_price_rules', 'cq_parametros_referencia', 'entregas', 'estoque_embalagens', 'estoque_produto', 'formulacoes', 'lotes', 'microrganismos', 'ordens_servico', 'ordens_servico_onfarm', 'os_faturamento_base', 'partner_order_items', 'partner_product_prices', 'partner_simulation_items', 'product_crop_recommendations', 'product_fiscal_profiles', 'product_target_recommendations', 'product_technical_profiles', 'produto_composicao_conjuntos', 'produto_conformidade_perfis', 'produto_etiquetas', 'produtos', 'programacao_producao', 'registros_consultor_recomendacoes', 'public.catalog_tenant_visibility', 'public.catalogo_volumes', 'public.commercial_campaign_products', 'public.commercial_condition_item_prices', 'public.commercial_price_rules', 'public.cq_parametros_referencia', 'public.entregas', 'public.estoque_embalagens', 'public.estoque_produto', 'public.formulacoes', 'public.lotes', 'public.microrganismos', 'public.ordens_servico', 'public.ordens_servico_onfarm', 'public.os_faturamento_base', 'public.partner_order_items', 'public.partner_product_prices', 'public.partner_simulation_items', 'public.product_crop_recommendations', 'public.product_fiscal_profiles', 'public.product_target_recommendations', 'public.product_technical_profiles', 'public.produto_composicao_conjuntos', 'public.produto_conformidade_perfis', 'public.produto_etiquetas', 'public.produtos', 'public.programacao_producao', 'public.registros_consultor_recomendacoes');
DO $t$ DECLARE r record; BEGIN
  FOR r IN SELECT * FROM tc_triggers LOOP EXECUTE format('ALTER TABLE %s DISABLE TRIGGER %I', r.rel, r.tgname); END LOOP;
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail)
    SELECT 'triggers_disabled', coalesce(jsonb_agg(jsonb_build_object('rel',rel,'trigger',tgname,'state',tgenabled)),'[]') FROM tc_triggers;
END $t$;
ALTER TABLE public.produtos ADD COLUMN owner_organization_id uuid REFERENCES public.organizations(id);
DO $ix$ DECLARE r record; v_cols text; BEGIN
  FOR r IN SELECT i.indexrelid, i.indexrelid::regclass::text AS ix, c.conname
             FROM pg_index i LEFT JOIN pg_constraint c ON c.conindid = i.indexrelid
            WHERE i.indrelid='public.produtos'::regclass AND i.indisunique AND NOT i.indisprimary LOOP
    SELECT string_agg(quote_ident(a.attname), ', ' ORDER BY k.ord) INTO v_cols
      FROM pg_index i2, unnest(i2.indkey) WITH ORDINALITY k(attnum, ord) JOIN pg_attribute a ON a.attrelid='public.produtos'::regclass AND a.attnum=k.attnum
     WHERE i2.indexrelid = r.indexrelid;
    INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail)
      VALUES ('unique_rescoped', jsonb_build_object('index', r.ix, 'def', pg_get_indexdef(r.indexrelid), 'cols', v_cols));
    IF r.conname IS NOT NULL THEN EXECUTE format('ALTER TABLE public.produtos DROP CONSTRAINT %I', r.conname);
    ELSE EXECUTE format('DROP INDEX %s', r.ix); END IF;
    EXECUTE format('CREATE UNIQUE INDEX %I ON public.produtos (owner_organization_id, %s)', r.ix::text || '_tenant', v_cols);
  END LOOP;
END $ix$;
INSERT INTO public.produtos
  SELECT (jsonb_populate_record(NULL::public.produtos,
           to_jsonb(p) || jsonb_build_object('id', m.new_product_id, 'owner_organization_id', m.organization_id))).*
    FROM public.produtos p JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = p.id;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.product_fiscal_profiles'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.product_fiscal_profiles
    SELECT (jsonb_populate_record(NULL::public.product_fiscal_profiles, to_jsonb(s) || jsonb_build_object('product_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.product_fiscal_profiles s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.product_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.product_fiscal_profiles s WHERE s.product_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','product_fiscal_profiles','rows',v_n));
END $d$;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.product_technical_profiles'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.product_technical_profiles
    SELECT (jsonb_populate_record(NULL::public.product_technical_profiles, to_jsonb(s) || jsonb_build_object('produto_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.product_technical_profiles s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.produto_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.product_technical_profiles s WHERE s.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','product_technical_profiles','rows',v_n));
END $d$;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.produto_composicao_conjuntos'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.produto_composicao_conjuntos
    SELECT (jsonb_populate_record(NULL::public.produto_composicao_conjuntos, to_jsonb(s) || jsonb_build_object('produto_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.produto_composicao_conjuntos s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.produto_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.produto_composicao_conjuntos s WHERE s.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','produto_composicao_conjuntos','rows',v_n));
END $d$;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.produto_conformidade_perfis'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.produto_conformidade_perfis
    SELECT (jsonb_populate_record(NULL::public.produto_conformidade_perfis, to_jsonb(s) || jsonb_build_object('produto_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.produto_conformidade_perfis s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.produto_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.produto_conformidade_perfis s WHERE s.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','produto_conformidade_perfis','rows',v_n));
END $d$;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.product_crop_recommendations'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.product_crop_recommendations
    SELECT (jsonb_populate_record(NULL::public.product_crop_recommendations, to_jsonb(s) || jsonb_build_object('produto_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.product_crop_recommendations s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.produto_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.product_crop_recommendations s WHERE s.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
  INSERT INTO platform_private.tenant_catalog_migration_ledger(step, detail) VALUES ('descendant_copied', jsonb_build_object('table','product_crop_recommendations','rows',v_n));
END $d$;
DO $d$ DECLARE v_has_id boolean := EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='public.product_target_recommendations'::regclass AND attname='id' AND NOT attisdropped);
  v_n bigint; BEGIN
  INSERT INTO public.product_target_recommendations
    SELECT (jsonb_populate_record(NULL::public.product_target_recommendations, to_jsonb(s) || jsonb_build_object('produto_id', m.new_product_id)
            || CASE WHEN v_has_id THEN jsonb_build_object('id', gen_random_uuid()) ELSE '{}'::jsonb END)).*
      FROM public.product_target_recommendations s JOIN platform_private.tenant_catalog_product_map m ON m.old_product_id = s.produto_id;
  GET DIAGNOSTICS v_n = ROW_COUNT;
  DELETE FROM public.product_target_recommendations s WHERE s.produto_id IN (SELECT id FROM public.produtos WHERE owner_organization_id IS NULL);
