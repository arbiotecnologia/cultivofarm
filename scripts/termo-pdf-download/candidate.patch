+type Deadline = { signal: AbortSignal; wait: <T>(p: PromiseLike<T>) => Promise<T>; run: <T = any>(b: any) => Promise<T>; dispose: () => void };
+function deadline(ms: number, parent?: AbortSignal | null): Deadline {
