+
+function load(): Handler {
+  const code = ts.transpileModule(readFileSync(SRC, "utf8").replace(/^import[\s\S]*?;\s*/gm, ""),
+    { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.None } }).outputText;
