// CANDIDATO NÃO IMPLANTADO (fora de supabase/functions). Destino após revisão: supabase/functions/tenant-user-admin/index.ts
// Por que existe: em produção sync_user_cliente_principal + guard_profile_tenant_fields negam mudança de
// profiles.cliente_id sob JWT; vínculos/tipos de acesso só podem ser escritos com auth.uid() nulo.
// Autoridade = JWT do ATOR (getClaims + getUser) reautorizado no SQL (admin vigente, mesma empresa, iat > épocas).
// service_role é só transporte; o corpo do cliente nunca autoriza.
import { createClient } from "npm:@supabase/supabase-js@2.110.8";
import { corsHeadersFor, handlePreflight, isTrustedOrigin } from "../_shared/comunicacao/cors.ts";

const OPS = new Set(["change_access_type", "consultor_link"]);
Deno.serve(async (req) => {
  if (req.method === "OPTIONS") return handlePreflight(req);
  const origin = req.headers.get("Origin");
  const json = (b: unknown, s = 200) => new Response(JSON.stringify(b), { status: s, headers: { ...corsHeadersFor(origin), "Content-Type": "application/json", "Cache-Control": "no-store, private" } });
  if (origin && !isTrustedOrigin(origin)) return json({ error: "origin_forbidden" }, 403);
  if (req.method !== "POST") return json({ error: "method_not_allowed" }, 405);
  const url = Deno.env.get("SUPABASE_URL"), anon = Deno.env.get("SUPABASE_ANON_KEY"), svc = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
  if (!url || !anon || !svc || url !== "https://swzpzcwiasxmjutrmvkm.supabase.co") return json({ error: "unavailable" }, 503);
  const h = req.headers.get("Authorization"); if (!h?.startsWith("Bearer ")) return json({ error: "not_authenticated" }, 401);
  const token = h.slice(7).trim();
  const pub = createClient(url, anon, { auth: { persistSession: false, autoRefreshToken: false } });
  const { data: c, error: ce } = await pub.auth.getClaims(token);
  const sub = c?.claims?.sub as string | undefined, iat = Number(c?.claims?.iat);
  if (ce || !sub || !Number.isFinite(iat) || iat <= 0) return json({ error: "not_authenticated" }, 401);
  const admin = createClient(url, svc, { auth: { persistSession: false, autoRefreshToken: false } });
  const { data: u, error: ue } = await admin.auth.getUser(token);      // sessão ainda válida no Auth
  if (ue || u.user?.id !== sub) return json({ error: "not_authenticated" }, 401);
  const body = await req.json().catch(() => null) as { op?: unknown; args?: unknown } | null;
  if (!body || typeof body.op !== "string" || !OPS.has(body.op) || typeof body.args !== "object" || body.args === null) return json({ error: "invalid_args" }, 400);
  const { data, error } = await admin.rpc("tenant_admin_user_access_exec_v1", { p_actor: sub, p_actor_iat: Math.floor(iat), p_op: body.op, p_args: body.args });
  if (error) {
    console.error(JSON.stringify({ fn: "tenant-user-admin", op: body.op, code: error.code ?? null }));
    // Códigos de negócio fixos do SQL; mensagem livre nunca é repassada.
    const m = /([a-z_]+)$/.exec(error.message ?? "")?.[1] ?? "failed";
    return json({ error: m }, error.code === "42501" ? 403 : error.code === "PT409" ? 409 : 400);
  }
  return json(data);
});
