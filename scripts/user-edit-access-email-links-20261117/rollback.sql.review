-- Rollback (deny-only): fecha os pontos de entrada; dados, pedidos, épocas, vínculos e auditoria preservados.
-- Antes: remover/desligar os Edges tenant-user-admin e user-email-change-sync (sem eles o núcleo é inalcançável).
BEGIN;
REVOKE ALL ON FUNCTION public.tenant_admin_user_access_exec_v1(uuid,bigint,text,jsonb) FROM service_role;
DROP FUNCTION IF EXISTS public.tenant_admin_user_access_exec_v1(uuid,bigint,text,jsonb);
DROP FUNCTION IF EXISTS public.tenant_admin_email_change_request_v1(uuid,text,uuid);
DROP FUNCTION IF EXISTS public.tenant_admin_email_change_status_v1(uuid);
DROP FUNCTION IF EXISTS public.tenant_admin_email_change_cancel_v1(uuid,uuid);
DROP FUNCTION IF EXISTS public.tenant_admin_search_clientes_v1(text,int,int);
DROP FUNCTION IF EXISTS public.tenant_admin_consultor_links_v1(uuid);
DROP FUNCTION IF EXISTS public.user_email_change_my_pending_v1();
DROP FUNCTION IF EXISTS public.user_email_change_accept_v1(uuid);
DROP FUNCTION IF EXISTS public.user_email_change_decline_v1(uuid);
DROP FUNCTION IF EXISTS public.user_email_change_release_v1(uuid);
-- MANTER public.user_email_change_sync_self_v1(), public.user_email_change_sync_service_v1(uuid),
-- platform_private.user_email_change_sync_v1(uuid) e platform_private.user_email_change_reconcile(uuid):
-- pedidos aceitos (inclusive cancelados depois do aceite) podem ter link oficial do Auth ainda válido;
-- removê-los deixaria auth.users.email divergente de profiles após confirmação tardia.
DROP FUNCTION IF EXISTS public.my_session_authz_state_v1();
-- platform_actor_access_ready: MANTER a versão com user_authz_epoch (deny-only). Restaurar o corpo
-- capturado (md5 048249c0c2106c3761e26eacb8d0de84) reabriria autoridade de JWTs anteriores a
-- mudanças já executadas; só após expiração dos tokens antigos e com decisão do auditor.
-- Gatilhos globais: nada a desfazer (o candidato não os altera).
-- rev.6 — campanhas_cliente_select: NÃO restaurar a expressão anterior (reabriria leitura comercial por vínculo
-- de consultor). Rollback mantém a versão restrita; a verificação abaixo aborta se alguém a tiver afrouxado.
DO $rb9$ BEGIN
  IF (SELECT pg_get_expr(polqual, polrelid) FROM pg_policy WHERE polrelid = 'public.commercial_campaigns'::regclass AND polname = 'campanhas_cliente_select') !~ 'cliente_produtor' THEN
    RAISE EXCEPTION 'rollback: campanhas_cliente_select sem exigência de papel produtor — não prosseguir';
  END IF;
END $rb9$;
-- user_admin_scope_settle é inalcançável sem os núcleos (fica, sem EXECUTE de cliente).
COMMIT;
