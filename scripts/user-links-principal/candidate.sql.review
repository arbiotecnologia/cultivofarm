-- CANDIDATO. Não executar nesta rodada. Destino obrigatório swzpzcwiasxmjutrmvkm.
-- Executor deve validar o ref fora do SQL; current_database() não prova project ref.
-- Escopo: SOMENTE public.sync_user_cliente_principal. Não altera ACL, roles, dados,
-- constraints, demais triggers, gate common F2, V0 instalado nem ledger.
-- Preserva assinatura, SECURITY DEFINER, search_path e ACL live ({postgres,service_role}).

DO $preflight$
BEGIN
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p
      JOIN pg_namespace n ON n.oid=p.pronamespace
      WHERE n.nspname='public' AND p.proname='sync_user_cliente_principal')
     <> '50392a57c5908c67c709c4e84f0e932e' THEN
    RAISE EXCEPTION 'principal_sync_definition_drift';
  END IF;
  IF (SELECT md5(pg_get_functiondef(p.oid)) FROM pg_proc p
      JOIN pg_namespace n ON n.oid=p.pronamespace
      WHERE n.nspname='public' AND p.proname='get_cliente_ids_for_user')
     <> 'c80d5900692d960f649d0a9f7850fe2c' THEN
    RAISE EXCEPTION 'principal_resolver_definition_drift';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='trg_user_clientes_sync'
    AND tgrelid='public.user_clientes'::regclass) THEN
    RAISE EXCEPTION 'principal_trigger_missing';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid='public.user_clientes'::regclass
    AND conname='user_clientes_user_id_cliente_id_key') THEN
    RAISE EXCEPTION 'principal_unique_drift';
  END IF;
END
$preflight$;

-- Vigência canônica alinhada ao resolver live get_cliente_ids_for_user:
-- is_active AND revoked_at IS NULL AND valid_from/valid_until dentro da janela.
-- Convergência: cada UPDATE só toca linhas que precisam mudar; a segunda
-- passagem do trigger não encontra trabalho e a recursão termina.
CREATE OR REPLACE FUNCTION public.sync_user_cliente_principal()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user uuid;
  v_principal uuid;
BEGIN
  v_user := COALESCE(NEW.user_id, OLD.user_id);

  -- 1) Rebaixa principais que não estão vigentes (inativo, revogado, futuro, expirado)
  UPDATE public.user_clientes
     SET principal = false
   WHERE user_id = v_user
     AND principal = true
     AND NOT (is_active AND revoked_at IS NULL
              AND (valid_from IS NULL OR valid_from <= now())
              AND (valid_until IS NULL OR valid_until >= now()));

  -- 2) Se a linha da operação é vigente e marcada principal, desmarca as demais
  IF TG_OP IN ('INSERT','UPDATE') AND NEW.principal
     AND NEW.is_active AND NEW.revoked_at IS NULL
     AND (NEW.valid_from IS NULL OR NEW.valid_from <= now())
     AND (NEW.valid_until IS NULL OR NEW.valid_until >= now()) THEN
    UPDATE public.user_clientes
       SET principal = false
     WHERE user_id = v_user
       AND id <> NEW.id
       AND principal = true;
  END IF;

  -- 3) Garante exatamente um principal vigente, deterministicamente
  --    (mais antigo por created_at, desempate por id)
  IF NOT EXISTS (
    SELECT 1 FROM public.user_clientes
     WHERE user_id = v_user AND principal = true
       AND is_active AND revoked_at IS NULL
       AND (valid_from IS NULL OR valid_from <= now())
       AND (valid_until IS NULL OR valid_until >= now())
  ) THEN
    UPDATE public.user_clientes
       SET principal = true
     WHERE id = (
       SELECT id FROM public.user_clientes
        WHERE user_id = v_user
          AND is_active AND revoked_at IS NULL
          AND (valid_from IS NULL OR valid_from <= now())
          AND (valid_until IS NULL OR valid_until >= now())
        ORDER BY created_at ASC, id ASC
        LIMIT 1
     );
  END IF;

  -- 4) Sincroniza profiles.cliente_id SOMENTE com principal vigente (ou NULL).
  --    Nunca aponta para vínculo histórico/revogado.
  SELECT cliente_id INTO v_principal
    FROM public.user_clientes
   WHERE user_id = v_user AND principal = true
     AND is_active AND revoked_at IS NULL
     AND (valid_from IS NULL OR valid_from <= now())
     AND (valid_until IS NULL OR valid_until >= now())
   LIMIT 1;

  UPDATE public.profiles
     SET cliente_id = v_principal
   WHERE user_id = v_user
     AND cliente_id IS DISTINCT FROM v_principal;

  RETURN COALESCE(NEW, OLD);
END;
$function$;

-- ACL preservada: nenhum GRANT/REVOKE novo; a função substituída herda os
-- privilégios existentes do objeto de mesmo nome/assinatura.
