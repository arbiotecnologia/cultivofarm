-- ROLLBACK CANDIDATO v3 — SOMENTE COM GATE DE ASSOCIAÇÃO FECHADO.
-- Esta restauração traz de volta a definição live anterior, que contém a falha
-- conhecida (principal histórico). Só é segura enquanto a troca de associações
-- estiver fechada (estado atual). Se o gate de associação estiver aberto, NÃO
-- usar este arquivo: a contenção segura é manter/aplicar o candidate.sql.review
-- (v3), que é ele próprio o estado contido.
-- Não apaga dados, não reverte vínculos legítimos, não toca V0/common F2/ledger.
CREATE OR REPLACE FUNCTION public.sync_user_cliente_principal()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user uuid;
  v_principal uuid;
BEGIN
  v_user := COALESCE(NEW.user_id, OLD.user_id);

  -- Se inseriu/atualizou marcando principal, desmarca os demais
  IF TG_OP IN ('INSERT','UPDATE') AND NEW.principal THEN
    UPDATE public.user_clientes
       SET principal = false
     WHERE user_id = v_user
       AND id <> NEW.id
       AND principal = true;
  END IF;

  -- Garante que sempre exista um principal se houver linhas
  IF NOT EXISTS (
    SELECT 1 FROM public.user_clientes WHERE user_id = v_user AND principal = true
  ) THEN
    UPDATE public.user_clientes
       SET principal = true
     WHERE id = (
       SELECT id FROM public.user_clientes
        WHERE user_id = v_user
        ORDER BY created_at ASC LIMIT 1
     );
  END IF;

  -- Sincroniza profiles.cliente_id com o principal atual
  SELECT cliente_id INTO v_principal
    FROM public.user_clientes
   WHERE user_id = v_user AND principal = true
   LIMIT 1;

  UPDATE public.profiles
     SET cliente_id = v_principal
   WHERE user_id = v_user
     AND COALESCE(cliente_id::text,'') IS DISTINCT FROM COALESCE(v_principal::text,'');

  RETURN COALESCE(NEW, OLD);
END;
$function$;

DROP TRIGGER IF EXISTS trg_user_clientes_sync_ins ON public.user_clientes;
DROP TRIGGER IF EXISTS trg_user_clientes_sync_upd ON public.user_clientes;
DROP TRIGGER IF EXISTS trg_user_clientes_sync_del ON public.user_clientes;
DROP TRIGGER IF EXISTS trg_user_clientes_sync ON public.user_clientes;
CREATE TRIGGER trg_user_clientes_sync
 AFTER INSERT OR DELETE OR UPDATE ON public.user_clientes
 FOR EACH ROW EXECUTE FUNCTION public.sync_user_cliente_principal();
