-- READ ONLY. SET app.expected_ref='swzpzcwiasxmjutrmvkm' antes. Exige 02e instalado. Falha fechada.
DO $pre$ BEGIN
 IF current_setting('app.expected_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'IAP_PRE_REF_UNPROVEN'; END IF;
 IF md5(pg_get_functiondef('public.approve_partner_order(uuid,text,date)'::regprocedure)) IS DISTINCT FROM '0d3b85049e3b3b799ba81b4cb95be0da' THEN RAISE EXCEPTION 'IAP_PRE_DRIFT:public.approve_partner_order(uuid,text,date)'; END IF;
 IF md5(pg_get_functiondef('public.c2_internal_order_entry_capability_v1()'::regprocedure)) IS DISTINCT FROM '7ec80e2596cac468063dc167f2f90165' THEN RAISE EXCEPTION 'IAP_PRE_GCAP:public.c2_internal_order_entry_capability_v1()'; END IF;
 IF md5(pg_get_functiondef('platform_private.b2b_internal_order_snapshot_guard()'::regprocedure)) IS DISTINCT FROM '1f82005554748b8545403372160e68a9' THEN RAISE EXCEPTION 'IAP_PRE_GUARD:platform_private.b2b_internal_order_snapshot_guard()'; END IF;
 IF (SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='public.approve_partner_order(uuid,text,date)'::regprocedure) IS DISTINCT FROM 'postgres>authenticated:EXECUTE:f,postgres>postgres:EXECUTE:f,postgres>service_role:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'IAP_PRE_ACL:public.approve_partner_order(uuid,text,date)'; END IF;
 RAISE NOTICE 'IAP_PRE_PASS';
END $pre$;
SELECT 'IAP_PRE_PASS';
