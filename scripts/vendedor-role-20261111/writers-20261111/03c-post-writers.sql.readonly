 IF EXISTS(SELECT 1 FROM pg_proc p WHERE p.prokind='f' AND pg_get_functiondef(p.oid) LIKE '%seller_quote_respond%' AND p.oid NOT IN ('public.respond_b2b_order_quote_secure(uuid,jsonb,date,integer,text)'::regprocedure,'platform_private.seller_quote_origin_dispatch(uuid,jsonb,uuid,uuid)'::regprocedure)) THEN RAISE EXCEPTION 'VENDW_POST_TICKET_SCOPE_WIDENED'; END IF;
END $post$;
SELECT 'VENDW_POST_PASS';
