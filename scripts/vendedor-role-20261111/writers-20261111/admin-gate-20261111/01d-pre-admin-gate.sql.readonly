-- READ ONLY. SET app.expected_ref='swzpzcwiasxmjutrmvkm' antes. Requer 02b+02c instalados e sem drift.
DO $pre$ BEGIN
 IF current_setting('app.expected_ref',true) IS DISTINCT FROM 'swzpzcwiasxmjutrmvkm' THEN RAISE EXCEPTION 'VENDA_PRE_REF_UNPROVEN'; END IF;
 IF md5(pg_get_functiondef('public.admin_assign_seller_portfolio_v1(uuid,uuid,text)'::regprocedure)) IS DISTINCT FROM 'ba9f3f32d92f027642a40e78d38c09e9' THEN RAISE EXCEPTION 'VENDA_PRE_DRIFT:public.admin_assign_seller_portfolio_v1(uuid,uuid,text)'; END IF;
 IF ((SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='public.admin_assign_seller_portfolio_v1(uuid,uuid,text)'::regprocedure)) IS DISTINCT FROM 'postgres>authenticated:EXECUTE:f,postgres>postgres:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'VENDA_PRE_ACL_DRIFT:public.admin_assign_seller_portfolio_v1(uuid,uuid,text)'; END IF;
 IF md5(pg_get_functiondef('public.admin_revoke_seller_portfolio_v1(uuid,text)'::regprocedure)) IS DISTINCT FROM '95a65f60521d4346ba377d1918f5dd48' THEN RAISE EXCEPTION 'VENDA_PRE_DRIFT:public.admin_revoke_seller_portfolio_v1(uuid,text)'; END IF;
 IF ((SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='public.admin_revoke_seller_portfolio_v1(uuid,text)'::regprocedure)) IS DISTINCT FROM 'postgres>authenticated:EXECUTE:f,postgres>postgres:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'VENDA_PRE_ACL_DRIFT:public.admin_revoke_seller_portfolio_v1(uuid,text)'; END IF;
 IF md5(pg_get_functiondef('public.admin_list_seller_portfolio_v1()'::regprocedure)) IS DISTINCT FROM '907f4d1eb2d5909587d082b7ad9bb900' THEN RAISE EXCEPTION 'VENDA_PRE_DRIFT:public.admin_list_seller_portfolio_v1()'; END IF;
 IF ((SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='public.admin_list_seller_portfolio_v1()'::regprocedure)) IS DISTINCT FROM 'postgres>authenticated:EXECUTE:f,postgres>postgres:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'VENDA_PRE_ACL_DRIFT:public.admin_list_seller_portfolio_v1()'; END IF;
 IF md5(pg_get_functiondef('public.admin_seller_portfolio_overview_v1()'::regprocedure)) IS DISTINCT FROM '53dca32d7f12458c194cf852e47ad92f' THEN RAISE EXCEPTION 'VENDA_PRE_DRIFT:public.admin_seller_portfolio_overview_v1()'; END IF;
 IF ((SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='public.admin_seller_portfolio_overview_v1()'::regprocedure)) IS DISTINCT FROM 'postgres>authenticated:EXECUTE:f,postgres>postgres:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'VENDA_PRE_ACL_DRIFT:public.admin_seller_portfolio_overview_v1()'; END IF;
 IF to_regprocedure('platform_private.seller_admin_actor_org()') IS NOT NULL THEN RAISE EXCEPTION 'VENDA_PRE_ALREADY_PRESENT:platform_private.seller_admin_actor_org()'; END IF;
 IF to_regprocedure('platform_private.seller_assignee_eligible(uuid,uuid)') IS NOT NULL THEN RAISE EXCEPTION 'VENDA_PRE_ALREADY_PRESENT:platform_private.seller_assignee_eligible(uuid,uuid)'; END IF;
 RAISE NOTICE 'VENDA_PRE_PASS';
END $pre$;
