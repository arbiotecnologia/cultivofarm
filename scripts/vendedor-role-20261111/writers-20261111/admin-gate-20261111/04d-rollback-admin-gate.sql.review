CREATE OR REPLACE FUNCTION public.admin_assign_seller_portfolio_v1(p_seller uuid, p_partner uuid, p_reason text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog'
AS $function$
DECLARE v_org uuid := platform_private.seller_actor_org('administrador'); v_id uuid;
BEGIN
  IF v_org IS NULL THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_REASON_REQUIRED' USING ERRCODE='22023'; END IF;
  PERFORM 1 FROM public.partner_accounts WHERE id=p_partner AND commercial_owner_organization_id=v_org FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE user_id=p_seller AND organization_id=v_org AND ativo IS TRUE)
     OR NOT EXISTS (SELECT 1 FROM public.user_roles WHERE user_id=p_seller AND role='vendedor') THEN
    RAISE EXCEPTION 'SELLER_PORTFOLIO_SELLER_INVALID' USING ERRCODE='22023';
  END IF;
  IF EXISTS (SELECT 1 FROM platform_private.seller_portfolio_assignments
              WHERE organization_id=v_org AND partner_id=p_partner AND revoked_at IS NULL) THEN
    RAISE EXCEPTION 'SELLER_PORTFOLIO_ALREADY_ASSIGNED' USING ERRCODE='P0409';
  END IF;
  INSERT INTO platform_private.seller_portfolio_assignments(organization_id,seller_user_id,partner_id,assigned_by,reason)
  VALUES (v_org,p_seller,p_partner,auth.uid(),btrim(p_reason)) RETURNING id INTO v_id;
  INSERT INTO platform_private.seller_portfolio_audit(assignment_id,action,actor,snapshot)
  SELECT v_id,'assign',auth.uid(),to_jsonb(a) FROM platform_private.seller_portfolio_assignments a WHERE a.id=v_id;
  RETURN v_id;
END $function$;
CREATE OR REPLACE FUNCTION public.admin_revoke_seller_portfolio_v1(p_assignment uuid, p_reason text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog'
AS $function$
DECLARE v_org uuid := platform_private.seller_actor_org('administrador');
BEGIN
  IF v_org IS NULL THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  IF nullif(btrim(coalesce(p_reason,'')),'') IS NULL THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_REASON_REQUIRED' USING ERRCODE='22023'; END IF;
  UPDATE platform_private.seller_portfolio_assignments
     SET revoked_at=now(), revoked_by=auth.uid(), revoke_reason=btrim(p_reason)
   WHERE id=p_assignment AND organization_id=v_org AND revoked_at IS NULL;
  IF NOT FOUND THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  INSERT INTO platform_private.seller_portfolio_audit(assignment_id,action,actor,snapshot)
  SELECT p_assignment,'revoke',auth.uid(),to_jsonb(a) FROM platform_private.seller_portfolio_assignments a WHERE a.id=p_assignment;
END $function$;
CREATE OR REPLACE FUNCTION public.admin_list_seller_portfolio_v1()
 RETURNS TABLE(id uuid, seller_user_id uuid, partner_id uuid, assigned_at timestamp with time zone, reason text, revoked_at timestamp with time zone)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog'
AS $function$
DECLARE v_org uuid := platform_private.seller_actor_org('administrador');
BEGIN
  IF v_org IS NULL THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  RETURN QUERY SELECT a.id,a.seller_user_id,a.partner_id,a.assigned_at,a.reason,a.revoked_at
    FROM platform_private.seller_portfolio_assignments a WHERE a.organization_id=v_org ORDER BY a.assigned_at DESC;
END $function$;
CREATE OR REPLACE FUNCTION public.admin_seller_portfolio_overview_v1()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_org uuid := platform_private.seller_actor_org('administrador'::public.app_role);
BEGIN
  IF v_org IS NULL OR v_org IS DISTINCT FROM public.h15_actor_organization() THEN RAISE EXCEPTION 'SELLER_PORTFOLIO_FORBIDDEN' USING ERRCODE='42501'; END IF;
  RETURN jsonb_build_object('contract','admin_seller_portfolio_overview_v1','organization_id',v_org,
    'sellers',COALESCE((SELECT jsonb_agg(jsonb_build_object('user_id',pr.user_id,'nome',pr.nome) ORDER BY pr.nome, pr.user_id)
      FROM public.profiles pr WHERE pr.organization_id=v_org AND pr.ativo IS TRUE
       AND EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id=pr.user_id AND r.role='vendedor'::public.app_role)),'[]'::jsonb),
    'partners',COALESCE((SELECT jsonb_agg(jsonb_build_object('partner_id',p.id,'razao_social',p.razao_social) ORDER BY p.razao_social, p.id)
      FROM public.partner_accounts p WHERE p.commercial_owner_organization_id=v_org AND p.ativo IS TRUE AND p.deleted_at IS NULL),'[]'::jsonb),
    'assignments',COALESCE((SELECT jsonb_agg(jsonb_build_object('id',a.id,'seller_user_id',a.seller_user_id,'partner_id',a.partner_id,
        'assigned_at',a.assigned_at,'reason',a.reason,'revoked_at',a.revoked_at,'revoke_reason',a.revoke_reason,
        'seller_active',EXISTS(SELECT 1 FROM public.profiles sp WHERE sp.user_id=a.seller_user_id AND sp.organization_id=v_org AND sp.ativo IS TRUE)
          AND EXISTS(SELECT 1 FROM public.user_roles sr WHERE sr.user_id=a.seller_user_id AND sr.role='vendedor'::public.app_role),
        'partner_active',EXISTS(SELECT 1 FROM public.partner_accounts pp WHERE pp.id=a.partner_id AND pp.ativo IS TRUE AND pp.deleted_at IS NULL)) ORDER BY a.assigned_at DESC, a.id)
      FROM platform_private.seller_portfolio_assignments a WHERE a.organization_id=v_org),'[]'::jsonb));
END $function$;
