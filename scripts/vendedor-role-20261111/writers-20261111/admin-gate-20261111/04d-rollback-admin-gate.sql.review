 IF ((SELECT coalesce((SELECT string_agg(x,',' ORDER BY x) FROM (SELECT format('%s>%s:%s:%s',pg_get_userbyid(a.grantor),CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,a.privilege_type,a.is_grantable) x FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) q),'')||'|'||pg_get_userbyid(p.proowner) FROM pg_proc p WHERE p.oid='platform_private.seller_admin_actor_org()'::regprocedure)) IS DISTINCT FROM 'postgres>postgres:EXECUTE:f|postgres' THEN RAISE EXCEPTION 'VENDA_RB_ACL_DRIFT:platform_private.seller_admin_actor_org()'; END IF;
