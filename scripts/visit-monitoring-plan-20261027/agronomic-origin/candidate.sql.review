BEGIN;
-- INACTIVE. Independent reviewer executes only after preflight.sql on ref swzpzcwiasxmjutrmvkm.
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '20s';
DO $pre$
BEGIN
  IF md5(pg_get_functiondef('public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz)'::regprocedure))<>'b32bf163ed7ccb989f4f0b653827d825'
    OR md5(pg_get_functiondef('public.rpc_criar_alerta_climatico_v1(uuid,uuid,public.tipo_alerta,public.nivel_risco,text)'::regprocedure))<>'b675f863360f50d58cd5358451284eff'
    OR md5(pg_get_functiondef('platform_private.guard_visit_plan_preservation()'::regprocedure))<>'618797b75f8c6b962dc70c0841c84de1'
    OR md5(pg_get_functiondef('platform_private.save_visit_monitoring_plan_core(uuid,integer,jsonb,uuid)'::regprocedure))<>'a7817ac54fd40701d97ceb9a57976a57'
    OR md5(pg_get_functiondef('public._visita_lock_and_check(uuid,integer,boolean)'::regprocedure))<>'e3bc4bd9d38f1fb4b659b9e1384c770a'
    OR md5(pg_get_functiondef('public.can_manage_technical_visit(uuid,uuid)'::regprocedure))<>'d95c2c2b34af117d467d7d4b2b775002'
    OR md5(pg_get_functiondef('platform_private.monitoring_refs_in_actor_tenant(uuid,uuid,uuid)'::regprocedure))<>'914283d3f4dee931679ef140ae84b498'
    OR md5(pg_get_functiondef('public.technical_actor_ready(uuid)'::regprocedure))<>'b5d0994b6eb976b14122cd2a1ec798cf'
    OR md5(pg_get_functiondef('public.enforce_visit_immutability()'::regprocedure))<>'8a6a92bb748f745526ed163ec52464aa'
    OR to_regclass('platform_private.visit_plan_write_tickets') IS NULL THEN
    RAISE EXCEPTION 'agronomic_origin_dependency_drift' USING ERRCODE='55000';
  END IF;
  -- Revocation must serialize on the same gate; otherwise the ordering claims are void.
  IF NOT EXISTS(SELECT 1 FROM pg_trigger t WHERE t.tgrelid='public.user_roles'::regclass AND NOT t.tgisinternal
      AND t.tgenabled='O' AND t.tgfoid='cf_user_guards_v1.acquire_gate()'::regprocedure)
    OR NOT EXISTS(SELECT 1 FROM pg_trigger t WHERE t.tgrelid='public.profiles'::regclass AND NOT t.tgisinternal
      AND t.tgenabled='O' AND t.tgfoid='cf_user_guards_v1.acquire_gate()'::regprocedure)
    OR NOT EXISTS(SELECT 1 FROM pg_trigger t WHERE t.tgrelid='public.registros_consultor'::regclass
      AND t.tgname='trg_visit_plan_preservation' AND t.tgenabled='O') THEN
    RAISE EXCEPTION 'agronomic_origin_gate_or_guard_missing' USING ERRCODE='55000';
  END IF;
  IF to_regclass('platform_private.monitoring_alert_receipts') IS NOT NULL
    OR to_regprocedure('public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid)') IS NOT NULL
    OR to_regprocedure('public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid)') IS NOT NULL
    OR to_regprocedure('public.rpc_listar_alertas_vinculaveis_v1(uuid)') IS NOT NULL THEN
    RAISE EXCEPTION 'agronomic_origin_already_installed_review_required' USING ERRCODE='55000';
  END IF;
END;
$pre$;

CREATE TABLE platform_private.monitoring_alert_receipts (
  actor_id uuid NOT NULL, alerta_id uuid NOT NULL, request_id uuid NOT NULL,
  operation text NOT NULL CHECK (operation IN ('link_origin','reschedule')),
  fingerprint text NOT NULL, result jsonb NOT NULL,
  PRIMARY KEY(actor_id,alerta_id,request_id)
);
REVOKE ALL ON platform_private.monitoring_alert_receipts FROM PUBLIC,anon,authenticated;
GRANT ALL ON platform_private.monitoring_alert_receipts TO service_role;
ALTER TABLE platform_private.monitoring_alert_receipts ENABLE ROW LEVEL SECURITY;

-- Lock order for every writer here: global gate -> alert row -> visit row -> generic notice.
-- The plan writer uses gate -> visit -> notice; the gate serializes both, so no inversion.
-- lock_timeout bounds each wait; no long global wait is created.
CREATE FUNCTION platform_private.link_alert_origin_core(
  p_alerta_id uuid, p_registro_id uuid, p_expected_alert_updated_at timestamptz,
  p_expected_visit_version integer, p_request_id uuid
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_alerta public.alertas_agronomicos;
  v_reg public.registros_consultor;
  v_receipt jsonb;
  v_updated timestamptz;
  v_fp text := md5(jsonb_build_object('op','link_origin','alerta',p_alerta_id,'visit',p_registro_id,
    'alert_at',p_expected_alert_updated_at,'version',p_expected_visit_version)::text);
BEGIN
  IF NOT coalesce(public.technical_actor_ready(v_uid),false) THEN
    RAISE EXCEPTION 'monitoring_unavailable' USING ERRCODE='42501';
  END IF;
  IF p_alerta_id IS NULL OR p_registro_id IS NULL OR p_request_id IS NULL THEN
    RAISE EXCEPTION 'invalid_input' USING ERRCODE='22023';
  END IF;
  IF p_expected_alert_updated_at IS NULL OR NOT isfinite(p_expected_alert_updated_at)
    OR p_expected_visit_version IS NULL OR p_expected_visit_version<=0 THEN
    RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409';
  END IF;
  PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'monitoring_gate_unavailable' USING ERRCODE='55000'; END IF;
  IF NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT coalesce(public.can_manage_technical_visit(v_uid,p_registro_id),false) THEN
    RAISE EXCEPTION 'monitoring_unavailable' USING ERRCODE='PT404';
  END IF;
  SELECT * INTO v_alerta FROM public.alertas_agronomicos
   WHERE id=p_alerta_id AND platform_private.monitoring_refs_in_actor_tenant(fazenda_id,talhao_id,NULL)
   FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'monitoring_alert_not_found' USING ERRCODE='PT404'; END IF;
  v_reg := public._visita_lock_and_check(p_registro_id,NULL,false);
  -- Re-read authority after every wait (READ COMMITTED: new snapshot per statement).
  IF NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT coalesce(public.can_manage_technical_visit(v_uid,p_registro_id),false)
    OR NOT coalesce(platform_private.monitoring_refs_in_actor_tenant(v_alerta.fazenda_id,v_alerta.talhao_id,NULL),false) THEN
    RAISE EXCEPTION 'monitoring_unavailable' USING ERRCODE='PT404';
  END IF;
  SELECT jsonb_build_object('fp',fingerprint,'op',operation,'result',result) INTO v_receipt
    FROM platform_private.monitoring_alert_receipts
   WHERE actor_id=v_uid AND alerta_id=p_alerta_id AND request_id=p_request_id;
  IF FOUND THEN
    IF v_receipt->>'op'<>'link_origin' OR v_receipt->>'fp' IS DISTINCT FROM v_fp THEN
      RAISE EXCEPTION 'request_conflict' USING ERRCODE='PT409';
    END IF;
    RETURN v_receipt->'result';
  END IF;
  IF v_reg.status::text NOT IN ('rascunho','em_andamento') THEN
    RAISE EXCEPTION 'technical_record_content_locked' USING ERRCODE='42501';
  END IF;
  IF v_reg.version IS DISTINCT FROM p_expected_visit_version
    OR v_alerta.updated_at IS DISTINCT FROM p_expected_alert_updated_at THEN
    RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409';
  END IF;
  IF v_alerta.registro_origem_id IS NOT NULL THEN
    RAISE EXCEPTION 'alert_origin_already_linked' USING ERRCODE='PT409';
  END IF;
  IF v_alerta.status::text NOT IN ('ativo','monitoramento') THEN
    RAISE EXCEPTION 'monitoring_alert_not_active' USING ERRCODE='P0001';
  END IF;
  -- Sync contract: at most one open alert per origin visit (its date is the visit/plan date).
  IF EXISTS(SELECT 1 FROM public.alertas_agronomicos o WHERE o.registro_origem_id=p_registro_id
      AND o.id<>p_alerta_id AND o.status::text<>'encerrado') THEN
    RAISE EXCEPTION 'visit_already_has_origin_alert' USING ERRCODE='PT409';
  END IF;
  -- Date policy: linking never creates divergence; reprogram first so dates match.
  IF v_reg.data_proxima_visita IS NOT NULL AND v_alerta.data_vencimento IS DISTINCT FROM v_reg.data_proxima_visita THEN
    RAISE EXCEPTION 'origin_date_mismatch' USING ERRCODE='22023';
  END IF;
  IF position('[PLANO DE MONITORAMENTO]' in coalesce(v_reg.observacoes_tecnicas,''))>0 AND v_reg.data_proxima_visita IS NULL THEN
    RAISE EXCEPTION 'plan_date_missing' USING ERRCODE='PT409';
  END IF;
  -- Same farm and compatible plot; an alert without plot only matches by farm.
  IF v_reg.fazenda_id IS DISTINCT FROM v_alerta.fazenda_id
    OR (v_alerta.talhao_id IS NOT NULL AND v_reg.talhao_id IS DISTINCT FROM v_alerta.talhao_id)
    OR NOT coalesce(platform_private.monitoring_refs_in_actor_tenant(v_alerta.fazenda_id,v_alerta.talhao_id,v_reg.id),false) THEN
    RAISE EXCEPTION 'origin_reference_mismatch' USING ERRCODE='22023';
  END IF;
  UPDATE public.alertas_agronomicos
     SET registro_origem_id=p_registro_id,
         updated_at=greatest(clock_timestamp(),v_alerta.updated_at+interval '1 microsecond')
   WHERE id=p_alerta_id AND updated_at=p_expected_alert_updated_at AND registro_origem_id IS NULL
   RETURNING updated_at INTO v_updated;
  IF NOT FOUND THEN RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409'; END IF;
  v_receipt := jsonb_build_object('ok',true,'alerta_id',p_alerta_id,'registro_origem_id',p_registro_id,
    'tipo_alerta',v_alerta.tipo_alerta,'alerta_updated_at',v_updated,'visit_version',v_reg.version,'request_id',p_request_id);
  INSERT INTO public.visitas_logs(registro_consultor_id,usuario_id,acao,descricao,metadata)
    VALUES(p_registro_id,v_uid,'alerta_origem_vinculada','Alerta agronômico vinculado à visita de origem',
      jsonb_build_object('request_id',p_request_id,'alerta_id',p_alerta_id,'fingerprint',v_fp));
  INSERT INTO platform_private.monitoring_alert_receipts VALUES(v_uid,p_alerta_id,p_request_id,'link_origin',v_fp,v_receipt);
  RETURN v_receipt;
END;
$function$;

CREATE FUNCTION platform_private.reschedule_monitoring_core(
  p_alerta_id uuid, p_nova_data date, p_expected_alert_updated_at timestamptz,
  p_expected_visit_version integer, p_request_id uuid
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path='' SET lock_timeout='3s' AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_alerta public.alertas_agronomicos;
  v_reg public.registros_consultor;
  v_receipt jsonb;
  v_obs text; v_block text; v_new_block text;
  v_notice uuid; v_version integer; v_updated timestamptz; v_visit_updated boolean := false; v_mode text := 'somente_alerta';
  v_fp text := md5(jsonb_build_object('op','reschedule','alerta',p_alerta_id,'date',p_nova_data,
    'alert_at',p_expected_alert_updated_at,'version',p_expected_visit_version)::text);
BEGIN
  IF v_uid IS NULL OR NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT (public.has_role(v_uid,'administrador'::public.app_role) OR public.has_role(v_uid,'gestor'::public.app_role)) THEN
    RAISE EXCEPTION 'permission_denied' USING ERRCODE='42501';
  END IF;
  IF p_alerta_id IS NULL OR p_nova_data IS NULL OR p_request_id IS NULL THEN
    RAISE EXCEPTION 'invalid_input' USING ERRCODE='22023';
  END IF;
  IF p_expected_alert_updated_at IS NULL OR NOT isfinite(p_expected_alert_updated_at)
    OR (p_expected_visit_version IS NOT NULL AND p_expected_visit_version<=0) THEN
    RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409';
  END IF;
  PERFORM 1 FROM cf_user_guards_v1.state WHERE singleton FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'monitoring_gate_unavailable' USING ERRCODE='55000'; END IF;
  IF NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT (public.has_role(v_uid,'administrador'::public.app_role) OR public.has_role(v_uid,'gestor'::public.app_role)) THEN
    RAISE EXCEPTION 'permission_denied' USING ERRCODE='42501';
  END IF;
  SELECT * INTO v_alerta FROM public.alertas_agronomicos
   WHERE id=p_alerta_id AND platform_private.monitoring_refs_in_actor_tenant(fazenda_id,talhao_id,registro_origem_id)
   FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'monitoring_alert_not_found' USING ERRCODE='PT404'; END IF;
  IF v_alerta.registro_origem_id IS NOT NULL THEN
    v_reg := public._visita_lock_and_check(v_alerta.registro_origem_id,NULL,false);
  END IF;
  IF NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT (public.has_role(v_uid,'administrador'::public.app_role) OR public.has_role(v_uid,'gestor'::public.app_role))
    OR NOT coalesce(platform_private.monitoring_refs_in_actor_tenant(v_alerta.fazenda_id,v_alerta.talhao_id,v_alerta.registro_origem_id),false)
    OR (v_alerta.registro_origem_id IS NOT NULL AND NOT coalesce(public.can_manage_technical_visit(v_uid,v_alerta.registro_origem_id),false)) THEN
    RAISE EXCEPTION 'monitoring_alert_not_found' USING ERRCODE='PT404';
  END IF;
  SELECT jsonb_build_object('fp',fingerprint,'op',operation,'result',result) INTO v_receipt
    FROM platform_private.monitoring_alert_receipts
   WHERE actor_id=v_uid AND alerta_id=p_alerta_id AND request_id=p_request_id;
  IF FOUND THEN
    IF v_receipt->>'op'<>'reschedule' OR v_receipt->>'fp' IS DISTINCT FROM v_fp THEN
      RAISE EXCEPTION 'request_conflict' USING ERRCODE='PT409';
    END IF;
    RETURN v_receipt->'result';
  END IF;
  IF p_nova_data < (clock_timestamp() AT TIME ZONE 'America/Sao_Paulo')::date THEN
    RAISE EXCEPTION 'past_date_not_allowed' USING ERRCODE='22023';
  END IF;
  IF v_alerta.status IS DISTINCT FROM 'monitoramento'::public.status_alerta THEN
    RAISE EXCEPTION 'monitoring_alert_not_active' USING ERRCODE='P0001';
  END IF;
  IF v_alerta.updated_at IS DISTINCT FROM p_expected_alert_updated_at
    OR (v_alerta.registro_origem_id IS NULL AND p_expected_visit_version IS NOT NULL)
    OR (v_alerta.registro_origem_id IS NOT NULL AND v_reg.version IS DISTINCT FROM p_expected_visit_version) THEN
    RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409';
  END IF;
  IF v_alerta.registro_origem_id IS NOT NULL AND v_reg.status::text IN ('rascunho','em_andamento') THEN
    -- Shared date: any other open alert on the same visit makes synchronization ambiguous.
    IF EXISTS(SELECT 1 FROM public.alertas_agronomicos o WHERE o.registro_origem_id=v_reg.id
        AND o.id<>p_alerta_id AND o.status::text<>'encerrado') THEN
      RAISE EXCEPTION 'multiple_alerts_share_visit' USING ERRCODE='PT409';
    END IF;
    v_obs := coalesce(v_reg.observacoes_tecnicas,'');
    IF (length(v_obs)-length(replace(v_obs,'[PLANO DE MONITORAMENTO]','')))/length('[PLANO DE MONITORAMENTO]')>1
      OR (length(v_obs)-length(replace(v_obs,'[FIM DO PLANO]','')))/length('[FIM DO PLANO]')>1
      OR (position('[PLANO DE MONITORAMENTO]' in v_obs)>0)<>(position('[FIM DO PLANO]' in v_obs)>0)
      OR (position('[FIM DO PLANO]' in v_obs)>0 AND position('[FIM DO PLANO]' in v_obs)<position('[PLANO DE MONITORAMENTO]' in v_obs)) THEN
      RAISE EXCEPTION 'ambiguous_plan_text' USING ERRCODE='PT409';
    END IF;
    v_block := substring(v_obs from '\[PLANO DE MONITORAMENTO\].*?\[FIM DO PLANO\]');
    IF v_block IS NOT NULL THEN
      -- Only the date line changes; every other byte of notes and plan is preserved.
      IF (SELECT count(*) FROM regexp_matches(v_block,'(^|\n)Próxima Avaliação: [^\n]*','g'))<>1 THEN
        RAISE EXCEPTION 'ambiguous_plan_text' USING ERRCODE='PT409';
      END IF;
      v_new_block := regexp_replace(v_block,'(^|\n)Próxima Avaliação: [^\n]*','\1Próxima Avaliação: '||p_nova_data::text);
      v_obs := overlay(v_obs placing v_new_block from position(v_block in v_obs) for length(v_block));
      -- Exactly one coherent generic notice; never fabricate one.
      IF (SELECT count(*) FROM public.monitoramento_avisos WHERE registro_consultor_id=v_reg.id AND tipo='plano_monitoramento')<>1
        OR v_block !~ ('(^|\n)Próxima Avaliação: '||coalesce(v_reg.data_proxima_visita::text,'<none>')||'(\n|$)') THEN
        RAISE EXCEPTION 'plan_notice_incoherent' USING ERRCODE='PT409';
      END IF;
      SELECT id INTO v_notice FROM public.monitoramento_avisos
       WHERE registro_consultor_id=v_reg.id AND tipo='plano_monitoramento'
         AND data_referencia IS NOT DISTINCT FROM v_reg.data_proxima_visita FOR UPDATE;
      IF v_notice IS NULL THEN RAISE EXCEPTION 'plan_notice_incoherent' USING ERRCODE='PT409'; END IF;
      INSERT INTO platform_private.visit_plan_write_tickets(transaction_id,registro_id,block,next_date)
        VALUES(txid_current(),v_reg.id,v_new_block,p_nova_data);
    ELSIF EXISTS(SELECT 1 FROM public.monitoramento_avisos WHERE registro_consultor_id=v_reg.id AND tipo='plano_monitoramento') THEN
      RAISE EXCEPTION 'plan_notice_incoherent' USING ERRCODE='PT409';
    END IF;
    UPDATE public.registros_consultor
       SET observacoes_tecnicas=CASE WHEN v_block IS NULL THEN observacoes_tecnicas ELSE v_obs END,
           data_proxima_visita=p_nova_data, version=p_expected_visit_version+1, updated_at=clock_timestamp()
     WHERE id=v_reg.id AND version=p_expected_visit_version
       AND public.can_manage_technical_visit(v_uid,id)
     RETURNING version INTO v_version;
    IF NOT FOUND OR v_version<>p_expected_visit_version+1 THEN RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409'; END IF;
    IF v_notice IS NOT NULL THEN
      UPDATE public.monitoramento_avisos SET data_referencia=p_nova_data WHERE id=v_notice AND registro_consultor_id=v_reg.id;
      IF NOT FOUND THEN RAISE EXCEPTION 'notice_conflict' USING ERRCODE='PT409'; END IF;
    END IF;
    DELETE FROM platform_private.visit_plan_write_tickets WHERE transaction_id=txid_current() AND registro_id=v_reg.id;
    v_visit_updated := true;
    v_mode := CASE WHEN v_block IS NULL THEN 'visita_alerta' ELSE 'plano_visita_aviso_alerta' END;
  ELSIF v_alerta.registro_origem_id IS NOT NULL THEN
    -- Immutable visit: explicit alert-only mode; the visit/plan is NOT synchronized.
    v_version := v_reg.version;
  END IF;
  UPDATE public.alertas_agronomicos
     SET data_vencimento=p_nova_data, nivel_risco='medio'::public.nivel_risco,
         updated_at=greatest(clock_timestamp(),v_alerta.updated_at+interval '1 microsecond')
   WHERE id=p_alerta_id AND updated_at=p_expected_alert_updated_at
   RETURNING updated_at INTO v_updated;
  IF NOT FOUND THEN RAISE EXCEPTION 'concurrent_update' USING ERRCODE='PT409'; END IF;
  v_receipt := jsonb_build_object('success',true,'alerta_id',p_alerta_id,'data_anterior',v_alerta.data_vencimento,
    'nova_data',p_nova_data,'registro_origem_id',v_alerta.registro_origem_id,'visita_atualizada',v_visit_updated,'modo',v_mode,
    'visit_version',v_version,'alerta_updated_at',v_updated,'request_id',p_request_id);
  IF v_alerta.registro_origem_id IS NOT NULL THEN
    INSERT INTO public.visitas_logs(registro_consultor_id,usuario_id,acao,descricao,metadata)
      VALUES(v_alerta.registro_origem_id,v_uid,'monitoramento_reprogramado','Monitoramento reprogramado pelo alerta de origem',
        jsonb_build_object('request_id',p_request_id,'alerta_id',p_alerta_id,'fingerprint',v_fp,'modo',v_mode));
  END IF;
  INSERT INTO platform_private.monitoring_alert_receipts VALUES(v_uid,p_alerta_id,p_request_id,'reschedule',v_fp,v_receipt);
  RETURN v_receipt;
END;
$function$;

CREATE FUNCTION platform_private.list_linkable_alerts_core(p_registro_id uuid)
RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $function$
DECLARE v_uid uuid := auth.uid(); v_reg public.registros_consultor;
BEGIN
  IF NOT coalesce(public.technical_actor_ready(v_uid),false)
    OR NOT coalesce(public.can_manage_technical_visit(v_uid,p_registro_id),false) THEN
    RAISE EXCEPTION 'monitoring_unavailable' USING ERRCODE='PT404';
  END IF;
  SELECT * INTO v_reg FROM public.registros_consultor WHERE id=p_registro_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'monitoring_unavailable' USING ERRCODE='PT404'; END IF;
  RETURN coalesce((SELECT jsonb_agg(jsonb_build_object('id',a.id,'tipo_alerta',a.tipo_alerta,'nivel_risco',a.nivel_risco,
      'status',a.status,'data_vencimento',a.data_vencimento,'updated_at',a.updated_at,'descricao',a.descricao,
      'registro_origem_id',a.registro_origem_id) ORDER BY a.created_at DESC)
    FROM public.alertas_agronomicos a
    WHERE a.fazenda_id=v_reg.fazenda_id
      AND (a.talhao_id IS NULL OR a.talhao_id IS NOT DISTINCT FROM v_reg.talhao_id)
      AND a.status::text IN ('ativo','monitoramento')
      AND (a.registro_origem_id IS NULL OR a.registro_origem_id=p_registro_id)
      AND platform_private.monitoring_refs_in_actor_tenant(a.fazenda_id,a.talhao_id,p_registro_id)),'[]'::jsonb);
END;
$function$;

REVOKE ALL ON FUNCTION platform_private.link_alert_origin_core(uuid,uuid,timestamptz,integer,uuid) FROM PUBLIC,anon;
REVOKE ALL ON FUNCTION platform_private.reschedule_monitoring_core(uuid,date,timestamptz,integer,uuid) FROM PUBLIC,anon;
REVOKE ALL ON FUNCTION platform_private.list_linkable_alerts_core(uuid) FROM PUBLIC,anon;
GRANT EXECUTE ON FUNCTION platform_private.link_alert_origin_core(uuid,uuid,timestamptz,integer,uuid) TO authenticated,service_role;
GRANT EXECUTE ON FUNCTION platform_private.reschedule_monitoring_core(uuid,date,timestamptz,integer,uuid) TO authenticated,service_role;
GRANT EXECUTE ON FUNCTION platform_private.list_linkable_alerts_core(uuid) TO authenticated,service_role;

CREATE FUNCTION public.rpc_vincular_origem_alerta_v1(p_alerta_id uuid,p_registro_id uuid,p_expected_alert_updated_at timestamptz,p_expected_visit_version integer,p_request_id uuid)
RETURNS jsonb LANGUAGE sql SECURITY INVOKER SET search_path='' AS $f$
  SELECT platform_private.link_alert_origin_core(p_alerta_id,p_registro_id,p_expected_alert_updated_at,p_expected_visit_version,p_request_id);
$f$;
CREATE FUNCTION public.rpc_reprogramar_monitoramento_v2(p_alerta_id uuid,p_nova_data date,p_expected_alert_updated_at timestamptz,p_expected_visit_version integer,p_request_id uuid)
RETURNS jsonb LANGUAGE sql SECURITY INVOKER SET search_path='' AS $f$
  SELECT platform_private.reschedule_monitoring_core(p_alerta_id,p_nova_data,p_expected_alert_updated_at,p_expected_visit_version,p_request_id);
$f$;
CREATE FUNCTION public.rpc_listar_alertas_vinculaveis_v1(p_registro_id uuid)
RETURNS jsonb LANGUAGE sql STABLE SECURITY INVOKER SET search_path='' AS $f$
  SELECT platform_private.list_linkable_alerts_core(p_registro_id);
$f$;
REVOKE ALL ON FUNCTION public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid) FROM PUBLIC,anon;
REVOKE ALL ON FUNCTION public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid) FROM PUBLIC,anon;
REVOKE ALL ON FUNCTION public.rpc_listar_alertas_vinculaveis_v1(uuid) FROM PUBLIC,anon;
GRANT EXECUTE ON FUNCTION public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid) TO authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid) TO authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.rpc_listar_alertas_vinculaveis_v1(uuid) TO authenticated,service_role;

-- Plan writer: once an open alert is linked, the plan date is owned by the alert reschedule flow.
-- Content edits with the same date stay allowed; a different date fails atomically (no silent divergence).
DO $plan$
DECLARE
  d text := pg_get_functiondef('platform_private.save_visit_monitoring_plan_core(uuid,integer,jsonb,uuid)'::regprocedure);
  needle text := '  IF (SELECT count(*) FROM public.monitoramento_avisos WHERE registro_consultor_id=p_registro_id AND tipo=''plano_monitoramento'')>1 THEN';
BEGIN
  IF (length(d)-length(replace(d,needle,'')))/length(needle)<>1 THEN
    RAISE EXCEPTION 'plan_core_patch_mismatch' USING ERRCODE='55000';
  END IF;
  EXECUTE replace(d,needle,'  IF EXISTS(SELECT 1 FROM public.alertas_agronomicos o WHERE o.registro_origem_id=p_registro_id AND o.status::text<>''encerrado'')
    AND v_date IS DISTINCT FROM v_reg.data_proxima_visita THEN
    RAISE EXCEPTION ''linked_alert_date_requires_reschedule'' USING ERRCODE=''PT409'';
  END IF;
'||needle);
END;
$plan$;

-- Old v1 callers: alerts WITH origin fail safely (PT428) before any write; no-origin path unchanged.
-- CREATE OR REPLACE keeps OID/owner/ACL.
DO $patch$
DECLARE
  d text := pg_get_functiondef('public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz)'::regprocedure);
  needle text := '  IF v_alerta.status IS DISTINCT FROM ''monitoramento''::public.status_alerta THEN';
BEGIN
  IF (length(d)-length(replace(d,needle,'')))/length(needle)<>1 THEN
    RAISE EXCEPTION 'v1_patch_mismatch' USING ERRCODE='55000';
  END IF;
  EXECUTE replace(d,needle,'  IF v_alerta.registro_origem_id IS NOT NULL THEN
    RAISE EXCEPTION ''monitoring_reschedule_requires_current_client'' USING ERRCODE=''PT428'';
  END IF;
'||needle);
END;
$patch$;

DO $post$
BEGIN
  IF has_table_privilege('authenticated','platform_private.monitoring_alert_receipts','SELECT')
    OR has_table_privilege('authenticated','platform_private.monitoring_alert_receipts','INSERT')
    OR has_function_privilege('anon','public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid)','EXECUTE')
    OR has_function_privilege('anon','public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid)','EXECUTE')
    OR has_function_privilege('anon','public.rpc_listar_alertas_vinculaveis_v1(uuid)','EXECUTE')
    OR has_function_privilege('anon','public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz)','EXECUTE')
    OR position('monitoring_reschedule_requires_current_client' in pg_get_functiondef('public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz)'::regprocedure))=0
    OR position('linked_alert_date_requires_reschedule' in pg_get_functiondef('platform_private.save_visit_monitoring_plan_core(uuid,integer,jsonb,uuid)'::regprocedure))=0
    OR position('visit_plan_write_tickets' in pg_get_functiondef('platform_private.save_visit_monitoring_plan_core(uuid,integer,jsonb,uuid)'::regprocedure))=0
    OR md5(pg_get_functiondef('platform_private.guard_visit_plan_preservation()'::regprocedure))<>'618797b75f8c6b962dc70c0841c84de1' THEN
    RAISE EXCEPTION 'agronomic_origin_postflight_failed' USING ERRCODE='55000';
  END IF;
END;
$post$;
COMMIT;
