+-- Plan writer: once an open alert is linked, the plan date is owned by the alert reschedule flow.
+-- Content edits with the same date stay allowed; a different date fails atomically (no silent divergence).
+DO $plan$
+DECLARE
+  d text := pg_get_functiondef('platform_private.save_visit_monitoring_plan_core(uuid,integer,jsonb,uuid)'::regprocedure);
+  needle text := '  IF (SELECT count(*) FROM public.monitoramento_avisos WHERE registro_consultor_id=p_registro_id AND tipo=''plano_monitoramento'')>1 THEN';
+BEGIN
+  IF (length(d)-length(replace(d,needle,'')))/length(needle)<>1 THEN
+    RAISE EXCEPTION 'plan_core_patch_mismatch' USING ERRCODE='55000';
+  END IF;
+  EXECUTE replace(d,needle,'  IF EXISTS(SELECT 1 FROM public.alertas_agronomicos o WHERE o.registro_origem_id=p_registro_id AND o.status::text<>''encerrado'')
+    AND v_date IS DISTINCT FROM v_reg.data_proxima_visita THEN
+    RAISE EXCEPTION ''linked_alert_date_requires_reschedule'' USING ERRCODE=''PT409'';
+  END IF;
+'||needle);
+END;
+$plan$;
