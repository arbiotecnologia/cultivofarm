-- INACTIVE. Deny-only containment: closes new entry points, keeps receipts, logs, guard and data.
-- Keeps the plan-writer date lock and the v1 PT428 patch: removing either reopens silent divergence.
-- Does NOT restore the pre-patch v1 (that would reopen the guarded legacy write path).
BEGIN;
SET LOCAL lock_timeout='5s';
REVOKE EXECUTE ON FUNCTION public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid) FROM authenticated;
REVOKE EXECUTE ON FUNCTION public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid) FROM authenticated;
REVOKE EXECUTE ON FUNCTION public.rpc_listar_alertas_vinculaveis_v1(uuid) FROM authenticated;
REVOKE EXECUTE ON FUNCTION platform_private.reschedule_monitoring_core(uuid,date,timestamptz,integer,uuid) FROM authenticated;
REVOKE EXECUTE ON FUNCTION platform_private.link_alert_origin_core(uuid,uuid,timestamptz,integer,uuid) FROM authenticated;
REVOKE EXECUTE ON FUNCTION platform_private.list_linkable_alerts_core(uuid) FROM authenticated;
DO $c$ BEGIN
  IF has_function_privilege('authenticated','platform_private.reschedule_monitoring_core(uuid,date,timestamptz,integer,uuid)','EXECUTE')
    OR has_function_privilege('authenticated','platform_private.link_alert_origin_core(uuid,uuid,timestamptz,integer,uuid)','EXECUTE')
    OR NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgname='trg_visit_plan_preservation' AND tgenabled='O') THEN
    RAISE EXCEPTION 'containment_failed' USING ERRCODE='55000';
  END IF;
END $c$;
COMMIT;
