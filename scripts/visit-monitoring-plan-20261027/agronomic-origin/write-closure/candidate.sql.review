$pre$;

CREATE TEMP TABLE monitoring_closure_baseline ON COMMIT DROP AS
SELECT oid,prosrc,proacl,proowner,prosecdef,proconfig FROM pg_proc WHERE oid IN (
 'public.rpc_criar_alerta_climatico_v1(uuid,uuid,public.tipo_alerta,public.nivel_risco,text)'::regprocedure,
 'public.rpc_atualizar_status_alerta_agronomico_v1(uuid,public.status_alerta,timestamptz)'::regprocedure,
 'public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz)'::regprocedure);
CREATE POLICY monitoring_authenticated_insert_closed ON public.alertas_agronomicos AS RESTRICTIVE FOR INSERT TO authenticated WITH CHECK(false);
CREATE POLICY monitoring_authenticated_update_closed ON public.alertas_agronomicos AS RESTRICTIVE FOR UPDATE TO authenticated USING(false) WITH CHECK(false);
CREATE POLICY monitoring_authenticated_delete_closed ON public.alertas_agronomicos AS RESTRICTIVE FOR DELETE TO authenticated USING(false);
-- Necessary: LIVE legacy functions have no bounded wait; gate/advisory/row waits can otherwise be unbounded.
ALTER FUNCTION public.rpc_criar_alerta_climatico_v1(uuid,uuid,public.tipo_alerta,public.nivel_risco,text) SET lock_timeout='3s';
ALTER FUNCTION public.rpc_atualizar_status_alerta_agronomico_v1(uuid,public.status_alerta,timestamptz) SET lock_timeout='3s';
ALTER FUNCTION public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz) SET lock_timeout='3s';
DO $metadata$
BEGIN
 IF (SELECT count(*) FROM monitoring_closure_baseline)<>3 OR EXISTS(
 SELECT 1 FROM monitoring_closure_baseline b LEFT JOIN pg_proc p ON p.oid=b.oid WHERE p.oid IS NULL
 OR ROW(p.prosrc,p.proacl,p.proowner,p.prosecdef) IS DISTINCT FROM ROW(b.prosrc,b.proacl,b.proowner,b.prosecdef)
 OR p.proconfig IS DISTINCT FROM array_append(b.proconfig,'lock_timeout=3s')) THEN
 RAISE EXCEPTION 'write_closure_metadata_changed' USING ERRCODE='55000'; END IF;
END;
$metadata$;
-- Read-only; failure means NO-GO. Tenant/SELECT fingerprint excludes ONLY the 3 new policies.
