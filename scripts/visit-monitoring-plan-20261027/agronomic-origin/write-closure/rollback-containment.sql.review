-- Containment only: DO NOT drop policies, restore direct writes, remove guards or reset timeouts.
BEGIN;
SET LOCAL lock_timeout='3s'; SET LOCAL statement_timeout='15s';
DO $contain$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_class WHERE oid='public.alertas_agronomicos'::regclass AND relrowsecurity)
 THEN RAISE EXCEPTION 'containment_requires_rls' USING ERRCODE='55000'; END IF;
END; $contain$;
-- Stronger deny, including grants inherited through another role. SELECT/service_role are unchanged.
REVOKE INSERT,UPDATE,DELETE ON public.alertas_agronomicos FROM authenticated,anon;
REVOKE EXECUTE ON FUNCTION public.rpc_criar_alerta_climatico_v1(uuid,uuid,public.tipo_alerta,public.nivel_risco,text) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION public.rpc_atualizar_status_alerta_agronomico_v1(uuid,public.status_alerta,timestamptz) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION public.rpc_reprogramar_monitoramento_v1(uuid,date,timestamptz) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION public.rpc_reprogramar_monitoramento_v2(uuid,date,timestamptz,integer,uuid) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION public.rpc_vincular_origem_alerta_v1(uuid,uuid,timestamptz,integer,uuid) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION platform_private.reschedule_monitoring_core(uuid,date,timestamptz,integer,uuid) FROM authenticated,anon,PUBLIC;
REVOKE EXECUTE ON FUNCTION platform_private.link_alert_origin_core(uuid,uuid,timestamptz,integer,uuid) FROM authenticated,anon,PUBLIC;
DO $verify$ BEGIN
 IF has_table_privilege('authenticated','public.alertas_agronomicos','INSERT,UPDATE,DELETE')
 OR has_table_privilege('anon','public.alertas_agronomicos','INSERT,UPDATE,DELETE')
 OR NOT has_table_privilege('service_role','public.alertas_agronomicos','UPDATE')
 THEN RAISE EXCEPTION 'containment_privilege_failed' USING ERRCODE='55000'; END IF;
END; $verify$;
COMMIT;
