+  fireEvent.change(input, { target: { value: "2026-11-07" } }); fireEvent.click(screen.getByRole("button", { name: "Salvar Alterações" }));
+  await waitFor(() => expect(screen.queryByRole("dialog")).toBeNull()); await settle(); await elapse();
