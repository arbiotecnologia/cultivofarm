BEGIN;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='120s';
DO $weather_pre$
BEGIN
 IF EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('public','platform_private') AND p.proname IN ('weather_sync_context_v1','weather_sync_apply_v1')) THEN RAISE EXCEPTION 'weather_function_collision'; END IF;
 IF EXISTS(SELECT 1 FROM pg_policy WHERE polrelid='public.clima_dados'::regclass AND polname LIKE 'climate_tenant_write_%_v1') THEN RAISE EXCEPTION 'weather_policy_collision'; END IF;
 IF md5(pg_get_functiondef('public.h15_actor_organization()'::regprocedure))<>'55edafec08bcc84a00f1526c14334a2c' OR md5(pg_get_functiondef('platform_private.h15_actor_organization()'::regprocedure))<>'64e10608403238a41a9baf92857ca881' OR md5(pg_get_functiondef('public.has_role(uuid,public.app_role)'::regprocedure))<>'4d90e93d521a4819d9085f28d742030f' OR md5(pg_get_functiondef('public._saas_user_has_feature(uuid,text)'::regprocedure))<>'501dd958e117d2df8a4d38f6bcbeed04' OR md5(pg_get_functiondef('public.can_user_access_fazenda(uuid)'::regprocedure))<>'8c8d0dfd80fa05e0be30cc5ed95bb400' THEN RAISE EXCEPTION 'weather_dependency_drift'; END IF;
 IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='public.clima_dados'::regclass) THEN RAISE EXCEPTION 'weather_rls_not_enabled'; END IF;
END $weather_pre$;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='60s';
-- Execute na mesma transacao da publicacao; aborta se a base mudou.
DO $preflight$
BEGIN
IF (select md5(pg_get_functiondef('platform_private.tenant_catalog_ref_owner(text,uuid)'::regprocedure))) IS DISTINCT FROM '9e2a23293124f7953b2d9b63d46a1890' THEN RAISE EXCEPTION 'baseline_changed: tenant_catalog_ref_owner'; END IF;
IF (select md5(pg_get_functiondef('public.tenant_catalog_root_delete(text,uuid,timestamp with time zone,uuid)'::regprocedure))) IS DISTINCT FROM 'df00f52431d468eb518217c118a2f327' THEN RAISE EXCEPTION 'baseline_changed: tenant_catalog_root_delete'; END IF;
IF (select md5(pg_get_functiondef('public.tenant_catalog_root_save(text,uuid,jsonb,timestamp with time zone,uuid)'::regprocedure))) IS DISTINCT FROM 'ae4d6655682def0fa68a15ba844dd6b3' THEN RAISE EXCEPTION 'baseline_changed: tenant_catalog_root_save'; END IF;
IF (select md5(pg_get_functiondef('public.tenant_microorganism_ficha_save_v1(uuid,timestamp with time zone,timestamp with time zone,jsonb,jsonb,uuid)'::regprocedure))) IS DISTINCT FROM 'a33d571cf0ad6ff17e7ae3b4538a5184' THEN RAISE EXCEPTION 'baseline_changed: tenant_microorganism_ficha_save_v1'; END IF;
END $preflight$;



DO $schema_guard$ BEGIN IF (select jsonb_build_object('cfg',(select jsonb_agg(to_jsonb(x) order by root) from platform_private.tenant_catalog_root_cfg x),'columns',(select jsonb_agg(jsonb_build_object('table',c.relname,'column',a.attname,'type',format_type(a.atttypid,a.atttypmod),'default',pg_get_expr(d.adbin,d.adrelid),'notnull',a.attnotnull) order by c.relname,a.attnum) from pg_attribute a join pg_class c on c.oid=a.attrelid join pg_namespace n on n.oid=c.relnamespace left join pg_attrdef d on d.adrelid=c.oid and d.adnum=a.attnum where n.nspname='public' and c.relname in ('microrganismos','culturas','catalogo_volumes','catalogo_alvos','product_technical_profiles','microorganism_technical_profiles','microorganism_crop_recommendations','microorganism_targets','catalog_technical_sources') and a.attnum>0 and not a.attisdropped))) IS DISTINCT FROM $metadata${"cfg":[{"kind":"root","refs":{},"root":"catalogo_alvos","allowed":["nome","tipo","nome_cientifico","descricao","sinonimos","ativo"],"parent_col":"","parent_tbl":"","safe_defaults":{}},{"kind":"root","refs":{"produto_id":"produtos","microrganismo_id":"microrganismos"},"root":"catalogo_volumes","allowed":["item_tipo","produto_id","microrganismo_id","volume_ml","rotulo","preco_brl","moeda","ativo","ordem","preco_litro_brl","valor_dose_100ml_brl","doses_por_volume"],"parent_col":"","parent_tbl":"","safe_defaults":{}},{"kind":"root","refs":{},"root":"culturas","allowed":["nome","descricao","ativo"],"parent_col":"","parent_tbl":"","safe_defaults":{}},{"kind":"profile","refs":{"microrganismo_id":"microrganismos"},"root":"microorganism_technical_profiles","allowed":["microrganismo_id","resumo_curto","mecanismo_acao","beneficios_agronomicos","explicacao_tecnica","explicacao_produtor","explicacao_b2b","indicacoes_uso","cuidados_aplicacao","compatibilidade","armazenamento","observacoes_regulatorias"],"parent_col":"microrganismo_id","parent_tbl":"microrganismos","safe_defaults":{}},{"kind":"root","refs":{"product_id":"produtos