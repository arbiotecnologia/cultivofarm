SELECT CASE WHEN p_payload ? 'item_tipo' THEN r."item_tipo" ELSE NULL END,
CASE WHEN p_payload ? 'produto_id' THEN r."produto_id" ELSE NULL END,
CASE WHEN p_payload ? 'microrganismo_id' THEN r."microrganismo_id" ELSE NULL END,
CASE WHEN p_payload ? 'volume_ml' THEN r."volume_ml" ELSE NULL END,
CASE WHEN p_payload ? 'rotulo' THEN r."rotulo" ELSE NULL END,
CASE WHEN p_payload ? 'preco_brl' THEN r."preco_brl" ELSE 0 END,
CASE WHEN p_payload ? 'moeda' THEN r."moeda" ELSE 'BRL'::text END,
CASE WHEN p_payload ? 'ativo' THEN r."ativo" ELSE true END,
CASE WHEN p_payload ? 'ordem' THEN r."ordem" ELSE 0 END,
CASE WHEN p_payload ? 'preco_litro_brl' THEN r."preco_litro_brl" ELSE NULL END,
CASE WHEN p_payload ? 'valor_dose_100ml_brl' THEN r."valor_dose_100ml_brl" ELSE NULL END,
CASE WHEN p_payload ? 'doses_por_volume' THEN r."doses_por_volume" ELSE NULL END,
CASE WHEN p_payload ? 'owner_organization_id' THEN r."owner_organization_id" ELSE NULL END
FROM jsonb_populate_record(NULL::public."catalogo_volumes",p_payload) r RETURNING to_jsonb("catalogo_volumes".*) INTO v_row;
WHEN 'product_technical_profiles' THEN
INSERT INTO public."product_technical_profiles" ("produto_id", "resumo_curto", "beneficio_combinado", "explicacao_tecnica", "explicacao_produtor", "explicacao_b2b", "indicacoes_uso", "janela_aplicacao", "cuidados_aplicacao", "compatibilidade", "observacoes_regulatorias")
SELECT CASE WHEN p_payload ? 'produto_id' THEN r."produto_id" ELSE NULL END,
CASE WHEN p_payload ? 'resumo_curto' THEN r."resumo_curto" ELSE NULL END,
CASE WHEN p_payload ? 'beneficio_combinado' THEN r."beneficio_combinado" ELSE NULL END,
CASE WHEN p_payload ? 'explicacao_tecnica' THEN r."explicacao_tecnica" ELSE NULL END,
CASE WHEN p_payload ? 'explicacao_produtor' THEN r."explicacao_produtor" ELSE NULL END,
CASE WHEN p_payload ? 'explicacao_b2b' THEN r."explicacao_b2b" ELSE NULL END,
CASE WHEN p_payload ? 'indicacoes_uso' THEN r."indicacoes_uso" ELSE NULL END,
