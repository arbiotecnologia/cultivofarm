type":"numeric(10,2)","table":"microrganismos","column":"valor_dose_brl","default":null,"notnull":false},{"type":"text","table":"microrganismos","column":"fornecedor","default":"'A.R Biotecnologia'::text","notnull":false},{"type":"text","table":"microrganismos","column":"safra_referencia","default":"'2025'::text","notnull":false},{"type":"boolean","table":"microrganismos","column":"producao_on_farm","default":"true","notnull":false},{"type":"text","table":"microrganismos","column":"meio_cultivo","default":null,"notnull":false},{"type":"text","table":"microrganismos","column":"funcao_agronomica","default":null,"notnull":false},{"type":"text","table":"microrganismos","column":"observacoes","default":null,"notnull":false},{"type":"boolean","table":"microrganismos","column":"ativo","default":"true","notnull":true},{"type":"boolean","table":"microrganismos","column":"b2b_enabled","default":"false","notnull":true},{"type":"text","table":"microrganismos","column":"codigo","default":null,"notnull":false},{"type":"text","table":"microrganismos","column":"descricao","default":null,"notnull":false},{"type":"numeric(12,2)","table":"microrganismos","column":"preco_tabela","default":null,"notnull":false},{"type":"numeric","table":"microrganismos","column":"valor_litro_brl","default":null,"notnull":false},{"type":"uuid","table":"microrganismos","column":"product_id","default":null,"notnull":false},{"type":"timestamp with time zone","table":"microrganismos","column":"updated_at","default":"now()","notnull":true},{"type":"uuid","table":"microrganismos","column":"owner_organization_id","default":"platform_private.tenant_catalog_mutate_org()","notnull":true},{"type":"uuid","table":"product_technical_profiles","column":"id","default":"gen_random_uuid()","notnull":true},{"type":"uuid","table":"product_technical_profiles","column":"produto_id","default":null,"notnull":true},{"type":"text","table":"product_technical_profiles","column":"resumo_curto","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"beneficio_combinado","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"explicacao_tecnica","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"explicacao_produtor","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"explicacao_b2b","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"indicacoes_uso","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"janela_aplicacao","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"cuidados_aplicacao","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"compatibilidade","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"observacoes_regulatorias","default":null,"notnull":false},{"type":"text","table":"product_technical_profiles","column":"status_validacao","default":"'rascunho'::text","notnull":true},{"type":"uuid","table":"product_technical_profiles","column":"validado_por","default":null,"notnull":false},{"type":"timestamp with time zone","table":"product_technical_profiles","column":"validado_em","default":null,"notnull":false},{"type":"uuid","table":"product_technical_profiles","column":"created_by","default":null,"notnull":false},{"type":"uuid","table":"product_technical_profiles","column":"updated_by","default":null,"notnull":false},{"type":"timestamp with time zone","table":"product_technical_profiles","column":"created_at","default":"now()","notnull":true},{"type":"timestamp with time zone","table":"product_technical_profiles","column":"updated_at","default":"now()","notnull":true}]}$metadata$::jsonb THEN RAISE EXCEPTION 'catalog_schema_changed'; END IF; END $schema_guard$;
CREATE OR REPLACE FUNCTION public.tenant_catalog_root_delete(p_root text, p_id uuid, p_expected_updated_at timestamp with time zone, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_hash text; v_rep jsonb; v_prev jsonb; v_row jsonb;
BEGIN
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  v_org := platform_private.recorte_a_actor_fresh('mutate');
  IF p_root IS NULL OR p_root NOT IN ('microrganismos','culturas','catalogo_volumes') THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_id IS NULL OR p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', 'delete', p_root, p_id::text, p_expected_updated_at::text));
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  CASE p_root
WHEN 'microrganismos' THEN
SELECT to_jsonb(x.*) INTO v_prev FROM public."microrganismos" x WHERE x.id=p_id FOR UPDATE;
WHEN 'culturas' THEN
SELECT to_jsonb(x.*) INTO v_prev FROM public."culturas" x WHERE x.id=p_id FOR UPDATE;
WHEN 'catalogo_volumes' THEN
SELECT to_jsonb(x.*) INTO v_prev FROM public."catalogo_volumes" x WHERE x.id=p_id FOR UPDATE;
ELSE RAISE EXCEPTION 'catalog_static_target_invalid' USING ERRCODE='22023';
END CASE;
  IF v_prev IS NULL OR (v_prev->>'owner_organization_id')::uuid IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_not_found' USING ERRCODE='P0002'; END IF;
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF (v_prev->>'updated_at')::timestamptz IS DISTINCT FROM p_expected_updated_at THEN RAISE EXCEPTION 'tenant_catalog_stale' USING ERRCODE='PT409'; END IF;
  BEGIN
    CASE p_root
WHEN 'microrganismos' THEN
DELETE FROM public."microrganismos" WHERE id=p_id;
WHEN 'culturas' THEN
DELETE FROM public."culturas" WHERE id=p_id;
WHEN 'catalogo_volumes' THEN
DELETE FROM public."catalogo_volumes" WHERE id=p_id;
ELSE RAISE EXCEPTION 'catalog_static_target_invalid' USING ERRCODE='22023';
END CASE;
  EXCEPTION WHEN foreign_key_violation THEN RAISE EXCEPTION 'tenant_catalog_in_use' USING ERRCODE='PT409';
  END;
  v_row := jsonb_build_object('ok', true, 'root', p_root, 'id', p_id, 'deleted', true, 'organization_id', v_org, 'replayed', false);
  INSERT INTO platform_private.tenant_catalog_root_receipts VALUES (v_uid, v_org, p_idempotency_key, v_hash, v_row);
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  RETURN v_row;
END $function$
;

CREATE OR REPLACE FUNCTION public.tenant_catalog_root_save(p_root text, p_id uuid, p_payload jsonb, p_expected_updated_at timestamp with time zone, p_idempotency_key uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE v_uid uuid := auth.uid(); v_org uuid; v_org2 uuid; v_cfg platform_private.tenant_catalog_root_cfg%ROWTYPE;
  v_children jsonb; v_evidence jsonb; v_product uuid; v_source jsonb; v_item jsonb; v_value text; v_enabled boolean; v_seen text[] := ARRAY[]::text[]; v_product_name text;
  k text; v_hash text; v_rep jsonb; v_cols text[] := '{}'; v_row jsonb; v_prev jsonb; v_parent uuid; v_ref uuid; v_ts timestamptz;
BEGIN
  IF p_root IS NULL THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF v_uid IS NULL THEN RAISE EXCEPTION 'unauthenticated' USING ERRCODE='28000'; END IF;
  IF p_root = 'product_technical_profiles' THEN v_org := platform_private.recorte_a_actor_fresh('mutate'); ELSE v_org := platform_private.recorte_a_actor_fresh('mutate'); END IF;
  v_children := p_payload->'product_relations';
   v_evidence := p_payload->'documentary_evidence';
   IF v_children IS NOT NULL OR v_evidence IS NOT NULL THEN
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   END IF;
   IF v_children IS NOT NULL THEN
     IF p_root <> 'product_technical_profiles' THEN RAISE EXCEPTION 'product_relations_root_denied' USING ERRCODE='22023'; END IF;
     SELECT enabled INTO v_enabled FROM platform_private.product_evidence_gate_v1 WHERE singleton FOR SHARE;
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
     IF v_enabled IS DISTINCT FROM true THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
     p_payload := p_payload-'product_relations';
   END IF;
   IF v_evidence IS NOT NULL THEN
     IF p_root <> 'product_technical_profiles' THEN RAISE EXCEPTION 'product_evidence_root_denied' USING ERRCODE='22023'; END IF;
     SELECT enabled INTO v_enabled FROM platform_private.product_evidence_gate_v1 WHERE singleton FOR SHARE;
     IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
     IF v_enabled IS DISTINCT FROM true THEN RAISE EXCEPTION 'product_evidence_closed' USING ERRCODE='42501'; END IF;
     IF jsonb_typeof(v_evidence) IS DISTINCT FROM 'array' OR jsonb_array_length(v_evidence)>40 OR octet_length(v_evidence::text)>300000 THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
     FOR v_item IN SELECT value FROM jsonb_array_elements(v_evidence) LOOP
       IF jsonb_typeof(v_item) IS DISTINCT FROM 'object' OR (v_item-ARRAY['field','value','identity','sources','candidate_key'])<>'{}' OR jsonb_typeof(v_item->'candidate_key') IS DISTINCT FROM 'string' OR length(v_item->>'candidate_key') NOT BETWEEN 1 AND 200 OR NOT coalesce(v_item->>'field','')=ANY(ARRAY['resumo_curto','explicacao_tecnica','explicacao_produtor','explicacao_b2b','indicacoes_uso','janela_aplicacao','cuidados_aplicacao','compatibilidade','beneficio_combinado']) OR jsonb_typeof(v_item->'value') IS DISTINCT FROM 'string' OR length(v_item->>'value') NOT BETWEEN 1 AND 12000 OR jsonb_typeof(v_item->'identity') IS DISTINCT FROM 'object' OR jsonb_typeof(v_item->'sources') IS DISTINCT FROM 'array' THEN RAISE EXCEPTION 'product_evidence_shape' USING ERRCODE='22023'; END IF;
       IF ((v_item->'identity')-ARRAY['entity','id','name','manufacturer','registration','scientificName','strain','purpose','synonyms','concentration','presentation','researchScope'])<>'{}'
         OR v_item->'identity'->>'entity' IS DISTINCT FROM 'produto'
         OR jsonb_typeof(v_item->'identity'->'id') IS DISTINCT FROM 'string'
         OR (v_item->'identity'->>'id') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
         OR jsonb_typeof(v_item->'identity'->'name') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'name') NOT BETWEEN 1 AND 1000
         OR jsonb_typeof(v_item->'identity'->'manufacturer') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'manufacturer')>1000
         OR jsonb_typeof(v_item->'identity'->'registration') IS DISTINCT FROM 'string' OR length(v_item->'identity'->>'registration')>1000
         OR jsonb_array_length(v_item->'sources') NOT BETWEEN 1 AND 20 THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       FOR k IN SELECT jsonb_object_keys(v_item->'identity') LOOP
         IF k=ANY(ARRAY['scientificName','strain','purpose','synonyms','concentration','presentation']) AND (jsonb_typeof(v_item->'identity'->k) IS DISTINCT FROM 'string' OR length(v_item->'identity'->>k)>2000) THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       END LOOP;
       IF v_item->'identity' ? 'researchScope' AND (jsonb_typeof(v_item->'identity'->'researchScope') IS DISTINCT FROM 'string' OR NOT (v_item->'identity'->>'researchScope')=ANY(ARRAY['species','product_strain'])) THEN RAISE EXCEPTION 'product_evidence_identity' USING ERRCODE='22023'; END IF;
       IF (v_item->>'field')=ANY(v_seen) THEN RAISE EXCEPTION 'product_evidence_duplicate_field' USING ERRCODE='22023'; END IF;
       v_seen := array_append(v_seen,v_item->>'field');
       IF p_payload->>(v_item->>'field') IS DISTINCT FROM v_item->>'value' THEN RAISE EXCEPTION 'product_evidence_value_mismatch' USING ERRCODE='22023'; END IF;
       FOR v_source IN SELECT value FROM jsonb_array_elements(v_item->'sources') LOOP
         IF jsonb_typeof(v_source) IS DISTINCT FROM 'object' OR (v_source-ARRAY['url','title','excerpt'])<>'{}' OR NOT platform_private.product_source_https_v1(v_source->>'url') OR jsonb_typeof(v_source->'url') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'title') IS DISTINCT FROM 'string' OR jsonb_typeof(v_source->'excerpt') IS DISTINCT FROM 'string' OR coalesce(v_source->>'title','')='' OR coalesce(v_source->>'excerpt','')='' OR octet_length(v_source::text)>20000 THEN RAISE EXCEPTION 'product_source_invalid' USING ERRCODE='22023'; END IF;
       END LOOP;
     END LOOP;
     p_payload := p_payload-'documentary_evidence';
   END IF;
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
   SELECT * INTO v_cfg FROM platform_private.tenant_catalog_root_cfg WHERE root = p_root;
  IF NOT FOUND THEN RAISE EXCEPTION 'tenant_catalog_root_invalid' USING ERRCODE='22023'; END IF;
  IF p_payload IS NULL OR jsonb_typeof(p_payload) <> 'object' THEN RAISE EXCEPTION 'tenant_catalog_payload_invalid' USING ERRCODE='22023'; END IF;
  FOR k IN SELECT jsonb_object_keys(p_payload) LOOP
    IF NOT k = ANY (v_cfg.allowed) THEN RAISE EXCEPTION 'tenant_catalog_field_forbidden:%', k USING ERRCODE='22023'; END IF;
    v_cols := v_cols || k;
  END LOOP;
  IF p_id IS NOT NULL AND p_expected_updated_at IS NULL THEN RAISE EXCEPTION 'tenant_catalog_cas_required' USING ERRCODE='PT409'; END IF;
  v_hash := md5(concat_ws('|', p_root, coalesce(p_id::text,'new'), p_payload::text, coalesce(p_expected_updated_at::text,'')));
  IF v_evidence IS NOT NULL THEN v_hash := md5(v_hash || v_evidence::text); END IF;
  IF v_children IS NOT NULL THEN v_hash := md5(v_hash || v_children::text); END IF;
  v_rep := platform_private.tenant_catalog_receipt(v_org, p_idempotency_key, v_hash);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
  IF platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_actor_changed' USING ERRCODE='42501'; END IF;
  IF v_rep IS NOT NULL THEN RETURN v_rep; END IF;
  -- referÃªncias no payload: mesma empresa (FOR SHARE no pai)
  FOR k IN SELECT jsonb_object_keys(v_cfg.refs) LOOP
    IF p_payload ? k AND jsonb_typeof(p_payload->k) <> 'null' THEN
      v_ref := platform_private.tenant_catalog_ref_owner(v_cfg.refs->>k, (p_payload->>k)::uuid);
  IF p_root = 'product_technical_profiles' AND platform_private.recorte_a_actor_fresh('mutate') IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'product_actor_changed' USING ERRCODE='42501'; END IF;
      IF v_ref IS DISTINCT FROM v_org THEN RAISE EXCEPTION 'tenant_catalog_ref_foreign:%', k USING ERRCODE='42501'; END IF;
    END IF;
  END LOOP;
  IF p_id IS NULL THEN
    IF v_cfg.kind = 'profile' AND NOT p_payload ? v_cfg.parent_col THEN RAISE EXCEPTION 'tenant_catalog_parent_required' USING ERRCODE='22023'; END IF;
    FOR k IN SELECT jsonb_object_keys(v_cfg.safe_defaults) LOOP
      IF NOT p_payload ? k THEN p_payload := p_payload || jsonb_build_object(k, v_cfg.safe_defaults->k); v_cols := v_cols || k; END IF;
    END LOOP;
    IF v_cfg.kind = 'root' THEN p_payload := p_payload || jsonb_build_object('owner_organization_id', v_org); v_cols := v_cols || 'owner_organization_id'::text; END IF;
    CASE p_root
WHEN 'microrganismos' THEN
INSERT INTO public."microrganismos" ("nome", "tipo", "nome_cientifico", "concentracao_ufc_ml", "concentracao_label", "dose_ml_ha", "valor_dose_brl", "fornecedor", "safra_referencia", "producao_on_farm", "meio_cultivo", "funcao_agronomica", "observacoes", "ativo", "b2b_enabled", "codigo", "descricao", "preco_tabela", "valor_litro_brl", "product_id", "owner_organization_id")
SELECT CASE WHEN p_payload ? 'nome' THEN r."nome" ELSE NULL END,
CASE WHEN p_payload ? 'tipo' THEN r."tipo" ELSE NULL END,
CASE WHEN p_payload ? 'nome_cientifico' THEN r."nome_cientifico" ELSE NULL END,
CASE WHEN p_payload ? 'concentracao_ufc_ml' THEN r."concentracao_ufc_ml" ELSE NULL END,
CASE WHEN p_payload ? 'concentracao_label' THEN r."concentracao_label" ELSE NULL END,
CASE WHEN p_payload ? 'dose_ml_ha' THEN r."dose_ml_ha" ELSE 100 END,
CASE WHEN p_payload ? 'valor_dose_brl' THEN r."valor_dose_brl" ELSE NULL END,
CASE WHEN p_payload ? 'fornecedor' THEN r."fornecedor" ELSE 'A.R Biotecnologia'::text END,
CASE WHEN p_payload ? 'safra_referencia' THEN r."safra_referencia" ELSE '2025'::text END,
CASE WHEN p_payload ? 'producao_on_farm' THEN r."producao_on_farm" ELSE true END,
CASE WHEN p_payload ? 'meio_cultivo' THEN r."meio_cultivo" ELSE NULL END,
CASE WHEN p_payload ? 'funcao_agronomica' THEN r."funcao_agronomica" ELSE NULL END,
CASE WHEN p_payload ? 'observacoes' THEN r."observacoes" ELSE NULL END,
CASE WHEN p_payload ? 'ativo' THEN r."ativo" ELSE true END,
CASE WHEN p_payload ? 'b2b_enabled' THEN r."b2b_enabled" ELSE false END,
CASE WHEN p_payload ? 'codigo' THEN r."codigo" ELSE NULL END,
CASE WHEN p_payload ? 'descricao' THEN r."descricao" ELSE NULL END,
CASE WHEN p_payload ? 'preco_tabela' THEN r."preco_tabela" ELSE NULL END,
CASE WHEN p_payload ? 'valor_litro_brl' THEN r."valor_litro_brl" ELSE NULL END,
CASE WHEN p_payload ? 'product_id' THEN r."product_id" ELSE NULL END,
CASE WHEN p_payload ? 'owner_organization_id' THEN r."owner_organization_id" ELSE platform_private.tenant_catalog_mutate_org() END
FROM jsonb_populate_record(NULL::public."microrganismos",p_payload) r RETURNING to_jsonb("microrganismos".*) INTO v_row;
WHEN 'culturas' THEN
INSERT INTO public."culturas" ("nome", "descricao", "ativo", "owner_organization_id")
SELECT CASE WHEN p_payload ? 'nome' THEN r."nome" ELSE NULL END,
CASE WHEN p_payload ? 'descricao' THEN r."descricao" ELSE NULL END,
CASE WHEN p_payload ? 'ativo' THEN r."ativo" ELSE true END,
CASE WHEN p_payload ? 'owner_organization_id' THEN r."owner_organization_id" ELSE platform_private.tenant_catalog_mutate_org() END
FROM jsonb_populate_record(NULL::public."culturas",p_payload) r RETURNING to_jsonb("culturas".*) INTO v_row;
WHEN 'catalogo_volumes' THEN
